{{- if .Components.DatabasePostgres }}
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
{{- else if .Components.DatabaseMySQL }}
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
{{- else if .Components.DatabaseSQLite }}
DB_DRIVER=sqlite
DB_DATABASE=./_data/sqlite/app.db
{{- end }}
REDIS_HOST=localhost
REDIS_PORT=6379
DEVCONSOLE_URL=ws://localhost:3000/__devconsole/ws/agent
DEVCONSOLE_TOKEN={{ .AppKey }}
