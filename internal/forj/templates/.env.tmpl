# App
APP_NAME={{ .ProjectName }}
APP_KEY={{ .AppKey }}
APP_ENV=local
APP_DEBUG=0
APP_URL=http://localhost:3000

# JWT
JWT_SECRET_KEY=xxx

# Database
{{- if .Components.DatabasePostgres }}
DB_DRIVER=postgres
DB_HOST=postgres
DB_DATABASE=app
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5432
DB_QUERY_LOGGING=false
{{- else if .Components.DatabaseMySQL }}
DB_DRIVER=mysql
DB_HOST=mysql
DB_DATABASE=db
DB_USERNAME=user
DB_PASSWORD=password
DB_PORT=3306
DB_ROOT_PASSWORD=root
DB_QUERY_LOGGING=false
{{- else if .Components.DatabaseSQLite }}
DB_DRIVER=sqlite
DB_DATABASE=./_data/sqlite/app.db
DB_QUERY_LOGGING=false
{{- end }}

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

{{- if .Components.Jobs }}
# Jobs
ASYNQ_MONITOR_USERNAME=admin
ASYNQ_MONITOR_PASSWORD=admin
ASYNQ_MONITOR_URI=/monitoring/tasks/
{{- end}}

# Docker
IP_ADDRESS=0.0.0.0
