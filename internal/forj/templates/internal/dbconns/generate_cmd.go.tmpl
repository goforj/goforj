package dbconns

import (
	"bytes"
	"fmt"
	"go/format"
	"os"
	"path/filepath"
	"sort"
	"strings"

	"github.com/goforj/env"
	"github.com/goforj/str"
)

// GenerateCmd generates connection accessors from environment variables.
type GenerateCmd struct {
	Output string `help:"Path to write DB accessors file" default:"internal/dbconns/connections_gen.go"`
}

// NewGenerateCmd returns a new GenerateCmd instance.
func NewGenerateCmd() *GenerateCmd {
	return &GenerateCmd{}
}

// Run writes the accessors file to disk.
func (c *GenerateCmd) Run() error {
	output := str.Of(c.Output).TrimSpace().String()
	if output == "" {
		output = "internal/dbconns/connections_gen.go"
	}

	names := discoverConnectionNames()
	source, err := renderAccessors(names)
	if err != nil {
		return err
	}

	formatted, err := format.Source(source)
	if err != nil {
		return fmt.Errorf("failed to format generated code: %w", err)
	}

	if err := os.MkdirAll(filepath.Dir(output), 0755); err != nil {
		return err
	}
	if err := os.WriteFile(output, formatted, 0644); err != nil {
		return err
	}

	fmt.Printf("generated %s\n", output)
	return nil
}

// discoverConnectionNames returns connection names derived from DB_* environment variables.
func discoverConnectionNames() []string {
	baseKeys := map[string]struct{}{
		"DEFAULT":                  {},
		"DRIVER":                   {},
		"DSN":                      {},
		"HOST":                     {},
		"DATABASE":                 {},
		"USERNAME":                 {},
		"PASSWORD":                 {},
		"PORT":                     {},
		"QUERY_LOGGING":            {},
		"MAX_IDLE_CONNECTIONS":     {},
		"MAX_OPEN_CONNECTIONS":     {},
		"CONN_MAX_LIFETIME_MINUTES": {},
		"ROOT_PASSWORD":            {},
	}
	names := map[string]struct{}{}
	for _, env := range os.Environ() {
		key, _, _ := strings.Cut(env, "=")
		if !strings.HasPrefix(key, "DB_") {
			continue
		}
		trimmed := strings.TrimPrefix(key, "DB_")
		if _, ok := baseKeys[trimmed]; ok {
			continue
		}
		parts := strings.SplitN(trimmed, "_", 2)
		if len(parts) < 2 {
			continue
		}
		if parts[0] == "ROOT" {
			continue
		}
		name := str.Of(parts[0]).ToLower().String()
		if name != "" {
			names[name] = struct{}{}
		}
	}

	if def := str.Of(env.Get("DB_DEFAULT", "")).TrimSpace().ToLower().String(); def != "" {
		names[def] = struct{}{}
	}

	out := make([]string, 0, len(names))
	for name := range names {
		out = append(out, name)
	}
	sort.Strings(out)
	return out
}

// renderAccessors renders accessor methods for the supplied connection names.
func renderAccessors(names []string) ([]byte, error) {
	var b bytes.Buffer
	b.WriteString("// Code generated by forj generate:dbconns. DO NOT EDIT.\n")
	b.WriteString("// Run: forj generate:dbconns\n")
	b.WriteString("//\n")
	b.WriteString("// This file contains accessors generated from DB_<NAME>_<KEY> environment variables.\n")
	b.WriteString("// For example, DB_ANALYTICS_DRIVER will generate GetAnalytics().\n")
	b.WriteString("//\n")
	b.WriteString("// Supported keys (DB_<NAME>_<KEY>):\n")
	b.WriteString("// - DRIVER\n")
	b.WriteString("// - DSN\n")
	b.WriteString("// - HOST\n")
	b.WriteString("// - DATABASE\n")
	b.WriteString("// - USERNAME\n")
	b.WriteString("// - PASSWORD\n")
	b.WriteString("// - PORT\n")
	b.WriteString("// - QUERY_LOGGING\n")
	b.WriteString("// - MAX_IDLE_CONNECTIONS\n")
	b.WriteString("// - MAX_OPEN_CONNECTIONS\n")
	b.WriteString("// - CONN_MAX_LIFETIME_MINUTES\n")
	b.WriteString("//\n")
	b.WriteString("// Generated output is accessor methods only, for example:\n")
	b.WriteString("//\n")
	b.WriteString("//   func (c *Connections) GetAnalytics() (*gorm.DB, error) {\n")
	b.WriteString("//     return c.get(\"analytics\")\n")
	b.WriteString("//   }\n")
	b.WriteString("//\n")
	b.WriteString("//   func (c *Connections) GetReporting() (*gorm.DB, error) {\n")
	b.WriteString("//     return c.get(\"reporting\")\n")
	b.WriteString("//   }\n")
	b.WriteString("package dbconns\n\n")
	funcsWritten := 0
	for _, name := range names {
		if name == "default" {
			continue
		}
		if funcsWritten == 0 {
			b.WriteString("import \"gorm.io/gorm\"\n\n")
		}
		b.WriteString(fmt.Sprintf("// Get%s returns the %q connection.\n", toPascal(name), name))
		b.WriteString(fmt.Sprintf("func (c *Connections) Get%s() (*gorm.DB, error) {\n", toPascal(name)))
		b.WriteString(fmt.Sprintf("\treturn c.get(%q)\n", name))
		b.WriteString("}\n")
		b.WriteString("\n")
		funcsWritten++
	}
	return b.Bytes(), nil
}

// toPascal converts a name into PascalCase for generated method names.
func toPascal(value string) string {
	parts := strings.FieldsFunc(value, func(r rune) bool {
		return r == '_' || r == '-' || r == ' '
	})
	for i, part := range parts {
		if part == "" {
			continue
		}
		parts[i] = str.Of(part[:1]).ToUpper().String() + str.Of(part[1:]).ToLower().String()
	}
	return strings.Join(parts, "")
}
