package dbconns

import (
	"os"
	"path/filepath"
	"reflect"
	"strings"
	"testing"

	"github.com/goforj/str"
)

// TestDiscoverConnectionNames ensures connection names are detected from env.
func TestDiscoverConnectionNames(t *testing.T) {
	t.Setenv("DB_ANALYTICS_HOST", "analytics-db")
	t.Setenv("DB_REPORTING_DRIVER", "postgres")
	t.Setenv("DB_DEFAULT", "Reporting")
	t.Setenv("DB_ROOT_PASSWORD", "rootpass")

	want := []string{"analytics", "reporting"}
	got := discoverConnectionNames()
	if !reflect.DeepEqual(got, want) {
		t.Fatalf("expected %v, got %v", want, got)
	}
}

// TestRenderAccessorsSkipsDefault ensures default accessors are not generated.
func TestRenderAccessorsSkipsDefault(t *testing.T) {
	source, err := renderAccessors([]string{"default", "analytics", "reporting"})
	if err != nil {
		t.Fatalf("expected no error, got %v", err)
	}
	output := string(source)
	if strings.Contains(output, "GetDefault") {
		t.Fatalf("expected default accessor to be skipped")
	}
	if !strings.Contains(output, "GetAnalytics") {
		t.Fatalf("expected analytics accessor to be generated")
	}
	if !strings.Contains(output, "GetReporting") {
		t.Fatalf("expected reporting accessor to be generated")
	}
}

// TestRenderAccessorsOmitsImportWhenEmpty ensures gorm import is skipped without accessors.
func TestRenderAccessorsOmitsImportWhenEmpty(t *testing.T) {
	source, err := renderAccessors([]string{"default"})
	if err != nil {
		t.Fatalf("expected no error, got %v", err)
	}
	output := string(source)
	if strings.Contains(output, "gorm.io/gorm") {
		t.Fatalf("expected gorm import to be omitted")
	}
}

// TestToPascal ensures names are converted to PascalCase.
func TestToPascal(t *testing.T) {
	if got := str.Of("foo_bar").Pascal().String(); got != "FooBar" {
		t.Fatalf("expected FooBar, got %q", got)
	}
	if got := str.Of("analytics-db").Pascal().String(); got != "AnalyticsDb" {
		t.Fatalf("expected AnalyticsDb, got %q", got)
	}
}

// TestGenerateCmdRun writes the accessors file to the requested path.
func TestGenerateCmdRun(t *testing.T) {
	t.Setenv("DB_ANALYTICS_HOST", "analytics-db")
	dir := t.TempDir()
	output := filepath.Join(dir, "connections_gen.go")

	cmd := &GenerateCmd{Output: output}
	if err := cmd.Run(); err != nil {
		t.Fatalf("expected no error, got %v", err)
	}

	contents, err := os.ReadFile(output)
	if err != nil {
		t.Fatalf("expected generated file, got %v", err)
	}
	if !strings.Contains(string(contents), "GetAnalytics") {
		t.Fatalf("expected GetAnalytics in generated file")
	}
}

// TestGenerateCmdRunDefaultPath writes to the default output path.
func TestGenerateCmdRunDefaultPath(t *testing.T) {
	t.Setenv("DB_ANALYTICS_HOST", "analytics-db")
	dir := t.TempDir()
	cwd, err := os.Getwd()
	if err != nil {
		t.Fatalf("failed to get cwd: %v", err)
	}
	if err := os.Chdir(dir); err != nil {
		t.Fatalf("failed to change dir: %v", err)
	}
	t.Cleanup(func() {
		_ = os.Chdir(cwd)
	})

	cmd := &GenerateCmd{Output: " "}
	if err := cmd.Run(); err != nil {
		t.Fatalf("expected no error, got %v", err)
	}

	output := filepath.Join(dir, "internal", "dbconns", "connections_gen.go")
	contents, err := os.ReadFile(output)
	if err != nil {
		t.Fatalf("expected generated file at default path, got %v", err)
	}
	text := string(contents)
	if !strings.Contains(text, "Code generated by forj generate:dbconns") {
		t.Fatalf("expected codegen header")
	}
	if !strings.Contains(text, "package dbconns") {
		t.Fatalf("expected package declaration")
	}
}
