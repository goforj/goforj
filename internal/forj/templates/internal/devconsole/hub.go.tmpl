package devconsole

import (
	"encoding/json"
	"fmt"
	"github.com/gorilla/websocket"
	"sync"
	"time"
)

// AgentInfo represents a connected agent.
type AgentInfo struct {
	ID           string    `json:"id"`
	Source       string    `json:"source"`
	App          string    `json:"app"`
	Version      string    `json:"version"`
	Env          string    `json:"env"`
	Capabilities []string  `json:"capabilities"`
	InstanceID   string    `json:"instance_id"`
	InstanceKind string    `json:"instance_kind"`
	Host         string    `json:"host"`
	LastSeen     time.Time `json:"last_seen"`
}

type agentConn struct {
	info AgentInfo
	conn *wsConn
}

type wsConn struct {
	conn *websocket.Conn
	mu   sync.Mutex
}

func (w *wsConn) writeJSON(msg Message) error {
	w.mu.Lock()
	defer w.mu.Unlock()
	return w.conn.WriteJSON(msg)
}

// Hub is the control-plane registry for agents and console connections.
type Hub struct {
	mu       sync.RWMutex
	agents   map[string]*agentConn
	pending  map[string]*wsConn
	consoles map[*wsConn]struct{}
}

// NewHub creates a new Hub instance.
func NewHub() *Hub {
	return &Hub{
		agents:   map[string]*agentConn{},
		pending:  map[string]*wsConn{},
		consoles: map[*wsConn]struct{}{},
	}
}

// Agents returns a snapshot of connected agents.
func (h *Hub) Agents() []AgentInfo {
	h.mu.RLock()
	defer h.mu.RUnlock()

	list := make([]AgentInfo, 0, len(h.agents))
	for _, agent := range h.agents {
		list = append(list, agent.info)
	}
	return list
}

// RegisterConsole adds a console connection.
func (h *Hub) RegisterConsole(conn *websocket.Conn) {
	h.mu.Lock()
	defer h.mu.Unlock()
	h.consoles[&wsConn{conn: conn}] = struct{}{}
}

// UnregisterConsole removes a console connection.
func (h *Hub) UnregisterConsole(conn *websocket.Conn) {
	h.mu.Lock()
	defer h.mu.Unlock()
	for w := range h.consoles {
		if w.conn == conn {
			delete(h.consoles, w)
			return
		}
	}
}

// RegisterAgent stores a new agent connection.
func (h *Hub) RegisterAgent(conn *websocket.Conn, info AgentInfo) {
	h.mu.Lock()
	defer h.mu.Unlock()
	info.LastSeen = time.Now()
	h.agents[info.Source] = &agentConn{info: info, conn: &wsConn{conn: conn}}
}

// UpdateHeartbeat updates the last seen timestamp for an agent.
func (h *Hub) UpdateHeartbeat(source string) {
	h.mu.Lock()
	defer h.mu.Unlock()
	agent := h.agents[source]
	if agent == nil {
		return
	}
	agent.info.LastSeen = time.Now()
}

// RemoveAgent removes a disconnected agent.
func (h *Hub) RemoveAgent(source string) {
	h.mu.Lock()
	defer h.mu.Unlock()
	delete(h.agents, source)
}

// RouteCommand sends a command to the target agent and tracks the response.
func (h *Hub) RouteCommand(conn *websocket.Conn, msg Message) error {
	h.mu.Lock()
	agent := h.agents[msg.Target]
	if agent == nil {
		h.mu.Unlock()
		return fmt.Errorf("agent not connected: %s", msg.Target)
	}
	var consoleConn *wsConn
	for w := range h.consoles {
		if w.conn == conn {
			consoleConn = w
			break
		}
	}
	if consoleConn != nil {
		h.pending[msg.ID] = consoleConn
	}
	h.mu.Unlock()

	return agent.conn.writeJSON(msg)
}

// HandleResponse routes a response back to the waiting console.
func (h *Hub) HandleResponse(msg Message) {
	h.mu.Lock()
	conn := h.pending[msg.ReplyTo]
	delete(h.pending, msg.ReplyTo)
	h.mu.Unlock()

	if conn != nil {
		_ = conn.writeJSON(msg)
	}
}

// BroadcastEvent sends an event message to all console connections.
func (h *Hub) BroadcastEvent(msg Message) {
	h.mu.RLock()
	defer h.mu.RUnlock()
	for conn := range h.consoles {
		_ = conn.writeJSON(msg)
	}
}

// parseAgentInfo decodes agent registration payloads.
func parseAgentInfo(raw json.RawMessage) (AgentInfo, error) {
	var info AgentInfo
	if err := json.Unmarshal(raw, &info); err != nil {
		return AgentInfo{}, err
	}
	return info, nil
}
