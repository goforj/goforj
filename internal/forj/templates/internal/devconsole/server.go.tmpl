package devconsole

import (
	"encoding/json"
	"fmt"
	"github.com/google/uuid"
	"github.com/gorilla/websocket"
	"github.com/labstack/echo/v4"
	"net/http"
	"os"
	"path/filepath"
	"strconv"
	"strings"
	"time"
)

// ServerConfig configures the dev console server.
type ServerConfig struct {
	Token string
}

const devconsoleAuthCookie = "devconsole_token"

// Attach mounts the dev console routes onto the Echo server.
func Attach(e *echo.Echo, hub *Hub, config ServerConfig) {
	group := e.Group("/__devconsole")

	group.GET("", func(c echo.Context) error {
		return serveIndex(c, config)
	})

	group.GET("/assets/*", func(c echo.Context) error {
		return serveAssets(c)
	})

	group.POST("/auth", func(c echo.Context) error {
		var req struct {
			Username string `json:"username"`
			Token    string `json:"token"`
		}
		if err := c.Bind(&req); err != nil {
			return c.NoContent(http.StatusBadRequest)
		}
		if strings.TrimSpace(req.Username) != "admin" {
			return c.NoContent(http.StatusUnauthorized)
		}
		if config.Token == "" || req.Token != config.Token {
			return c.NoContent(http.StatusUnauthorized)
		}
		http.SetCookie(c.Response(), &http.Cookie{
			Name:     devconsoleAuthCookie,
			Value:    config.Token,
			Path:     "/__devconsole",
			HttpOnly: true,
			SameSite: http.SameSiteLaxMode,
		})
		return c.NoContent(http.StatusNoContent)
	})

	group.POST("/auth/logout", func(c echo.Context) error {
		http.SetCookie(c.Response(), &http.Cookie{
			Name:     devconsoleAuthCookie,
			Value:    "",
			Path:     "/__devconsole",
			MaxAge:   -1,
			HttpOnly: true,
			SameSite: http.SameSiteLaxMode,
		})
		return c.NoContent(http.StatusNoContent)
	})

	group.GET("/api/agents", func(c echo.Context) error {
		if !authorizeRequest(c.Request(), config.Token) {
			return c.NoContent(http.StatusUnauthorized)
		}
		return c.JSON(http.StatusOK, hub.Agents())
	})
	group.GET("/api/env", func(c echo.Context) error {
		if !authorizeRequest(c.Request(), config.Token) {
			return c.NoContent(http.StatusUnauthorized)
		}
		name := strings.TrimSpace(c.QueryParam("file"))
		if name == "" {
			return c.JSON(http.StatusOK, map[string]any{
				"files": listEnvFiles(),
			})
		}
		path, ok := resolveEnvFile(name)
		if !ok {
			return c.NoContent(http.StatusNotFound)
		}
		data, err := os.ReadFile(path)
		if err != nil {
			return c.NoContent(http.StatusInternalServerError)
		}
		return c.JSON(http.StatusOK, map[string]any{
			"name":    name,
			"content": string(data),
		})
	})
	group.POST("/api/env", func(c echo.Context) error {
		if !authorizeRequest(c.Request(), config.Token) {
			return c.NoContent(http.StatusUnauthorized)
		}
		name := strings.TrimSpace(c.QueryParam("file"))
		if name == "" {
			return c.NoContent(http.StatusBadRequest)
		}
		path, ok := resolveEnvFile(name)
		if !ok {
			return c.NoContent(http.StatusNotFound)
		}
		var payload struct {
			Content string `json:"content"`
		}
		if err := c.Bind(&payload); err != nil {
			return c.NoContent(http.StatusBadRequest)
		}
		if err := os.WriteFile(path, []byte(payload.Content), 0644); err != nil {
			return c.NoContent(http.StatusInternalServerError)
		}
		return c.NoContent(http.StatusNoContent)
	})

	group.GET("/ws/agent", func(c echo.Context) error {
		if !authorizeRequest(c.Request(), config.Token) {
			return c.NoContent(http.StatusUnauthorized)
		}
		return handleAgentWS(c, hub)
	})

	group.GET("/ws/console", func(c echo.Context) error {
		if !authorizeRequest(c.Request(), config.Token) {
			return c.NoContent(http.StatusUnauthorized)
		}
		return handleConsoleWS(c, hub)
	})
	group.GET("/ws/devwatch", func(c echo.Context) error {
		if !authorizeRequest(c.Request(), config.Token) {
			return c.NoContent(http.StatusUnauthorized)
		}
		return handleDevwatchWS(c, hub)
	})

	group.GET("/*", func(c echo.Context) error {
		return serveIndex(c, config)
	})
}

// authorizeRequest checks the Authorization header or token query param.
func authorizeRequest(req *http.Request, token string) bool {
	if token == "" {
		return true
	}
	if cookie, err := req.Cookie(devconsoleAuthCookie); err == nil {
		if cookie.Value == token {
			return true
		}
	}
	auth := req.Header.Get("Authorization")
	if strings.HasPrefix(auth, "Bearer ") {
		return strings.TrimSpace(strings.TrimPrefix(auth, "Bearer ")) == token
	}
	queryToken := req.URL.Query().Get("token")
	return queryToken == token
}

func listEnvFiles() []string {
	files := []string{}
	entries, err := os.ReadDir(".")
	if err != nil {
		return files
	}
	for _, entry := range entries {
		if entry.IsDir() {
			continue
		}
		name := entry.Name()
		if name == ".env" || strings.HasPrefix(name, ".env.") {
			files = append(files, name)
		}
	}
	return files
}

func resolveEnvFile(name string) (string, bool) {
	if name != ".env" && !strings.HasPrefix(name, ".env.") {
		return "", false
	}
	clean := filepath.Base(name)
	if clean != name {
		return "", false
	}
	path := filepath.Join(".", clean)
	if _, err := os.Stat(path); err != nil {
		return "", false
	}
	return path, true
}

func handleAgentWS(c echo.Context, hub *Hub) error {
	upgrader := websocket.Upgrader{
		CheckOrigin: func(r *http.Request) bool { return true },
	}
	conn, err := upgrader.Upgrade(c.Response(), c.Request(), nil)
	if err != nil {
		return err
	}
	defer conn.Close()

	source := ""
	for {
		var msg Message
		if err := conn.ReadJSON(&msg); err != nil {
			if source != "" {
				hub.RemoveAgent(source)
			}
			return nil
		}
		if msg.Source == "" && source != "" {
			msg.Source = source
		}
		switch msg.Type {
		case "register":
			info, err := parseAgentInfo(msg.Payload)
			if err != nil {
				return err
			}
			source = info.Source
			hub.RegisterAgent(conn, info)
		case "heartbeat":
			var heartbeat struct {
				StartedAt time.Time `json:"started_at"`
			}
			if err := json.Unmarshal(msg.Payload, &heartbeat); err == nil {
				hub.UpdateHeartbeat(msg.Source, heartbeat.StartedAt)
			} else {
				hub.UpdateHeartbeat(msg.Source, time.Time{})
			}
		case "event":
			hub.RecordEvent(msg)
		case "response":
			hub.HandleResponse(msg)
		}
	}
}

func handleConsoleWS(c echo.Context, hub *Hub) error {
	upgrader := websocket.Upgrader{
		CheckOrigin: func(r *http.Request) bool { return true },
	}
	conn, err := upgrader.Upgrade(c.Response(), c.Request(), nil)
	if err != nil {
		return err
	}
	defer conn.Close()

	ws := newWSConn(conn)
	hub.RegisterConsole(ws)
	defer hub.UnregisterConsole(ws)

	for {
		var msg Message
		if err := conn.ReadJSON(&msg); err != nil {
			return nil
		}
		if msg.Type != "command" {
			continue
		}
		var cmd Command
		if err := json.Unmarshal(msg.Payload, &cmd); err != nil {
			payload, _ := json.Marshal(Response{Ok: false, Error: err.Error()})
			_ = ws.writeJSON(Message{
				Type:    "response",
				ID:      msg.ID,
				ReplyTo: msg.ID,
				Payload: payload,
			})
			continue
		}
		if msg.Target == "control" && cmd.Name == "logs:history" {
			limit := 5000
			if len(cmd.Params) > 0 {
				var params map[string]any
				if err := json.Unmarshal(cmd.Params, &params); err == nil {
					if raw, ok := params["limit"]; ok {
						if parsed, err := strconv.Atoi(fmt.Sprint(raw)); err == nil {
							limit = parsed
						}
					}
				}
			}
			payload, _ := json.Marshal(map[string]any{
				"logs": hub.LogSnapshot(limit),
			})
			response, _ := json.Marshal(Response{Ok: true, Data: payload})
			_ = ws.writeJSON(Message{
				Type:    "response",
				ID:      uuid.NewString(),
				ReplyTo: msg.ID,
				Source:  "control",
				Payload: response,
			})
			continue
		}
		if err := hub.RouteCommand(ws, msg); err != nil {
			payload, _ := json.Marshal(Response{Ok: false, Error: err.Error()})
			_ = ws.writeJSON(Message{
				Type:    "response",
				ID:      msg.ID,
				ReplyTo: msg.ID,
				Payload: payload,
			})
		}
	}
}

func handleDevwatchWS(c echo.Context, hub *Hub) error {
	upgrader := websocket.Upgrader{
		CheckOrigin: func(r *http.Request) bool { return true },
	}
	conn, err := upgrader.Upgrade(c.Response(), c.Request(), nil)
	if err != nil {
		return err
	}
	defer conn.Close()

	ws := newWSConn(conn)
	isSource := c.QueryParam("role") == "source"
	if !isSource {
		hub.RegisterDevwatch(ws)
		defer hub.UnregisterDevwatch(ws)
	} else {
		hub.RegisterDevwatchSource(ws)
		defer hub.UnregisterDevwatchSource(ws)
	}

	for {
		var msg Message
		if err := conn.ReadJSON(&msg); err != nil {
			return nil
		}
		if msg.Type == "devwatch-control" {
			if !isSource {
				hub.BroadcastDevwatchControl(msg.Payload)
			}
			continue
		}
		if msg.Type != "devwatch" {
			continue
		}
		var payload struct {
			Line DevwatchLine `json:"line"`
		}
		if err := json.Unmarshal(msg.Payload, &payload); err != nil {
			continue
		}
		if payload.Line.Line == "" {
			continue
		}
		if payload.Line.Timestamp.IsZero() {
			payload.Line.Timestamp = time.Now()
		}
		hub.RecordDevwatch(payload.Line)
	}
}

// serveIndex returns the embedded dev console UI.
func serveIndex(c echo.Context, config ServerConfig) error {
	if config.Token != "" {
		queryToken := c.QueryParam("token")
		if queryToken != "" && queryToken == config.Token {
			http.SetCookie(c.Response(), &http.Cookie{
				Name:     devconsoleAuthCookie,
				Value:    config.Token,
				Path:     "/__devconsole",
				HttpOnly: true,
				SameSite: http.SameSiteLaxMode,
			})
			return c.Redirect(http.StatusFound, strings.Split(c.Request().URL.Path, "?")[0])
		}
	}
	data, err := readAsset("index.html")
	if err != nil {
		return err
	}
	return c.HTMLBlob(http.StatusOK, data)
}

// serveAssets serves embedded UI assets.
func serveAssets(c echo.Context) error {
	path := strings.TrimPrefix(c.Request().URL.Path, "/__devconsole/assets/")
	if path == "" {
		return c.NoContent(http.StatusNotFound)
	}
	data, err := readAsset("assets/" + path)
	if err != nil {
		return c.NoContent(http.StatusNotFound)
	}
	if strings.HasSuffix(path, ".css") {
		c.Response().Header().Set("Content-Type", "text/css")
	} else if strings.HasSuffix(path, ".js") {
		c.Response().Header().Set("Content-Type", "text/javascript")
	}
	return c.Blob(http.StatusOK, c.Response().Header().Get("Content-Type"), data)
}

func readAsset(name string) ([]byte, error) {
	data, ok := uiAssets[name]
	if !ok {
		return nil, fmt.Errorf("asset not found: %s", name)
	}
	return data, nil
}
