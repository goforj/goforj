package env

import (
	"errors"
	"fmt"
	"github.com/joho/godotenv"
	"os"
	"runtime"
	"strconv"
)

// Get environment variable with a fallback (string)
// Example: Get("LOGGING_FORMAT", "text")
func Get(key, fallback string) string {
	value := os.Getenv(key)
	if len(value) == 0 {
		return fallback
	}

	return value
}

// GetInt environment variable with a fallback (int)
// Example: GetInt("MYSQL_MAX_OPEN_CONNECTIONS", "150")
func GetInt(key, fallback string) int {
	val := Get(key, fallback)
	ret, err := strconv.Atoi(val)
	if err != nil {
		panic(err)
	}
	return ret
}

// GetBool environment variable with a fallback (bool)
// Example: GetBool("MYSQL_QUERY_LOGGING", "false")
func GetBool(key, fallback string) bool {
	val := Get(key, fallback)
	ret, err := strconv.ParseBool(val)
	if err != nil {
		panic(err)
	}
	return ret
}

// MaxDirectorySeekLevels is the number of directory
// levels a .env file needs to be searched in
const MaxDirectorySeekLevels int = 10

// envLoaded is a flag to check if the environment file has been loaded
var envLoaded = false

// LoadEnvFileIfExists loads environment file .env locally
// loads .env.testing if invoked from the context of a test file
// loads .env.host if invoked from the context of MacOS which references variables to communicate back to the docker network
func LoadEnvFileIfExists() error {
	if runtime.GOOS == "darwin" || runtime.GOOS == "windows" {
		_ = os.Setenv("APP_ENV", "local")
	}

	if !envLoaded {
		// use dev or testing envs depending on the environment
		envLoadMsg := ""
		envFile := ".env"
		if IsAppEnvTesting() {
			envFile = ".env.testing"
		}

		// load top-level .env
		if loadEnvFile(envFile) {
			envLoadMsg = fmt.Sprintf("[LoadEnv] APP_ENV [%v] ENV_FILE [%v]", os.Getenv("APP_ENV"), envFile)
		}

		// display env: [LoadEnv] APP_ENV [local] ENV_FILE [.env]
		if GetInt("APP_DEBUG", "0") >= 3 {
			fmt.Println(envLoadMsg)
		}

		envLoaded = true

		// check if running in docker
		isInDocker := true

        // 1. If /.dockerenv is missing → probably NOT a real container
        if _, err := os.Stat("/.dockerenv"); errors.Is(err, os.ErrNotExist) {
            isInDocker = false
        }

        // 2. Detect Docker-in-Docker (dind) — we want this to be "not in docker"
        if isRunningInDind() {
            isInDocker = false
        }

		// search for global .env.host
		// we're likely talking from host -> container network
		// used from IDEs
		if !isInDocker {
			env := ".env.host"
			if loadEnvFile(env) {
				if GetInt("APP_DEBUG", "0") > 0 {
					fmt.Println(fmt.Sprintf("Loaded environment [env] APP_ENV [%v] ENV_FILE [%v]", os.Getenv("APP_ENV"), env))
				}
			}
		}
	}

	return nil
}

// IsEnvLoaded checks if the environment file has been loaded
func IsEnvLoaded() bool {
	return envLoaded
}

// searches for .env file through directory traversal
// loads .env file if found
func loadEnvFile(envFile string) bool {
	var path string
	found := false
	for i := 0; i < MaxDirectorySeekLevels; i++ {
		if _, err := os.Stat(path + envFile); err == nil {
			path += envFile
			found = true
			break
		}
		path += "../"
	}

	if found {
		if err := godotenv.Overload(path); err != nil {
			panic(err)
		}
	}

	return found
}

func isRunningInDind() bool {
    // DIND containers always have this service directory
    if _, err := os.Stat("/var/run/docker.sock"); err == nil {
        // But normal containers ALSO sometimes mount it
        // So verify the cgroup says "docker" or "kubepods" host-style
        cgroup, _ := os.ReadFile("/proc/1/cgroup")

        // If PID 1 is NOT namespaced → very likely dind
        if !bytes.Contains(cgroup, []byte("docker")) &&
           !bytes.Contains(cgroup, []byte("kubepods")) {
            return true
        }
    }

    return false
}
