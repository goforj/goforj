package migrations

import (
	"fmt"
	"sort"

	"gorm.io/gorm"
	"{{.GoModuleName}}/internal/logger"
)

// MigrateCmd is a CLI command
type MigrateCmd struct {
	Step   int  `help:"Number of migrations to apply" default:"0"` // 0 = all
	DryRun bool `help:"Show what would run without applying"`

	logger *logger.AppLogger
	db     *gorm.DB
}

// NewMigrateCmd creates a new MigrateCmd
func NewMigrateCmd(logger *logger.AppLogger, db *gorm.DB) *MigrateCmd {
	return &MigrateCmd{
		logger: logger,
		db:     db,
	}
}

// Run executes the command.
func (c *MigrateCmd) Run() error {
	if err := c.ensureMigrationsTable(); err != nil {
		failf("%v", err)
		return nil
	}

	var existing []string
	c.db.Raw("SELECT name FROM migrations").Scan(&existing)
	existingMap := map[string]bool{}
	for _, name := range existing {
		existingMap[name] = true
	}

	var pending []Migration
	for _, m := range GetMigrations() {
		if !existingMap[m.Name()] {
			pending = append(pending, m)
		}
	}

	// Sort pending by Name lexically (oldest first)
	sort.Slice(pending, func(i, j int) bool {
		return pending[i].Name() < pending[j].Name()
	})

	if len(pending) == 0 {
		fmt.Printf("%s migrations complete (0)\n", successMark())
		return nil
	}

	applied := 0
	for _, m := range pending {
		if c.Step > 0 && applied >= c.Step {
			break
		}

		if c.DryRun {
			fmt.Printf("%s would apply %s\n", infoMark(), m.Name())
			applied++
			continue
		}

		if err := m.Up(c.db); err != nil {
			failf("migration %s failed: %v", m.Name(), err)
			return nil
		}

		fmt.Printf("%s applied %s\n", successMark(), m.Name())
		c.db.Exec("INSERT INTO migrations (name) VALUES (?)", m.Name())
		applied++
	}

	if c.DryRun {
		fmt.Printf("%s dry-run complete (%d)\n", successMark(), applied)
		return nil
	}

	fmt.Printf("%s migrations complete (%d)\n", successMark(), applied)
	return nil
}

func (c *MigrateCmd) ensureMigrationsTable() error {
	const ddl = `
CREATE TABLE IF NOT EXISTS migrations (
	id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
	name VARCHAR(255) NOT NULL UNIQUE,
	applied_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
);`

	if err := c.db.Exec(ddl).Error; err != nil {
		return fmt.Errorf("failed to create migrations table: %w", err)
	}

	return nil
}
