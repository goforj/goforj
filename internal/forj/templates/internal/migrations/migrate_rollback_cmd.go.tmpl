package migrations

import (
	"fmt"
	"sort"

	"{{.GoModuleName}}/internal/console"
	"{{.GoModuleName}}/internal/dbconns"
	"{{.GoModuleName}}/internal/logger"
)

type MigrateRollbackCmd struct {
	Step       int    `help:"Number of recent migrations to rollback" default:"1"`
	Connection string `help:"Database connection name" default:"default"`

	logger *logger.AppLogger
	db     *dbconns.Connections
}

func NewMigrateRollbackCmd(logger *logger.AppLogger, db *dbconns.Connections) *MigrateRollbackCmd {
	return &MigrateRollbackCmd{logger: logger, db: db}
}

func (c *MigrateRollbackCmd) Run() error {
	if err := c.ensureMigrationsTable(); err != nil {
		console.Fatalf("%v", err)
		return nil
	}

	connName := normalizeConnectionName(c.Connection)
	dbConn, err := c.db.Connection(connName)
	if err != nil {
		console.Fatalf("%v", err)
		return nil
	}

	var applied []string
	err = dbConn.Table("migrations").Select("name").Scan(&applied).Error
	if err != nil {
		console.Fatalf("%v", err)
		return nil
	}

	appliedSet := make(map[string]bool)
	for _, name := range applied {
		appliedSet[name] = true
	}

	// Get all migrations, sort by Name descending
	all := GetMigrations()
	sort.Slice(all, func(i, j int) bool {
		return all[i].Name() > all[j].Name()
	})

	rollbackCount := 0
	for _, m := range all {
		if m.Connection() != connName {
			continue
		}
		if !appliedSet[m.Name()] {
			continue
		}
		if rollbackCount >= c.Step {
			break
		}

		if err := m.Down(dbConn); err != nil {
			console.Fatalf("failed to rollback migration %s: %v", m.Name(), err)
			return nil
		}

		if err := dbConn.Exec(`DELETE FROM migrations WHERE name = ?`, m.Name()).Error; err != nil {
			console.Fatalf("%v", err)
			return nil
		}

		console.Successf("reverted %s", m.Name())
		rollbackCount++
	}

	if rollbackCount == 0 {
		console.Infof("no migrations rolled back")
	}
	console.Successf("rollback complete (%d)", rollbackCount)

	return nil
}

func (c *MigrateRollbackCmd) ensureMigrationsTable() error {
	connName := normalizeConnectionName(c.Connection)
	dbConn, err := c.db.Connection(connName)
	if err != nil {
		return err
	}
	return dbConn.Exec(`
	CREATE TABLE IF NOT EXISTS migrations (
		name VARCHAR(255) PRIMARY KEY,
		applied_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
	);
	`).Error
}
