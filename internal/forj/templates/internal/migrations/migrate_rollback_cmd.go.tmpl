package migrations

import (
	"fmt"
	"sort"

	"gorm.io/gorm"
	"{{.GoModuleName}}/internal/logger"
)

type MigrateRollbackCmd struct {
	Step int `help:"Number of recent migrations to rollback" default:"1"`

	logger *logger.AppLogger
	db     *gorm.DB
}

func NewMigrateRollbackCmd(logger *logger.AppLogger, db *gorm.DB) *MigrateRollbackCmd {
	return &MigrateRollbackCmd{logger: logger, db: db}
}

func (c *MigrateRollbackCmd) Run() error {
	if err := c.ensureMigrationsTable(); err != nil {
		failf("%v", err)
		return nil
	}

	var applied []string
	err := c.db.Table("migrations").Select("name").Scan(&applied).Error
	if err != nil {
		failf("%v", err)
		return nil
	}

	appliedSet := make(map[string]bool)
	for _, name := range applied {
		appliedSet[name] = true
	}

	// Get all migrations, sort by Name descending
	all := GetMigrations()
	sort.Slice(all, func(i, j int) bool {
		return all[i].Name() > all[j].Name()
	})

	rollbackCount := 0
	for _, m := range all {
		if !appliedSet[m.Name()] {
			continue
		}
		if rollbackCount >= c.Step {
			break
		}

		if err := m.Down(c.db); err != nil {
			failf("failed to rollback migration %s: %v", m.Name(), err)
			return nil
		}

		if err := c.db.Exec(`DELETE FROM migrations WHERE name = ?`, m.Name()).Error; err != nil {
			failf("%v", err)
			return nil
		}

		fmt.Printf("%s reverted %s\n", successMark(), m.Name())
		rollbackCount++
	}

	if rollbackCount == 0 {
		fmt.Printf("%s no migrations rolled back\n", infoMark())
	}
	fmt.Printf("%s rollback complete (%d)\n", successMark(), rollbackCount)

	return nil
}

func (c *MigrateRollbackCmd) ensureMigrationsTable() error {
	return c.db.Exec(`
	CREATE TABLE IF NOT EXISTS migrations (
		name VARCHAR(255) PRIMARY KEY,
		applied_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
	);
	`).Error
}
