	defer restore()
	log := logger.NewSilentLogger()
	cmd := NewMakeModelCmd(log, dbconns.NewConnections())
	cmd.Output = filepath.Join(tempDir, "internal", "models")
	inputName := str.Of(table).Plural().String()
	if inputName == table {
		inputName = table + "s"
	}
	cmd.Table = inputName
