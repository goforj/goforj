package scheduler

import (
	"context"
	"fmt"
	"os"
	"os/signal"
	"sort"
	"strconv"
	"strings"
	"sync"
	"syscall"
	"time"

	"github.com/go-co-op/gocron/v2"
	schedulerx "github.com/goforj/scheduler"
	"github.com/google/uuid"
	"{{.GoModuleName}}/internal/logger"
)

// Scheduler is a struct that represents a scheduler.
type Scheduler struct {
	logger    *logger.AppLogger
	scheduler gocron.Scheduler
	schedule  *schedulerx.JobBuilder
}

type scheduleMeta struct {
	JobType  string
	Schedule string
	Handler  string
}

var scheduleMetaMu sync.RWMutex
var scheduleMetaByID = map[string]scheduleMeta{}

// scheduleSpec captures job definitions so schedules can be paused/resumed.
type scheduleSpec struct {
	Definition gocron.JobDefinition
	Task       gocron.Task
	Options    []gocron.JobOption
	Meta       scheduleMeta
	Name       string
	Tags       []string
}

var scheduleSpecMu sync.RWMutex
var scheduleSpecByID = map[string]scheduleSpec{}
var pausedSpecByID = map[string]scheduleSpec{}
var pausedAllMu sync.RWMutex
var pausedAll bool

// NewScheduler creates a new Scheduler.
func NewScheduler(
	logger *logger.AppLogger,
	scheduler gocron.Scheduler,
	schedule *schedulerx.JobBuilder,
) *Scheduler {
	return &Scheduler{
		logger:    logger,
		scheduler: scheduler,
		schedule:  schedule,
	}
}

// Start starts the scheduler.
func (s *Scheduler) Start() error {
	err := s.Register()
	if err != nil {
		return err
	}

	StartDevConsoleAgent(context.Background(), s, s.logger)

	// start the scheduler
	s.scheduler.Start()
	s.logger.Info().Msg("Scheduler started")

	// Wait for termination signal
	sigChan := make(chan os.Signal, 1)
	signal.Notify(sigChan, syscall.SIGINT, syscall.SIGTERM)

	<-sigChan
	s.logger.Info().Msg("Shutting down scheduler...")

	// when you're done, shut it down
	err = s.scheduler.Shutdown()
	if err != nil {
		return err
	}

	s.logger.Info().Msg("Scheduler shut down")

	return nil
}

// recordScheduleMeta stores schedule metadata for dev console rendering.
func recordScheduleMeta(id string, meta scheduleMeta) {
	scheduleMetaMu.Lock()
	scheduleMetaByID[id] = meta
	scheduleMetaMu.Unlock()
}

// recordScheduleSpec stores job definitions so they can be rehydrated.
func recordScheduleSpec(id string, spec scheduleSpec) {
	scheduleSpecMu.Lock()
	scheduleSpecByID[id] = spec
	scheduleSpecMu.Unlock()
}

// lookupScheduleMeta returns schedule metadata for a job id.
func lookupScheduleMeta(id string) (scheduleMeta, bool) {
	scheduleMetaMu.RLock()
	meta, ok := scheduleMetaByID[id]
	scheduleMetaMu.RUnlock()
	return meta, ok
}

// lookupScheduleSpec returns the schedule spec for a job id.
func lookupScheduleSpec(id string) (scheduleSpec, bool) {
	scheduleSpecMu.RLock()
	spec, ok := scheduleSpecByID[id]
	scheduleSpecMu.RUnlock()
	return spec, ok
}

// formatScheduleLabel returns a short schedule label based on cron or duration.
func formatScheduleLabel(cronExpr string, duration *time.Duration) string {
	if cronExpr != "" {
		return "cron " + cronExpr
	}
	if duration == nil {
		return "-"
	}
	seconds := int(duration.Seconds())
	if seconds <= 0 {
		return "-"
	}
	if seconds%3600 == 0 {
		return "every " + strconv.Itoa(seconds/3600) + "h"
	}
	if seconds%60 == 0 {
		return "every " + strconv.Itoa(seconds/60) + "m"
	}
	return "every " + duration.String()
}

// normalizeScheduleType returns a stable schedule type label.
func normalizeScheduleType(value string) string {
	trimmed := strings.TrimSpace(strings.ToLower(value))
	if trimmed == "" {
		return "function"
	}
	return trimmed
}

// formatRelativeTime returns a short relative time label for a timestamp.
func formatRelativeTime(now, next time.Time) string {
	if next.IsZero() {
		return "-"
	}
	if next.Before(now) {
		return "now"
	}
	return "in " + time.Until(next).Round(time.Second).String()
}

// formatScheduleDisplayName shortens function names for UI display.
func formatScheduleDisplayName(value string) string {
	if strings.TrimSpace(value) == "" {
		return "-"
	}
	if strings.Contains(value, ":") {
		return value
	}
	if idx := strings.LastIndex(value, "/"); idx >= 0 && idx < len(value)-1 {
		value = value[idx+1:]
	}
	value = strings.ReplaceAll(value, "(*", "")
	value = strings.ReplaceAll(value, ").", ".")
	return value
}

// ListSchedules returns a snapshot of scheduled jobs.
func (s *Scheduler) ListSchedules() []ScheduleInfo {
	jobs := s.scheduler.Jobs()
	out := make([]ScheduleInfo, 0, len(jobs))
	for _, job := range jobs {
		next, _ := job.NextRun()
		now := time.Now()
		jobID := job.ID().String()
		meta, ok := s.lookupLiveScheduleMeta(job.ID())
		jobType := ""
		handler := ""
		schedule := ""
		if ok {
			jobType = meta.JobType
			handler = meta.Handler
			schedule = meta.Schedule
		}
		if jobType == "" {
			if strings.Contains(job.Name(), ":") {
				jobType = "command"
			} else {
				jobType = "function"
			}
		}
		if handler == "" {
			if jobType == "command" {
				handler = "-"
			} else {
				handler = job.Name()
			}
		}
		name := job.Name()
		rawHandler := handler
		displayName := formatScheduleDisplayName(name)
		displayHandler := formatScheduleDisplayName(handler)
		if schedule == "" {
			schedule = "-"
		}
		out = append(out, ScheduleInfo{
			ID:         jobID,
			Name:       displayName,
			Type:       jobType,
			Schedule:   schedule,
			Handler:    displayHandler,
			HandlerRaw: rawHandler,
			Next:       formatRelativeTime(now, next),
			NextRun:    next.Format(time.RFC3339),
			Tags:       job.Tags(),
			Paused:     false,
		})
	}
	paused := listPausedSchedules()
	out = append(out, paused...)
	sort.Slice(out, func(i, j int) bool {
		if out[i].Name == out[j].Name {
			return out[i].ID < out[j].ID
		}
		return out[i].Name < out[j].Name
	})
	return out
}

// IsAllPaused reports whether all schedules are currently paused.
func (s *Scheduler) IsAllPaused() bool {
	jobs := s.scheduler.Jobs()
	if len(jobs) > 0 {
		return false
	}
	scheduleSpecMu.RLock()
	defer scheduleSpecMu.RUnlock()
	return len(pausedSpecByID) > 0
}

func (s *Scheduler) lookupLiveScheduleMeta(id uuid.UUID) (scheduleMeta, bool) {
	if s.schedule != nil {
		if meta, ok := s.schedule.JobMetadata()[id]; ok {
			return scheduleMeta{
				JobType:  normalizeScheduleType(meta.TargetKind),
				Schedule: meta.Schedule,
				Handler:  meta.Handler,
			}, true
		}
	}
	return lookupScheduleMeta(id.String())
}

// listPausedSchedules returns paused schedules kept in memory.
func listPausedSchedules() []ScheduleInfo {
	scheduleSpecMu.RLock()
	defer scheduleSpecMu.RUnlock()

	out := make([]ScheduleInfo, 0, len(pausedSpecByID))
	for id, spec := range pausedSpecByID {
		meta := spec.Meta
		jobType := meta.JobType
		handler := meta.Handler
		schedule := meta.Schedule
		if jobType == "" {
			jobType = "function"
		}
		if handler == "" {
			handler = spec.Name
		}
		rawHandler := handler
		displayName := formatScheduleDisplayName(spec.Name)
		displayHandler := formatScheduleDisplayName(handler)
		if schedule == "" {
			schedule = "-"
		}
		out = append(out, ScheduleInfo{
			ID:         id,
			Name:       displayName,
			Type:       jobType,
			Schedule:   schedule,
			Handler:    displayHandler,
			HandlerRaw: rawHandler,
			Next:       "-",
			NextRun:    "-",
			Tags:       spec.Tags,
			Paused:     true,
		})
	}
	return out
}

func listPausedScheduleIDs() []string {
	scheduleSpecMu.RLock()
	defer scheduleSpecMu.RUnlock()
	ids := make([]string, 0, len(pausedSpecByID))
	for id := range pausedSpecByID {
		ids = append(ids, id)
	}
	return ids
}

// PauseAll halts job execution without removing schedule definitions.
func (s *Scheduler) PauseAll() error {
	jobs := s.scheduler.Jobs()
	for _, job := range jobs {
		jobID := job.ID()
		id := jobID.String()
		spec, ok := lookupScheduleSpec(id)
		if !ok {
			continue
		}
		if meta, ok := s.lookupLiveScheduleMeta(jobID); ok {
			spec.Meta = meta
		}
		if err := s.scheduler.RemoveJob(jobID); err != nil {
			return err
		}
		scheduleSpecMu.Lock()
		pausedSpecByID[id] = spec
		delete(scheduleSpecByID, id)
		scheduleSpecMu.Unlock()
	}
	pausedAllMu.Lock()
	pausedAll = true
	pausedAllMu.Unlock()
	return nil
}

// ResumeAll restarts job execution for all schedules.
func (s *Scheduler) ResumeAll() {
	s.scheduler.Start()
	pausedAllMu.Lock()
	pausedAll = false
	pausedAllMu.Unlock()
	pausedIDs := listPausedScheduleIDs()
	for _, id := range pausedIDs {
		_, _ = s.ResumeSchedule(id)
	}
}

// isPausedAll returns whether the scheduler is globally paused.
func isPausedAll() bool {
	pausedAllMu.RLock()
	defer pausedAllMu.RUnlock()
	return pausedAll
}

// PauseSchedule removes a schedule but keeps its definition for later.
func (s *Scheduler) PauseSchedule(id string) error {
	scheduleSpecMu.RLock()
	_, alreadyPaused := pausedSpecByID[id]
	scheduleSpecMu.RUnlock()
	if alreadyPaused {
		return nil
	}
	jobID, err := uuid.Parse(id)
	if err != nil {
		return fmt.Errorf("invalid schedule id")
	}
	job := s.findJob(jobID)
	if job == nil {
		return nil
	}
	spec, ok := lookupScheduleSpec(id)
	if !ok {
		return fmt.Errorf("schedule spec not found")
	}
	if meta, ok := s.lookupLiveScheduleMeta(jobID); ok {
		spec.Meta = meta
	}
	if err := s.scheduler.RemoveJob(jobID); err != nil {
		return err
	}
	scheduleSpecMu.Lock()
	pausedSpecByID[id] = spec
	delete(scheduleSpecByID, id)
	scheduleSpecMu.Unlock()
	return nil
}

// ResumeSchedule rehydrates a paused schedule and returns its new id.
func (s *Scheduler) ResumeSchedule(id string) (string, error) {
	if job := s.findJobByString(id); job != nil {
		return id, nil
	}
	scheduleSpecMu.RLock()
	spec, ok := pausedSpecByID[id]
	scheduleSpecMu.RUnlock()
	if !ok {
		return id, nil
	}
	job, err := s.scheduler.NewJob(spec.Definition, spec.Task, spec.Options...)
	if err != nil {
		return "", err
	}
	newID := job.ID().String()
	spec.Name = job.Name()
	spec.Tags = job.Tags()
	recordScheduleMeta(newID, spec.Meta)
	recordScheduleSpec(newID, spec)
	scheduleSpecMu.Lock()
	delete(pausedSpecByID, id)
	scheduleSpecMu.Unlock()
	pausedAllMu.Lock()
	pausedAll = false
	pausedAllMu.Unlock()
	return newID, nil
}

// RestartSchedule runs a schedule immediately (resuming first if needed).
func (s *Scheduler) RestartSchedule(id string) (string, error) {
	if job := s.findJobByString(id); job != nil {
		if err := job.RunNow(); err != nil {
			return "", err
		}
		return id, nil
	}
	newID, err := s.ResumeSchedule(id)
	if err != nil {
		return "", err
	}
	job := s.findJobByString(newID)
	if job == nil {
		return newID, nil
	}
	if err := job.RunNow(); err != nil {
		return newID, err
	}
	return newID, nil
}

// findJob resolves a gocron job by UUID.
func (s *Scheduler) findJob(id uuid.UUID) gocron.Job {
	for _, job := range s.scheduler.Jobs() {
		if job.ID() == id {
			return job
		}
	}
	return nil
}

// findJobByString resolves a gocron job by string id.
func (s *Scheduler) findJobByString(id string) gocron.Job {
	jobID, err := uuid.Parse(id)
	if err != nil {
		return nil
	}
	return s.findJob(jobID)
}
