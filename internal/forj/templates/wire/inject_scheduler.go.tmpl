package wire

import (
	"github.com/go-co-op/gocron/v2"
	"github.com/google/wire"
	"{{.GoModuleName}}/internal/scheduler"
)

var schedulerSet = wire.NewSet(
	scheduler.NewScheduler,
	scheduler.NewCmd,
	scheduler.NewFluentJobWrapper,
	ProvideScheduler,
)

// ProvideScheduler provides the scheduler and its command.
func ProvideScheduler() (gocron.Scheduler, error) {
	s, err := gocron.NewScheduler()
	if err != nil {
		return nil, err
	}

	return s, nil
}
