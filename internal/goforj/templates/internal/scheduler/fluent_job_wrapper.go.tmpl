// Hourly schedules the job to run every hour.
func (f *FluentJobWrapper) Hourly() *FluentJobWrapper {
	return f.every(1 * time.Hour)
}

// HourlyAt schedules the job to run every hour at the specified minute.
func (f *FluentJobWrapper) HourlyAt(minute int) *FluentJobWrapper {
	return f.Cron(fmt.Sprintf("%d * * * *", minute))
}

// EveryOddHour schedules the job to run every odd-numbered hour at the specified minute.
func (f *FluentJobWrapper) EveryOddHour(minute int) *FluentJobWrapper {
	return f.Cron(fmt.Sprintf("%d 1-23/2 * * *", minute))
}

// EveryTwoHours schedules the job to run every two hours at the specified minute.
func (f *FluentJobWrapper) EveryTwoHours(minute int) *FluentJobWrapper {
	return f.Cron(fmt.Sprintf("%d */2 * * *", minute))
}

// EveryThreeHours schedules the job to run every three hours at the specified minute.
func (f *FluentJobWrapper) EveryThreeHours(minute int) *FluentJobWrapper {
	return f.Cron(fmt.Sprintf("%d */3 * * *", minute))
}

// EveryFourHours schedules the job to run every four hours at the specified minute.
func (f *FluentJobWrapper) EveryFourHours(minute int) *FluentJobWrapper {
	return f.Cron(fmt.Sprintf("%d */4 * * *", minute))
}

// EverySixHours schedules the job to run every six hours at the specified minute.
func (f *FluentJobWrapper) EverySixHours(minute int) *FluentJobWrapper {
	return f.Cron(fmt.Sprintf("%d */6 * * *", minute))
}

// Daily schedules the job to run once per day at midnight.
func (f *FluentJobWrapper) Daily() *FluentJobWrapper {
	return f.Cron("0 0 * * *")
}

// DailyAt schedules the job to run daily at a specific time (e.g., "13:00").
func (f *FluentJobWrapper) DailyAt(hm string) *FluentJobWrapper {
	return f.Cron(fmt.Sprintf("%s * * *", hm))
}

// TwiceDaily schedules the job to run daily at two specified hours (e.g., 1 and 13).
func (f *FluentJobWrapper) TwiceDaily(h1, h2 int) *FluentJobWrapper {
	return f.Cron(fmt.Sprintf("0 %d,%d * * *", h1, h2))
}

// TwiceDailyAt schedules the job to run daily at two specified times (e.g., 1:15 and 13:15).
func (f *FluentJobWrapper) TwiceDailyAt(h1, h2, m int) *FluentJobWrapper {
	return f.Cron(fmt.Sprintf("%d %d,%d * * *", m, h1, h2))
}

// Weekly schedules the job to run once per week on Sunday at midnight.
func (f *FluentJobWrapper) Weekly() *FluentJobWrapper {
	return f.Cron("0 0 * * 0")
}

// WeeklyOn schedules the job to run weekly on a specific day of the week and time.
// Day uses 0 = Sunday through 6 = Saturday.
func (f *FluentJobWrapper) WeeklyOn(day int, hm string) *FluentJobWrapper {
	return f.Cron(fmt.Sprintf("%s * * %d", hm, day))
}

// Monthly schedules the job to run on the first day of each month at midnight.
func (f *FluentJobWrapper) Monthly() *FluentJobWrapper {
	return f.Cron("0 0 1 * *")
}

// MonthlyOn schedules the job to run on a specific day of the month at a given time.
func (f *FluentJobWrapper) MonthlyOn(day int, hm string) *FluentJobWrapper {
	return f.Cron(fmt.Sprintf("%s %d * *", hm, day))
}

// TwiceMonthly schedules the job to run on two specific days of the month at the given time.
func (f *FluentJobWrapper) TwiceMonthly(d1, d2 int, hm string) *FluentJobWrapper {
	return f.Cron(fmt.Sprintf("%s %d,%d * *", hm, d1, d2))
}

// LastDayOfMonth schedules the job to run on the last day of each month at a specific time.
func (f *FluentJobWrapper) LastDayOfMonth(hm string) *FluentJobWrapper {
	return f.Cron(fmt.Sprintf("%s L * *", hm))
}

// Quarterly schedules the job to run on the first day of each quarter at midnight.
func (f *FluentJobWrapper) Quarterly() *FluentJobWrapper {
	return f.Cron("0 0 1 1,4,7,10 *")
}

// QuarterlyOn schedules the job to run on a specific day of each quarter at a given time.
func (f *FluentJobWrapper) QuarterlyOn(day int, hm string) *FluentJobWrapper {
	return f.Cron(fmt.Sprintf("%s %d 1,4,7,10 *", hm, day))
}

// Yearly schedules the job to run on January 1st every year at midnight.
func (f *FluentJobWrapper) Yearly() *FluentJobWrapper {
	return f.Cron("0 0 1 1 *")
}

// YearlyOn schedules the job to run every year on a specific month, day, and time.
func (f *FluentJobWrapper) YearlyOn(month, day int, hm string) *FluentJobWrapper {
	return f.Cron(fmt.Sprintf("%s %d %d *", hm, day, month))
}

// Timezone sets a timezone string for the job (not currently applied to gocron Scheduler).
func (f *FluentJobWrapper) Timezone(zone string) *FluentJobWrapper {
	f.timezone = zone
	return f
}

// CronExpr returns the cron expression string configured for this job.
func (f *FluentJobWrapper) CronExpr() string {
	return f.cronExpr
}

// Job returns the last scheduled gocron.Job instance, if available.
func (f *FluentJobWrapper) Job() gocron.Job {
	return f.lastJob
}

// WithoutOverlappingWithLocker ensures the job does not run concurrently across distributed systems using the provided locker.
func (f *FluentJobWrapper) WithoutOverlappingWithLocker(locker gocron.Locker) *FluentJobWrapper {
	f.withoutOverlap = true
	f.distributedLocker = locker
	return f
}

// Environments restricts job registration to specific environment names (e.g. "production", "staging").
func (f *FluentJobWrapper) Environments(envs ...string) *FluentJobWrapper {
	f.envs = envs
	return f
}

// When only schedules the job if the provided condition returns true.
func (f *FluentJobWrapper) When(fn func() bool) *FluentJobWrapper {
	f.whenFunc = fn
	return f
}

// Skip prevents scheduling the job if the provided condition returns true.
func (f *FluentJobWrapper) Skip(fn func() bool) *FluentJobWrapper {
	f.skipFunc = fn
	return f
}
