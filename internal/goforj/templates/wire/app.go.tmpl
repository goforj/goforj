package wire

import (
	"context"
	"{{.GoModuleName}}/internal/cmd"
	"{{.GoModuleName}}/internal/logger"
	gocache "github.com/patrickmn/go-cache"
{{- if .Components.Database }}
	"gorm.io/gorm"
{{- end }}
)

// App is the root App resource
type App struct {
	context context.Context
	rootCmd *cmd.RootCmd
	logger  *logger.AppLogger
	cache   *gocache.Cache
	{{- if .Components.Database }}
	db      *gorm.DB
	{{- end }}
}

// RootCmd returns the root command of the application
func (a *App) RootCmd() *cmd.RootCmd {
	return a.rootCmd
}

// Logger returns the logger of the application
func (a *App) Logger() *logger.AppLogger {
	return a.logger
}

{{- if .Components.Database }}
// DB returns the database instance
func (a *App) DB() *gorm.DB {
	return a.db
}
{{- end }}

// NewApplication creates a new App instance
func NewApplication(
	{{- if .Components.Database }}
	db *gorm.DB,
	{{- end }}
	logger *logger.AppLogger,
	rootCmd *cmd.RootCmd,
	cache *gocache.Cache,
) App {
	return App{
		context: context.Background(),
		rootCmd: rootCmd,
		logger:  logger,
		{{- if .Components.Database }}
		db: db,
		{{- end }}
		cache: cache,
	}
}
