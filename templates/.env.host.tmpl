# These overrides are typically for networked resource connection details.
{{- if .Resources.DatabasePostgres }}
{{- if not .Resources.DatabaseExternal }}
DB_HOST=localhost
DB_PORT=5432
{{- end }}
{{- else if .Resources.DatabaseMySQL }}
{{- if not .Resources.DatabaseExternal }}
DB_HOST=localhost
DB_PORT=3306
{{- end }}
{{- else if .Resources.DatabaseSQLite }}
DB_DATABASE=./_data/sqlite/app.db
{{- end }}
{{- if and (or .Resources.RedisActive .Resources.RedisLocal) (not .Resources.RedisExternal) }}
REDIS_HOST=localhost
REDIS_PORT=6379
{{- end }}
{{- if .Resources.CacheMemcachedLocal }}
CACHE_ADDRESSES=localhost:11211
{{- end }}
{{- if .Resources.CacheDynamoDBLocal }}
CACHE_ENDPOINT=http://localhost:8000
{{- end }}
{{- if .Resources.CacheNATSLocal }}
CACHE_URL=nats://goforj:goforj@localhost:4222
{{- end }}
{{- if .Resources.QueueNATSLocal }}
QUEUE_URL=nats://goforj:goforj@localhost:4222
{{- else if .Resources.QueueRabbitMQLocal }}
QUEUE_URL=amqp://goforj:goforj@localhost:5672/
{{- end }}
{{- if .Resources.QueueSQSLocal }}
QUEUE_ENDPOINT=http://localhost:9324
{{- end }}
{{- if .Resources.EventsNATSLocal }}
EVENTS_URL=nats://goforj:goforj@localhost:4222
{{- end }}
{{- if .Resources.EventsKafkaLocal }}
EVENTS_BROKERS=localhost:19092
{{- end }}
{{- if .Resources.EventsGCPPubSubLocal }}
EVENTS_URI=localhost:8085
{{- end }}
{{- if and .Components.Mail .Components.Docker }}
MAIL_SMTP_HOST=localhost
{{- end }}
