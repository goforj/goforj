{{- if .Components.DatabasePostgres }}
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
{{- else if .Components.DatabaseMySQL }}
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
{{- else if .Components.DatabaseSQLite }}
DB_DRIVER=sqlite
DB_DATABASE=./_data/sqlite/app.db
{{- end }}
REDIS_HOST=localhost
REDIS_PORT=6379
{{- if .Render.QueueDriver }}
QUEUE_DRIVER={{ .Render.QueueDriver }}
{{- else }}
QUEUE_DRIVER=redis
{{- end }}
APP_SHUTDOWN_TIMEOUT_MS=15000
SCHEDULER_COMMAND_TIMEOUT_MS=600000
SCHEDULER_SUBPROCESS_SHUTDOWN_TIMEOUT_MS=15000
{{- if eq .Render.QueueDriver "workerpool" }}
QUEUE_WORKERPOOL_WORKERS=0
QUEUE_WORKERPOOL_BUFFER=1024
QUEUE_WORKERPOOL_TASK_TIMEOUT_MS=0
QUEUE_WORKERPOOL_SHUTDOWN_TIMEOUT_MS=15000
{{- end }}
