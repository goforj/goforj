# These overrides are typically for network settings, such as database and Redis connection details.
{{- if .Components.DatabasePostgres }}
DB_HOST=localhost
DB_PORT=5432
{{- else if .Components.DatabaseMySQL }}
DB_HOST=localhost
DB_PORT=3306
{{- else if .Components.DatabaseSQLite }}
DB_DATABASE=./_data/sqlite/app.db
{{- end }}
REDIS_HOST=localhost
REDIS_PORT=6379

