# These overrides are typically for networked resource connection details.
{{- if .Resources.DatabasePostgres }}
{{- if not .Resources.DatabaseExternal }}
DB_HOST=localhost
DB_PORT=5432
{{- end }}
{{- else if .Resources.DatabaseMySQL }}
{{- if not .Resources.DatabaseExternal }}
DB_HOST=localhost
DB_PORT=3306
{{- end }}
{{- else if .Resources.DatabaseSQLite }}
DB_DATABASE=./_data/sqlite/app.db
{{- end }}
{{- if and .Resources.RedisSupported (not .Resources.RedisExternal) }}
REDIS_HOST=localhost
REDIS_PORT=6379
{{- end }}
{{- if and .Components.Mail .Components.Docker }}
MAIL_SMTP_HOST=localhost
{{- end }}
