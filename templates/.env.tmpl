# App
APP_NAME={{ .ProjectName }}
APP_KEY={{ .AppKey }}
APP_DIAG_TOKEN={{ .AppDiagToken }}
APP_ENV=local
APP_DEBUG=0
APP_URL=http://localhost:3000
APP_SHUTDOWN_TIMEOUT=30s

# Forj
FORJ_MAKE_OPEN=auto # options: auto, always, never
# Optional editor command for make commands; falls back to common GUI editors.
FORJ_EDITOR=

# Logging
APP_LOG_CALLER=0 # set to 1/true to show caller metadata (caller=pkg.Func) in log output
APP_LOG_FORMAT=console # options: console, json
APP_LOG_TIME=1 # show timestamps in console/json log output
APP_LOG_DEDUPE_ENABLED=true # coalesce repeated similar logs (1000 identical logs will be output as "last log message" (x1000))

# Lighthouse
LIGHTHOUSE_ENABLED=true
LIGHTHOUSE_URL=ws://localhost:3000/lighthouse/ws/agent
LIGHTHOUSE_SECRET={{ .LighthouseSecret }}
LIGHTHOUSE_INSPECT_MAX_TOTAL=250
LIGHTHOUSE_INSPECT_MAX_INFLIGHT=100
LIGHTHOUSE_INSPECT_MAX_EVENTS=200
LIGHTHOUSE_INSPECT_SAMPLE_RATE=1.0

# API
{{- if .Components.Auth }}
API_JWT_SECRET_KEY={{ .JWTSecretKey }}
{{- end }}
API_SWAGGER_ENABLED=true
API_HTTP_HOST=0.0.0.0
API_HTTP_PORT=3000
{{- if .ProjectComponents.Metrics }}
METRICS_PORT=10000
METRICS_API_PORT=10000
METRICS_HTTP_ENABLED=true
{{- if .ProjectComponents.Cache }}
METRICS_CACHE_ENABLED=true
{{- end }}
{{- if .ProjectComponents.Storage }}
METRICS_STORAGE_ENABLED=true
{{- end }}
{{- if .ProjectComponents.Events }}
METRICS_EVENTS_ENABLED=true
{{- end }}
{{- if .Components.Mail }}
METRICS_MAIL_ENABLED=true
{{- end }}
{{- if .ProjectComponents.Jobs }}
METRICS_QUEUE_ENABLED=true
{{- end }}
{{- if .Components.HasDatabase }}
METRICS_DATABASE_ENABLED=true
{{- end }}
{{- if .Components.Auth }}
METRICS_AUTH_ENABLED=true
{{- end }}
{{- if .Components.Scheduler }}
METRICS_SCHEDULER_ENABLED=true
{{- end }}
{{- end }}

{{- if .Components.WebUI }}
# Frontend
# FRONTEND_* is exposed to browser code as import.meta.env.VITE_*.
# <APP>_FRONTEND_* overrides values for a named app, such as MARKETPLACE_FRONTEND_BACKEND_URL.
# FRONTEND_BACKEND_URL=http://localhost:3000
FRONTEND_APP_ENV=local
{{- if .Components.Auth }}
FRONTEND_AUTH_PASSWORD_MIN_LENGTH=8
FRONTEND_AUTH_PASSWORD_REQUIRE_UPPER=true
FRONTEND_AUTH_PASSWORD_REQUIRE_LOWER=false
FRONTEND_AUTH_PASSWORD_REQUIRE_NUMBER=false
FRONTEND_AUTH_PASSWORD_REQUIRE_SYMBOL=true
{{- end }}

{{- end }}

{{- if .Components.Auth }}
# Auth
# Short-lived bearer token used on authenticated requests. Refreshed while the session remains valid.
AUTH_ACCESS_TOKEN_TTL=15m
# Maximum inactivity window before the user must sign in again.
AUTH_SESSION_IDLE_TTL=2h
# Absolute session lifetime before the user must authenticate again, even if they remain active.
AUTH_SESSION_TTL=24h
# Absolute session lifetime when "Remember me" is selected at login.
AUTH_REMEMBER_SESSION_TTL=720h
AUTH_COOKIE_SECURE=auto
# Failed login attempts allowed before the account is temporarily locked.
AUTH_LOGIN_LOCKOUT_ATTEMPTS=5
# How long the temporary login lockout lasts after too many failed attempts.
AUTH_LOGIN_LOCKOUT_DURATION=15m
# Login attempts allowed within the rate limit window before requests are throttled.
AUTH_LOGIN_RATE_LIMIT_ATTEMPTS=10
# Time window used for login request throttling.
AUTH_LOGIN_RATE_LIMIT_DURATION=15m
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_EMAIL=admin@example.com
AUTH_BOOTSTRAP_PASSWORD=admin
{{- if .Components.OAuth }}
# OAuth
# AUTH_OAUTH_STATE_TTL=10m
# AUTH_OAUTH_GITHUB_CLIENT_ID=
# AUTH_OAUTH_GITHUB_CLIENT_SECRET=
# AUTH_OAUTH_GOOGLE_CLIENT_ID=
# AUTH_OAUTH_GOOGLE_CLIENT_SECRET=
# AUTH_OAUTH_MICROSOFT_CLIENT_ID=
# AUTH_OAUTH_MICROSOFT_CLIENT_SECRET=
# AUTH_OAUTH_MICROSOFT_TENANT=common
# AUTH_OAUTH_APPLE_CLIENT_ID=
# AUTH_OAUTH_APPLE_TEAM_ID=
# AUTH_OAUTH_APPLE_KEY_ID=
# AUTH_OAUTH_APPLE_PRIVATE_KEY=
{{- end }}
{{- end }}

{{- if .Components.Mail }}
# Mail
MAIL_DRIVER={{ .Resources.MailDriver }} # options: log, smtp, resend, postmark, mailgun, sendgrid, ses
MAIL_SUPPORTED_DRIVERS={{ .Resources.MailSupportedDrivers }} # comma separated driver names; options: log, smtp, resend, postmark, mailgun, sendgrid, ses
{{- if .Components.Docker }}
MAIL_SMTP_HOST=mailpit
{{- else }}
MAIL_SMTP_HOST=localhost
{{- end }}
MAIL_SMTP_PORT=1025
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_IDENTITY=
MAIL_SMTP_FORCE_TLS=false
{{- if .Components.Docker }}
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
{{- end }}
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME={{ .ProjectName }}
MAIL_LOG_BODIES=false
{{- end }}

{{- if .Components.Observability }}
# Observability
OBSERVABILITY_VM_PORT=8428
OBSERVABILITY_METRICS_TARGET_MODE=auto # options: auto, local-single, local-multi, compose, disabled
OBSERVABILITY_METRICS_TARGET_HOST=host.docker.internal # leave empty to keep your own metrics-targets.json
# OBSERVABILITY_API_METRICS_HOST=api
{{- if .ProjectComponents.Jobs }}
# OBSERVABILITY_JOBS_METRICS_HOST=jobs
{{- end }}
# OBSERVABILITY_SCHEDULER_METRICS_HOST=scheduler
{{- if .Components.Grafana }}
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=13001
{{- end }}
{{- end }}

# Database
{{- if .Resources.DatabasePostgres }}
DB_DRIVER={{ .Resources.DatabaseDriver }} # options: sqlite, mysql, postgres
DB_SUPPORTED_DRIVERS={{ .Resources.DatabaseSupportedDrivers }} # comma separated multiple driver names (sqlite,mysql,postgres)
{{- if .Resources.DatabaseExternal }}
DB_HOST=
{{- else }}
DB_HOST=postgres
{{- end }}
DB_DATABASE=app
DB_SQLITE_DATABASE=./_data/sqlite/app.db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5432
DB_QUERY_LOGGING=false
# Queries at or above this duration are tracked as slow queries with fingerprints.
DB_SLOW_QUERY_THRESHOLD=250ms
{{- else if .Resources.DatabaseMySQL }}
DB_DRIVER={{ .Resources.DatabaseDriver }} # options: sqlite, mysql, postgres
DB_SUPPORTED_DRIVERS={{ .Resources.DatabaseSupportedDrivers }} # comma separated multiple driver names (sqlite,mysql,postgres)
{{- if .Resources.DatabaseExternal }}
DB_HOST=
{{- else }}
DB_HOST=mysql
{{- end }}
DB_DATABASE=db
DB_SQLITE_DATABASE=./_data/sqlite/app.db
DB_USERNAME=user
DB_PASSWORD=password
DB_PORT=3306
DB_ROOT_PASSWORD=root
DB_QUERY_LOGGING=false
# Queries at or above this duration are tracked as slow queries with fingerprints.
DB_SLOW_QUERY_THRESHOLD=250ms
{{- else if .Resources.DatabaseSQLite }}
DB_DRIVER={{ .Resources.DatabaseDriver }} # options: sqlite, mysql, postgres
DB_SUPPORTED_DRIVERS={{ .Resources.DatabaseSupportedDrivers }} # comma separated multiple driver names (sqlite,mysql,postgres)
DB_DATABASE=./_data/sqlite/app.db
DB_QUERY_LOGGING=false
# Queries at or above this duration are tracked as slow queries with fingerprints.
DB_SLOW_QUERY_THRESHOLD=250ms
{{- end }}

{{- if .Resources.RedisSupported }}
# Redis
{{- if .Resources.RedisLocal }}
COMPOSE_PROFILES=redis
{{- end }}
{{- if .Resources.RedisExternal }}
REDIS_HOST=
{{- else if .Components.Docker }}
REDIS_HOST=redis
{{- else }}
REDIS_HOST=
{{- end }}
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
{{- end }}

{{- if .ProjectComponents.Cache }}
# Cache
CACHE_DRIVER={{ .Resources.CacheDriver }} # options: memory, file, null, redis, memcached, dynamodb, sqlite, postgres, mysql, nats
CACHE_SUPPORTED_DRIVERS={{ .Resources.CacheSupportedDrivers }} # comma separated driver names; options: memory, file, null, redis, memcached, dynamodb, sqlite, postgres, mysql, nats
CACHE_PREFIX=app
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_MEMORY_CLEANUP_SECONDS=600
{{- if .ProjectComponents.DemoApp }}
CACHE_SETTINGS_DRIVER={{ .Resources.CacheSettingsDriver }}
{{- end }}
{{- if .ProjectComponents.Auth }}
CACHE_SESSIONS_DRIVER={{ .Resources.CacheSessionsDriver }}
{{- end }}
{{- range .RuntimeApps }}
{{- if and .EnvPrefix .Components.Cache }}
{{ .EnvPrefix }}_CACHE_DRIVER={{ $.Resources.CacheDriver }}
{{- end }}
{{- end }}
{{- end }}

{{- if .ProjectComponents.Storage }}
# File Storage
STORAGE_DRIVER={{ .Resources.StorageDriver }} # options: local, memory, redis, ftp, sftp, s3, gcs, dropbox, rclone
STORAGE_SUPPORTED_DRIVERS={{ .Resources.StorageSupportedDrivers }} # comma separated driver names; options: local, memory, redis, ftp, sftp, s3, gcs, dropbox, rclone
STORAGE_ROOT=storage/app/private
STORAGE_PREFIX=
STORAGE_PUBLIC_DRIVER={{ .Resources.StoragePublicDriver }} # options: local, memory, redis, ftp, sftp, s3, gcs, dropbox, rclone
STORAGE_PUBLIC_ROOT=storage/app/public
STORAGE_PUBLIC_PREFIX=
{{- if .Components.DemoApp }}
STORAGE_FAVICONS_DRIVER={{ .Resources.StorageFaviconsDriver }} # options: local, memory, redis, ftp, sftp, s3, gcs, dropbox, rclone
STORAGE_FAVICONS_ROOT=storage/app/favicons
STORAGE_FAVICONS_PREFIX=
{{- end }}
{{- range .RuntimeApps }}
{{- if and .EnvPrefix .Components.Storage }}
{{ .EnvPrefix }}_STORAGE_DRIVER={{ $.Resources.StorageDriver }}
{{- end }}
{{- end }}
{{- end }}

{{- if .ProjectComponents.Events }}
# Events
EVENTS_DRIVER={{ .Resources.EventsDriver }} # options: inproc, null, redis, nats, natsjetstream, kafka, gcppubsub, sns
EVENTS_SUPPORTED_DRIVERS={{ .Resources.EventsSupportedDrivers }} # comma separated driver names; options: inproc, null, redis, nats, natsjetstream, kafka, gcppubsub, sns
EVENTS_REDIS_CHANNEL_PREFIX=events
EVENTS_INPROC_WORKERS=0 # <=0 defaults to CPU count
EVENTS_INPROC_BUFFER=1024
{{- range .RuntimeApps }}
{{- if and .EnvPrefix .Components.Events }}
{{ .EnvPrefix }}_EVENTS_DRIVER={{ $.Resources.EventsDriver }}
{{- end }}
{{- end }}
{{- end }}

# Scheduler
SCHEDULER_COMMAND_TIMEOUT=10m
SCHEDULER_SUBPROCESS_SHUTDOWN_TIMEOUT=90s
{{- if and .Components.Metrics .Components.Scheduler }}
METRICS_SCHEDULER_PORT=10001
{{- end }}

{{- if .ProjectComponents.Jobs }}

# Queue
QUEUE_DRIVER={{ .Resources.QueueDriver }} # options: null, sync, workerpool, redis, nats, sqs, rabbitmq, sqlite, postgres, mysql
QUEUE_SUPPORTED_DRIVERS={{ .Resources.QueueSupportedDrivers }} # comma separated driver names; options: null, sync, workerpool, redis, nats, sqs, rabbitmq, sqlite, postgres, mysql
QUEUE_WORKERS=30
QUEUE_NAME=default
QUEUE_SERVER_LOG_LEVEL=error # redis only; options: debug, info, warn, error, fatal
QUEUE_SHUTDOWN_TIMEOUT=10s
# Named queues can prioritize work by allocating workers:
# QUEUE_EMAILS_NAME=emails
# QUEUE_EMAILS_WORKERS=6
# QUEUE_REPORTS_NAME=reports
# QUEUE_REPORTS_WORKERS=2
{{- range .RuntimeApps }}
{{- if and .EnvPrefix .Components.Jobs }}
{{ .EnvPrefix }}_QUEUE_DRIVER={{ $.Resources.QueueDriver }}
{{- end }}
{{- end }}
{{- if .ProjectComponents.Metrics }}
METRICS_JOBS_PORT=10002
{{- end }}
{{- end }}

{{- with .Resources.DriverEnvironmentPlaceholders }}

# Advanced driver configuration
# Uncomment only the values required by the selected driver and deployment.
{{ . }}
{{- end }}

# Docker
IP_ADDRESS=0.0.0.0
