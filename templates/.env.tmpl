# App
APP_NAME={{ .ProjectName }}
APP_KEY={{ .AppKey }}
APP_DIAG_TOKEN={{ .AppDiagToken }}
APP_ENV=local
APP_DEBUG=0
APP_URL=http://localhost:3000
APP_SHUTDOWN_TIMEOUT=30s

# Logging
APP_LOG_CALLER=1 # show caller metadata (#pkg.Func) in log output
APP_LOG_FORMAT=console # options: console, json
APP_LOG_TIME=1 # show timestamps in console/json log output
APP_LOG_DEDUPE_ENABLED=true # coalesce repeated similar logs (1000 identical logs will be output as "last log message" (x1000))

# Lighthouse
LIGHTHOUSE_ENABLED=true
LIGHTHOUSE_URL=ws://localhost:3000/lighthouse/ws/agent
LIGHTHOUSE_TOKEN={{ .LighthouseToken }}

# API
{{- if .Components.Auth }}
API_JWT_SECRET_KEY={{ .JWTSecretKey }}
{{- end }}
API_SWAGGER_ENABLED=true
API_HTTP_HOST=0.0.0.0
API_HTTP_PORT=3000

{{- if .Components.Auth }}
# Auth
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
AUTH_COOKIE_SECURE=auto
AUTH_BOOTSTRAP_ENABLED=true
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_EMAIL=admin@example.com
AUTH_BOOTSTRAP_PASSWORD=admin
{{- end }}

# Database
{{- if .Components.DatabasePostgres }}
DB_DRIVER=postgres # options: sqlite, mysql, postgres
DB_SUPPORTED_DRIVERS=postgres # comma separated multiple driver names (sqlite,mysql,postgres)
DB_HOST=postgres
DB_DATABASE=app
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5432
DB_QUERY_LOGGING=false
{{- else if .Components.DatabaseMySQL }}
DB_DRIVER=mysql # options: sqlite, mysql, postgres
{{- if .Components.DemoApp }}
DB_SUPPORTED_DRIVERS=sqlite,mysql # comma separated multiple driver names (sqlite,mysql,postgres)
{{- else }}
DB_SUPPORTED_DRIVERS=mysql # comma separated multiple driver names (sqlite,mysql,postgres)
{{- end }}
DB_HOST=mysql
DB_DATABASE=db
DB_USERNAME=user
DB_PASSWORD=password
DB_PORT=3306
DB_ROOT_PASSWORD=root
DB_QUERY_LOGGING=false
{{- else if .Components.DatabaseSQLite }}
DB_DRIVER=sqlite # options: sqlite, mysql, postgres
DB_SUPPORTED_DRIVERS=sqlite # comma separated multiple driver names (sqlite,mysql,postgres)
DB_DATABASE=./_data/sqlite/app.db
DB_QUERY_LOGGING=false
{{- end }}

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cache
CACHE_DRIVER=memory # options: memory, file, null, redis, memcached, dynamodb, sqlite, postgres, mysql, nats
CACHE_SUPPORTED_DRIVERS=memory # comma separated driver names; options: memory, file, null, redis, memcached, dynamodb, sqlite, postgres, mysql, nats
CACHE_PREFIX=app
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_MEMORY_CLEANUP_SECONDS=600
{{- if .Components.DemoApp }}
CACHE_SETTINGS_DRIVER=memory
{{- end }}

# File Storage
STORAGE_DRIVER=local # options: local, memory, redis, ftp, sftp, s3, gcs, dropbox, rclone
STORAGE_SUPPORTED_DRIVERS=local # comma separated driver names; options: local, memory, redis, ftp, sftp, s3, gcs, dropbox, rclone
STORAGE_ROOT=storage/app/private
STORAGE_PREFIX=
STORAGE_PUBLIC_DRIVER=local # options: local, memory, redis, ftp, sftp, s3, gcs, dropbox, rclone
STORAGE_PUBLIC_ROOT=storage/app/public
STORAGE_PUBLIC_PREFIX=
{{- if .Components.DemoApp }}
STORAGE_FAVICONS_DRIVER=local # options: local, memory, redis, ftp, sftp, s3, gcs, dropbox, rclone
STORAGE_FAVICONS_ROOT=storage/app/favicons
STORAGE_FAVICONS_PREFIX=
{{- end }}

# Events
EVENTS_DRIVER=inproc # options: inproc, null, redis, nats, natsjetstream, kafka, gcppubsub, sns
EVENTS_SUPPORTED_DRIVERS=inproc # comma separated driver names; options: inproc, null, redis, nats, natsjetstream, kafka, gcppubsub, sns
EVENTS_REDIS_CHANNEL_PREFIX=events
EVENTS_INPROC_WORKERS=0 # <=0 defaults to CPU count
EVENTS_INPROC_BUFFER=1024

# Scheduler
SCHEDULER_COMMAND_TIMEOUT=10m
SCHEDULER_SUBPROCESS_SHUTDOWN_TIMEOUT=90s

# Queue
{{- if .Render.QueueDriver }}
QUEUE_DRIVER={{ .Render.QueueDriver }} # options: null, sync, workerpool, redis, nats, sqs, rabbitmq, sqlite, postgres, mysql
QUEUE_SUPPORTED_DRIVERS={{ .Render.QueueDriver }} # comma separated driver names; options: null, sync, workerpool, redis, nats, sqs, rabbitmq, sqlite, postgres, mysql
{{- else }}
QUEUE_DRIVER=redis # options: null, sync, workerpool, redis, nats, sqs, rabbitmq, sqlite, postgres, mysql
QUEUE_SUPPORTED_DRIVERS=redis # comma separated driver names; options: null, sync, workerpool, redis, nats, sqs, rabbitmq, sqlite, postgres, mysql
{{- end }}
QUEUE_WORKERS=30
QUEUE_DEFAULT_QUEUE=default
QUEUE_SERVER_LOG_LEVEL=error # redis only; options: debug, info, warn, error, fatal
QUEUE_QUEUES=critical=6,default=3,low=1 # redis only; worker queue weights
QUEUE_SHUTDOWN_TIMEOUT=10s
{{- if and .Components.StressTest .Components.Jobs }}
STRESS_ENABLED=false
STRESS_INTERVAL_SECONDS=2
STRESS_DEFAULT_PER_TICK=2
STRESS_CRITICAL_PER_TICK=1
STRESS_LOW_PER_TICK=1
STRESS_DEFAULT_SLEEP_MS=120
STRESS_CRITICAL_SLEEP_MS=180
STRESS_LOW_SLEEP_MS=60
STRESS_FAIL_EVERY=0
STRESS_LOG_TICKS=false
{{- end }}

# Docker
IP_ADDRESS=0.0.0.0
