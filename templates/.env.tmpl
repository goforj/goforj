# Environment reference: https://goforj.dev/reference/env-vars

# App
APP_NAME={{ .ProjectName }}
APP_KEY={{ .AppKey }}
{{- if or .ProjectComponents.WebAPI .ProjectComponents.WebUI }}
APP_DIAG_TOKEN={{ .AppDiagToken }}
{{- end }}
APP_ENV=local
TZ=UTC
APP_DEBUG=0
{{- if or .ProjectComponents.WebAPI .ProjectComponents.WebUI }}
APP_MAINTENANCE_ENABLED=false
APP_MAINTENANCE_DRIVER=memory
APP_MAINTENANCE_STORE=default
{{- end }}
{{- if .ProjectComponents.WebAPI }}
APP_URL=http://localhost:3000
{{- end }}

# Logging
APP_LOG_FORMAT=console # options: console, json
APP_LOG_TIME=1

# OpenTelemetry
{{- if and .ProjectComponents.Grafana .ProjectComponents.Observability .ProjectComponents.Docker }}
# The local grafana Compose profile exports traces and logs through Alloy automatically.
# Set OTEL_TRACES_EXPORTER=none or OTEL_LOGS_EXPORTER=none to disable either signal.
{{- else }}
# Uncomment the endpoint to export traces. Lighthouse works without a collector.
{{- end }}
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Optional overrides; service name defaults to the Go module path and current app.
# OTEL_SERVICE_NAME=
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_TRACES_EXPORTER=otlp
# Remote logs require explicit selection; a trace endpoint alone does not enable them.
# OTEL_LOGS_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
# OTEL_TRACES_SAMPLER=parentbased_always_on
# OTEL_TRACES_SAMPLER_ARG=1.0 # used by traceidratio and parentbased_traceidratio
# OTEL_SDK_DISABLED=false
# More options: internal/inspects/README.md and internal/logger/README.md
{{- if .ProjectComponents.HasRuntime }}

# Lighthouse
LIGHTHOUSE_ENABLED=true
LIGHTHOUSE_URL=ws://localhost:3000/lighthouse/ws/agent
LIGHTHOUSE_SECRET={{ .LighthouseSecret }}
{{- end }}
{{- if .ProjectComponents.WebAPI }}

# API
{{- if .ProjectComponents.Auth }}
API_JWT_SECRET_KEY={{ .JWTSecretKey }}
{{- end }}
API_OPENAPI_ENABLED=true
API_HTTP_HOST=0.0.0.0
API_HTTP_PORT=3000
{{- end }}
{{- if .ProjectComponents.Metrics }}

# Metrics
METRICS_PORT=10000
{{- if and .Components.Metrics .Components.Scheduler }}
METRICS_SCHEDULER_PORT=10001
{{- end }}
{{- if .ProjectComponents.Jobs }}
METRICS_JOBS_PORT=10002
{{- end }}
{{- end }}

{{- if .ProjectComponents.Auth }}

# Auth
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_EMAIL=admin@example.com
AUTH_BOOTSTRAP_PASSWORD=admin
{{- end }}

{{- if .ProjectComponents.Notification }}

# Notifications
# Synchronous local capture or provider acceptance, without background retries.
# Available drivers: {{ .Resources.NotificationAvailableDrivers }}
NOTIFICATION_DRIVER={{ .Resources.NotificationDriver }}
NOTIFICATION_SUPPORTED_DRIVERS={{ .Resources.NotificationSupportedDrivers }}
{{- end }}
{{- if .ProjectComponents.Mail }}

# Mail
# Available drivers: {{ .Resources.MailAvailableDrivers }}
MAIL_DRIVER={{ .Resources.MailDriver }}
MAIL_SUPPORTED_DRIVERS={{ .Resources.MailSupportedDrivers }}
{{- if eq .Resources.MailDriver "smtp" }}
{{- if .Components.Docker }}
MAIL_SMTP_HOST=mailpit
{{- else }}
MAIL_SMTP_HOST=localhost
{{- end }}
MAIL_SMTP_PORT=1025
{{- end }}
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME={{ .ProjectName }}
{{- if .Components.Docker }}

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
{{- end }}
{{- end }}

{{- if .Components.Observability }}

# Observability
OBSERVABILITY_VM_PORT=8428
{{- if .Components.Grafana }}
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=13001
{{- end }}
{{- end }}

{{- if .ProjectComponents.HasDatabase }}

# Database
# Available drivers: {{ .Resources.DatabaseAvailableDrivers }}
{{- if .Resources.DatabasePostgres }}
DB_DRIVER={{ .Resources.DatabaseDriver }}
DB_SUPPORTED_DRIVERS={{ .Resources.DatabaseSupportedDrivers }}
{{- if .Resources.DatabaseExternal }}
DB_HOST=
{{- else }}
DB_HOST=postgres
{{- end }}
DB_PORT=5432
DB_DATABASE=app
{{- if .ProjectComponents.DatabaseSQLite }}
DB_SQLITE_DATABASE=./_data/sqlite/app.db
{{- end }}
DB_USERNAME=postgres
DB_PASSWORD=postgres
{{- else if .Resources.DatabaseMySQL }}
DB_DRIVER={{ .Resources.DatabaseDriver }}
DB_SUPPORTED_DRIVERS={{ .Resources.DatabaseSupportedDrivers }}
{{- if .Resources.DatabaseExternal }}
DB_HOST=
{{- else }}
DB_HOST=mysql
{{- end }}
DB_PORT=3306
DB_DATABASE=db
{{- if .ProjectComponents.DatabaseSQLite }}
DB_SQLITE_DATABASE=./_data/sqlite/app.db
{{- end }}
DB_USERNAME=user
DB_PASSWORD=password
DB_ROOT_PASSWORD=root
{{- else if .Resources.DatabaseSQLite }}
DB_DRIVER={{ .Resources.DatabaseDriver }}
DB_SUPPORTED_DRIVERS={{ .Resources.DatabaseSupportedDrivers }}
DB_DATABASE=./_data/sqlite/app.db
{{- end }}
{{- end }}

{{- if or .Resources.RedisActive .Resources.RedisLocal }}

# Redis
{{- if .Resources.RedisActive }}
{{- if .Resources.RedisExternal }}
REDIS_HOST=
{{- else if .Components.Docker }}
REDIS_HOST=redis
{{- else }}
REDIS_HOST=
{{- end }}
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
{{- end }}
{{- end }}

{{- if .ProjectComponents.Cache }}

# Cache
# Available drivers: {{ .Resources.CacheAvailableDrivers }}
CACHE_DRIVER={{ .Resources.CacheDriver }}
CACHE_SUPPORTED_DRIVERS={{ .Resources.CacheSupportedDrivers }}
{{- if .Resources.CacheMemcachedLocal }}
CACHE_ADDRESSES=memcached:11211
{{- end }}
{{- if .Resources.CacheDynamoDBLocal }}
CACHE_REGION=us-east-1
CACHE_ENDPOINT=http://dynamodb:8000
{{- end }}
{{- if .Resources.CacheNATSLocal }}
CACHE_URL=nats://goforj:goforj@nats:4222
{{- end }}
{{- if .ProjectComponents.DemoApp }}
CACHE_SETTINGS_DRIVER={{ .Resources.CacheSettingsDriver }}
{{- end }}
{{- if .ProjectComponents.Auth }}
CACHE_SESSIONS_DRIVER={{ .Resources.CacheSessionsDriver }}
{{- end }}
{{- range .RuntimeApps }}
{{- if and .EnvPrefix .Components.Cache }}
{{ .EnvPrefix }}_CACHE_DRIVER={{ $.Resources.CacheDriver }}
{{- end }}
{{- end }}
{{- end }}

{{- if .ProjectComponents.Feature }}

# Feature evaluator resources (flag names remain in each definition document).
FEATURE_DRIVER={{ .Resources.FeatureDriver }}
FEATURE_SUPPORTED_DRIVERS={{ .Resources.FeatureSupportedDrivers }}
# Memory sources start empty; file sources load definitions from FEATURE_PATH.
{{- range .RuntimeApps }}
{{- if and .EnvPrefix .Components.Feature }}
{{ .EnvPrefix }}_FEATURE_DRIVER={{ $.Resources.FeatureDriver }}
{{- end }}
{{- end }}
{{- end }}

{{- if .ProjectComponents.Search }}

# Search indexes are defined in each App's search.go. Provision schemas explicitly before starting.
SEARCH_DRIVER={{ .Resources.SearchDriver }}
SEARCH_SUPPORTED_DRIVERS={{ .Resources.SearchSupportedDrivers }}
SEARCH_PATH=storage/search
{{- range .RuntimeApps }}
{{- if and .EnvPrefix .Components.Search }}
{{ .EnvPrefix }}_SEARCH_DRIVER={{ $.Resources.SearchDriver }}
{{ .EnvPrefix }}_SEARCH_PATH=storage/search/{{ .Name }}
{{- end }}
{{- end }}
{{- end }}

{{- if .ProjectComponents.Storage }}

# File Storage
# Available drivers: {{ .Resources.StorageAvailableDrivers }}
STORAGE_DRIVER={{ .Resources.StorageDriver }}
STORAGE_SUPPORTED_DRIVERS={{ .Resources.StorageSupportedDrivers }}
STORAGE_ROOT=storage/app/private
STORAGE_PUBLIC_DRIVER={{ .Resources.StoragePublicDriver }}
STORAGE_PUBLIC_ROOT=storage/app/public
{{- if .Components.DemoApp }}
STORAGE_FAVICONS_DRIVER={{ .Resources.StorageFaviconsDriver }}
STORAGE_FAVICONS_ROOT=storage/app/favicons
{{- end }}
{{- range .RuntimeApps }}
{{- if and .EnvPrefix .Components.Storage }}
{{ .EnvPrefix }}_STORAGE_DRIVER={{ $.Resources.StorageDriver }}
{{- end }}
{{- end }}
{{- end }}

{{- if .ProjectComponents.Events }}

# Events
# Available drivers: {{ .Resources.EventsAvailableDrivers }}
EVENTS_DRIVER={{ .Resources.EventsDriver }}
EVENTS_SUPPORTED_DRIVERS={{ .Resources.EventsSupportedDrivers }}
# Disable while upgrading Redis subscribers that cannot decode context envelopes.
EVENTS_CONTEXT_PROPAGATION_ENABLED=true
{{- if .Resources.EventsNATSLocal }}
EVENTS_URL=nats://goforj:goforj@nats:4222
{{- end }}
{{- if .Resources.EventsKafkaLocal }}
EVENTS_BROKERS=redpanda:9092
{{- end }}
{{- if .Resources.EventsGCPPubSubLocal }}
EVENTS_PROJECT_ID=goforj-local
EVENTS_URI=gcppubsub:8085
{{- end }}
{{- range .RuntimeApps }}
{{- if and .EnvPrefix .Components.Events }}
{{ .EnvPrefix }}_EVENTS_DRIVER={{ $.Resources.EventsDriver }}
{{- end }}
{{- end }}
{{- end }}

{{- if .ProjectComponents.Jobs }}

# Queue
# Available drivers: {{ .Resources.QueueAvailableDrivers }}
QUEUE_DRIVER={{ .Resources.QueueDriver }}
QUEUE_SUPPORTED_DRIVERS={{ .Resources.QueueSupportedDrivers }}
{{- if .Resources.QueueNATSLocal }}
QUEUE_URL=nats://goforj:goforj@nats:4222
{{- else if .Resources.QueueRabbitMQLocal }}
QUEUE_URL=amqp://goforj:goforj@rabbitmq:5672/
{{- end }}
{{- if .Resources.QueueSQSLocal }}
QUEUE_REGION=elasticmq
QUEUE_ENDPOINT=http://elasticmq:9324
QUEUE_ACCESS_KEY=x
QUEUE_SECRET_KEY=x
{{- end }}
QUEUE_WORKERS={{if eq .Render.Example "gopher_eats"}}1{{else}}30{{end}}
QUEUE_SHUTDOWN_TIMEOUT=10s
{{- range .RuntimeApps }}
{{- if and .EnvPrefix .Components.Jobs }}
{{ .EnvPrefix }}_QUEUE_DRIVER={{ $.Resources.QueueDriver }}
{{- end }}
{{- end }}
{{- end }}

{{- if .ProjectComponents.Scheduler }}

# Runtime
SCHEDULER_SUBPROCESS_SHUTDOWN_TIMEOUT=
{{- end }}

{{- if .Components.Docker }}

# Development Services
## Available Compose profiles:
{{- if .Resources.DatabaseMySQL }}
##   mysql
{{- end }}
{{- if .Resources.DatabasePostgres }}
##   postgres
{{- end }}
{{- range .Resources.DevelopmentServiceProfileLines }}
##   {{ . }}
{{- end }}
## Enable any comma-separated subset; services stay dormant when this is empty.
## Compose settings: https://goforj.dev/reference/env-vars#development-service-compose-settings
COMPOSE_PROFILES={{ .Resources.ComposeProfiles }}

# Docker
IP_ADDRESS=127.0.0.1
{{- end }}
