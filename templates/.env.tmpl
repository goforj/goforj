# App
APP_NAME={{ .ProjectName }}
APP_KEY={{ .AppKey }}
APP_ENV=local
APP_DEBUG=0
APP_URL=http://localhost:3000
APP_SHUTDOWN_TIMEOUT_SECONDS=30

# Logging
APP_LOG_CALLER=1 # show caller metadata (#pkg.Func) in log output
APP_LOG_FORMAT=console # options: console, json

# Dev Console
DEVCONSOLE_ENABLED=true
DEVCONSOLE_URL=ws://localhost:3000/__devconsole/ws/agent
DEVCONSOLE_TOKEN={{ .DevConsoleToken }}

# API
API_JWT_SECRET_KEY={{ .JWTSecretKey }}
API_SWAGGER_ENABLED=true

# Database
{{- if .Components.DatabasePostgres }}
DB_DRIVER=postgres
DB_SUPPORTED_DRIVERS=postgres # comma separated multiple driver names (sqlite,mysql,postgres)
DB_HOST=postgres
DB_DATABASE=app
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5432
DB_QUERY_LOGGING=false
{{- else if .Components.DatabaseMySQL }}
DB_DRIVER=mysql
{{- if .Components.DemoApp }}
DB_SUPPORTED_DRIVERS=sqlite,mysql # comma separated multiple driver names (sqlite,mysql,postgres)
{{- else }}
DB_SUPPORTED_DRIVERS=mysql # comma separated multiple driver names (sqlite,mysql,postgres)
{{- end }}
DB_HOST=mysql
DB_DATABASE=db
DB_USERNAME=user
DB_PASSWORD=password
DB_PORT=3306
DB_ROOT_PASSWORD=root
DB_QUERY_LOGGING=false
{{- else if .Components.DatabaseSQLite }}
DB_DRIVER=sqlite
DB_SUPPORTED_DRIVERS=sqlite # comma separated multiple driver names (sqlite,mysql,postgres)
DB_DATABASE=./_data/sqlite/app.db
DB_QUERY_LOGGING=false
{{- end }}

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cache
CACHE_DRIVER=memory # options: memory, redis
CACHE_PREFIX=app
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_MEMORY_CLEANUP_SECONDS=600

# Events
EVENTS_DRIVER=inproc # options: inproc, redis
EVENTS_REDIS_CHANNEL_PREFIX=events
EVENTS_INPROC_WORKERS=0 # <=0 defaults to CPU count
EVENTS_INPROC_BUFFER=1024

# Scheduler
SCHEDULER_COMMAND_TIMEOUT_SECONDS=600
SCHEDULER_SUBPROCESS_SHUTDOWN_TIMEOUT_SECONDS=90

# Queue
{{- if .Render.QueueDriver }}
QUEUE_DRIVER={{ .Render.QueueDriver }} # options: redis, sync, workerpool
{{- else }}
QUEUE_DRIVER=redis # options: redis, sync, workerpool
{{- end }}
QUEUE_REDIS_LOG_LEVEL=error # options: debug, info, warn, error, fatal
{{- if eq .Render.QueueDriver "workerpool" }}
QUEUE_WORKERPOOL_WORKERS=0 # default: CPU count when <= 0
QUEUE_WORKERPOOL_BUFFER=1024
QUEUE_WORKERPOOL_TASK_TIMEOUT_SECONDS=60
QUEUE_WORKERPOOL_SHUTDOWN_TIMEOUT_SECONDS=90
{{- end }}
{{- if and .Components.StressTest .Components.Jobs }}
QUEUE_STRESS_ENABLED=false
QUEUE_STRESS_INTERVAL_SECONDS=2
QUEUE_STRESS_DEFAULT_PER_TICK=2
QUEUE_STRESS_CRITICAL_PER_TICK=1
QUEUE_STRESS_LOW_PER_TICK=1
QUEUE_STRESS_DEFAULT_SLEEP_MS=120
QUEUE_STRESS_CRITICAL_SLEEP_MS=180
QUEUE_STRESS_LOW_SLEEP_MS=60
QUEUE_STRESS_FAIL_EVERY=0
QUEUE_STRESS_LOG_TICKS=false
{{- end }}

{{- if .Components.Jobs }}
# Jobs
ASYNQ_MONITOR_USERNAME=admin
ASYNQ_MONITOR_PASSWORD=admin
ASYNQ_MONITOR_URI=/monitoring/tasks/
{{- end}}

# Docker
IP_ADDRESS=0.0.0.0
