package {{.AppPackageName}}

import (
	"github.com/goforj/web"
	{{if and .Components.Auth .Components.HasDatabase}}"{{.GoModuleName}}/internal/auth"{{end}}
	{{if and .Components.DemoApp .Components.HasDatabase}}"{{.GoModuleName}}/internal/appsettings"{{end}}
	"{{.GoModuleName}}/internal/hello"
	{{if and .Components.DemoApp .Components.HasDatabase}}"{{.GoModuleName}}/internal/monitoring"{{end}}
	{{if eq .StarterKit "templ_htmx"}}"{{.GoModuleName}}/internal/starterui"{{end}}
	"slices"
)

// ProvideRoutes provides route groups for the HTTP server.
func ProvideRoutes(
	{{if and .Components.Auth .Components.HasDatabase (ne .StarterKit "templ_htmx")}}authController *auth.Controller,{{end}}
	helloController *hello.Controller,
	{{if and .Components.DemoApp .Components.HasDatabase}}appsettingsController *appsettings.Controller,{{end}}
	{{if and .Components.DemoApp .Components.HasDatabase}}monitoringController *monitoring.Controller,{{end}}
	{{if eq .StarterKit "templ_htmx"}}starterUIController *starterui.Controller,{{end}}
	{{if and .Components.Auth .Components.HasDatabase}}authService *auth.Service,{{end}}
) []web.RouteGroup {
	{{- if eq .StarterKit "templ_htmx"}}
	pageRoutes := starterUIController.Routes()
	{{- end}}
	{{- if and .Components.Auth .Components.HasDatabase}}
	groups := []web.RouteGroup{
		{{if eq .StarterKit "templ_htmx"}}web.NewRouteGroup("", pageRoutes),{{end}}
	}
	{{- if or (ne .StarterKit "templ_htmx") (and .Components.DemoApp .Components.HasDatabase)}}
	publicRoutes := slices.Concat(
		{{if ne .StarterKit "templ_htmx"}}authController.Routes(),{{end}}
		{{if and .Components.DemoApp .Components.HasDatabase}}monitoringController.PublicRoutes(),{{end}}
	)
	groups = append(groups, web.NewRouteGroup("/api/v1", publicRoutes))
	{{- end}}
	protectedRoutes := slices.Concat(
		helloController.Routes(),
		{{if and .Components.DemoApp .Components.HasDatabase}}appsettingsController.Routes(),{{end}}
		{{if and .Components.DemoApp .Components.HasDatabase}}monitoringController.ProtectedRoutes(),{{end}}
	)
	groups = append(groups, web.NewRouteGroup("/api/v1", protectedRoutes, authService.RequireAuth))
	return groups
	{{- else}}
	publicRoutes := slices.Concat(
		helloController.Routes(),
		{{if and .Components.DemoApp .Components.HasDatabase}}appsettingsController.Routes(),{{end}}
		{{if and .Components.DemoApp .Components.HasDatabase}}monitoringController.PublicRoutes(),{{end}}
		{{if and .Components.DemoApp .Components.HasDatabase}}monitoringController.ProtectedRoutes(),{{end}}
	)

	return []web.RouteGroup{
		{{if eq .StarterKit "templ_htmx"}}web.NewRouteGroup("", pageRoutes),{{end}}
		web.NewRouteGroup("/api/v1", publicRoutes),
	}
	{{- end}}
}
