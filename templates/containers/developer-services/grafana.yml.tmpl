{{- define "developer-service-grafana-volumes" }}
  grafana:
    driver: local
{{ end -}}

{{- define "developer-service-grafana-services" }}
  grafana:
    profiles: [grafana]
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
{{- if .Components.Grafana }}
    build:
      context: ./containers/observability/grafana
{{- else }}
    image: grafana/grafana:12.0.2
{{- end }}
    depends_on:
      - victoriametrics
    ports:
      - ${IP_ADDRESS:-127.0.0.1}:${GRAFANA_PORT:-13001}:3000
    environment:
      - TZ=${TZ:-UTC}
      - GF_SECURITY_ADMIN_USER=${GRAFANA_ADMIN_USER:-admin}
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD:-admin}
      - GF_USERS_ALLOW_SIGN_UP=false
    volumes:
      - grafana:/var/lib/grafana
    networks:
      - backend
{{- if .Components.Grafana }}

  grafana-seed:
    profiles: [grafana]
    restart: "no"
    stop_grace_period: 1s
    security_opt:
      - no-new-privileges:true
    build:
      context: ./containers/observability/grafana
      dockerfile: Dockerfile.seed
    depends_on:
      - grafana
    environment:
      - TZ=${TZ:-UTC}
      - GRAFANA_URL=http://grafana:3000
      - GRAFANA_ADMIN_USER=${GRAFANA_ADMIN_USER:-admin}
      - GRAFANA_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD:-admin}
    entrypoint: ["sh"]
    command: ["/seed-dashboards.sh"]
    networks:
      - backend
{{- end }}
{{ end -}}
