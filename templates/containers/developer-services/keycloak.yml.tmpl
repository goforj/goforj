{{- define "developer-service-keycloak-volumes" }}
  keycloak:
    driver: local
{{ end -}}

{{- define "developer-service-keycloak-services" }}
  keycloak:
    profiles: [keycloak]
    x-forj-test: false
    restart: unless-stopped
    image: quay.io/keycloak/keycloak:26.7.0
    security_opt:
      - no-new-privileges:true
    mem_limit: ${KEYCLOAK_MEMORY_LIMIT:-1g}
    stop_grace_period: 30s
    command: ["start-dev"]
    environment:
      - TZ=${TZ:-UTC}
      - KC_HEALTH_ENABLED=true
      - KC_BOOTSTRAP_ADMIN_USERNAME=${KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME:-admin}
      - KC_BOOTSTRAP_ADMIN_PASSWORD=${KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD:-G0Forj-Local-Keycloak!}
    ports:
      - ${DEV_SERVICE_IP_ADDRESS:-127.0.0.1}:${KEYCLOAK_HTTP_PORT:-8180}:8080
    volumes:
      - keycloak:/opt/keycloak/data
    healthcheck:
      test: ["CMD-SHELL", "{ printf 'HEAD /health/ready HTTP/1.0\\r\\n\\r\\n' >&0; grep 'HTTP/1.0 200'; } 0<>/dev/tcp/localhost/9000"]
      interval: 10s
      timeout: 5s
      retries: 15
      start_period: 60s
    networks:
      - backend
{{ end -}}
