{{- define "developer-service-mailpit-volumes" }}{{ end -}}

{{- define "developer-service-mailpit-services" }}
  mailpit:
    profiles: [mailpit]
    restart: unless-stopped
    image: axllent/mailpit:v1.30.4
    security_opt:
      - no-new-privileges:true
    environment:
      - TZ=${TZ:-UTC}
    ports:
      - ${IP_ADDRESS:-${DEV_SERVICE_IP_ADDRESS:-127.0.0.1}}:${MAILPIT_SMTP_PORT:-1025}:1025
      - ${IP_ADDRESS:-${DEV_SERVICE_IP_ADDRESS:-127.0.0.1}}:${MAILPIT_HTTP_PORT:-8025}:8025
    networks:
      - backend
{{ end -}}
