{{- define "developer-service-memcached-volumes" }}{{ end -}}

{{- define "developer-service-memcached-services" }}
  memcached:
    profiles: [memcached]
    restart: unless-stopped
    image: memcached:1.6.44-alpine
    security_opt:
      - no-new-privileges:true
    command: ["memcached", "--memory-limit=${MEMCACHED_MEMORY_MB:-64}"]
    environment:
      - TZ=${TZ:-UTC}
    ports:
      - ${DEV_SERVICE_IP_ADDRESS:-127.0.0.1}:${MEMCACHED_PORT:-11211}:11211
    healthcheck:
      test: ["CMD-SHELL", "printf 'version\\r\\n' | nc -w 1 127.0.0.1 11211 | grep -q '^VERSION '"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 5s
    networks:
      - backend
{{ end -}}
