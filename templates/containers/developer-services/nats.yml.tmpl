{{- define "developer-service-nats-volumes" }}
  nats:
    driver: local
{{ end -}}

{{- define "developer-service-nats-services" }}
  nats:
    profiles: [nats]
    restart: unless-stopped
    image: nats:2.14.3-alpine
    command:
      - --jetstream
      - --store_dir=/data
      - --http_port=8222
      - --user=${NATS_USERNAME:-goforj}
      - --pass=${NATS_PASSWORD:-goforj}
    environment:
      - TZ=${TZ:-UTC}
    ports:
      - ${DEV_SERVICE_IP_ADDRESS:-127.0.0.1}:${NATS_CLIENT_PORT:-4222}:4222
      - ${DEV_SERVICE_IP_ADDRESS:-127.0.0.1}:${NATS_MONITORING_PORT:-8222}:8222
    volumes:
      - nats:/data
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null 'http://127.0.0.1:8222/healthz?js-enabled-only=true'"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 5s
    networks:
      - backend
{{ end -}}
