{{- define "developer-service-opensearch-volumes" }}
  opensearch:
    driver: local
{{ end -}}

{{- define "developer-service-opensearch-services" }}
  opensearch:
    # OpenSearch requires vm.max_map_count=262144 on Linux hosts.
    profiles: [opensearch]
    x-forj-test: false
    restart: unless-stopped
    image: opensearchproject/opensearch:3.7.0
    environment:
      - TZ=${TZ:-UTC}
      - discovery.type=single-node
      - bootstrap.memory_lock=true
      - OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
      - OPENSEARCH_INITIAL_ADMIN_PASSWORD=${OPENSEARCH_INITIAL_ADMIN_PASSWORD:-G0Forj-Local-OpenSearch-2026!}
    ulimits:
      memlock:
        soft: -1
        hard: -1
      nofile:
        soft: 65536
        hard: 65536
    ports:
      - ${DEV_SERVICE_IP_ADDRESS:-127.0.0.1}:${OPENSEARCH_HTTP_PORT:-9200}:9200
      - ${DEV_SERVICE_IP_ADDRESS:-127.0.0.1}:${OPENSEARCH_ANALYZER_PORT:-9600}:9600
    volumes:
      - opensearch:/usr/share/opensearch/data
    healthcheck:
      test: ["CMD-SHELL", "curl -kfsS -u \"admin:$${OPENSEARCH_INITIAL_ADMIN_PASSWORD}\" https://localhost:9200/_cluster/health?wait_for_status=yellow"]
      interval: 10s
      timeout: 5s
      retries: 20
      start_period: 40s
    networks:
      - backend

  opensearch-dashboards:
    profiles: [opensearch]
    x-forj-test: false
    restart: unless-stopped
    image: opensearchproject/opensearch-dashboards:3.7.0
    depends_on:
      opensearch:
        condition: service_healthy
    environment:
      - TZ=${TZ:-UTC}
      - OPENSEARCH_HOSTS=["https://opensearch:9200"]
    ports:
      - ${DEV_SERVICE_IP_ADDRESS:-127.0.0.1}:${OPENSEARCH_DASHBOARDS_PORT:-5601}:5601
    networks:
      - backend
{{ end -}}
