{{- define "developer-service-qdrant-volumes" }}
  qdrant:
    driver: local
{{ end -}}

{{- define "developer-service-qdrant-services" }}
  qdrant:
    profiles: [qdrant]
    x-forj-test: false
    restart: unless-stopped
    image: qdrant/qdrant:v1.18.3
    security_opt:
      - no-new-privileges:true
    environment:
      - TZ=${TZ:-UTC}
    ports:
      - ${DEV_SERVICE_IP_ADDRESS:-127.0.0.1}:${QDRANT_HTTP_PORT:-6333}:6333
      - ${DEV_SERVICE_IP_ADDRESS:-127.0.0.1}:${QDRANT_GRPC_PORT:-6334}:6334
    volumes:
      - qdrant:/qdrant/storage
    healthcheck:
      test:
        - CMD-SHELL
        - >-
          bash -ec 'exec 3<>/dev/tcp/127.0.0.1/6333;
          printf "GET /readyz HTTP/1.0\r\nHost: localhost\r\n\r\n" >&3;
          grep -q "200 OK" <&3'
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s
    networks:
      - backend
{{ end -}}
