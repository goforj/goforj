{{- define "developer-service-rustfs-volumes" }}
  rustfs:
    driver: local
{{ end -}}

{{- define "developer-service-rustfs-services" }}
  rustfs:
    profiles: [rustfs]
    restart: unless-stopped
    image: rustfs/rustfs:1.0.0-beta.10
    security_opt:
      - no-new-privileges:true
    environment:
      - TZ=${TZ:-UTC}
      - RUSTFS_VOLUMES=/data
      - RUSTFS_ADDRESS=0.0.0.0:9000
      - RUSTFS_CONSOLE_ADDRESS=0.0.0.0:9001
      - RUSTFS_CONSOLE_ENABLE=true
      - RUSTFS_ACCESS_KEY=${RUSTFS_ACCESS_KEY:-rustfsadmin}
      - RUSTFS_SECRET_KEY=${RUSTFS_SECRET_KEY:-rustfsadmin}
    ports:
      - ${DEV_SERVICE_IP_ADDRESS:-127.0.0.1}:${RUSTFS_API_PORT:-9000}:9000
      - ${DEV_SERVICE_IP_ADDRESS:-127.0.0.1}:${RUSTFS_CONSOLE_PORT:-9001}:9001
    volumes:
      - rustfs:/data
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:9000/health && curl -fsS http://127.0.0.1:9001/rustfs/console/health"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 40s
    networks:
      - backend
{{ end -}}
