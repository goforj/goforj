{{- define "developer-service-temporal-volumes" }}{{ end -}}

{{- define "developer-service-temporal-services" }}
  temporal:
    profiles: [temporal]
    x-forj-test: false
    restart: unless-stopped
    image: temporalio/temporal:1.8.0
    security_opt:
      - no-new-privileges:true
    command:
      - server
      - start-dev
      - --ip
      - 0.0.0.0
      - --ui-disable-news-fetch
    environment:
      - TZ=${TZ:-UTC}
    ports:
      - ${DEV_SERVICE_IP_ADDRESS:-127.0.0.1}:${TEMPORAL_GRPC_PORT:-7233}:7233
      - ${DEV_SERVICE_IP_ADDRESS:-127.0.0.1}:${TEMPORAL_UI_PORT:-8233}:8233
    healthcheck:
      test: ["CMD", "/usr/local/bin/temporal", "operator", "cluster", "health", "--address", "127.0.0.1:7233"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 20s
    networks:
      - backend
{{ end -}}
