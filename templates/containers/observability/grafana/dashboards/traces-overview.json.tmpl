{
  "id": null,
  "uid": "goforj-traces-overview",
  "title": "Traces Overview",
  "tags": [
    "goforj",
    "traces"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "tempo",
          "uid": "goforj-tempo"
        },
        "query": {
          "type": 1,
          "label": "resource.service.name",
          "refId": "TempoVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Request traces",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Send a request to your app, choose a service, and open a trace to see its spans and timing. Application-created OpenTelemetry spans appear alongside framework spans."
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Recent traces",
      "datasource": {
        "type": "tempo",
        "uid": "goforj-tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "goforj-tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"${service:regex}\" }",
          "tableType": "traces",
          "limit": 50,
          "filters": []
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "sortBy": [
          {
            "displayName": "Start time",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      }
    }
  ],
  "links": [
    {
      "title": "Platform Overview",
      "type": "link",
      "url": "/d/goforj-platform-overview",
      "keepTime": true,
      "targetBlank": false
    }
  ]
}
