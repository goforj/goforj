#!/bin/sh
set -eu

grafana_url="${GRAFANA_URL:-http://grafana:3000}"
grafana_user="${GRAFANA_ADMIN_USER:-admin}"
grafana_password="${GRAFANA_ADMIN_PASSWORD:-admin}"
auth="${grafana_user}:${grafana_password}"

dashboard_uids="goforj-platform-overview goforj-lighthouse-inspects goforj-cache-overview goforj-storage-overview goforj-events-overview goforj-http-overview goforj-auth-overview"
{{- if .ProjectComponents.Mail }}
dashboard_uids="${dashboard_uids} goforj-mail-overview"
{{- end }}
{{- if .ProjectComponents.HasDatabase }}
dashboard_uids="${dashboard_uids} goforj-database-overview"
{{- end }}
{{- if .ProjectComponents.Jobs }}
dashboard_uids="${dashboard_uids} goforj-queue-overview"
{{- end }}
{{- if .ProjectComponents.Scheduler }}
dashboard_uids="${dashboard_uids} goforj-scheduler-overview"
{{- end }}

wait_for_grafana() {
	attempts=0
	status="000"
	until status="$(curl -sS -u "${auth}" -o /dev/null -w "%{http_code}" "${grafana_url}/api/user" 2>/dev/null)" && [ "${status}" = "200" ]; do
		attempts=$((attempts + 1))
		if [ "${attempts}" -ge 60 ]; then
			echo "Timed out waiting for authenticated Grafana API; last HTTP status was ${status}" >&2
			return 1
		fi
		sleep 2
	done
}

echo "Waiting for Grafana at ${grafana_url}..."
wait_for_grafana

wait_for_dashboard() {
	uid="$1"
	attempts=0
	until curl -fsS -u "${auth}" "${grafana_url}/api/dashboards/uid/${uid}" >/dev/null 2>/dev/null; do
		attempts=$((attempts + 1))
		if [ "${attempts}" -ge 60 ]; then
			echo "Timed out waiting for dashboard ${uid}" >&2
			return 1
		fi
		sleep 2
	done
}

dashboard_is_starred() {
	uid="$1"
	curl -fsS -u "${auth}" "${grafana_url}/api/dashboards/uid/${uid}" \
		| grep -Eq '"isStarred"[[:space:]]*:[[:space:]]*true'
}

for uid in ${dashboard_uids}; do
	wait_for_dashboard "${uid}"
	if dashboard_is_starred "${uid}"; then
		echo "Grafana dashboard ${uid} is already starred"
		continue
	fi
	curl -fsS -u "${auth}" -X POST "${grafana_url}/api/user/stars/dashboard/uid/${uid}" >/dev/null
	if ! dashboard_is_starred "${uid}"; then
		echo "Grafana dashboard ${uid} was not starred after the API request" >&2
		exit 1
	fi
	echo "Starred Grafana dashboard ${uid}"
done

curl -fsS -u "${auth}" \
	-H "Content-Type: application/json" \
	-X PUT \
	-d '{"homeDashboardUID":"goforj-platform-overview","theme":"dark"}' \
	"${grafana_url}/api/org/preferences" >/dev/null

echo "Grafana dashboards seeded."
