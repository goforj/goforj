package alerts

import (
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"time"

	"github.com/hibiken/asynq"
	"{{.GoModuleName}}/internal/logger"
	"{{.GoModuleName}}/internal/models"
	"{{.GoModuleName}}/internal/notification"
	"{{.GoModuleName}}/internal/queue"
)

const DispatchJobTypeName = "alerts:dispatch"

// DispatchPayload is the serialized alert event sent through the alert queue.
type DispatchPayload struct {
	Event        string    `json:"event"`
	MonitorID    string    `json:"monitor_id"`
	MonitorName  string    `json:"monitor_name"`
	MonitorType  string    `json:"monitor_type"`
	Target       string    `json:"target"`
	Status       string    `json:"status"`
	IncidentID   string    `json:"incident_id,omitempty"`
	Summary      string    `json:"summary,omitempty"`
	ErrorClass   string    `json:"error_class,omitempty"`
	ErrorMessage string    `json:"error_message,omitempty"`
	DurationMs   int64     `json:"duration_ms,omitempty"`
	CheckedAt    time.Time `json:"checked_at"`
	ChannelIDs   []int64   `json:"channel_ids,omitempty"`
}

type DispatchJob struct {
	dispatcher queue.Dispatcher
	logger    *logger.AppLogger
	manager   *notification.Manager
	eventRepo *models.AlertDispatchEventRepo
}

// NewDispatchJob constructs the async dispatch job handler and enqueuer.
func NewDispatchJob(
	dispatcher queue.Dispatcher,
	logger *logger.AppLogger,
	manager *notification.Manager,
	eventRepo *models.AlertDispatchEventRepo,
) *DispatchJob {
	job := &DispatchJob{
		dispatcher: dispatcher,
		logger:    logger,
		manager:   manager,
		eventRepo: eventRepo,
	}
	if dispatcher != nil {
		dispatcher.Register(DispatchJobTypeName, job.HandleTask)
	}
	return job
}

// Enqueue schedules an alert dispatch task on the critical queue so
// monitor state transitions notify quickly even during heavy poll cycles.
func (j *DispatchJob) Enqueue(payload DispatchPayload) error {
	body, err := json.Marshal(payload)
	if err != nil {
		return err
	}
	if j.dispatcher == nil {
		return fmt.Errorf("queue dispatcher unavailable")
	}
	err = j.dispatcher.Enqueue(
		context.Background(),
		queue.Task{Type: DispatchJobTypeName, Payload: body},
		queue.WithQueue("critical"),
		queue.WithMaxRetry(2),
		queue.WithTimeout(15*time.Second),
	)
	if errors.Is(err, queue.ErrDuplicate) {
		return nil
	}
	return err
}

// Handle consumes a queued alert task and dispatches it to configured channels.
func (j *DispatchJob) Handle(ctx context.Context, task *asynq.Task) error {
	return j.handlePayload(ctx, task.Payload())
}

// HandleTask consumes backend-agnostic queue payloads.
func (j *DispatchJob) HandleTask(ctx context.Context, task queue.Task) error {
	return j.handlePayload(ctx, task.Payload)
}

func (j *DispatchJob) handlePayload(ctx context.Context, body []byte) error {
	var payload DispatchPayload
	if err := json.Unmarshal(body, &payload); err != nil {
		return fmt.Errorf("invalid alert payload: %w", asynq.SkipRetry)
	}
	msg := notification.AlertMessage{
		Event:        payload.Event,
		MonitorID:    payload.MonitorID,
		MonitorName:  payload.MonitorName,
		MonitorType:  payload.MonitorType,
		Target:       payload.Target,
		Status:       payload.Status,
		IncidentID:   payload.IncidentID,
		Summary:      payload.Summary,
		ErrorClass:   payload.ErrorClass,
		ErrorMessage: payload.ErrorMessage,
		DurationMs:   payload.DurationMs,
		CheckedAt:    payload.CheckedAt,
		ChannelIDs:   payload.ChannelIDs,
	}
	attempts := j.manager.Dispatch(ctx, msg)
	j.persistAttempts(payload, attempts)
	j.logger.Debug().
		Str("event", payload.Event).
		Str("monitor_id", payload.MonitorID).
		Str("status", payload.Status).
		Msg("alert dispatched")
	return nil
}

func (j *DispatchJob) persistAttempts(payload DispatchPayload, attempts []notification.DispatchAttempt) {
	if j.eventRepo == nil {
		return
	}
	checkedAt := payload.CheckedAt.UTC()
	if checkedAt.IsZero() {
		checkedAt = time.Now().UTC()
	}
	for i := range attempts {
		row := &models.AlertDispatchEvent{
			CreatedAt:    time.Now().UTC(),
			CheckedAt:    checkedAt,
			Event:        payload.Event,
			MonitorID:    payload.MonitorID,
			MonitorName:  payload.MonitorName,
			MonitorType:  payload.MonitorType,
			Target:       payload.Target,
			Status:       payload.Status,
			IncidentID:   payload.IncidentID,
			Summary:      payload.Summary,
			ChannelID:    attempts[i].ChannelID,
			ChannelName:  attempts[i].ChannelName,
			Provider:     attempts[i].Provider,
			Delivery:     attempts[i].Delivery,
			ErrorMessage: attempts[i].ErrorMessage,
		}
		if err := j.eventRepo.Create(row); err != nil {
			j.logger.Error().Err(err).Str("event", payload.Event).Str("monitor_id", payload.MonitorID).Msg("persist alert dispatch event failed")
		}
	}
}
