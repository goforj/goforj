package appsettings

import (
	"strconv"

	"github.com/goforj/storage"
	"github.com/goforj/str"
	"github.com/labstack/echo/v4"
	"{{.GoModuleName}}/internal/http"
	"{{.GoModuleName}}/internal/logger"
	"{{.GoModuleName}}/internal/notification"
	"{{.GoModuleName}}/internal/storages"
)

type Controller struct {
	logger      *logger.AppLogger
	repo        *AppSettingRepo
	channelRepo *notification.ChannelRepo
	storage     *storages.Manager
}

// NewController wires settings and notification channel handlers with preseed hooks.
func NewController(
	logger *logger.AppLogger,
	repo *AppSettingRepo,
	channelRepo *notification.ChannelRepo,
	storage *storages.Manager,
) *Controller {
	return &Controller{
		logger:      logger,
		repo:        repo,
		channelRepo: channelRepo,
		storage:     storage,
	}
}

// Routes returns app settings and notification channel management endpoints.
func (c *Controller) Routes() []http.Route {
	return []http.Route{
		http.NewRoute(http.MethodGet, "/monitoring/settings", c.GetSettings),
		http.NewRoute(http.MethodPut, "/monitoring/settings", c.UpdateSettings),
		http.NewRoute(http.MethodPost, "/monitoring/settings/favicon-cache/clear", c.ClearFaviconCache),
		http.NewRoute(http.MethodGet, "/monitoring/settings/notification-channels", c.ListNotificationChannels),
		http.NewRoute(http.MethodPost, "/monitoring/settings/notification-channels", c.CreateNotificationChannel),
		http.NewRoute(http.MethodPut, "/monitoring/settings/notification-channels/:id", c.UpdateNotificationChannel),
		http.NewRoute(http.MethodDelete, "/monitoring/settings/notification-channels/:id", c.DeleteNotificationChannel),
	}
}

// GetSettings returns current application settings used by the monitoring UI.
func (c *Controller) GetSettings(ctx echo.Context) error {
	faviconTTLRaw, err := c.repo.GetValue(SettingFaviconCacheTTLSeconds, "604800")
	if err != nil {
		return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	faviconTTL, convErr := strconv.Atoi(str.Of(faviconTTLRaw).TrimSpace().String())
	if convErr != nil || faviconTTL <= 0 {
		faviconTTL = 604800
	}
	rawDays, _ := c.getPositiveSetting(SettingMonitoringRetentionRawDays, 30)
	hourlyAfter, _ := c.getPositiveSetting(SettingMonitoringRetentionDownsampleHourlyAfterDays, 7)
	dailyAfter, _ := c.getPositiveSetting(SettingMonitoringRetentionDownsampleDailyAfterDays, 30)
	hourlyRollupDays, _ := c.getPositiveSetting(SettingMonitoringRetentionHourlyRollupDays, 90)
	dailyRollupDays, _ := c.getPositiveSetting(SettingMonitoringRetentionDailyRollupDays, 365)
	alertDays, _ := c.getPositiveSetting(SettingMonitoringRetentionAlertDispatchDays, 90)
	resolvedIncidentDays, _ := c.getPositiveSetting(SettingMonitoringRetentionResolvedIncidentDays, 180)
	pollBatchSize, _ := c.getPositiveSetting(SettingMonitoringPollBatchSize, 100)
	return ctx.JSON(http.StatusOK, map[string]any{
		"ok": true,
		"settings": map[string]any{
			"favicon_cache_ttl_seconds":                         faviconTTL,
			"monitoring_retention_raw_days":                     rawDays,
			"monitoring_retention_downsample_hourly_after_days": hourlyAfter,
			"monitoring_retention_downsample_daily_after_days":  dailyAfter,
			"monitoring_retention_hourly_rollup_days":           hourlyRollupDays,
			"monitoring_retention_daily_rollup_days":            dailyRollupDays,
			"monitoring_retention_alert_dispatch_days":          alertDays,
			"monitoring_retention_resolved_incident_days":       resolvedIncidentDays,
			"monitoring_poll_batch_size":                        pollBatchSize,
		},
	})
}

// UpdateSettings persists supported application settings from API payload.
func (c *Controller) UpdateSettings(ctx echo.Context) error {
	var payload struct {
		FaviconCacheTTLSeconds                       *int `json:"favicon_cache_ttl_seconds"`
		MonitoringRetentionRawDays                   *int `json:"monitoring_retention_raw_days"`
		MonitoringRetentionDownsampleHourlyAfterDays *int `json:"monitoring_retention_downsample_hourly_after_days"`
		MonitoringRetentionDownsampleDailyAfterDays  *int `json:"monitoring_retention_downsample_daily_after_days"`
		MonitoringRetentionHourlyRollupDays          *int `json:"monitoring_retention_hourly_rollup_days"`
		MonitoringRetentionDailyRollupDays           *int `json:"monitoring_retention_daily_rollup_days"`
		MonitoringRetentionAlertDispatchDays         *int `json:"monitoring_retention_alert_dispatch_days"`
		MonitoringRetentionResolvedIncidentDays      *int `json:"monitoring_retention_resolved_incident_days"`
		MonitoringPollBatchSize                      *int `json:"monitoring_poll_batch_size"`
	}
	if err := ctx.Bind(&payload); err != nil {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "invalid payload"})
	}
	updated := map[string]int{}
	updatePositive := func(key string, value *int, min int, max int, label string) error {
		if value == nil {
			return nil
		}
		v := *value
		if v < min || (max > 0 && v > max) {
			if max > 0 {
				return strconv.ErrSyntax
			}
			return strconv.ErrRange
		}
		if err := c.repo.Upsert(key, strconv.Itoa(v)); err != nil {
			return err
		}
		updated[label] = v
		return nil
	}
	if err := updatePositive(SettingFaviconCacheTTLSeconds, payload.FaviconCacheTTLSeconds, 60, 2592000, "favicon_cache_ttl_seconds"); err != nil {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "favicon_cache_ttl_seconds must be between 60 and 2592000"})
	}
	if err := updatePositive(SettingMonitoringRetentionRawDays, payload.MonitoringRetentionRawDays, 1, 36500, "monitoring_retention_raw_days"); err != nil {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "monitoring_retention_raw_days must be between 1 and 36500"})
	}
	if err := updatePositive(SettingMonitoringRetentionDownsampleHourlyAfterDays, payload.MonitoringRetentionDownsampleHourlyAfterDays, 1, 36500, "monitoring_retention_downsample_hourly_after_days"); err != nil {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "monitoring_retention_downsample_hourly_after_days must be between 1 and 36500"})
	}
	if err := updatePositive(SettingMonitoringRetentionDownsampleDailyAfterDays, payload.MonitoringRetentionDownsampleDailyAfterDays, 1, 36500, "monitoring_retention_downsample_daily_after_days"); err != nil {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "monitoring_retention_downsample_daily_after_days must be between 1 and 36500"})
	}
	if err := updatePositive(SettingMonitoringRetentionHourlyRollupDays, payload.MonitoringRetentionHourlyRollupDays, 1, 36500, "monitoring_retention_hourly_rollup_days"); err != nil {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "monitoring_retention_hourly_rollup_days must be between 1 and 36500"})
	}
	if err := updatePositive(SettingMonitoringRetentionDailyRollupDays, payload.MonitoringRetentionDailyRollupDays, 1, 36500, "monitoring_retention_daily_rollup_days"); err != nil {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "monitoring_retention_daily_rollup_days must be between 1 and 36500"})
	}
	if err := updatePositive(SettingMonitoringRetentionAlertDispatchDays, payload.MonitoringRetentionAlertDispatchDays, 1, 36500, "monitoring_retention_alert_dispatch_days"); err != nil {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "monitoring_retention_alert_dispatch_days must be between 1 and 36500"})
	}
	if err := updatePositive(SettingMonitoringRetentionResolvedIncidentDays, payload.MonitoringRetentionResolvedIncidentDays, 1, 36500, "monitoring_retention_resolved_incident_days"); err != nil {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "monitoring_retention_resolved_incident_days must be between 1 and 36500"})
	}
	if err := updatePositive(SettingMonitoringPollBatchSize, payload.MonitoringPollBatchSize, 1, 1000, "monitoring_poll_batch_size"); err != nil {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "monitoring_poll_batch_size must be between 1 and 1000"})
	}
	if len(updated) == 0 {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "at least one setting is required"})
	}
	return ctx.JSON(http.StatusOK, map[string]any{
		"ok":       true,
		"settings": updated,
	})
}

func (c *Controller) getPositiveSetting(key string, fallback int) (int, error) {
	raw, err := c.repo.GetValue(key, strconv.Itoa(fallback))
	if err != nil {
		return fallback, err
	}
	value, convErr := strconv.Atoi(str.Of(raw).TrimSpace().String())
	if convErr != nil || value <= 0 {
		return fallback, nil
	}
	return value, nil
}

// ClearFaviconCache clears cached favicon files and recreates the cache directory.
func (c *Controller) ClearFaviconCache(ctx echo.Context) error {
	removedFiles, err := clearStorageEntries(c.storage.Favicons(), "")
	if err != nil {
		return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	c.logger.Info().Int("removed_files", removedFiles).Msg("favicon cache cleared")
	return ctx.JSON(http.StatusOK, map[string]any{
		"ok":            true,
		"removed_files": removedFiles,
	})
}

func clearStorageEntries(disk storage.Storage, path string) (int, error) {
	entries, err := disk.List(path)
	if err != nil {
		return 0, err
	}
	removed := 0
	for _, entry := range entries {
		if entry.IsDir {
			count, err := clearStorageEntries(disk, entry.Path)
			removed += count
			if err != nil {
				return removed, err
			}
			continue
		}
		if err := disk.Delete(entry.Path); err != nil {
			return removed, err
		}
		removed++
	}
	return removed, nil
}

// ListNotificationChannels returns configured notification channels for settings UI.
func (c *Controller) ListNotificationChannels(ctx echo.Context) error {
	channels, err := c.channelRepo.ListSummaries()
	if err != nil {
		return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	return ctx.JSON(http.StatusOK, map[string]any{
		"ok":       true,
		"channels": channels,
	})
}

// CreateNotificationChannel creates a new notification channel definition.
func (c *Controller) CreateNotificationChannel(ctx echo.Context) error {
	var payload struct {
		Name      string            `json:"name"`
		Provider  string            `json:"provider"`
		IsEnabled bool              `json:"is_enabled"`
		Config    map[string]string `json:"config"`
		Secrets   map[string]string `json:"secrets"`
	}
	if err := ctx.Bind(&payload); err != nil {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "invalid payload"})
	}
	channel, err := c.channelRepo.Upsert(notification.UpsertChannelInput{
		Name:      payload.Name,
		Provider:  payload.Provider,
		IsEnabled: payload.IsEnabled,
		Config:    payload.Config,
		Secrets:   payload.Secrets,
	})
	if err != nil {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": err.Error()})
	}
	return ctx.JSON(http.StatusOK, map[string]any{"ok": true, "channel": channel})
}

// UpdateNotificationChannel updates an existing notification channel definition.
func (c *Controller) UpdateNotificationChannel(ctx echo.Context) error {
	var payload struct {
		Name      string             `json:"name"`
		Provider  string             `json:"provider"`
		IsEnabled bool               `json:"is_enabled"`
		Config    map[string]string  `json:"config"`
		Secrets   *map[string]string `json:"secrets"`
	}
	if err := ctx.Bind(&payload); err != nil {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "invalid payload"})
	}
	id, err := strconv.ParseInt(ctx.Param("id"), 10, 64)
	if err != nil || id <= 0 {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "invalid id"})
	}
	var secrets map[string]string
	if payload.Secrets != nil {
		secrets = *payload.Secrets
	}
	channel, upsertErr := c.channelRepo.Upsert(notification.UpsertChannelInput{
		ID:        id,
		Name:      payload.Name,
		Provider:  payload.Provider,
		IsEnabled: payload.IsEnabled,
		Config:    payload.Config,
		Secrets:   secrets,
	})
	if upsertErr != nil {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": upsertErr.Error()})
	}
	return ctx.JSON(http.StatusOK, map[string]any{"ok": true, "channel": channel})
}

// DeleteNotificationChannel deletes a notification channel by id.
func (c *Controller) DeleteNotificationChannel(ctx echo.Context) error {
	id, err := strconv.ParseInt(ctx.Param("id"), 10, 64)
	if err != nil || id <= 0 {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "invalid id"})
	}
	if delErr := c.channelRepo.Delete(id); delErr != nil {
		return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": delErr.Error()})
	}
	return ctx.JSON(http.StatusOK, map[string]any{"ok": true})
}
