package appsettings

import (
	"context"
	"strconv"
	"time"

	"github.com/goforj/storage"
	"github.com/goforj/str/v2"
	"github.com/goforj/web"
	"{{.GoModuleName}}/internal/logger"
	"{{.GoModuleName}}/internal/notification"
	"{{.GoModuleName}}/internal/storages"
	"net/http"
)

type Controller struct {
	logger      *logger.AppLogger
	repo        *AppSettingRepo
	channelRepo *notification.ChannelRepo
	storage     *storages.Manager
}

// NewController wires settings and notification channel handlers with preseed hooks.
func NewController(
	logger *logger.AppLogger,
	repo *AppSettingRepo,
	channelRepo *notification.ChannelRepo,
	storage *storages.Manager,
) *Controller {
	return &Controller{
		logger:      logger,
		repo:        repo,
		channelRepo: channelRepo,
		storage:     storage,
	}
}

// Routes returns app settings and notification channel management endpoints.
func (c *Controller) Routes() []web.Route {
	return []web.Route{
		web.NewRoute(http.MethodGet, "/monitoring/settings", c.GetSettings),
		web.NewRoute(http.MethodPut, "/monitoring/settings", c.UpdateSettings),
		web.NewRoute(http.MethodPost, "/monitoring/settings/favicon-cache/clear", c.ClearFaviconCache),
		web.NewRoute(http.MethodGet, "/monitoring/settings/notification-channels", c.ListNotificationChannels),
		web.NewRoute(http.MethodPost, "/monitoring/settings/notification-channels", c.CreateNotificationChannel),
		web.NewRoute(http.MethodPut, "/monitoring/settings/notification-channels/:id", c.UpdateNotificationChannel),
		web.NewRoute(http.MethodDelete, "/monitoring/settings/notification-channels/:id", c.DeleteNotificationChannel),
	}
}

// GetSettings returns current application settings used by the monitoring UI.
func (c *Controller) GetSettings(r web.Context) error {
	faviconTTLRaw, err := c.repo.GetValue(r.Context(), SettingFaviconCacheTTLSeconds, "604800")
	if err != nil {
		return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	faviconTTL, convErr := strconv.Atoi(str.Of(faviconTTLRaw).Trim().String())
	if convErr != nil || faviconTTL <= 0 {
		faviconTTL = 604800
	}
	rawDays, _ := c.getPositiveSetting(r.Context(), SettingMonitoringRetentionRawDays, 30)
	hourlyAfter, _ := c.getPositiveSetting(r.Context(), SettingMonitoringRetentionDownsampleHourlyAfterDays, 7)
	dailyAfter, _ := c.getPositiveSetting(r.Context(), SettingMonitoringRetentionDownsampleDailyAfterDays, 30)
	hourlyRollupDays, _ := c.getPositiveSetting(r.Context(), SettingMonitoringRetentionHourlyRollupDays, 90)
	dailyRollupDays, _ := c.getPositiveSetting(r.Context(), SettingMonitoringRetentionDailyRollupDays, 365)
	alertDays, _ := c.getPositiveSetting(r.Context(), SettingMonitoringRetentionAlertDispatchDays, 90)
	resolvedIncidentDays, _ := c.getPositiveSetting(r.Context(), SettingMonitoringRetentionResolvedIncidentDays, 180)
	pollBatchSize, _ := c.getPositiveSetting(r.Context(), SettingMonitoringPollBatchSize, 100)
	maintenance := c.repo.MonitoringMaintenanceWindow(r.Context(), time.Now().UTC())
	return r.JSON(http.StatusOK, map[string]any{
		"ok": true,
		"settings": map[string]any{
			"favicon_cache_ttl_seconds":                         faviconTTL,
			"monitoring_retention_raw_days":                     rawDays,
			"monitoring_retention_downsample_hourly_after_days": hourlyAfter,
			"monitoring_retention_downsample_daily_after_days":  dailyAfter,
			"monitoring_retention_hourly_rollup_days":           hourlyRollupDays,
			"monitoring_retention_daily_rollup_days":            dailyRollupDays,
			"monitoring_retention_alert_dispatch_days":          alertDays,
			"monitoring_retention_resolved_incident_days":       resolvedIncidentDays,
			"monitoring_poll_batch_size":                        pollBatchSize,
			"monitoring_maintenance_starts_at":                  formatNullableTime(maintenance.StartsAt),
			"monitoring_maintenance_ends_at":                    formatNullableTime(maintenance.EndsAt),
			"monitoring_maintenance_active":                     maintenance.Active,
		},
	})
}

// UpdateSettings persists supported application settings from API payload.
func (c *Controller) UpdateSettings(r web.Context) error {
	var payload struct {
		FaviconCacheTTLSeconds                       *int `json:"favicon_cache_ttl_seconds"`
		MonitoringRetentionRawDays                   *int `json:"monitoring_retention_raw_days"`
		MonitoringRetentionDownsampleHourlyAfterDays *int `json:"monitoring_retention_downsample_hourly_after_days"`
		MonitoringRetentionDownsampleDailyAfterDays  *int `json:"monitoring_retention_downsample_daily_after_days"`
		MonitoringRetentionHourlyRollupDays          *int `json:"monitoring_retention_hourly_rollup_days"`
		MonitoringRetentionDailyRollupDays           *int `json:"monitoring_retention_daily_rollup_days"`
		MonitoringRetentionAlertDispatchDays         *int `json:"monitoring_retention_alert_dispatch_days"`
		MonitoringRetentionResolvedIncidentDays      *int `json:"monitoring_retention_resolved_incident_days"`
		MonitoringPollBatchSize                      *int `json:"monitoring_poll_batch_size"`
		MonitoringMaintenanceStartsAt                *string `json:"monitoring_maintenance_starts_at"`
		MonitoringMaintenanceEndsAt                  *string `json:"monitoring_maintenance_ends_at"`
	}
	if err := r.Bind(&payload); err != nil {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "invalid payload"})
	}
	updated := map[string]any{}
	updatePositive := func(key string, value *int, min int, max int, label string) error {
		if value == nil {
			return nil
		}
		v := *value
		if v < min || (max > 0 && v > max) {
			if max > 0 {
				return strconv.ErrSyntax
			}
			return strconv.ErrRange
		}
		if err := c.repo.Upsert(r.Context(), key, strconv.Itoa(v)); err != nil {
			return err
		}
		updated[label] = v
		return nil
	}
	updateMaintenanceWindow := func(startRaw, endRaw *string) error {
		if startRaw == nil && endRaw == nil {
			return nil
		}
		start := ""
		end := ""
		if startRaw != nil {
			start = str.Of(*startRaw).Trim().String()
		}
		if endRaw != nil {
			end = str.Of(*endRaw).Trim().String()
		}
		if start == "" && end == "" {
			if err := c.repo.Upsert(r.Context(), SettingMonitoringMaintenanceStartsAt, ""); err != nil {
				return err
			}
			if err := c.repo.Upsert(r.Context(), SettingMonitoringMaintenanceEndsAt, ""); err != nil {
				return err
			}
			updated["monitoring_maintenance_starts_at"] = nil
			updated["monitoring_maintenance_ends_at"] = nil
			return nil
		}
		if start == "" || end == "" {
			return strconv.ErrSyntax
		}
		startAt, err := time.Parse(time.RFC3339, start)
		if err != nil {
			return strconv.ErrSyntax
		}
		endAt, err := time.Parse(time.RFC3339, end)
		if err != nil {
			return strconv.ErrSyntax
		}
		startAt = startAt.UTC()
		endAt = endAt.UTC()
		if !endAt.After(startAt) {
			return strconv.ErrRange
		}
		start = startAt.Format(time.RFC3339)
		end = endAt.Format(time.RFC3339)
		if err := c.repo.Upsert(r.Context(), SettingMonitoringMaintenanceStartsAt, start); err != nil {
			return err
		}
		if err := c.repo.Upsert(r.Context(), SettingMonitoringMaintenanceEndsAt, end); err != nil {
			return err
		}
		updated["monitoring_maintenance_starts_at"] = start
		updated["monitoring_maintenance_ends_at"] = end
		return nil
	}
	if err := updatePositive(SettingFaviconCacheTTLSeconds, payload.FaviconCacheTTLSeconds, 60, 2592000, "favicon_cache_ttl_seconds"); err != nil {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "favicon_cache_ttl_seconds must be between 60 and 2592000"})
	}
	if err := updatePositive(SettingMonitoringRetentionRawDays, payload.MonitoringRetentionRawDays, 1, 36500, "monitoring_retention_raw_days"); err != nil {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "monitoring_retention_raw_days must be between 1 and 36500"})
	}
	if err := updatePositive(SettingMonitoringRetentionDownsampleHourlyAfterDays, payload.MonitoringRetentionDownsampleHourlyAfterDays, 1, 36500, "monitoring_retention_downsample_hourly_after_days"); err != nil {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "monitoring_retention_downsample_hourly_after_days must be between 1 and 36500"})
	}
	if err := updatePositive(SettingMonitoringRetentionDownsampleDailyAfterDays, payload.MonitoringRetentionDownsampleDailyAfterDays, 1, 36500, "monitoring_retention_downsample_daily_after_days"); err != nil {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "monitoring_retention_downsample_daily_after_days must be between 1 and 36500"})
	}
	if err := updatePositive(SettingMonitoringRetentionHourlyRollupDays, payload.MonitoringRetentionHourlyRollupDays, 1, 36500, "monitoring_retention_hourly_rollup_days"); err != nil {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "monitoring_retention_hourly_rollup_days must be between 1 and 36500"})
	}
	if err := updatePositive(SettingMonitoringRetentionDailyRollupDays, payload.MonitoringRetentionDailyRollupDays, 1, 36500, "monitoring_retention_daily_rollup_days"); err != nil {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "monitoring_retention_daily_rollup_days must be between 1 and 36500"})
	}
	if err := updatePositive(SettingMonitoringRetentionAlertDispatchDays, payload.MonitoringRetentionAlertDispatchDays, 1, 36500, "monitoring_retention_alert_dispatch_days"); err != nil {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "monitoring_retention_alert_dispatch_days must be between 1 and 36500"})
	}
	if err := updatePositive(SettingMonitoringRetentionResolvedIncidentDays, payload.MonitoringRetentionResolvedIncidentDays, 1, 36500, "monitoring_retention_resolved_incident_days"); err != nil {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "monitoring_retention_resolved_incident_days must be between 1 and 36500"})
	}
	if err := updatePositive(SettingMonitoringPollBatchSize, payload.MonitoringPollBatchSize, 1, 1000, "monitoring_poll_batch_size"); err != nil {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "monitoring_poll_batch_size must be between 1 and 1000"})
	}
	if err := updateMaintenanceWindow(payload.MonitoringMaintenanceStartsAt, payload.MonitoringMaintenanceEndsAt); err != nil {
		switch err {
		case strconv.ErrSyntax:
			return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "monitoring maintenance window requires valid RFC3339 start and end"})
		case strconv.ErrRange:
			return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "monitoring maintenance end must be after start"})
		default:
			return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
		}
	}
	if len(updated) == 0 {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "at least one setting is required"})
	}
	return r.JSON(http.StatusOK, map[string]any{
		"ok":       true,
		"settings": updated,
	})
}

func formatNullableTime(value *time.Time) any {
	if value == nil {
		return nil
	}
	return value.UTC().Format(time.RFC3339)
}

func (c *Controller) getPositiveSetting(ctx context.Context, key string, fallback int) (int, error) {
	raw, err := c.repo.GetValue(ctx, key, strconv.Itoa(fallback))
	if err != nil {
		return fallback, err
	}
	value, convErr := strconv.Atoi(str.Of(raw).Trim().String())
	if convErr != nil || value <= 0 {
		return fallback, nil
	}
	return value, nil
}

// ClearFaviconCache clears cached favicon files and recreates the cache directory.
func (c *Controller) ClearFaviconCache(r web.Context) error {
	removedFiles, err := clearStorageEntries(r.Context(), c.storage.Favicons(), "")
	if err != nil {
		return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	c.logger.Info().Int("removed_files", removedFiles).Msg("favicon cache cleared")
	return r.JSON(http.StatusOK, map[string]any{
		"ok":            true,
		"removed_files": removedFiles,
	})
}

func clearStorageEntries(ctx context.Context, disk storage.Storage, path string) (int, error) {
	disk = disk.WithContext(ctx)
	entries, err := disk.List(path)
	if err != nil {
		return 0, err
	}
	removed := 0
	for _, entry := range entries {
		if entry.IsDir {
			count, err := clearStorageEntries(ctx, disk, entry.Path)
			removed += count
			if err != nil {
				return removed, err
			}
			continue
		}
		if err := disk.Delete(entry.Path); err != nil {
			return removed, err
		}
		removed++
	}
	return removed, nil
}

// ListNotificationChannels returns configured notification channels for settings UI.
func (c *Controller) ListNotificationChannels(r web.Context) error {
	channels, err := c.channelRepo.ListSummaries()
	if err != nil {
		return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	return r.JSON(http.StatusOK, map[string]any{
		"ok":       true,
		"channels": channels,
	})
}

// CreateNotificationChannel creates a new notification channel definition.
func (c *Controller) CreateNotificationChannel(r web.Context) error {
	var payload struct {
		Name      string            `json:"name"`
		Provider  string            `json:"provider"`
		IsEnabled bool              `json:"is_enabled"`
		Config    map[string]string `json:"config"`
		Secrets   map[string]string `json:"secrets"`
	}
	if err := r.Bind(&payload); err != nil {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "invalid payload"})
	}
	channel, err := c.channelRepo.Upsert(r.Context(), notification.UpsertChannelInput{
		Name:      payload.Name,
		Provider:  payload.Provider,
		IsEnabled: payload.IsEnabled,
		Config:    payload.Config,
		Secrets:   payload.Secrets,
	})
	if err != nil {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": err.Error()})
	}
	return r.JSON(http.StatusOK, map[string]any{"ok": true, "channel": channel})
}

// UpdateNotificationChannel updates an existing notification channel definition.
func (c *Controller) UpdateNotificationChannel(r web.Context) error {
	var payload struct {
		Name      string             `json:"name"`
		Provider  string             `json:"provider"`
		IsEnabled bool               `json:"is_enabled"`
		Config    map[string]string  `json:"config"`
		Secrets   *map[string]string `json:"secrets"`
	}
	if err := r.Bind(&payload); err != nil {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "invalid payload"})
	}
	id, err := strconv.ParseInt(r.Param("id"), 10, 64)
	if err != nil || id <= 0 {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "invalid id"})
	}
	var secrets map[string]string
	if payload.Secrets != nil {
		secrets = *payload.Secrets
	}
	channel, upsertErr := c.channelRepo.Upsert(r.Context(), notification.UpsertChannelInput{
		ID:        id,
		Name:      payload.Name,
		Provider:  payload.Provider,
		IsEnabled: payload.IsEnabled,
		Config:    payload.Config,
		Secrets:   secrets,
	})
	if upsertErr != nil {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": upsertErr.Error()})
	}
	return r.JSON(http.StatusOK, map[string]any{"ok": true, "channel": channel})
}

// DeleteNotificationChannel deletes a notification channel by id.
func (c *Controller) DeleteNotificationChannel(r web.Context) error {
	id, err := strconv.ParseInt(r.Param("id"), 10, 64)
	if err != nil || id <= 0 {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "invalid id"})
	}
	if delErr := c.channelRepo.Delete(r.Context(), id); delErr != nil {
		return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": delErr.Error()})
	}
	return r.JSON(http.StatusOK, map[string]any{"ok": true})
}
