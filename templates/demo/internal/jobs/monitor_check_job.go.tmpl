package jobs

import (
	"context"
	"encoding/json"
	"fmt"
	"io"
	"math/rand"
	"net"
	"net/http"
	"strings"
	"time"

	"github.com/goforj/null/v6"
	"github.com/hibiken/asynq"
	"{{.GoModuleName}}/internal/dbconns"
	"{{.GoModuleName}}/internal/logger"
	"{{.GoModuleName}}/internal/models"
)

const MonitorCheckJobTypeName = "monitoring:check"
const monitorQueueCycleCap = 50

type MonitorCheckPayload struct {
	MonitorID string `json:"monitor_id"`
}

type MonitorCheckJob struct {
	queue            *asynq.Client
	db               *dbconns.Connections
	logger           *logger.AppLogger
	httpClient       *http.Client
	monitorRepo      *models.MonitorRepo
	monitorCheckRepo *models.MonitorCheckRepo
	incidentRepo     *models.IncidentRepo
}

func NewMonitorCheckJob(
	queue *asynq.Client,
	db *dbconns.Connections,
	logger *logger.AppLogger,
	monitorRepo *models.MonitorRepo,
	monitorCheckRepo *models.MonitorCheckRepo,
	incidentRepo *models.IncidentRepo,
) *MonitorCheckJob {
	transport := &http.Transport{
		Proxy:                 http.ProxyFromEnvironment,
		DialContext:           (&net.Dialer{Timeout: 5 * time.Second, KeepAlive: 30 * time.Second}).DialContext,
		ForceAttemptHTTP2:     true,
		MaxIdleConns:          200,
		MaxIdleConnsPerHost:   32,
		IdleConnTimeout:       90 * time.Second,
		TLSHandshakeTimeout:   5 * time.Second,
		ExpectContinueTimeout: 1 * time.Second,
	}

	return &MonitorCheckJob{
		queue:            queue,
		db:               db,
		logger:           logger,
		httpClient:       &http.Client{Transport: transport},
		monitorRepo:      monitorRepo,
		monitorCheckRepo: monitorCheckRepo,
		incidentRepo:     incidentRepo,
	}
}

func (j *MonitorCheckJob) Queue(monitorID string) error {
	return j.QueueWithDelay(monitorID, 0)
}

func (j *MonitorCheckJob) QueueWithDelay(monitorID string, delay time.Duration) error {
	payload, err := json.Marshal(MonitorCheckPayload{MonitorID: monitorID})
	if err != nil {
		return err
	}
	options := []asynq.Option{
		asynq.Timeout(2*time.Minute),
		asynq.Queue("default"),
		asynq.MaxRetry(3),
	}
	if delay > 0 {
		options = append(options, asynq.ProcessIn(delay))
	}
	_, err = j.queue.Enqueue(
		asynq.NewTask(MonitorCheckJobTypeName, payload),
		options...,
	)
	return err
}

func (j *MonitorCheckJob) QueueDue() error {
	db, err := j.db.Default()
	if err != nil {
		return err
	}
	type row struct {
		ID              string `gorm:"column:id"`
		IntervalSeconds int    `gorm:"column:interval_seconds"`
	}
	var monitors []row
	if err := db.Raw("SELECT id, interval_seconds FROM monitors WHERE enabled = ?", true).Scan(&monitors).Error; err != nil {
		return err
	}
	type lastCheck struct {
		MonitorID string `gorm:"column:monitor_id"`
		CheckedAt string `gorm:"column:last_checked_at"`
	}
	var checks []lastCheck
	if err := db.Raw(`
SELECT monitor_id, MAX(checked_at) AS last_checked_at
FROM monitor_checks
GROUP BY monitor_id
`).Scan(&checks).Error; err != nil {
		return err
	}
	lastByMonitor := map[string]time.Time{}
	for _, c := range checks {
		parsed, err := parseDBTimestamp(c.CheckedAt)
		if err != nil {
			continue
		}
		lastByMonitor[c.MonitorID] = parsed
	}
	now := time.Now().UTC()
	queued := 0
	rng := rand.New(rand.NewSource(now.UnixNano()))
	for _, monitor := range monitors {
		interval := monitor.IntervalSeconds
		if interval <= 0 {
			interval = 60
		}
		if last, ok := lastByMonitor[monitor.ID]; ok {
			if now.Sub(last) < time.Duration(interval)*time.Second {
				continue
			}
		}
		if queued >= monitorQueueCycleCap {
			break
		}
		// Add light jitter so many monitors with the same interval do not fire in one burst.
		jitter := time.Duration(rng.Intn(4000)-2000) * time.Millisecond
		processIn := 0 * time.Second
		if jitter > 0 {
			processIn = jitter
		}
		if err := j.QueueWithDelay(monitor.ID, processIn); err != nil {
			j.logger.Error().Err(err).Str("monitor_id", monitor.ID).Msg("queue monitor check failed")
			continue
		}
		queued++
	}
	return nil
}

func (j *MonitorCheckJob) Handle(ctx context.Context, task *asynq.Task) error {
	var payload MonitorCheckPayload
	if err := json.Unmarshal(task.Payload(), &payload); err != nil {
		return fmt.Errorf("invalid payload: %w", asynq.SkipRetry)
	}
	if payload.MonitorID == "" {
		return fmt.Errorf("missing monitor id: %w", asynq.SkipRetry)
	}

	m, err := j.monitorRepo.ByID(payload.MonitorID)
	if err != nil {
		return err
	}
	monitorID := monitorIDString(m)
	if m == nil || monitorID == "" || !m.Enabled {
		return nil
	}

	timeout := 5 * time.Second
	if m.TimeoutMs > 0 {
		timeout = time.Duration(m.TimeoutMs) * time.Millisecond
	}
	status := "down"
	statusCode := 0
	errText := ""
	switch m.MonitorType {
	case "tcp":
		start := time.Now()
		conn, err := net.DialTimeout("tcp", m.Target, timeout)
		duration := time.Since(start).Milliseconds()
		if err != nil {
			errText = classifyCheckError("tcp", err.Error())
		} else {
			status = "up"
			_ = conn.Close()
		}
			if err := j.writeCheck(monitorID, status, statusCode, duration, errText); err != nil {
				return err
			}
	case "ping":
		start := time.Now()
		resolverCtx, cancel := context.WithTimeout(ctx, timeout)
		defer cancel()
			_, err := net.DefaultResolver.LookupHost(resolverCtx, m.Target)
		duration := time.Since(start).Milliseconds()
		if err != nil {
			errText = classifyCheckError("ping", err.Error())
		} else {
			status = "up"
		}
			if err := j.writeCheck(monitorID, status, statusCode, duration, errText); err != nil {
				return err
			}
	default:
		// Prime the connection before measuring to reduce cold-start/TLS spike noise.
		j.primeHTTPConnection(ctx, m.Target, timeout)
		statusCode, duration, reqErr := j.runHTTPCheck(ctx, m.Target, timeout)
		if reqErr != nil {
			errText = classifyCheckError("http", reqErr.Error())
		} else {
			if statusCode >= 200 && statusCode < 500 {
				status = "up"
			} else {
				errText = classifyCheckError("http", fmt.Sprintf("status=%d", statusCode))
			}
		}
			if err := j.writeCheck(monitorID, status, statusCode, duration, errText); err != nil {
				return err
			}
	}
	return nil
}

func (j *MonitorCheckJob) primeHTTPConnection(ctx context.Context, target string, timeout time.Duration) {
	warmTimeout := timeout
	if warmTimeout > 1500*time.Millisecond {
		warmTimeout = 1500 * time.Millisecond
	}
	reqCtx, cancel := context.WithTimeout(ctx, warmTimeout)
	defer cancel()

	req, err := http.NewRequestWithContext(reqCtx, http.MethodHead, target, nil)
	if err != nil {
		return
	}
	resp, err := j.httpClient.Do(req)
	if err != nil {
		return
	}
	defer resp.Body.Close()
	_, _ = io.Copy(io.Discard, resp.Body)
}

func (j *MonitorCheckJob) runHTTPCheck(ctx context.Context, target string, timeout time.Duration) (int, int64, error) {
	reqCtx, cancel := context.WithTimeout(ctx, timeout)
	defer cancel()

	req, err := http.NewRequestWithContext(reqCtx, http.MethodGet, target, nil)
	if err != nil {
		return 0, 0, err
	}

	start := time.Now()
	resp, err := j.httpClient.Do(req)
	duration := time.Since(start).Milliseconds()
	if err != nil {
		return 0, duration, err
	}
	defer resp.Body.Close()
	_, _ = io.Copy(io.Discard, resp.Body)
	return resp.StatusCode, duration, nil
}

func classifyCheckError(kind string, msg string) string {
	lower := strings.ToLower(msg)
	tag := "check"
	switch {
	case strings.Contains(lower, "timeout"):
		tag = "timeout"
	case strings.Contains(lower, "refused"), strings.Contains(lower, "reset"), strings.Contains(lower, "no route"):
		tag = "network"
	case strings.Contains(lower, "status="):
		tag = "status"
	}
	return fmt.Sprintf("[%s/%s] %s", kind, tag, msg)
}

func parseDBTimestamp(value string) (time.Time, error) {
	value = strings.TrimSpace(value)
	layouts := []string{
		time.RFC3339Nano,
		"2006-01-02 15:04:05.999999999Z07:00",
		"2006-01-02 15:04:05.999999999",
		"2006-01-02 15:04:05",
	}
	for _, layout := range layouts {
		if ts, err := time.Parse(layout, value); err == nil {
			if ts.Location() == time.Local {
				return ts.UTC(), nil
			}
			return ts, nil
		}
	}
	return time.Time{}, fmt.Errorf("parse timestamp: %s", value)
}

func monitorIDString(m *models.Monitor) string {
	if m == nil {
		return ""
	}
	return anyIDToString(m.Id)
}

func anyIDToString(v any) string {
	switch id := v.(type) {
	case string:
		return id
	case null.String:
		return id.String
	default:
		return strings.TrimSpace(fmt.Sprint(v))
	}
}

func (j *MonitorCheckJob) writeCheck(monitorID, status string, statusCode int, duration int64, errText string) error {
	conn, err := j.monitorCheckRepo.Builder()
	if err != nil {
		return err
	}
	var previousStatus string
	_ = conn.Model(&models.MonitorCheck{}).
		Select("status").
		Where("monitor_id = ?", monitorID).
		Order("checked_at DESC").
		Limit(1).
		Scan(&previousStatus).Error

	now := time.Now().UTC()
	checkID := fmt.Sprintf("%d", now.UnixNano())
	if err := j.monitorCheckRepo.Create(&models.MonitorCheck{
		Id:           null.StringFrom(checkID),
		MonitorId:    monitorID,
		CheckedAt:    now,
		Status:       status,
		StatusCode:   null.IntFrom(int64(statusCode)),
		DurationMs:   null.IntFrom(duration),
		ErrorMessage: null.StringFrom(errText),
	}); err != nil {
		return err
	}

	if previousStatus != status {
		if status == "down" {
			incidentID := fmt.Sprintf("incident_%d", now.UnixNano())
			summary := "Monitor transitioned to down state"
			if err := j.incidentRepo.Create(&models.Incident{
				Id:        null.StringFrom(incidentID),
				MonitorId: monitorID,
				OpenedAt:  now,
				Summary:   summary,
			}); err != nil {
				j.logger.Error().Err(err).Str("monitor_id", monitorID).Msg("open incident failed")
			}
		}
		if previousStatus == "down" && status == "up" {
			incidentConn, err := j.incidentRepo.Builder()
			if err != nil {
				return err
			}
			var incident models.Incident
			if err := incidentConn.
				Where("monitor_id = ? AND resolved_at IS NULL", monitorID).
				Order("opened_at DESC").
				Limit(1).
				First(&incident).Error; err == nil {
				incident.ResolvedAt = &now
				if err := j.incidentRepo.Update(&incident); err != nil {
					j.logger.Error().Err(err).Str("incident_id", anyIDToString(incident.Id)).Msg("resolve incident failed")
				}
			}
		}
	}
	return nil
}
