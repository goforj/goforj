const MonitorCheckJobTypeName = "monitoring:check"
const monitorQueueLookahead = 30 * time.Second
const demoPushMonitorID = "monitor_push_demo"

const (
	monitorPrimaryUserAgent  = "uptime-gopher/1.0"
	monitorDownThreshold     = 2
	monitorRecoveryThreshold = 2
	monitorStreakScanLimit   = 12
	monitorMaxRetryAttempts  = 5
	monitorCircuitThreshold  = 3
	monitorCircuitTTL        = 5 * time.Minute
	monitorRetryCap          = 5 * time.Second
)

type checkResult struct {
	status     string
	statusCode int
	durationMs int64
	errText    string
	errClass   string
	retryable  bool
	dnsOrTLS   bool
}

type MonitorCheckPayload struct {
	MonitorID string `json:"monitor_id"`
}

type MonitorCheckJob struct {
	queue            *asynq.Client
	db               *dbconns.Connections
	logger           *logger.AppLogger
	httpxPrimary     *httpx.Client
	httpxChrome      *httpx.Client
	httpxHTTP1       *httpx.Client
	monitorRepo      *models.MonitorRepo
	monitorCheckRepo *models.MonitorCheckRepo
	incidentRepo     *models.IncidentRepo
}

func NewMonitorCheckJob(
	queue *asynq.Client,
	db *dbconns.Connections,
	logger *logger.AppLogger,
	monitorRepo *models.MonitorRepo,
	monitorCheckRepo *models.MonitorCheckRepo,
	incidentRepo *models.IncidentRepo,
) *MonitorCheckJob {
	http1Client := httpx.New(httpx.UserAgent(monitorPrimaryUserAgent))
	http1Client.Req().EnableForceHTTP1()

	return &MonitorCheckJob{
		queue:            queue,
		db:               db,
		logger:           logger,
		httpxPrimary:     httpx.New(httpx.UserAgent(monitorPrimaryUserAgent)),
		httpxChrome:      httpx.New(httpx.AsChrome()),
		httpxHTTP1:       http1Client,
		monitorRepo:      monitorRepo,
		monitorCheckRepo: monitorCheckRepo,
		incidentRepo:     incidentRepo,
	}
}

func (j *MonitorCheckJob) Queue(monitorID string) error {
	return j.QueueWithDelayUnique(monitorID, 0, 10*time.Second)
}

func (j *MonitorCheckJob) QueueWithDelay(monitorID string, delay time.Duration) error {
	return j.QueueWithDelayUnique(monitorID, delay, 0)
}

func (j *MonitorCheckJob) QueueWithDelayUnique(monitorID string, delay time.Duration, uniqueTTL time.Duration) error {
	payload, err := json.Marshal(MonitorCheckPayload{MonitorID: monitorID})
	if err != nil {
		return err
	}
	options := []asynq.Option{
		asynq.Timeout(2 * time.Minute),
		asynq.Queue("default"),
		asynq.MaxRetry(3),
	}
	if delay > 0 {
		options = append(options, asynq.ProcessIn(delay))
	}
	if uniqueTTL > 0 {
		options = append(options, asynq.Unique(uniqueTTL))
	}
	_, err = j.queue.Enqueue(
		asynq.NewTask(MonitorCheckJobTypeName, payload),
		options...,
	)
	if errors.Is(err, asynq.ErrDuplicateTask) {
		return nil
	}
	return err
}

func (j *MonitorCheckJob) QueueDue() error {
	db, err := j.db.Default()
	if err != nil {
		return err
	}
	type row struct {
		ID              string `gorm:"column:id"`
		MonitorType     string `gorm:"column:monitor_type"`
		IntervalSeconds int    `gorm:"column:interval_seconds"`
		ScheduleJitterMs int   `gorm:"column:schedule_jitter_ms"`
	}
	var monitors []row
	if err := db.Raw("SELECT id, monitor_type, interval_seconds, schedule_jitter_ms FROM monitors WHERE enabled = ?", true).Scan(&monitors).Error; err != nil {
		return err
	}
	now := time.Now().UTC()
	for _, monitor := range monitors {
		if strings.EqualFold(strings.TrimSpace(monitor.MonitorType), "push") {
			continue
		}
		interval := monitor.IntervalSeconds
		if interval <= 0 {
			interval = 60
		}
		intervalDur := time.Duration(interval) * time.Second
		nextDue := now.Truncate(intervalDur).Add(intervalDur)
		delay := nextDue.Sub(now)
		// Only schedule when the next aligned interval is close enough; this keeps
		// all monitors on the same interval cadence without per-monitor drift.
		if delay > monitorQueueLookahead {
			continue
		}
		if delay < 0 {
			delay = 0
		}
		if monitor.ScheduleJitterMs > 0 {
			delay += deterministicJitter(now, monitor.ID, monitor.ScheduleJitterMs)
		}
		uniqueTTL := intervalDur + monitorQueueLookahead
		if uniqueTTL < 10*time.Second {
			uniqueTTL = 10 * time.Second
		}
		if err := j.QueueWithDelayUnique(monitor.ID, delay, uniqueTTL); err != nil {
			j.logger.Error().Err(err).Str("monitor_id", monitor.ID).Msg("queue monitor check failed")
			continue
		}
	}
	return nil
}

// TriggerDemoPushMonitor writes one synthetic "up" check for the demo push monitor.
func (j *MonitorCheckJob) TriggerDemoPushMonitor() error {
	m, err := j.monitorRepo.ByID(demoPushMonitorID)
	if err != nil {
		return err
	}
	monitorID := monitorIDString(m)
	if m == nil || monitorID == "" || !m.Enabled {
		return nil
	}
	if !strings.EqualFold(strings.TrimSpace(m.MonitorType), "push") {
		return nil
	}
	return j.writeCheckWithPolicy(monitorID, m, checkResult{
		status:     "up",
		statusCode: http.StatusOK,
		durationMs: 1,
	})
}

func (j *MonitorCheckJob) Handle(ctx context.Context, task *asynq.Task) error {
	var payload MonitorCheckPayload
	if err := json.Unmarshal(task.Payload(), &payload); err != nil {
		return fmt.Errorf("invalid payload: %w", asynq.SkipRetry)
	}
	if payload.MonitorID == "" {
		return fmt.Errorf("missing monitor id: %w", asynq.SkipRetry)
	}

	m, err := j.monitorRepo.ByID(payload.MonitorID)
	if err != nil {
		return err
	}
	monitorID := monitorIDString(m)
	if m == nil || monitorID == "" || !m.Enabled {
		return nil
	}

	timeout := 5 * time.Second
	if m.TimeoutMs > 0 {
		timeout = time.Duration(m.TimeoutMs) * time.Millisecond
	}
	if m.CircuitOpenUntil != nil && m.CircuitOpenUntil.After(time.Now().UTC()) {
		result := checkResult{
			status:     "down",
			statusCode: 0,
			durationMs: 0,
			errClass:   "circuit_open",
			errText:    classifyCheckError(m.MonitorType, "circuit open: "+m.CircuitReason.ValueOrZero()),
			retryable:  false,
			dnsOrTLS:   false,
		}
		return j.writeCheckWithPolicy(monitorID, m, result)
	}
	result := j.runWithRetry(ctx, m, timeout)
	if err := j.writeCheckWithPolicy(monitorID, m, result); err != nil {
		return err
	}
	return nil
}

func (j *MonitorCheckJob) runWithRetry(ctx context.Context, m *models.Monitor, timeout time.Duration) checkResult {
	attempts := m.RetryAttempts + 1
	if attempts < 1 {
		attempts = 1
	}
	if attempts > monitorMaxRetryAttempts {
		attempts = monitorMaxRetryAttempts
	}
	backoff := time.Duration(m.RetryBackoffMs) * time.Millisecond
	if backoff <= 0 {
		backoff = 250 * time.Millisecond
	}
	jitter := time.Duration(m.ScheduleJitterMs) * time.Millisecond
	if jitter < 0 {
		jitter = 0
	}
	var result checkResult
	for attempt := 1; attempt <= attempts; attempt++ {
		result = j.runSingleCheck(ctx, m, timeout)
		if result.status == "up" || !result.retryable || attempt == attempts {
			return result
		}
		sleep := backoff * time.Duration(attempt)
		if sleep > monitorRetryCap {
			sleep = monitorRetryCap
		}
		if jitter > 0 {
			sleep += deterministicRetryJitter(monitorIDString(m), attempt, jitter)
		}
		timer := time.NewTimer(sleep)
		select {
		case <-ctx.Done():
			timer.Stop()
			return result
		case <-timer.C:
		}
	}
	return result
}

func (j *MonitorCheckJob) runSingleCheck(ctx context.Context, m *models.Monitor, timeout time.Duration) checkResult {
	switch m.MonitorType {
	case "tcp":
		start := time.Now()
		conn, err := net.DialTimeout("tcp", m.Target, timeout)
		duration := time.Since(start).Milliseconds()
		if err != nil {
			class := classifyCheckClass(err.Error())
			return checkResult{
				status:     "down",
				statusCode: 0,
				durationMs: duration,
				errClass:   class,
				errText:    classifyCheckError("tcp", err.Error()),
				retryable:  isRetryableClass(class),
				dnsOrTLS:   class == "dns" || class == "tls",
			}
		}
		_ = conn.Close()
		return checkResult{status: "up", statusCode: 0, durationMs: duration}
	case "ping":
		start := time.Now()
		resolverCtx, cancel := context.WithTimeout(ctx, timeout)
		defer cancel()
		_, err := net.DefaultResolver.LookupHost(resolverCtx, m.Target)
		duration := time.Since(start).Milliseconds()
		if err != nil {
			class := classifyCheckClass(err.Error())
			return checkResult{
				status:     "down",
				statusCode: 0,
				durationMs: duration,
				errClass:   class,
				errText:    classifyCheckError("ping", err.Error()),
				retryable:  isRetryableClass(class),
				dnsOrTLS:   class == "dns",
			}
		}
		return checkResult{status: "up", statusCode: 0, durationMs: duration}
	case "dns":
		statusCode, duration, errClass, errText, retryable := j.runDNSCheck(ctx, m.Target, timeout)
		return checkResult{
			status:     statusFromError(errText),
			statusCode: statusCode,
			durationMs: duration,
			errClass:   errClass,
			errText:    errText,
			retryable:  retryable,
			dnsOrTLS:   errClass == "dns",
		}
	case "tls":
		statusCode, duration, errClass, errText, retryable := j.runTLSCheck(ctx, m.Target, timeout)
		return checkResult{
			status:     statusFromError(errText),
			statusCode: statusCode,
			durationMs: duration,
			errClass:   errClass,
			errText:    errText,
			retryable:  retryable,
			dnsOrTLS:   errClass == "dns" || errClass == "tls",
		}
	case "http_keyword":
		// Prime the connection before measuring to reduce cold-start/TLS spike noise.
		targetURL, keyword, parseErr := parseHTTPKeywordTarget(m.Target)
		if parseErr != nil {
			return checkResult{
				status:    "down",
				errClass:  "validation",
				errText:   classifyCheckError("http_keyword", parseErr.Error()),
				retryable: false,
			}
		}
		j.primeHTTPConnection(ctx, targetURL, timeout)
		statusCode, duration, reqErr := j.runHTTPCheck(ctx, targetURL, timeout)
		if reqErr != nil {
			class := classifyCheckClass(reqErr.Error())
			return checkResult{
				status:     "down",
				statusCode: statusCode,
				durationMs: duration,
				errClass:   class,
				errText:    classifyCheckError("http_keyword", reqErr.Error()),
				retryable:  isRetryableClass(class),
				dnsOrTLS:   class == "dns" || class == "tls",
			}
		}
		body, err := j.fetchHTTPBody(ctx, targetURL, timeout)
		if err != nil {
			class := classifyCheckClass(err.Error())
			return checkResult{
				status:     "down",
				statusCode: statusCode,
				durationMs: duration,
				errClass:   class,
				errText:    classifyCheckError("http_keyword", err.Error()),
				retryable:  isRetryableClass(class),
				dnsOrTLS:   class == "dns" || class == "tls",
			}
		}
		if !strings.Contains(strings.ToLower(body), strings.ToLower(keyword)) {
			return checkResult{
				status:     "down",
				statusCode: statusCode,
				durationMs: duration,
				errClass:   "keyword",
				errText:    classifyCheckError("http_keyword", "keyword not found"),
				retryable:  false,
			}
		}
		return checkResult{status: "up", statusCode: statusCode, durationMs: duration}
	case "http_json_query":
		targetURL, path, expected, parseErr := parseHTTPJSONQueryTarget(m.Target)
		if parseErr != nil {
			return checkResult{
				status:    "down",
				errClass:  "validation",
				errText:   classifyCheckError("http_json_query", parseErr.Error()),
				retryable: false,
			}
		}
		j.primeHTTPConnection(ctx, targetURL, timeout)
		statusCode, duration, reqErr := j.runHTTPCheck(ctx, targetURL, timeout)
		if reqErr != nil {
			class := classifyCheckClass(reqErr.Error())
			return checkResult{
				status:     "down",
				statusCode: statusCode,
				durationMs: duration,
				errClass:   class,
				errText:    classifyCheckError("http_json_query", reqErr.Error()),
				retryable:  isRetryableClass(class),
				dnsOrTLS:   class == "dns" || class == "tls",
			}
		}
		body, err := j.fetchHTTPBody(ctx, targetURL, timeout)
		if err != nil {
			class := classifyCheckClass(err.Error())
			return checkResult{
				status:     "down",
				statusCode: statusCode,
				durationMs: duration,
				errClass:   class,
				errText:    classifyCheckError("http_json_query", err.Error()),
				retryable:  isRetryableClass(class),
				dnsOrTLS:   class == "dns" || class == "tls",
			}
		}
		var decoded any
		if err := json.Unmarshal([]byte(body), &decoded); err != nil {
			return checkResult{
				status:     "down",
				statusCode: statusCode,
				durationMs: duration,
				errClass:   "json",
				errText:    classifyCheckError("http_json_query", "invalid json body"),
				retryable:  false,
			}
		}
		value, ok := resolveJSONPath(decoded, path)
		if !ok {
			return checkResult{
				status:     "down",
				statusCode: statusCode,
				durationMs: duration,
				errClass:   "json_path",
				errText:    classifyCheckError("http_json_query", "json path not found"),
				retryable:  false,
			}
		}
		if strings.TrimSpace(fmt.Sprintf("%v", value)) != expected {
			return checkResult{
				status:     "down",
				statusCode: statusCode,
				durationMs: duration,
				errClass:   "json_value",
				errText:    classifyCheckError("http_json_query", "json value mismatch"),
				retryable:  false,
			}
		}
		return checkResult{status: "up", statusCode: statusCode, durationMs: duration}
	case "websocket":
		statusCode, duration, errClass, errText, retryable := j.runWebsocketCheck(ctx, m.Target, timeout)
		return checkResult{
			status:     statusFromError(errText),
			statusCode: statusCode,
			durationMs: duration,
			errClass:   errClass,
			errText:    errText,
			retryable:  retryable,
			dnsOrTLS:   errClass == "dns" || errClass == "tls",
		}
	case "push":
		// Passive monitor type: external systems push check results via API.
		return checkResult{
			status:     "unknown",
			statusCode: 0,
			durationMs: 0,
			errClass:   "push_passive",
			errText:    "",
			retryable:  false,
		}
	default:
		// Prime the connection before measuring to reduce cold-start/TLS spike noise.
		j.primeHTTPConnection(ctx, m.Target, timeout)
		statusCode, duration, reqErr := j.runHTTPCheck(ctx, m.Target, timeout)
		if reqErr != nil {
			class := classifyCheckClass(reqErr.Error())
			return checkResult{
				status:     "down",
				statusCode: statusCode,
				durationMs: duration,
				errClass:   class,
				errText:    classifyCheckError("http", reqErr.Error()),
				retryable:  isRetryableClass(class),
				dnsOrTLS:   class == "dns" || class == "tls",
			}
		}
		if statusCode >= 200 && statusCode < 500 {
			return checkResult{status: "up", statusCode: statusCode, durationMs: duration}
		}
		return checkResult{
			status:     "down",
			statusCode: statusCode,
			durationMs: duration,
			errClass:   "status",
			errText:    classifyCheckError("http", fmt.Sprintf("status=%d", statusCode)),
			retryable:  false,
		}
	}
}

func statusFromError(errText string) string {
	if strings.TrimSpace(errText) == "" {
		return "up"
	}
	return "down"
}

func (j *MonitorCheckJob) primeHTTPConnection(ctx context.Context, target string, timeout time.Duration) {
	warmTimeout := timeout
	if warmTimeout > 1500*time.Millisecond {
		warmTimeout = 1500 * time.Millisecond
	}
	_, _, _ = j.runHTTPCheckWithClient(ctx, j.httpxPrimary, "HEAD", target, warmTimeout)
}

func (j *MonitorCheckJob) runHTTPCheck(ctx context.Context, target string, timeout time.Duration) (int, int64, error) {
	statusCode, duration, err := j.runHTTPCheckWithClient(ctx, j.httpxPrimary, "GET", target, timeout)
	if !shouldRetryWithChromeProfile(statusCode, err) {
		if shouldRetryWithHTTP1(err) {
			http1Status, http1Duration, http1Err := j.runHTTPCheckWithClient(ctx, j.httpxHTTP1, "GET", target, timeout)
			if http1Err == nil {
				return http1Status, http1Duration, nil
			}
			return http1Status, http1Duration, http1Err
		}
		return statusCode, duration, err
	}

	fallbackStatus, fallbackDuration, fallbackErr := j.runHTTPCheckWithClient(ctx, j.httpxChrome, "GET", target, timeout)
	if fallbackErr == nil {
		return fallbackStatus, fallbackDuration, nil
	}

	if shouldRetryWithHTTP1(fallbackErr) {
		http1Status, http1Duration, http1Err := j.runHTTPCheckWithClient(ctx, j.httpxHTTP1, "GET", target, timeout)
		if http1Err == nil {
			return http1Status, http1Duration, nil
		}
		return http1Status, http1Duration, http1Err
	}

	return fallbackStatus, fallbackDuration, fallbackErr
}

func (j *MonitorCheckJob) runHTTPCheckWithClient(ctx context.Context, client *httpx.Client, method, target string, timeout time.Duration) (int, int64, error) {
	reqCtx, cancel := context.WithTimeout(ctx, timeout)
	defer cancel()

	r := client.Req().R()
	r.SetContext(reqCtx)

	start := time.Now()
	switch method {
	case "HEAD":
		resp, err := r.Head(target)
		duration := time.Since(start).Milliseconds()
		if resp != nil && resp.Response != nil {
			return resp.StatusCode, duration, err
		}
		if err != nil {
			return 0, duration, err
		}
		return 0, duration, nil
	default:
		resp, err := r.Get(target)
		duration := time.Since(start).Milliseconds()
		if resp != nil && resp.Response != nil {
			return resp.StatusCode, duration, err
		}
		if err != nil {
			return 0, duration, err
		}
		return 0, duration, nil
	}
}

func (j *MonitorCheckJob) fetchHTTPBody(ctx context.Context, target string, timeout time.Duration) (string, error) {
	reqCtx, cancel := context.WithTimeout(ctx, timeout)
	defer cancel()
	resp, err := j.httpxPrimary.Req().R().SetContext(reqCtx).Get(target)
	if err != nil {
		return "", err
	}
	if resp == nil || resp.Response == nil || resp.Response.Body == nil {
		return "", fmt.Errorf("empty body")
	}
	data, readErr := io.ReadAll(resp.Response.Body)
	if readErr != nil {
		return "", readErr
	}
	return string(data), nil
}

func (j *MonitorCheckJob) runDNSCheck(ctx context.Context, target string, timeout time.Duration) (int, int64, string, string, bool) {
	host, recordType, err := parseDNSMonitorTarget(target)
	if err != nil {
		return 0, 0, "validation", classifyCheckError("dns", err.Error()), false
	}
	start := time.Now()
	resolverCtx, cancel := context.WithTimeout(ctx, timeout)
	defer cancel()
	var lookupErr error
	switch recordType {
	case "AAAA":
		_, lookupErr = net.DefaultResolver.LookupIP(resolverCtx, "ip6", host)
	case "CNAME":
		_, lookupErr = net.DefaultResolver.LookupCNAME(resolverCtx, host)
	case "MX":
		_, lookupErr = net.DefaultResolver.LookupMX(resolverCtx, host)
	case "NS":
		_, lookupErr = net.DefaultResolver.LookupNS(resolverCtx, host)
	case "TXT":
		_, lookupErr = net.DefaultResolver.LookupTXT(resolverCtx, host)
	default:
		_, lookupErr = net.DefaultResolver.LookupHost(resolverCtx, host)
	}
	duration := time.Since(start).Milliseconds()
	if lookupErr != nil {
		class := classifyCheckClass(lookupErr.Error())
		return 0, duration, class, classifyCheckError("dns", lookupErr.Error()), isRetryableClass(class)
	}
	return 200, duration, "", "", false
}

func (j *MonitorCheckJob) runTLSCheck(ctx context.Context, target string, timeout time.Duration) (int, int64, string, string, bool) {
	host, port, err := parseTLSMonitorTarget(target)
	if err != nil {
		return 0, 0, "validation", classifyCheckError("tls", err.Error()), false
	}
	address := net.JoinHostPort(host, port)
	dialer := &net.Dialer{Timeout: timeout}
	start := time.Now()
	conn, dialErr := tls.DialWithDialer(dialer, "tcp", address, &tls.Config{
		ServerName:         host,
		InsecureSkipVerify: false,
		MinVersion:         tls.VersionTLS12,
	})
	duration := time.Since(start).Milliseconds()
	if dialErr != nil {
		class := classifyCheckClass(dialErr.Error())
		return 0, duration, class, classifyCheckError("tls", dialErr.Error()), isRetryableClass(class)
	}
	defer conn.Close()
	state := conn.ConnectionState()
	now := time.Now().UTC()
	if len(state.PeerCertificates) > 0 {
		cert := state.PeerCertificates[0]
		if now.After(cert.NotAfter) {
			return 0, duration, "tls", classifyCheckError("tls", "certificate expired"), false
		}
	}
	return 200, duration, "", "", false
}

func parseDNSMonitorTarget(target string) (string, string, error) {
	parts := strings.SplitN(strings.TrimSpace(target), "|", 2)
	host := strings.TrimSpace(parts[0])
	if host == "" {
		return "", "", fmt.Errorf("missing host")
	}
	recordType := "A"
	if len(parts) == 2 {
		recordType = strings.ToUpper(strings.TrimSpace(parts[1]))
	}
	return host, recordType, nil
}

func parseTLSMonitorTarget(target string) (string, string, error) {
	value := strings.TrimSpace(target)
	if value == "" {
		return "", "", fmt.Errorf("missing target")
	}
	if strings.Contains(value, "://") {
		u, err := neturl.Parse(value)
		if err != nil || u.Host == "" {
			return "", "", fmt.Errorf("invalid url")
		}
		host := u.Hostname()
		port := u.Port()
		if port == "" {
			port = "443"
		}
		return host, port, nil
	}
	host, port, err := net.SplitHostPort(value)
	if err == nil {
		return host, port, nil
	}
	return value, "443", nil
}

func parseHTTPKeywordTarget(target string) (string, string, error) {
	parts := strings.SplitN(strings.TrimSpace(target), "|", 2)
	if len(parts) != 2 {
		return "", "", fmt.Errorf("missing separator")
	}
	urlValue := strings.TrimSpace(parts[0])
	keyword := strings.TrimSpace(parts[1])
	if urlValue == "" || keyword == "" {
		return "", "", fmt.Errorf("invalid value")
	}
	return urlValue, keyword, nil
}

func parseHTTPJSONQueryTarget(target string) (string, string, string, error) {
	parts := strings.SplitN(strings.TrimSpace(target), "|", 3)
	if len(parts) != 3 {
		return "", "", "", fmt.Errorf("missing segments")
	}
	urlValue := strings.TrimSpace(parts[0])
	path := strings.TrimSpace(parts[1])
	expected := strings.TrimSpace(parts[2])
	if urlValue == "" || path == "" || expected == "" {
		return "", "", "", fmt.Errorf("invalid value")
	}
	return urlValue, path, expected, nil
}

func resolveJSONPath(value any, path string) (any, bool) {
	parts := strings.Split(strings.TrimSpace(path), ".")
	current := value
	for _, part := range parts {
		key := strings.TrimSpace(part)
		if key == "" {
			return nil, false
		}
		obj, ok := current.(map[string]any)
		if !ok {
			return nil, false
		}
		next, exists := obj[key]
		if !exists {
			return nil, false
		}
		current = next
	}
	return current, true
}

func (j *MonitorCheckJob) runWebsocketCheck(ctx context.Context, target string, timeout time.Duration) (int, int64, string, string, bool) {
	u, err := neturl.Parse(strings.TrimSpace(target))
	if err != nil || u.Host == "" || (u.Scheme != "ws" && u.Scheme != "wss") {
		return 0, 0, "validation", classifyCheckError("websocket", "invalid websocket target"), false
	}
	dialer := websocket.Dialer{
		HandshakeTimeout: timeout,
	}
	start := time.Now()
	conn, resp, dialErr := dialer.DialContext(ctx, target, nil)
	duration := time.Since(start).Milliseconds()
	if dialErr != nil {
		class := classifyCheckClass(dialErr.Error())
		statusCode := 0
		if resp != nil {
			statusCode = resp.StatusCode
		}
		return statusCode, duration, class, classifyCheckError("websocket", dialErr.Error()), isRetryableClass(class)
	}
	_ = conn.Close()
	return 101, duration, "", "", false
}

func shouldRetryWithChromeProfile(statusCode int, reqErr error) bool {
	if isLikelyBotOrProtocolBlock(reqErr) {
		return true
	}
	switch statusCode {
	case http.StatusForbidden, http.StatusTooManyRequests, http.StatusServiceUnavailable:
		return true
	default:
		return false
	}
}

func shouldRetryWithHTTP1(reqErr error) bool {
	if reqErr == nil {
		return false
	}
	lower := strings.ToLower(reqErr.Error())
	return strings.Contains(lower, "stream error") ||
		strings.Contains(lower, "internal_error") ||
		strings.Contains(lower, "http2") ||
		strings.Contains(lower, "protocol error")
}

func isLikelyBotOrProtocolBlock(reqErr error) bool {
	if reqErr == nil {
		return false
	}
	lower := strings.ToLower(reqErr.Error())
	return strings.Contains(lower, "forbidden") ||
		strings.Contains(lower, "stream error") ||
		strings.Contains(lower, "internal_error") ||
		strings.Contains(lower, "http2")
}

func classifyCheckClass(msg string) string {
	lower := strings.ToLower(msg)
	switch {
	case strings.Contains(lower, "timeout"), strings.Contains(lower, "deadline exceeded"):
		return "timeout"
	case strings.Contains(lower, "no such host"), strings.Contains(lower, "lookup"):
		return "dns"
	case strings.Contains(lower, "x509"), strings.Contains(lower, "certificate"), strings.Contains(lower, "tls"):
		return "tls"
	case strings.Contains(lower, "refused"), strings.Contains(lower, "reset"), strings.Contains(lower, "no route"):
		return "network"
	case strings.Contains(lower, "status="):
		return "status"
	case strings.Contains(lower, "keyword"):
		return "keyword"
	default:
		return "check"
	}
}

func isRetryableClass(class string) bool {
	switch class {
	case "timeout", "dns", "tls", "network":
		return true
	default:
		return false
	}
}

func classifyCheckError(kind string, msg string) string {
	tag := classifyCheckClass(msg)
	return fmt.Sprintf("[%s/%s] %s", kind, tag, msg)
}

func deterministicJitter(now time.Time, key string, jitterMs int) time.Duration {
	if jitterMs <= 0 {
		return 0
	}
	h := fnv.New32a()
	_, _ = h.Write([]byte(key))
	_, _ = h.Write([]byte(now.Truncate(time.Minute).Format(time.RFC3339)))
	mod := int(h.Sum32() % uint32(jitterMs+1))
	return time.Duration(mod) * time.Millisecond
}

func deterministicRetryJitter(key string, attempt int, max time.Duration) time.Duration {
	if max <= 0 {
		return 0
	}
	h := fnv.New32a()
	_, _ = h.Write([]byte(key))
	_, _ = h.Write([]byte(fmt.Sprintf("-%d", attempt)))
	mod := int64(h.Sum32()) % max.Milliseconds()
	if mod < 0 {
		mod = 0
	}
	return time.Duration(mod) * time.Millisecond
}

func parseDBTimestamp(value string) (time.Time, error) {
	value = strings.TrimSpace(value)
	layouts := []string{
		time.RFC3339Nano,
		"2006-01-02 15:04:05.999999999Z07:00",
		"2006-01-02 15:04:05.999999999",
		"2006-01-02 15:04:05",
	}
	for _, layout := range layouts {
		if ts, err := time.Parse(layout, value); err == nil {
			if ts.Location() == time.Local {
				return ts.UTC(), nil
			}
			return ts, nil
		}
	}
	return time.Time{}, fmt.Errorf("parse timestamp: %s", value)
}

func monitorIDString(m *models.Monitor) string {
	if m == nil {
		return ""
	}
	return anyIDToString(m.Id)
}

func anyIDToString(v any) string {
	switch id := v.(type) {
	case string:
		return id
	case null.String:
		return id.String
	default:
		return strings.TrimSpace(fmt.Sprint(v))
	}
}

func (j *MonitorCheckJob) writeCheckWithPolicy(monitorID string, monitor *models.Monitor, result checkResult) error {
	now := time.Now().UTC()
	checkID := fmt.Sprintf("%d", now.UnixNano())
	if err := j.monitorCheckRepo.Create(&models.MonitorCheck{
		Id:           null.StringFrom(checkID),
		MonitorId:    monitorID,
		CheckedAt:    now,
		Status:       result.status,
		StatusCode:   null.IntFrom(int64(result.statusCode)),
		DurationMs:   null.IntFrom(result.durationMs),
		ErrorMessage: null.StringFrom(result.errText),
	}); err != nil {
		return err
	}

	if monitor != nil {
		if result.status == "up" {
			monitor.FailureStreak = 0
			monitor.DNSTLSFailureStreak = 0
			monitor.CircuitOpenUntil = nil
			monitor.CircuitReason = null.String{}
		} else {
			monitor.FailureStreak++
			if result.dnsOrTLS {
				monitor.DNSTLSFailureStreak++
			} else {
				monitor.DNSTLSFailureStreak = 0
			}
			if monitor.DNSTLSFailureStreak >= monitorCircuitThreshold {
				until := now.Add(monitorCircuitTTL)
				monitor.CircuitOpenUntil = &until
				monitor.CircuitReason = null.StringFrom(result.errClass)
			}
		}
		monitor.UpdatedAt = now
		if err := j.monitorRepo.Update(monitor); err != nil {
			j.logger.Error().Err(err).Str("monitor_id", monitorID).Msg("update monitor policy state failed")
		}
	}

	openIncident, err := j.latestOpenIncident(monitorID)
	if err != nil {
		return err
	}

	switch result.status {
	case "down":
		if openIncident != nil {
			return nil
		}
		streak, err := j.consecutiveStatusCount(monitorID, "down", monitorStreakScanLimit)
		if err != nil {
			return err
		}
		if streak < monitorDownThreshold {
			return nil
		}
		incidentID := fmt.Sprintf("incident_%d", now.UnixNano())
		summary := "Monitor transitioned to down state"
		if err := j.incidentRepo.Create(&models.Incident{
			Id:        null.StringFrom(incidentID),
			MonitorId: monitorID,
			OpenedAt:  now,
			Summary:   summary,
		}); err != nil {
			j.logger.Error().Err(err).Str("monitor_id", monitorID).Msg("open incident failed")
		}
	case "up":
		if openIncident == nil {
			return nil
		}
		streak, err := j.consecutiveStatusCount(monitorID, "up", monitorStreakScanLimit)
		if err != nil {
			return err
		}
		if streak < monitorRecoveryThreshold {
			return nil
		}
		openIncident.ResolvedAt = &now
		if err := j.incidentRepo.Update(openIncident); err != nil {
			j.logger.Error().Err(err).Str("incident_id", anyIDToString(openIncident.Id)).Msg("resolve incident failed")
		}
	}
	return nil
}

func (j *MonitorCheckJob) consecutiveStatusCount(monitorID, target string, limit int) (int, error) {
	rows, err := j.monitorCheckRepo.LatestByMonitor(monitorID, limit)
	if err != nil {
		return 0, err
	}
	count := 0
	for _, row := range rows {
		state := strings.ToLower(strings.TrimSpace(row.Status))
		if state == "paused" || state == "unknown" || state == "" {
			continue
		}
		if state != target {
			break
		}
		count++
	}
	return count, nil
}

func (j *MonitorCheckJob) latestOpenIncident(monitorID string) (*models.Incident, error) {
	incidentConn, err := j.incidentRepo.Builder()
	if err != nil {
		return nil, err
	}
	var incident models.Incident
	if err := incidentConn.
		Where("monitor_id = ? AND resolved_at IS NULL", monitorID).
		Order("opened_at DESC").
		Limit(1).
		First(&incident).Error; err != nil {
		if errors.Is(err, gorm.ErrRecordNotFound) {
			return nil, nil
		}
		return nil, err
	}
	return &incident, nil
}
