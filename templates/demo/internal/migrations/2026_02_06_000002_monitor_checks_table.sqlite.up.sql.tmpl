CREATE TABLE IF NOT EXISTS monitor_checks (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    monitor_id BIGINT NOT NULL,
    checked_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    status VARCHAR(32) NOT NULL,
    status_code INTEGER NULL,
    duration_ms INTEGER NULL,
    error_message TEXT NULL
);

CREATE INDEX idx_monitor_checks_monitor_id_checked_at
ON monitor_checks (monitor_id, checked_at DESC, id DESC);

CREATE INDEX idx_monitor_checks_checked_at
ON monitor_checks (checked_at DESC, id DESC);

CREATE INDEX idx_monitor_checks_monitor_id_status_checked_at
ON monitor_checks (monitor_id, status, checked_at DESC, id DESC);
