-- Keep passive push demo monitor stable by default, but keep websocket active.
UPDATE monitors
SET target = 'wss://echo.websocket.org', enabled = TRUE, updated_at = STRFTIME('%Y-%m-%d %H:%M:%f', 'now')
WHERE id = 'monitor_ws_echo';

UPDATE monitors
SET enabled = TRUE, updated_at = STRFTIME('%Y-%m-%d %H:%M:%f', 'now')
WHERE id = 'monitor_push_demo';

DELETE FROM monitor_checks
WHERE monitor_id = 'monitor_ws_echo'
  AND error_message = 'stable-default'
  AND status = 'paused';

DELETE FROM monitor_checks
WHERE monitor_id = 'monitor_push_demo'
  AND error_message = 'stable-default'
  AND status = 'paused';
