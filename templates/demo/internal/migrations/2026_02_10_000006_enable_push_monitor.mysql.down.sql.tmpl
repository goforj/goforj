-- Roll back push monitor enablement.
UPDATE monitors
SET enabled = FALSE, updated_at = UTC_TIMESTAMP(6)
WHERE name = 'Push Monitor';

INSERT INTO monitor_checks (monitor_id, checked_at, status, status_code, duration_ms, error_message)
SELECT
  m.id,
  UTC_TIMESTAMP(6),
  'paused',
  0,
  0,
  'stable-default'
FROM monitors m
WHERE m.name = 'Push Monitor';
