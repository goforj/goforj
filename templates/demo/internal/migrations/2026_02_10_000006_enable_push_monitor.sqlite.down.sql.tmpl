-- Roll back push monitor enablement.
UPDATE monitors
SET enabled = FALSE, updated_at = STRFTIME('%Y-%m-%d %H:%M:%f', 'now')
WHERE id = 'monitor_push_primary';

INSERT INTO monitor_checks (id, monitor_id, checked_at, status, status_code, duration_ms, error_message)
SELECT
  'check_' || ABS(RANDOM()),
  m.id,
  STRFTIME('%Y-%m-%d %H:%M:%f', 'now'),
  'paused',
  0,
  0,
  'stable-default'
FROM monitors m
WHERE m.id = 'monitor_push_primary';

