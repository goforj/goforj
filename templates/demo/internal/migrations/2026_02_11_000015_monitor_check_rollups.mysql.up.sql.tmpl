CREATE TABLE IF NOT EXISTS monitor_check_rollups (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    monitor_id BIGINT NOT NULL,
    resolution VARCHAR(16) NOT NULL,
    bucket_start DATETIME NOT NULL,
    sample_count BIGINT NOT NULL DEFAULT 0,
    up_count BIGINT NOT NULL DEFAULT 0,
    down_count BIGINT NOT NULL DEFAULT 0,
    avg_duration_ms BIGINT NOT NULL DEFAULT 0,
    first_checked_at DATETIME NOT NULL,
    last_checked_at DATETIME NOT NULL,
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    UNIQUE KEY uq_monitor_check_rollups_bucket (monitor_id, resolution, bucket_start),
    KEY idx_monitor_check_rollups_bucket_start (bucket_start),
    KEY idx_monitor_check_rollups_resolution_bucket (resolution, bucket_start)
);
