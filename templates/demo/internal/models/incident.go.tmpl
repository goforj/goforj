// Create inserts a new Incident row.
func (r *IncidentRepo) Create(model *Incident) error {
	conn, err := r.connection()
	if err != nil {
		return err
	}
	if model.MonitorId <= 0 {
		return fmt.Errorf("incident create: monitor_id must be > 0")
	}
	return conn.Create(model).Error
}

// Update persists changes to an existing Incident row.
func (r *IncidentRepo) Update(model *Incident) error {
	conn, err := r.connection()
	if err != nil {
		return err
	}
	return conn.Save(model).Error
}

// DeleteByID removes a Incident row by primary key.
func (r *IncidentRepo) DeleteByID(id any) error {
	conn, err := r.connection()
	if err != nil {
		return err
	}
	return conn.Delete(&Incident{}, id).Error
}

// DeleteWhere removes Incident rows matching a where map.
func (r *IncidentRepo) DeleteWhere(where map[string]any) error {
	conn, err := r.connection()
	if err != nil {
		return err
	}
	return conn.Where(where).Delete(&Incident{}).Error
}

// PurgeAll removes all incident rows.
func (r *IncidentRepo) PurgeAll() error {
	conn, err := r.connection()
	if err != nil {
		return err
	}
	return conn.Session(&gorm.Session{AllowGlobalUpdate: true}).Delete(&Incident{}).Error
}

// DeleteResolvedOlderThan removes resolved incidents older than the given timestamp.
func (r *IncidentRepo) DeleteResolvedOlderThan(cutoff time.Time) (int64, error) {
	conn, err := r.connection()
	if err != nil {
		return 0, err
	}
	tx := conn.Where("resolved_at IS NOT NULL AND resolved_at < ?", cutoff.UTC()).Delete(&Incident{})
	return tx.RowsAffected, tx.Error
}
