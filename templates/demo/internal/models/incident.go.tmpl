type Incident struct {
	Id         null.String `gorm:"column:id" json:"id"`
	MonitorId  int64       `gorm:"column:monitor_id" json:"monitor_id"`
	OpenedAt   time.Time   `gorm:"column:opened_at" json:"opened_at"`
	ResolvedAt *time.Time  `gorm:"column:resolved_at" json:"resolved_at"`
	Summary    string      `gorm:"column:summary" json:"summary"`
}

// TableName returns the database table name.
func (*Incident) TableName() string {
	return "incidents"
}

// Relationships returns the relationship paths for eager loading.
func (*Incident) Relationships() []string {
	return []string{}
}

//
// Repository
//

// IncidentRepo provides persistence helpers for Incident.
type IncidentRepo struct {
	db *dbconns.Connections
}

// NewIncidentRepo creates a new Incident repository.
func NewIncidentRepo(db *dbconns.Connections) *IncidentRepo {
	return &IncidentRepo{db: db}
}

// Builder returns a query builder for Incident.
// Treat this as an escape hatch for quick manual querying; prefer repository methods.
func (r *IncidentRepo) Builder() (*gorm.DB, error) {
	return r.connection()
}

// connection resolves the default database connection for repository actions.
func (r *IncidentRepo) connection() (*gorm.DB, error) {
	return r.db.Default()
}

func parseIncidentMonitorID(monitorID string) (int64, error) {
	parsed, err := strconv.ParseInt(strings.TrimSpace(monitorID), 10, 64)
	if err != nil || parsed <= 0 {
		return 0, fmt.Errorf("invalid monitor id %q", strings.TrimSpace(monitorID))
	}
	return parsed, nil
}

// ByID fetches a Incident by primary key.
func (r *IncidentRepo) ByID(id any) (*Incident, error) {
	conn, err := r.connection()
	if err != nil {
		return nil, err
	}
	var model Incident
	if idAsString, ok := id.(string); ok {
		if err := conn.Where("id = ?", idAsString).First(&model).Error; err != nil {
			return nil, err
		}
	} else if err := conn.First(&model, id).Error; err != nil {
		return nil, err
	}
	return &model, nil
}

// GetWhere fetches matching Incident rows by a where map.
func (r *IncidentRepo) GetWhere(where map[string]any) ([]Incident, error) {
	conn, err := r.connection()
	if err != nil {
		return nil, err
	}
	var models []Incident
	if err := conn.Where(where).Find(&models).Error; err != nil {
		return nil, err
	}
	return models, nil
}

// All fetches all Incident rows.
func (r *IncidentRepo) All() ([]Incident, error) {
	conn, err := r.connection()
	if err != nil {
		return nil, err
	}
	var models []Incident
	if err := conn.Find(&models).Error; err != nil {
		return nil, err
	}
	return models, nil
}

// CountOpen returns number of unresolved incidents.
func (r *IncidentRepo) CountOpen() (int64, error) {
	conn, err := r.connection()
	if err != nil {
		return 0, err
	}
	var count int64
	if err := conn.Model(&Incident{}).Where("resolved_at IS NULL").Count(&count).Error; err != nil {
		return 0, err
	}
	return count, nil
}

// RecentWithMonitor returns latest incidents with monitor names.
func (r *IncidentRepo) RecentWithMonitor(limit int) ([]IncidentWithMonitor, error) {
	conn, err := r.connection()
	if err != nil {
		return nil, err
	}
	if limit <= 0 {
		limit = 100
	}
	var rows []IncidentWithMonitor
	if err := conn.Table("incidents i").
		Select("i.id, m.id AS monitor_id, m.name AS monitor_name, m.monitor_type AS monitor_type, i.opened_at, i.resolved_at, i.summary").
		Joins("LEFT JOIN monitors m ON m.id = i.monitor_id").
		Order("i.opened_at DESC").
		Limit(limit).
		Scan(&rows).Error; err != nil {
		return nil, err
	}
	return rows, nil
}

type IncidentWithMonitor struct {
	ID          string     `gorm:"column:id" json:"id"`
	MonitorID   string     `gorm:"column:monitor_id" json:"monitor_id"`
	MonitorName string     `gorm:"column:monitor_name" json:"monitor_name"`
	MonitorType string     `gorm:"column:monitor_type" json:"monitor_type"`
	OpenedAt    time.Time  `gorm:"column:opened_at" json:"opened_at"`
	ResolvedAt  *time.Time `gorm:"column:resolved_at" json:"resolved_at"`
	Summary     string     `gorm:"column:summary" json:"summary"`
}

// RecentOpenWithMonitor returns latest unresolved incidents with monitor names.
func (r *IncidentRepo) RecentOpenWithMonitor(limit int) ([]IncidentWithMonitor, error) {
	conn, err := r.connection()
	if err != nil {
		return nil, err
	}
	if limit <= 0 {
		limit = 100
	}
	var rows []IncidentWithMonitor
	if err := conn.Table("incidents i").
		Select("i.id, m.id AS monitor_id, m.name AS monitor_name, m.monitor_type AS monitor_type, i.opened_at, i.resolved_at, i.summary").
		Joins("LEFT JOIN monitors m ON m.id = i.monitor_id").
		Where("i.resolved_at IS NULL").
		Order("i.opened_at DESC").
		Limit(limit).
		Scan(&rows).Error; err != nil {
		return nil, err
	}
	return rows, nil
}

// RecentByMonitor returns latest incidents for one monitor.
func (r *IncidentRepo) RecentByMonitor(monitorID string, limit int) ([]Incident, error) {
	conn, err := r.connection()
	if err != nil {
		return nil, err
	}
	if limit <= 0 {
		limit = 20
	}
	var rows []Incident
	monitorPK, parseErr := parseIncidentMonitorID(monitorID)
	if parseErr != nil {
		return []Incident{}, nil
	}
	if err := conn.Table("incidents i").
		Select("i.id, i.monitor_id, i.opened_at, i.resolved_at, i.summary").
		Where("i.monitor_id = ?", monitorPK).
		Order("i.opened_at DESC").
		Limit(limit).
		Scan(&rows).Error; err != nil {
		return nil, err
	}
	return rows, nil
}

// OpenByMonitorIDs returns the latest unresolved incident for each monitor id.
func (r *IncidentRepo) OpenByMonitorIDs(monitorIDs []string) (map[string]Incident, error) {
	conn, err := r.connection()
	if err != nil {
		return nil, err
	}
	ids := make([]string, 0, len(monitorIDs))
	seen := map[string]struct{}{}
	for _, id := range monitorIDs {
		id = strings.TrimSpace(id)
		if id == "" {
			continue
		}
		if _, exists := seen[id]; exists {
			continue
		}
		seen[id] = struct{}{}
		ids = append(ids, id)
	}
	out := map[string]Incident{}
	if len(ids) == 0 {
		return out, nil
	}
	monitorPKs := make([]int64, 0, len(ids))
	for _, id := range ids {
		pk, parseErr := parseIncidentMonitorID(id)
		if parseErr != nil {
			continue
		}
		monitorPKs = append(monitorPKs, pk)
	}
	if len(monitorPKs) == 0 {
		return out, nil
	}
	rows := make([]Incident, 0, len(ids))
	if err := conn.
		Table("incidents i").
		Select("i.id, i.monitor_id, i.opened_at, i.resolved_at, i.summary").
		Where("i.monitor_id IN ? AND i.resolved_at IS NULL", monitorPKs).
		Order("i.opened_at DESC, i.id DESC").
		Scan(&rows).Error; err != nil {
		return nil, err
	}
	for _, row := range rows {
		monitorID := strconv.FormatInt(row.MonitorId, 10)
		if _, exists := out[monitorID]; exists {
			continue
		}
		out[monitorID] = row
	}
	return out, nil
}

