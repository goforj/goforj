// CountByTypeAndTarget returns number of monitors with same type+target.
func (r *MonitorRepo) CountByTypeAndTarget(monitorType, target string) (int64, error) {
	conn, err := r.connection()
	if err != nil {
		return 0, err
	}
	var count int64
	if err := conn.Model(&Monitor{}).
		Where("monitor_type = ? AND target = ?", monitorType, target).
		Count(&count).Error; err != nil {
		return 0, err
	}
	return count, nil
}

// CountByTypeAndTargetExcludingID returns duplicates excluding the given monitor id.
func (r *MonitorRepo) CountByTypeAndTargetExcludingID(monitorType, target, excludeID string) (int64, error) {
	conn, err := r.connection()
	if err != nil {
		return 0, err
	}
	var count int64
	if err := conn.Model(&Monitor{}).
		Where("monitor_type = ? AND target = ? AND id <> ?", monitorType, target, excludeID).
		Count(&count).Error; err != nil {
		return 0, err
	}
	return count, nil
}

