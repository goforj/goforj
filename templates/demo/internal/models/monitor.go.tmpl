func (r *MonitorRepo) Builder() (*gorm.DB, error) {
	return r.connection()
}

// connection resolves the default database connection for repository actions.
func (r *MonitorRepo) connection() (*gorm.DB, error) {
	return r.db.Default()
}

// ByID fetches a Monitor by primary key.
func (r *MonitorRepo) ByID(id any) (*Monitor, error) {
	conn, err := r.connection()
	if err != nil {
		return nil, err
	}
	var model Monitor
	if idAsString, ok := id.(string); ok {
		if err := conn.Where("id = ?", idAsString).First(&model).Error; err != nil {
			return nil, err
		}
	} else if err := conn.First(&model, id).Error; err != nil {
		return nil, err
	}
	return &model, nil
}

// GetWhere fetches matching Monitor rows by a where map.
func (r *MonitorRepo) GetWhere(where map[string]any) ([]Monitor, error) {
	conn, err := r.connection()
	if err != nil {
		return nil, err
	}
	var models []Monitor
	if err := conn.Where(where).Find(&models).Error; err != nil {
		return nil, err
	}
	return models, nil
}

