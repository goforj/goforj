}

// ListItemsOrderedByName returns monitor rows shaped for API responses.
func (r *MonitorRepo) ListItemsOrderedByName() ([]MonitorListItem, error) {
	conn, err := r.connection()
	if err != nil {
		return nil, err
	}
	rows := make([]MonitorListItem, 0)
	if err := conn.Model(&Monitor{}).
		Select("id, name, monitor_type AS type, target, interval_seconds, timeout_ms, enabled").
		Order("name ASC").
		Scan(&rows).Error; err != nil {
		return nil, err
	}
	return rows, nil
}

type MonitorListItem struct {
	ID              string     `json:"id"`
	Name            string     `json:"name"`
	Type            string     `json:"type"`
	Target          string     `json:"target"`
	IntervalSeconds int        `json:"interval_seconds"`
	TimeoutMS       int        `json:"timeout_ms"`
	Enabled         bool       `json:"enabled"`
	LastStatus      string     `json:"last_status"`
	LastCheckedAt   *time.Time `json:"last_checked_at"`
	Uptime24h       float64    `json:"uptime_24h"`
}

// DetailByID fetches one monitor shaped for API response.
func (r *MonitorRepo) DetailByID(id string) (*MonitorDetailItem, error) {
	conn, err := r.connection()
	if err != nil {
		return nil, err
	}
	var row MonitorDetailItem
	if err := conn.Model(&Monitor{}).
		Select("id, name, monitor_type AS type, target, interval_seconds, timeout_ms, enabled, updated_at").
		Where("id = ?", id).
		Limit(1).
		Scan(&row).Error; err != nil {
		return nil, err
	}
	if row.ID == "" {
		return nil, gorm.ErrRecordNotFound
	}
	return &row, nil
}

type MonitorDetailItem struct {
	ID              string    `json:"id"`
	Name            string    `json:"name"`
	Type            string    `json:"type"`
	Target          string    `json:"target"`
	IntervalSeconds int       `json:"interval_seconds"`
	TimeoutMS       int       `json:"timeout_ms"`
	Enabled         bool      `json:"enabled"`
	UpdatedAt       time.Time `json:"updated_at"`
}

