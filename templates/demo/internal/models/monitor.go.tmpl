}

// AllOrderedByName fetches all Monitor rows ordered by name.
func (r *MonitorRepo) AllOrderedByName() ([]Monitor, error) {
	conn, err := r.connection()
	if err != nil {
		return nil, err
	}
	var models []Monitor
	if err := conn.Order("name ASC").Find(&models).Error; err != nil {
		return nil, err
	}
	return models, nil
}

// IdentitiesOrderedByName fetches lightweight monitor rows used by heartbeat logic.
func (r *MonitorRepo) IdentitiesOrderedByName() ([]MonitorIdentity, error) {
	conn, err := r.connection()
	if err != nil {
		return nil, err
	}
	rows := make([]MonitorIdentity, 0)
	if err := conn.Model(&Monitor{}).
		Select("id, enabled, interval_seconds").
		Order("name ASC").
		Scan(&rows).Error; err != nil {
		return nil, err
	}
	return rows, nil
}

type MonitorIdentity struct {
	ID              string `json:"id"`
