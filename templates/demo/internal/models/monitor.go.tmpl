type Monitor struct {
	Id              null.String `gorm:"column:id" json:"id"`
	Name            string      `gorm:"column:name" json:"name"`
	MonitorType     string      `gorm:"column:monitor_type" json:"monitor_type"`
	Target          string      `gorm:"column:target" json:"target"`
	IntervalSeconds int         `gorm:"column:interval_seconds" json:"interval_seconds"`
	TimeoutMs       int         `gorm:"column:timeout_ms" json:"timeout_ms"`
	Enabled         bool        `gorm:"column:enabled" json:"enabled"`
	CreatedAt       time.Time   `gorm:"column:created_at" json:"created_at"`
	UpdatedAt       time.Time   `gorm:"column:updated_at" json:"updated_at"`
}

// TableName returns the database table name.
func (*Monitor) TableName() string {
	return "monitors"
}

// Relationships returns the relationship paths for eager loading.
