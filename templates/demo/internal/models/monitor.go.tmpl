// TargetSetByType returns a normalized set of targets for a monitor type.
func (r *MonitorRepo) TargetSetByType(monitorType string) (map[string]struct{}, error) {
	conn, err := r.connection()
	if err != nil {
		return nil, err
	}
	rows := make([]string, 0)
	if err := conn.Model(&Monitor{}).
		Where("monitor_type = ?", monitorType).
		Pluck("target", &rows).Error; err != nil {
		return nil, err
	}
	out := make(map[string]struct{}, len(rows))
	for _, row := range rows {
		key := str.Of(row).TrimSpace().ToLower().String()
		if key == "" {
			continue
		}
		out[key] = struct{}{}
	}
	return out, nil
}

// BackfillNormalizedTargets parses legacy target strings and stores target_* columns.
// It is safe to run repeatedly; already-normalized rows are skipped.
func (r *MonitorRepo) BackfillNormalizedTargets(limit int) (int, error) {
	conn, err := r.connection()
	if err != nil {
		return 0, err
	}
	// Backfill is a best-effort startup task; skip cleanly before monitor migrations exist.
	if !conn.Migrator().HasTable(&Monitor{}) {
		return 0, nil
	}
	if !conn.Migrator().HasColumn(&Monitor{}, "target_url") {
		return 0, nil
	}
	if limit <= 0 {
		limit = 2000
	}
	rows := make([]Monitor, 0)
	if err := conn.
		Where("TRIM(COALESCE(target_url, '')) = ''").
		Limit(limit).
		Find(&rows).Error; err != nil {
		return 0, err
	}
	updated := 0
	now := time.Now().UTC()
	for i := range rows {
		row := &rows[i]
		if !applyNormalizedTargetFields(row) {
			continue
		}
		row.UpdatedAt = now
		if err := conn.Model(&Monitor{}).
			Where("id = ?", row.Id.ValueOrZero()).
			Updates(map[string]any{
				"target_url":         row.TargetURL,
				"target_record_type": row.TargetRecordType,
				"target_keyword":     row.TargetKeyword,
				"target_expected":    row.TargetExpected,
				"target_container":   row.TargetContainer,
				"target_docker_host": row.TargetDockerHost,
				"target_push_token":  row.TargetPushToken,
				"updated_at":         row.UpdatedAt,
			}).Error; err != nil {
			return updated, err
		}
		updated++
	}
	return updated, nil
}

func applyNormalizedTargetFields(m *Monitor) bool {
	monitorType := str.Of(m.MonitorType).TrimSpace().ToLower().String()
	target := str.Of(m.Target).TrimSpace().String()
	if target == "" {
		return false
	}
	changed := false

	setNullString := func(field *null.String, raw string) {
		value := str.Of(raw).TrimSpace().String()
		next := null.NewString(value, value != "")
		if field.String != next.String || field.Valid != next.Valid {
			*field = next
			changed = true
		}
	}

	setURL := func(raw string) bool {
		u, err := url.Parse(str.Of(raw).TrimSpace().String())
		hostName := str.Of(u.Hostname()).TrimSpace().String()
		if err != nil || hostName == "" {
			return false
		}
		setNullString(&m.TargetURL, raw)
		return true
	}

	switch monitorType {
	case "http", "websocket", "tls":
		return setURL(target)
	case "tcp", "steam":
		_, _, ok := strings.Cut(target, ":")
		return ok && changed
	case "ping":
		return false
	case "dns":
		host, recordType, ok := strings.Cut(target, "|")
		if !ok {
			return false
		}
		host = str.Of(host).TrimSpace().ToLower().String()
		recordType = str.Of(recordType).TrimSpace().ToUpper().String()
		if host == "" {
			return false
		}
		setNullString(&m.TargetRecordType, recordType)
		return changed
	case "http_keyword":
		urlPart, keyword, ok := strings.Cut(target, "|")
		if !ok || !setURL(urlPart) {
			return false
		}
		keyword = str.Of(keyword).TrimSpace().String()
		setNullString(&m.TargetKeyword, keyword)
		return changed
	case "http_json_query":
		urlPart, rest, ok := strings.Cut(target, "|")
		if !ok || !setURL(urlPart) {
			return false
		}
		pathExpr, expected, _ := strings.Cut(rest, "|")
		pathExpr = str.Of(pathExpr).TrimSpace().String()
		expected = str.Of(expected).TrimSpace().String()
		setNullString(&m.TargetKeyword, pathExpr)
		setNullString(&m.TargetExpected, expected)
		return changed
	case "docker":
		container, dockerHost, ok := strings.Cut(target, "|")
		if !ok {
			return false
		}
		container = str.Of(container).TrimSpace().String()
		dockerHost = str.Of(dockerHost).TrimSpace().String()
		setNullString(&m.TargetContainer, container)
		setNullString(&m.TargetDockerHost, dockerHost)
		return changed
	case "push":
		token := str.Of(target).TrimSpace().String()
		setNullString(&m.TargetPushToken, token)
		return changed
	default:
		return false
	}
}

// NormalizeNotificationChannelIDs canonicalizes monitor channel selections.
func NormalizeNotificationChannelIDs(input []int64) []int64 {
	if len(input) == 0 {
		return nil
	}
	seen := make(map[int64]struct{}, len(input))
	out := make([]int64, 0, len(input))
	for _, id := range input {
		if id <= 0 {
			continue
		}
		if _, ok := seen[id]; ok {
			continue
		}
		seen[id] = struct{}{}
		out = append(out, id)
	}
	sort.Slice(out, func(i, j int) bool { return out[i] < out[j] })
	if len(out) == 0 {
		return nil
	}
	return out
}

// SerializeNotificationChannelIDs persists selected channel IDs as comma-separated text.
func SerializeNotificationChannelIDs(input []int64) string {
	ids := NormalizeNotificationChannelIDs(input)
	if len(ids) == 0 {
		return ""
	}
	parts := make([]string, 0, len(ids))
	for _, id := range ids {
		parts = append(parts, strconv.FormatInt(id, 10))
	}
	return strings.Join(parts, ",")
}

// ParseNotificationChannelIDs converts stored monitor channel selections back to IDs.
func ParseNotificationChannelIDs(raw string) []int64 {
	value := str.Of(raw).TrimSpace().String()
	if value == "" {
		return nil
	}
	parts := strings.Split(value, ",")
	ids := make([]int64, 0, len(parts))
	for _, part := range parts {
		next, err := strconv.ParseInt(str.Of(part).TrimSpace().String(), 10, 64)
		if err != nil || next <= 0 {
			continue
		}
		ids = append(ids, next)
	}
	return NormalizeNotificationChannelIDs(ids)
}
