// DetailByID fetches one monitor shaped for API response.
func (r *MonitorRepo) DetailByID(id string) (*MonitorDetailItem, error) {
	conn, err := r.connection()
	if err != nil {
		return nil, err
	}
	var row MonitorDetailItem
	if err := conn.Model(&Monitor{}).
		Select("id, name, monitor_type AS type, target, target_url, target_record_type, target_keyword, target_expected, target_container, target_docker_host, target_push_token, notification_channel_ids, interval_seconds, timeout_ms, retry_attempts, retry_backoff_ms, schedule_jitter_ms, dns_tls_failure_streak, failure_streak, circuit_open_until, COALESCE(circuit_reason, '') AS circuit_reason, enabled, updated_at").
		Where("id = ?", id).
		Limit(1).
		Scan(&row).Error; err != nil {
		return nil, err
	}
	if row.ID == "" {
		return nil, gorm.ErrRecordNotFound
	}
	row.NotificationChannelIDs = ParseNotificationChannelIDs(row.NotificationChannelIDsRaw)
	return &row, nil
}

