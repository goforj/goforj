// CreateBatch inserts many MonitorCheck rows in one call.
func (r *MonitorCheckRepo) CreateBatch(models []MonitorCheck) error {
	if len(models) == 0 {
		return nil
	}
	conn, err := r.connection()
	if err != nil {
		return err
	}
	for i := range models {
		if models[i].MonitorId > 0 {
			continue
		}
		return fmt.Errorf("monitor check create batch: monitor_id must be > 0")
	}
	// Keep batches conservative so SQLite does not exceed variable limits.
	return conn.CreateInBatches(&models, 200).Error
}

