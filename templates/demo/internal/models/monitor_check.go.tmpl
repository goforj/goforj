func parseMonitorID(monitorID string) (int64, error) {
	parsed, err := strconv.ParseInt(strings.TrimSpace(monitorID), 10, 64)
	if err != nil || parsed <= 0 {
		return 0, fmt.Errorf("invalid monitor id %q", strings.TrimSpace(monitorID))
	}
	return parsed, nil
}

// ByID fetches a MonitorCheck by primary key.
func (r *MonitorCheckRepo) ByID(id any) (*MonitorCheck, error) {
	conn, err := r.connection()
	if err != nil {
		return nil, err
	}
	var model MonitorCheck
	if idAsString, ok := id.(string); ok {
		parsed, parseErr := strconv.ParseInt(strings.TrimSpace(idAsString), 10, 64)
		if parseErr != nil || parsed <= 0 {
			return nil, gorm.ErrRecordNotFound
		}
		if err := conn.Where("id = ?", parsed).First(&model).Error; err != nil {
			return nil, err
		}
	} else if err := conn.First(&model, id).Error; err != nil {
		return nil, err
	}
	return &model, nil
}

