}

type UptimeStat struct {
	Total   int64
	UpCount int64
}

// LatestByMonitor fetches newest checks for one monitor.
func (r *MonitorCheckRepo) LatestByMonitor(monitorID string, limit int) ([]MonitorCheck, error) {
	conn, err := r.connection()
	if err != nil {
		return nil, err
	}
	if limit <= 0 {
		limit = 1
	}
	var models []MonitorCheck
	if err := conn.Where("monitor_id = ?", monitorID).Order("checked_at DESC").Limit(limit).Find(&models).Error; err != nil {
		return nil, err
	}
	return models, nil
}

// LatestStatusByMonitor returns latest check row keyed by monitor id.
func (r *MonitorCheckRepo) LatestStatusByMonitor(limit int) (map[string]MonitorCheck, error) {
	rows, err := r.Latest(limit)
	if err != nil {
		return nil, err
	}
	out := map[string]MonitorCheck{}
	for _, row := range rows {
		if _, exists := out[row.MonitorId]; exists {
			continue
		}
		out[row.MonitorId] = row
	}
	return out, nil
}

// UptimeByMonitorSince aggregates up/total counts for checks newer than since.
func (r *MonitorCheckRepo) UptimeByMonitorSince(since time.Time, limit int) (map[string]UptimeStat, error) {
	rows, err := r.Since(since, limit)
	if err != nil {
		return nil, err
	}
	out := map[string]UptimeStat{}
	for _, row := range rows {
		status := strings.ToLower(strings.TrimSpace(row.Status))
		if status != "up" && status != "down" {
			continue
		}
		stat := out[row.MonitorId]
		stat.Total++
		if status == "up" {
			stat.UpCount++
		}
		out[row.MonitorId] = stat
	}
	return out, nil
}

// CountSince returns number of checks newer than or equal to timestamp.
