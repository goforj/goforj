// LatestByMonitorIDs fetches newest checks for many monitors and groups rows by monitor id.
func (r *MonitorCheckRepo) LatestByMonitorIDs(monitorIDs []string, perMonitorLimit int) (map[string][]MonitorCheck, error) {
	conn, err := r.connection()
	if err != nil {
		return nil, err
	}
	ids := make([]string, 0, len(monitorIDs))
	seen := map[string]struct{}{}
	for _, id := range monitorIDs {
		id = strings.TrimSpace(id)
		if id == "" {
			continue
		}
		if _, exists := seen[id]; exists {
			continue
		}
		seen[id] = struct{}{}
		ids = append(ids, id)
	}
	out := map[string][]MonitorCheck{}
	if len(ids) == 0 {
		return out, nil
	}
	if perMonitorLimit <= 0 {
		perMonitorLimit = 1
	}
	monitorPKs := make([]int64, 0, len(ids))
	for _, id := range ids {
		pk, parseErr := parseMonitorID(id)
		if parseErr != nil {
			continue
		}
		monitorPKs = append(monitorPKs, pk)
	}
	if len(monitorPKs) == 0 {
		return out, nil
	}
	rows := make([]MonitorCheck, 0, len(ids)*perMonitorLimit)
	ranked := conn.Table("monitor_checks c").
		Select("c.id, c.monitor_id, c.checked_at, c.status, c.status_code, c.duration_ms, c.error_message, ROW_NUMBER() OVER (PARTITION BY c.monitor_id ORDER BY c.checked_at DESC, c.id DESC) AS row_num").
		Where("c.monitor_id IN ?", monitorPKs)
	if err := conn.Table("(?) AS ranked_checks", ranked).
		Select("ranked_checks.id, ranked_checks.monitor_id, ranked_checks.checked_at, ranked_checks.status, ranked_checks.status_code, ranked_checks.duration_ms, ranked_checks.error_message").
		Where("ranked_checks.row_num <= ?", perMonitorLimit).
		Order("ranked_checks.monitor_id ASC, ranked_checks.checked_at DESC, ranked_checks.id DESC").
		Scan(&rows).Error; err != nil {
		return nil, err
	}
	for _, row := range rows {
		monitorID := strconv.FormatInt(row.MonitorId, 10)
		current := out[monitorID]
		if len(current) >= perMonitorLimit {
			continue
		}
		out[monitorID] = append(current, row)
	}
	for _, id := range ids {
		if _, exists := out[id]; !exists {
			out[id] = []MonitorCheck{}
		}
	}
	return out, nil
}

// LatestStatusByMonitor returns latest check row keyed by monitor id.
func (r *MonitorCheckRepo) LatestStatusByMonitor(limit int) (map[string]MonitorCheck, error) {
	rows, err := r.Latest(limit)
	if err != nil {
		return nil, err
	}
	out := map[string]MonitorCheck{}
	for _, row := range rows {
		monitorID := strconv.FormatInt(row.MonitorId, 10)
		if _, exists := out[monitorID]; exists {
			continue
		}
		out[monitorID] = row
	}
	return out, nil
}

// LatestDisplayStatusByMonitor returns the newest display-worthy check row keyed
// by monitor id. A transient pending row only masks the prior status when the
// previous terminal state was up or absent; once a monitor is confirmed down, it
// should remain down until a real recovery result arrives.
func (r *MonitorCheckRepo) LatestDisplayStatusByMonitor(limit int) (map[string]MonitorCheck, error) {
	rows, err := r.Latest(limit)
	if err != nil {
		return nil, err
	}
	latest := map[string]MonitorCheck{}
	latestTerminal := map[string]MonitorCheck{}
	for _, row := range rows {
		monitorID := strconv.FormatInt(row.MonitorId, 10)
		if _, exists := latest[monitorID]; !exists {
			latest[monitorID] = row
		}
		status := strings.ToLower(strings.TrimSpace(row.Status))
		if status == "pending" || status == "unknown" || status == "" {
			continue
		}
		if _, exists := latestTerminal[monitorID]; exists {
			continue
		}
		latestTerminal[monitorID] = row
	}
	out := make(map[string]MonitorCheck, len(latest))
	for monitorID, row := range latest {
		status := strings.ToLower(strings.TrimSpace(row.Status))
		if status != "pending" {
			out[monitorID] = row
			continue
		}
		terminal, hasTerminal := latestTerminal[monitorID]
		if !hasTerminal {
			out[monitorID] = row
			continue
		}
		terminalStatus := strings.ToLower(strings.TrimSpace(terminal.Status))
		if terminalStatus == "down" {
			out[monitorID] = terminal
			continue
		}
		out[monitorID] = row
	}
	return out, nil
}

// UptimeByMonitorSince aggregates up/total counts for checks newer than since.
func (r *MonitorCheckRepo) UptimeByMonitorSince(since time.Time, limit int) (map[string]UptimeStat, error) {
	rows, err := r.Since(since, limit)
	if err != nil {
		return nil, err
	}
	out := map[string]UptimeStat{}
	for _, row := range rows {
		status := strings.ToLower(strings.TrimSpace(row.Status))
		if status != "up" && status != "down" {
			continue
		}
		monitorID := strconv.FormatInt(row.MonitorId, 10)
		stat := out[monitorID]
		stat.Total++
		if status == "up" {
			stat.UpCount++
		}
		out[monitorID] = stat
	}
	return out, nil
}

