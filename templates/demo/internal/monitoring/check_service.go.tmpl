const (
	monitorPrimaryUserAgent = "uptime-gopher/1.0"
	monitorStreakScanLimit  = 12
	monitorMaxRetryAttempts = 5
	monitorCircuitThreshold = 3
	monitorCircuitTTL       = 5 * time.Minute
	monitorRetryCap         = 5 * time.Second
)

type checkResult struct {
	status     string
	statusCode int
	durationMs int64
	errText    string
	errClass   string
	retryable  bool
	dnsOrTLS   bool
}

type checkExecution struct {
	monitor         *models.Monitor
	monitorID       string
	result          checkResult
	startedAt       time.Time
	timeout         time.Duration
	attemptsPlanned int
	attemptsUsed    int
}

type monitorPolicyState struct {
	downStreak int
	upStreak   int
}

type policyBatchContext struct {
	monitorState  map[string]monitorPolicyState
	openIncidents map[string]models.Incident
}

type CheckService struct {
	logger              *logger.AppLogger
	httpxPrimary        *httpx.Client
	httpxChrome         *httpx.Client
	httpxHTTP1          *httpx.Client
	monitorRepo         *models.MonitorRepo
	monitorCheckRepo    *models.MonitorCheckRepo
	incidentTransitions *IncidentTransitionService
	alertDispatch       *alerts.DispatchJob
	eventBus            events.Bus
}

func NewCheckService(
	logger *logger.AppLogger,
	monitorRepo *models.MonitorRepo,
	monitorCheckRepo *models.MonitorCheckRepo,
	incidentTransitions *IncidentTransitionService,
	alertDispatch *alerts.DispatchJob,
	eventBus events.Bus,
) *CheckService {
	http1Client := httpx.New(httpx.UserAgent(monitorPrimaryUserAgent))
	http1Client.Req().EnableForceHTTP1()

	return &CheckService{
		logger:              logger,
		httpxPrimary:        httpx.New(httpx.UserAgent(monitorPrimaryUserAgent)),
		httpxChrome:         httpx.New(httpx.AsChrome()),
		httpxHTTP1:          http1Client,
		monitorRepo:         monitorRepo,
		monitorCheckRepo:    monitorCheckRepo,
		incidentTransitions: incidentTransitions,
		alertDispatch:       alertDispatch,
		eventBus:            eventBus,
	}
}

// TriggerPushMonitor writes one synthetic "up" check for the push monitor.
func (s *CheckService) TriggerPushMonitor() error {
	monitors, err := s.monitorRepo.EnabledOrderedByName()
	if err != nil {
		return err
	}
	var m *models.Monitor
	for i := range monitors {
		if str.Of(monitors[i].MonitorType).TrimSpace().ToLower().String() == "push" {
			m = &monitors[i]
			break
		}
	}
	monitorID := monitorIDString(m)
	if m == nil || monitorID == "" || !m.Enabled {
		return nil
	}
	if str.Of(m.MonitorType).TrimSpace().ToLower().String() != "push" {
		return nil
	}
	return s.writeCheckWithPolicy(context.Background(), monitorID, m, checkResult{
		status:     "up",
		statusCode: http.StatusOK,
		durationMs: 1,
	})
}

func (s *CheckService) CheckMonitor(ctx context.Context, m *models.Monitor) error {
	exec, ok := s.executeMonitorCheck(ctx, m)
	if !ok {
		return nil
	}
	return s.persistMonitorChecks(ctx, []checkExecution{exec})
}

// CheckMonitorsBatch runs monitor checks concurrently, then persists outcomes in batch.
func (s *CheckService) CheckMonitorsBatch(ctx context.Context, monitors []models.Monitor) error {
	if len(monitors) == 0 {
		return nil
	}
	workerCount := len(monitors)
	if workerCount > 8 {
		workerCount = 8
	}
	if workerCount < 1 {
		workerCount = 1
	}
	jobs := make(chan models.Monitor)
	results := make(chan checkExecution, len(monitors))
	var wg sync.WaitGroup
	for i := 0; i < workerCount; i++ {
		wg.Add(1)
		go func() {
			defer wg.Done()
			for monitor := range jobs {
				m := monitor
				exec, ok := s.executeMonitorCheck(ctx, &m)
				if !ok {
					continue
				}
				results <- exec
			}
		}()
	}
	for i := range monitors {
		jobs <- monitors[i]
	}
	close(jobs)
	wg.Wait()
	close(results)

	executions := make([]checkExecution, 0, len(monitors))
	for exec := range results {
		executions = append(executions, exec)
	}
	if len(executions) == 0 {
		return nil
	}
	return s.persistMonitorChecks(ctx, executions)
}

func (s *CheckService) executeMonitorCheck(ctx context.Context, m *models.Monitor) (checkExecution, bool) {
	monitorID := monitorIDString(m)
	if m == nil || monitorID == "" || !m.Enabled {
		return checkExecution{}, false
	}
	timeout := 5 * time.Second
	if m.TimeoutMs > 0 {
		timeout = time.Duration(m.TimeoutMs) * time.Millisecond
	}
	attemptsPlanned := m.RetryAttempts + 1
	if attemptsPlanned < 1 {
		attemptsPlanned = 1
	}
	if attemptsPlanned > monitorMaxRetryAttempts {
		attemptsPlanned = monitorMaxRetryAttempts
	}
	startedAt := time.Now()
	if s.logger != nil {
		s.logger.Debug().
			Str("monitor_id", monitorID).
			Str("monitor_type", strings.TrimSpace(strings.ToLower(m.MonitorType))).
			Int("timeout_ms", int(timeout/time.Millisecond)).
			Int("attempts_planned", attemptsPlanned).
			Msg("monitor check started")
	}
	if m.CircuitOpenUntil != nil && m.CircuitOpenUntil.After(time.Now().UTC()) {
		return checkExecution{
			monitor:         m,
			monitorID:       monitorID,
			startedAt:       startedAt,
			timeout:         timeout,
			attemptsPlanned: attemptsPlanned,
			attemptsUsed:    0,
			result: checkResult{
				status:     "down",
				statusCode: 0,
				durationMs: 0,
				errClass:   "circuit_open",
				errText:    classifyCheckError(m.MonitorType, "circuit open: "+m.CircuitReason.ValueOrZero()),
				retryable:  false,
				dnsOrTLS:   false,
			},
		}, true
	}
	result, attemptsUsed := s.runWithRetry(ctx, m, timeout)
	return checkExecution{
		monitor:         m,
		monitorID:       monitorID,
		startedAt:       startedAt,
		timeout:         timeout,
		attemptsPlanned: attemptsPlanned,
		attemptsUsed:    attemptsUsed,
		result:          result,
	}, true
}

func (s *CheckService) runWithRetry(ctx context.Context, m *models.Monitor, timeout time.Duration) (checkResult, int) {
	attempts := m.RetryAttempts + 1
	if attempts < 1 {
		attempts = 1
	}
	if attempts > monitorMaxRetryAttempts {
		attempts = monitorMaxRetryAttempts
	}
	backoff := time.Duration(m.RetryBackoffMs) * time.Millisecond
	if backoff <= 0 {
		backoff = 250 * time.Millisecond
	}
	jitter := time.Duration(m.ScheduleJitterMs) * time.Millisecond
	if jitter < 0 {
		jitter = 0
	}
	var result checkResult
	for attempt := 1; attempt <= attempts; attempt++ {
		result = s.runSingleCheck(ctx, m, timeout)
		if result.status == "up" || !result.retryable || attempt == attempts {
			return result, attempt
		}
		s.writePendingRetryCheck(monitorIDString(m), result)
		sleep := backoff * time.Duration(attempt)
		if sleep > monitorRetryCap {
			sleep = monitorRetryCap
		}
		if jitter > 0 {
			sleep += deterministicRetryJitter(monitorIDString(m), attempt, jitter)
		}
		timer := time.NewTimer(sleep)
		select {
		case <-ctx.Done():
			timer.Stop()
			return result, attempt
		case <-timer.C:
		}
	}
	return result, attempts
}

func (s *CheckService) logCheckCompletion(
	monitorID string,
	m *models.Monitor,
	startedAt time.Time,
	timeout time.Duration,
	attemptsPlanned int,
	attemptsUsed int,
	result checkResult,
	runErr error,
) {
	if s.logger == nil {
		return
	}
	event := s.logger.Debug()
	if runErr != nil {
		event = s.logger.Error().Err(runErr)
	}
	event.
		Str("monitor_id", monitorID).
		Str("monitor_type", func() string {
			if m == nil {
				return ""
			}
			return strings.TrimSpace(strings.ToLower(m.MonitorType))
		}()).
		Int64("elapsed_ms", time.Since(startedAt).Milliseconds()).
		Int("timeout_ms", int(timeout/time.Millisecond)).
		Int("attempts_planned", attemptsPlanned).
		Int("attempts_used", attemptsUsed).
		Str("status", result.status).
		Int("status_code", result.statusCode).
		Str("error_class", result.errClass).
		Str("error_text", result.errText).
		Bool("retryable", result.retryable).
		Msg("monitor check completed")
}

func (s *CheckService) runSingleCheck(ctx context.Context, m *models.Monitor, timeout time.Duration) checkResult {
	switch m.MonitorType {
	case "tcp":
		target := monitorTCPAddress(m)
		s.primeTCPConnection(ctx, target, timeout)
		start := time.Now()
		conn, err := net.DialTimeout("tcp", target, timeout)
		duration := time.Since(start).Milliseconds()
		if err != nil {
			class := classifyCheckClass(err.Error())
			return checkResult{
				status:     "down",
				statusCode: 0,
				durationMs: duration,
				errClass:   class,
				errText:    classifyCheckError("tcp", err.Error()),
				retryable:  isRetryableClass(class),
				dnsOrTLS:   class == "dns" || class == "tls",
			}
		}
		_ = conn.Close()
		return checkResult{status: "up", statusCode: 0, durationMs: duration}
	case "ping":
		target := monitorPingHost(m)
		duration, err := runPingRTT(ctx, target, timeout)
		if err != nil {
			class := classifyCheckClass(err.Error())
			return checkResult{
				status:     "down",
				statusCode: 0,
				durationMs: duration,
				errClass:   class,
				errText:    classifyCheckError("ping", err.Error()),
				retryable:  isRetryableClass(class),
				dnsOrTLS:   class == "dns",
			}
		}
		return checkResult{status: "up", statusCode: 0, durationMs: duration}
	case "dns":
		statusCode, duration, errClass, errText, retryable := s.runDNSCheck(ctx, monitorDNSTarget(m), timeout)
		return checkResult{
			status:     statusFromError(errText),
			statusCode: statusCode,
			durationMs: duration,
			errClass:   errClass,
			errText:    errText,
			retryable:  retryable,
			dnsOrTLS:   errClass == "dns",
		}
	case "tls":
		s.primeTLSConnection(ctx, monitorTLSTarget(m), timeout)
		statusCode, duration, errClass, errText, retryable := s.runTLSCheck(ctx, monitorTLSTarget(m), timeout)
		return checkResult{
			status:     statusFromError(errText),
			statusCode: statusCode,
			durationMs: duration,
			errClass:   errClass,
			errText:    errText,
			retryable:  retryable,
			dnsOrTLS:   errClass == "dns" || errClass == "tls",
		}
	case "http_keyword":
		// Prime the connection before measuring to reduce cold-start/TLS spike noise.
		targetURL, keyword, parseErr := monitorHTTPKeywordTarget(m)
		if parseErr != nil {
			return checkResult{
				status:    "down",
				errClass:  "validation",
				errText:   classifyCheckError("http_keyword", parseErr.Error()),
				retryable: false,
			}
		}
		s.primeHTTPConnection(ctx, targetURL, timeout)
		statusCode, duration, reqErr := s.runHTTPCheck(ctx, targetURL, timeout)
		if reqErr != nil {
			class := classifyCheckClass(reqErr.Error())
			return checkResult{
				status:     "down",
				statusCode: statusCode,
				durationMs: duration,
				errClass:   class,
				errText:    classifyCheckError("http_keyword", reqErr.Error()),
				retryable:  isRetryableClass(class),
				dnsOrTLS:   class == "dns" || class == "tls",
			}
		}
		body, err := s.fetchHTTPBody(ctx, targetURL, timeout)
		if err != nil {
			class := classifyCheckClass(err.Error())
			return checkResult{
				status:     "down",
				statusCode: statusCode,
				durationMs: duration,
				errClass:   class,
				errText:    classifyCheckError("http_keyword", err.Error()),
				retryable:  isRetryableClass(class),
				dnsOrTLS:   class == "dns" || class == "tls",
			}
		}
		if !strings.Contains(strings.ToLower(body), strings.ToLower(keyword)) {
			return checkResult{
				status:     "down",
				statusCode: statusCode,
				durationMs: duration,
				errClass:   "keyword",
				errText:    classifyCheckError("http_keyword", "keyword not found"),
				retryable:  false,
			}
		}
		return checkResult{status: "up", statusCode: statusCode, durationMs: duration}
	case "http_json_query":
		targetURL, path, expected, parseErr := monitorHTTPJSONQueryTarget(m)
		if parseErr != nil {
			return checkResult{
				status:    "down",
				errClass:  "validation",
				errText:   classifyCheckError("http_json_query", parseErr.Error()),
				retryable: false,
			}
		}
		s.primeHTTPConnection(ctx, targetURL, timeout)
		statusCode, duration, reqErr := s.runHTTPCheck(ctx, targetURL, timeout)
		if reqErr != nil {
			class := classifyCheckClass(reqErr.Error())
			return checkResult{
				status:     "down",
				statusCode: statusCode,
				durationMs: duration,
				errClass:   class,
				errText:    classifyCheckError("http_json_query", reqErr.Error()),
				retryable:  isRetryableClass(class),
				dnsOrTLS:   class == "dns" || class == "tls",
			}
		}
		body, err := s.fetchHTTPBody(ctx, targetURL, timeout)
		if err != nil {
			class := classifyCheckClass(err.Error())
			return checkResult{
				status:     "down",
				statusCode: statusCode,
				durationMs: duration,
				errClass:   class,
				errText:    classifyCheckError("http_json_query", err.Error()),
				retryable:  isRetryableClass(class),
				dnsOrTLS:   class == "dns" || class == "tls",
			}
		}
		var decoded any
		if err := json.Unmarshal([]byte(body), &decoded); err != nil {
			return checkResult{
				status:     "down",
				statusCode: statusCode,
				durationMs: duration,
				errClass:   "json",
				errText:    classifyCheckError("http_json_query", "invalid json body"),
				retryable:  false,
			}
		}
		value, ok := resolveJSONPath(decoded, path)
		if !ok {
			return checkResult{
				status:     "down",
				statusCode: statusCode,
				durationMs: duration,
				errClass:   "json_path",
				errText:    classifyCheckError("http_json_query", "json path not found"),
				retryable:  false,
			}
		}
		if strings.TrimSpace(fmt.Sprintf("%v", value)) != expected {
			return checkResult{
				status:     "down",
				statusCode: statusCode,
				durationMs: duration,
				errClass:   "json_value",
				errText:    classifyCheckError("http_json_query", "json value mismatch"),
				retryable:  false,
			}
		}
		return checkResult{status: "up", statusCode: statusCode, durationMs: duration}
	case "websocket":
		s.primeWebsocketConnection(ctx, monitorURLTarget(m), timeout)
		statusCode, duration, errClass, errText, retryable := s.runWebsocketCheck(ctx, monitorURLTarget(m), timeout)
		return checkResult{
			status:     statusFromError(errText),
			statusCode: statusCode,
			durationMs: duration,
			errClass:   errClass,
			errText:    errText,
			retryable:  retryable,
			dnsOrTLS:   errClass == "dns" || errClass == "tls",
		}
	case "steam":
		s.primeSteamConnection(ctx, monitorSteamTarget(m), timeout)
		return s.runSteamCheck(ctx, monitorSteamTarget(m), timeout)
	case "docker":
		s.primeDockerConnection(ctx, monitorDockerTarget(m), timeout)
		return s.runDockerCheck(ctx, monitorDockerTarget(m), timeout)
	case "push":
		// Passive monitor type: external systems push check results via API.
		return checkResult{
			status:     "unknown",
			statusCode: 0,
			durationMs: 0,
			errClass:   "push_passive",
			errText:    "",
			retryable:  false,
		}
	default:
		// Prime the connection before measuring to reduce cold-start/TLS spike noise.
		targetURL := monitorURLTarget(m)
		s.primeHTTPConnection(ctx, targetURL, timeout)
		statusCode, duration, reqErr := s.runHTTPCheck(ctx, targetURL, timeout)
		if reqErr != nil {
			class := classifyCheckClass(reqErr.Error())
			return checkResult{
				status:     "down",
				statusCode: statusCode,
				durationMs: duration,
				errClass:   class,
				errText:    classifyCheckError("http", reqErr.Error()),
				retryable:  isRetryableClass(class),
				dnsOrTLS:   class == "dns" || class == "tls",
			}
		}
		if statusCode >= 200 && statusCode < 500 {
			return checkResult{status: "up", statusCode: statusCode, durationMs: duration}
		}
		return checkResult{
			status:     "down",
			statusCode: statusCode,
			durationMs: duration,
			errClass:   "status",
			errText:    classifyCheckError("http", fmt.Sprintf("status=%d", statusCode)),
			retryable:  false,
		}
	}
}

func runPingRTT(ctx context.Context, target string, timeout time.Duration) (int64, error) {
	target = strings.TrimSpace(target)
	if target == "" {
		return 0, fmt.Errorf("missing ping target")
	}
	ip, err := resolvePingIP(ctx, target, timeout)
	if err != nil {
		return 0, err
	}
	return runICMPEchoRTT(ctx, ip, timeout)
}

func resolvePingIP(ctx context.Context, target string, timeout time.Duration) (net.IP, error) {
	if parsed := net.ParseIP(target); parsed != nil {
		return parsed, nil
	}
	resolverCtx, cancel := context.WithTimeout(ctx, timeout)
	defer cancel()
	ips, err := net.DefaultResolver.LookupIP(resolverCtx, "ip", target)
	if err != nil {
		return nil, err
	}
	if len(ips) == 0 {
		return nil, fmt.Errorf("no ip addresses found for %s", target)
	}
	// Prefer IPv4 when available for compatibility.
	for _, ip := range ips {
		if ip.To4() != nil {
			return ip, nil
		}
	}
	return ips[0], nil
}

func runICMPEchoRTT(ctx context.Context, ip net.IP, timeout time.Duration) (int64, error) {
	conn, protocol, requestType, replyType, datagramMode, err := listenICMP(ip)
	if err != nil {
		return 0, err
	}
	defer conn.Close()

	deadline := time.Now().Add(timeout)
	if ctxDeadline, ok := ctx.Deadline(); ok && ctxDeadline.Before(deadline) {
		deadline = ctxDeadline
	}
	if err := conn.SetDeadline(deadline); err != nil {
		return 0, err
	}

	identifier := int(time.Now().UnixNano() & 0xffff)
	sequence := int((time.Now().UnixNano() >> 16) & 0xffff)
	if sequence == 0 {
		sequence = 1
	}

	echo := &icmp.Echo{
		ID:   identifier,
		Seq:  sequence,
		Data: []byte("goforj-monitor-ping"),
	}
	request := icmp.Message{
		Type: requestType,
		Code: 0,
		Body: echo,
	}
	packet, err := request.Marshal(nil)
	if err != nil {
		return 0, err
	}

	start := time.Now()
	dest := net.Addr(&net.IPAddr{IP: ip})
	if datagramMode {
		dest = &net.UDPAddr{IP: ip, Port: 0}
	}
	if _, err := conn.WriteTo(packet, dest); err != nil {
		return 0, err
	}

	buffer := make([]byte, 1500)
	for {
		n, peer, err := conn.ReadFrom(buffer)
		if err != nil {
			return 0, err
		}
		if !icmpPeerMatchesTarget(peer, ip) {
			continue
		}
		reply, parseErr := icmp.ParseMessage(protocol, buffer[:n])
		if parseErr != nil || reply == nil {
			continue
		}
		if reply.Type != replyType {
			continue
		}
		body, ok := reply.Body.(*icmp.Echo)
		if !ok {
			continue
		}
		// Kernel-managed datagram ICMP sockets may rewrite identifiers.
		if !datagramMode && (body.ID != identifier || body.Seq != sequence) {
			continue
		}
		if datagramMode && body.Seq != sequence {
			continue
		}
		if string(body.Data) != string(echo.Data) {
			continue
		}
		duration := time.Since(start).Milliseconds()
		if duration <= 0 {
			duration = 1
		}
		return duration, nil
	}
}

func icmpPeerMatchesTarget(peer net.Addr, target net.IP) bool {
	if peer == nil {
		return false
	}
	var peerIP net.IP
	switch v := peer.(type) {
	case *net.IPAddr:
		peerIP = v.IP
	case *net.UDPAddr:
		peerIP = v.IP
	default:
		return false
	}
	if peerIP == nil || target == nil {
		return false
	}
	if t4 := target.To4(); t4 != nil {
		p4 := peerIP.To4()
		return p4 != nil && p4.Equal(t4)
	}
	return peerIP.Equal(target)
}

func listenICMP(ip net.IP) (*icmp.PacketConn, int, icmp.Type, icmp.Type, bool, error) {
	if ip4 := ip.To4(); ip4 != nil {
		// Prefer datagram ICMP sockets when available for unprivileged execution.
		if conn, err := icmp.ListenPacket("udp4", "0.0.0.0"); err == nil {
			return conn, 1, ipv4.ICMPTypeEcho, ipv4.ICMPTypeEchoReply, true, nil
		}
		conn, err := icmp.ListenPacket("ip4:icmp", "0.0.0.0")
		if err != nil {
			return nil, 0, nil, nil, false, err
		}
		return conn, 1, ipv4.ICMPTypeEcho, ipv4.ICMPTypeEchoReply, false, nil
	}

	if conn, err := icmp.ListenPacket("udp6", "::"); err == nil {
		return conn, 58, ipv6.ICMPTypeEchoRequest, ipv6.ICMPTypeEchoReply, true, nil
	}
	conn, err := icmp.ListenPacket("ip6:ipv6-icmp", "::")
	if err != nil {
		return nil, 0, nil, nil, false, err
	}
	return conn, 58, ipv6.ICMPTypeEchoRequest, ipv6.ICMPTypeEchoReply, false, nil
}

func (s *CheckService) runSteamCheck(ctx context.Context, target string, timeout time.Duration) checkResult {
	host, port, err := parseSteamMonitorTarget(target)
	if err != nil {
		return checkResult{
			status:    "down",
			errClass:  "validation",
			errText:   classifyCheckError("steam", err.Error()),
			retryable: false,
		}
	}

	address := net.JoinHostPort(host, port)
	start := time.Now()
	conn, dialErr := net.DialTimeout("udp", address, timeout)
	duration := time.Since(start).Milliseconds()
	if dialErr != nil {
		class := classifyCheckClass(dialErr.Error())
		return checkResult{
			status:     "down",
			statusCode: 0,
			durationMs: duration,
			errClass:   class,
			errText:    classifyCheckError("steam", dialErr.Error()),
			retryable:  isRetryableClass(class),
			dnsOrTLS:   class == "dns",
		}
	}
	defer conn.Close()
	_ = conn.SetDeadline(time.Now().Add(timeout))

	// A2S_INFO probe used by Source/Steam game servers.
	query := []byte{0xFF, 0xFF, 0xFF, 0xFF, 0x54, 0x53, 0x6F, 0x75, 0x72, 0x63, 0x65, 0x20, 0x45, 0x6E, 0x67, 0x69, 0x6E, 0x65, 0x20, 0x51, 0x75, 0x65, 0x72, 0x79, 0x00}
	if _, writeErr := conn.Write(query); writeErr != nil {
		class := classifyCheckClass(writeErr.Error())
		return checkResult{
			status:     "down",
			statusCode: 0,
			durationMs: duration,
			errClass:   class,
			errText:    classifyCheckError("steam", writeErr.Error()),
			retryable:  isRetryableClass(class),
			dnsOrTLS:   class == "dns",
		}
	}

	resp := make([]byte, 1400)
	n, readErr := conn.Read(resp)
	if readErr != nil {
		class := classifyCheckClass(readErr.Error())
		return checkResult{
			status:     "down",
			statusCode: 0,
			durationMs: duration,
			errClass:   class,
			errText:    classifyCheckError("steam", readErr.Error()),
			retryable:  isRetryableClass(class),
			dnsOrTLS:   class == "dns",
		}
	}
	if n < 5 || resp[0] != 0xFF || resp[1] != 0xFF || resp[2] != 0xFF || resp[3] != 0xFF {
		return checkResult{
			status:     "down",
			statusCode: 0,
			durationMs: duration,
			errClass:   "protocol",
			errText:    classifyCheckError("steam", "invalid A2S response"),
			retryable:  false,
		}
	}

	packetType := resp[4]
	// 0x49 = A2S_INFO response, 0x41 = challenge response.
	if packetType == 0x49 || packetType == 0x41 {
		return checkResult{status: "up", statusCode: http.StatusOK, durationMs: duration}
	}
	return checkResult{
		status:     "down",
		statusCode: 0,
		durationMs: duration,
		errClass:   "protocol",
		errText:    classifyCheckError("steam", fmt.Sprintf("unexpected response type=0x%X", packetType)),
		retryable:  false,
	}
}

func (s *CheckService) runDockerCheck(ctx context.Context, target string, timeout time.Duration) checkResult {
	container, host, err := parseDockerMonitorTarget(target)
	if err != nil {
		return checkResult{
			status:    "down",
			errClass:  "validation",
			errText:   classifyCheckError("docker", err.Error()),
			retryable: false,
		}
	}

	client, baseURL, clientErr := newDockerHTTPClient(host, timeout)
	if clientErr != nil {
		return checkResult{
			status:    "down",
			errClass:  "validation",
			errText:   classifyCheckError("docker", clientErr.Error()),
			retryable: false,
		}
	}

	reqCtx, cancel := context.WithTimeout(ctx, timeout)
	defer cancel()
	requestURL := fmt.Sprintf("%s/containers/%s/json", strings.TrimRight(baseURL, "/"), neturl.PathEscape(container))
	req, reqErr := http.NewRequestWithContext(reqCtx, http.MethodGet, requestURL, nil)
	if reqErr != nil {
		return checkResult{
			status:    "down",
			errClass:  "validation",
			errText:   classifyCheckError("docker", reqErr.Error()),
			retryable: false,
		}
	}

	start := time.Now()
	res, doErr := client.Do(req)
	duration := time.Since(start).Milliseconds()
	if doErr != nil {
		class := classifyCheckClass(doErr.Error())
		return checkResult{
			status:     "down",
			statusCode: 0,
			durationMs: duration,
			errClass:   class,
			errText:    classifyCheckError("docker", doErr.Error()),
			retryable:  isRetryableClass(class),
			dnsOrTLS:   class == "dns" || class == "tls",
		}
	}
	defer res.Body.Close()

	if res.StatusCode == http.StatusNotFound {
		return checkResult{
			status:     "down",
			statusCode: res.StatusCode,
			durationMs: duration,
			errClass:   "docker_not_found",
			errText:    classifyCheckError("docker", "container not found"),
			retryable:  false,
		}
	}
	if res.StatusCode >= http.StatusBadRequest {
		return checkResult{
			status:     "down",
			statusCode: res.StatusCode,
			durationMs: duration,
			errClass:   "status",
			errText:    classifyCheckError("docker", fmt.Sprintf("status=%d", res.StatusCode)),
			retryable:  false,
		}
	}

	var inspect struct {
		State struct {
			Running    bool   `json:"Running"`
			Paused     bool   `json:"Paused"`
			Restarting bool   `json:"Restarting"`
			Status     string `json:"Status"`
			Health     *struct {
				Status string `json:"Status"`
			} `json:"Health"`
		} `json:"State"`
	}
	if decodeErr := json.NewDecoder(res.Body).Decode(&inspect); decodeErr != nil {
		return checkResult{
			status:     "down",
			statusCode: res.StatusCode,
			durationMs: duration,
			errClass:   "json",
			errText:    classifyCheckError("docker", decodeErr.Error()),
			retryable:  false,
		}
	}

	if inspect.State.Paused {
		return checkResult{
			status:     "down",
			statusCode: res.StatusCode,
			durationMs: duration,
			errClass:   "docker_paused",
			errText:    classifyCheckError("docker", "container is paused"),
			retryable:  false,
		}
	}
	if inspect.State.Restarting {
		return checkResult{
			status:     "unknown",
			statusCode: res.StatusCode,
			durationMs: duration,
			errClass:   "docker_restarting",
			errText:    "",
			retryable:  false,
		}
	}
	if !inspect.State.Running {
		return checkResult{
			status:     "down",
			statusCode: res.StatusCode,
			durationMs: duration,
			errClass:   "docker_stopped",
			errText:    classifyCheckError("docker", "container is not running"),
			retryable:  false,
		}
	}

	if inspect.State.Health != nil {
		switch strings.ToLower(strings.TrimSpace(inspect.State.Health.Status)) {
		case "healthy":
			return checkResult{status: "up", statusCode: res.StatusCode, durationMs: duration}
		case "unhealthy":
			return checkResult{
				status:     "down",
				statusCode: res.StatusCode,
				durationMs: duration,
				errClass:   "docker_unhealthy",
				errText:    classifyCheckError("docker", "container health status is unhealthy"),
				retryable:  false,
			}
		default:
			return checkResult{
				status:     "unknown",
				statusCode: res.StatusCode,
				durationMs: duration,
				errClass:   "docker_starting",
				errText:    "",
				retryable:  false,
			}
		}
	}

	return checkResult{status: "up", statusCode: res.StatusCode, durationMs: duration}
}

func statusFromError(errText string) string {
	if str.Of(errText).TrimSpace().String() == "" {
		return "up"
	}
	return "down"
}

func monitorURLTarget(m *models.Monitor) string {
	targetURL := str.Of(m.TargetURL.ValueOrZero()).TrimSpace().String()
	if targetURL != "" {
		return targetURL
	}
	return str.Of(m.Target).TrimSpace().String()
}

func monitorTCPAddress(m *models.Monitor) string {
	return strings.TrimSpace(m.Target)
}

func monitorPingHost(m *models.Monitor) string {
	return strings.TrimSpace(m.Target)
}

func monitorDNSTarget(m *models.Monitor) string {
	target := strings.TrimSpace(m.Target)
	if target != "" {
		return target
	}
	recordType := strings.TrimSpace(m.TargetRecordType.ValueOrZero())
	if recordType == "" {
		recordType = "A"
	}
	return "|" + strings.ToUpper(recordType)
}

func monitorTLSTarget(m *models.Monitor) string {
	return strings.TrimSpace(m.Target)
}

func monitorHTTPKeywordTarget(m *models.Monitor) (string, string, error) {
	targetURL := monitorURLTarget(m)
	keyword := strings.TrimSpace(m.TargetKeyword.ValueOrZero())
	if targetURL != "" && keyword != "" {
		return targetURL, keyword, nil
	}
	return parseHTTPKeywordTarget(strings.TrimSpace(m.Target))
}

func monitorHTTPJSONQueryTarget(m *models.Monitor) (string, string, string, error) {
	targetURL := monitorURLTarget(m)
	pathExpr := strings.TrimSpace(m.TargetKeyword.ValueOrZero())
	expected := strings.TrimSpace(m.TargetExpected.ValueOrZero())
	if targetURL != "" && pathExpr != "" && expected != "" {
		return targetURL, pathExpr, expected, nil
	}
	return parseHTTPJSONQueryTarget(strings.TrimSpace(m.Target))
}

func monitorSteamTarget(m *models.Monitor) string {
	return strings.TrimSpace(m.Target)
}

func monitorDockerTarget(m *models.Monitor) string {
	container := strings.TrimSpace(m.TargetContainer.ValueOrZero())
	if container == "" {
		return strings.TrimSpace(m.Target)
	}
	dockerHost := strings.TrimSpace(m.TargetDockerHost.ValueOrZero())
	if dockerHost == "" {
		return container
	}
	return container + "|" + dockerHost
}

func (s *CheckService) primeHTTPConnection(ctx context.Context, target string, timeout time.Duration) {
	warmTimeout := monitorWarmupTimeout(timeout)
	_, _, _ = s.runHTTPCheckWithClient(ctx, s.httpxPrimary, "HEAD", target, warmTimeout)
}

func monitorWarmupTimeout(timeout time.Duration) time.Duration {
	warmTimeout := timeout
	if warmTimeout > 1500*time.Millisecond {
		warmTimeout = 1500 * time.Millisecond
	}
	return warmTimeout
}

func (s *CheckService) primeTCPConnection(ctx context.Context, target string, timeout time.Duration) {
	warmTimeout := monitorWarmupTimeout(timeout)
	dialer := net.Dialer{Timeout: warmTimeout}
	conn, err := dialer.DialContext(ctx, "tcp", target)
	if err == nil && conn != nil {
		_ = conn.Close()
	}
}

func (s *CheckService) primeTLSConnection(ctx context.Context, target string, timeout time.Duration) {
	host, port, err := parseTLSMonitorTarget(target)
	if err != nil {
		return
	}
	warmTimeout := monitorWarmupTimeout(timeout)
	dialer := &net.Dialer{Timeout: warmTimeout}
	address := net.JoinHostPort(host, port)
	conn, dialErr := tls.DialWithDialer(dialer, "tcp", address, &tls.Config{
		ServerName:         host,
		InsecureSkipVerify: false,
		MinVersion:         tls.VersionTLS12,
	})
	if dialErr == nil && conn != nil {
		_ = conn.Close()
	}
}

func (s *CheckService) primeWebsocketConnection(ctx context.Context, target string, timeout time.Duration) {
	u, err := neturl.Parse(strings.TrimSpace(target))
	if err != nil || u.Host == "" || (u.Scheme != "ws" && u.Scheme != "wss") {
		return
	}
	warmTimeout := monitorWarmupTimeout(timeout)
	dialer := websocket.Dialer{
		HandshakeTimeout: warmTimeout,
	}
	conn, _, dialErr := dialer.DialContext(ctx, target, nil)
	if dialErr == nil && conn != nil {
		_ = conn.Close()
	}
}

func (s *CheckService) primeSteamConnection(ctx context.Context, target string, timeout time.Duration) {
	host, port, err := parseSteamMonitorTarget(target)
	if err != nil {
		return
	}
	warmTimeout := monitorWarmupTimeout(timeout)
	address := net.JoinHostPort(host, port)
	dialer := net.Dialer{Timeout: warmTimeout}
	conn, dialErr := dialer.DialContext(ctx, "udp", address)
	if dialErr == nil && conn != nil {
		_ = conn.Close()
	}
}

func (s *CheckService) primeDockerConnection(ctx context.Context, target string, timeout time.Duration) {
	container, host, err := parseDockerMonitorTarget(target)
	if err != nil || container == "" {
		return
	}
	warmTimeout := monitorWarmupTimeout(timeout)
	client, baseURL, clientErr := newDockerHTTPClient(host, warmTimeout)
	if clientErr != nil {
		return
	}

	reqCtx, cancel := context.WithTimeout(ctx, warmTimeout)
	defer cancel()
	requestURL := fmt.Sprintf("%s/containers/%s/json", strings.TrimRight(baseURL, "/"), neturl.PathEscape(container))
	req, reqErr := http.NewRequestWithContext(reqCtx, http.MethodGet, requestURL, nil)
	if reqErr != nil {
		return
	}
	resp, doErr := client.Do(req)
	if doErr == nil && resp != nil && resp.Body != nil {
		_, _ = io.Copy(io.Discard, resp.Body)
		_ = resp.Body.Close()
	}
}

func (s *CheckService) runHTTPCheck(ctx context.Context, target string, timeout time.Duration) (int, int64, error) {
	statusCode, duration, err := s.runHTTPCheckWithClient(ctx, s.httpxPrimary, "GET", target, timeout)
	if !shouldRetryWithChromeProfile(statusCode, err) {
		if shouldRetryWithHTTP1(err) {
			http1Status, http1Duration, http1Err := s.runHTTPCheckWithClient(ctx, s.httpxHTTP1, "GET", target, timeout)
			if http1Err == nil {
				return http1Status, http1Duration, nil
			}
			return http1Status, http1Duration, http1Err
		}
		return statusCode, duration, err
	}

	fallbackStatus, fallbackDuration, fallbackErr := s.runHTTPCheckWithClient(ctx, s.httpxChrome, "GET", target, timeout)
	if fallbackErr == nil {
		return fallbackStatus, fallbackDuration, nil
	}

	if shouldRetryWithHTTP1(fallbackErr) {
		http1Status, http1Duration, http1Err := s.runHTTPCheckWithClient(ctx, s.httpxHTTP1, "GET", target, timeout)
		if http1Err == nil {
			return http1Status, http1Duration, nil
		}
		return http1Status, http1Duration, http1Err
	}

	return fallbackStatus, fallbackDuration, fallbackErr
}

func (s *CheckService) runHTTPCheckWithClient(ctx context.Context, client *httpx.Client, method, target string, timeout time.Duration) (int, int64, error) {
	reqCtx, cancel := context.WithTimeout(ctx, timeout)
	defer cancel()

	r := client.Req().R()
	r.SetContext(reqCtx)

	start := time.Now()
	switch method {
	case "HEAD":
		resp, err := r.Head(target)
		duration := time.Since(start).Milliseconds()
		if resp != nil && resp.Response != nil {
			return resp.StatusCode, duration, err
		}
		if err != nil {
			return 0, duration, err
		}
		return 0, duration, nil
	default:
		resp, err := r.Get(target)
		duration := time.Since(start).Milliseconds()
		if resp != nil && resp.Response != nil {
			return resp.StatusCode, duration, err
		}
		if err != nil {
			return 0, duration, err
		}
		return 0, duration, nil
	}
}

func (s *CheckService) fetchHTTPBody(ctx context.Context, target string, timeout time.Duration) (string, error) {
	reqCtx, cancel := context.WithTimeout(ctx, timeout)
	defer cancel()
	resp, err := s.httpxPrimary.Req().R().SetContext(reqCtx).Get(target)
	if err != nil {
		return "", err
	}
	if resp == nil || resp.Response == nil || resp.Response.Body == nil {
		return "", fmt.Errorf("empty body")
	}
	data, readErr := io.ReadAll(resp.Response.Body)
	if readErr != nil {
		return "", readErr
	}
	return string(data), nil
}

func (s *CheckService) runDNSCheck(ctx context.Context, target string, timeout time.Duration) (int, int64, string, string, bool) {
	host, recordType, err := parseDNSMonitorTarget(target)
	if err != nil {
		return 0, 0, "validation", classifyCheckError("dns", err.Error()), false
	}
	start := time.Now()
	resolverCtx, cancel := context.WithTimeout(ctx, timeout)
	defer cancel()
	var lookupErr error
	switch recordType {
	case "AAAA":
		_, lookupErr = net.DefaultResolver.LookupIP(resolverCtx, "ip6", host)
	case "CNAME":
		_, lookupErr = net.DefaultResolver.LookupCNAME(resolverCtx, host)
	case "MX":
		_, lookupErr = net.DefaultResolver.LookupMX(resolverCtx, host)
	case "NS":
		_, lookupErr = net.DefaultResolver.LookupNS(resolverCtx, host)
	case "TXT":
		_, lookupErr = net.DefaultResolver.LookupTXT(resolverCtx, host)
	default:
		_, lookupErr = net.DefaultResolver.LookupHost(resolverCtx, host)
	}
	duration := time.Since(start).Milliseconds()
	if lookupErr != nil {
		class := classifyCheckClass(lookupErr.Error())
		return 0, duration, class, classifyCheckError("dns", lookupErr.Error()), isRetryableClass(class)
	}
	return 200, duration, "", "", false
}

func (s *CheckService) runTLSCheck(ctx context.Context, target string, timeout time.Duration) (int, int64, string, string, bool) {
	host, port, err := parseTLSMonitorTarget(target)
	if err != nil {
		return 0, 0, "validation", classifyCheckError("tls", err.Error()), false
	}
	address := net.JoinHostPort(host, port)
	dialer := &net.Dialer{Timeout: timeout}
	start := time.Now()
	conn, dialErr := tls.DialWithDialer(dialer, "tcp", address, &tls.Config{
		ServerName:         host,
		InsecureSkipVerify: false,
		MinVersion:         tls.VersionTLS12,
	})
	duration := time.Since(start).Milliseconds()
	if dialErr != nil {
		class := classifyCheckClass(dialErr.Error())
		return 0, duration, class, classifyCheckError("tls", dialErr.Error()), isRetryableClass(class)
	}
	defer conn.Close()
	state := conn.ConnectionState()
	now := time.Now().UTC()
	if len(state.PeerCertificates) > 0 {
		cert := state.PeerCertificates[0]
		if now.After(cert.NotAfter) {
			return 0, duration, "tls", classifyCheckError("tls", "certificate expired"), false
		}
	}
	return 200, duration, "", "", false
}

func newDockerHTTPClient(host string, timeout time.Duration) (*http.Client, string, error) {
	value := strings.TrimSpace(host)
	if value == "" {
		value = "unix:///var/run/docker.sock"
	}

	if strings.HasPrefix(value, "unix://") {
		socketPath := strings.TrimPrefix(value, "unix://")
		if strings.TrimSpace(socketPath) == "" {
			return nil, "", fmt.Errorf("invalid unix socket path")
		}
		transport := &http.Transport{
			DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) {
				var d net.Dialer
				return d.DialContext(ctx, "unix", socketPath)
			},
		}
		return &http.Client{Timeout: timeout, Transport: transport}, "http://docker", nil
	}

	if strings.HasPrefix(value, "tcp://") {
		value = "http://" + strings.TrimPrefix(value, "tcp://")
	} else if !strings.HasPrefix(value, "http://") && !strings.HasPrefix(value, "https://") {
		value = "http://" + value
	}
	return &http.Client{Timeout: timeout}, value, nil
}

func resolveJSONPath(value any, path string) (any, bool) {
	parts := strings.Split(strings.TrimSpace(path), ".")
	current := value
	for _, part := range parts {
		key := strings.TrimSpace(part)
		if key == "" {
			return nil, false
		}
		obj, ok := current.(map[string]any)
		if !ok {
			return nil, false
		}
		next, exists := obj[key]
		if !exists {
			return nil, false
		}
		current = next
	}
	return current, true
}

func (s *CheckService) runWebsocketCheck(ctx context.Context, target string, timeout time.Duration) (int, int64, string, string, bool) {
	u, err := neturl.Parse(strings.TrimSpace(target))
	if err != nil || u.Host == "" || (u.Scheme != "ws" && u.Scheme != "wss") {
		return 0, 0, "validation", classifyCheckError("websocket", "invalid websocket target"), false
	}
	dialer := websocket.Dialer{
		HandshakeTimeout: timeout,
	}
	start := time.Now()
	conn, resp, dialErr := dialer.DialContext(ctx, target, nil)
	duration := time.Since(start).Milliseconds()
	if dialErr != nil {
		class := classifyCheckClass(dialErr.Error())
		statusCode := 0
		if resp != nil {
			statusCode = resp.StatusCode
		}
		return statusCode, duration, class, classifyCheckError("websocket", dialErr.Error()), isRetryableClass(class)
	}
	_ = conn.Close()
	return 101, duration, "", "", false
}

func shouldRetryWithChromeProfile(statusCode int, reqErr error) bool {
	if isLikelyBotOrProtocolBlock(reqErr) {
		return true
	}
	switch statusCode {
	case http.StatusForbidden, http.StatusTooManyRequests, http.StatusServiceUnavailable:
		return true
	default:
		return false
	}
}

func shouldRetryWithHTTP1(reqErr error) bool {
	if reqErr == nil {
		return false
	}
	lower := strings.ToLower(reqErr.Error())
	return strings.Contains(lower, "stream error") ||
		strings.Contains(lower, "internal_error") ||
		strings.Contains(lower, "http2") ||
		strings.Contains(lower, "protocol error")
}

func isLikelyBotOrProtocolBlock(reqErr error) bool {
	if reqErr == nil {
		return false
	}
	lower := strings.ToLower(reqErr.Error())
	return strings.Contains(lower, "forbidden") ||
		strings.Contains(lower, "stream error") ||
		strings.Contains(lower, "internal_error") ||
		strings.Contains(lower, "http2")
}

func classifyCheckClass(msg string) string {
	lower := strings.ToLower(msg)
	switch {
	case strings.Contains(lower, "timeout"), strings.Contains(lower, "deadline exceeded"):
		return "timeout"
	case strings.Contains(lower, "no such host"), strings.Contains(lower, "lookup"):
		return "dns"
	case strings.Contains(lower, "x509"), strings.Contains(lower, "certificate"), strings.Contains(lower, "tls"):
		return "tls"
	case strings.Contains(lower, "refused"), strings.Contains(lower, "reset"), strings.Contains(lower, "no route"):
		return "network"
	case strings.Contains(lower, "status="):
		return "status"
	case strings.Contains(lower, "keyword"):
		return "keyword"
	default:
		return "check"
	}
}

func isRetryableClass(class string) bool {
	switch class {
	case "timeout", "dns", "tls", "network":
		return true
	default:
		return false
	}
}

func classifyCheckError(kind string, msg string) string {
	if kind == "ping" {
		msg = humanizePingError(msg)
	}
	tag := classifyCheckClass(msg)
	return fmt.Sprintf("[%s/%s] %s", kind, tag, msg)
}

func humanizePingError(msg string) string {
	lower := strings.ToLower(strings.TrimSpace(msg))
	switch {
	case lower == "":
		return "ping check failed"
	case strings.Contains(lower, "deadline exceeded"), strings.Contains(lower, "i/o timeout"), strings.Contains(lower, "timeout"):
		return "request timed out"
	case strings.Contains(lower, "no route to host"):
		return "no route to host"
	case strings.Contains(lower, "network is unreachable"):
		return "network is unreachable"
	case strings.Contains(lower, "operation not permitted"), strings.Contains(lower, "permission denied"):
		return "icmp permission denied"
	case strings.Contains(lower, "invalid argument"):
		return "icmp socket write failed"
	case strings.Contains(lower, "no such host"), strings.Contains(lower, "lookup"):
		return "host lookup failed"
	default:
		return msg
	}
}

func deterministicJitter(now time.Time, key string, jitterMs int) time.Duration {
	if jitterMs <= 0 {
		return 0
	}
	h := fnv.New32a()
	_, _ = h.Write([]byte(key))
	_, _ = h.Write([]byte(now.Truncate(time.Minute).Format(time.RFC3339)))
	mod := int(h.Sum32() % uint32(jitterMs+1))
	return time.Duration(mod) * time.Millisecond
}

func deterministicRetryJitter(key string, attempt int, max time.Duration) time.Duration {
	if max <= 0 {
		return 0
	}
	h := fnv.New32a()
	_, _ = h.Write([]byte(key))
	_, _ = h.Write([]byte(fmt.Sprintf("-%d", attempt)))
	mod := int64(h.Sum32()) % max.Milliseconds()
	if mod < 0 {
		mod = 0
	}
	return time.Duration(mod) * time.Millisecond
}

func parseDBTimestamp(value string) (time.Time, error) {
	value = strings.TrimSpace(value)
	layouts := []string{
		time.RFC3339Nano,
		"2006-01-02 15:04:05.999999999Z07:00",
		"2006-01-02 15:04:05.999999999",
		"2006-01-02 15:04:05",
	}
	for _, layout := range layouts {
		if ts, err := time.Parse(layout, value); err == nil {
			if ts.Location() == time.Local {
				return ts.UTC(), nil
			}
			return ts, nil
		}
	}
	return time.Time{}, fmt.Errorf("parse timestamp: %s", value)
}

func monitorIDString(m *models.Monitor) string {
	if m == nil {
		return ""
	}
	return anyIDToString(m.Id)
}

func anyIDToString(v any) string {
	switch id := v.(type) {
	case string:
		return id
	case null.String:
		return id.String
	default:
		return strings.TrimSpace(fmt.Sprint(v))
	}
}

func nullableErrorMessage(value string) null.String {
	if strings.TrimSpace(value) == "" {
		return null.String{}
	}
	return null.StringFrom(value)
}

func monitorIDInt64(m *models.Monitor, monitorID string) int64 {
	if m != nil && m.Id > 0 {
		return m.Id
	}
	parsed, err := strconv.ParseInt(strings.TrimSpace(monitorID), 10, 64)
	if err != nil || parsed <= 0 {
		return 0
	}
	return parsed
}

func (s *CheckService) writeCheckWithPolicy(ctx context.Context, monitorID string, monitor *models.Monitor, result checkResult) error {
	exec := checkExecution{
		monitor:   monitor,
		monitorID: monitorID,
		result:    result,
		startedAt: time.Now(),
		timeout:   0,
	}
	return s.persistMonitorChecks(ctx, []checkExecution{exec})
}

func (s *CheckService) persistMonitorChecks(ctx context.Context, executions []checkExecution) error {
	if len(executions) == 0 {
		return nil
	}
	checks := make([]models.MonitorCheck, 0, len(executions))
	checkedAt := make([]time.Time, 0, len(executions))
	for _, exec := range executions {
		now := time.Now().UTC()
		monitorPK := monitorIDInt64(exec.monitor, exec.monitorID)
		if monitorPK <= 0 {
			return fmt.Errorf("monitor check create batch: invalid monitor id %q", strings.TrimSpace(exec.monitorID))
		}
		checkedAt = append(checkedAt, now)
		checks = append(checks, models.MonitorCheck{
			MonitorId:    monitorPK,
			CheckedAt:    now,
			Status:       exec.result.status,
			StatusCode:   null.IntFrom(int64(exec.result.statusCode)),
			DurationMs:   null.IntFrom(exec.result.durationMs),
			ErrorMessage: nullableErrorMessage(exec.result.errText),
		})
	}
	if len(checks) == 1 {
		if err := s.monitorCheckRepo.Create(&checks[0]); err != nil {
			exec := executions[0]
			s.logCheckCompletion(exec.monitorID, exec.monitor, exec.startedAt, exec.timeout, exec.attemptsPlanned, exec.attemptsUsed, exec.result, err)
			return err
		}
	} else {
		if err := s.monitorCheckRepo.CreateBatch(checks); err != nil {
			for _, exec := range executions {
				s.logCheckCompletion(exec.monitorID, exec.monitor, exec.startedAt, exec.timeout, exec.attemptsPlanned, exec.attemptsUsed, exec.result, err)
			}
			return err
		}
	}
	policyCtx, policyErr := s.buildPolicyBatchContext(executions)
	var firstErr error
	if policyErr != nil {
		firstErr = policyErr
	}
	for i, exec := range executions {
		err := s.applyCheckPolicy(ctx, exec.monitorID, exec.monitor, exec.result, checkedAt[i], policyCtx)
		if err != nil && firstErr == nil {
			firstErr = err
		}
		s.logCheckCompletion(exec.monitorID, exec.monitor, exec.startedAt, exec.timeout, exec.attemptsPlanned, exec.attemptsUsed, exec.result, err)
	}
	return firstErr
}

func (s *CheckService) buildPolicyBatchContext(executions []checkExecution) (*policyBatchContext, error) {
	ctx := &policyBatchContext{
		monitorState:  map[string]monitorPolicyState{},
		openIncidents: map[string]models.Incident{},
	}
	if len(executions) == 0 {
		return ctx, nil
	}
	monitorIDs := make([]string, 0, len(executions))
	seen := map[string]struct{}{}
	for _, exec := range executions {
		id := strings.TrimSpace(exec.monitorID)
		if id == "" {
			continue
		}
		if _, exists := seen[id]; exists {
			continue
		}
		seen[id] = struct{}{}
		monitorIDs = append(monitorIDs, id)
	}
	if len(monitorIDs) == 0 {
		return ctx, nil
	}
	if s.monitorCheckRepo != nil {
		rowsByMonitor, err := s.monitorCheckRepo.LatestByMonitorIDs(monitorIDs, monitorStreakScanLimit)
		if err != nil {
			return nil, err
		}
		for monitorID, rows := range rowsByMonitor {
			state := monitorPolicyState{}
			for _, row := range rows {
				status := strings.ToLower(strings.TrimSpace(row.Status))
				if status == "paused" || status == "unknown" || status == "" || status == "pending" {
					continue
				}
				if state.downStreak == 0 && status == "down" {
					state.downStreak = 1
				} else if state.downStreak > 0 {
					if status == "down" {
						state.downStreak++
					} else {
						state.downStreak = -state.downStreak
					}
				}
				if state.upStreak == 0 && status == "up" {
					state.upStreak = 1
				} else if state.upStreak > 0 {
					if status == "up" {
						state.upStreak++
					} else {
						state.upStreak = -state.upStreak
					}
				}
				if state.downStreak < 0 && state.upStreak < 0 {
					break
				}
			}
			if state.downStreak < 0 {
				state.downStreak = 0
			}
			if state.upStreak < 0 {
				state.upStreak = 0
			}
			ctx.monitorState[monitorID] = state
		}
	}
	if s.incidentTransitions != nil {
		openIncidents, err := s.incidentTransitions.OpenByMonitorIDs(monitorIDs)
		if err != nil {
			return nil, err
		}
		ctx.openIncidents = openIncidents
	}
	return ctx, nil
}

func (s *CheckService) applyCheckPolicy(ctx context.Context, monitorID string, monitor *models.Monitor, result checkResult, now time.Time, batchCtx *policyBatchContext) error {
	monitorName := ""
	monitorType := ""
	target := ""
	channelIDs := []int64(nil)
	downConfirm := 1
	recoveryConfirm := 1
	resendEvery := 0
	if monitor != nil {
		monitorName = monitor.Name
		monitorType = monitor.MonitorType
		target = monitor.Target
		channelIDs = models.ParseNotificationChannelIDs(monitor.NotificationChannelIDsRaw)
		if monitor.DownConfirmAttempts > 0 {
			downConfirm = monitor.DownConfirmAttempts
		}
		if monitor.RecoveryConfirmAttempts > 0 {
			recoveryConfirm = monitor.RecoveryConfirmAttempts
		}
		if monitor.ResendIntervalChecks > 0 {
			resendEvery = monitor.ResendIntervalChecks
		}
	}
	if downConfirm > 10 {
		downConfirm = 10
	}
	if recoveryConfirm > 10 {
		recoveryConfirm = 10
	}

	switch result.status {
	case "down":
		streak, err := s.consecutiveStatusCountWithFallback(batchCtx, monitorID, "down", monitorStreakScanLimit)
		if err != nil {
			return err
		}
		if streak < downConfirm {
			return nil
		}
		transition := IncidentTransition{Event: "monitor.down"}
		if existing, hasOpen := s.openIncidentFromBatch(batchCtx, monitorID); hasOpen {
			transition.Changed = false
			transition.IncidentID = anyIDToString(existing.Id)
			transition.Summary = existing.Summary
		} else {
			var err error
			transition, err = s.incidentTransitions.MarkDown(monitorID, now, "Monitor transitioned to down state")
			if err != nil {
				return err
			}
			if transition.Changed && batchCtx != nil {
				monitorPK := monitorIDInt64(monitor, monitorID)
				batchCtx.openIncidents[monitorID] = models.Incident{
					Id:        null.StringFrom(transition.IncidentID),
					MonitorId: monitorPK,
					OpenedAt:  now.UTC(),
					Summary:   transition.Summary,
				}
			}
		}
		if transition.Changed {
			s.publishMonitorDown(events.MonitorDown{
				MonitorID:    monitorID,
				MonitorName:  monitorName,
				MonitorType:  monitorType,
				Target:       target,
				Status:       "down",
				IncidentID:   transition.IncidentID,
				Summary:      transition.Summary,
				ErrorClass:   result.errClass,
				ErrorMessage: result.errText,
				DurationMs:   result.durationMs,
				CheckedAt:    now.Format(time.RFC3339),
			})
			s.enqueueAlert(ctx, alerts.DispatchPayload{
				Event:        "monitor.down",
				MonitorID:    monitorID,
				MonitorName:  monitorName,
				MonitorType:  monitorType,
				Target:       target,
				Status:       "down",
				IncidentID:   transition.IncidentID,
				Summary:      transition.Summary,
				ErrorClass:   result.errClass,
				ErrorMessage: result.errText,
				DurationMs:   result.durationMs,
				CheckedAt:    now,
				ChannelIDs:   channelIDs,
			})
		} else if resendEvery > 0 && streak >= resendEvery && streak%resendEvery == 0 {
			s.enqueueAlert(ctx, alerts.DispatchPayload{
				Event:        "monitor.still_down",
				MonitorID:    monitorID,
				MonitorName:  monitorName,
				MonitorType:  monitorType,
				Target:       target,
				Status:       "down",
				IncidentID:   transition.IncidentID,
				Summary:      "Monitor remains down",
				ErrorClass:   result.errClass,
				ErrorMessage: result.errText,
				DurationMs:   result.durationMs,
				CheckedAt:    now,
				ChannelIDs:   channelIDs,
			})
		}
	case "up":
		streak, err := s.consecutiveStatusCountWithFallback(batchCtx, monitorID, "up", monitorStreakScanLimit)
		if err != nil {
			return err
		}
		if streak < recoveryConfirm {
			return nil
		}
		existing, hasOpen := s.openIncidentFromBatch(batchCtx, monitorID)
		if !hasOpen {
			if batchCtx != nil {
				return nil
			}
			transition, err := s.incidentTransitions.MarkRecovered(monitorID, now)
			if err != nil {
				return err
			}
			if !transition.Changed {
				return nil
			}
			s.publishMonitorRecovered(events.MonitorRecovered{
				MonitorID:   monitorID,
				MonitorName: monitorName,
				MonitorType: monitorType,
				Target:      target,
				Status:      "up",
				IncidentID:  transition.IncidentID,
				Summary:     transition.Summary,
				DurationMs:  result.durationMs,
				CheckedAt:   now.Format(time.RFC3339),
			})
			s.enqueueAlert(ctx, alerts.DispatchPayload{
				Event:       "monitor.recovered",
				MonitorID:   monitorID,
				MonitorName: monitorName,
				MonitorType: monitorType,
				Target:      target,
				Status:      "up",
				IncidentID:  transition.IncidentID,
				Summary:     transition.Summary,
				DurationMs:  result.durationMs,
				CheckedAt:   now,
				ChannelIDs:  channelIDs,
			})
			return nil
		}
		transition, err := s.incidentTransitions.MarkRecoveredByIncidentID(monitorID, anyIDToString(existing.Id), now)
		if err != nil {
			return err
		}
		if transition.Changed {
			if batchCtx != nil {
				delete(batchCtx.openIncidents, monitorID)
			}
			s.publishMonitorRecovered(events.MonitorRecovered{
				MonitorID:   monitorID,
				MonitorName: monitorName,
				MonitorType: monitorType,
				Target:      target,
				Status:      "up",
				IncidentID:  transition.IncidentID,
				Summary:     transition.Summary,
				DurationMs:  result.durationMs,
				CheckedAt:   now.Format(time.RFC3339),
			})
			s.enqueueAlert(ctx, alerts.DispatchPayload{
				Event:       "monitor.recovered",
				MonitorID:   monitorID,
				MonitorName: monitorName,
				MonitorType: monitorType,
				Target:      target,
				Status:      "up",
				IncidentID:  transition.IncidentID,
				Summary:     transition.Summary,
				DurationMs:  result.durationMs,
				CheckedAt:   now,
				ChannelIDs:  channelIDs,
			})
		}
	}
	return nil
}

func (s *CheckService) openIncidentFromBatch(batchCtx *policyBatchContext, monitorID string) (models.Incident, bool) {
	if batchCtx == nil {
		return models.Incident{}, false
	}
	if batchCtx.openIncidents == nil {
		return models.Incident{}, false
	}
	incident, ok := batchCtx.openIncidents[monitorID]
	return incident, ok
}

func (s *CheckService) consecutiveStatusCountFromBatch(batchCtx *policyBatchContext, monitorID, target string) int {
	if batchCtx == nil || batchCtx.monitorState == nil {
		return 0
	}
	state, ok := batchCtx.monitorState[monitorID]
	if !ok {
		return 0
	}
	switch strings.ToLower(strings.TrimSpace(target)) {
	case "down":
		return state.downStreak
	case "up":
		return state.upStreak
	default:
		return 0
	}
}

func (s *CheckService) consecutiveStatusCountWithFallback(batchCtx *policyBatchContext, monitorID, target string, limit int) (int, error) {
	if batchCtx == nil || batchCtx.monitorState == nil {
		return s.consecutiveStatusCount(monitorID, target, limit)
	}
	return s.consecutiveStatusCountFromBatch(batchCtx, monitorID, target), nil
}

func (s *CheckService) writePendingRetryCheck(monitorID string, result checkResult) {
	if s.monitorCheckRepo == nil || strings.TrimSpace(monitorID) == "" {
		return
	}
	now := time.Now().UTC()
	monitorPK := monitorIDInt64(nil, monitorID)
	if monitorPK <= 0 {
		return
	}
	if err := s.monitorCheckRepo.Create(&models.MonitorCheck{
		MonitorId:    monitorPK,
		CheckedAt:    now,
		Status:       "pending",
		StatusCode:   null.IntFrom(int64(result.statusCode)),
		DurationMs:   null.IntFrom(result.durationMs),
		ErrorMessage: nullableErrorMessage(result.errText),
	}); err != nil {
		s.logger.Debug().
			Err(err).
			Str("monitor_id", monitorID).
			Msg("write pending retry check failed")
	}
}

func (s *CheckService) enqueueAlert(ctx context.Context, payload alerts.DispatchPayload) {
	if s.alertDispatch == nil {
		return
	}
	if err := s.alertDispatch.Enqueue(ctx, payload); err != nil {
		s.logger.Error().
			Err(err).
			Str("event", payload.Event).
			Str("monitor_id", payload.MonitorID).
			Msg("enqueue alert failed")
	}
}

func (s *CheckService) publishMonitorDown(payload events.MonitorDown) {
	if s.eventBus == nil {
		return
	}
	if err := s.eventBus.PublishContext(context.Background(), payload); err != nil {
		s.logger.Debug().
			Err(err).
			Str("monitor_id", payload.MonitorID).
			Msg("publish monitor down event failed")
	}
}

func (s *CheckService) publishMonitorRecovered(payload events.MonitorRecovered) {
	if s.eventBus == nil {
		return
	}
	if err := s.eventBus.PublishContext(context.Background(), payload); err != nil {
		s.logger.Debug().
			Err(err).
			Str("monitor_id", payload.MonitorID).
			Msg("publish monitor recovered event failed")
	}
}

func (s *CheckService) consecutiveStatusCount(monitorID, target string, limit int) (int, error) {
	rows, err := s.monitorCheckRepo.LatestByMonitor(monitorID, limit)
	if err != nil {
		return 0, err
	}
	count := 0
	for _, row := range rows {
		state := strings.ToLower(strings.TrimSpace(row.Status))
		if state == "paused" || state == "unknown" || state == "" || state == "pending" {
			continue
		}
		if state != target {
			break
		}
		count++
	}
	return count, nil
}
