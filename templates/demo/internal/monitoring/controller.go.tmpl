func (c *Controller) Summary(ctx echo.Context) error {
	monitors, err := c.monitorRepo.All()
	if err != nil {
		return ctx.JSON(http.StatusServiceUnavailable, map[string]any{"ok": false, "error": err.Error()})
	}
	latestChecks, err := c.monitorCheckRepo.Latest(5000)
	if err != nil {
		return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	latestStatusByMonitor := map[string]string{}
	for _, row := range latestChecks {
		monitorID := strconv.FormatInt(row.MonitorId, 10)
		if _, exists := latestStatusByMonitor[monitorID]; exists {
			continue
		}
		latestStatusByMonitor[monitorID] = normalizeLower(row.Status)
	}

	var total, up, down, paused, pending int64
	total = int64(len(monitors))
		for _, m := range monitors {
			if !m.Enabled {
				paused++
				continue
			}
			switch latestStatusByMonitor[strconv.FormatInt(m.Id, 10)] {
		case "up":
			up++
		case "pending":
			pending++
		default:
			down++
		}
	}

	since := time.Now().UTC().Add(-1 * time.Hour)
	checksLastHour, _ := c.monitorCheckRepo.CountSince(since)

	incidentsOpen, _ := c.incidentRepo.CountOpen()

	payload := map[string]any{
		"ok": true,
		"meta": map[string]any{
			"source":      "demo-app",
			"generatedAt": time.Now().UTC().Format(time.RFC3339),
		},
		"stats": map[string]any{
			"monitors_total":   total,
			"monitors_up":      up,
			"monitors_down":    down,
			"monitors_pending": pending,
			"monitors_paused":  paused,
			"incidents_open":   incidentsOpen,
			"checks_last_hour": checksLastHour,
		},
	}
	return ctx.JSON(http.StatusOK, payload)
}

func (c *Controller) Monitors(ctx echo.Context) error {
	monitors, err := c.loadMonitorItems(
		normalizeLower(ctx.QueryParam("q")),
		normalizeLower(ctx.QueryParam("type")),
		normalizeLower(ctx.QueryParam("state")),
	)
	if err != nil {
		return ctx.JSON(http.StatusServiceUnavailable, map[string]any{"ok": false, "error": err.Error()})
	}

	return ctx.JSON(http.StatusOK, map[string]any{
		"ok":       true,
		"monitors": monitors,
	})
}

func (c *Controller) loadMonitorItems(q, typ, state string) ([]models.MonitorListItem, error) {
	monitors, err := c.monitorRepo.ListItemsOrderedByName()
	if err != nil {
		return nil, err
	}

	latestByMonitor, err := c.monitorCheckRepo.LatestStatusByMonitor(5000)
	if err != nil {
		return nil, err
	}
	for i := range monitors {
		if row, ok := latestByMonitor[monitors[i].ID]; ok {
			monitors[i].LastStatus = normalizeLower(row.Status)
			checkedAt := row.CheckedAt.UTC()
			monitors[i].LastCheckedAt = &checkedAt
		}
	}

	since := time.Now().UTC().Add(-24 * time.Hour)
	byMonitor, _ := c.monitorCheckRepo.UptimeByMonitorSince(since, 10000)
	for i := range monitors {
		row, ok := byMonitor[monitors[i].ID]
		if !ok || row.Total == 0 {
			monitors[i].Uptime24h = 0
			continue
		}
		monitors[i].Uptime24h = (float64(row.UpCount) / float64(row.Total)) * 100
	}
	if q != "" || typ != "" || state != "" {
		filtered := make([]models.MonitorListItem, 0, len(monitors))
		for _, m := range monitors {
			if q != "" {
				joined := strings.ToLower(m.Name + " " + m.Target)
				if !strings.Contains(joined, q) {
					continue
				}
			}
			if typ != "" && strings.ToLower(m.Type) != typ {
				continue
			}
			lastStatus := normalizeLower(m.LastStatus)
			if state == "up" && (!m.Enabled || lastStatus != "up") {
				continue
			}
			if state == "down" && (!m.Enabled || lastStatus == "up") {
				continue
			}
			if state == "paused" && m.Enabled {
				continue
			}
			filtered = append(filtered, m)
		}
		monitors = filtered
	}

	return monitors, nil
}

func (c *Controller) Incidents(ctx echo.Context) error {
	incidents, err := c.incidentRepo.RecentWithMonitor(300)
	if err != nil {
		return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	state := normalizeLower(ctx.QueryParam("state"))
	if state == "open" || state == "resolved" {
		filtered := make([]models.IncidentWithMonitor, 0, len(incidents))
		for _, it := range incidents {
			if state == "open" && it.ResolvedAt == nil {
				filtered = append(filtered, it)
			}
			if state == "resolved" && it.ResolvedAt != nil {
				filtered = append(filtered, it)
			}
		}
		incidents = filtered
	}

	incidentChannels := map[string][]map[string]any{}
	if c.alertDispatchEventRepo != nil && len(incidents) > 0 {
		incidentIDs := make([]string, 0, len(incidents))
		for _, it := range incidents {
			id := normalizeTrim(it.ID)
			if id == "" {
				continue
			}
			incidentIDs = append(incidentIDs, id)
		}
		rows, rowsErr := c.alertDispatchEventRepo.DeliveryRowsByIncidentIDs(incidentIDs, 2000)
		if rowsErr == nil {
			seen := map[string]struct{}{}
			for _, row := range rows {
				incidentID := normalizeTrim(row.IncidentID)
				if incidentID == "" {
					continue
				}
				delivery := normalizeTrim(row.Delivery)
				if delivery == "" {
					delivery = "sent"
				}
				key := fmt.Sprintf("%s|%d|%s|%s", incidentID, row.ChannelID, normalizeLower(row.Provider), normalizeLower(delivery))
				if _, exists := seen[key]; exists {
					continue
				}
				seen[key] = struct{}{}
				incidentChannels[incidentID] = append(incidentChannels[incidentID], map[string]any{
					"channel_id":   row.ChannelID,
					"channel_name": row.ChannelName,
					"provider":     row.Provider,
					"delivery":     delivery,
					"created_at":   row.CreatedAt.UTC(),
				})
			}
		}
	}

	return ctx.JSON(http.StatusOK, map[string]any{
		"ok":                true,
		"incidents":         incidents,
		"incident_channels": incidentChannels,
	})
}

type heartbeatPoint struct {
	Status    string     `json:"status"`
	CheckedAt *time.Time `json:"checked_at,omitempty"`
	LatencyMS *int64     `json:"latency_ms,omitempty"`
}

func buildHeartbeatSlots(
	history []models.HeartbeatRow,
	now time.Time,
	interval int,
	limit int,
	enabled bool,
) ([]string, []heartbeatPoint) {
	if interval <= 0 {
		interval = 60
	}
	if limit <= 0 {
		limit = 12
	}

	statuses := make([]string, limit) // index 0 = newest
	for i := range statuses {
		statuses[i] = "unknown"
	}
	points := make([]*heartbeatPoint, limit) // index 0 = newest

	nowUTC := now.UTC()
	nowSlot := nowUTC.Unix() / int64(interval)

	for _, check := range history {
		checkSlot := check.CheckedAt.UTC().Unix() / int64(interval)
		slotIdx := int(nowSlot - checkSlot)

		if slotIdx < 0 || slotIdx >= limit {
			continue
		}
		if statuses[slotIdx] != "unknown" {
			continue
		}
		status := normalizeLower(check.Status)
		if status == "" {
			status = "unknown"
		}
		statuses[slotIdx] = status
		checkedAt := check.CheckedAt.UTC()
		duration := check.DurationMS
		points[slotIdx] = &heartbeatPoint{
			Status:    status,
			CheckedAt: &checkedAt,
			LatencyMS: &duration,
		}
	}

	// If currently paused, extrapolate paused buckets from the latest persisted pause marker.
	if !enabled && len(history) > 0 && strings.EqualFold(history[0].Status, "paused") {
		pausedAgeSec := nowUTC.Sub(history[0].CheckedAt.UTC()).Seconds()
		if pausedAgeSec >= 0 {
			maxPausedIdx := int(pausedAgeSec / float64(interval))
			if maxPausedIdx >= limit {
				maxPausedIdx = limit - 1
			}
			for idx := 0; idx <= maxPausedIdx; idx++ {
				if statuses[idx] == "unknown" {
					statuses[idx] = "paused"
					slotTime := nowUTC.Add(-time.Duration(idx*interval) * time.Second)
					duration := int64(0)
					points[idx] = &heartbeatPoint{
						Status:    "paused",
						CheckedAt: &slotTime,
						LatencyMS: &duration,
					}
				}
			}
		}
	}

	orderedStatuses := make([]string, 0, limit)
	orderedPoints := make([]heartbeatPoint, 0, limit)
	for i := limit - 1; i >= 0; i-- {
		orderedStatuses = append(orderedStatuses, statuses[i])
		if points[i] != nil {
			orderedPoints = append(orderedPoints, *points[i])
		} else {
			orderedPoints = append(orderedPoints, heartbeatPoint{Status: statuses[i]})
		}
	}

	return orderedStatuses, orderedPoints
}

func (c *Controller) Heartbeats(ctx echo.Context) error {
	limit := 12
	if raw := normalizeTrim(ctx.QueryParam("limit")); raw != "" {
		var parsed int
		if _, parseErr := fmt.Sscanf(raw, "%d", &parsed); parseErr == nil && parsed > 0 && parsed <= 60 {
			limit = parsed
		}
	}

	heartbeats, heartbeatPoints, err := c.loadHeartbeatPayload(limit)
	if err != nil {
		return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}

	return ctx.JSON(http.StatusOK, map[string]any{
		"ok":               true,
		"limit":            limit,
		"heartbeats":       heartbeats,
		"heartbeat_points": heartbeatPoints,
	})
}

func (c *Controller) loadHeartbeatPayload(limit int) (map[string][]string, map[string][]heartbeatPoint, error) {
	monitorIDs, err := c.monitorRepo.IdentitiesOrderedByName()
	if err != nil {
		return nil, nil, err
	}
	rows, err := c.monitorCheckRepo.LatestHeartbeatRows(5000)
	if err != nil {
		return nil, nil, err
	}

	byMonitor := map[string][]models.HeartbeatRow{}
	for _, it := range rows {
		monitorID := strconv.FormatInt(it.MonitorID, 10)
		if len(byMonitor[monitorID]) >= limit {
			continue
		}
		it.Status = normalizeLower(it.Status)
		byMonitor[monitorID] = append(byMonitor[monitorID], it)
	}

	heartbeats := map[string][]string{}
	heartbeatPoints := map[string][]heartbeatPoint{}
	now := time.Now().UTC()
	for _, m := range monitorIDs {
		history := byMonitor[m.ID]
		current, currentPoints := buildHeartbeatSlots(history, now, m.IntervalSeconds, limit, m.Enabled)
		heartbeats[m.ID] = current
		heartbeatPoints[m.ID] = currentPoints
	}

	return heartbeats, heartbeatPoints, nil
}

func (c *Controller) MonitorDetail(ctx echo.Context) error {
	monitorID := ctx.Param("id")
	if monitorID == "" {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "missing monitor id"})
	}
	monitor, err := c.monitorRepo.DetailByID(monitorID)
	if err != nil {
		return ctx.JSON(http.StatusNotFound, map[string]any{"ok": false, "error": "monitor not found"})
	}
	return ctx.JSON(http.StatusOK, map[string]any{"ok": true, "monitor": monitor})
}

func (c *Controller) MonitorFavicon(ctx echo.Context) error {
	monitorID := ctx.Param("id")
	if monitorID == "" {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "missing monitor id"})
	}
	model, err := c.monitorRepo.ByID(monitorID)
	if err != nil {
		return ctx.JSON(http.StatusNotFound, map[string]any{"ok": false, "error": "monitor not found"})
	}

		type monitorTarget struct {
			ID     int64  `gorm:"column:id"`
			Type   string `gorm:"column:monitor_type"`
			Target string `gorm:"column:target"`
		}
	m := monitorTarget{
		ID:     model.Id,
		Type:   model.MonitorType,
		Target: model.Target,
	}

	if normalizeLower(m.Type) != "http" {
		return ctx.NoContent(http.StatusNotFound)
	}

	target := normalizeTrim(m.Target)
	if target == "" {
		return ctx.NoContent(http.StatusNotFound)
	}
	parsed, parseErr := neturl.Parse(target)
	if parseErr != nil || parsed.Host == "" {
		if !strings.Contains(target, "://") {
			parsed, parseErr = neturl.Parse("https://" + target)
		}
	}
	if parseErr != nil || parsed == nil || parsed.Host == "" {
		return ctx.NoContent(http.StatusNotFound)
	}

	scheme := normalizeLower(parsed.Scheme)
	if scheme == "" {
		scheme = "https"
	}
	if scheme != "http" && scheme != "https" {
		return ctx.NoContent(http.StatusNotFound)
	}
	client := &stdhttp.Client{
		Timeout: 4 * time.Second,
	}

	pageURL := scheme + "://" + parsed.Host
	cacheKey := fmt.Sprintf("%d|%s|%s", m.ID, m.Type, pageURL)
	if contentType, body, ok := readFaviconCache(cacheKey, c.faviconCacheTTL()); ok {
		ctx.Response().Header().Set("Cache-Control", "public, max-age=300")
		return ctx.Blob(http.StatusOK, contentType, body)
	}
	candidates := extractFaviconCandidates(pageURL)

	if _, pageType, pageBody, err := fetchURL(client, pageURL, "text/html,application/xhtml+xml"); err == nil {
		if strings.Contains(strings.ToLower(pageType), "text/html") || bytes.Contains(bytes.ToLower(pageBody), []byte("<html")) {
			candidates = append(extractIconLinks(pageURL, string(pageBody)), candidates...)
		}
	}

	seen := map[string]struct{}{}
	uniqueCandidates := make([]string, 0, len(candidates))
	for _, candidate := range candidates {
		normalized := strings.TrimSpace(candidate)
		if normalized == "" {
			continue
		}
		if _, ok := seen[normalized]; ok {
			continue
		}
		seen[normalized] = struct{}{}
		uniqueCandidates = append(uniqueCandidates, normalized)
	}

	for _, candidate := range uniqueCandidates {
		statusCode, contentType, body, err := fetchURL(client, candidate, "image/*,*/*")
		if err != nil || statusCode < 200 || statusCode >= 400 || len(body) == 0 {
			continue
		}
		detected := normalizeImageContentType(contentType, body)
		if detected == "" {
			continue
		}
		writeFaviconCache(cacheKey, detected, body)
		ctx.Response().Header().Set("Cache-Control", "public, max-age=300")
		return ctx.Blob(http.StatusOK, detected, body)
	}

	return ctx.NoContent(http.StatusNotFound)
}

type faviconCacheMeta struct {
	ContentType string `json:"content_type"`
	CachedUnix  int64  `json:"cached_unix"`
}

func faviconCachePath(cacheKey string) string {
	slug := str.Of(cacheKey).TrimSpace().ToLower().Snake("-").String()
	if slug == "" {
		slug = "favicon"
	}
	return filepath.Join(os.TempDir(), "gu-cache", "favicons", slug)
}

func readFaviconCache(cacheKey string, ttl time.Duration) (string, []byte, bool) {
	basePath := faviconCachePath(cacheKey)
	metaPath := basePath + ".json"
	bodyPath := basePath + ".bin"

	metaBytes, err := os.ReadFile(metaPath)
	if err != nil {
		return "", nil, false
	}
	var meta faviconCacheMeta
	if err := json.Unmarshal(metaBytes, &meta); err != nil {
		return "", nil, false
	}
	if meta.CachedUnix <= 0 || str.Of(meta.ContentType).TrimSpace().String() == "" {
		return "", nil, false
	}
	if ttl <= 0 {
		ttl = 7 * 24 * time.Hour
	}
	if time.Since(time.Unix(meta.CachedUnix, 0)) > ttl {
		return "", nil, false
	}
	body, err := os.ReadFile(bodyPath)
	if err != nil || len(body) == 0 {
		return "", nil, false
	}
	return meta.ContentType, body, true
}

func writeFaviconCache(cacheKey, contentType string, body []byte) {
	basePath := faviconCachePath(cacheKey)
	cacheDir := filepath.Dir(basePath)
	if err := os.MkdirAll(cacheDir, 0o755); err != nil {
		return
	}
	meta := faviconCacheMeta{
		ContentType: str.Of(contentType).TrimSpace().String(),
		CachedUnix:  time.Now().Unix(),
	}
	metaBytes, err := json.Marshal(meta)
	if err != nil {
		return
	}
	_ = os.WriteFile(basePath+".bin", body, 0o644)
	_ = os.WriteFile(basePath+".json", metaBytes, 0o644)
}

func (c *Controller) faviconCacheTTL() time.Duration {
	if c.appSettingRepo == nil {
		return 7 * 24 * time.Hour
	}
	raw, err := c.appSettingRepo.GetValue(appsettings.SettingFaviconCacheTTLSeconds, "604800")
	if err != nil {
		c.logger.Warn().Err(err).Msg("favicon cache ttl setting read failed")
		return 7 * 24 * time.Hour
	}
	seconds, convErr := strconv.Atoi(str.Of(raw).TrimSpace().String())
	if convErr != nil || seconds <= 0 {
		return 7 * 24 * time.Hour
	}
	return time.Duration(seconds) * time.Second
}

func extractFaviconCandidates(pageURL string) []string {
	return []string{
		strings.TrimRight(pageURL, "/") + "/favicon.ico",
		strings.TrimRight(pageURL, "/") + "/favicon.png",
	}
}

var (
	linkTagRegex  = regexp.MustCompile(`(?is)<link\b[^>]*>`)
	attrPairRegex = regexp.MustCompile(`(?is)([a-zA-Z_:][-a-zA-Z0-9_:.]*)\s*=\s*("([^"]*)"|'([^']*)'|([^\s>]+))`)
)

func extractIconLinks(pageURL, htmlDoc string) []string {
	baseURL, err := neturl.Parse(strings.TrimSpace(pageURL))
	if err != nil || baseURL == nil {
		return nil
	}

	tags := linkTagRegex.FindAllString(htmlDoc, -1)
	candidates := make([]string, 0, len(tags))
	for _, tag := range tags {
		matches := attrPairRegex.FindAllStringSubmatch(tag, -1)
		attrs := map[string]string{}
		for _, match := range matches {
			key := strings.ToLower(strings.TrimSpace(match[1]))
			value := strings.TrimSpace(match[3])
			if value == "" {
				value = strings.TrimSpace(match[4])
			}
			if value == "" {
				value = strings.TrimSpace(match[5])
			}
			attrs[key] = html.UnescapeString(value)
		}

		rel := strings.ToLower(strings.TrimSpace(attrs["rel"]))
		href := strings.TrimSpace(attrs["href"])
		if href == "" || !strings.Contains(rel, "icon") {
			continue
		}
		parsedHref, err := neturl.Parse(href)
		if err != nil || parsedHref == nil {
			continue
		}
		absolute := baseURL.ResolveReference(parsedHref)
		if absolute == nil {
			continue
		}
		if absolute.Scheme != "http" && absolute.Scheme != "https" {
			continue
		}
		candidates = append(candidates, absolute.String())
	}

	return candidates
}

func fetchURL(client *stdhttp.Client, targetURL, accept string) (int, string, []byte, error) {
	req, err := stdhttp.NewRequest(stdhttp.MethodGet, targetURL, nil)
	if err != nil {
		return 0, "", nil, err
	}
	req.Header.Set("User-Agent", "GoForj-Uptime/1.0")
	if normalizeTrim(accept) != "" {
		req.Header.Set("Accept", accept)
	}
	resp, err := client.Do(req)
	if err != nil {
		return 0, "", nil, err
	}
	defer resp.Body.Close()

	body, err := io.ReadAll(io.LimitReader(resp.Body, 2*1024*1024))
	if err != nil {
		return resp.StatusCode, resp.Header.Get("Content-Type"), nil, err
	}

	return resp.StatusCode, resp.Header.Get("Content-Type"), body, nil
}

func normalizeImageContentType(contentType string, body []byte) string {
	normalized := strings.ToLower(strings.TrimSpace(strings.Split(contentType, ";")[0]))
	if normalized == "" || strings.HasPrefix(normalized, "text/") || normalized == "application/xml" || normalized == "text/xml" {
		sniffed := stdhttp.DetectContentType(body)
		normalized = strings.ToLower(strings.TrimSpace(strings.Split(sniffed, ";")[0]))
	}
	if normalized == "text/plain" && bytes.Contains(bytes.ToLower(body), []byte("<svg")) {
		normalized = "image/svg+xml"
	}
	if strings.HasPrefix(normalized, "image/") {
		return normalized
	}
	if normalized == "application/octet-stream" {
		return "image/x-icon"
	}
	return ""
}

func (c *Controller) MonitorChecks(ctx echo.Context) error {
	monitorID := ctx.Param("id")
	if monitorID == "" {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "missing monitor id"})
	}
	checks, stats, err := c.loadMonitorChecks(monitorID, normalizeTrim(ctx.QueryParam("range")))
	if err != nil {
		if strings.Contains(strings.ToLower(err.Error()), "not found") {
			return ctx.JSON(http.StatusNotFound, map[string]any{"ok": false, "error": "monitor not found"})
		}
		return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}

	return ctx.JSON(http.StatusOK, map[string]any{
		"ok":     true,
		"checks": checks,
		"stats":  stats,
	})
}

func (c *Controller) MonitorDashboard(ctx echo.Context) error {
	monitorID := normalizeTrim(ctx.Param("id"))
	if monitorID == "" {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "missing monitor id"})
