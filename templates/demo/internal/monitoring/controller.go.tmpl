func (c *Controller) ensurePausedCheck(ctx stdcontext.Context, monitorID string, now time.Time) error {
	monitorPK, parseErr := strconv.ParseInt(strings.TrimSpace(monitorID), 10, 64)
	if parseErr != nil || monitorPK <= 0 {
		return fmt.Errorf("invalid monitor id %q", monitorID)
	}
	lastChecks, err := c.monitorCheckRepo.WithContext(ctx).LatestByMonitor(monitorID, 1)
	if err != nil {
		return err
	}
	lastStatus := ""
	if len(lastChecks) > 0 {
		lastStatus = lastChecks[0].Status
	}
	if normalizeLower(lastStatus) == "paused" {
		return nil
	}
	return c.monitorCheckRepo.WithContext(ctx).Create(&models.MonitorCheck{
		MonitorId:    monitorPK,
		CheckedAt:    now,
		Status:       "paused",
		StatusCode:   null.IntFrom(0),
		DurationMs:   null.IntFrom(0),
		ErrorMessage: null.String{},
	})
}

func (c *Controller) MonitorIncidents(r web.Context) error {
	monitorID := r.Param("id")
	if monitorID == "" {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "missing monitor id"})
	}
	incidents, err := c.incidentRepo.WithContext(r.Context()).RecentByMonitor(monitorID, 20)
	if err != nil {
		return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	return r.JSON(http.StatusOK, map[string]any{"ok": true, "incidents": incidents})
}

func (c *Controller) StatusPage(r web.Context) error {
	rows, err := c.monitorRepo.WithContext(r.Context()).EnabledStatusRowsOrderedByName()
	if err != nil {
		return r.JSON(http.StatusServiceUnavailable, map[string]any{"ok": false, "error": err.Error()})
	}
	latestByMonitor, err := c.monitorCheckRepo.WithContext(r.Context()).LatestDisplayStatusByMonitor(5000)
	if err != nil {
		return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	now := time.Now().UTC()
	globalMaintenance := c.monitoringMaintenanceWindow(r.Context(), now)
	for i := range rows {
		if check, ok := latestByMonitor[rows[i].ID]; ok {
			rows[i].LastStatus = normalizeLower(check.Status)
			checked := check.CheckedAt.UTC()
			rows[i].LastChecked = &checked
		}
		if maintenanceActive(globalMaintenance, rows[i].MaintenanceStartsAt, rows[i].MaintenanceEndsAt, now) {
			rows[i].LastStatus = "maintenance"
		}
	}

	latestIncidents, _ := c.incidentRepo.WithContext(r.Context()).RecentOpenWithMonitor(6)

	grouped := map[string][]models.StatusPageService{
		"http":            {},
		"tcp":             {},
		"ping":            {},
		"dns":             {},
		"tls":             {},
		"http_keyword":    {},
		"http_json_query": {},
		"websocket":       {},
		"steam":           {},
		"docker":          {},
		"push":            {},
	}
	for _, it := range rows {
		t := normalizeLower(it.Type)
		if _, ok := grouped[t]; !ok {
			grouped[t] = []models.StatusPageService{}
		}
		grouped[t] = append(grouped[t], it)
	}
	for key := range grouped {
		sort.Slice(grouped[key], func(i, j int) bool {
			return strings.ToLower(grouped[key][i].Name) < strings.ToLower(grouped[key][j].Name)
		})
	}

	var lastUpdated *time.Time
	for i := range rows {
		if rows[i].LastChecked == nil {
			continue
		}
		if lastUpdated == nil || rows[i].LastChecked.After(*lastUpdated) {
			lastUpdated = rows[i].LastChecked
		}
	}

	return r.JSON(http.StatusOK, map[string]any{
		"ok":             true,
		"services":       rows,
		"grouped":        grouped,
		"latestIncident": latestIncidents,
		"lastUpdated":    lastUpdated,
	})
}

func monitorIDFromModel(m *models.Monitor) string {
	if m == nil {
		return ""
	}
	switch id := any(m.Id).(type) {
	case string:
		return id
	case null.String:
		return id.String
	default:
		return strings.TrimSpace(fmt.Sprint(id))
	}
}

