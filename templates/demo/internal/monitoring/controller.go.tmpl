func normalizeMonitorInput(in monitorInput) monitorInput {
	in.Name = normalizeTrim(in.Name)
	in.Type = normalizeLower(in.Type)
	in.Target = normalizeTrim(in.Target)
	in.TargetURL = normalizeTrim(in.TargetURL)
	in.TargetHost = normalizeTrim(in.TargetHost)
	in.TargetRecordType = normalizeUpper(in.TargetRecordType)
	in.TargetKeyword = normalizeTrim(in.TargetKeyword)
	in.TargetExpected = normalizeTrim(in.TargetExpected)
	in.TargetContainer = normalizeTrim(in.TargetContainer)
	in.TargetDockerHost = normalizeTrim(in.TargetDockerHost)
	in.TargetPushToken = normalizeTrim(in.TargetPushToken)
	if in.TargetPort < 0 {
		in.TargetPort = 0
	}
	if in.IntervalSeconds <= 0 {
		in.IntervalSeconds = 60
	}
	if in.TimeoutMS <= 0 {
		in.TimeoutMS = 5000
	}
	if in.RetryAttempts < 0 {
		in.RetryAttempts = 0
	}
	if in.RetryBackoffMS <= 0 {
		in.RetryBackoffMS = 250
	}
	if in.ScheduleJitterMS < 0 {
		in.ScheduleJitterMS = 0
	}
	if in.ScheduleJitterMS == 0 {
		in.ScheduleJitterMS = 150
	}
	if in.DownConfirmAttempts <= 0 {
		in.DownConfirmAttempts = 1
	}
	if in.RecoveryConfirmAttempts <= 0 {
		in.RecoveryConfirmAttempts = 1
	}
	if in.ResendIntervalChecks < 0 {
		in.ResendIntervalChecks = 0
	}
	if in.Type == "" {
		in.Type = "http"
	}
	in.NotificationChannelIDs = models.NormalizeNotificationChannelIDs(in.NotificationChannelIDs)
	return in
}

func (c *Controller) normalizeAndValidateChannelIDs(ids []int64) ([]int64, map[string]string) {
	normalized := models.NormalizeNotificationChannelIDs(ids)
	if len(normalized) == 0 {
		return nil, nil
	}
	if c.channelRepo == nil {
		return nil, map[string]string{
			"notification_channel_ids": "notification channels are not configured",
		}
	}
	summaries, err := c.channelRepo.ListSummaries()
	if err != nil {
		return nil, map[string]string{
			"notification_channel_ids": "failed to load notification channels",
		}
	}
	available := make(map[int64]struct{}, len(summaries))
	for i := range summaries {
		available[summaries[i].ID] = struct{}{}
	}
	for _, id := range normalized {
		if _, ok := available[id]; ok {
			continue
		}
		return nil, map[string]string{
			"notification_channel_ids": "one or more selected channels no longer exist",
		}
	}
	return normalized, nil
}

func canonicalTargetFromInput(in monitorInput) string {
	if normalizeTrim(in.Target) != "" {
		return normalizeTrim(in.Target)
	}
	switch in.Type {
	case "http", "websocket":
		if in.TargetURL == "" {
			return ""
		}
		return in.TargetURL
	case "tcp", "steam":
		if in.TargetHost == "" || in.TargetPort <= 0 {
			return ""
		}
		return fmt.Sprintf("%s:%d", in.TargetHost, in.TargetPort)
	case "ping":
		return in.TargetHost
	case "dns":
		if in.TargetHost == "" {
			return ""
		}
		recordType := in.TargetRecordType
		if recordType == "" {
			recordType = "A"
		}
		return fmt.Sprintf("%s|%s", in.TargetHost, recordType)
	case "tls":
		if in.TargetHost == "" {
			return ""
		}
		port := in.TargetPort
		if port <= 0 {
			port = 443
		}
		return fmt.Sprintf("%s:%d", in.TargetHost, port)
	case "http_keyword":
		if in.TargetURL == "" || in.TargetKeyword == "" {
			return ""
		}
		return in.TargetURL + "|" + in.TargetKeyword
	case "http_json_query":
		if in.TargetURL == "" || in.TargetKeyword == "" || in.TargetExpected == "" {
			return ""
		}
		return in.TargetURL + "|" + in.TargetKeyword + "|" + in.TargetExpected
	case "docker":
		if in.TargetContainer == "" {
			return ""
		}
		if in.TargetDockerHost == "" {
			return in.TargetContainer
		}
		return in.TargetContainer + "|" + in.TargetDockerHost
	case "push":
		return in.TargetPushToken
	default:
		return ""
	}
}

type normalizedMonitorTarget struct {
	Canonical    string
	URL          string
	Host         string
	Port         int
	RecordType   string
	Keyword      string
	Expected     string
	Container    string
	DockerHost   string
	PushToken    string
}

func normalizeMonitorTarget(monitorType, target string) (normalizedMonitorTarget, error) {
	out := normalizedMonitorTarget{Canonical: normalizeTrim(target)}
	switch monitorType {
	case "http", "websocket":
		u, err := neturl.Parse(out.Canonical)
		if err != nil {
			return out, err
		}
		if strings.TrimSpace(u.Hostname()) == "" {
			return out, fmt.Errorf("missing host")
		}
		out.URL = out.Canonical
	case "tcp", "steam":
		host, port, err := net.SplitHostPort(out.Canonical)
		if monitorType == "steam" {
			host, port, err = parseSteamMonitorTarget(out.Canonical)
		}
		if err != nil {
			return out, err
		}
		out.Host = normalizeTrim(host)
		parsedPort, err := strconv.Atoi(normalizeTrim(port))
		if err != nil {
			return out, err
		}
		out.Port = parsedPort
	case "ping":
		out.Host = out.Canonical
	case "dns":
		host, recordType, err := parseDNSMonitorTarget(out.Canonical)
		if err != nil {
			return out, err
		}
		out.Host = host
		out.RecordType = recordType
	case "tls":
		host, port, err := parseTLSMonitorTarget(out.Canonical)
		if err != nil {
			return out, err
		}
		out.Host = host
		parsedPort, err := strconv.Atoi(normalizeTrim(port))
		if err != nil {
			return out, err
		}
		out.Port = parsedPort
	case "http_keyword":
		targetURL, keyword, err := parseHTTPKeywordTarget(out.Canonical)
		if err != nil {
			return out, err
		}
		u, err := neturl.Parse(targetURL)
		if err != nil {
			return out, err
		}
		if strings.TrimSpace(u.Hostname()) == "" {
			return out, fmt.Errorf("missing host")
		}
		out.URL = normalizeTrim(targetURL)
		out.Keyword = normalizeTrim(keyword)
	case "http_json_query":
		targetURL, pathExpr, expected, err := parseHTTPJSONQueryTarget(out.Canonical)
		if err != nil {
			return out, err
		}
		u, err := neturl.Parse(targetURL)
		if err != nil {
			return out, err
		}
		if strings.TrimSpace(u.Hostname()) == "" {
			return out, fmt.Errorf("missing host")
		}
		out.URL = normalizeTrim(targetURL)
		out.Keyword = normalizeTrim(pathExpr)
		out.Expected = normalizeTrim(expected)
	case "docker":
		container, host, err := parseDockerMonitorTarget(out.Canonical)
		if err != nil {
			return out, err
		}
		out.Container = normalizeTrim(container)
		out.DockerHost = normalizeTrim(host)
	case "push":
		out.PushToken = out.Canonical
	}
	return out, nil
}

func applyNormalizedMonitorTarget(m *models.Monitor, n normalizedMonitorTarget) {
	m.Target = n.Canonical
	m.TargetURL = null.NewString(n.URL, normalizeTrim(n.URL) != "")
	m.TargetRecordType = null.NewString(n.RecordType, normalizeTrim(n.RecordType) != "")
	m.TargetKeyword = null.NewString(n.Keyword, normalizeTrim(n.Keyword) != "")
	m.TargetExpected = null.NewString(n.Expected, normalizeTrim(n.Expected) != "")
	m.TargetContainer = null.NewString(n.Container, normalizeTrim(n.Container) != "")
	m.TargetDockerHost = null.NewString(n.DockerHost, normalizeTrim(n.DockerHost) != "")
	m.TargetPushToken = null.NewString(n.PushToken, normalizeTrim(n.PushToken) != "")
}

func validateMonitorInput(in monitorInput) *monitorValidationError {
	fields := map[string]string{}
	if in.Name == "" {
		fields["name"] = "name is required"
	}
	if in.Target == "" {
		fields["target"] = "target is required"
	}
	if in.IntervalSeconds < 5 || in.IntervalSeconds > 86400 {
		fields["interval_seconds"] = "interval must be between 5 and 86400 seconds"
	}
	if in.TimeoutMS < 250 || in.TimeoutMS > 60000 {
		fields["timeout_ms"] = "timeout must be between 250 and 60000 milliseconds"
	}
	if in.RetryAttempts < 0 || in.RetryAttempts > 5 {
		fields["retry_attempts"] = "retry attempts must be between 0 and 5"
	}
	if in.RetryBackoffMS < 50 || in.RetryBackoffMS > 10000 {
		fields["retry_backoff_ms"] = "retry backoff must be between 50 and 10000 milliseconds"
	}
	if in.ScheduleJitterMS < 0 || in.ScheduleJitterMS > 30000 {
		fields["schedule_jitter_ms"] = "schedule jitter must be between 0 and 30000 milliseconds"
	}
	if in.DownConfirmAttempts < 1 || in.DownConfirmAttempts > 10 {
		fields["down_confirm_attempts"] = "down confirm attempts must be between 1 and 10"
	}
	if in.RecoveryConfirmAttempts < 1 || in.RecoveryConfirmAttempts > 10 {
		fields["recovery_confirm_attempts"] = "recovery confirm attempts must be between 1 and 10"
	}
	if in.ResendIntervalChecks < 0 || in.ResendIntervalChecks > 1000 {
		fields["resend_interval_checks"] = "resend interval checks must be between 0 and 1000"
	}
	switch in.Type {
	case "http":
		u, err := neturl.Parse(in.Target)
		if err != nil || u.Host == "" {
			fields["target"] = "http target must be a valid URL"
		}
		if u.Scheme != "http" && u.Scheme != "https" {
			fields["target"] = "http target must start with http:// or https://"
		}
	case "tcp":
		if _, _, err := net.SplitHostPort(in.Target); err != nil {
			fields["target"] = "tcp target must be host:port"
		}
	case "ping":
		if strings.Contains(in.Target, "://") || strings.Contains(in.Target, "/") {
			fields["target"] = "ping target must be a hostname or IP"
		}
	case "dns":
		host, recordType, err := parseDNSMonitorTarget(in.Target)
		if err != nil || host == "" {
			fields["target"] = "dns target must be host or host|A/AAAA/CNAME/MX/NS/TXT"
			break
		}
		switch recordType {
		case "A", "AAAA", "CNAME", "MX", "NS", "TXT":
		default:
			fields["target"] = "dns record type must be A, AAAA, CNAME, MX, NS, or TXT"
		}
	case "tls":
		if _, _, err := parseTLSMonitorTarget(in.Target); err != nil {
			fields["target"] = "tls target must be https://host[:port], host, or host:port"
		}
	case "http_keyword":
		urlValue, keyword, err := parseHTTPKeywordTarget(in.Target)
		if err != nil {
			fields["target"] = "http_keyword target must be https://host/path|keyword"
			break
		}
		u, err := neturl.Parse(urlValue)
		if err != nil || u.Host == "" || (u.Scheme != "http" && u.Scheme != "https") {
			fields["target"] = "http_keyword URL must start with http:// or https://"
		} else if normalizeTrim(keyword) == "" {
			fields["target"] = "http_keyword must include a non-empty keyword after |"
		}
	case "http_json_query":
		urlValue, path, expected, err := parseHTTPJSONQueryTarget(in.Target)
		if err != nil {
			fields["target"] = "http_json_query target must be https://host/path|json.path|expected"
			break
		}
		u, err := neturl.Parse(urlValue)
		if err != nil || u.Host == "" || (u.Scheme != "http" && u.Scheme != "https") {
			fields["target"] = "http_json_query URL must start with http:// or https://"
		} else if normalizeTrim(path) == "" || normalizeTrim(expected) == "" {
			fields["target"] = "http_json_query must include non-empty path and expected value"
		}
	case "websocket":
		u, err := neturl.Parse(in.Target)
		if err != nil || u.Host == "" {
			fields["target"] = "websocket target must be a valid ws:// or wss:// URL"
			break
		}
		if u.Scheme != "ws" && u.Scheme != "wss" {
			fields["target"] = "websocket target must start with ws:// or wss://"
		}
	case "steam":
		host, port, err := parseSteamMonitorTarget(in.Target)
		if err != nil || host == "" || port == "" {
			fields["target"] = "steam target must be host:port"
		}
	case "docker":
		container, host, err := parseDockerMonitorTarget(in.Target)
		if err != nil || container == "" {
			fields["target"] = "docker target must be container-name or container-name|docker-host"
			break
		}
		lowerHost := normalizeLower(host)
		if lowerHost != "" &&
			!strings.HasPrefix(lowerHost, "unix://") &&
			!strings.HasPrefix(lowerHost, "tcp://") &&
			!strings.HasPrefix(lowerHost, "http://") &&
			!strings.HasPrefix(lowerHost, "https://") {
			fields["target"] = "docker host must start with unix://, tcp://, http://, or https://"
		}
	case "push":
		if normalizeTrim(in.Target) == "" {
			fields["target"] = "push target must be a non-empty token or name"
		}
	default:
		fields["type"] = "unsupported monitor type"
	}
	if len(fields) == 0 {
		return nil
	}
	return &monitorValidationError{
		Error:  "monitor validation failed",
		Fields: fields,
	}
}

func parseDNSMonitorTarget(target string) (string, string, error) {
	parts := strings.SplitN(strings.TrimSpace(target), "|", 2)
	host := strings.TrimSpace(parts[0])
	if host == "" {
		return "", "", fmt.Errorf("missing host")
	}
	recordType := "A"
	if len(parts) == 2 {
		recordType = strings.ToUpper(strings.TrimSpace(parts[1]))
	}
	return host, recordType, nil
}

func parseTLSMonitorTarget(target string) (string, string, error) {
	value := strings.TrimSpace(target)
	if value == "" {
		return "", "", fmt.Errorf("missing target")
	}
	if strings.Contains(value, "://") {
		u, err := neturl.Parse(value)
		if err != nil || u.Host == "" {
			return "", "", fmt.Errorf("invalid url")
		}
		host := u.Hostname()
		port := u.Port()
		if port == "" {
			port = "443"
		}
		return host, port, nil
	}
	host, port, err := net.SplitHostPort(value)
	if err == nil {
		return host, port, nil
	}
	return value, "443", nil
}

func parseSteamMonitorTarget(target string) (string, string, error) {
	value := strings.TrimSpace(target)
	if value == "" {
		return "", "", fmt.Errorf("missing target")
	}
	host, port, err := net.SplitHostPort(value)
	if err == nil {
		return strings.TrimSpace(host), strings.TrimSpace(port), nil
	}
	if strings.Contains(value, ":") {
		parts := strings.SplitN(value, ":", 2)
		if len(parts) == 2 && strings.TrimSpace(parts[0]) != "" && strings.TrimSpace(parts[1]) != "" {
			return strings.TrimSpace(parts[0]), strings.TrimSpace(parts[1]), nil
		}
	}
	return "", "", fmt.Errorf("steam target must be host:port")
}

func parseDockerMonitorTarget(target string) (string, string, error) {
	parts := strings.SplitN(strings.TrimSpace(target), "|", 2)
	container := strings.TrimSpace(parts[0])
	if container == "" {
		return "", "", fmt.Errorf("missing container")
	}
	host := ""
	if len(parts) == 2 {
		host = strings.TrimSpace(parts[1])
	}
	return container, host, nil
}

func parseHTTPKeywordTarget(target string) (string, string, error) {
	parts := strings.SplitN(strings.TrimSpace(target), "|", 2)
	if len(parts) != 2 {
		return "", "", fmt.Errorf("missing separator")
	}
	urlValue := strings.TrimSpace(parts[0])
	keyword := strings.TrimSpace(parts[1])
	if urlValue == "" || keyword == "" {
		return "", "", fmt.Errorf("invalid value")
	}
	return urlValue, keyword, nil
}

func parseHTTPJSONQueryTarget(target string) (string, string, string, error) {
	parts := strings.SplitN(strings.TrimSpace(target), "|", 3)
	if len(parts) != 3 {
		return "", "", "", fmt.Errorf("missing segments")
	}
	urlValue := strings.TrimSpace(parts[0])
	path := strings.TrimSpace(parts[1])
	expected := strings.TrimSpace(parts[2])
	if urlValue == "" || path == "" || expected == "" {
		return "", "", "", fmt.Errorf("invalid value")
	}
	return urlValue, path, expected, nil
}

func (c *Controller) CreateMonitor(ctx echo.Context) error {
	var in monitorInput
	if err := ctx.Bind(&in); err != nil {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "invalid payload"})
	}
	in = normalizeMonitorInput(in)
	in.Target = canonicalTargetFromInput(in)
	if validationErr := validateMonitorInput(in); validationErr != nil {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": validationErr.Error, "fields": validationErr.Fields})
	}
	channelIDs, channelErrFields := c.normalizeAndValidateChannelIDs(in.NotificationChannelIDs)
	if len(channelErrFields) > 0 {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "monitor validation failed", "fields": channelErrFields})
	}
	duplicateCount, err := c.monitorRepo.CountByTypeAndTarget(in.Type, in.Target)
	if err != nil {
		return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	if duplicateCount > 0 {
		return ctx.JSON(http.StatusConflict, map[string]any{
			"ok":    false,
			"error": "monitor validation failed",
			"fields": map[string]string{
				"target": "type + target must be unique",
			},
		})
	}
	normalizedTarget, err := normalizeMonitorTarget(in.Type, in.Target)
	if err != nil {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": err.Error()})
	}
	now := time.Now().UTC()
	model := &models.Monitor{
		Name:            in.Name,
		MonitorType:     in.Type,
		NotificationChannelIDsRaw: models.SerializeNotificationChannelIDs(channelIDs),
		IntervalSeconds: in.IntervalSeconds,
		TimeoutMs:       in.TimeoutMS,
		RetryAttempts:   in.RetryAttempts,
		RetryBackoffMs:  in.RetryBackoffMS,
		ScheduleJitterMs: in.ScheduleJitterMS,
		DownConfirmAttempts: in.DownConfirmAttempts,
		RecoveryConfirmAttempts: in.RecoveryConfirmAttempts,
		ResendIntervalChecks: in.ResendIntervalChecks,
		Enabled:         in.Enabled,
		CreatedAt:       now,
		UpdatedAt:       now,
	}
	applyNormalizedMonitorTarget(model, normalizedTarget)
	if err := c.monitorRepo.Create(model); err != nil {
		return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	id := strconv.FormatInt(model.Id, 10)
	if !in.Enabled {
		_ = c.ensurePausedCheck(id, now)
	}
	return ctx.JSON(http.StatusCreated, map[string]any{"ok": true, "id": id})
}

func (c *Controller) UpdateMonitor(ctx echo.Context) error {
	monitorID := ctx.Param("id")
	if monitorID == "" {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "missing monitor id"})
	}
	var in monitorInput
	if err := ctx.Bind(&in); err != nil {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "invalid payload"})
	}
	in = normalizeMonitorInput(in)
	in.Target = canonicalTargetFromInput(in)
	if validationErr := validateMonitorInput(in); validationErr != nil {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": validationErr.Error, "fields": validationErr.Fields})
	}
	channelIDs, channelErrFields := c.normalizeAndValidateChannelIDs(in.NotificationChannelIDs)
	if len(channelErrFields) > 0 {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "monitor validation failed", "fields": channelErrFields})
	}
	duplicateCount, err := c.monitorRepo.CountByTypeAndTargetExcludingID(in.Type, in.Target, monitorID)
	if err != nil {
		return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	if duplicateCount > 0 {
		return ctx.JSON(http.StatusConflict, map[string]any{
			"ok":    false,
			"error": "monitor validation failed",
			"fields": map[string]string{
				"target": "type + target must be unique",
			},
		})
	}
	normalizedTarget, err := normalizeMonitorTarget(in.Type, in.Target)
	if err != nil {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": err.Error()})
	}
	current, err := c.monitorRepo.ByID(monitorID)
	if err != nil {
		return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	if current == nil || monitorIDFromModel(current) == "" {
		return ctx.JSON(http.StatusNotFound, map[string]any{"ok": false, "error": "monitor not found"})
	}
	wasEnabled := current.Enabled
	current.Name = in.Name
	current.MonitorType = in.Type
	applyNormalizedMonitorTarget(current, normalizedTarget)
	current.IntervalSeconds = in.IntervalSeconds
	current.TimeoutMs = in.TimeoutMS
	current.RetryAttempts = in.RetryAttempts
	current.RetryBackoffMs = in.RetryBackoffMS
	current.ScheduleJitterMs = in.ScheduleJitterMS
	current.DownConfirmAttempts = in.DownConfirmAttempts
	current.RecoveryConfirmAttempts = in.RecoveryConfirmAttempts
	current.ResendIntervalChecks = in.ResendIntervalChecks
	current.NotificationChannelIDsRaw = models.SerializeNotificationChannelIDs(channelIDs)
	current.Enabled = in.Enabled
	current.UpdatedAt = time.Now().UTC()
	if err := c.monitorRepo.Update(current); err != nil {
		return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	now := time.Now().UTC()
	if wasEnabled && !in.Enabled {
		_ = c.ensurePausedCheck(monitorID, now)
	}
	return ctx.JSON(http.StatusOK, map[string]any{"ok": true, "id": monitorID})
}

func (c *Controller) SetMonitorEnabled(ctx echo.Context) error {
	monitorID := ctx.Param("id")
	if monitorID == "" {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "missing monitor id"})
	}
	var input struct {
		Enabled bool `json:"enabled"`
	}
	if err := ctx.Bind(&input); err != nil {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "invalid payload"})
	}
	current, err := c.monitorRepo.ByID(monitorID)
	if err != nil {
		return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	if current == nil || monitorIDFromModel(current) == "" {
		return ctx.JSON(http.StatusNotFound, map[string]any{"ok": false, "error": "monitor not found"})
	}
	if !input.Enabled && current.Enabled {
		now := time.Now().UTC()
		if err := c.ensurePausedCheck(monitorID, now); err != nil {
			return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
		}
	}
	current.Enabled = input.Enabled
	current.UpdatedAt = time.Now().UTC()
	if err := c.monitorRepo.Update(current); err != nil {
		return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	return ctx.JSON(http.StatusOK, map[string]any{"ok": true, "id": monitorID, "enabled": input.Enabled})
}

func (c *Controller) DeleteMonitor(ctx echo.Context) error {
	monitorID := ctx.Param("id")
	if monitorID == "" {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "missing monitor id"})
	}

	conn, err := c.db.Default()
	if err != nil {
		return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}

	err = conn.Transaction(func(tx *gorm.DB) error {
		monitorPK, parseErr := strconv.ParseInt(strings.TrimSpace(monitorID), 10, 64)
		if parseErr != nil || monitorPK <= 0 {
			return gorm.ErrRecordNotFound
		}
		if err := tx.Where("monitor_id = ?", monitorPK).Delete(&models.MonitorCheck{}).Error; err != nil {
			return err
		}
		if err := tx.Where("monitor_id = ?", monitorPK).Delete(&models.Incident{}).Error; err != nil {
			return err
		}
		if err := tx.Where("monitor_id = ?", monitorPK).Delete(&models.MonitorCheckRollup{}).Error; err != nil {
			return err
		}
		if err := tx.Where("monitor_id = ?", monitorPK).Delete(&models.AlertDispatchEvent{}).Error; err != nil {
			return err
		}
		result := tx.Where("id = ?", monitorID).Delete(&models.Monitor{})
		if result.Error != nil {
			return result.Error
		}
		if result.RowsAffected == 0 {
			return gorm.ErrRecordNotFound
		}
		return nil
	})
	if errors.Is(err, gorm.ErrRecordNotFound) {
		return ctx.JSON(http.StatusNotFound, map[string]any{"ok": false, "error": "monitor not found"})
	}
	if err != nil {
		return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	return ctx.JSON(http.StatusOK, map[string]any{"ok": true, "id": monitorID})
}

func (c *Controller) MonitorPush(ctx echo.Context) error {
	monitorID := normalizeTrim(ctx.Param("id"))
	if monitorID == "" {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "missing monitor id"})
	}

	monitor, err := c.monitorRepo.ByID(monitorID)
	if err != nil || monitor == nil {
		return ctx.JSON(http.StatusNotFound, map[string]any{"ok": false, "error": "monitor not found"})
	}
	if normalizeLower(monitor.MonitorType) != "push" {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "monitor is not push type"})
	}

	var payload struct {
		Status     string `json:"status"`
		StatusCode *int   `json:"status_code"`
		LatencyMS  *int64 `json:"latency_ms"`
		Message    string `json:"message"`
	}
	if bindErr := ctx.Bind(&payload); bindErr != nil && bindErr != io.EOF {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "invalid payload"})
	}

	status := normalizeLower(payload.Status)
	if status == "" {
		status = normalizeLower(ctx.QueryParam("status"))
	}
	switch status {
	case "up", "down", "paused", "unknown":
	default:
		if status == "" {
			status = "up"
		} else {
			return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "status must be one of up, down, paused, unknown"})
		}
	}

	var latency int64
	if payload.LatencyMS != nil {
		latency = *payload.LatencyMS
	} else if q := normalizeTrim(ctx.QueryParam("latency_ms")); q != "" {
		if _, parseErr := fmt.Sscanf(q, "%d", &latency); parseErr != nil {
			return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "latency_ms must be an integer"})
		}
	}
	if latency < 0 {
		latency = 0
	}

	now := time.Now().UTC()
	check := &models.MonitorCheck{
		MonitorId:  monitor.Id,
		CheckedAt:  now,
		Status:     status,
		DurationMs: null.IntFrom(latency),
	}
	if payload.StatusCode != nil {
		check.StatusCode = null.IntFrom(int64(*payload.StatusCode))
	} else if status == "up" {
		check.StatusCode = null.IntFrom(200)
	} else if status == "down" {
		check.StatusCode = null.IntFrom(503)
	}
	if msg := normalizeTrim(payload.Message); msg != "" {
		check.ErrorMessage = null.StringFrom(msg)
	} else {
		check.ErrorMessage = null.String{}
	}

	if err := c.monitorCheckRepo.Create(check); err != nil {
		return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	channelIDs := models.ParseNotificationChannelIDs(monitor.NotificationChannelIDsRaw)
	downConfirm := monitor.DownConfirmAttempts
	if downConfirm <= 0 {
		downConfirm = 1
	}
	recoveryConfirm := monitor.RecoveryConfirmAttempts
	if recoveryConfirm <= 0 {
		recoveryConfirm = 1
	}
	resendEvery := monitor.ResendIntervalChecks
	if resendEvery < 0 {
		resendEvery = 0
	}

	if status == "down" {
		streak, streakErr := c.consecutiveStatusCount(monitorID, "down", monitorPushStreakScanLimit)
		if streakErr != nil {
			return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": streakErr.Error()})
		}
		if streak >= downConfirm {
			transition, transitionErr := c.incidentTransitions.MarkDown(monitorID, now, "push monitor reported down")
			if transitionErr != nil {
				return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": transitionErr.Error()})
			}
			if transition.Changed {
				c.publishMonitorTransition(events.MonitorDownTopic, events.MonitorTransitionPayload{
					MonitorID:    monitorID,
					MonitorName:  monitor.Name,
					MonitorType:  monitor.MonitorType,
					Target:       monitor.Target,
					Status:       "down",
					IncidentID:   transition.IncidentID,
					Summary:      transition.Summary,
					ErrorMessage: normalizeTrim(payload.Message),
					DurationMs:   latency,
					CheckedAt:    now.Format(time.RFC3339),
				})
				c.enqueueMonitorAlert(
					ctx.Request().Context(),
					"monitor.down",
					monitorID,
					monitor.Name,
					monitor.MonitorType,
					monitor.Target,
					"down",
					transition.IncidentID,
					transition.Summary,
					normalizeTrim(payload.Message),
					latency,
					now,
					channelIDs,
				)
			} else if resendEvery > 0 && streak >= resendEvery && streak%resendEvery == 0 {
				c.enqueueMonitorAlert(
					ctx.Request().Context(),
					"monitor.still_down",
					monitorID,
					monitor.Name,
					monitor.MonitorType,
					monitor.Target,
					"down",
					transition.IncidentID,
					"Monitor remains down",
					normalizeTrim(payload.Message),
					latency,
					now,
					channelIDs,
				)
			}
		}
	} else if status == "up" {
		streak, streakErr := c.consecutiveStatusCount(monitorID, "up", monitorPushStreakScanLimit)
		if streakErr != nil {
			return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": streakErr.Error()})
		}
		if streak >= recoveryConfirm {
			transition, transitionErr := c.incidentTransitions.MarkRecovered(monitorID, now)
			if transitionErr != nil {
				return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": transitionErr.Error()})
			}
			if transition.Changed {
				c.publishMonitorTransition(events.MonitorRecoveredTopic, events.MonitorTransitionPayload{
					MonitorID:   monitorID,
					MonitorName: monitor.Name,
					MonitorType: monitor.MonitorType,
					Target:      monitor.Target,
					Status:      "up",
					IncidentID:  transition.IncidentID,
					Summary:     transition.Summary,
					DurationMs:  latency,
					CheckedAt:   now.Format(time.RFC3339),
				})
				c.enqueueMonitorAlert(
					ctx.Request().Context(),
					"monitor.recovered",
					monitorID,
					monitor.Name,
					monitor.MonitorType,
					monitor.Target,
					"up",
					transition.IncidentID,
					transition.Summary,
					"",
					latency,
					now,
					channelIDs,
				)
			}
		}
	}

	return ctx.JSON(http.StatusAccepted, map[string]any{
		"ok":         true,
		"id":         monitorID,
		"status":     status,
		"checked_at": now.Format(time.RFC3339),
	})
}

func (c *Controller) consecutiveStatusCount(monitorID, target string, limit int) (int, error) {
	rows, err := c.monitorCheckRepo.LatestByMonitor(monitorID, limit)
	if err != nil {
		return 0, err
	}
	count := 0
	for _, row := range rows {
		state := strings.ToLower(strings.TrimSpace(row.Status))
		if state == "paused" || state == "unknown" || state == "" || state == "pending" {
			continue
		}
		if state != target {
			break
		}
		count++
	}
	return count, nil
}

func (c *Controller) enqueueMonitorAlert(
	ctx stdcontext.Context,
	event string,
	monitorID string,
	monitorName string,
	monitorType string,
	target string,
	status string,
	incidentID string,
	summary string,
	errorMessage string,
	durationMs int64,
	checkedAt time.Time,
	channelIDs []int64,
) {
	{{- if .Components.Jobs }}
	if c.alertDispatch == nil {
		return
	}
	payload := alerts.DispatchPayload{
		Event:        event,
		MonitorID:    monitorID,
		MonitorName:  monitorName,
		MonitorType:  monitorType,
		Target:       target,
		Status:       status,
		IncidentID:   incidentID,
		Summary:      summary,
		ErrorMessage: errorMessage,
		DurationMs:   durationMs,
		CheckedAt:    checkedAt,
		ChannelIDs:   channelIDs,
	}
	if err := c.alertDispatch.Enqueue(ctx, payload); err != nil {
		c.logger.Error().
			Err(err).
			Str("event", event).
			Str("monitor_id", monitorID).
			Msg("enqueue push alert failed")
	}
	{{- end }}
}

func (c *Controller) publishMonitorTransition(topic string, payload events.MonitorTransitionPayload) {
	if c.eventBus == nil || strings.TrimSpace(topic) == "" {
		return
	}
	if err := events.PublishJSON(stdcontext.Background(), c.eventBus, topic, payload); err != nil {
		c.logger.Debug().
			Err(err).
			Str("topic", topic).
			Str("monitor_id", payload.MonitorID).
			Msg("publish push monitor transition event failed")
	}
}

func (c *Controller) ensurePausedCheck(monitorID string, now time.Time) error {
	monitorPK, parseErr := strconv.ParseInt(strings.TrimSpace(monitorID), 10, 64)
	if parseErr != nil || monitorPK <= 0 {
		return fmt.Errorf("invalid monitor id %q", monitorID)
	}
	lastChecks, err := c.monitorCheckRepo.LatestByMonitor(monitorID, 1)
	if err != nil {
		return err
	}
	lastStatus := ""
	if len(lastChecks) > 0 {
		lastStatus = lastChecks[0].Status
	}
	if normalizeLower(lastStatus) == "paused" {
		return nil
	}
	return c.monitorCheckRepo.Create(&models.MonitorCheck{
		MonitorId:    monitorPK,
		CheckedAt:    now,
		Status:       "paused",
		StatusCode:   null.IntFrom(0),
		DurationMs:   null.IntFrom(0),
		ErrorMessage: null.String{},
	})
}

func (c *Controller) MonitorIncidents(ctx echo.Context) error {
	monitorID := ctx.Param("id")
	if monitorID == "" {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "missing monitor id"})
	}
	incidents, err := c.incidentRepo.RecentByMonitor(monitorID, 20)
	if err != nil {
		return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	return ctx.JSON(http.StatusOK, map[string]any{"ok": true, "incidents": incidents})
}

func (c *Controller) StatusPage(ctx echo.Context) error {
	rows, err := c.monitorRepo.EnabledStatusRowsOrderedByName()
	if err != nil {
		return ctx.JSON(http.StatusServiceUnavailable, map[string]any{"ok": false, "error": err.Error()})
	}
	latestByMonitor, err := c.monitorCheckRepo.LatestStatusByMonitor(5000)
	if err != nil {
		return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	for i := range rows {
		if check, ok := latestByMonitor[rows[i].ID]; ok {
			rows[i].LastStatus = normalizeLower(check.Status)
			checked := check.CheckedAt.UTC()
			rows[i].LastChecked = &checked
		}
	}

	latestIncidents, _ := c.incidentRepo.RecentOpenWithMonitor(6)

	grouped := map[string][]models.StatusPageService{
		"http":            {},
		"tcp":             {},
		"ping":            {},
		"dns":             {},
		"tls":             {},
		"http_keyword":    {},
		"http_json_query": {},
		"websocket":       {},
		"steam":           {},
		"docker":          {},
		"push":            {},
	}
	for _, it := range rows {
		t := normalizeLower(it.Type)
		if _, ok := grouped[t]; !ok {
			grouped[t] = []models.StatusPageService{}
		}
		grouped[t] = append(grouped[t], it)
	}
	for key := range grouped {
		sort.Slice(grouped[key], func(i, j int) bool {
			return strings.ToLower(grouped[key][i].Name) < strings.ToLower(grouped[key][j].Name)
		})
	}

	var lastUpdated *time.Time
	for i := range rows {
		if rows[i].LastChecked == nil {
			continue
		}
		if lastUpdated == nil || rows[i].LastChecked.After(*lastUpdated) {
			lastUpdated = rows[i].LastChecked
		}
	}

	return ctx.JSON(http.StatusOK, map[string]any{
		"ok":             true,
		"services":       rows,
		"grouped":        grouped,
		"latestIncident": latestIncidents,
		"lastUpdated":    lastUpdated,
	})
}

func monitorIDFromModel(m *models.Monitor) string {
	if m == nil {
		return ""
	}
	switch id := any(m.Id).(type) {
	case string:
		return id
	case null.String:
		return id.String
	default:
		return strings.TrimSpace(fmt.Sprint(id))
	}
}

{{- if .Components.Jobs }}
func (c *Controller) CheckNow(ctx echo.Context) error {
	monitorID := ctx.Param("id")
	if monitorID == "" {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "missing monitor id"})
	}
	if c.monitorCheck == nil {
		return ctx.JSON(http.StatusServiceUnavailable, map[string]any{"ok": false, "error": "monitor checks are not configured"})
	}

	syncRequested := normalizeLower(ctx.QueryParam("sync"))
	if syncRequested == "1" || syncRequested == "true" || syncRequested == "yes" {
		summary, err := c.monitorCheck.RunNow(ctx.Request().Context(), monitorID)
		if err != nil {
			return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
		}
		return ctx.JSON(http.StatusOK, map[string]any{
			"ok":                 true,
			"mode":               "sync",
			"monitor_id":         monitorID,
			"total":              summary.Total,
			"succeeded":          summary.Succeeded,
			"failed":             summary.Failed,
			"failed_monitor_ids": summary.FailedMonitorIDs,
		})
	}

	enqueued, err := c.monitorCheck.QueueNow(monitorID)
	if err != nil {
		return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	return ctx.JSON(http.StatusAccepted, map[string]any{
		"ok":         true,
		"mode":       "queued",
		"monitor_id": monitorID,
		"enqueued":   enqueued,
	})
}
{{- end }}
