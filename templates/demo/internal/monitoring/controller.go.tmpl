		web.NewRoute(http.MethodGet, "/monitoring/monitors/:id/dashboard", c.MonitorDashboard),
		web.NewRoute(http.MethodGet, "/monitoring/monitors/:id/favicon", c.MonitorFavicon),
		web.NewRoute(http.MethodGet, "/monitoring/monitors/:id/checks", c.MonitorChecks),
		web.NewRoute(http.MethodGet, "/monitoring/monitors/:id/incidents", c.MonitorIncidents),
		web.NewRoute(http.MethodPost, "/monitoring/monitors/:id/push", c.MonitorPush),
		web.NewRoute(http.MethodPost, "/monitoring/monitors", c.CreateMonitor),
		web.NewRoute(http.MethodPut, "/monitoring/monitors/:id", c.UpdateMonitor),
