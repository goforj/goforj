		http.NewRoute(http.MethodGet, "/monitoring/diagnostics/cadence", c.CadenceDiagnostics),
		http.NewRoute(http.MethodGet, "/monitoring/diagnostics/alerts", c.AlertDispatchDiagnostics),
		http.NewRoute(http.MethodGet, "/monitoring/monitors", c.Monitors),
		http.NewRoute(http.MethodDelete, "/monitoring/monitors/:id", c.DeleteMonitor),
		http.NewRoute(http.MethodGet, "/monitoring/incidents", c.Incidents),
		http.NewRoute(http.MethodGet, "/monitoring/heartbeats", c.Heartbeats),
		http.NewRoute(http.MethodGet, "/monitoring/monitors/:id", c.MonitorDetail),
		http.NewRoute(http.MethodGet, "/monitoring/monitors/:id/dashboard", c.MonitorDashboard),
		http.NewRoute(http.MethodGet, "/monitoring/monitors/:id/favicon", c.MonitorFavicon),
		http.NewRoute(http.MethodGet, "/monitoring/monitors/:id/checks", c.MonitorChecks),
		http.NewRoute(http.MethodGet, "/monitoring/monitors/:id/incidents", c.MonitorIncidents),
		http.NewRoute(http.MethodPost, "/monitoring/monitors/:id/push", c.MonitorPush),
		http.NewRoute(http.MethodPost, "/monitoring/monitors", c.CreateMonitor),
		http.NewRoute(http.MethodPut, "/monitoring/monitors/:id", c.UpdateMonitor),
		http.NewRoute(http.MethodPatch, "/monitoring/monitors/:id/enabled", c.SetMonitorEnabled),
		http.NewRoute(http.MethodGet, "/monitoring/status-page", c.StatusPage),
