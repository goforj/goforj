type Controller struct {
	logger           *logger.AppLogger
	db               *database.Connections
	monitorRepo      *models.MonitorRepo
	monitorCheckRepo *models.MonitorCheckRepo
	incidentRepo     *models.IncidentRepo
	incidentTransitions *IncidentTransitionService
	channelRepo      *notification.ChannelRepo
	appSettingRepo   *appsettings.AppSettingRepo
	alertDispatchEventRepo *models.AlertDispatchEventRepo
	eventBus         events.Bus
	{{- if .Components.Jobs }}
	monitorCheck  *MonitorCheckJob
	alertDispatch *alerts.DispatchJob
	{{- end }}
}

const monitorPushStreakScanLimit = 12

func normalizeLower(value string) string {
	return str.Of(value).TrimSpace().ToLower().String()
}

func normalizeTrim(value string) string {
	return str.Of(value).TrimSpace().String()
}

func normalizeUpper(value string) string {
	return str.Of(value).TrimSpace().ToUpper().String()
}

func NewController(
	logger *logger.AppLogger,
	db *database.Connections,
	monitorRepo *models.MonitorRepo,
	monitorCheckRepo *models.MonitorCheckRepo,
	incidentRepo *models.IncidentRepo,
	incidentTransitions *IncidentTransitionService,
	channelRepo *notification.ChannelRepo,
	appSettingRepo *appsettings.AppSettingRepo,
	alertDispatchEventRepo *models.AlertDispatchEventRepo,
	eventBus events.Bus,
	{{- if .Components.Jobs }}
	monitorCheck *MonitorCheckJob,
	alertDispatch *alerts.DispatchJob,
	{{- end }}
) *Controller {
	c := &Controller{
		logger:           logger,
		db:               db,
		monitorRepo:      monitorRepo,
		monitorCheckRepo: monitorCheckRepo,
		incidentRepo:     incidentRepo,
		incidentTransitions: incidentTransitions,
		channelRepo:      channelRepo,
		appSettingRepo:   appSettingRepo,
		alertDispatchEventRepo: alertDispatchEventRepo,
		eventBus:         eventBus,
		{{- if .Components.Jobs }}
		monitorCheck:  monitorCheck,
		alertDispatch: alertDispatch,
		{{- end }}
	}
	backfillDone := false
	if appSettingRepo != nil {
		doneValue, err := appSettingRepo.GetValue(appsettings.SettingMonitoringTargetBackfillDone, "")
		if err != nil {
			logger.Warn().Err(err).Msg("monitor target normalization backfill marker read failed")
		} else {
			backfillDone = normalizeLower(doneValue) == "1" || normalizeLower(doneValue) == "true"
		}
	}
	if monitorRepo != nil && !backfillDone {
		if updated, err := monitorRepo.BackfillNormalizedTargets(10000); err != nil {
			logger.Warn().Err(err).Msg("monitor target normalization backfill failed")
		} else {
			if updated > 0 {
				logger.Info().Int("updated", updated).Msg("monitor target normalization backfill complete")
			}
			if appSettingRepo != nil {
				if err := appSettingRepo.Upsert(appsettings.SettingMonitoringTargetBackfillDone, "1"); err != nil {
					logger.Warn().Err(err).Msg("monitor target normalization backfill marker write failed")
				}
			}
		}
	}
	return c
}

