func (c *Controller) CheckNow(r web.Context) error {
	monitorID := r.Param("id")
	if monitorID == "" {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "missing monitor id"})
	}
	if c.monitorCheck == nil {
		return r.JSON(http.StatusServiceUnavailable, map[string]any{"ok": false, "error": "monitor checks are not configured"})
	}
	monitor, err := c.monitorRepo.WithContext(r.Context()).ByID(monitorID)
	if err != nil {
		return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	if monitor == nil || monitorIDFromModel(monitor) == "" {
		return r.JSON(http.StatusNotFound, map[string]any{"ok": false, "error": "monitor not found"})
	}

	syncRequested := normalizeLower(r.Query("sync"))
	if syncRequested == "1" || syncRequested == "true" || syncRequested == "yes" {
		summary, err := c.monitorCheck.RunNow(r.Context(), monitorID)
		if err != nil {
			return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
		}
		return r.JSON(http.StatusOK, map[string]any{
			"ok":                 true,
			"mode":               "sync",
			"monitor_id":         monitorID,
			"total":              summary.Total,
			"succeeded":          summary.Succeeded,
			"failed":             summary.Failed,
			"failed_monitor_ids": summary.FailedMonitorIDs,
		})
	}

	enqueued, err := c.monitorCheck.QueueNow(r.Context(), monitorID)
	if err != nil {
		return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	return r.JSON(http.StatusAccepted, map[string]any{
		"ok":         true,
		"mode":       "queued",
		"monitor_id": monitorID,
		"enqueued":   enqueued,
	})
}
{{- end }}
