		web.NewRoute(http.MethodGet, "/monitoring/monitors/sidebar", c.SidebarMonitors),
		web.NewRoute(http.MethodDelete, "/monitoring/monitors/:id", c.DeleteMonitor),
		web.NewRoute(http.MethodGet, "/monitoring/incidents", c.Incidents),
		web.NewRoute(http.MethodGet, "/monitoring/heartbeats", c.Heartbeats),
