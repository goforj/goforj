func monitorRangeSince(rangeKey string) time.Time {
	return time.Now().UTC().Add(-monitorRangeDuration(rangeKey))
}

func monitorRangeDuration(rangeKey string) time.Duration {
	switch normalizeLower(rangeKey) {
	case "15m":
		return 15 * time.Minute
	case "1h":
		return 1 * time.Hour
	case "3h":
		return 3 * time.Hour
	case "6h":
		return 6 * time.Hour
	case "12h":
		return 12 * time.Hour
	case "30d":
		return 30 * 24 * time.Hour
	case "7d":
		return 7 * 24 * time.Hour
	default:
		return 24 * time.Hour
	}
}

func monitorCheckFetchLimit(rangeKey string, intervalSeconds int) int {
	if intervalSeconds <= 0 {
		intervalSeconds = 60
	}
	// Keep enough rows for the selected range with headroom for retries/duplicates.
	expected := int(monitorRangeDuration(rangeKey).Seconds()) / intervalSeconds
	if expected < 500 {
		expected = 500
	}
	expected = int(float64(expected) * 1.5)
	if expected < 500 {
		expected = 500
	}
	if expected > 25000 {
		expected = 25000
	}
	return expected
}

func (c *Controller) loadMonitorChecks(monitorID, rangeKey string) ([]models.MonitorCheckView, map[string]any, error) {
	monitor, err := c.monitorRepo.ByID(monitorID)
	if err != nil {
		return nil, nil, fmt.Errorf("monitor not found")
	}

	since := monitorRangeSince(rangeKey)
	limit := monitorCheckFetchLimit(rangeKey, monitor.IntervalSeconds)
	checks, err := c.monitorCheckRepo.ByMonitorSinceView(monitorID, since, limit)
	if err != nil {
		return nil, nil, err
	}

	interval := monitor.IntervalSeconds
	if interval <= 0 {
		interval = 60
	}
	if !monitor.Enabled && len(checks) > 0 && strings.EqualFold(checks[0].Status, "paused") {
		now := time.Now().UTC()
		latestPausedAt := checks[0].CheckedAt.UTC()
		synth := make([]models.MonitorCheckView, 0, 64)
		for ts := now; ts.After(latestPausedAt); ts = ts.Add(-time.Duration(interval) * time.Second) {
			synth = append(synth, models.MonitorCheckView{
				ID:         0,
				CheckedAt:  ts,
				Status:     "paused",
				StatusCode: 0,
				DurationMS: 0,
				ErrorText:  "",
			})
		}
		if len(synth) > 0 {
			checks = append(synth, checks...)
		}
	}

	durations := make([]int, 0, len(checks))
	completedChecks := 0
	upCount := 0
	for _, it := range checks {
		status := normalizeLower(it.Status)
		if status != "up" && status != "down" {
			continue
		}
		completedChecks++
		if it.DurationMS > 0 {
			durations = append(durations, it.DurationMS)
		}
		if status == "up" {
			upCount++
		}
	}
	sort.Ints(durations)
	percentile := func(p float64) int {
		if len(durations) == 0 {
			return 0
		}
		idx := int(float64(len(durations)-1) * p)
		if idx < 0 {
			idx = 0
		}
		if idx >= len(durations) {
			idx = len(durations) - 1
		}
		return durations[idx]
	}
	uptimePct := 0.0
	if completedChecks > 0 {
		uptimePct = (float64(upCount) / float64(completedChecks)) * 100
	}

	stats := map[string]any{
		"sample_count": completedChecks,
		"uptime_pct":   uptimePct,
		"p50_ms":       percentile(0.50),
		"p95_ms":       percentile(0.95),
	}

	return checks, stats, nil
}

func parseMonitoringRange(raw string) time.Duration {
	switch normalizeLower(raw) {
	case "1h":
		return 1 * time.Hour
	case "3h":
		return 3 * time.Hour
	case "6h":
		return 6 * time.Hour
	case "12h":
		return 12 * time.Hour
	case "7d":
		return 7 * 24 * time.Hour
	case "30d":
		return 30 * 24 * time.Hour
	default:
		return 24 * time.Hour
	}
}

func (c *Controller) AlertDispatchDiagnostics(ctx echo.Context) error {
	if c.alertDispatchEventRepo == nil {
		return ctx.JSON(http.StatusServiceUnavailable, map[string]any{"ok": false, "error": "alert dispatch event repo not configured"})
	}
	limit := 100
	if raw := normalizeTrim(ctx.QueryParam("limit")); raw != "" {
		if parsed, err := strconv.Atoi(raw); err == nil && parsed > 0 {
			limit = parsed
		}
	}
	monitorID := normalizeTrim(ctx.QueryParam("monitor_id"))
	window := parseMonitoringRange(ctx.QueryParam("range"))
	since := time.Now().UTC().Add(-window)
	rows, err := c.alertDispatchEventRepo.Recent(limit, monitorID, since)
	if err != nil {
		return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	return ctx.JSON(http.StatusOK, map[string]any{
		"ok":     true,
		"events": rows,
	})
}

func (c *Controller) CadenceDiagnostics(ctx echo.Context) error {
	monitorID := normalizeTrim(ctx.QueryParam("monitor_id"))
	window := parseMonitoringRange(ctx.QueryParam("range"))
	now := time.Now().UTC()
	since := now.Add(-window)
	monitors := make([]models.Monitor, 0)
	if monitorID != "" {
		monitor, err := c.monitorRepo.ByID(monitorID)
		if err == nil && monitor != nil {
			monitors = append(monitors, *monitor)
		}
	} else {
		allMonitors, err := c.monitorRepo.AllOrderedByName()
		if err != nil {
			return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
		}
		monitors = allMonitors
	}

	if len(monitors) == 0 {
		return ctx.JSON(http.StatusOK, map[string]any{
			"ok":       true,
			"window":   normalizeLower(ctx.QueryParam("range")),
			"monitors": []any{},
		})
	}

	checkRows, err := c.monitorCheckRepo.Since(since, 20000)
	if err != nil {
		return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}

	byMonitor := map[string][]time.Time{}
	for _, row := range checkRows {
		rowMonitorID := strconv.FormatInt(row.MonitorId, 10)
		if monitorID != "" && rowMonitorID != monitorID {
			continue
		}
		status := normalizeLower(row.Status)
		if status != "up" && status != "down" {
			// Cadence diagnostics track terminal poll outcomes only.
			// Excluding transient rows (pending/paused/unknown) avoids
			// duplicate/missed inflation from retries and state markers.
			continue
		}
		byMonitor[rowMonitorID] = append(byMonitor[rowMonitorID], row.CheckedAt.UTC())
	}

	type cadence struct {
		MonitorID       string     `json:"monitor_id"`
		Name            string     `json:"name"`
		IntervalSeconds int        `json:"interval_seconds"`
		ToleranceSec    int        `json:"tolerance_sec"`
		Samples         int        `json:"samples"`
		DeltaSamples    int        `json:"delta_samples"`
		DeltaMinSec     int        `json:"delta_min_sec"`
		DeltaP50Sec     int        `json:"delta_p50_sec"`
		DeltaP95Sec     int        `json:"delta_p95_sec"`
		DeltaMaxSec     int        `json:"delta_max_sec"`
		OnTimeCount     int        `json:"on_time_count"`
		MissedCount     int        `json:"missed_count"`
		DuplicateCount  int        `json:"duplicate_count"`
		LastCheckedAt   *time.Time `json:"last_checked_at,omitempty"`
		FreshnessSec    int        `json:"freshness_sec"`
	}

	percentile := func(values []int, p float64) int {
		if len(values) == 0 {
			return 0
		}
		idx := int(float64(len(values)-1) * p)
		if idx < 0 {
			idx = 0
		}
		if idx >= len(values) {
			idx = len(values) - 1
		}
		return values[idx]
	}

	out := make([]cadence, 0, len(monitors))
		for _, mon := range monitors {
			monitorPrimaryID := strconv.FormatInt(mon.Id, 10)
		interval := mon.IntervalSeconds
		if interval <= 0 {
			interval = 60
		}
		tolerance := interval / 3
		if tolerance < 10 {
			tolerance = 10
		}
		if tolerance > 30 {
			tolerance = 30
		}

		times := byMonitor[monitorPrimaryID]
		if len(times) > 1 {
			sort.Slice(times, func(i, j int) bool {
				return times[i].Before(times[j])
			})
		}
		deltas := make([]int, 0, len(times))
		onTime := 0
		missed := 0
		dupes := 0

		for i := 1; i < len(times); i++ {
			delta := int(times[i].Sub(times[i-1]).Seconds())
			if delta < 0 {
				continue
			}
			deltas = append(deltas, delta)
			if delta < maxInt(1, interval/4) {
				dupes++
				continue
			}
			if delta > interval+tolerance {
				missed++
				continue
			}
			if delta >= maxInt(1, interval-tolerance) {
				onTime++
			}
		}

		sort.Ints(deltas)
			item := cadence{
				MonitorID:       monitorPrimaryID,
			Name:            mon.Name,
			IntervalSeconds: interval,
			ToleranceSec:    tolerance,
			Samples:         len(times),
			DeltaSamples:    len(deltas),
			DeltaMinSec:     0,
			DeltaP50Sec:     percentile(deltas, 0.50),
			DeltaP95Sec:     percentile(deltas, 0.95),
			DeltaMaxSec:     0,
			OnTimeCount:     onTime,
			MissedCount:     missed,
			DuplicateCount:  dupes,
			FreshnessSec:    0,
		}
		if len(deltas) > 0 {
			item.DeltaMinSec = deltas[0]
			item.DeltaMaxSec = deltas[len(deltas)-1]
		}
		if len(times) > 0 {
			last := times[len(times)-1]
			item.LastCheckedAt = &last
			age := int(now.Sub(last).Seconds())
			if age < 0 {
				age = 0
			}
			item.FreshnessSec = age
		}
		out = append(out, item)
	}

	return ctx.JSON(http.StatusOK, map[string]any{
		"ok":       true,
		"range":    normalizeLower(ctx.QueryParam("range")),
		"window_s": int(window.Seconds()),
		"monitors": out,
	})
}

func maxInt(a, b int) int {
	if a > b {
		return a
	}
	return b
}

