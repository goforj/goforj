type monitorStreamEnvelope struct {
	Type       string `json:"type"`
	MonitorID  string `json:"monitor_id"`
	MonitorName string `json:"monitor_name,omitempty"`
	MonitorType string `json:"monitor_type,omitempty"`
	Target     string `json:"target,omitempty"`
	Phase      string `json:"phase,omitempty"`
	Status     string `json:"status,omitempty"`
	IncidentID string `json:"incident_id,omitempty"`
	Summary    string `json:"summary,omitempty"`
	ErrorClass string `json:"error_class,omitempty"`
	ErrorMessage string `json:"error_message,omitempty"`
	DurationMs int64  `json:"duration_ms,omitempty"`
	CheckedAt  string `json:"checked_at,omitempty"`
}

type monitorTransition struct {
	Event        string
	MonitorID    string
	MonitorName  string
	MonitorType  string
	Target       string
	Status       string
	IncidentID   string
	Summary      string
	ErrorMessage string
	DurationMs   int64
	CheckedAt    time.Time
	ChannelIDs   []int64
}

func (c *Controller) MonitorStream(r web.Context, conn web.WebSocketConn) error {
	defer conn.Close()

	var writeMu sync.Mutex
	write := func(payload monitorStreamEnvelope) error {
		writeMu.Lock()
		defer writeMu.Unlock()
		return conn.WriteJSON(payload)
	}

	ctx, cancel := stdcontext.WithCancel(app.WithSource(r.Context(), app.SourceHTTP))
	defer cancel()

	if err := write(monitorStreamEnvelope{Type: "monitor.stream.ready"}); err != nil {
		return nil
	}

	now := time.Now().UTC()
	globalMaintenance := c.monitoringMaintenanceWindow(ctx, now)
	if globalMaintenance.Active && globalMaintenance.EndsAt != nil {
		maintenanceEndsAt := globalMaintenance.EndsAt.UTC()
		go func() {
			timer := time.NewTimer(time.Until(maintenanceEndsAt))
			defer timer.Stop()
			select {
			case <-ctx.Done():
				return
			case <-timer.C:
				_ = write(monitorStreamEnvelope{
					Type:      "monitor.maintenance",
					Status:    "inactive",
					CheckedAt: maintenanceEndsAt.Format(time.RFC3339),
				})
			}
		}()
	}

	subscribe := func(topic string, register func(stdcontext.Context) error) error {
		if err := register(ctx); err != nil {
			c.logger.Warn().Err(err).Str("topic", topic).Msg("monitor stream subscription failed")
			_ = write(monitorStreamEnvelope{Type: "monitor.stream.error", ErrorMessage: err.Error()})
			return err
		}
		return nil
	}

	var downSub io.Closer
	err := subscribe(events.MonitorStatusChangedTopic, func(subscribeCtx stdcontext.Context) error {
		sub, err := c.events.Default().WithContext(subscribeCtx).Subscribe(func(_ stdcontext.Context, payload events.MonitorStatusChanged) error {
			envelopeType := events.MonitorDownTopic
			if normalizeLower(payload.Status) == "up" {
				envelopeType = events.MonitorRecoveredTopic
			}
			return write(monitorStreamEnvelope{
				Type:         envelopeType,
				MonitorID:    payload.MonitorID,
				MonitorName:  payload.MonitorName,
				MonitorType:  payload.MonitorType,
				Target:       payload.Target,
				Status:       payload.Status,
				IncidentID:   payload.IncidentID,
				Summary:      payload.Summary,
				ErrorClass:   payload.ErrorClass,
				ErrorMessage: payload.ErrorMessage,
				DurationMs:   payload.DurationMs,
				CheckedAt:    payload.CheckedAt,
			})
		})
		if err != nil {
			return err
		}
		downSub = sub
		return nil
	})
	if err != nil {
		return nil
	}
	defer downSub.Close()

	var pollingSub io.Closer
	err = subscribe(events.MonitorPollingTopic, func(subscribeCtx stdcontext.Context) error {
		sub, err := c.events.Default().WithContext(subscribeCtx).Subscribe(func(_ stdcontext.Context, payload events.MonitorPolling) error {
			return write(monitorStreamEnvelope{
				Type:        events.MonitorPollingTopic,
				MonitorID:   payload.MonitorID,
				MonitorName: payload.MonitorName,
				MonitorType: payload.MonitorType,
				Target:      payload.Target,
				Phase:       payload.Phase,
				CheckedAt:   payload.CheckedAt,
			})
		})
		if err != nil {
			return err
		}
		pollingSub = sub
		return nil
	})
	if err != nil {
		return nil
	}
	defer pollingSub.Close()

	for {
		var discard map[string]any
		if err := conn.ReadJSON(&discard); err != nil {
			return nil
		}
	}
}

func (c *Controller) Summary(r web.Context) error {
	monitors, err := c.monitorRepo.WithContext(r.Context()).All()
	if err != nil {
		return r.JSON(http.StatusServiceUnavailable, map[string]any{"ok": false, "error": err.Error()})
	}
	latestChecks, err := c.monitorCheckRepo.WithContext(r.Context()).LatestDisplayStatusByMonitor(5000)
	if err != nil {
		return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}

	var total, up, down, paused, pending int64
	total = int64(len(monitors))
	now := time.Now().UTC()
	globalMaintenance := c.monitoringMaintenanceWindow(r.Context(), now)
	for _, m := range monitors {
		if !m.Enabled {
			paused++
			continue
		}
		if maintenanceActive(globalMaintenance, m.MaintenanceStartsAt, m.MaintenanceEndsAt, now) {
			paused++
			continue
		}
		check, ok := latestChecks[strconv.FormatInt(m.Id, 10)]
		status := ""
		if ok {
			status = normalizeLower(check.Status)
		}
		switch status {
		case "up":
			up++
		case "pending":
			pending++
		default:
			down++
		}
	}

	since := time.Now().UTC().Add(-1 * time.Hour)
	checksLastHour, _ := c.monitorCheckRepo.WithContext(r.Context()).CountSince(since)

	incidentsOpen, _ := c.incidentRepo.WithContext(r.Context()).CountOpen()

	payload := map[string]any{
		"ok": true,
		"meta": map[string]any{
			"source":      "demo-app",
			"generatedAt": time.Now().UTC().Format(time.RFC3339),
		},
		"maintenance": map[string]any{
			"active":    globalMaintenance.Active,
			"starts_at": nullableTimeString(globalMaintenance.StartsAt),
			"ends_at":   nullableTimeString(globalMaintenance.EndsAt),
		},
		"stats": map[string]any{
			"monitors_total":   total,
			"monitors_up":      up,
			"monitors_down":    down,
			"monitors_pending": pending,
			"monitors_paused":  paused,
			"incidents_open":   incidentsOpen,
			"checks_last_hour": checksLastHour,
		},
	}
	c.logger.WithContext(r.Context()).
		Info().
		Int64("monitors_total", total).
		Int64("monitors_up", up).
		Int64("monitors_down", down).
		Int64("monitors_pending", pending).
		Int64("monitors_paused", paused).
		Int64("incidents_open", incidentsOpen).
		Int64("checks_last_hour", checksLastHour).
		Bool("maintenance_active", globalMaintenance.Active).
		Msg("monitoring summary loaded")
	return r.JSON(http.StatusOK, payload)
}

func (c *Controller) Monitors(r web.Context) error {
	monitors, err := c.loadMonitorItems(
		r.Context(),
		normalizeLower(r.Query("q")),
		normalizeLower(r.Query("type")),
		normalizeLower(r.Query("state")),
	)
	if err != nil {
		return r.JSON(http.StatusServiceUnavailable, map[string]any{"ok": false, "error": err.Error()})
	}

	return r.JSON(http.StatusOK, map[string]any{
		"ok":       true,
		"monitors": monitors,
	})
}

func (c *Controller) SidebarMonitors(r web.Context) error {
	q := strings.ToLower(normalizeTrim(r.Query("q")))
	state := normalizeLower(r.Query("state"))
	offset := 0
	if raw := normalizeTrim(r.Query("offset")); raw != "" {
		if parsed, parseErr := strconv.Atoi(raw); parseErr == nil && parsed >= 0 {
			offset = parsed
		}
	}
	limit := 200
	if raw := normalizeTrim(r.Query("limit")); raw != "" {
		if parsed, parseErr := strconv.Atoi(raw); parseErr == nil && parsed > 0 {
			limit = parsed
		}
	}
	if limit > 250 {
		limit = 250
	}

	monitors, hasMore, nextOffset, err := c.loadSidebarMonitorItems(r.Context(), q, state, offset, limit)
	if err != nil {
		return r.JSON(http.StatusServiceUnavailable, map[string]any{"ok": false, "error": err.Error()})
	}
	return r.JSON(http.StatusOK, map[string]any{
		"ok":          true,
		"monitors":    monitors,
		"offset":      offset,
		"limit":       limit,
		"has_more":    hasMore,
		"next_offset": nextOffset,
	})
}

func (c *Controller) loadMonitorItems(ctx stdcontext.Context, q, typ, state string) ([]models.MonitorListItem, error) {
	monitors, err := c.monitorRepo.WithContext(ctx).ListItemsOrderedByName()
	if err != nil {
		return nil, err
	}

	latestByMonitor, err := c.monitorCheckRepo.WithContext(ctx).LatestDisplayStatusByMonitor(5000)
	if err != nil {
		return nil, err
	}
	now := time.Now().UTC()
	globalMaintenance := c.monitoringMaintenanceWindow(ctx, now)
	for i := range monitors {
		if row, ok := latestByMonitor[monitors[i].ID]; ok {
			monitors[i].LastStatus = normalizeLower(row.Status)
			checkedAt := row.CheckedAt.UTC()
			monitors[i].LastCheckedAt = &checkedAt
		}
		monitors[i].MaintenanceActive = maintenanceActive(globalMaintenance, monitors[i].MaintenanceStartsAt, monitors[i].MaintenanceEndsAt, now)
		if monitors[i].MaintenanceActive {
			monitors[i].LastStatus = "maintenance"
			if globalMaintenance.Active && !models.MaintenanceActiveAt(monitors[i].MaintenanceStartsAt, monitors[i].MaintenanceEndsAt, now) {
				monitors[i].MaintenanceStartsAt = globalMaintenance.StartsAt
				monitors[i].MaintenanceEndsAt = globalMaintenance.EndsAt
			}
		}
	}

	since := time.Now().UTC().Add(-24 * time.Hour)
	byMonitor, _ := c.monitorCheckRepo.WithContext(ctx).UptimeByMonitorSince(since, 10000)
	for i := range monitors {
		row, ok := byMonitor[monitors[i].ID]
		if !ok || row.Total == 0 {
			monitors[i].Uptime24h = 0
			continue
		}
		monitors[i].Uptime24h = (float64(row.UpCount) / float64(row.Total)) * 100
	}
	if q != "" || typ != "" || state != "" {
		filtered := make([]models.MonitorListItem, 0, len(monitors))
		for _, m := range monitors {
			if q != "" {
				joined := strings.ToLower(m.Name + " " + m.Target)
				if !strings.Contains(joined, q) {
					continue
				}
			}
			if typ != "" && strings.ToLower(m.Type) != typ {
				continue
			}
			lastStatus := normalizeLower(m.LastStatus)
			if state == "up" && (!m.Enabled || lastStatus != "up") {
				continue
			}
			if state == "down" && (!m.Enabled || lastStatus == "up" || lastStatus == "maintenance") {
				continue
			}
			if state == "paused" && m.Enabled && lastStatus != "maintenance" {
				continue
			}
			filtered = append(filtered, m)
		}
		monitors = filtered
	}

	return monitors, nil
}

func (c *Controller) loadSidebarMonitorItems(ctx stdcontext.Context, q, state string, offset, limit int) ([]models.MonitorSidebarItem, bool, int, error) {
	loadAll := q != "" || state != ""
	queryOffset := offset
	queryLimit := limit + 1
	if loadAll {
		queryOffset = 0
		queryLimit = 100000
	}
	monitors, err := c.monitorRepo.WithContext(ctx).SidebarItemsOrderedByName(queryOffset, queryLimit)
	if err != nil {
		return nil, false, offset, err
	}
	ids := make([]string, 0, len(monitors))
	for i := range monitors {
		ids = append(ids, monitors[i].ID)
	}
	latestByMonitor, err := c.monitorCheckRepo.WithContext(ctx).LatestByMonitorIDs(ids, 1)
	if err != nil {
		return nil, false, offset, err
	}
	now := time.Now().UTC()
	globalMaintenance := c.monitoringMaintenanceWindow(ctx, now)
	for i := range monitors {
		if rows := latestByMonitor[monitors[i].ID]; len(rows) > 0 {
			monitors[i].LastStatus = normalizeLower(rows[0].Status)
		}
		monitors[i].MaintenanceActive = maintenanceActive(globalMaintenance, monitors[i].MaintenanceStartsAt, monitors[i].MaintenanceEndsAt, now)
		if monitors[i].MaintenanceActive {
			monitors[i].LastStatus = "maintenance"
			if globalMaintenance.Active && !models.MaintenanceActiveAt(monitors[i].MaintenanceStartsAt, monitors[i].MaintenanceEndsAt, now) {
				monitors[i].MaintenanceStartsAt = globalMaintenance.StartsAt
				monitors[i].MaintenanceEndsAt = globalMaintenance.EndsAt
			}
		}
	}
	if q != "" || state != "" {
		filtered := make([]models.MonitorSidebarItem, 0, len(monitors))
		for _, m := range monitors {
			if q != "" {
				joined := strings.ToLower(m.Name + " " + m.TargetDisplay)
				if !strings.Contains(joined, q) {
					continue
				}
			}
			lastStatus := normalizeLower(m.LastStatus)
			if state == "up" && (!m.Enabled || lastStatus != "up") {
				continue
			}
			if state == "down" && (!m.Enabled || lastStatus == "up" || lastStatus == "maintenance") {
				continue
			}
			if state == "paused" && m.Enabled && lastStatus != "maintenance" {
				continue
			}
			filtered = append(filtered, m)
		}
		monitors = filtered
	}
	hasMore := false
	nextOffset := offset
	if loadAll {
		if offset >= len(monitors) {
			monitors = monitors[:0]
		} else {
			end := minInt(offset+limit, len(monitors))
			hasMore = end < len(monitors)
			monitors = monitors[offset:end]
			nextOffset = offset + len(monitors)
		}
	} else if len(monitors) > limit {
		hasMore = true
		monitors = monitors[:limit]
		nextOffset = offset + len(monitors)
	}
	return monitors, hasMore, nextOffset, nil
}

func minInt(a, b int) int {
	if a < b {
		return a
	}
	return b
}

func (c *Controller) Incidents(r web.Context) error {
	incidents, err := c.incidentRepo.WithContext(r.Context()).RecentWithMonitor(300)
	if err != nil {
		return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	state := normalizeLower(r.Query("state"))
	if state == "open" || state == "resolved" {
		filtered := make([]models.IncidentWithMonitor, 0, len(incidents))
		for _, it := range incidents {
			if state == "open" && it.ResolvedAt == nil {
				filtered = append(filtered, it)
			}
			if state == "resolved" && it.ResolvedAt != nil {
				filtered = append(filtered, it)
			}
		}
		incidents = filtered
	}

	incidentChannels := map[string][]map[string]any{}
	if c.alertDispatchEventRepo != nil && len(incidents) > 0 {
		incidentIDs := make([]string, 0, len(incidents))
		for _, it := range incidents {
			id := normalizeTrim(it.ID)
			if id == "" {
				continue
			}
			incidentIDs = append(incidentIDs, id)
		}
		rows, rowsErr := c.alertDispatchEventRepo.WithContext(r.Context()).DeliveryRowsByIncidentIDs(incidentIDs, 2000)
		if rowsErr == nil {
			seen := map[string]struct{}{}
			for _, row := range rows {
				incidentID := normalizeTrim(row.IncidentID)
				if incidentID == "" {
					continue
				}
				delivery := normalizeTrim(row.Delivery)
				if delivery == "" {
					delivery = "sent"
				}
				key := fmt.Sprintf("%s|%d|%s|%s", incidentID, row.ChannelID, normalizeLower(row.Provider), normalizeLower(delivery))
				if _, exists := seen[key]; exists {
					continue
				}
				seen[key] = struct{}{}
				incidentChannels[incidentID] = append(incidentChannels[incidentID], map[string]any{
					"channel_id":   row.ChannelID,
					"channel_name": row.ChannelName,
					"provider":     row.Provider,
					"delivery":     delivery,
					"created_at":   row.CreatedAt.UTC(),
				})
			}
		}
	}

	return r.JSON(http.StatusOK, map[string]any{
		"ok":                true,
		"incidents":         incidents,
		"incident_channels": incidentChannels,
	})
}

type heartbeatPoint struct {
	Status    string     `json:"status"`
	CheckedAt *time.Time `json:"checked_at,omitempty"`
	LatencyMS *int64     `json:"latency_ms,omitempty"`
}

type heartbeatSlotRequest struct {
	History             []models.HeartbeatRow
	Now                 time.Time
	Interval            int
	Limit               int
	Enabled             bool
	MaintenanceStartsAt *time.Time
	MaintenanceEndsAt   *time.Time
	GlobalMaintenanceStartsAt *time.Time
	GlobalMaintenanceEndsAt   *time.Time
}

func buildHeartbeatSlots(req heartbeatSlotRequest) ([]string, []heartbeatPoint) {
	if req.Interval <= 0 {
		req.Interval = 60
	}
	if req.Limit <= 0 {
		req.Limit = 12
	}

	statuses := make([]string, req.Limit) // index 0 = newest
	for i := range statuses {
		statuses[i] = "unknown"
	}
	points := make([]*heartbeatPoint, req.Limit) // index 0 = newest

	nowUTC := req.Now.UTC()
	nowSlot := nowUTC.Unix() / int64(req.Interval)

	for _, check := range req.History {
		checkSlot := check.CheckedAt.UTC().Unix() / int64(req.Interval)
		slotIdx := int(nowSlot - checkSlot)

		if slotIdx < 0 || slotIdx >= req.Limit {
			continue
		}
		if statuses[slotIdx] != "unknown" {
			continue
		}
		status := normalizeLower(check.Status)
		if status == "" {
			status = "unknown"
		}
		statuses[slotIdx] = status
		checkedAt := check.CheckedAt.UTC()
		duration := check.DurationMS
		points[slotIdx] = &heartbeatPoint{
			Status:    status,
			CheckedAt: &checkedAt,
			LatencyMS: &duration,
		}
	}

	// Preserve "pending" only while a monitor is transitioning away from a
	// newer healthy state. Once a newer confirmed down result exists, older
	// pending buckets in that same run should render as down too.
	newerDisplayStatus := ""
	for idx := 0; idx < req.Limit; idx++ {
		switch statuses[idx] {
		case "down", "up", "paused", "maintenance":
			newerDisplayStatus = statuses[idx]
		case "pending":
			if newerDisplayStatus == "down" {
				statuses[idx] = "down"
				if points[idx] != nil {
					points[idx].Status = "down"
				}
			}
		}
	}

	// If currently paused, extrapolate paused buckets from the latest persisted pause marker.
	if !req.Enabled && len(req.History) > 0 && strings.EqualFold(req.History[0].Status, "paused") {
		pausedAgeSec := nowUTC.Sub(req.History[0].CheckedAt.UTC()).Seconds()
		if pausedAgeSec >= 0 {
			maxPausedIdx := int(pausedAgeSec / float64(req.Interval))
			if maxPausedIdx >= req.Limit {
				maxPausedIdx = req.Limit - 1
			}
			for idx := 0; idx <= maxPausedIdx; idx++ {
				if statuses[idx] == "unknown" {
					statuses[idx] = "paused"
					slotTime := nowUTC.Add(-time.Duration(idx*req.Interval) * time.Second)
					duration := int64(0)
					points[idx] = &heartbeatPoint{
						Status:    "paused",
						CheckedAt: &slotTime,
						LatencyMS: &duration,
					}
				}
			}
		}
	}

	if req.Enabled {
		windowStart, _, maintenanceActiveNow := effectiveMaintenanceWindow(
			appsettings.MonitoringMaintenanceWindow{
				StartsAt: req.GlobalMaintenanceStartsAt,
				EndsAt:   req.GlobalMaintenanceEndsAt,
				Active:   monitoringWindowActive(req.GlobalMaintenanceStartsAt, req.GlobalMaintenanceEndsAt, nowUTC),
			},
			req.MaintenanceStartsAt,
			req.MaintenanceEndsAt,
			nowUTC,
		)
		if maintenanceActiveNow && windowStart != nil {
		maintenanceAgeSec := nowUTC.Sub(windowStart.UTC()).Seconds()
		if maintenanceAgeSec >= 0 {
			maxMaintenanceIdx := int(maintenanceAgeSec / float64(req.Interval))
			if maxMaintenanceIdx >= req.Limit {
				maxMaintenanceIdx = req.Limit - 1
			}
			for idx := 0; idx <= maxMaintenanceIdx; idx++ {
				statuses[idx] = "maintenance"
				slotTime := nowUTC.Add(-time.Duration(idx*req.Interval) * time.Second)
				duration := int64(0)
				points[idx] = &heartbeatPoint{
					Status:    "maintenance",
					CheckedAt: &slotTime,
					LatencyMS: &duration,
				}
			}
		}
	}
	}

	orderedStatuses := make([]string, 0, req.Limit)
	orderedPoints := make([]heartbeatPoint, 0, req.Limit)
	for i := req.Limit - 1; i >= 0; i-- {
		orderedStatuses = append(orderedStatuses, statuses[i])
		if points[i] != nil {
			orderedPoints = append(orderedPoints, *points[i])
		} else {
			orderedPoints = append(orderedPoints, heartbeatPoint{Status: statuses[i]})
		}
	}

	return orderedStatuses, orderedPoints
}

func (c *Controller) Heartbeats(r web.Context) error {
	limit := 12
	if raw := normalizeTrim(r.Query("limit")); raw != "" {
		var parsed int
		if _, parseErr := fmt.Sscanf(raw, "%d", &parsed); parseErr == nil && parsed > 0 && parsed <= 60 {
			limit = parsed
		}
	}

	monitorIDs := parseMonitorIDList(r.Query("ids"))
	heartbeats, heartbeatPoints, err := c.loadHeartbeatPayloadForMonitorIDs(r.Context(), limit, monitorIDs)
	if err != nil {
		return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}

	return r.JSON(http.StatusOK, map[string]any{
		"ok":               true,
		"limit":            limit,
		"heartbeats":       heartbeats,
		"heartbeat_points": heartbeatPoints,
	})
}

func parseMonitorIDList(raw string) []string {
	parts := strings.Split(strings.TrimSpace(raw), ",")
	ids := make([]string, 0, len(parts))
	seen := map[string]struct{}{}
	for _, part := range parts {
		id := normalizeTrim(part)
		if id == "" {
			continue
		}
		if _, exists := seen[id]; exists {
			continue
		}
		seen[id] = struct{}{}
		ids = append(ids, id)
	}
	return ids
}

func (c *Controller) loadHeartbeatPayloadForMonitorIDs(ctx stdcontext.Context, limit int, monitorIDs []string) (map[string][]string, map[string][]heartbeatPoint, error) {
	if len(monitorIDs) == 0 {
		return c.loadHeartbeatPayload(ctx, limit)
	}
	identities, err := c.monitorRepo.WithContext(ctx).EnabledByIDs(monitorIDs)
	if err != nil {
		return nil, nil, err
	}
	identityByID := make(map[string]models.MonitorIdentity, len(monitorIDs))
	for _, id := range monitorIDs {
		identityByID[id] = models.MonitorIdentity{ID: id}
	}
	for _, monitor := range identities {
		id := strconv.FormatInt(monitor.Id, 10)
		identityByID[id] = models.MonitorIdentity{
			ID:                 id,
			Enabled:            monitor.Enabled,
			IntervalSeconds:    monitor.IntervalSeconds,
			ScheduleJitterMs:   monitor.ScheduleJitterMs,
			MaintenanceStartsAt: monitor.MaintenanceStartsAt,
			MaintenanceEndsAt:   monitor.MaintenanceEndsAt,
		}
	}
	rowsByMonitor, err := c.monitorCheckRepo.WithContext(ctx).LatestByMonitorIDs(monitorIDs, limit)
	if err != nil {
		return nil, nil, err
	}
	heartbeats := map[string][]string{}
	heartbeatPoints := map[string][]heartbeatPoint{}
	now := time.Now().UTC()
	globalMaintenance := c.monitoringMaintenanceWindow(ctx, now)
	for _, monitorID := range monitorIDs {
		identity := identityByID[monitorID]
		current, currentPoints := buildHeartbeatSlots(heartbeatSlotRequest{
			History:                   rowsToHeartbeatRows(rowsByMonitor[monitorID]),
			Now:                       now,
			Interval:                  identity.IntervalSeconds,
			Limit:                     limit,
			Enabled:                   identity.Enabled,
			MaintenanceStartsAt:       identity.MaintenanceStartsAt,
			MaintenanceEndsAt:         identity.MaintenanceEndsAt,
			GlobalMaintenanceStartsAt: globalMaintenance.StartsAt,
			GlobalMaintenanceEndsAt:   globalMaintenance.EndsAt,
		})
		heartbeats[monitorID] = current
		heartbeatPoints[monitorID] = currentPoints
	}
	return heartbeats, heartbeatPoints, nil
}

func rowsToHeartbeatRows(rows []models.MonitorCheck) []models.HeartbeatRow {
	if len(rows) == 0 {
		return []models.HeartbeatRow{}
	}
	out := make([]models.HeartbeatRow, 0, len(rows))
	for _, row := range rows {
		out = append(out, models.HeartbeatRow{
			MonitorID:  row.MonitorId,
			Status:     normalizeLower(row.Status),
			CheckedAt:  row.CheckedAt,
			DurationMS: int64(row.DurationMs.Int64),
		})
	}
	return out
}

func (c *Controller) loadHeartbeatPayload(ctx stdcontext.Context, limit int) (map[string][]string, map[string][]heartbeatPoint, error) {
	monitorIDs, err := c.monitorRepo.WithContext(ctx).IdentitiesOrderedByName()
	if err != nil {
		return nil, nil, err
	}
	rows, err := c.monitorCheckRepo.WithContext(ctx).LatestHeartbeatRows(5000)
	if err != nil {
		return nil, nil, err
	}

	byMonitor := map[string][]models.HeartbeatRow{}
	for _, it := range rows {
		monitorID := strconv.FormatInt(it.MonitorID, 10)
		if len(byMonitor[monitorID]) >= limit {
			continue
		}
		it.Status = normalizeLower(it.Status)
		byMonitor[monitorID] = append(byMonitor[monitorID], it)
	}

	heartbeats := map[string][]string{}
	heartbeatPoints := map[string][]heartbeatPoint{}
	now := time.Now().UTC()
	globalMaintenance := c.monitoringMaintenanceWindow(ctx, now)
	for _, m := range monitorIDs {
		current, currentPoints := buildHeartbeatSlots(heartbeatSlotRequest{
			History:             byMonitor[m.ID],
			Now:                 now,
			Interval:            m.IntervalSeconds,
			Limit:               limit,
			Enabled:             m.Enabled,
			MaintenanceStartsAt: m.MaintenanceStartsAt,
			MaintenanceEndsAt:   m.MaintenanceEndsAt,
			GlobalMaintenanceStartsAt: globalMaintenance.StartsAt,
			GlobalMaintenanceEndsAt:   globalMaintenance.EndsAt,
		})
		heartbeats[m.ID] = current
		heartbeatPoints[m.ID] = currentPoints
	}

	return heartbeats, heartbeatPoints, nil
}

func (c *Controller) monitoringMaintenanceWindow(ctx stdcontext.Context, now time.Time) appsettings.MonitoringMaintenanceWindow {
	if c.appSettingRepo == nil {
		return appsettings.MonitoringMaintenanceWindow{}
	}
	return c.appSettingRepo.MonitoringMaintenanceWindow(ctx, now)
}

func maintenanceActive(global appsettings.MonitoringMaintenanceWindow, localStart, localEnd *time.Time, now time.Time) bool {
	return global.Active || models.MaintenanceActiveAt(localStart, localEnd, now)
}

func monitoringWindowActive(start, end *time.Time, now time.Time) bool {
	if start == nil || end == nil {
		return false
	}
	startUTC := start.UTC()
	endUTC := end.UTC()
	nowUTC := now.UTC()
	if !endUTC.After(startUTC) {
		return false
	}
	return !nowUTC.Before(startUTC) && nowUTC.Before(endUTC)
}

func effectiveMaintenanceWindow(global appsettings.MonitoringMaintenanceWindow, localStart, localEnd *time.Time, now time.Time) (*time.Time, *time.Time, bool) {
	activeStarts := make([]time.Time, 0, 2)
	activeEnds := make([]time.Time, 0, 2)
	if global.Active && global.StartsAt != nil && global.EndsAt != nil {
		activeStarts = append(activeStarts, global.StartsAt.UTC())
		activeEnds = append(activeEnds, global.EndsAt.UTC())
	}
	if models.MaintenanceActiveAt(localStart, localEnd, now) && localStart != nil && localEnd != nil {
		activeStarts = append(activeStarts, localStart.UTC())
		activeEnds = append(activeEnds, localEnd.UTC())
	}
	if len(activeStarts) == 0 || len(activeEnds) == 0 {
		return nil, nil, false
	}
	start := activeStarts[0]
	end := activeEnds[0]
	for i := 1; i < len(activeStarts); i++ {
		if activeStarts[i].Before(start) {
			start = activeStarts[i]
		}
		if activeEnds[i].After(end) {
			end = activeEnds[i]
		}
	}
	return &start, &end, true
}

func nullableTimeString(value *time.Time) any {
	if value == nil {
		return nil
	}
	return value.UTC().Format(time.RFC3339)
}

func (c *Controller) MonitorDetail(r web.Context) error {
	monitorID := r.Param("id")
	if monitorID == "" {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "missing monitor id"})
	}
	monitor, err := c.monitorRepo.WithContext(r.Context()).DetailByID(monitorID)
	if err != nil {
		return r.JSON(http.StatusNotFound, map[string]any{"ok": false, "error": "monitor not found"})
	}
	if c.logger != nil {
		c.logger.WithContext(r.Context()).Info().
			Str("monitor_id", monitorID).
			Str("monitor_name", monitor.Name).
			Str("monitor_type", monitor.Type).
			Msg("monitor detail loaded")
	}
	now := time.Now().UTC()
	globalMaintenance := c.monitoringMaintenanceWindow(r.Context(), now)
	monitor.MaintenanceActive = maintenanceActive(globalMaintenance, monitor.MaintenanceStartsAt, monitor.MaintenanceEndsAt, now)
	if monitor.MaintenanceActive && globalMaintenance.Active && !models.MaintenanceActiveAt(monitor.MaintenanceStartsAt, monitor.MaintenanceEndsAt, now) {
		monitor.MaintenanceStartsAt = globalMaintenance.StartsAt
		monitor.MaintenanceEndsAt = globalMaintenance.EndsAt
	}
	return r.JSON(http.StatusOK, map[string]any{"ok": true, "monitor": monitor})
}

func (c *Controller) MonitorFavicon(r web.Context) error {
	monitorID := r.Param("id")
	if monitorID == "" {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "missing monitor id"})
	}
	model, err := c.monitorRepo.WithContext(r.Context()).ByID(monitorID)
	if err != nil {
		return r.JSON(http.StatusNotFound, map[string]any{"ok": false, "error": "monitor not found"})
	}

		type monitorTarget struct {
			ID     int64  `gorm:"column:id"`
			Type   string `gorm:"column:monitor_type"`
			Target string `gorm:"column:target"`
		}
	m := monitorTarget{
		ID:     model.Id,
		Type:   model.MonitorType,
		Target: model.Target,
	}

	if normalizeLower(m.Type) != "http" {
		return r.NoContent(http.StatusNotFound)
	}

	target := normalizeTrim(m.Target)
	if target == "" {
		return r.NoContent(http.StatusNotFound)
	}
	parsed, parseErr := neturl.Parse(target)
	if parseErr != nil || parsed.Host == "" {
		if !strings.Contains(target, "://") {
			parsed, parseErr = neturl.Parse("https://" + target)
		}
	}
	if parseErr != nil || parsed == nil || parsed.Host == "" {
		return r.NoContent(http.StatusNotFound)
	}

	scheme := normalizeLower(parsed.Scheme)
	if scheme == "" {
		scheme = "https"
	}
	if scheme != "http" && scheme != "https" {
		return r.NoContent(http.StatusNotFound)
	}
	client := &http.Client{
		Timeout: 4 * time.Second,
	}

	pageURL := scheme + "://" + parsed.Host
	cacheKey := fmt.Sprintf("%d|%s|%s", m.ID, m.Type, pageURL)
	if contentType, body, ok, notFound := readFaviconCache(r.Context(), c.storage.Favicons(), cacheKey, c.faviconCacheTTL(r.Context())); ok {
		r.SetHeader("Cache-Control", "public, max-age=300")
		return r.Blob(http.StatusOK, contentType, body)
	} else if notFound {
		return r.NoContent(http.StatusNotFound)
	}
	candidates := extractFaviconCandidates(pageURL)

	if _, pageType, pageBody, err := fetchURL(client, pageURL, "text/html,application/xhtml+xml"); err == nil {
		if strings.Contains(strings.ToLower(pageType), "text/html") || bytes.Contains(bytes.ToLower(pageBody), []byte("<html")) {
			candidates = append(extractIconLinks(pageURL, string(pageBody)), candidates...)
		}
	}

	seen := map[string]struct{}{}
	uniqueCandidates := make([]string, 0, len(candidates))
	for _, candidate := range candidates {
		normalized := strings.TrimSpace(candidate)
		if normalized == "" {
			continue
		}
		if _, ok := seen[normalized]; ok {
			continue
		}
		seen[normalized] = struct{}{}
		uniqueCandidates = append(uniqueCandidates, normalized)
	}

	for _, candidate := range uniqueCandidates {
		statusCode, contentType, body, err := fetchURL(client, candidate, "image/*,*/*")
		if err != nil || statusCode < 200 || statusCode >= 400 || len(body) == 0 {
			continue
		}
		detected := normalizeImageContentType(contentType, body)
		if detected == "" {
			continue
		}
		writeFaviconCache(r.Context(), c.storage.Favicons(), cacheKey, detected, body)
		r.SetHeader("Cache-Control", "public, max-age=300")
		return r.Blob(http.StatusOK, detected, body)
	}

	writeMissingFaviconCache(r.Context(), c.storage.Favicons(), cacheKey)
	return r.NoContent(http.StatusNotFound)
}

type faviconCacheMeta struct {
	ContentType string `json:"content_type"`
	CachedUnix  int64  `json:"cached_unix"`
	NotFound    bool   `json:"not_found,omitempty"`
}

func faviconCachePath(cacheKey string) string {
	slug := str.Of(cacheKey).TrimSpace().ToLower().Snake("-").String()
	if slug == "" {
		slug = "favicon"
	}
	return slug
}

func readFaviconCache(ctx stdcontext.Context, disk storage.Storage, cacheKey string, ttl time.Duration) (string, []byte, bool, bool) {
	disk = disk.WithContext(ctx)
	metaPath := faviconCachePath(cacheKey) + ".json"
	metaExists, err := disk.Exists(metaPath)
	if err != nil || !metaExists {
		return "", nil, false, false
	}
	metaBytes, err := disk.Get(metaPath)
	if err != nil {
		return "", nil, false, false
	}
	var meta faviconCacheMeta
	if err := json.Unmarshal(metaBytes, &meta); err != nil {
		return "", nil, false, false
	}
	if meta.CachedUnix <= 0 {
		return "", nil, false, false
	}
	if ttl <= 0 {
		ttl = 7 * 24 * time.Hour
	}
	if time.Since(time.Unix(meta.CachedUnix, 0)) > ttl {
		return "", nil, false, false
	}
	if meta.NotFound {
		return "", nil, false, true
	}
	if str.Of(meta.ContentType).TrimSpace().String() == "" {
		return "", nil, false, false
	}
	bodyPath := faviconCachePath(cacheKey) + ".bin"
	bodyExists, err := disk.Exists(bodyPath)
	if err != nil || !bodyExists {
		return "", nil, false, false
	}
	body, err := disk.Get(bodyPath)
	if err != nil || len(body) == 0 {
		return "", nil, false, false
	}
	return meta.ContentType, body, true, false
}

func writeFaviconCache(ctx stdcontext.Context, disk storage.Storage, cacheKey, contentType string, body []byte) {
	disk = disk.WithContext(ctx)
	meta := faviconCacheMeta{
		ContentType: str.Of(contentType).TrimSpace().String(),
		CachedUnix:  time.Now().Unix(),
	}
	metaBytes, err := json.Marshal(meta)
	if err != nil {
		return
	}
	basePath := faviconCachePath(cacheKey)
	_ = disk.Put(basePath+".bin", body)
	_ = disk.Put(basePath+".json", metaBytes)
}

func writeMissingFaviconCache(ctx stdcontext.Context, disk storage.Storage, cacheKey string) {
	disk = disk.WithContext(ctx)
	meta := faviconCacheMeta{
		CachedUnix: time.Now().Unix(),
		NotFound:   true,
	}
	metaBytes, err := json.Marshal(meta)
	if err != nil {
		return
	}
	basePath := faviconCachePath(cacheKey)
	_ = disk.Delete(basePath + ".bin")
	_ = disk.Put(basePath+".json", metaBytes)
}

func (c *Controller) faviconCacheTTL(ctx stdcontext.Context) time.Duration {
	if c.appSettingRepo == nil {
		return 7 * 24 * time.Hour
	}
	raw, err := c.appSettingRepo.GetValue(ctx, appsettings.SettingFaviconCacheTTLSeconds, "604800")
	if err != nil {
		c.logger.Warn().Err(err).Msg("favicon cache ttl setting read failed")
		return 7 * 24 * time.Hour
	}
	seconds, convErr := strconv.Atoi(str.Of(raw).TrimSpace().String())
	if convErr != nil || seconds <= 0 {
		return 7 * 24 * time.Hour
	}
	return time.Duration(seconds) * time.Second
}

func extractFaviconCandidates(pageURL string) []string {
	return []string{
		strings.TrimRight(pageURL, "/") + "/favicon.ico",
		strings.TrimRight(pageURL, "/") + "/favicon.png",
	}
}

var (
	linkTagRegex  = regexp.MustCompile(`(?is)<link\b[^>]*>`)
	attrPairRegex = regexp.MustCompile(`(?is)([a-zA-Z_:][-a-zA-Z0-9_:.]*)\s*=\s*("([^"]*)"|'([^']*)'|([^\s>]+))`)
)

func extractIconLinks(pageURL, htmlDoc string) []string {
	baseURL, err := neturl.Parse(strings.TrimSpace(pageURL))
	if err != nil || baseURL == nil {
		return nil
	}

	tags := linkTagRegex.FindAllString(htmlDoc, -1)
	candidates := make([]string, 0, len(tags))
	for _, tag := range tags {
		matches := attrPairRegex.FindAllStringSubmatch(tag, -1)
		attrs := map[string]string{}
		for _, match := range matches {
			key := strings.ToLower(strings.TrimSpace(match[1]))
			value := strings.TrimSpace(match[3])
			if value == "" {
				value = strings.TrimSpace(match[4])
			}
			if value == "" {
				value = strings.TrimSpace(match[5])
			}
			attrs[key] = html.UnescapeString(value)
		}

		rel := strings.ToLower(strings.TrimSpace(attrs["rel"]))
		href := strings.TrimSpace(attrs["href"])
		if href == "" || !strings.Contains(rel, "icon") {
			continue
		}
		parsedHref, err := neturl.Parse(href)
		if err != nil || parsedHref == nil {
			continue
		}
		absolute := baseURL.ResolveReference(parsedHref)
		if absolute == nil {
			continue
		}
		if absolute.Scheme != "http" && absolute.Scheme != "https" {
			continue
		}
		candidates = append(candidates, absolute.String())
	}

	return candidates
}

func fetchURL(client *http.Client, targetURL, accept string) (int, string, []byte, error) {
	req, err := http.NewRequest(http.MethodGet, targetURL, nil)
	if err != nil {
		return 0, "", nil, err
	}
	req.Header.Set("User-Agent", "GoForj-Uptime/1.0")
	if normalizeTrim(accept) != "" {
		req.Header.Set("Accept", accept)
	}
	resp, err := client.Do(req)
	if err != nil {
		return 0, "", nil, err
	}
	defer resp.Body.Close()

	body, err := io.ReadAll(io.LimitReader(resp.Body, 2*1024*1024))
	if err != nil {
		return resp.StatusCode, resp.Header.Get("Content-Type"), nil, err
	}

	return resp.StatusCode, resp.Header.Get("Content-Type"), body, nil
}

func normalizeImageContentType(contentType string, body []byte) string {
	normalized := strings.ToLower(strings.TrimSpace(strings.Split(contentType, ";")[0]))
	if normalized == "" || strings.HasPrefix(normalized, "text/") || normalized == "application/xml" || normalized == "text/xml" {
		sniffed := http.DetectContentType(body)
		normalized = strings.ToLower(strings.TrimSpace(strings.Split(sniffed, ";")[0]))
	}
	if normalized == "text/plain" && bytes.Contains(bytes.ToLower(body), []byte("<svg")) {
		normalized = "image/svg+xml"
	}
	if strings.HasPrefix(normalized, "image/") {
		return normalized
	}
	if normalized == "application/octet-stream" {
		return "image/x-icon"
	}
	return ""
}

func (c *Controller) MonitorChecks(r web.Context) error {
	monitorID := r.Param("id")
	if monitorID == "" {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "missing monitor id"})
	}
	checks, stats, err := c.loadMonitorChecks(r.Context(), monitorID, normalizeTrim(r.Query("range")))
	if err != nil {
		if strings.Contains(strings.ToLower(err.Error()), "not found") {
			return r.JSON(http.StatusNotFound, map[string]any{"ok": false, "error": "monitor not found"})
		}
		return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}

	return r.JSON(http.StatusOK, map[string]any{
		"ok":     true,
		"checks": checks,
		"stats":  stats,
	})
}

func (c *Controller) MonitorDashboard(r web.Context) error {
	monitorID := normalizeTrim(r.Param("id"))
	if monitorID == "" {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "missing monitor id"})
	}

	monitor, err := c.monitorRepo.WithContext(r.Context()).DetailByID(monitorID)
	if err != nil {
		return r.JSON(http.StatusNotFound, map[string]any{"ok": false, "error": "monitor not found"})
	}
	now := time.Now().UTC()
	globalMaintenance := c.monitoringMaintenanceWindow(r.Context(), now)
	monitor.MaintenanceActive = maintenanceActive(globalMaintenance, monitor.MaintenanceStartsAt, monitor.MaintenanceEndsAt, now)
	if monitor.MaintenanceActive && globalMaintenance.Active && !models.MaintenanceActiveAt(monitor.MaintenanceStartsAt, monitor.MaintenanceEndsAt, now) {
		monitor.MaintenanceStartsAt = globalMaintenance.StartsAt
		monitor.MaintenanceEndsAt = globalMaintenance.EndsAt
	}
	checks, stats, err := c.loadMonitorChecks(r.Context(), monitorID, normalizeTrim(r.Query("range")))
	if err != nil {
		return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	incidents, err := c.incidentRepo.WithContext(r.Context()).RecentByMonitor(monitorID, 20)
	if err != nil {
		return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}

	return r.JSON(http.StatusOK, map[string]any{
		"ok":        true,
		"monitor":   monitor,
		"checks":    checks,
		"stats":     stats,
		"incidents": incidents,
	})
}

func monitorRangeSince(rangeKey string) time.Time {
	return time.Now().UTC().Add(-monitorRangeDuration(rangeKey))
}

func monitorRangeDuration(rangeKey string) time.Duration {
	switch normalizeLower(rangeKey) {
	case "15m":
		return 15 * time.Minute
	case "1h":
		return 1 * time.Hour
	case "3h":
		return 3 * time.Hour
	case "6h":
		return 6 * time.Hour
	case "12h":
		return 12 * time.Hour
	case "30d":
		return 30 * 24 * time.Hour
	case "7d":
		return 7 * 24 * time.Hour
	default:
		return 24 * time.Hour
	}
}

func monitorCheckFetchLimit(rangeKey string, intervalSeconds int) int {
	if intervalSeconds <= 0 {
		intervalSeconds = 60
	}
	// Keep enough rows for the selected range with headroom for retries/duplicates.
	expected := int(monitorRangeDuration(rangeKey).Seconds()) / intervalSeconds
	if expected < 500 {
		expected = 500
	}
	expected = int(float64(expected) * 1.5)
	if expected < 500 {
		expected = 500
	}
	if expected > 25000 {
		expected = 25000
	}
	return expected
}

func (c *Controller) loadMonitorChecks(ctx stdcontext.Context, monitorID, rangeKey string) ([]models.MonitorCheckView, map[string]any, error) {
	monitor, err := c.monitorRepo.WithContext(ctx).ByID(monitorID)
	if err != nil {
		return nil, nil, fmt.Errorf("monitor not found")
	}

	since := monitorRangeSince(rangeKey)
	limit := monitorCheckFetchLimit(rangeKey, monitor.IntervalSeconds)
	checks, err := c.monitorCheckRepo.WithContext(ctx).ByMonitorSinceView(monitorID, since, limit)
	if err != nil {
		return nil, nil, err
	}

	interval := monitor.IntervalSeconds
	if interval <= 0 {
		interval = 60
	}
	if !monitor.Enabled && len(checks) > 0 && strings.EqualFold(checks[0].Status, "paused") {
		now := time.Now().UTC()
		latestPausedAt := checks[0].CheckedAt.UTC()
		synth := make([]models.MonitorCheckView, 0, 64)
		for ts := now; ts.After(latestPausedAt); ts = ts.Add(-time.Duration(interval) * time.Second) {
			synth = append(synth, models.MonitorCheckView{
				ID:         0,
				CheckedAt:  ts,
				Status:     "paused",
				StatusCode: 0,
				DurationMS: 0,
				ErrorText:  "",
			})
		}
		if len(synth) > 0 {
			checks = append(synth, checks...)
		}
	}
	now := time.Now().UTC()
	globalMaintenance := c.monitoringMaintenanceWindow(ctx, now)
	if monitor.Enabled {
		maintenanceStart, _, maintenanceActiveNow := effectiveMaintenanceWindow(globalMaintenance, monitor.MaintenanceStartsAt, monitor.MaintenanceEndsAt, now)
		if maintenanceActiveNow {
			latestMaintenanceAt := now
			if maintenanceStart != nil {
				latestMaintenanceAt = maintenanceStart.UTC()
			}
			synth := make([]models.MonitorCheckView, 0, 64)
			for ts := now; ts.After(latestMaintenanceAt); ts = ts.Add(-time.Duration(interval) * time.Second) {
				synth = append(synth, models.MonitorCheckView{
					ID:         0,
					CheckedAt:  ts,
					Status:     "maintenance",
					StatusCode: 0,
					DurationMS: 0,
					ErrorText:  "",
				})
			}
			if len(synth) > 0 {
				checks = append(synth, checks...)
			}
		}
	}

	durations := make([]int, 0, len(checks))
	completedChecks := 0
	upCount := 0
	for _, it := range checks {
		status := normalizeLower(it.Status)
		if status != "up" && status != "down" {
			continue
		}
		completedChecks++
		if it.DurationMS > 0 {
			durations = append(durations, it.DurationMS)
		}
		if status == "up" {
			upCount++
		}
	}
	sort.Ints(durations)
	percentile := func(p float64) int {
		if len(durations) == 0 {
			return 0
		}
		idx := int(float64(len(durations)-1) * p)
		if idx < 0 {
			idx = 0
		}
		if idx >= len(durations) {
			idx = len(durations) - 1
		}
		return durations[idx]
	}
	uptimePct := 0.0
	if completedChecks > 0 {
		uptimePct = (float64(upCount) / float64(completedChecks)) * 100
	}

	stats := map[string]any{
		"sample_count": completedChecks,
		"uptime_pct":   uptimePct,
		"p50_ms":       percentile(0.50),
		"p95_ms":       percentile(0.95),
	}

	return checks, stats, nil
}

func parseMonitoringRange(raw string) time.Duration {
	switch normalizeLower(raw) {
	case "1h":
		return 1 * time.Hour
	case "3h":
		return 3 * time.Hour
	case "6h":
		return 6 * time.Hour
	case "12h":
		return 12 * time.Hour
	case "7d":
		return 7 * 24 * time.Hour
	case "30d":
		return 30 * 24 * time.Hour
	default:
		return 24 * time.Hour
	}
}

func (c *Controller) AlertDispatchDiagnostics(r web.Context) error {
	if c.alertDispatchEventRepo == nil {
		return r.JSON(http.StatusServiceUnavailable, map[string]any{"ok": false, "error": "alert dispatch event repo not configured"})
	}
	limit := 100
	if raw := normalizeTrim(r.Query("limit")); raw != "" {
		if parsed, err := strconv.Atoi(raw); err == nil && parsed > 0 {
			limit = parsed
		}
	}
	monitorID := normalizeTrim(r.Query("monitor_id"))
	window := parseMonitoringRange(r.Query("range"))
	since := time.Now().UTC().Add(-window)
	rows, err := c.alertDispatchEventRepo.WithContext(r.Context()).Recent(limit, monitorID, since)
	if err != nil {
		return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	return r.JSON(http.StatusOK, map[string]any{
		"ok":     true,
		"events": rows,
	})
}

func (c *Controller) CadenceDiagnostics(r web.Context) error {
	monitorID := normalizeTrim(r.Query("monitor_id"))
	window := parseMonitoringRange(r.Query("range"))
	now := time.Now().UTC()
	since := now.Add(-window)
	monitors := make([]models.Monitor, 0)
	if monitorID != "" {
		monitor, err := c.monitorRepo.WithContext(r.Context()).ByID(monitorID)
		if err == nil && monitor != nil {
			monitors = append(monitors, *monitor)
		}
	} else {
		allMonitors, err := c.monitorRepo.WithContext(r.Context()).AllOrderedByName()
		if err != nil {
			return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
		}
		monitors = allMonitors
	}

	if len(monitors) == 0 {
		return r.JSON(http.StatusOK, map[string]any{
			"ok":       true,
			"window":   normalizeLower(r.Query("range")),
			"monitors": []any{},
		})
	}

	checkRows, err := c.monitorCheckRepo.WithContext(r.Context()).Since(since, 20000)
	if err != nil {
		return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}

	byMonitor := map[string][]time.Time{}
	for _, row := range checkRows {
		rowMonitorID := strconv.FormatInt(row.MonitorId, 10)
		if monitorID != "" && rowMonitorID != monitorID {
			continue
		}
		status := normalizeLower(row.Status)
		if status != "up" && status != "down" {
			// Cadence diagnostics track terminal poll outcomes only.
			// Excluding transient rows (pending/paused/unknown) avoids
			// duplicate/missed inflation from retries and state markers.
			continue
		}
		byMonitor[rowMonitorID] = append(byMonitor[rowMonitorID], row.CheckedAt.UTC())
	}

	type cadence struct {
		MonitorID       string     `json:"monitor_id"`
		Name            string     `json:"name"`
		IntervalSeconds int        `json:"interval_seconds"`
		ToleranceSec    int        `json:"tolerance_sec"`
		Samples         int        `json:"samples"`
		DeltaSamples    int        `json:"delta_samples"`
		DeltaMinSec     int        `json:"delta_min_sec"`
		DeltaP50Sec     int        `json:"delta_p50_sec"`
		DeltaP95Sec     int        `json:"delta_p95_sec"`
		DeltaMaxSec     int        `json:"delta_max_sec"`
		OnTimeCount     int        `json:"on_time_count"`
		MissedCount     int        `json:"missed_count"`
		DuplicateCount  int        `json:"duplicate_count"`
		LastCheckedAt   *time.Time `json:"last_checked_at,omitempty"`
		FreshnessSec    int        `json:"freshness_sec"`
	}

	percentile := func(values []int, p float64) int {
		if len(values) == 0 {
			return 0
		}
		idx := int(float64(len(values)-1) * p)
		if idx < 0 {
			idx = 0
		}
		if idx >= len(values) {
			idx = len(values) - 1
		}
		return values[idx]
	}

	out := make([]cadence, 0, len(monitors))
		for _, mon := range monitors {
			monitorPrimaryID := strconv.FormatInt(mon.Id, 10)
		interval := mon.IntervalSeconds
		if interval <= 0 {
			interval = 60
		}
		tolerance := interval / 3
		if tolerance < 10 {
			tolerance = 10
		}
		if tolerance > 30 {
			tolerance = 30
		}

		times := byMonitor[monitorPrimaryID]
		if len(times) > 1 {
			sort.Slice(times, func(i, j int) bool {
				return times[i].Before(times[j])
			})
		}
		deltas := make([]int, 0, len(times))
		onTime := 0
		missed := 0
		dupes := 0

		for i := 1; i < len(times); i++ {
			delta := int(times[i].Sub(times[i-1]).Seconds())
			if delta < 0 {
				continue
			}
			deltas = append(deltas, delta)
			if delta < maxInt(1, interval/4) {
				dupes++
				continue
			}
			if delta > interval+tolerance {
				missed++
				continue
			}
			if delta >= maxInt(1, interval-tolerance) {
				onTime++
			}
		}

		sort.Ints(deltas)
			item := cadence{
				MonitorID:       monitorPrimaryID,
			Name:            mon.Name,
			IntervalSeconds: interval,
			ToleranceSec:    tolerance,
			Samples:         len(times),
			DeltaSamples:    len(deltas),
			DeltaMinSec:     0,
			DeltaP50Sec:     percentile(deltas, 0.50),
			DeltaP95Sec:     percentile(deltas, 0.95),
			DeltaMaxSec:     0,
			OnTimeCount:     onTime,
			MissedCount:     missed,
			DuplicateCount:  dupes,
			FreshnessSec:    0,
		}
		if len(deltas) > 0 {
			item.DeltaMinSec = deltas[0]
			item.DeltaMaxSec = deltas[len(deltas)-1]
		}
		if len(times) > 0 {
			last := times[len(times)-1]
			item.LastCheckedAt = &last
			age := int(now.Sub(last).Seconds())
			if age < 0 {
				age = 0
			}
			item.FreshnessSec = age
		}
		out = append(out, item)
	}

	return r.JSON(http.StatusOK, map[string]any{
		"ok":       true,
		"range":    normalizeLower(r.Query("range")),
		"window_s": int(window.Seconds()),
		"monitors": out,
	})
}

func maxInt(a, b int) int {
	if a > b {
		return a
	}
	return b
}

type monitorInput struct {
	Name            string `json:"name"`
	Type            string `json:"type"`
	Target          string `json:"target"`
	TargetURL       string `json:"target_url"`
	TargetHost      string `json:"target_host"`
	TargetPort      int    `json:"target_port"`
	TargetRecordType string `json:"target_record_type"`
	TargetKeyword   string `json:"target_keyword"`
	TargetExpected  string `json:"target_expected"`
	TargetContainer string `json:"target_container"`
	TargetDockerHost string `json:"target_docker_host"`
	TargetPushToken string `json:"target_push_token"`
	NotificationChannelIDs []int64 `json:"notification_channel_ids"`
	IntervalSeconds int    `json:"interval_seconds"`
	TimeoutMS       int    `json:"timeout_ms"`
	RetryAttempts   int    `json:"retry_attempts"`
	RetryBackoffMS  int    `json:"retry_backoff_ms"`
	ScheduleJitterMS int   `json:"schedule_jitter_ms"`
	DownConfirmAttempts int `json:"down_confirm_attempts"`
	RecoveryConfirmAttempts int `json:"recovery_confirm_attempts"`
	ResendIntervalChecks int `json:"resend_interval_checks"`
	MaintenanceStartsAt string `json:"maintenance_starts_at"`
	MaintenanceEndsAt string `json:"maintenance_ends_at"`
	Enabled         bool   `json:"enabled"`
}

type monitorValidationError struct {
	Error  string            `json:"error"`
	Fields map[string]string `json:"fields"`
}

func normalizeMonitorInput(in monitorInput) monitorInput {
	in.Name = normalizeTrim(in.Name)
	in.Type = normalizeLower(in.Type)
	in.Target = normalizeTrim(in.Target)
	in.TargetURL = normalizeTrim(in.TargetURL)
	in.TargetHost = normalizeTrim(in.TargetHost)
	in.TargetRecordType = normalizeUpper(in.TargetRecordType)
	in.TargetKeyword = normalizeTrim(in.TargetKeyword)
	in.TargetExpected = normalizeTrim(in.TargetExpected)
	in.TargetContainer = normalizeTrim(in.TargetContainer)
	in.TargetDockerHost = normalizeTrim(in.TargetDockerHost)
	in.TargetPushToken = normalizeTrim(in.TargetPushToken)
	in.MaintenanceStartsAt = normalizeTrim(in.MaintenanceStartsAt)
	in.MaintenanceEndsAt = normalizeTrim(in.MaintenanceEndsAt)
	if in.TargetPort < 0 {
		in.TargetPort = 0
	}
	if in.IntervalSeconds <= 0 {
		in.IntervalSeconds = 60
	}
	if in.TimeoutMS <= 0 {
		in.TimeoutMS = 5000
	}
	if in.RetryAttempts < 0 {
		in.RetryAttempts = 0
	}
	if in.RetryBackoffMS <= 0 {
		in.RetryBackoffMS = 250
	}
	if in.ScheduleJitterMS < 0 {
		in.ScheduleJitterMS = 0
	}
	if in.ScheduleJitterMS == 0 {
		in.ScheduleJitterMS = 150
	}
	if in.DownConfirmAttempts <= 0 {
		in.DownConfirmAttempts = 1
	}
	if in.RecoveryConfirmAttempts <= 0 {
		in.RecoveryConfirmAttempts = 1
	}
	if in.ResendIntervalChecks < 0 {
		in.ResendIntervalChecks = 0
	}
	if in.Type == "" {
		in.Type = "http"
	}
	in.NotificationChannelIDs = models.NormalizeNotificationChannelIDs(in.NotificationChannelIDs)
	return in
}

func parseOptionalRFC3339(value string) (*time.Time, error) {
	trimmed := normalizeTrim(value)
	if trimmed == "" {
		return nil, nil
	}
	parsed, err := time.Parse(time.RFC3339, trimmed)
	if err != nil {
		return nil, err
	}
	utc := parsed.UTC()
	return &utc, nil
}

func monitorMaintenanceTimesFromInput(in monitorInput) (*time.Time, *time.Time, error) {
	start, err := parseOptionalRFC3339(in.MaintenanceStartsAt)
	if err != nil {
		return nil, nil, fmt.Errorf("maintenance start must be RFC3339")
	}
	end, err := parseOptionalRFC3339(in.MaintenanceEndsAt)
	if err != nil {
		return nil, nil, fmt.Errorf("maintenance end must be RFC3339")
	}
	return start, end, nil
}

func monitorRuntimeStatus(enabled bool, maintenanceActive bool, lastStatus string) string {
	if !enabled {
		return "paused"
	}
	if maintenanceActive {
		return "maintenance"
	}
	status := normalizeLower(lastStatus)
	if status == "" {
		return "unknown"
	}
	return status
}

func (c *Controller) normalizeAndValidateChannelIDs(ids []int64) ([]int64, map[string]string) {
	normalized := models.NormalizeNotificationChannelIDs(ids)
	if len(normalized) == 0 {
		return nil, nil
	}
	if c.channelRepo == nil {
		return nil, map[string]string{
			"notification_channel_ids": "notification channels are not configured",
		}
	}
	summaries, err := c.channelRepo.ListSummaries()
	if err != nil {
		return nil, map[string]string{
			"notification_channel_ids": "failed to load notification channels",
		}
	}
	available := make(map[int64]struct{}, len(summaries))
	for i := range summaries {
		available[summaries[i].ID] = struct{}{}
	}
	for _, id := range normalized {
		if _, ok := available[id]; ok {
			continue
		}
		return nil, map[string]string{
			"notification_channel_ids": "one or more selected channels no longer exist",
		}
	}
	return normalized, nil
}

func canonicalTargetFromInput(in monitorInput) string {
	if normalizeTrim(in.Target) != "" {
		return normalizeTrim(in.Target)
	}
	switch in.Type {
	case "http", "websocket":
		if in.TargetURL == "" {
			return ""
		}
		return in.TargetURL
	case "tcp", "steam":
		if in.TargetHost == "" || in.TargetPort <= 0 {
			return ""
		}
		return fmt.Sprintf("%s:%d", in.TargetHost, in.TargetPort)
	case "ping":
		return in.TargetHost
	case "dns":
		if in.TargetHost == "" {
			return ""
		}
		recordType := in.TargetRecordType
		if recordType == "" {
			recordType = "A"
		}
		return fmt.Sprintf("%s|%s", in.TargetHost, recordType)
	case "tls":
		if in.TargetHost == "" {
			return ""
		}
		port := in.TargetPort
		if port <= 0 {
			port = 443
		}
		return fmt.Sprintf("%s:%d", in.TargetHost, port)
	case "http_keyword":
		if in.TargetURL == "" || in.TargetKeyword == "" {
			return ""
		}
		return in.TargetURL + "|" + in.TargetKeyword
	case "http_json_query":
		if in.TargetURL == "" || in.TargetKeyword == "" || in.TargetExpected == "" {
			return ""
		}
		return in.TargetURL + "|" + in.TargetKeyword + "|" + in.TargetExpected
	case "docker":
		if in.TargetContainer == "" {
			return ""
		}
		if in.TargetDockerHost == "" {
			return in.TargetContainer
		}
		return in.TargetContainer + "|" + in.TargetDockerHost
	case "push":
		return in.TargetPushToken
	default:
		return ""
	}
}

type normalizedMonitorTarget struct {
	Canonical    string
	URL          string
	Host         string
	Port         int
	RecordType   string
	Keyword      string
	Expected     string
	Container    string
	DockerHost   string
	PushToken    string
}

func normalizeMonitorTarget(monitorType, target string) (normalizedMonitorTarget, error) {
	out := normalizedMonitorTarget{Canonical: normalizeTrim(target)}
	switch monitorType {
	case "http", "websocket":
		u, err := neturl.Parse(out.Canonical)
		if err != nil {
			return out, err
		}
		if strings.TrimSpace(u.Hostname()) == "" {
			return out, fmt.Errorf("missing host")
		}
		out.URL = out.Canonical
	case "tcp", "steam":
		host, port, err := net.SplitHostPort(out.Canonical)
		if monitorType == "steam" {
			host, port, err = parseSteamMonitorTarget(out.Canonical)
		}
		if err != nil {
			return out, err
		}
		out.Host = normalizeTrim(host)
		parsedPort, err := strconv.Atoi(normalizeTrim(port))
		if err != nil {
			return out, err
		}
		out.Port = parsedPort
	case "ping":
		out.Host = out.Canonical
	case "dns":
		host, recordType, err := parseDNSMonitorTarget(out.Canonical)
		if err != nil {
			return out, err
		}
		out.Host = host
		out.RecordType = recordType
	case "tls":
		host, port, err := parseTLSMonitorTarget(out.Canonical)
		if err != nil {
			return out, err
		}
		out.Host = host
		parsedPort, err := strconv.Atoi(normalizeTrim(port))
		if err != nil {
			return out, err
		}
		out.Port = parsedPort
	case "http_keyword":
		targetURL, keyword, err := parseHTTPKeywordTarget(out.Canonical)
		if err != nil {
			return out, err
		}
		u, err := neturl.Parse(targetURL)
		if err != nil {
			return out, err
		}
		if strings.TrimSpace(u.Hostname()) == "" {
			return out, fmt.Errorf("missing host")
		}
		out.URL = normalizeTrim(targetURL)
		out.Keyword = normalizeTrim(keyword)
	case "http_json_query":
		targetURL, pathExpr, expected, err := parseHTTPJSONQueryTarget(out.Canonical)
		if err != nil {
			return out, err
		}
		u, err := neturl.Parse(targetURL)
		if err != nil {
			return out, err
		}
		if strings.TrimSpace(u.Hostname()) == "" {
			return out, fmt.Errorf("missing host")
		}
		out.URL = normalizeTrim(targetURL)
		out.Keyword = normalizeTrim(pathExpr)
		out.Expected = normalizeTrim(expected)
	case "docker":
		container, host, err := parseDockerMonitorTarget(out.Canonical)
		if err != nil {
			return out, err
		}
		out.Container = normalizeTrim(container)
		out.DockerHost = normalizeTrim(host)
	case "push":
		out.PushToken = out.Canonical
	}
	return out, nil
}

func applyNormalizedMonitorTarget(m *models.Monitor, n normalizedMonitorTarget) {
	m.Target = n.Canonical
	m.TargetURL = null.NewString(n.URL, normalizeTrim(n.URL) != "")
	m.TargetRecordType = null.NewString(n.RecordType, normalizeTrim(n.RecordType) != "")
	m.TargetKeyword = null.NewString(n.Keyword, normalizeTrim(n.Keyword) != "")
	m.TargetExpected = null.NewString(n.Expected, normalizeTrim(n.Expected) != "")
	m.TargetContainer = null.NewString(n.Container, normalizeTrim(n.Container) != "")
	m.TargetDockerHost = null.NewString(n.DockerHost, normalizeTrim(n.DockerHost) != "")
	m.TargetPushToken = null.NewString(n.PushToken, normalizeTrim(n.PushToken) != "")
}

func validateMonitorInput(in monitorInput) *monitorValidationError {
	fields := map[string]string{}
	if in.Name == "" {
		fields["name"] = "name is required"
	}
	if in.Target == "" {
		fields["target"] = "target is required"
	}
	if in.IntervalSeconds < 5 || in.IntervalSeconds > 86400 {
		fields["interval_seconds"] = "interval must be between 5 and 86400 seconds"
	}
	if in.TimeoutMS < 250 || in.TimeoutMS > 60000 {
		fields["timeout_ms"] = "timeout must be between 250 and 60000 milliseconds"
	}
	if in.RetryAttempts < 0 || in.RetryAttempts > 5 {
		fields["retry_attempts"] = "retry attempts must be between 0 and 5"
	}
	if in.RetryBackoffMS < 50 || in.RetryBackoffMS > 10000 {
		fields["retry_backoff_ms"] = "retry backoff must be between 50 and 10000 milliseconds"
	}
	if in.ScheduleJitterMS < 0 || in.ScheduleJitterMS > 30000 {
		fields["schedule_jitter_ms"] = "schedule jitter must be between 0 and 30000 milliseconds"
	}
	if in.DownConfirmAttempts < 1 || in.DownConfirmAttempts > 10 {
		fields["down_confirm_attempts"] = "down confirm attempts must be between 1 and 10"
	}
	if in.RecoveryConfirmAttempts < 1 || in.RecoveryConfirmAttempts > 10 {
		fields["recovery_confirm_attempts"] = "recovery confirm attempts must be between 1 and 10"
	}
	if in.ResendIntervalChecks < 0 || in.ResendIntervalChecks > 1000 {
		fields["resend_interval_checks"] = "resend interval checks must be between 0 and 1000"
	}
	start, startErr := parseOptionalRFC3339(in.MaintenanceStartsAt)
	if startErr != nil {
		fields["maintenance_starts_at"] = "maintenance start must be RFC3339"
	}
	end, endErr := parseOptionalRFC3339(in.MaintenanceEndsAt)
	if endErr != nil {
		fields["maintenance_ends_at"] = "maintenance end must be RFC3339"
	}
	if (start == nil) != (end == nil) {
		fields["maintenance_starts_at"] = "maintenance window requires both start and end"
		fields["maintenance_ends_at"] = "maintenance window requires both start and end"
	}
	if start != nil && end != nil && !end.After(*start) {
		fields["maintenance_ends_at"] = "maintenance end must be after start"
	}
	switch in.Type {
	case "http":
		u, err := neturl.Parse(in.Target)
		if err != nil || u.Host == "" {
			fields["target"] = "http target must be a valid URL"
		}
		if u.Scheme != "http" && u.Scheme != "https" {
			fields["target"] = "http target must start with http:// or https://"
		}
	case "tcp":
		if _, _, err := net.SplitHostPort(in.Target); err != nil {
			fields["target"] = "tcp target must be host:port"
		}
	case "ping":
		if strings.Contains(in.Target, "://") || strings.Contains(in.Target, "/") {
			fields["target"] = "ping target must be a hostname or IP"
		}
	case "dns":
		host, recordType, err := parseDNSMonitorTarget(in.Target)
		if err != nil || host == "" {
			fields["target"] = "dns target must be host or host|A/AAAA/CNAME/MX/NS/TXT"
			break
		}
		switch recordType {
		case "A", "AAAA", "CNAME", "MX", "NS", "TXT":
		default:
			fields["target"] = "dns record type must be A, AAAA, CNAME, MX, NS, or TXT"
		}
	case "tls":
		if _, _, err := parseTLSMonitorTarget(in.Target); err != nil {
			fields["target"] = "tls target must be https://host[:port], host, or host:port"
		}
	case "http_keyword":
		urlValue, keyword, err := parseHTTPKeywordTarget(in.Target)
		if err != nil {
			fields["target"] = "http_keyword target must be https://host/path|keyword"
			break
		}
		u, err := neturl.Parse(urlValue)
		if err != nil || u.Host == "" || (u.Scheme != "http" && u.Scheme != "https") {
			fields["target"] = "http_keyword URL must start with http:// or https://"
		} else if normalizeTrim(keyword) == "" {
			fields["target"] = "http_keyword must include a non-empty keyword after |"
		}
	case "http_json_query":
		urlValue, path, expected, err := parseHTTPJSONQueryTarget(in.Target)
		if err != nil {
			fields["target"] = "http_json_query target must be https://host/path|json.path|expected"
			break
		}
		u, err := neturl.Parse(urlValue)
		if err != nil || u.Host == "" || (u.Scheme != "http" && u.Scheme != "https") {
			fields["target"] = "http_json_query URL must start with http:// or https://"
		} else if normalizeTrim(path) == "" || normalizeTrim(expected) == "" {
			fields["target"] = "http_json_query must include non-empty path and expected value"
		}
	case "websocket":
		u, err := neturl.Parse(in.Target)
		if err != nil || u.Host == "" {
			fields["target"] = "websocket target must be a valid ws:// or wss:// URL"
			break
		}
		if u.Scheme != "ws" && u.Scheme != "wss" {
			fields["target"] = "websocket target must start with ws:// or wss://"
		}
	case "steam":
		host, port, err := parseSteamMonitorTarget(in.Target)
		if err != nil || host == "" || port == "" {
			fields["target"] = "steam target must be host:port"
		}
	case "docker":
		container, host, err := parseDockerMonitorTarget(in.Target)
		if err != nil || container == "" {
			fields["target"] = "docker target must be container-name or container-name|docker-host"
			break
		}
		lowerHost := normalizeLower(host)
		if lowerHost != "" &&
			!strings.HasPrefix(lowerHost, "unix://") &&
			!strings.HasPrefix(lowerHost, "tcp://") &&
			!strings.HasPrefix(lowerHost, "http://") &&
			!strings.HasPrefix(lowerHost, "https://") {
			fields["target"] = "docker host must start with unix://, tcp://, http://, or https://"
		}
	case "push":
		if normalizeTrim(in.Target) == "" {
			fields["target"] = "push target must be a non-empty token or name"
		}
	default:
		fields["type"] = "unsupported monitor type"
	}
	if len(fields) == 0 {
		return nil
	}
	return &monitorValidationError{
		Error:  "monitor validation failed",
		Fields: fields,
	}
}

func parseDNSMonitorTarget(target string) (string, string, error) {
	parts := strings.SplitN(strings.TrimSpace(target), "|", 2)
	host := strings.TrimSpace(parts[0])
	if host == "" {
		return "", "", fmt.Errorf("missing host")
	}
	recordType := "A"
	if len(parts) == 2 {
		recordType = strings.ToUpper(strings.TrimSpace(parts[1]))
	}
	return host, recordType, nil
}

func parseTLSMonitorTarget(target string) (string, string, error) {
	value := strings.TrimSpace(target)
	if value == "" {
		return "", "", fmt.Errorf("missing target")
	}
	if strings.Contains(value, "://") {
		u, err := neturl.Parse(value)
		if err != nil || u.Host == "" {
			return "", "", fmt.Errorf("invalid url")
		}
		host := u.Hostname()
		port := u.Port()
		if port == "" {
			port = "443"
		}
		return host, port, nil
	}
	host, port, err := net.SplitHostPort(value)
	if err == nil {
		return host, port, nil
	}
	return value, "443", nil
}

func parseSteamMonitorTarget(target string) (string, string, error) {
	value := strings.TrimSpace(target)
	if value == "" {
		return "", "", fmt.Errorf("missing target")
	}
	host, port, err := net.SplitHostPort(value)
	if err == nil {
		return strings.TrimSpace(host), strings.TrimSpace(port), nil
	}
	if strings.Contains(value, ":") {
		parts := strings.SplitN(value, ":", 2)
		if len(parts) == 2 && strings.TrimSpace(parts[0]) != "" && strings.TrimSpace(parts[1]) != "" {
			return strings.TrimSpace(parts[0]), strings.TrimSpace(parts[1]), nil
		}
	}
	return "", "", fmt.Errorf("steam target must be host:port")
}

func parseDockerMonitorTarget(target string) (string, string, error) {
	parts := strings.SplitN(strings.TrimSpace(target), "|", 2)
	container := strings.TrimSpace(parts[0])
	if container == "" {
		return "", "", fmt.Errorf("missing container")
	}
	host := ""
	if len(parts) == 2 {
		host = strings.TrimSpace(parts[1])
	}
	return container, host, nil
}

func parseHTTPKeywordTarget(target string) (string, string, error) {
	parts := strings.SplitN(strings.TrimSpace(target), "|", 2)
	if len(parts) != 2 {
		return "", "", fmt.Errorf("missing separator")
	}
	urlValue := strings.TrimSpace(parts[0])
	keyword := strings.TrimSpace(parts[1])
	if urlValue == "" || keyword == "" {
		return "", "", fmt.Errorf("invalid value")
	}
	return urlValue, keyword, nil
}

func parseHTTPJSONQueryTarget(target string) (string, string, string, error) {
	parts := strings.SplitN(strings.TrimSpace(target), "|", 3)
	if len(parts) != 3 {
		return "", "", "", fmt.Errorf("missing segments")
	}
	urlValue := strings.TrimSpace(parts[0])
	path := strings.TrimSpace(parts[1])
	expected := strings.TrimSpace(parts[2])
	if urlValue == "" || path == "" || expected == "" {
		return "", "", "", fmt.Errorf("invalid value")
	}
	return urlValue, path, expected, nil
}

func (c *Controller) CreateMonitor(r web.Context) error {
	var in monitorInput
	if err := r.Bind(&in); err != nil {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "invalid payload"})
	}
	in = normalizeMonitorInput(in)
	in.Target = canonicalTargetFromInput(in)
	if validationErr := validateMonitorInput(in); validationErr != nil {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": validationErr.Error, "fields": validationErr.Fields})
	}
	channelIDs, channelErrFields := c.normalizeAndValidateChannelIDs(in.NotificationChannelIDs)
	if len(channelErrFields) > 0 {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "monitor validation failed", "fields": channelErrFields})
	}
	duplicateCount, err := c.monitorRepo.WithContext(r.Context()).CountByTypeAndTarget(in.Type, in.Target)
	if err != nil {
		return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	if duplicateCount > 0 {
		return r.JSON(http.StatusConflict, map[string]any{
			"ok":    false,
			"error": "monitor validation failed",
			"fields": map[string]string{
				"target": "type + target must be unique",
			},
		})
	}
	normalizedTarget, err := normalizeMonitorTarget(in.Type, in.Target)
	if err != nil {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": err.Error()})
	}
	maintenanceStartsAt, maintenanceEndsAt, err := monitorMaintenanceTimesFromInput(in)
	if err != nil {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": err.Error()})
	}
	now := time.Now().UTC()
	model := &models.Monitor{
		Name:            in.Name,
		MonitorType:     in.Type,
		NotificationChannelIDsRaw: models.SerializeNotificationChannelIDs(channelIDs),
		IntervalSeconds: in.IntervalSeconds,
		TimeoutMs:       in.TimeoutMS,
		RetryAttempts:   in.RetryAttempts,
		RetryBackoffMs:  in.RetryBackoffMS,
		ScheduleJitterMs: in.ScheduleJitterMS,
		DownConfirmAttempts: in.DownConfirmAttempts,
		RecoveryConfirmAttempts: in.RecoveryConfirmAttempts,
		ResendIntervalChecks: in.ResendIntervalChecks,
		MaintenanceStartsAt: maintenanceStartsAt,
		MaintenanceEndsAt: maintenanceEndsAt,
		Enabled:         in.Enabled,
		CreatedAt:       now,
		UpdatedAt:       now,
	}
	applyNormalizedMonitorTarget(model, normalizedTarget)
	if err := c.monitorRepo.WithContext(r.Context()).Create(model); err != nil {
		return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	id := strconv.FormatInt(model.Id, 10)
	if !in.Enabled {
		_ = c.ensurePausedCheck(r.Context(), id, now)
	}
	return r.JSON(http.StatusCreated, map[string]any{"ok": true, "id": id})
}

func (c *Controller) UpdateMonitor(r web.Context) error {
	monitorID := r.Param("id")
	if monitorID == "" {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "missing monitor id"})
	}
	var in monitorInput
	if err := r.Bind(&in); err != nil {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "invalid payload"})
	}
	in = normalizeMonitorInput(in)
	in.Target = canonicalTargetFromInput(in)
	if validationErr := validateMonitorInput(in); validationErr != nil {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": validationErr.Error, "fields": validationErr.Fields})
	}
	channelIDs, channelErrFields := c.normalizeAndValidateChannelIDs(in.NotificationChannelIDs)
	if len(channelErrFields) > 0 {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "monitor validation failed", "fields": channelErrFields})
	}
	duplicateCount, err := c.monitorRepo.WithContext(r.Context()).CountByTypeAndTargetExcludingID(in.Type, in.Target, monitorID)
	if err != nil {
		return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	if duplicateCount > 0 {
		return r.JSON(http.StatusConflict, map[string]any{
			"ok":    false,
			"error": "monitor validation failed",
			"fields": map[string]string{
				"target": "type + target must be unique",
			},
		})
	}
	normalizedTarget, err := normalizeMonitorTarget(in.Type, in.Target)
	if err != nil {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": err.Error()})
	}
	maintenanceStartsAt, maintenanceEndsAt, err := monitorMaintenanceTimesFromInput(in)
	if err != nil {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": err.Error()})
	}
	current, err := c.monitorRepo.WithContext(r.Context()).ByID(monitorID)
	if err != nil {
		return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	if current == nil || monitorIDFromModel(current) == "" {
		return r.JSON(http.StatusNotFound, map[string]any{"ok": false, "error": "monitor not found"})
	}
	wasEnabled := current.Enabled
	current.Name = in.Name
	current.MonitorType = in.Type
	applyNormalizedMonitorTarget(current, normalizedTarget)
	current.IntervalSeconds = in.IntervalSeconds
	current.TimeoutMs = in.TimeoutMS
	current.RetryAttempts = in.RetryAttempts
	current.RetryBackoffMs = in.RetryBackoffMS
	current.ScheduleJitterMs = in.ScheduleJitterMS
	current.DownConfirmAttempts = in.DownConfirmAttempts
	current.RecoveryConfirmAttempts = in.RecoveryConfirmAttempts
	current.ResendIntervalChecks = in.ResendIntervalChecks
	current.MaintenanceStartsAt = maintenanceStartsAt
	current.MaintenanceEndsAt = maintenanceEndsAt
	current.NotificationChannelIDsRaw = models.SerializeNotificationChannelIDs(channelIDs)
	current.Enabled = in.Enabled
	current.UpdatedAt = time.Now().UTC()
	if err := c.monitorRepo.WithContext(r.Context()).Update(current); err != nil {
		return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	now := time.Now().UTC()
	if wasEnabled && !in.Enabled {
		_ = c.ensurePausedCheck(r.Context(), monitorID, now)
	}
	return r.JSON(http.StatusOK, map[string]any{"ok": true, "id": monitorID})
}

func (c *Controller) SetMonitorEnabled(r web.Context) error {
	monitorID := r.Param("id")
	if monitorID == "" {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "missing monitor id"})
	}
	var input struct {
		Enabled bool `json:"enabled"`
	}
	if err := r.Bind(&input); err != nil {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "invalid payload"})
	}
	current, err := c.monitorRepo.WithContext(r.Context()).ByID(monitorID)
	if err != nil {
		return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	if current == nil || monitorIDFromModel(current) == "" {
		return r.JSON(http.StatusNotFound, map[string]any{"ok": false, "error": "monitor not found"})
	}
	if !input.Enabled && current.Enabled {
		now := time.Now().UTC()
		if err := c.ensurePausedCheck(r.Context(), monitorID, now); err != nil {
			return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
		}
	}
	current.Enabled = input.Enabled
	current.UpdatedAt = time.Now().UTC()
	if err := c.monitorRepo.WithContext(r.Context()).Update(current); err != nil {
		return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	return r.JSON(http.StatusOK, map[string]any{"ok": true, "id": monitorID, "enabled": input.Enabled})
}

func (c *Controller) DeleteMonitor(r web.Context) error {
	monitorID := r.Param("id")
	if monitorID == "" {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "missing monitor id"})
	}

	conn, err := c.db.Default()
	if err != nil {
		return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	conn = conn.WithContext(r.Context())

	err = conn.Transaction(func(tx *gorm.DB) error {
		monitorPK, parseErr := strconv.ParseInt(strings.TrimSpace(monitorID), 10, 64)
		if parseErr != nil || monitorPK <= 0 {
			return gorm.ErrRecordNotFound
		}
		if err := tx.Where("monitor_id = ?", monitorPK).Delete(&models.MonitorCheck{}).Error; err != nil {
			return err
		}
		if err := tx.Where("monitor_id = ?", monitorPK).Delete(&models.Incident{}).Error; err != nil {
			return err
		}
		if err := tx.Where("monitor_id = ?", monitorPK).Delete(&models.MonitorCheckRollup{}).Error; err != nil {
			return err
		}
		if err := tx.Where("monitor_id = ?", monitorPK).Delete(&models.AlertDispatchEvent{}).Error; err != nil {
			return err
		}
		result := tx.Where("id = ?", monitorID).Delete(&models.Monitor{})
		if result.Error != nil {
			return result.Error
		}
		if result.RowsAffected == 0 {
			return gorm.ErrRecordNotFound
		}
		return nil
	})
	if errors.Is(err, gorm.ErrRecordNotFound) {
		return r.JSON(http.StatusNotFound, map[string]any{"ok": false, "error": "monitor not found"})
	}
	if err != nil {
		return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	return r.JSON(http.StatusOK, map[string]any{"ok": true, "id": monitorID})
}

func (c *Controller) MonitorPush(r web.Context) error {
	monitorID := normalizeTrim(r.Param("id"))
	if monitorID == "" {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "missing monitor id"})
	}

	monitor, err := c.monitorRepo.WithContext(r.Context()).ByID(monitorID)
	if err != nil || monitor == nil {
		return r.JSON(http.StatusNotFound, map[string]any{"ok": false, "error": "monitor not found"})
	}
	if normalizeLower(monitor.MonitorType) != "push" {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "monitor is not push type"})
	}
	now := time.Now().UTC()

	var payload struct {
		Status     string `json:"status"`
		StatusCode *int   `json:"status_code"`
		LatencyMS  *int64 `json:"latency_ms"`
		Message    string `json:"message"`
	}
	if bindErr := r.Bind(&payload); bindErr != nil && bindErr != io.EOF {
		return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "invalid payload"})
	}

	status := normalizeLower(payload.Status)
	if status == "" {
		status = normalizeLower(r.Query("status"))
	}
	switch status {
	case "up", "down", "paused", "unknown":
	default:
		if status == "" {
			status = "up"
		} else {
			return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "status must be one of up, down, paused, unknown"})
		}
	}

	var latency int64
	if payload.LatencyMS != nil {
		latency = *payload.LatencyMS
	} else if q := normalizeTrim(r.Query("latency_ms")); q != "" {
		if _, parseErr := fmt.Sscanf(q, "%d", &latency); parseErr != nil {
			return r.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "latency_ms must be an integer"})
		}
	}
	if latency < 0 {
		latency = 0
	}

	check := &models.MonitorCheck{
		MonitorId:  monitor.Id,
		CheckedAt:  now,
		Status:     status,
		DurationMs: null.IntFrom(latency),
	}
	if payload.StatusCode != nil {
		check.StatusCode = null.IntFrom(int64(*payload.StatusCode))
	} else if status == "up" {
		check.StatusCode = null.IntFrom(200)
	} else if status == "down" {
		check.StatusCode = null.IntFrom(503)
	}
	if msg := normalizeTrim(payload.Message); msg != "" {
		check.ErrorMessage = null.StringFrom(msg)
	} else {
		check.ErrorMessage = null.String{}
	}

	if err := c.monitorCheckRepo.WithContext(r.Context()).Create(check); err != nil {
		return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	globalMaintenance := c.monitoringMaintenanceWindow(r.Context(), now)
	maintenanceMode := maintenanceActive(globalMaintenance, monitor.MaintenanceStartsAt, monitor.MaintenanceEndsAt, now)
	channelIDs := models.ParseNotificationChannelIDs(monitor.NotificationChannelIDsRaw)
	transitionPayload := monitorTransition{
		MonitorID:    monitorID,
		MonitorName:  monitor.Name,
		MonitorType:  monitor.MonitorType,
		Target:       monitor.Target,
		CheckedAt:    now,
		ChannelIDs:   channelIDs,
		ErrorMessage: normalizeTrim(payload.Message),
		DurationMs:   latency,
	}
	downConfirm := monitor.DownConfirmAttempts
	if downConfirm <= 0 {
		downConfirm = 1
	}
	recoveryConfirm := monitor.RecoveryConfirmAttempts
	if recoveryConfirm <= 0 {
		recoveryConfirm = 1
	}
	resendEvery := monitor.ResendIntervalChecks
	if resendEvery < 0 {
		resendEvery = 0
	}

	if status == "down" {
		streak, streakErr := c.consecutiveStatusCount(r.Context(), monitorID, "down", monitorPushStreakScanLimit)
		if streakErr != nil {
			return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": streakErr.Error()})
		}
		if streak >= downConfirm {
			if maintenanceMode {
				return r.JSON(http.StatusAccepted, map[string]any{
					"ok":         true,
					"id":         monitorID,
					"status":     status,
					"checked_at": now.Format(time.RFC3339),
				})
			}
			transition, transitionErr := c.incidentTransitions.MarkDown(r.Context(), monitorID, now, "push monitor reported down")
			if transitionErr != nil {
				return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": transitionErr.Error()})
			}
			if transition.Changed {
				transitionPayload.Event = "monitor.down"
				transitionPayload.Status = "down"
				transitionPayload.IncidentID = transition.IncidentID
				transitionPayload.Summary = transition.Summary
					c.publishMonitorDown(r.Context(), transitionPayload)
				c.enqueueMonitorAlert(r.Context(), transitionPayload)
			} else if resendEvery > 0 && streak >= resendEvery && streak%resendEvery == 0 {
				transitionPayload.Event = "monitor.still_down"
				transitionPayload.Status = "down"
				transitionPayload.IncidentID = transition.IncidentID
				transitionPayload.Summary = "Monitor remains down"
				c.enqueueMonitorAlert(r.Context(), transitionPayload)
			}
		}
	} else if status == "up" {
		streak, streakErr := c.consecutiveStatusCount(r.Context(), monitorID, "up", monitorPushStreakScanLimit)
		if streakErr != nil {
			return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": streakErr.Error()})
		}
		if streak >= recoveryConfirm {
			openIncidents, openErr := c.incidentTransitions.OpenByMonitorIDs(r.Context(), []string{monitorID})
			if openErr != nil {
				return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": openErr.Error()})
			}
			if len(openIncidents) == 0 {
				return r.JSON(http.StatusAccepted, map[string]any{
					"ok":         true,
					"id":         monitorID,
					"status":     status,
					"checked_at": now.Format(time.RFC3339),
				})
			}
			transition, transitionErr := c.incidentTransitions.MarkRecovered(r.Context(), monitorID, now)
			if transitionErr != nil {
				return r.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": transitionErr.Error()})
			}
			if transition.Changed {
				transitionPayload.Event = "monitor.recovered"
				transitionPayload.Status = "up"
				transitionPayload.IncidentID = transition.IncidentID
				transitionPayload.Summary = transition.Summary
				transitionPayload.ErrorMessage = ""
					c.publishMonitorRecovered(r.Context(), transitionPayload)
				if !maintenanceMode {
					c.enqueueMonitorAlert(r.Context(), transitionPayload)
				}
			}
		}
	}

	return r.JSON(http.StatusAccepted, map[string]any{
		"ok":         true,
		"id":         monitorID,
		"status":     status,
		"checked_at": now.Format(time.RFC3339),
	})
}

func (c *Controller) consecutiveStatusCount(ctx stdcontext.Context, monitorID, target string, limit int) (int, error) {
	rows, err := c.monitorCheckRepo.WithContext(ctx).LatestByMonitor(monitorID, limit)
	if err != nil {
		return 0, err
	}
	count := 0
	for _, row := range rows {
		state := strings.ToLower(strings.TrimSpace(row.Status))
		if state == "paused" || state == "unknown" || state == "" || state == "pending" {
			continue
		}
		if state != target {
			break
		}
		count++
	}
	return count, nil
}

