func (c *Controller) CheckNow(ctx echo.Context) error {
	monitorID := ctx.Param("id")
	if monitorID == "" {
		return ctx.JSON(http.StatusBadRequest, map[string]any{"ok": false, "error": "missing monitor id"})
	}
	c.checkNowMu.Lock()
	last := c.checkNowLast[monitorID]
	now := time.Now().UTC()
	if !last.IsZero() && now.Sub(last) < 5*time.Second {
		c.checkNowMu.Unlock()
		return ctx.JSON(http.StatusTooManyRequests, map[string]any{"ok": false, "error": "check-now is rate limited (5s)"})
	}
	c.checkNowLast[monitorID] = now
	c.checkNowMu.Unlock()
	if err := c.monitorCheck.Queue(monitorID); err != nil {
		return ctx.JSON(http.StatusInternalServerError, map[string]any{"ok": false, "error": err.Error()})
	}
	return ctx.JSON(http.StatusAccepted, map[string]any{"ok": true, "queued": monitorID})
}
