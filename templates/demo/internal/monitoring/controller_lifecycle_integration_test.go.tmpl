func TestCheckNow_SyncModeReturnsSummary(t *testing.T) {
	h := newControllerLifecycleHarness(t)
	job := NewMonitorCheckJob(nil, logger.NewSilentLogger(), h.monitorRepo, h.appSettingRepo, nil)
	h.controller = NewController(
		logger.NewSilentLogger(),
		h.conns,
		h.storage,
		h.monitorRepo,
		h.monitorCheckRepo,
		h.incidentRepo,
		h.incidentTransitions,
		h.channelRepo,
		h.appSettingRepo,
		h.alertDispatchEventRepo,
		nil,
		job,
		(*alerts.DispatchJob)(nil),
	)

	now := time.Now().UTC()
	monitor := &models.Monitor{
		Name:                    "HTTP Monitor",
		MonitorType:             "http",
		Target:                  "https://example.com",
		IntervalSeconds:         60,
		TimeoutMs:               5000,
		RetryAttempts:           1,
		RetryBackoffMs:          250,
		ScheduleJitterMs:        150,
		DownConfirmAttempts:     1,
		RecoveryConfirmAttempts: 1,
		ResendIntervalChecks:    0,
		Enabled:                 true,
		CreatedAt:               now,
		UpdatedAt:               now,
	}
	if err := h.monitorRepo.Create(monitor); err != nil {
		t.Fatalf("create monitor: %v", err)
	}

	rec := h.doJSON(http.MethodPost, "/monitoring/monitors/:id/check-now?sync=1", nil, h.controller.CheckNow, map[string]string{"id": fmt.Sprint(monitor.Id)})
	if rec.Code != http.StatusOK {
		t.Fatalf("check-now sync failed: code=%d body=%s", rec.Code, rec.Body.String())
	}
	payload := h.decodeJSON(rec)
	if payload["mode"] != "sync" {
		t.Fatalf("expected sync mode, got %v", payload["mode"])
	}
	if intValue(payload["total"]) != 1 {
		t.Fatalf("expected total=1, got %v", payload["total"])
	}
}
