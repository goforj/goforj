func TestCreateAndUpdateMonitor_PersistsNotificationChannelSelection(t *testing.T) {
	h := newControllerLifecycleHarness(t)
	ch1, err := h.channelRepo.Upsert(notification.UpsertChannelInput{
		Name:      "Default Log",
		Provider:  notification.ProviderLog,
		IsEnabled: true,
		Config:    map[string]string{},
	})
	if err != nil {
		t.Fatalf("upsert channel 1: %v", err)
	}
	ch2, err := h.channelRepo.Upsert(notification.UpsertChannelInput{
		Name:      "Secondary Log",
		Provider:  notification.ProviderLog,
		IsEnabled: true,
		Config:    map[string]string{},
	})
	if err != nil {
		t.Fatalf("upsert channel 2: %v", err)
	}

	createPayload := map[string]any{
		"name":                     "API",
		"type":                     "http",
		"target":                   "https://example.com",
		"interval_seconds":         60,
		"timeout_ms":               5000,
		"retry_attempts":           1,
		"retry_backoff_ms":         250,
		"schedule_jitter_ms":       150,
		"down_confirm_attempts":    1,
		"recovery_confirm_attempts": 1,
		"resend_interval_checks":   0,
		"enabled":                  true,
		"notification_channel_ids": []int64{ch1.ID, ch2.ID},
	}
	createRec := h.doJSON(http.MethodPost, "/monitoring/monitors", createPayload, h.controller.CreateMonitor, nil)
	if createRec.Code != http.StatusCreated {
		t.Fatalf("create monitor failed: code=%d body=%s", createRec.Code, createRec.Body.String())
	}
	created := h.decodeJSON(createRec)
	monitorID, _ := created["id"].(string)
	if monitorID == "" {
		t.Fatalf("expected created monitor id in response: %v", created)
	}

	detail, err := h.monitorRepo.DetailByID(monitorID)
	if err != nil {
		t.Fatalf("detail after create: %v", err)
	}
	if len(detail.NotificationChannelIDs) != 2 || detail.NotificationChannelIDs[0] != ch1.ID || detail.NotificationChannelIDs[1] != ch2.ID {
		t.Fatalf("unexpected channel ids after create: %+v", detail.NotificationChannelIDs)
	}

	updatePayload := map[string]any{
		"name":                     "API",
		"type":                     "http",
		"target":                   "https://example.com",
		"interval_seconds":         60,
		"timeout_ms":               5000,
		"retry_attempts":           1,
		"retry_backoff_ms":         250,
		"schedule_jitter_ms":       150,
		"down_confirm_attempts":    1,
		"recovery_confirm_attempts": 1,
		"resend_interval_checks":   0,
		"enabled":                  true,
		"notification_channel_ids": []int64{ch2.ID},
	}
	updateRec := h.doJSON(http.MethodPut, "/monitoring/monitors/:id", updatePayload, h.controller.UpdateMonitor, map[string]string{"id": monitorID})
	if updateRec.Code != http.StatusOK {
		t.Fatalf("update monitor failed: code=%d body=%s", updateRec.Code, updateRec.Body.String())
	}

	updated, err := h.monitorRepo.DetailByID(monitorID)
	if err != nil {
		t.Fatalf("detail after update: %v", err)
	}
	if len(updated.NotificationChannelIDs) != 1 || updated.NotificationChannelIDs[0] != ch2.ID {
		t.Fatalf("unexpected channel ids after update: %+v", updated.NotificationChannelIDs)
	}
}

type controllerLifecycleHarness struct {
	e                      *echo.Echo
	conns                  *database.Connections
	storage                *storages.Manager
	cache                  *caches.Manager
	controller             *Controller
	monitorRepo            *models.MonitorRepo
	monitorCheckRepo       *models.MonitorCheckRepo
	incidentRepo           *models.IncidentRepo
	incidentTransitions    *IncidentTransitionService
	channelRepo            *notification.ChannelRepo
	appSettingRepo         *appsettings.AppSettingRepo
	alertDispatchEventRepo *models.AlertDispatchEventRepo
}

func newControllerLifecycleHarness(t *testing.T) controllerLifecycleHarness {
	t.Helper()
	t.Setenv("DB_DRIVER", "sqlite")
	t.Setenv("DB_DATABASE", filepath.Join(t.TempDir(), "monitoring-controller-lifecycle.sqlite"))
	t.Setenv("DB_QUERY_LOGGING", "false")

	conns := database.NewConnections()
	db, err := conns.Default()
	if err != nil {
		t.Fatalf("open db: %v", err)
	}
	if err := db.AutoMigrate(
		&appsettings.AppSetting{},
		&notification.Channel{},
		&models.Monitor{},
		&models.MonitorCheck{},
		&models.Incident{},
		&models.MonitorCheckRollup{},
		&models.AlertDispatchEvent{},
	); err != nil {
		t.Fatalf("automigrate: %v", err)
	}

	monitorRepo := models.NewMonitorRepo(conns)
	monitorCheckRepo := models.NewMonitorCheckRepo(conns)
	incidentRepo := models.NewIncidentRepo(conns)
	incidentTransitions := NewIncidentTransitionService(logger.NewSilentLogger(), incidentRepo)
	channelRepo := notification.NewChannelRepo(conns, caches)
	t.Setenv("CACHE_DRIVER", "memory")
	t.Setenv("CACHE_SETTINGS_DRIVER", "memory")
	t.Setenv("CACHE_NOTIFICATION_CHANNELS_DRIVER", "memory")
	caches, err := caches.NewManager()
	if err != nil {
		t.Fatalf("new cache manager: %v", err)
	}
	appSettingRepo := appsettings.NewAppSettingRepo(conns, caches)
	alertDispatchEventRepo := models.NewAlertDispatchEventRepo(conns)
	t.Setenv("STORAGE_DRIVER", "local")
	t.Setenv("STORAGE_ROOT", filepath.Join(t.TempDir(), "private"))
	t.Setenv("STORAGE_PUBLIC_DRIVER", "local")
	t.Setenv("STORAGE_PUBLIC_ROOT", filepath.Join(t.TempDir(), "public"))
	t.Setenv("STORAGE_FAVICONS_DRIVER", "local")
	t.Setenv("STORAGE_FAVICONS_ROOT", filepath.Join(t.TempDir(), "favicons"))
	storage, err := storages.NewManager()
	if err != nil {
		t.Fatalf("new storage manager: %v", err)
	}

	controller := NewController(
		logger.NewSilentLogger(),
		conns,
		storage,
		monitorRepo,
		monitorCheckRepo,
		incidentRepo,
		incidentTransitions,
		channelRepo,
		appSettingRepo,
		alertDispatchEventRepo,
		nil,
		{{- if .Components.Jobs }}
		nil,
		nil,
		{{- end }}
	)

	return controllerLifecycleHarness{
		e:                      echo.New(),
		conns:                  conns,
		storage:                storage,
		cache:                  caches,
		controller:             controller,
		monitorRepo:            monitorRepo,
		monitorCheckRepo:       monitorCheckRepo,
		incidentRepo:           incidentRepo,
		incidentTransitions:    incidentTransitions,
		channelRepo:            channelRepo,
		appSettingRepo:         appSettingRepo,
		alertDispatchEventRepo: alertDispatchEventRepo,
	}
}

func (h controllerLifecycleHarness) doJSON(
	method, path string,
	body any,
	handler echo.HandlerFunc,
	params map[string]string,
) *httptest.ResponseRecorder {
	var payload []byte
	if body != nil {
		payload, _ = json.Marshal(body)
	}
	req := httptest.NewRequest(method, path, bytes.NewReader(payload))
	req.Header.Set(echo.HeaderContentType, echo.MIMEApplicationJSON)
	rec := httptest.NewRecorder()
	ctx := h.e.NewContext(req, rec)

	if len(params) > 0 {
		names := make([]string, 0, len(params))
		values := make([]string, 0, len(params))
		for k, v := range params {
			names = append(names, k)
			values = append(values, v)
		}
		ctx.SetParamNames(names...)
		ctx.SetParamValues(values...)
	}

	if err := handler(ctx); err != nil {
		rec.Code = http.StatusInternalServerError
		_, _ = rec.WriteString(err.Error())
	}
	return rec
}

func (h controllerLifecycleHarness) decodeJSON(rec *httptest.ResponseRecorder) map[string]any {
	out := map[string]any{}
	_ = json.Unmarshal(rec.Body.Bytes(), &out)
	return out
}

func intValue(v any) int {
	switch n := v.(type) {
	case float64:
		return int(n)
	case int:
		return n
	default:
		return 0
	}
}
