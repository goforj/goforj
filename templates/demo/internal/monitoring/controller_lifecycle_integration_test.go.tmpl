func TestSetMonitorEnabled_PauseThenResumeKeepsSinglePausedMarker(t *testing.T) {
	h := newControllerLifecycleHarness(t)
	now := time.Now().UTC()
	monitor := &models.Monitor{
		Name:                    "API",
		MonitorType:             "http",
		Target:                  "https://example.com",
		IntervalSeconds:         60,
		TimeoutMs:               5000,
		RetryAttempts:           1,
		RetryBackoffMs:          250,
		ScheduleJitterMs:        150,
		DownConfirmAttempts:     1,
		RecoveryConfirmAttempts: 1,
		ResendIntervalChecks:    0,
		Enabled:                 true,
		CreatedAt:               now,
		UpdatedAt:               now,
	}
	if err := h.monitorRepo.Create(monitor); err != nil {
		t.Fatalf("create monitor: %v", err)
	}

	monitorID := fmt.Sprint(monitor.Id)
	rec := h.doJSON(http.MethodPatch, "/monitoring/monitors/:id/enabled", map[string]any{"enabled": false}, h.controller.SetMonitorEnabled, map[string]string{"id": monitorID})
	if rec.Code != http.StatusOK {
		t.Fatalf("disable monitor failed: code=%d body=%s", rec.Code, rec.Body.String())
	}

	rows, err := h.monitorCheckRepo.LatestByMonitor(monitorID, 5)
	if err != nil {
		t.Fatalf("latest checks after disable: %v", err)
	}
	if len(rows) == 0 || rows[0].Status != "paused" {
		t.Fatalf("expected latest check to be paused after disable, got %+v", rows)
	}

	rec = h.doJSON(http.MethodPatch, "/monitoring/monitors/:id/enabled", map[string]any{"enabled": true}, h.controller.SetMonitorEnabled, map[string]string{"id": monitorID})
	if rec.Code != http.StatusOK {
		t.Fatalf("enable monitor failed: code=%d body=%s", rec.Code, rec.Body.String())
	}

	after, err := h.monitorCheckRepo.LatestByMonitor(monitorID, 10)
	if err != nil {
		t.Fatalf("latest checks after enable: %v", err)
	}
	pausedCount := 0
	for i := range after {
		if after[i].Status == "paused" {
			pausedCount++
		}
	}
	if pausedCount != 1 {
		t.Fatalf("expected exactly one paused marker after pause/resume, got %d", pausedCount)
	}
}

func TestMonitorsAndHeartbeats_ShowActiveMaintenanceWindow(t *testing.T) {
	h := newControllerLifecycleHarness(t)
	now := time.Now().UTC()
	monitor := &models.Monitor{
		Name:                    "API",
		MonitorType:             "http",
		Target:                  "https://example.com",
		IntervalSeconds:         60,
		TimeoutMs:               5000,
		RetryAttempts:           1,
		RetryBackoffMs:          250,
		ScheduleJitterMs:        150,
		DownConfirmAttempts:     1,
		RecoveryConfirmAttempts: 1,
		ResendIntervalChecks:    0,
		MaintenanceStartsAt:     ptrTime(now.Add(-10 * time.Minute)),
		MaintenanceEndsAt:       ptrTime(now.Add(20 * time.Minute)),
		Enabled:                 true,
		CreatedAt:               now,
		UpdatedAt:               now,
	}
	if err := h.monitorRepo.Create(monitor); err != nil {
		t.Fatalf("create monitor: %v", err)
	}

	if err := h.monitorCheckRepo.Create(&models.MonitorCheck{
		MonitorId:    monitor.Id,
		CheckedAt:    now.Add(-30 * time.Second),
		Status:       "up",
		StatusCode:   null.IntFrom(200),
		DurationMs:   null.IntFrom(7),
		ErrorMessage: null.String{},
	}); err != nil {
		t.Fatalf("seed check: %v", err)
	}

	rec := h.doJSON(http.MethodGet, "/monitoring/monitors", nil, h.controller.Monitors, nil)
	if rec.Code != http.StatusOK {
		t.Fatalf("monitors failed: code=%d body=%s", rec.Code, rec.Body.String())
	}
	payload := h.decodeJSON(rec)
	rows, _ := payload["monitors"].([]any)
	if len(rows) != 1 {
		t.Fatalf("expected one monitor row, got %#v", payload["monitors"])
	}
	first, _ := rows[0].(map[string]any)
	if got := fmt.Sprint(first["last_status"]); got != "maintenance" {
		t.Fatalf("expected maintenance status, got %q", got)
	}

	rec = h.doJSON(http.MethodGet, "/monitoring/heartbeats?limit=6", nil, h.controller.Heartbeats, nil)
	if rec.Code != http.StatusOK {
		t.Fatalf("heartbeats failed: code=%d body=%s", rec.Code, rec.Body.String())
	}
	payload = h.decodeJSON(rec)
	beats, _ := payload["heartbeats"].(map[string]any)
	series, _ := beats[fmt.Sprint(monitor.Id)].([]any)
	if len(series) == 0 {
		t.Fatalf("expected heartbeat series for monitor")
	}
	if got := fmt.Sprint(series[len(series)-1]); got != "maintenance" {
		t.Fatalf("expected newest heartbeat bucket to be maintenance, got %q", got)
	}
}

