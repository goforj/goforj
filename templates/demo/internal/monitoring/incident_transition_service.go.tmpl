package monitoring

import (
	"context"
	"errors"
	"fmt"
	"strconv"
	"strings"
	"sync/atomic"
	"time"

	"github.com/goforj/null/v6"
	"gorm.io/gorm"
	"{{.GoModuleName}}/internal/logger"
	"{{.GoModuleName}}/internal/models"
)

type IncidentTransition struct {
	Changed    bool
	Event      string
	IncidentID string
	Summary    string
}

type IncidentTransitionService struct {
	logger       *logger.AppLogger
	incidentRepo *models.IncidentRepo
}

var incidentTransitionSeq uint64

func NewIncidentTransitionService(
	logger *logger.AppLogger,
	incidentRepo *models.IncidentRepo,
) *IncidentTransitionService {
	return &IncidentTransitionService{
		logger:       logger,
		incidentRepo: incidentRepo,
	}
}

func (s *IncidentTransitionService) OpenByMonitorIDs(ctx context.Context, monitorIDs []string) (map[string]models.Incident, error) {
	if s == nil || s.incidentRepo == nil {
		return map[string]models.Incident{}, nil
	}
	return s.incidentRepo.WithContext(ctx).OpenByMonitorIDs(monitorIDs)
}

func (s *IncidentTransitionService) MarkDown(ctx context.Context, monitorID string, when time.Time, summary string) (IncidentTransition, error) {
	out := IncidentTransition{Event: "monitor.down"}
	if s == nil || s.incidentRepo == nil || strings.TrimSpace(monitorID) == "" {
		return out, nil
	}
	if strings.TrimSpace(summary) == "" {
		summary = "Monitor transitioned to down state"
	}
	conn, err := s.incidentRepo.WithContext(ctx).Builder()
	if err != nil {
		return out, err
	}
	err = conn.Transaction(func(tx *gorm.DB) error {
		monitorPK, parseErr := strconv.ParseInt(strings.TrimSpace(monitorID), 10, 64)
		if parseErr != nil || monitorPK <= 0 {
			return gorm.ErrRecordNotFound
		}
		var existing models.Incident
		findErr := tx.Where("monitor_id = ? AND resolved_at IS NULL", monitorPK).
			Order("opened_at DESC").
			Limit(1).
			First(&existing).Error
		if findErr == nil {
			out.IncidentID = anyIDToString(existing.Id)
			out.Summary = existing.Summary
			return nil
		}
		if !errors.Is(findErr, gorm.ErrRecordNotFound) {
			return findErr
		}

		id := fmt.Sprintf("incident_%d-%d", when.UnixNano(), atomic.AddUint64(&incidentTransitionSeq, 1))
		model := &models.Incident{
			Id:        null.StringFrom(id),
			MonitorId: monitorPK,
			OpenedAt:  when.UTC(),
			Summary:   summary,
		}
		if createErr := tx.Create(model).Error; createErr != nil {
			if !isUniqueConstraintErr(createErr) {
				return createErr
			}
			// Another worker opened it first; treat as idempotent success.
			var raced models.Incident
			raceErr := tx.Where("monitor_id = ? AND resolved_at IS NULL", monitorPK).
				Order("opened_at DESC").
				Limit(1).
				First(&raced).Error
			if raceErr != nil {
				return raceErr
			}
			out.IncidentID = anyIDToString(raced.Id)
			out.Summary = raced.Summary
			return nil
		}
		out.Changed = true
		out.IncidentID = id
		out.Summary = summary
		return nil
	})
	return out, err
}

func (s *IncidentTransitionService) MarkRecovered(ctx context.Context, monitorID string, when time.Time) (IncidentTransition, error) {
	out := IncidentTransition{
		Event:   "monitor.recovered",
		Summary: "Monitor recovered",
	}
	if s == nil || s.incidentRepo == nil || strings.TrimSpace(monitorID) == "" {
		return out, nil
	}
	conn, err := s.incidentRepo.WithContext(ctx).Builder()
	if err != nil {
		return out, err
	}
	err = conn.Transaction(func(tx *gorm.DB) error {
		monitorPK, parseErr := strconv.ParseInt(strings.TrimSpace(monitorID), 10, 64)
		if parseErr != nil || monitorPK <= 0 {
			return gorm.ErrRecordNotFound
		}
		var existing models.Incident
		findErr := tx.Where("monitor_id = ? AND resolved_at IS NULL", monitorPK).
			Order("opened_at DESC").
			Limit(1).
			First(&existing).Error
		if errors.Is(findErr, gorm.ErrRecordNotFound) {
			return nil
		}
		if findErr != nil {
			return findErr
		}
		updates := map[string]any{"resolved_at": when.UTC()}
		res := tx.Model(&models.Incident{}).
			Where("id = ? AND resolved_at IS NULL", anyIDToString(existing.Id)).
			Updates(updates)
		if res.Error != nil {
			return res.Error
		}
		if res.RowsAffected == 0 {
			return nil
		}
		out.Changed = true
		out.IncidentID = anyIDToString(existing.Id)
		return nil
	})
	return out, err
}

func (s *IncidentTransitionService) MarkRecoveredByIncidentID(ctx context.Context, monitorID, incidentID string, when time.Time) (IncidentTransition, error) {
	out := IncidentTransition{
		Event:      "monitor.recovered",
		Summary:    "Monitor recovered",
		IncidentID: strings.TrimSpace(incidentID),
	}
	if s == nil || s.incidentRepo == nil || strings.TrimSpace(monitorID) == "" || strings.TrimSpace(incidentID) == "" {
		return out, nil
	}
	conn, err := s.incidentRepo.WithContext(ctx).Builder()
	if err != nil {
		return out, err
	}
	monitorPK, parseErr := strconv.ParseInt(strings.TrimSpace(monitorID), 10, 64)
	if parseErr != nil || monitorPK <= 0 {
		return out, nil
	}
	res := conn.Model(&models.Incident{}).
		Where("id = ? AND monitor_id = ? AND resolved_at IS NULL", incidentID, monitorPK).
		Updates(map[string]any{"resolved_at": when.UTC()})
	if res.Error != nil {
		return out, res.Error
	}
	out.Changed = res.RowsAffected > 0
	return out, nil
}

func isUniqueConstraintErr(err error) bool {
	if err == nil {
		return false
	}
	msg := strings.ToLower(err.Error())
	return strings.Contains(msg, "duplicate entry") ||
		strings.Contains(msg, "unique constraint failed") ||
		strings.Contains(msg, "violates unique constraint")
}

func anyIDToString(v any) string {
	switch value := v.(type) {
	case string:
		return strings.TrimSpace(value)
	case fmt.Stringer:
		return strings.TrimSpace(value.String())
	case int:
		return strconv.Itoa(value)
	case int64:
		return strconv.FormatInt(value, 10)
	case uint:
		return strconv.FormatUint(uint64(value), 10)
	case uint64:
		return strconv.FormatUint(value, 10)
	default:
		return strings.TrimSpace(fmt.Sprint(v))
	}
}
