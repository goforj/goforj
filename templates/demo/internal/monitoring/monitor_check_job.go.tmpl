package monitoring

import (
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"time"

	"github.com/goforj/str"
	"github.com/hibiken/asynq"
	"{{.GoModuleName}}/internal/logger"
	"{{.GoModuleName}}/internal/models"
)

const MonitorCheckJobTypeName = "monitoring:check"
const monitorQueueLookahead = 30 * time.Second

type MonitorCheckPayload struct {
	MonitorID string `json:"monitor_id"`
}

type PollRunSummary struct {
	Total            int
	Succeeded        int
	Failed           int
	FailedMonitorIDs []string
}

// MonitorCheckJob adapts asynq payload/queue semantics to the monitoring check service.
type MonitorCheckJob struct {
	queue       *asynq.Client
	logger      *logger.AppLogger
	monitorRepo *models.MonitorRepo
	service     *CheckService
}

func NewMonitorCheckJob(
	queue *asynq.Client,
	logger *logger.AppLogger,
	monitorRepo *models.MonitorRepo,
	service *CheckService,
) *MonitorCheckJob {
	return &MonitorCheckJob{
		queue:       queue,
		logger:      logger,
		monitorRepo: monitorRepo,
		service:     service,
	}
}

func (j *MonitorCheckJob) Queue(monitorID string) error {
	return j.QueueWithDelayUnique(monitorID, 0, 10*time.Second)
}

func (j *MonitorCheckJob) QueueWithDelay(monitorID string, delay time.Duration) error {
	return j.QueueWithDelayUnique(monitorID, delay, 0)
}

func (j *MonitorCheckJob) QueueWithDelayUnique(monitorID string, delay time.Duration, uniqueTTL time.Duration) error {
	payload, err := json.Marshal(MonitorCheckPayload{MonitorID: monitorID})
	if err != nil {
		return err
	}
	options := []asynq.Option{
		asynq.Timeout(2 * time.Minute),
		asynq.Queue("default"),
		asynq.MaxRetry(3),
	}
	if delay > 0 {
		options = append(options, asynq.ProcessIn(delay))
	}
	if uniqueTTL > 0 {
		options = append(options, asynq.Unique(uniqueTTL))
	}
	_, err = j.queue.Enqueue(asynq.NewTask(MonitorCheckJobTypeName, payload), options...)
	if errors.Is(err, asynq.ErrDuplicateTask) {
		return nil
	}
	return err
}

func (j *MonitorCheckJob) QueueDue() error {
	if j.monitorRepo == nil {
		return nil
	}
	monitors, err := j.monitorRepo.EnabledOrderedByName()
	if err != nil {
		return err
	}
	now := time.Now().UTC()
	for _, monitor := range monitors {
		monitorID := monitorIDString(&monitor)
		monitorType := str.Of(monitor.MonitorType).TrimSpace().ToLower().String()
		if monitorID == "" || monitorType == "push" {
			continue
		}
		interval := monitor.IntervalSeconds
		if interval <= 0 {
			interval = 60
		}
		intervalDur := time.Duration(interval) * time.Second
		nextDue := now.Truncate(intervalDur).Add(intervalDur)
		delay := nextDue.Sub(now)
		if delay > monitorQueueLookahead {
			continue
		}
		if delay < 0 {
			delay = 0
		}
		if monitor.ScheduleJitterMs > 0 {
			delay += deterministicJitter(now, monitorID, monitor.ScheduleJitterMs)
		}
		uniqueTTL := intervalDur + monitorQueueLookahead
		if uniqueTTL < 10*time.Second {
			uniqueTTL = 10 * time.Second
		}
		if err := j.QueueWithDelayUnique(monitorID, delay, uniqueTTL); err != nil {
			j.logger.Error().Err(err).Str("monitor_id", monitorID).Msg("queue monitor check failed")
			continue
		}
	}
	return nil
}

// QueueAllNow enqueues an immediate check for every enabled non-push monitor.
func (j *MonitorCheckJob) QueueAllNow() (int, error) {
	return j.QueueNow("")
}

// QueueNow enqueues an immediate check for one monitor or all when monitorID is empty.
func (j *MonitorCheckJob) QueueNow(monitorID string) (int, error) {
	if j.monitorRepo == nil {
		return 0, nil
	}
	monitors, err := j.pollTargets(monitorID)
	if err != nil {
		return 0, err
	}
	enqueued := 0
	for _, monitor := range monitors {
		monitorType := str.Of(monitor.MonitorType).TrimSpace().ToLower().String()
		monitorID := monitorIDString(&monitor)
		if monitorID == "" || monitorType == "push" {
			continue
		}
		if err := j.QueueWithDelayUnique(monitorID, 0, 10*time.Second); err != nil {
			j.logger.Error().Err(err).Str("monitor_id", monitorID).Msg("queue immediate monitor check failed")
			continue
		}
		enqueued++
	}
	return enqueued, nil
}

// RunNow executes poll checks synchronously for one monitor or all when monitorID is empty.
func (j *MonitorCheckJob) RunNow(ctx context.Context, monitorID string) (PollRunSummary, error) {
	summary := PollRunSummary{}
	if j.monitorRepo == nil || j.service == nil {
		return summary, nil
	}
	monitors, err := j.pollTargets(monitorID)
	if err != nil {
		return summary, err
	}
	summary.Total = len(monitors)
	for i := range monitors {
		monitor := monitors[i]
		id := monitorIDString(&monitor)
		if id == "" {
			continue
		}
		if err := j.service.CheckMonitor(ctx, &monitor); err != nil {
			summary.Failed++
			summary.FailedMonitorIDs = append(summary.FailedMonitorIDs, id)
			j.logger.Error().Err(err).Str("monitor_id", id).Msg("sync monitor check failed")
			continue
		}
		summary.Succeeded++
	}
	return summary, nil
}

func (j *MonitorCheckJob) TriggerPushMonitor() error {
	return j.service.TriggerPushMonitor()
}

func (j *MonitorCheckJob) pollTargets(monitorID string) ([]models.Monitor, error) {
	monitors, err := j.monitorRepo.EnabledOrderedByName()
	if err != nil {
		return nil, err
	}
	trimmed := str.Of(monitorID).TrimSpace().String()
	if trimmed == "" {
		filtered := make([]models.Monitor, 0, len(monitors))
		for i := range monitors {
			monitorType := str.Of(monitors[i].MonitorType).TrimSpace().ToLower().String()
			if monitorType == "push" {
				continue
			}
			filtered = append(filtered, monitors[i])
		}
		return filtered, nil
	}
	filtered := make([]models.Monitor, 0, 1)
	for i := range monitors {
		id := monitorIDString(&monitors[i])
		if id == "" {
			continue
		}
		if id != trimmed {
			continue
		}
		monitorType := str.Of(monitors[i].MonitorType).TrimSpace().ToLower().String()
		if monitorType == "push" {
			return nil, fmt.Errorf("monitor %s is push and not pollable", trimmed)
		}
		filtered = append(filtered, monitors[i])
		break
	}
	if len(filtered) == 0 {
		return nil, fmt.Errorf("monitor %s not found or not enabled", trimmed)
	}
	return filtered, nil
}

func (j *MonitorCheckJob) Handle(ctx context.Context, task *asynq.Task) error {
	var payload MonitorCheckPayload
	if err := json.Unmarshal(task.Payload(), &payload); err != nil {
		return fmt.Errorf("invalid payload: %w", asynq.SkipRetry)
	}
	if payload.MonitorID == "" {
		return fmt.Errorf("missing monitor id: %w", asynq.SkipRetry)
	}
	m, err := j.monitorRepo.ByID(payload.MonitorID)
	if err != nil {
		return err
	}
	return j.service.CheckMonitor(ctx, m)
}

func (j *MonitorCheckJob) LookupMonitorByID(monitorID string) (*models.Monitor, error) {
	if j.monitorRepo == nil || str.Of(monitorID).TrimSpace().String() == "" {
		return nil, nil
	}
	return j.monitorRepo.ByID(monitorID)
}
