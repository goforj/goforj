package monitoring

import (
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"strconv"
	"time"

	"github.com/goforj/str"
	"{{.GoModuleName}}/internal/appsettings"
	"{{.GoModuleName}}/internal/logger"
	"{{.GoModuleName}}/internal/models"
	"{{.GoModuleName}}/internal/queues"
	"github.com/goforj/queue"
	"gorm.io/gorm"
)

const MonitorCheckJobTypeName = "monitoring:check"
const monitorQueueLookahead = 30 * time.Second
const defaultMonitorPollBatchSize = 100
const maxMonitorPollBatchSize = 1000

type MonitorCheckPayload struct {
	MonitorID  string   `json:"monitor_id,omitempty"`
	MonitorIDs []string `json:"monitor_ids,omitempty"`
}

type PollRunSummary struct {
	Total            int
	Succeeded        int
	Failed           int
	FailedMonitorIDs []string
}

// MonitorCheckJob adapts queue payload semantics to the monitoring check service.
type MonitorCheckJob struct {
	queues         *queues.Manager
	logger         *logger.AppLogger
	schedulerLogger *logger.AppLogger
	monitorRepo    *models.MonitorRepo
	appSettingRepo *appsettings.AppSettingRepo
	service        *CheckService
}

func NewMonitorCheckJob(
	queues *queues.Manager,
	logger *logger.AppLogger,
	monitorRepo *models.MonitorRepo,
	appSettingRepo *appsettings.AppSettingRepo,
	service *CheckService,
) *MonitorCheckJob {
	schedulerLogger := logger
	if schedulerLogger != nil {
		schedulerLogger = schedulerLogger.WithComponent("Scheduler")
	}
	return &MonitorCheckJob{
		queues:         queues,
		logger:         logger,
		schedulerLogger: schedulerLogger,
		monitorRepo:    monitorRepo,
		appSettingRepo: appSettingRepo,
		service:        service,
	}
}

// Queue enqueues an immediate monitor check with default uniqueness.
func (j *MonitorCheckJob) Queue(ctx context.Context, monitorID string) error {
	return j.QueueWithDelayUnique(ctx, monitorID, 0, 10*time.Second)
}

// QueueWithDelay enqueues a monitor check with a delay and no uniqueness window.
func (j *MonitorCheckJob) QueueWithDelay(ctx context.Context, monitorID string, delay time.Duration) error {
	return j.QueueWithDelayUnique(ctx, monitorID, delay, 0)
}

// QueueWithDelayUnique enqueues a monitor check with delay and uniqueness controls.
func (j *MonitorCheckJob) QueueWithDelayUnique(ctx context.Context, monitorID string, delay time.Duration, uniqueTTL time.Duration) error {
	trimmed := str.Of(monitorID).TrimSpace().String()
	if trimmed == "" {
		return nil
	}
	return j.queueWithPayload(ctx, MonitorCheckPayload{MonitorIDs: []string{trimmed}}, delay, uniqueTTL)
}

func (j *MonitorCheckJob) queueWithPayload(ctx context.Context, payloadData MonitorCheckPayload, delay time.Duration, uniqueTTL time.Duration) error {
	payload, err := json.Marshal(payloadData)
	if err != nil {
		return err
	}
	job := queue.NewJob(MonitorCheckJobTypeName).
		Payload(payload).
		Timeout(2 * time.Minute).
		OnQueue("default").
		Retry(3)
	if delay > 0 {
		job = job.Delay(delay)
	}
	if uniqueTTL > 0 {
		job = job.UniqueFor(uniqueTTL)
	}
	_, err = j.queues.WithContext(ctx).Dispatch(job)
	if errors.Is(err, queue.ErrDuplicate) {
		return nil
	}
	return err
}

// QueueDue enqueues checks for monitors that are due in the lookahead window.
func (j *MonitorCheckJob) QueueDue(ctx context.Context) error {
	monitors, err := j.monitorRepo.WithContext(ctx).EnabledOrderedByName()
	if err != nil {
		return err
	}
	now := time.Now().UTC()
	monitorIDs := make([]string, 0, len(monitors))
	for _, monitor := range monitors {
		monitorID := monitorIDString(&monitor)
		monitorType := str.Of(monitor.MonitorType).TrimSpace().ToLower().String()
		if monitorID == "" || monitorType == "push" {
			continue
		}
		interval := monitor.IntervalSeconds
		if interval <= 0 {
			interval = 60
		}
		intervalDur := time.Duration(interval) * time.Second
		nextDue := now.Truncate(intervalDur).Add(intervalDur)
		delay := nextDue.Sub(now)
		if delay > monitorQueueLookahead {
			continue
		}
		if delay < 0 {
			delay = 0
		}
		if monitor.ScheduleJitterMs > 0 {
			delay += deterministicJitter(now, monitorID, monitor.ScheduleJitterMs)
		}
		uniqueTTL := intervalDur + monitorQueueLookahead
		if uniqueTTL < 10*time.Second {
			uniqueTTL = 10 * time.Second
		}
		_ = uniqueTTL // uniqueness is now enforced per batch payload.
		_ = delay     // delay scheduling is now handled by scheduler cadence + due filtering.
		monitorIDs = append(monitorIDs, monitorID)
	}
	return j.enqueueBatches(ctx, monitorIDs, 0, 10*time.Second)
}

// QueueAllNow enqueues an immediate check for every enabled non-push monitor.
func (j *MonitorCheckJob) QueueAllNow(ctx context.Context) (int, error) {
	return j.QueueNow(ctx, "")
}

// QueueNow enqueues an immediate check for one monitor or all when monitorID is empty.
func (j *MonitorCheckJob) QueueNow(ctx context.Context, monitorID string) (int, error) {
	monitors, err := j.pollTargets(ctx, monitorID)
	if err != nil {
		return 0, err
	}
	enqueued := 0
	monitorIDs := make([]string, 0, len(monitors))
	for _, monitor := range monitors {
		monitorType := str.Of(monitor.MonitorType).TrimSpace().ToLower().String()
		monitorID := monitorIDString(&monitor)
		if monitorID == "" || monitorType == "push" {
			continue
		}
		monitorIDs = append(monitorIDs, monitorID)
	}
	if err := j.enqueueBatches(ctx, monitorIDs, 0, 10*time.Second); err != nil {
		return 0, err
	}
	enqueued = len(monitorIDs)
	return enqueued, nil
}

// RunScheduledPoll enqueues the default batch of due monitor checks for scheduler use.
func (j *MonitorCheckJob) RunScheduledPoll(ctx context.Context) error {
	enqueued, err := j.QueueNow(ctx, "")
	if err != nil {
		return err
	}
	j.schedulerLogger.Info().Int("monitors", enqueued).Msg("Monitor poll handler queued")
	return nil
}

// RunNow executes poll checks synchronously for one monitor or all when monitorID is empty.
func (j *MonitorCheckJob) RunNow(ctx context.Context, monitorID string) (PollRunSummary, error) {
	summary := PollRunSummary{}
	monitors, err := j.pollTargets(ctx, monitorID)
	if err != nil {
		return summary, err
	}
	summary.Total = len(monitors)
	for i := range monitors {
		monitor := monitors[i]
		id := monitorIDString(&monitor)
		if id == "" {
			continue
		}
		if err := j.service.CheckMonitor(ctx, &monitor); err != nil {
			summary.Failed++
			summary.FailedMonitorIDs = append(summary.FailedMonitorIDs, id)
			j.logger.Error().Err(err).Str("monitor_id", id).Msg("sync monitor check failed")
			continue
		}
		summary.Succeeded++
	}
	return summary, nil
}

// TriggerPushMonitor triggers the synthetic push monitor endpoint.
func (j *MonitorCheckJob) TriggerPushMonitor(ctx context.Context) error {
	return j.service.TriggerPushMonitor(ctx)
}

// RunScheduledPushTrigger triggers the synthetic push monitor heartbeat for scheduler use.
func (j *MonitorCheckJob) RunScheduledPushTrigger(ctx context.Context) error {
	if err := j.TriggerPushMonitor(ctx); err != nil {
		return err
	}
	j.schedulerLogger.Info().Msg("Push monitor heartbeat recorded")
	return nil
}

func (j *MonitorCheckJob) pollTargets(ctx context.Context, monitorID string) ([]models.Monitor, error) {
	trimmed := str.Of(monitorID).TrimSpace().String()
	if trimmed == "" {
		monitors, err := j.monitorRepo.WithContext(ctx).EnabledOrderedByName()
		if err != nil {
			return nil, err
		}
		filtered := make([]models.Monitor, 0, len(monitors))
		for i := range monitors {
			monitorType := str.Of(monitors[i].MonitorType).TrimSpace().ToLower().String()
			if monitorType == "push" {
				continue
			}
			filtered = append(filtered, monitors[i])
		}
		return filtered, nil
	}
	model, err := j.monitorRepo.WithContext(ctx).ByID(trimmed)
	if err != nil {
		if errors.Is(err, gorm.ErrRecordNotFound) {
			return nil, fmt.Errorf("monitor %s not found or not enabled", trimmed)
		}
		return nil, err
	}
	if model == nil || !model.Enabled {
		return nil, fmt.Errorf("monitor %s not found or not enabled", trimmed)
	}
	monitorType := str.Of(model.MonitorType).TrimSpace().ToLower().String()
	if monitorType == "push" {
		return nil, fmt.Errorf("monitor %s is push and not pollable", trimmed)
	}
	return []models.Monitor{*model}, nil
}

// HandleTask processes queue payloads through the backend-agnostic queue API.
func (j *MonitorCheckJob) HandleTask(ctx context.Context, msg queue.Message) error {
	return j.handlePayload(ctx, msg.PayloadBytes())
}

func (j *MonitorCheckJob) handlePayload(ctx context.Context, body []byte) error {
	var request MonitorCheckPayload
	if err := json.Unmarshal(body, &request); err != nil {
		return fmt.Errorf("invalid payload: %w", err)
	}
	monitorIDs := request.MonitorIDs
	if len(monitorIDs) == 0 && str.Of(request.MonitorID).TrimSpace().String() != "" {
		monitorIDs = []string{str.Of(request.MonitorID).TrimSpace().String()}
	}
	if len(monitorIDs) == 0 {
		return fmt.Errorf("missing monitor id")
	}
	monitors, err := j.monitorRepo.WithContext(ctx).EnabledByIDs(uniqueMonitorIDStrings(monitorIDs))
	if err != nil {
		return err
	}
	if len(monitors) == 0 {
		return nil
	}
	return j.service.CheckMonitorsBatch(ctx, monitors)
}

// LookupMonitorByID returns a monitor for logging/task diagnostics.
func (j *MonitorCheckJob) LookupMonitorByID(ctx context.Context, monitorID string) (*models.Monitor, error) {
	if str.Of(monitorID).TrimSpace().String() == "" {
		return nil, nil
	}
	return j.monitorRepo.WithContext(ctx).ByID(monitorID)
}

func (j *MonitorCheckJob) enqueueBatches(ctx context.Context, monitorIDs []string, delay time.Duration, uniqueTTL time.Duration) error {
	ids := uniqueMonitorIDStrings(monitorIDs)
	if len(ids) == 0 {
		return nil
	}
	batchSize := j.pollBatchSize(ctx)
	for start := 0; start < len(ids); start += batchSize {
		end := start + batchSize
		if end > len(ids) {
			end = len(ids)
		}
		payload := MonitorCheckPayload{MonitorIDs: ids[start:end]}
		if err := j.queueWithPayload(ctx, payload, delay, uniqueTTL); err != nil {
			return err
		}
	}
	return nil
}

func (j *MonitorCheckJob) pollBatchSize(ctx context.Context) int {
	size := defaultMonitorPollBatchSize
	if j.appSettingRepo != nil {
		if raw, err := j.appSettingRepo.GetValue(ctx, appsettings.SettingMonitoringPollBatchSize, "100"); err == nil {
			if parsed, parseErr := strconv.Atoi(str.Of(raw).TrimSpace().String()); parseErr == nil && parsed > 0 {
				size = parsed
			}
		}
	}
	if size <= 0 {
		size = defaultMonitorPollBatchSize
	}
	if size > maxMonitorPollBatchSize {
		size = maxMonitorPollBatchSize
	}
	return size
}

func uniqueMonitorIDStrings(input []string) []string {
	if len(input) == 0 {
		return nil
	}
	seen := make(map[string]struct{}, len(input))
	out := make([]string, 0, len(input))
	for _, raw := range input {
		id := str.Of(raw).TrimSpace().String()
		if id == "" {
			continue
		}
		if _, ok := seen[id]; ok {
			continue
		}
		seen[id] = struct{}{}
		out = append(out, id)
	}
	return out
}
