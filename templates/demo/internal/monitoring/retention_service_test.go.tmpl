func TestRetentionRun_DryRunKeepsData(t *testing.T) {
	now := time.Date(2026, 2, 11, 12, 0, 0, 0, time.UTC)
	ctx := newRetentionTestContext(t)

	seedRetentionFixture(t, ctx, now)

	summary, err := ctx.service.Run(context.Background(), RetentionRunOptions{
		Now:    now,
		DryRun: true,
	})
	if err != nil {
		t.Fatalf("run dry retention: %v", err)
	}
	if !summary.DryRun {
		t.Fatalf("expected dry_run summary")
	}
	if summary.HourlyRollupsUpserted == 0 {
		t.Fatalf("expected computed hourly rollups")
	}
	if summary.DailyRollupsUpserted == 0 {
		t.Fatalf("expected computed daily rollups")
	}
	if summary.RawChecksDeleted != 0 || summary.HourlyRollupsDeleted != 0 || summary.DailyRollupsDeleted != 0 {
		t.Fatalf("dry-run should not report deletions: %+v", summary)
	}
	if got := mustCountRows(t, ctx.conns, &models.MonitorCheck{}); got != 6 {
		t.Fatalf("dry-run should not delete checks: got %d", got)
	}
	if got := mustCountRows(t, ctx.conns, &models.AlertDispatchEvent{}); got != 2 {
		t.Fatalf("dry-run should not delete alert events: got %d", got)
	}
	if got := mustCountRows(t, ctx.conns, &models.Incident{}); got != 2 {
		t.Fatalf("dry-run should not delete incidents: got %d", got)
	}
	// Stale rollups remain because dry-run skips retention deletes.
	if got := mustCountRows(t, ctx.conns, &models.MonitorCheckRollup{}); got != 2 {
		t.Fatalf("dry-run should not delete or write rollups: got %d", got)
	}
}

func TestRetentionRun_AppliesRollupsAndRetention(t *testing.T) {
	now := time.Date(2026, 2, 11, 12, 0, 0, 0, time.UTC)
	ctx := newRetentionTestContext(t)

	seedRetentionFixture(t, ctx, now)

	summary, err := ctx.service.Run(context.Background(), RetentionRunOptions{
		Now: now,
	})
	if err != nil {
		t.Fatalf("run retention: %v", err)
	}
	if summary.DryRun {
		t.Fatalf("expected non dry-run summary")
	}
	if summary.HourlyRollupsUpserted != 2 {
		t.Fatalf("unexpected hourly upserts: got %d want %d", summary.HourlyRollupsUpserted, 2)
	}
	if summary.DailyRollupsUpserted != 3 {
		t.Fatalf("unexpected daily upserts: got %d want %d", summary.DailyRollupsUpserted, 3)
	}
	if summary.RawChecksDeleted != 1 {
		t.Fatalf("unexpected raw deletes: got %d want %d", summary.RawChecksDeleted, 1)
	}
	if summary.HourlyRollupsDeleted != 1 {
		t.Fatalf("unexpected hourly rollup deletes: got %d want %d", summary.HourlyRollupsDeleted, 1)
	}
	if summary.DailyRollupsDeleted != 1 {
		t.Fatalf("unexpected daily rollup deletes: got %d want %d", summary.DailyRollupsDeleted, 1)
	}
	if summary.AlertDispatchDeleted != 1 {
		t.Fatalf("unexpected alert dispatch deletes: got %d want %d", summary.AlertDispatchDeleted, 1)
	}
	if summary.ResolvedIncidentsDeleted != 1 {
		t.Fatalf("unexpected resolved incident deletes: got %d want %d", summary.ResolvedIncidentsDeleted, 1)
	}

	if got := mustCountRows(t, ctx.conns, &models.MonitorCheck{}); got != 5 {
		t.Fatalf("expected one raw check removed; got %d rows", got)
	}
	if got := mustCountRows(t, ctx.conns, &models.AlertDispatchEvent{}); got != 1 {
		t.Fatalf("expected one alert event removed; got %d rows", got)
	}
	if got := mustCountRows(t, ctx.conns, &models.Incident{}); got != 1 {
		t.Fatalf("expected one resolved incident removed; got %d rows", got)
	}

	rollups := mustListRollups(t, ctx.conns)
	if len(rollups) != 5 {
		t.Fatalf("expected 5 retained rollups (2 old trimmed + 5 upserted => 5 total), got %d", len(rollups))
	}
}

type retentionTestContext struct {
	conns        *database.Connections
	service      *RetentionService
	settingRepo  *appsettings.AppSettingRepo
	checkRepo    *models.MonitorCheckRepo
	rollupRepo   *models.MonitorCheckRollupRepo
	alertRepo    *models.AlertDispatchEventRepo
	incidentRepo *models.IncidentRepo
}

func newRetentionTestContext(t *testing.T) retentionTestContext {
	t.Helper()
	t.Setenv("DB_DRIVER", "sqlite")
	t.Setenv("DB_DATABASE", filepath.Join(t.TempDir(), "retention-test.sqlite"))
	t.Setenv("DB_QUERY_LOGGING", "false")

	conns := database.NewConnections((*traces.Manager)(nil))
	t.Setenv("CACHE_DRIVER", "memory")
	t.Setenv("CACHE_SETTINGS_DRIVER", "memory")
	caches, err := caches.NewManager()
	if err != nil {
		t.Fatalf("new cache manager: %v", err)
	}
	db, err := conns.Default()
	if err != nil {
		t.Fatalf("open default db: %v", err)
	}
	if err := db.AutoMigrate(
		&appsettings.AppSetting{},
		&models.Monitor{},
		&models.MonitorCheck{},
		&models.MonitorCheckRollup{},
		&models.AlertDispatchEvent{},
		&models.Incident{},
	); err != nil {
		t.Fatalf("automigrate retention tables: %v", err)
	}

	settingRepo := appsettings.NewAppSettingRepo(conns, caches)
	mustUpsertSetting(t, settingRepo, appsettings.SettingMonitoringRetentionRawDays, "7")
	mustUpsertSetting(t, settingRepo, appsettings.SettingMonitoringRetentionDownsampleHourlyAfterDays, "1")
	mustUpsertSetting(t, settingRepo, appsettings.SettingMonitoringRetentionDownsampleDailyAfterDays, "3")
	mustUpsertSetting(t, settingRepo, appsettings.SettingMonitoringRetentionHourlyRollupDays, "10")
	mustUpsertSetting(t, settingRepo, appsettings.SettingMonitoringRetentionDailyRollupDays, "20")
	mustUpsertSetting(t, settingRepo, appsettings.SettingMonitoringRetentionAlertDispatchDays, "5")
	mustUpsertSetting(t, settingRepo, appsettings.SettingMonitoringRetentionResolvedIncidentDays, "6")

	checkRepo := models.NewMonitorCheckRepo(conns)
	rollupRepo := models.NewMonitorCheckRollupRepo(conns)
	alertRepo := models.NewAlertDispatchEventRepo(conns)
	incidentRepo := models.NewIncidentRepo(conns)

	svc := NewRetentionService(
		&logger.AppLogger{},
		settingRepo,
		checkRepo,
		rollupRepo,
		alertRepo,
		incidentRepo,
	)

	return retentionTestContext{
		conns:        conns,
		service:      svc,
		settingRepo:  settingRepo,
		checkRepo:    checkRepo,
		rollupRepo:   rollupRepo,
		alertRepo:    alertRepo,
		incidentRepo: incidentRepo,
	}
}

func seedRetentionFixture(t *testing.T, ctx retentionTestContext, now time.Time) {
	t.Helper()
	monitorRepo := models.NewMonitorRepo(ctx.conns)
	seedMonitors := []models.Monitor{
		{
			Name:            "Monitor 1",
			MonitorType:     "http",
			Target:          "https://example.com/m1",
			IntervalSeconds: 60,
			TimeoutMs:       5000,
			Enabled:         true,
			CreatedAt:       now.Add(-30 * 24 * time.Hour),
			UpdatedAt:       now,
		},
		{
			Name:            "Monitor 2",
			MonitorType:     "http",
			Target:          "https://example.com/m2",
			IntervalSeconds: 60,
			TimeoutMs:       5000,
			Enabled:         true,
			CreatedAt:       now.Add(-30 * 24 * time.Hour),
			UpdatedAt:       now,
		},
	}
	if err := monitorRepo.CreateBatch(seedMonitors); err != nil {
		t.Fatalf("seed monitors: %v", err)
	}
	seeded, err := monitorRepo.AllOrderedByName()
	if err != nil {
		t.Fatalf("list seeded monitors: %v", err)
	}
	idByName := map[string]int64{}
	for i := range seeded {
		idByName[seeded[i].Name] = seeded[i].Id
	}
	m1 := idByName["Monitor 1"]
	m2 := idByName["Monitor 2"]
	if m1 == 0 || m2 == 0 {
		t.Fatalf("seeded monitor ids missing")
	}

	checks := []models.MonitorCheck{
		{MonitorId: m1, CheckedAt: now.Add(-49 * time.Hour), Status: "up", DurationMs: null.IntFrom(100)},
		{MonitorId: m1, CheckedAt: now.Add(-48*time.Hour - 30*time.Minute), Status: "down", DurationMs: null.IntFrom(300)},
		{MonitorId: m2, CheckedAt: now.Add(-47 * time.Hour), Status: "up", DurationMs: null.IntFrom(120)},
		{MonitorId: m1, CheckedAt: now.Add(-4 * 24 * time.Hour), Status: "down", DurationMs: null.IntFrom(250)},
		{MonitorId: m2, CheckedAt: now.Add(-5 * 24 * time.Hour), Status: "up", DurationMs: null.IntFrom(150)},
		{MonitorId: m1, CheckedAt: now.Add(-9 * 24 * time.Hour), Status: "up", DurationMs: null.IntFrom(90)},
	}
	for i := range checks {
		if err := ctx.checkRepo.Create(&checks[i]); err != nil {
			t.Fatalf("seed check %d: %v", i, err)
		}
	}

	seedRollups := []models.MonitorCheckRollup{
		{
			MonitorID:      m1,
			Resolution:     "hour",
			BucketStart:    now.Add(-15 * 24 * time.Hour).Truncate(time.Hour),
			SampleCount:    1,
			UpCount:        1,
			DownCount:      0,
			AvgDurationMs:  111,
			FirstCheckedAt: now.Add(-15 * 24 * time.Hour),
			LastCheckedAt:  now.Add(-15 * 24 * time.Hour),
		},
		{
			MonitorID:      m1,
			Resolution:     "day",
			BucketStart:    time.Date(now.Year(), now.Month(), now.Day()-25, 0, 0, 0, 0, time.UTC),
			SampleCount:    1,
			UpCount:        1,
			DownCount:      0,
			AvgDurationMs:  111,
			FirstCheckedAt: now.Add(-25 * 24 * time.Hour),
			LastCheckedAt:  now.Add(-25 * 24 * time.Hour),
		},
	}
	if _, err := ctx.rollupRepo.UpsertBatch(seedRollups); err != nil {
		t.Fatalf("seed rollups: %v", err)
	}

	alertRows := []models.AlertDispatchEvent{
		{CreatedAt: now.Add(-10 * 24 * time.Hour), CheckedAt: now.Add(-10 * 24 * time.Hour), Event: "down", MonitorID: m1},
		{CreatedAt: now.Add(-1 * 24 * time.Hour), CheckedAt: now.Add(-1 * 24 * time.Hour), Event: "up", MonitorID: m1},
	}
	for i := range alertRows {
		if err := ctx.alertRepo.Create(&alertRows[i]); err != nil {
			t.Fatalf("seed alert row %d: %v", i, err)
		}
	}

	resolvedAtOld := now.Add(-10 * 24 * time.Hour)
	incidents := []models.Incident{
		{
			Id:         null.StringFrom("inc-old"),
			MonitorId:  m1,
			OpenedAt:   now.Add(-11 * 24 * time.Hour),
			ResolvedAt: &resolvedAtOld,
			Summary:    "old resolved",
		},
		{
			Id:        null.StringFrom("inc-open"),
			MonitorId: m1,
			OpenedAt:  now.Add(-1 * 24 * time.Hour),
			Summary:   "open",
		},
	}
	for i := range incidents {
		if err := ctx.incidentRepo.Create(&incidents[i]); err != nil {
			t.Fatalf("seed incident row %d: %v", i, err)
		}
	}
}

func mustUpsertSetting(t *testing.T, repo *appsettings.AppSettingRepo, key, value string) {
	t.Helper()
	if err := repo.Upsert(context.Background(), key, value); err != nil {
		t.Fatalf("upsert setting %s: %v", key, err)
	}
}

func mustCountRows(t *testing.T, conns *database.Connections, model any) int64 {
	t.Helper()
	db, err := conns.Default()
	if err != nil {
		t.Fatalf("open db for counting rows: %v", err)
	}
	var count int64
	if err := db.Model(model).Count(&count).Error; err != nil {
		t.Fatalf("count rows for model %T: %v", model, err)
	}
	return count
}

func mustListRollups(t *testing.T, conns *database.Connections) []models.MonitorCheckRollup {
	t.Helper()
	db, err := conns.Default()
	if err != nil {
		t.Fatalf("open db for listing rollups: %v", err)
	}
	rows := make([]models.MonitorCheckRollup, 0)
	if err := db.Order("resolution ASC, monitor_id ASC, bucket_start ASC").Find(&rows).Error; err != nil {
		t.Fatalf("list rollups: %v", err)
	}
	return rows
}
