func TestSanitizeRetentionPolicy(t *testing.T) {
	got := sanitizeRetentionPolicy(RetentionPolicy{
		RawDays:                   0,
		DownsampleHourlyAfterDays: 20,
		DownsampleDailyAfterDays:  20,
		HourlyRollupDays:          90,
		DailyRollupDays:           90,
		AlertDispatchDays:         -1,
		ResolvedIncidentDays:      0,
	})
	if got.RawDays <= 0 {
		t.Fatalf("raw days should be positive")
	}
	if got.DownsampleDailyAfterDays <= got.DownsampleHourlyAfterDays {
		t.Fatalf("daily downsample threshold should be greater than hourly threshold")
	}
	if got.DailyRollupDays <= got.HourlyRollupDays {
		t.Fatalf("daily rollup retention should be greater than hourly rollup retention")
	}
	if got.AlertDispatchDays <= 0 || got.ResolvedIncidentDays <= 0 {
		t.Fatalf("derived retention values should be positive")
	}
}

func TestRetentionHourlyWindow(t *testing.T) {
	now := time.Date(2026, 2, 11, 12, 0, 0, 0, time.UTC)
	policy := RetentionPolicy{
		DownsampleHourlyAfterDays: 30,
		DownsampleDailyAfterDays:  180,
	}
	start, end, ok := retentionHourlyWindow(now, policy)
	if !ok {
		t.Fatalf("expected valid hourly window")
	}
	if !start.Before(end) {
		t.Fatalf("expected start < end")
	}
	if got := end.Sub(start).Hours() / 24; int(got) != 150 {
		t.Fatalf("unexpected window width days: %.0f", got)
	}
}

func TestAggregateMonitorChecks(t *testing.T) {
	base := time.Date(2026, 2, 11, 10, 0, 0, 0, time.UTC)
	rows := []models.MonitorCheck{
		{
			MonitorId:  1,
			CheckedAt:  base.Add(5 * time.Minute),
			Status:     "up",
			DurationMs: null.IntFrom(100),
		},
		{
			MonitorId:  1,
			CheckedAt:  base.Add(35 * time.Minute),
			Status:     "down",
			DurationMs: null.IntFrom(300),
		},
		{
			MonitorId:  1,
			CheckedAt:  base.Add(26 * time.Hour),
			Status:     "up",
			DurationMs: null.IntFrom(200),
		},
	}

	hourly := aggregateMonitorChecks(rows, "hour")
	if len(hourly) != 2 {
		t.Fatalf("expected 2 hourly buckets, got %d", len(hourly))
	}
	if hourly[0].SampleCount != 2 || hourly[0].UpCount != 1 || hourly[0].DownCount != 1 {
		t.Fatalf("unexpected first hourly rollup counts: %+v", hourly[0])
	}
	if hourly[0].AvgDurationMs != 200 {
		t.Fatalf("unexpected avg duration: %d", hourly[0].AvgDurationMs)
	}

	daily := aggregateMonitorChecks(rows, "day")
	if len(daily) != 2 {
		t.Fatalf("expected 2 daily buckets, got %d", len(daily))
	}
	if daily[0].SampleCount != 2 {
		t.Fatalf("unexpected first daily sample count: %+v", daily[0])
	}
}

