package notification

import (
	"context"
	"encoding/json"

	"{{.GoModuleName}}/internal/logger"
)

func NewGenericWebhookCompatProvider(
	logger *logger.AppLogger,
	providerID string,
	url string,
	headers map[string]string,
	timeoutSeconds int,
) *GenericWebhookCompatProvider {
	webhook := NewWebhookProvider(logger, url, headers, timeoutSeconds)
	if webhook == nil {
		return nil
	}
	return &GenericWebhookCompatProvider{
		providerID: NormalizeProviderID(providerID),
		webhook:    webhook,
	}
}

type GenericWebhookCompatProvider struct {
	providerID string
	webhook    *WebhookProvider
}

func (p *GenericWebhookCompatProvider) Name() string { return p.providerID }

func (p *GenericWebhookCompatProvider) Send(ctx context.Context, msg AlertMessage) error {
	payload := map[string]any{
		"provider": p.providerID,
		"text":     formatAlertText(msg),
		"message":  msg,
	}
	body, err := json.Marshal(payload)
	if err != nil {
		return err
	}
	return p.webhook.sendRawJSON(ctx, body)
}
