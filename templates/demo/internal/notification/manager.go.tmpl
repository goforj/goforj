package notification

import (
	"context"
	"strconv"
	"time"

	"github.com/goforj/str"
	"{{.GoModuleName}}/internal/logger"
)

type AlertMessage struct {
	Event        string    `json:"event"`
	MonitorID    string    `json:"monitor_id"`
	MonitorName  string    `json:"monitor_name"`
	MonitorType  string    `json:"monitor_type"`
	Target       string    `json:"target"`
	Status       string    `json:"status"`
	IncidentID   string    `json:"incident_id,omitempty"`
	Summary      string    `json:"summary,omitempty"`
	ErrorClass   string    `json:"error_class,omitempty"`
	ErrorMessage string    `json:"error_message,omitempty"`
	DurationMs   int64     `json:"duration_ms,omitempty"`
	CheckedAt    time.Time `json:"checked_at"`
	ChannelIDs   []int64   `json:"channel_ids,omitempty"`
}

type Provider interface {
	Name() string
	Send(ctx context.Context, msg AlertMessage) error
}

type Manager struct {
	logger      *logger.AppLogger
	channelRepo *ChannelRepo
}

func NewManager(logger *logger.AppLogger, channelRepo *ChannelRepo) *Manager {
	return &Manager{
		logger:      logger,
		channelRepo: channelRepo,
	}
}

func (m *Manager) Dispatch(ctx context.Context, msg AlertMessage) {
	channelIDs := normalizeChannelIDs(msg.ChannelIDs)
	// Monitor-level routing is explicit: no selected channels means no dispatch.
	if len(channelIDs) == 0 {
		return
	}
	channels, err := m.channelRepo.ListRuntimeEnabledByIDs(channelIDs)
	if err != nil {
		m.logger.Error().Err(err).Msg("load notification channels failed")
		return
	}
	for _, channel := range channels {
		provider := m.providerForChannel(channel)
		if provider == nil {
			continue
		}
		if sendErr := provider.Send(ctx, msg); sendErr != nil {
			m.logger.Error().
				Err(sendErr).
				Str("provider", provider.Name()).
				Str("channel_name", channel.Name).
				Str("event", msg.Event).
				Str("monitor_id", msg.MonitorID).
				Msg("alert dispatch failed")
		}
	}
}

func normalizeChannelIDs(input []int64) []int64 {
	if len(input) == 0 {
		return nil
	}
	seen := map[int64]struct{}{}
	out := make([]int64, 0, len(input))
	for _, id := range input {
		if id <= 0 {
			continue
		}
		if _, ok := seen[id]; ok {
			continue
		}
		seen[id] = struct{}{}
		out = append(out, id)
	}
	return out
}

func (m *Manager) providerForChannel(channel RuntimeChannel) Provider {
	providerID := NormalizeProviderID(channel.Provider)
	timeoutSeconds := parseTimeoutSeconds(channel.Config["timeout_seconds"], 5)
	switch providerID {
	case ProviderLog:
		return NewLogProvider(m.logger)
	case ProviderWebhook:
		return NewWebhookProvider(m.logger, channel.Config["url"], notificationHeaders(channel), timeoutSeconds)
	case ProviderSlack:
		return NewSlackProvider(m.logger, channel.Config["url"], timeoutSeconds)
	case ProviderDiscord:
		return NewDiscordProvider(m.logger, channel.Config["url"], timeoutSeconds)
	case ProviderEmail, ProviderSMTP:
		return NewEmailProvider(m.logger, EmailProviderConfig{
			SMTPHost:      channel.Config["smtp_host"],
			SMTPPort:      channel.Config["smtp_port"],
			FromEmail:     channel.Config["from_email"],
			ToEmails:      channel.Config["to_emails"],
			SubjectPrefix: channel.Config["subject_prefix"],
			TimeoutSecs:   timeoutSeconds,
			Username:      channel.Secrets["smtp_username"],
			Password:      channel.Secrets["smtp_password"],
		})
	case "teams":
		return NewTeamsProvider(channel, timeoutSeconds)
	case "telegram":
		return NewTelegramProvider(channel, timeoutSeconds)
	case "pagerduty":
		return NewPagerDutyProvider(channel, timeoutSeconds)
	case "jiraservicemanagement":
		return NewJiraServiceManagementProvider(channel, timeoutSeconds)
	case "googlechat":
		return NewGoogleChatProvider(channel, timeoutSeconds)
	case "twilio":
		return NewTwilioProvider(channel, timeoutSeconds)
	case "opsgenie":
		return NewOpsgenieProvider(channel, timeoutSeconds)
	case "ntfy":
		return NewNtfyProvider(channel, timeoutSeconds)
	case "gotify":
		return NewGotifyProvider(channel, timeoutSeconds)
	case "wecom":
		return NewWeComProvider(channel, timeoutSeconds)
	case "dingding":
		return NewDingDingProvider(channel, timeoutSeconds)
	case "feishu":
		return NewFeishuProvider(channel, timeoutSeconds)
	case "line":
		return NewLineProvider(channel, timeoutSeconds)
	case "waha":
		return NewWAHAProvider(channel, timeoutSeconds)
	case "whapi":
		return NewWhapiProvider(channel, timeoutSeconds)
	default:
		if IsWebhookCompatProvider(providerID) {
			return NewGenericWebhookCompatProvider(
				m.logger,
				providerID,
				channel.Config["url"],
				notificationHeaders(channel),
				timeoutSeconds,
			)
		}
		return nil
	}
}

func notificationHeaders(channel RuntimeChannel) map[string]string {
	headers := map[string]string{}
	if token := channel.Secrets["bearer_token"]; token != "" {
		headers["Authorization"] = "Bearer " + token
	}
	if auth := channel.Secrets["authorization"]; auth != "" {
		headers["Authorization"] = auth
	}
	return headers
}

func parseTimeoutSeconds(raw string, fallback int) int {
	value := str.Of(raw).TrimSpace().String()
	if value == "" {
		return fallback
	}
	parsed, err := strconv.Atoi(value)
	if err != nil || parsed <= 0 {
		return fallback
	}
	return parsed
}
