package notification

import (
	"bytes"
	"context"
	"encoding/json"
	"fmt"
	"net/http"
	"net/url"
	"strings"
	"time"

	"github.com/goforj/str"
)

type priorityHTTPClient struct {
	client *http.Client
}

func newPriorityHTTPClient(timeoutSeconds int) *priorityHTTPClient {
	if timeoutSeconds <= 0 {
		timeoutSeconds = 5
	}
	return &priorityHTTPClient{
		client: &http.Client{Timeout: time.Duration(timeoutSeconds) * time.Second},
	}
}

func (c *priorityHTTPClient) postJSON(ctx context.Context, rawURL string, headers map[string]string, payload any) error {
	body, err := json.Marshal(payload)
	if err != nil {
		return err
	}
	req, err := http.NewRequestWithContext(ctx, http.MethodPost, rawURL, bytes.NewReader(body))
	if err != nil {
		return err
	}
	req.Header.Set("Content-Type", "application/json")
	for key, value := range headers {
		if str.Of(key).TrimSpace().String() == "" || str.Of(value).TrimSpace().String() == "" {
			continue
		}
		req.Header.Set(key, value)
	}
	resp, err := c.client.Do(req)
	if err != nil {
		return err
	}
	defer resp.Body.Close()
	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
		return fmt.Errorf("provider status: %s", resp.Status)
	}
	return nil
}

func (c *priorityHTTPClient) getJSON(ctx context.Context, rawURL string, headers map[string]string, out any) error {
	req, err := http.NewRequestWithContext(ctx, http.MethodGet, rawURL, nil)
	if err != nil {
		return err
	}
	for key, value := range headers {
		if str.Of(key).TrimSpace().String() == "" || str.Of(value).TrimSpace().String() == "" {
			continue
		}
		req.Header.Set(key, value)
	}
	resp, err := c.client.Do(req)
	if err != nil {
		return err
	}
	defer resp.Body.Close()
	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
		return fmt.Errorf("provider status: %s", resp.Status)
	}
	return json.NewDecoder(resp.Body).Decode(out)
}

func (c *priorityHTTPClient) postForm(ctx context.Context, rawURL string, headers map[string]string, form url.Values) error {
	req, err := http.NewRequestWithContext(ctx, http.MethodPost, rawURL, strings.NewReader(form.Encode()))
	if err != nil {
		return err
	}
	req.Header.Set("Content-Type", "application/x-www-form-urlencoded;charset=utf-8")
	for key, value := range headers {
		if str.Of(key).TrimSpace().String() == "" || str.Of(value).TrimSpace().String() == "" {
			continue
		}
		req.Header.Set(key, value)
	}
	resp, err := c.client.Do(req)
	if err != nil {
		return err
	}
	defer resp.Body.Close()
	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
		return fmt.Errorf("provider status: %s", resp.Status)
	}
	return nil
}

func cfg(channel RuntimeChannel, keys ...string) string {
	for _, key := range keys {
		k := str.Of(key).TrimSpace().String()
		if k == "" {
			continue
		}
		if value := str.Of(channel.Config[k]).TrimSpace().String(); value != "" {
			return value
		}
		if value := str.Of(channel.Config[strings.ToLower(k)]).TrimSpace().String(); value != "" {
			return value
		}
	}
	return ""
}

func secret(channel RuntimeChannel, keys ...string) string {
	for _, key := range keys {
		k := str.Of(key).TrimSpace().String()
		if k == "" {
			continue
		}
		if value := str.Of(channel.Secrets[k]).TrimSpace().String(); value != "" {
			return value
		}
		if value := str.Of(channel.Secrets[strings.ToLower(k)]).TrimSpace().String(); value != "" {
			return value
		}
	}
	return ""
}

func boolValue(channel RuntimeChannel, defaultValue bool, keys ...string) bool {
	raw := strings.ToLower(cfg(channel, keys...))
	switch raw {
	case "1", "true", "yes", "y", "on":
		return true
	case "0", "false", "no", "n", "off":
		return false
	default:
		return defaultValue
	}
}

func statusDown(msg AlertMessage) bool { return strings.EqualFold(msg.Status, "down") }
func statusUp(msg AlertMessage) bool   { return strings.EqualFold(msg.Status, "up") }

func dedupKey(msg AlertMessage) string {
	id := str.Of(msg.MonitorID).TrimSpace().String()
	if id == "" {
		id = str.Of(msg.MonitorName).TrimSpace().String()
	}
	if id == "" {
		id = "global"
	}
	return "UptimeGopher/" + id
}

func firstNonEmpty(values ...string) string {
	for _, value := range values {
		normalized := str.Of(value).TrimSpace().String()
		if normalized != "" {
			return normalized
		}
	}
	return ""
}
