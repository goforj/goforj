func NormalizeProviderID(provider string) string {
	return strings.ToLower(strings.TrimSpace(provider))
}

func IsSupportedNotificationProvider(provider string) bool {
	normalized := NormalizeProviderID(provider)
	if normalized == ProviderLog || normalized == ProviderEmail {
		return true
	}
	_, ok := webhookCompatProviders[normalized]
	return ok
}

func IsWebhookCompatProvider(provider string) bool {
	normalized := NormalizeProviderID(provider)
	if normalized == ProviderLog || normalized == ProviderEmail || normalized == ProviderSMTP {
		return false
	}
	if normalized == ProviderWebhook || normalized == ProviderSlack || normalized == ProviderDiscord {
		return false
	}
	_, ok := webhookCompatProviders[normalized]
	return ok
}
