networks:
  backend:
    driver: bridge

volumes:
  noop:
    driver: local
{{- if .Resources.DatabaseMySQL }}
  mariadb:
    driver: local
{{ end }}
{{- if .Resources.DatabasePostgres }}
  postgres:
    driver: local
{{ end }}
{{- if .Components.Observability }}
  victoriametrics:
    driver: local
{{ end }}
{{- if .Components.Grafana }}
  grafana:
    driver: local
{{ end }}
{{- if .Components.Docker }}
  redis:
    driver: local
  rustfs:
    driver: local
  opensearch:
    driver: local
{{ end }}

services:

{{- if .Components.Observability }}
  victoriametrics:
    restart: unless-stopped
    image: victoriametrics/victoria-metrics:v1.120.0
    environment:
      - TZ=${TZ:-UTC}
    ports:
      - ${IP_ADDRESS:-0.0.0.0}:${OBSERVABILITY_VM_PORT:-8428}:8428
    volumes:
      - victoriametrics:/victoria-metrics-data
    command:
      - --storageDataPath=/victoria-metrics-data
      - --httpListenAddr=:8428
      - --retentionPeriod=30d
    networks:
      - backend

  vmagent:
    restart: unless-stopped
    build:
      context: ./containers/observability/vmagent
    environment:
      - TZ=${TZ:-UTC}
    depends_on:
      - victoriametrics
    extra_hosts:
      - "host.docker.internal:host-gateway"
    command:
      - -promscrape.config=/etc/vmagent/prometheus.yml
      - -remoteWrite.url=http://victoriametrics:8428/api/v1/write
    networks:
      - backend
{{- end }}

{{- if .Components.Grafana }}
  grafana:
    restart: unless-stopped
    build:
      context: ./containers/observability/grafana
    depends_on:
      - victoriametrics
    ports:
      - ${IP_ADDRESS:-0.0.0.0}:${GRAFANA_PORT:-13001}:3000
    environment:
      - TZ=${TZ:-UTC}
      - GF_SECURITY_ADMIN_USER=${GRAFANA_ADMIN_USER:-admin}
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD:-admin}
      - GF_USERS_ALLOW_SIGN_UP=false
    volumes:
      - grafana:/var/lib/grafana
    networks:
      - backend

  grafana-seed:
    restart: "no"
    stop_grace_period: 1s
    build:
      context: ./containers/observability/grafana
      dockerfile: Dockerfile.seed
    depends_on:
      - grafana
    environment:
      - TZ=${TZ:-UTC}
      - GRAFANA_URL=http://grafana:3000
      - GRAFANA_ADMIN_USER=${GRAFANA_ADMIN_USER:-admin}
      - GRAFANA_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD:-admin}
    entrypoint: ["sh"]
    command: ["/seed-dashboards.sh"]
    networks:
      - backend
{{- end }}

{{- if and .Components.Mail .Components.Docker }}
  mailpit:
    restart: unless-stopped
    image: axllent/mailpit:v1.27
    environment:
      - TZ=${TZ:-UTC}
    ports:
      - ${IP_ADDRESS:-0.0.0.0}:${MAILPIT_SMTP_PORT:-1025}:1025
      - ${IP_ADDRESS:-0.0.0.0}:${MAILPIT_HTTP_PORT:-8025}:8025
    networks:
      - backend
{{- end }}

{{- if .Resources.DatabaseMySQL }}
  mysql:
    restart: unless-stopped
    build:
      context: ./containers/mariadb
      args:
        - INNODB_BUFFER_POOL_SIZE=${INNODB_BUFFER_POOL_SIZE:-512MB}
    ports:
      - ${IP_ADDRESS:-0.0.0.0}:${DB_MYSQL_PORT:-${DB_PORT:-3306}}:3306
    volumes:
      - mariadb:/var/lib/mysql
    environment:
      - MARIADB_DATABASE=${DB_DATABASE}
      - MARIADB_USER=${DB_USERNAME}
      - MARIADB_PASSWORD=${DB_PASSWORD}
      - MARIADB_ROOT_PASSWORD=${DB_ROOT_PASSWORD}
      - MARIADB_ALLOW_EMPTY_PASSWORD=NO
      - TZ=${TZ:-UTC}
    networks:
      - backend
{{ end }}

{{- if .Resources.DatabasePostgres }}
  postgres:
    restart: unless-stopped
    image: postgres:16
    ports:
      - ${IP_ADDRESS:-0.0.0.0}:${DB_POSTGRES_PORT:-${DB_PORT:-5432}}:5432
    volumes:
      - postgres:/var/lib/postgresql/data
    environment:
      - POSTGRES_DB=${DB_DATABASE}
      - POSTGRES_USER=${DB_USERNAME}
      - POSTGRES_PASSWORD=${DB_PASSWORD}
      - TZ=${TZ:-UTC}
    networks:
      - backend
{{ end }}

{{- if .Components.Docker }}
  # These catalog services remain dormant until COMPOSE_PROFILES selects them.
  redis:
    profiles: [redis]
    restart: unless-stopped
    image: redis:7.4
    environment:
      - TZ=${TZ:-UTC}
    ports:
      - ${IP_ADDRESS:-0.0.0.0}:${REDIS_PORT:-6379}:6379
    volumes:
      - redis:/data
    networks:
      - backend

  rustfs:
    profiles: [rustfs]
    restart: unless-stopped
    image: rustfs/rustfs:1.0.0-beta.10
    security_opt:
      - no-new-privileges:true
    environment:
      - TZ=${TZ:-UTC}
      - RUSTFS_VOLUMES=/data
      - RUSTFS_ADDRESS=0.0.0.0:9000
      - RUSTFS_CONSOLE_ADDRESS=0.0.0.0:9001
      - RUSTFS_CONSOLE_ENABLE=true
      - RUSTFS_ACCESS_KEY=${RUSTFS_ACCESS_KEY:-rustfsadmin}
      - RUSTFS_SECRET_KEY=${RUSTFS_SECRET_KEY:-rustfsadmin}
    ports:
      - ${DEV_SERVICE_IP_ADDRESS:-127.0.0.1}:${RUSTFS_API_PORT:-9000}:9000
      - ${DEV_SERVICE_IP_ADDRESS:-127.0.0.1}:${RUSTFS_CONSOLE_PORT:-9001}:9001
    volumes:
      - rustfs:/data
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:9000/health && curl -fsS http://127.0.0.1:9001/rustfs/console/health"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 40s
    networks:
      - backend

  opensearch:
    # OpenSearch requires vm.max_map_count=262144 on Linux hosts.
    profiles: [opensearch]
    x-forj-test: false
    restart: unless-stopped
    image: opensearchproject/opensearch:3.7.0
    environment:
      - TZ=${TZ:-UTC}
      - discovery.type=single-node
      - bootstrap.memory_lock=true
      - OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
      - OPENSEARCH_INITIAL_ADMIN_PASSWORD=${OPENSEARCH_INITIAL_ADMIN_PASSWORD:-G0Forj-Local-OpenSearch-2026!}
    ulimits:
      memlock:
        soft: -1
        hard: -1
      nofile:
        soft: 65536
        hard: 65536
    ports:
      - ${DEV_SERVICE_IP_ADDRESS:-127.0.0.1}:${OPENSEARCH_HTTP_PORT:-9200}:9200
      - ${DEV_SERVICE_IP_ADDRESS:-127.0.0.1}:${OPENSEARCH_ANALYZER_PORT:-9600}:9600
    volumes:
      - opensearch:/usr/share/opensearch/data
    healthcheck:
      test: ["CMD-SHELL", "curl -kfsS -u \"admin:$${OPENSEARCH_INITIAL_ADMIN_PASSWORD}\" https://localhost:9200/_cluster/health?wait_for_status=yellow"]
      interval: 10s
      timeout: 5s
      retries: 20
      start_period: 40s
    networks:
      - backend

  opensearch-dashboards:
    profiles: [opensearch]
    x-forj-test: false
    restart: unless-stopped
    image: opensearchproject/opensearch-dashboards:3.7.0
    depends_on:
      opensearch:
        condition: service_healthy
    environment:
      - TZ=${TZ:-UTC}
      - OPENSEARCH_HOSTS=["https://opensearch:9200"]
    ports:
      - ${DEV_SERVICE_IP_ADDRESS:-127.0.0.1}:${OPENSEARCH_DASHBOARDS_PORT:-5601}:5601
    networks:
      - backend
{{ end }}
