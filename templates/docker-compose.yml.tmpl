networks:
  backend:
    driver: bridge

volumes:
  noop:
    driver: local
{{- if .Resources.DatabaseMySQL }}
  mariadb:
    driver: local
{{ end }}
{{- if .Resources.DatabasePostgres }}
  postgres:
    driver: local
{{ end }}
{{- if .Components.Observability }}
  victoriametrics:
    driver: local
{{ end }}
{{- if .Components.Grafana }}
  grafana:
    driver: local
{{ end }}
{{- if .Resources.RedisSupported }}
  redis:
    driver: local
{{ end }}

services:

{{- if .Components.Observability }}
  victoriametrics:
    restart: unless-stopped
    image: victoriametrics/victoria-metrics:v1.120.0
    ports:
      - ${IP_ADDRESS:-0.0.0.0}:${OBSERVABILITY_VM_PORT:-8428}:8428
    volumes:
      - victoriametrics:/victoria-metrics-data
    command:
      - --storageDataPath=/victoria-metrics-data
      - --httpListenAddr=:8428
      - --retentionPeriod=30d
    networks:
      - backend

  vmagent:
    restart: unless-stopped
    build:
      context: ./containers/observability/vmagent
    depends_on:
      - victoriametrics
    extra_hosts:
      - "host.docker.internal:host-gateway"
    command:
      - -promscrape.config=/etc/vmagent/prometheus.yml
      - -remoteWrite.url=http://victoriametrics:8428/api/v1/write
    networks:
      - backend
{{- end }}

{{- if .Components.Grafana }}
  grafana:
    restart: unless-stopped
    build:
      context: ./containers/observability/grafana
    depends_on:
      - victoriametrics
    ports:
      - ${IP_ADDRESS:-0.0.0.0}:${GRAFANA_PORT:-13001}:3000
    environment:
      - GF_SECURITY_ADMIN_USER=${GRAFANA_ADMIN_USER:-admin}
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD:-admin}
      - GF_USERS_ALLOW_SIGN_UP=false
    volumes:
      - grafana:/var/lib/grafana
    networks:
      - backend

  grafana-seed:
    restart: "no"
    stop_grace_period: 1s
    build:
      context: ./containers/observability/grafana
      dockerfile: Dockerfile.seed
    depends_on:
      - grafana
    environment:
      - GRAFANA_URL=http://grafana:3000
      - GRAFANA_ADMIN_USER=${GRAFANA_ADMIN_USER:-admin}
      - GRAFANA_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD:-admin}
    entrypoint: ["sh"]
    command: ["/seed-dashboards.sh"]
    networks:
      - backend
{{- end }}

{{- if and .Components.Mail .Components.Docker }}
  mailpit:
    restart: unless-stopped
    image: axllent/mailpit:v1.27
    ports:
      - ${IP_ADDRESS:-0.0.0.0}:${MAILPIT_SMTP_PORT:-1025}:1025
      - ${IP_ADDRESS:-0.0.0.0}:${MAILPIT_HTTP_PORT:-8025}:8025
    networks:
      - backend
{{- end }}

{{- if .Resources.DatabaseMySQL }}
  mysql:
    restart: unless-stopped
    build:
      context: ./containers/mariadb
      args:
        - INNODB_BUFFER_POOL_SIZE=${INNODB_BUFFER_POOL_SIZE:-512MB}
    ports:
      - ${IP_ADDRESS:-0.0.0.0}:${DB_MYSQL_PORT:-${DB_PORT:-3306}}:3306
    volumes:
      - mariadb:/var/lib/mysql
    environment:
      - MARIADB_DATABASE=${DB_DATABASE}
      - MARIADB_USER=${DB_USERNAME}
      - MARIADB_PASSWORD=${DB_PASSWORD}
      - MARIADB_ROOT_PASSWORD=${DB_ROOT_PASSWORD}
      - MARIADB_ALLOW_EMPTY_PASSWORD=NO
      - TZ=${TZ:-US/Central}
    networks:
      - backend
{{ end }}

{{- if .Resources.DatabasePostgres }}
  postgres:
    restart: unless-stopped
    image: postgres:16
    ports:
      - ${IP_ADDRESS:-0.0.0.0}:${DB_POSTGRES_PORT:-${DB_PORT:-5432}}:5432
    volumes:
      - postgres:/var/lib/postgresql/data
    environment:
      - POSTGRES_DB=${DB_DATABASE}
      - POSTGRES_USER=${DB_USERNAME}
      - POSTGRES_PASSWORD=${DB_PASSWORD}
      - TZ=${TZ:-US/Central}
    networks:
      - backend
{{ end }}

{{- if .Resources.RedisSupported }}
  redis:
    profiles: [redis]
    restart: unless-stopped
    image: redis:7.4
    ports:
      - ${IP_ADDRESS:-0.0.0.0}:${REDIS_PORT:-6379}:6379
    volumes:
      - redis:/data
    networks:
      - backend
{{ end }}
