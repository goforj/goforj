networks:
  backend:
    driver: bridge

volumes:
  noop:
    driver: local
{{- if .Components.Jobs }}
  redis:
    driver: local
{{ end }}

services:

{{- if .Components.DatabaseMySQL }}
  mysql:
    restart: unless-stopped
    build:
      context: ./containers/mariadb
      args:
        - INNODB_BUFFER_POOL_SIZE=${INNODB_BUFFER_POOL_SIZE:-512MB}
    ports:
      - ${IP_ADDRESS:-0.0.0.0}:3306:3306
    volumes:
      - ./_data/mariadb:/var/lib/mysql
    environment:
      - MARIADB_DATABASE=${DB_DATABASE}
      - MARIADB_USER=${DB_USERNAME}
      - MARIADB_PASSWORD=${DB_PASSWORD}
      - MARIADB_ROOT_PASSWORD=${DB_ROOT_PASSWORD}
      - MARIADB_ALLOW_EMPTY_PASSWORD=NO
      - TZ=${TZ:-US/Central}
    networks:
      - backend
{{ end }}

{{- if .Components.DatabasePostgres }}
  postgres:
    restart: unless-stopped
    image: postgres:16
    ports:
      - ${IP_ADDRESS:-0.0.0.0}:5432:5432
    volumes:
      - ./_data/postgres:/var/lib/postgresql/data
    environment:
      - POSTGRES_DB=${DB_DATABASE}
      - POSTGRES_USER=${DB_USERNAME}
      - POSTGRES_PASSWORD=${DB_PASSWORD}
      - TZ=${TZ:-US/Central}
    networks:
      - backend
{{ end }}

{{- if .Components.Jobs }}
  redis:
    restart: unless-stopped
    image: redis:7.4
    ports:
      - ${IP_ADDRESS:-0.0.0.0}:6379:6379
    volumes:
      - redis:/data
    networks:
      - backend
{{ end }}
