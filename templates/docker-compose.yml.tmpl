networks:
  backend:
    driver: bridge

volumes:
  noop:
    driver: local
{{- if .Components.Jobs }}
  redis:
    driver: local
{{ end }}

services:

{{- if .Components.Observability }}
  victoriametrics:
    restart: unless-stopped
    image: victoriametrics/victoria-metrics:v1.120.0
    ports:
      - ${IP_ADDRESS:-0.0.0.0}:${OBSERVABILITY_VM_PORT:-8428}:8428
    volumes:
      - ./_data/victoriametrics:/victoria-metrics-data
    command:
      - --storageDataPath=/victoria-metrics-data
      - --httpListenAddr=:8428
      - --retentionPeriod=30d
    networks:
      - backend

  vmagent:
    restart: unless-stopped
    image: victoriametrics/vmagent:v1.120.0
    depends_on:
      - victoriametrics
    extra_hosts:
      - "host.docker.internal:host-gateway"
    volumes:
      - ./containers/observability/vmagent:/etc/vmagent:ro
    command:
      - -promscrape.config=/etc/vmagent/prometheus.yml
      - -remoteWrite.url=http://victoriametrics:8428/api/v1/write
    networks:
      - backend
{{- end }}

{{- if .Components.Grafana }}
  grafana-data-init:
    restart: "no"
    image: grafana/grafana:12.0.2
    user: "0:0"
    volumes:
      - ./_data/grafana:/var/lib/grafana
    entrypoint:
      - sh
      - -lc
    command:
      - |
        mkdir -p /var/lib/grafana/plugins
        uid="$(id -u grafana 2>/dev/null || echo 472)"
        gid="$(id -g grafana 2>/dev/null || echo 0)"
        chown -R "$${uid}:$${gid}" /var/lib/grafana 2>/dev/null || true
        chmod -R a+rwX /var/lib/grafana
    networks:
      - backend

  grafana:
    restart: unless-stopped
    image: grafana/grafana:12.0.2
    depends_on:
      victoriametrics:
        condition: service_started
      grafana-data-init:
        condition: service_completed_successfully
    ports:
      - ${IP_ADDRESS:-0.0.0.0}:${GRAFANA_PORT:-13001}:3000
    environment:
      - GF_SECURITY_ADMIN_USER=${GRAFANA_ADMIN_USER:-admin}
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD:-admin}
      - GF_USERS_ALLOW_SIGN_UP=false
    volumes:
      - ./_data/grafana:/var/lib/grafana
      - ./containers/observability/grafana/provisioning:/etc/grafana/provisioning:ro
      - ./containers/observability/grafana/dashboards:/etc/grafana/dashboards:ro
    networks:
      - backend

  grafana-seed:
    restart: "no"
    stop_grace_period: 1s
    image: curlimages/curl:8.10.1
    depends_on:
      - grafana
    environment:
      - GRAFANA_URL=http://grafana:3000
      - GRAFANA_ADMIN_USER=${GRAFANA_ADMIN_USER:-admin}
      - GRAFANA_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD:-admin}
    volumes:
      - ./containers/observability/grafana/seed-dashboards.sh:/seed-dashboards.sh:ro
    command: ["sh", "/seed-dashboards.sh"]
    networks:
      - backend
{{- end }}

{{- if and .Components.Mail .Components.Docker }}
  mailpit:
    restart: unless-stopped
    image: axllent/mailpit:v1.27
    ports:
      - ${IP_ADDRESS:-0.0.0.0}:${MAILPIT_SMTP_PORT:-1025}:1025
      - ${IP_ADDRESS:-0.0.0.0}:${MAILPIT_HTTP_PORT:-8025}:8025
    networks:
      - backend
{{- end }}

{{- if .Components.DatabaseMySQL }}
  mysql:
    restart: unless-stopped
    build:
      context: ./containers/mariadb
      args:
        - INNODB_BUFFER_POOL_SIZE=${INNODB_BUFFER_POOL_SIZE:-512MB}
    ports:
      - ${IP_ADDRESS:-0.0.0.0}:{{- if .Components.DatabasePostgres }}${DB_MYSQL_PORT:-3306}{{- else }}${DB_MYSQL_PORT:-${DB_PORT:-3306}}{{- end }}:3306
    volumes:
      - ./_data/mariadb:/var/lib/mysql
    environment:
      - MARIADB_DATABASE=${DB_DATABASE}
      - MARIADB_USER=${DB_USERNAME}
      - MARIADB_PASSWORD=${DB_PASSWORD}
      - MARIADB_ROOT_PASSWORD=${DB_ROOT_PASSWORD}
      - MARIADB_ALLOW_EMPTY_PASSWORD=NO
      - TZ=${TZ:-US/Central}
    networks:
      - backend
{{ end }}

{{- if .Components.DatabasePostgres }}
  postgres:
    restart: unless-stopped
    image: postgres:16
    ports:
      - ${IP_ADDRESS:-0.0.0.0}:{{- if .Components.DatabaseMySQL }}${DB_POSTGRES_PORT:-5432}{{- else }}${DB_POSTGRES_PORT:-${DB_PORT:-5432}}{{- end }}:5432
    volumes:
      - ./_data/postgres:/var/lib/postgresql/data
    environment:
      - POSTGRES_DB=${DB_DATABASE}
      - POSTGRES_USER=${DB_USERNAME}
      - POSTGRES_PASSWORD=${DB_PASSWORD}
      - TZ=${TZ:-US/Central}
    networks:
      - backend
{{ end }}

{{- if .Components.Jobs }}
  redis:
    restart: unless-stopped
    image: redis:7.4
    ports:
      - ${IP_ADDRESS:-0.0.0.0}:${REDIS_PORT:-6379}:6379
    volumes:
      - redis:/data
    networks:
      - backend
{{ end }}
