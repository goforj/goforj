networks:
  backend:
    driver: bridge

volumes:
  noop:
    driver: local
{{- if .Components.Jobs }}
  redis:
    driver: local
{{ end }}

services:

{{- if .Components.Observability }}
  victoriametrics:
    restart: unless-stopped
    image: victoriametrics/victoria-metrics:v1.120.0
    ports:
      - ${IP_ADDRESS:-0.0.0.0}:${OBSERVABILITY_VM_PORT:-8428}:8428
    volumes:
      - ./_data/victoriametrics:/victoria-metrics-data
    command:
      - --storageDataPath=/victoria-metrics-data
      - --httpListenAddr=:8428
      - --retentionPeriod=30d
    networks:
      - backend

  vmagent:
    restart: unless-stopped
    image: victoriametrics/vmagent:v1.120.0
    depends_on:
      - victoriametrics
    extra_hosts:
      - "host.docker.internal:host-gateway"
    volumes:
      - ./containers/observability/vmagent/prometheus.yml:/etc/vmagent/prometheus.yml:ro
    command:
      - -promscrape.config=/etc/vmagent/prometheus.yml
      - -remoteWrite.url=http://victoriametrics:8428/api/v1/write
    networks:
      - backend
{{- end }}

{{- if .Components.Grafana }}
  grafana:
    restart: unless-stopped
    image: grafana/grafana:12.0.2
    depends_on:
      - victoriametrics
    ports:
      - ${IP_ADDRESS:-0.0.0.0}:${GRAFANA_PORT:-3001}:3000
    environment:
      - GF_SECURITY_ADMIN_USER=${GRAFANA_ADMIN_USER:-admin}
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD:-admin}
      - GF_USERS_ALLOW_SIGN_UP=false
    volumes:
      - ./_data/grafana:/var/lib/grafana
      - ./containers/observability/grafana/provisioning:/etc/grafana/provisioning:ro
      - ./containers/observability/grafana/dashboards:/var/lib/grafana/dashboards:ro
    networks:
      - backend
{{- end }}

{{- if .Components.DatabaseMySQL }}
  mysql:
    restart: unless-stopped
    build:
      context: ./containers/mariadb
      args:
        - INNODB_BUFFER_POOL_SIZE=${INNODB_BUFFER_POOL_SIZE:-512MB}
    ports:
      - ${IP_ADDRESS:-0.0.0.0}:${DB_PORT:-3306}:3306
    volumes:
      - ./_data/mariadb:/var/lib/mysql
    environment:
      - MARIADB_DATABASE=${DB_DATABASE}
      - MARIADB_USER=${DB_USERNAME}
      - MARIADB_PASSWORD=${DB_PASSWORD}
      - MARIADB_ROOT_PASSWORD=${DB_ROOT_PASSWORD}
      - MARIADB_ALLOW_EMPTY_PASSWORD=NO
      - TZ=${TZ:-US/Central}
    networks:
      - backend
{{ end }}

{{- if .Components.DatabasePostgres }}
  postgres:
    restart: unless-stopped
    image: postgres:16
    ports:
      - ${IP_ADDRESS:-0.0.0.0}:${DB_PORT:-5432}:5432
    volumes:
      - ./_data/postgres:/var/lib/postgresql/data
    environment:
      - POSTGRES_DB=${DB_DATABASE}
      - POSTGRES_USER=${DB_USERNAME}
      - POSTGRES_PASSWORD=${DB_PASSWORD}
      - TZ=${TZ:-US/Central}
    networks:
      - backend
{{ end }}

{{- if .Components.Jobs }}
  redis:
    restart: unless-stopped
    image: redis:7.4
    ports:
      - ${IP_ADDRESS:-0.0.0.0}:${REDIS_PORT:-6379}:6379
    volumes:
      - redis:/data
    networks:
      - backend
{{ end }}
