<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0c0a0e" media="(prefers-color-scheme: dark)">
    <meta name="theme-color" content="#f2eff5" media="(prefers-color-scheme: light)">
    <title>{{if .AppIsDefault}}{{.ProjectName}}{{else}}{{.ProjectName}} / {{.App.Name}}{{end}}</title>
    <link rel="icon" href="./goforj-mark-dark.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)">
    <link rel="icon" href="./goforj-mark-light.svg" type="image/svg+xml" media="(prefers-color-scheme: light)">
    <style>
        :root {
            color-scheme: dark light;
            --accent: #ff5e3a;
            --accent-hi: #ff8257;
            --accent-soft: rgba(255, 94, 58, 0.12);
            --accent-line: rgba(255, 94, 58, 0.32);
            --nav: #ffc24d;
            --nav-soft: rgba(255, 194, 77, 0.11);
            --nav-line: rgba(255, 194, 77, 0.30);
            --ground-deep: #0c0a0e;
            --ground: #1a1620;
            --ground-alt: #1d1923;
            --surface: #2c2734;
            --surface-2: #2d2835;
            --line: #2a2333;
            --line-strong: #3d3349;
            --ink: #ffffff;
            --ink-2: #a9a1b3;
            --ink-3: #746c80;
            --shadow: rgba(0, 0, 0, 0.46);
            --on-accent: #08070a;
        }

        * {
            box-sizing: border-box;
        }

        html {
            min-width: 320px;
            background: var(--ground-deep);
        }

        body {
            min-height: 100vh;
            margin: 0;
            display: grid;
            place-items: center;
            padding: clamp(20px, 4vw, 64px);
            overflow-x: hidden;
            color: var(--ink);
            background:
                radial-gradient(circle at 83% 18%, var(--accent-soft), transparent 28rem),
                linear-gradient(135deg, transparent 0 48%, rgba(255, 255, 255, 0.018) 48% 52%, transparent 52%) 0 0 / 44px 44px,
                var(--ground-deep);
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        main {
            width: min(100%, 1180px);
            min-height: min(720px, calc(100vh - 80px));
            display: grid;
            grid-template-columns: minmax(0, 0.92fr) minmax(420px, 1.08fr);
            overflow: hidden;
            border: 1px solid var(--line-strong);
            border-radius: 20px;
            background: var(--ground);
            box-shadow: 0 38px 100px var(--shadow);
        }

        .content {
            position: relative;
            z-index: 2;
            display: flex;
            min-width: 0;
            flex-direction: column;
            padding: clamp(32px, 5vw, 64px);
        }

        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 12px;
        }

        .mark {
            width: 38px;
            height: 38px;
            display: block;
            flex: none;
        }

        .mark img {
            width: 100%;
            height: 100%;
            display: block;
        }

        .brand-copy {
            display: grid;
            gap: 2px;
        }

        .brand-name {
            font-size: 18px;
            font-weight: 760;
            letter-spacing: -0.025em;
        }

        .brand-tagline {
            color: var(--ink-2);
            font-size: 12px;
            line-height: 1.25;
        }

        .header-actions {
            display: inline-flex;
            align-items: center;
            gap: 18px;
            color: var(--nav);
            font-size: 13px;
            font-weight: 700;
        }

        .header-actions a {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            border-bottom: 1px solid transparent;
        }

        .header-actions a:hover,
        .header-actions a:focus-visible {
            border-bottom-color: currentColor;
        }

        .hero {
            margin: auto 0;
            padding: 74px 0 56px;
        }

        .eyebrow {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
            color: var(--accent-hi);
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.16em;
            text-transform: uppercase;
        }

        .eyebrow::before {
            width: 30px;
            height: 2px;
            content: "";
            background: var(--accent);
        }

        h1 {
            max-width: 11ch;
            margin: 0;
            overflow-wrap: anywhere;
            color: var(--ink);
            font-size: clamp(48px, 6vw, 78px);
            font-weight: 780;
            letter-spacing: -0.055em;
            line-height: 0.96;
        }

        .app-meta {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 18px;
            color: var(--ink-2);
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 12px;
        }

        .app-meta-divider {
            width: 1px;
            height: 16px;
            background: var(--line-strong);
        }

        .status {
            width: fit-content;
            height: 32px;
            display: inline-flex;
            align-items: center;
            gap: 9px;
            margin-top: 26px;
            padding: 0 13px;
            border: 1px solid var(--nav-line);
            border-radius: 999px;
            color: var(--nav);
            background: var(--nav-soft);
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .status-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--nav);
            box-shadow: 0 0 14px var(--nav);
        }

        .rule {
            height: 1px;
            margin: 38px 0 24px;
            background: var(--line);
        }

        .cta {
            display: grid;
            grid-template-columns: 42px minmax(0, 1fr) auto;
            align-items: center;
            gap: 15px;
            padding: 15px;
            border: 1px solid var(--line-strong);
            border-radius: 12px;
            background: var(--ground-alt);
            transition: border-color 160ms ease, transform 160ms ease;
        }

        .cta:hover,
        .cta:focus-visible {
            border-color: var(--nav-line);
            transform: translateY(-2px);
        }

        .cta-icon {
            width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            border: 1px solid var(--accent-line);
            border-radius: 9px;
            color: var(--accent-hi);
            background: var(--accent-soft);
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-weight: 800;
        }

        .cta-copy {
            min-width: 0;
        }

        .cta-title {
            display: block;
            font-size: 14px;
            font-weight: 750;
        }

        .cta-subtitle {
            display: block;
            margin-top: 3px;
            overflow: hidden;
            color: var(--ink-2);
            font-size: 12px;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .cta-arrow {
            color: var(--nav);
            font-size: 21px;
        }

        .footer {
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--ink-3);
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 10px;
            letter-spacing: 0.04em;
        }

        .footer-dot {
            width: 4px;
            height: 4px;
            border-radius: 50%;
            background: var(--accent);
        }

        .visual {
            position: relative;
            min-height: 720px;
            overflow: hidden;
            border-left: 1px solid var(--line);
            background:
                radial-gradient(circle at 48% 46%, var(--accent-soft), transparent 17rem),
                linear-gradient(145deg, var(--ground-alt), var(--ground-deep));
        }

        .visual::before {
            position: absolute;
            inset: 0;
            content: "";
            opacity: 0.42;
            background-image:
                linear-gradient(30deg, transparent 24%, var(--line) 25%, var(--line) 26%, transparent 27%, transparent 74%, var(--line) 75%, var(--line) 76%, transparent 77%),
                linear-gradient(150deg, transparent 24%, var(--line) 25%, var(--line) 26%, transparent 27%, transparent 74%, var(--line) 75%, var(--line) 76%, transparent 77%);
            background-size: 72px 42px;
            mask-image: radial-gradient(circle at center, black, transparent 72%);
        }

        .runtime-card {
            position: absolute;
            inset: 50% auto auto 50%;
            z-index: 2;
            width: min(78%, 430px);
            overflow: hidden;
            transform: translate(-50%, -50%);
            border: 1px solid var(--line-strong);
            border-radius: 16px;
            background: var(--surface);
            box-shadow: 0 36px 80px var(--shadow), 0 0 80px var(--accent-soft);
        }

        .runtime-bar {
            height: 48px;
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 0 18px;
            border-bottom: 1px solid var(--line-strong);
            background: var(--ground-alt);
        }

        .runtime-bar i {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--ink-3);
        }

        .runtime-bar i:first-child {
            background: var(--accent);
        }

        .runtime-label {
            margin-left: auto;
            color: var(--ink-3);
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 10px;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .runtime-body {
            display: grid;
            gap: 16px;
            padding: 26px;
        }

        .runtime-line {
            display: grid;
            grid-template-columns: 32px minmax(0, 1fr) auto;
            align-items: center;
            gap: 13px;
            min-height: 58px;
            padding: 12px 14px;
            border: 1px solid var(--line-strong);
            border-radius: 10px;
            background: var(--surface-2);
        }

        .runtime-line strong {
            font-size: 13px;
        }

        .runtime-line small {
            display: block;
            margin-top: 3px;
            color: var(--ink-2);
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 10px;
        }

        .runtime-number {
            color: var(--ink-3);
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 10px;
        }

        .runtime-state {
            color: var(--nav);
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 10px;
            font-weight: 700;
        }

        .core {
            display: grid;
            place-items: center;
        }

        .cube {
            width: 32px;
            height: 32px;
            display: grid;
            place-items: center;
            border-radius: 8px;
            border: 1px solid var(--accent-line);
            background: var(--accent-soft);
        }

        .cube picture,
        .cube img {
            width: 22px;
            height: 22px;
            display: block;
            object-fit: contain;
        }

        .runtime-note {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 2px 4px 0;
            color: var(--ink-2);
            font-size: 12px;
            line-height: 1.5;
        }

        .runtime-note::before {
            width: 6px;
            height: 6px;
            flex: none;
            border-radius: 50%;
            content: "";
            background: var(--accent);
        }

        @media (prefers-color-scheme: light) {
            :root {
                --accent: #d6351a;
                --accent-hi: #b32b13;
                --accent-soft: rgba(214, 53, 26, 0.08);
                --accent-line: rgba(214, 53, 26, 0.26);
                --nav: #8f5d00;
                --nav-soft: rgba(143, 93, 0, 0.08);
                --nav-line: rgba(143, 93, 0, 0.26);
                --ground-deep: #f2eff5;
                --ground: #ffffff;
                --ground-alt: #f7f5f9;
                --surface: #faf8fc;
                --surface-2: #f5f2f8;
                --line: #e6e2ec;
                --line-strong: #cec7d8;
                --ink: #0c0a0e;
                --ink-2: #5f5868;
                --ink-3: #867e90;
                --shadow: rgba(45, 32, 55, 0.14);
                --on-accent: #ffffff;
            }

            body {
                background:
                    radial-gradient(circle at 83% 18%, var(--accent-soft), transparent 28rem),
                    linear-gradient(135deg, transparent 0 48%, rgba(20, 10, 30, 0.025) 48% 52%, transparent 52%) 0 0 / 44px 44px,
                    var(--ground-deep);
            }

        }

        @media (max-width: 920px) {
            main {
                min-height: 0;
                grid-template-columns: 1fr;
            }

            .visual {
                min-height: 470px;
                border-top: 1px solid var(--line);
                border-left: 0;
            }
        }

        @media (max-width: 580px) {
            body {
                padding: 0;
            }

            main {
                border: 0;
                border-radius: 0;
            }

            .content {
                padding: 28px 24px 36px;
            }

            .header {
                align-items: flex-start;
                flex-direction: column;
            }

            .hero {
                padding: 72px 0 48px;
            }

            .visual {
                min-height: 410px;
            }

            .runtime-card {
                width: calc(100% - 40px);
            }
        }

        @media (prefers-reduced-motion: no-preference) {
            .status-dot {
                animation: pulse 2.2s ease-in-out infinite;
            }

            @keyframes pulse {
                50% {
                    opacity: 0.48;
                    box-shadow: 0 0 4px var(--nav);
                }
            }
        }
    </style>
</head>
<body>
    <main data-goforj-placeholder="temper-v2">
        <section class="content">
            <header class="header">
                <div class="brand">
                    <picture class="mark">
                        <source media="(prefers-color-scheme: light)" srcset="./goforj-mark-light.svg">
                        <img src="./goforj-mark-dark.svg" alt="GoForj logo">
                    </picture>
                    <span class="brand-copy">
                        <span class="brand-name">GoForj</span>
                        <span class="brand-tagline">The composable stack for building with Go.</span>
                    </span>
                </div>
                <nav class="header-actions" aria-label="GoForj links">
                    <a href="https://goforj.dev">Docs</a>
                    <a href="https://github.com/goforj" aria-label="GoForj on GitHub">
                        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
                            <path fill="currentColor" d="M12 .5A11.5 11.5 0 0 0 8.36 22.9c.58.11.79-.25.79-.56v-2.1c-3.22.7-3.9-1.38-3.9-1.38-.53-1.33-1.29-1.68-1.29-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.38.96.11-.75.41-1.26.74-1.55-2.57-.29-5.27-1.28-5.27-5.72 0-1.26.45-2.3 1.2-3.11-.12-.29-.52-1.47.11-3.06 0 0 .98-.31 3.2 1.19a11.1 11.1 0 0 1 5.84 0c2.22-1.5 3.2-1.19 3.2-1.19.63 1.59.23 2.77.11 3.06.75.81 1.2 1.85 1.2 3.11 0 4.45-2.7 5.43-5.28 5.72.42.36.79 1.08.79 2.18v3.07c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .5Z"></path>
                        </svg>
                        GitHub
                    </a>
                </nav>
            </header>

            <div class="hero">
                <div class="eyebrow">Web surface ready</div>
                <div class="app-heading">
                    <h1>{{if .AppIsDefault}}{{.ProjectName}}{{else}}{{.App.Name}}{{end}}</h1>
                    <div class="app-meta">
                        <span>{{.ProjectName}}</span>
                        <span class="app-meta-divider"></span>
                        <span>{{if .HasNamedApps}}{{.App.Name}}{{else}}local{{end}}</span>
                    </div>
                </div>
                <div class="status"><span class="status-dot"></span>Running</div>

                <div class="rule"></div>

                <a class="cta" href="https://goforj.dev/starter-kits/">
                    <span class="cta-icon">&gt;_</span>
                    <span class="cta-copy">
                        <span class="cta-title">Build the interface</span>
                        <span class="cta-subtitle">Start from the web UI guide or choose a starter kit.</span>
                    </span>
                    <span class="cta-arrow">→</span>
                </a>
            </div>

            <footer class="footer">
                <span>{{if .Render.GoForjVersion}}GoForj {{.Render.GoForjVersion}}{{else}}GoForj{{end}}</span>
                <span class="footer-dot"></span>
                <span>Local development</span>
            </footer>
        </section>

        <section class="visual" aria-hidden="true">
            <div class="runtime-card">
                <div class="runtime-bar">
                    <i></i><i></i><i></i>
                    <span class="runtime-label">GoForj runtime</span>
                </div>
                <div class="runtime-body">
                    <div class="runtime-line">
                        <span class="runtime-number">01</span>
                        <span><strong>Application</strong><small>{{if .AppIsDefault}}{{.ProjectName}}{{else}}{{.App.Name}}{{end}}</small></span>
                        <span class="runtime-state">READY</span>
                    </div>
                    <div class="runtime-line">
                        <span class="runtime-number">02</span>
                        <span><strong>HTTP</strong><small>request pipeline</small></span>
                        <span class="runtime-state">LIVE</span>
                    </div>
                    <div class="runtime-line">
                        <div class="core">
                            <div class="cube">
                                <picture>
                                    <source media="(prefers-color-scheme: light)" srcset="./goforj-mark-light.svg">
                                    <img src="./goforj-mark-dark.svg" alt="">
                                </picture>
                            </div>
                        </div>
                        <span><strong>Your interface</strong><small>frontend build output</small></span>
                        <span class="runtime-state">NEXT</span>
                    </div>
                    <div class="runtime-note">This placeholder gives way to your frontend build.</div>
                </div>
            </div>
        </section>
    </main>
</body>
</html>
