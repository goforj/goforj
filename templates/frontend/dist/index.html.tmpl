<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{if .TargetIsDefault}}{{.ProjectName}}{{else}}{{.ProjectName}} / {{.Target.Name}}{{end}}</title>
    <link rel="icon" href="./goforj-logo.png" type="image/png">
    <link rel="apple-touch-icon" href="./goforj-logo.png">
    <style>
        :root {
            color-scheme: dark;
            --bg: #090b10;
            --panel: #11141c;
            --line: #262b36;
            --text: #f5f7fb;
            --muted: #9aa3b2;
            --accent: #69e6a3;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 32px;
            background:
                radial-gradient(circle at 50% 0%, rgba(105, 230, 163, 0.12), transparent 34rem),
                var(--bg);
            color: var(--text);
            font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        main {
            width: min(100%, 560px);
            padding: 42px;
            border: 1px solid var(--line);
            border-radius: 8px;
            background:
                linear-gradient(180deg, rgba(255, 255, 255, 0.035), transparent 38%),
                rgba(17, 20, 28, 0.92);
            box-shadow: 0 28px 90px rgba(0, 0, 0, 0.36);
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            margin-bottom: 30px;
            padding-bottom: 28px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 13px;
            min-width: 0;
        }

        .mark {
            width: 38px;
            height: 38px;
            object-fit: contain;
        }

        .brand-text {
            display: grid;
            gap: 2px;
        }

        .brand-name {
            color: var(--text);
            font-size: 15px;
            font-weight: 800;
            letter-spacing: 0;
        }

        .brand-subtitle {
            color: var(--muted);
            font-size: 12px;
            font-weight: 650;
            letter-spacing: 0;
        }

        .status {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            height: 28px;
            padding: 0 12px;
            border: 1px solid rgba(105, 230, 163, 0.24);
            border-radius: 999px;
            background: rgba(105, 230, 163, 0.08);
            color: #c7f8dd;
            font-size: 12px;
            font-weight: 750;
            white-space: nowrap;
        }

        .status-dot {
            width: 7px;
            height: 7px;
            border-radius: 999px;
            background: var(--accent);
            box-shadow: 0 0 18px rgba(105, 230, 163, 0.72);
        }

        h1 {
            margin: 0 0 12px;
            font-size: clamp(28px, 5vw, 40px);
            line-height: 1.08;
            letter-spacing: 0;
        }

        p {
            margin: 0;
            color: var(--muted);
            font-size: 16px;
            line-height: 1.6;
        }

        @media (max-width: 520px) {
            main {
                padding: 30px;
            }

            .topbar {
                align-items: flex-start;
                flex-direction: column;
            }
        }
    </style>
</head>
<body>
    <main>
        <div class="topbar">
            <div class="brand">
                <img class="mark" src="./goforj-logo.png" alt="GoForj logo">
                <span class="brand-text">
                    <span class="brand-name">GoForj</span>
                    <span class="brand-subtitle">Composable apps for Go</span>
                </span>
            </div>
            <span class="status"><span class="status-dot"></span>Live</span>
        </div>
        <h1>{{if .TargetIsDefault}}{{.ProjectName}}{{else}}{{.ProjectName}} / {{.Target.Name}}{{end}}</h1>
        <p>Your app is live. Build the interface that belongs here.</p>
    </main>
</body>
</html>
