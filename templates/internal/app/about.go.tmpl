		details = aboutAppendIfSet(details, "Port", scope.Get("PORT", ""))
		details = aboutAppendIfSet(details, "User", scope.Get("USER", ""))
		details = aboutAppendIfSet(details, "Key Path", scope.Get("KEY_PATH", ""))
		details = aboutAppendIfSet(details, "Known Hosts Path", scope.Get("KNOWN_HOSTS_PATH", ""))
		details = aboutAppendIfSet(details, "Insecure Ignore Host Key", aboutTruthyField(scope.Get("INSECURE_IGNORE_HOST_KEY", "")))
	case "gcs":
		details = aboutAppendIfSet(details, "Bucket", scope.Get("BUCKET", ""))
		details = aboutAppendIfSet(details, "Endpoint", scope.Get("ENDPOINT", ""))
	case "dropbox":
		// Token is intentionally omitted.
	case "rclone":
		details = aboutAppendIfSet(details, "Remote", scope.Get("REMOTE", ""))
		details = aboutAppendIfSet(details, "Config Path", scope.Get("RCLONE_CONFIG_PATH", ""))
	default:
