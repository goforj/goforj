func aboutDatabaseReports() []AboutDatabase {
	instances := DiscoverDatabaseInstances()
	reports := make([]AboutDatabase, 0, len(instances))
	for _, instance := range instances {
		name := instance.Name
		dsn := aboutMaskDSN(aboutDatabaseEnv(name, "DSN"))
		if dsn == "-" {
			dsn = ""
		}
		host := ""
		port := ""
		database := ""
		url := ""
		switch instance.Driver {
		case "postgres", "postgresql", "mysql", "mariadb":
			host = strings.TrimSpace(aboutDatabaseEnv(name, "HOST"))
			port = strings.TrimSpace(aboutDatabaseEnv(name, "PORT"))
			database = strings.TrimSpace(aboutDatabaseEnv(name, "DATABASE"))
			if host != "" && port != "" && database != "" {
				url = host + ":" + port + "/" + database
			}
		}
		details := aboutDatabaseDetails(name)
		reports = append(reports, AboutDatabase{
			Name:      name,
			IsDefault: instance.IsDefault,
			Driver:    instance.Driver,
			Host:      host,
			Port:      port,
			Database:  database,
			DSN:       dsn,
			URL:       url,
			Summary:   aboutDetailSummary(details),
			Details:   details,
		})
	}
	return reports
}

func aboutCacheReports() []AboutCache {
	instances := DiscoverCacheInstances()
	reports := make([]AboutCache, 0, len(instances))
	for _, instance := range instances {
		name := instance.Name
		scope := aboutPrimitiveScope("CACHE", name)
		driver := instance.Driver
		url := ""
		fileDir := ""
		if driver == "redis" {
			url = strings.TrimPrefix(aboutRedisSummary(scope, "CACHE"), "redis://")
		}
		if driver == "file" {
			fileDir = strings.TrimSpace(scope.Get("FILE_DIR", ""))
			if fileDir == "" {
				fileDir = filepath.Join(os.TempDir(), "cache-file")
				if name != "default" {
					fileDir = filepath.Join(fileDir, name)
				}
			}
		}
		details := aboutCacheDetails(name)
		reports = append(reports, AboutCache{
			Name:      name,
			IsDefault: instance.IsDefault,
			Driver:    driver,
			URL:       url,
			FileDir:   fileDir,
			Summary:   aboutDetailSummary(details),
			Details:   details,
		})
	}
	return reports
}

func aboutQueueReports() []AboutQueue {
	instances := DiscoverQueueInstances()
	reports := make([]AboutQueue, 0, len(instances))
	for _, instance := range instances {
		name := instance.Name
		scope := aboutPrimitiveScope("QUEUE", name)
		details := aboutQueueDetails(name)
		reports = append(reports, AboutQueue{
			Name:         name,
			IsDefault:    instance.IsDefault,
			Driver:       instance.Driver,
			DefaultQueue: QueueDefaultQueue(name),
			Workers:      strings.TrimSpace(scope.Get("WORKERS", scope.Get("WORKERPOOL_WORKERS", "30"))),
			URL:          aboutFieldValue(details, "Address", "URL", "DSN"),
			Summary:      aboutDetailSummary(details),
			Details:      details,
		})
	}
	return reports
}

func aboutStorageReports() []AboutStorage {
	instances := DiscoverStorageInstances()
	reports := make([]AboutStorage, 0, len(instances))
	for _, instance := range instances {
		name := instance.Name
		scope := aboutPrimitiveScope("STORAGE", name)
		driver := instance.Driver
		root := strings.TrimSpace(scope.Get("ROOT", ""))
		if root == "" && driver == "local" {
			root = filepath.Join("storage", "app", name)
			if name == "default" {
				root = filepath.Join("storage", "app", "private")
			}
		}
		details := aboutStorageDetails(name)
		reports = append(reports, AboutStorage{
			Name:      name,
			IsDefault: instance.IsDefault,
			Driver:    driver,
			Root:      root,
			URL:       aboutFieldValue(details, "Address", "Endpoint", "Remote"),
			Summary:   aboutDetailSummary(details),
			Details:   details,
		})
	}
	return reports
}

