func aboutPrimitiveChildDefined(prefix string, scope env.Scope) bool {
	switch prefix {
	case "CACHE":
		return aboutAnySet(scope, "DRIVER", "FILE_DIR", "ADDR", "URL", "DSN")
	case "QUEUE":
		return aboutAnySet(scope, "DRIVER", "ADDR", "URL", "DSN", "WORKERS", "DEFAULT_QUEUE", "WORKERPOOL_WORKERS", "QUEUES")
	case "STORAGE":
		return aboutAnySet(scope, "DRIVER", "ROOT", "BUCKET", "REMOTE", "URL", "ADDR")
	case "EVENTS":
		return aboutAnySet(scope, "DRIVER", "ADDR", "URL", "BROKERS", "PROJECT_ID", "URI", "REGION", "ENDPOINT")
	default:
		return false
	}
}

func aboutDatabaseChildDefined(scope env.Scope) bool {
	return aboutAnySet(scope, "DRIVER", "DSN", "DATABASE", "HOST")
}

func aboutAnySet(scope env.Scope, keys ...string) bool {
	for _, key := range keys {
		if strings.TrimSpace(scope.Get(key, "")) != "" {
			return true
		}
	}
	return false
}

func aboutDatabaseDetails(name string) []AboutField {
	driver := NormalizeDBDriver(aboutDatabaseEnv(name, "DRIVER"))
	dsn := aboutMaskDSN(aboutDatabaseEnv(name, "DSN"))
	details := []AboutField{
		{Key: "Driver", Value: fallbackAboutValue(driver, "-")},
	}
	switch driver {
	case "postgres", "postgresql", "mysql", "mariadb":
		if host := strings.TrimSpace(aboutDatabaseEnv(name, "HOST")); host != "" {
			details = append(details, AboutField{Key: "Host", Value: host})
		}
		if port := strings.TrimSpace(aboutDatabaseEnv(name, "PORT")); port != "" {
			details = append(details, AboutField{Key: "Port", Value: port})
		}
		if database := strings.TrimSpace(aboutDatabaseEnv(name, "DATABASE")); database != "" {
			details = append(details, AboutField{Key: "Database", Value: database})
		}
		if dsn != "-" && len(details) == 1 {
			details = append(details, AboutField{Key: "DSN", Value: dsn})
		}
	case "sqlite":
		if dsn != "-" {
			details = append(details, AboutField{Key: "DSN", Value: dsn})
		}
	default:
		if dsn != "-" {
			details = append(details, AboutField{Key: "DSN", Value: dsn})
		}
	}
	details = aboutAppendIfTrue(details, "Query Logging", aboutDatabaseEnv(name, "QUERY_LOGGING"))
	details = aboutAppendIfSet(details, "Max Idle", aboutDatabaseEnv(name, "MAX_IDLE_CONNECTIONS"))
	details = aboutAppendIfSet(details, "Max Open", aboutDatabaseEnv(name, "MAX_OPEN_CONNECTIONS"))
	details = aboutAppendIfSet(details, "Conn Max Lifetime Minutes", aboutDatabaseEnv(name, "CONN_MAX_LIFETIME_MINUTES"))
	return details
}

func aboutCacheDetails(name string) []AboutField {
	scope := aboutPrimitiveScope("CACHE", name)
	driver := NormalizeCacheDriver(scope.Get("DRIVER", "memory"))
	if driver == "" {
		driver = "memory"
	}
	details := []AboutField{
		{Key: "Driver", Value: driver},
	}
	switch driver {
	case "null", "memory":
		details = aboutAppendIfNot(details, "Cleanup Seconds", scope.Get("MEMORY_CLEANUP_SECONDS", ""), "600")
	case "redis":
		details = append(details, AboutField{Key: "Address", Value: strings.TrimPrefix(aboutRedisSummary(scope, "CACHE"), "redis://")})
		details = aboutAppendIfSet(details, "Username", scope.Get("USERNAME", ""))
		details = aboutAppendIfSet(details, "TLS", aboutTruthyField(scope.Get("TLS", "")))
	case "file":
		dir := strings.TrimSpace(scope.Get("FILE_DIR", ""))
		if dir == "" {
			dir = filepath.Join(os.TempDir(), "cache-file")
			if name != "default" {
				dir = filepath.Join(dir, name)
			}
		}
		details = append(details, AboutField{Key: "Directory", Value: dir})
	case "memcached":
		if addresses := strings.TrimSpace(scope.Get("ADDRESSES", "")); addresses != "" {
			details = append(details, AboutField{Key: "Addresses", Value: addresses})
		} else if addr := strings.TrimSpace(scope.Get("ADDR", "")); addr != "" {
			details = append(details, AboutField{Key: "Address", Value: addr})
		}
	case "dynamodb":
		if table := strings.TrimSpace(scope.Get("TABLE", "")); table != "" {
			details = append(details, AboutField{Key: "Table", Value: table})
		}
		if region := strings.TrimSpace(scope.Get("REGION", "")); region != "" {
			details = append(details, AboutField{Key: "Region", Value: region})
		}
		details = aboutAppendIfSet(details, "Endpoint", scope.Get("ENDPOINT", ""))
	case "nats":
		details = aboutAppendIfSet(details, "URL", scope.Get("URL", ""))
		details = aboutAppendIfSet(details, "Bucket", scope.Get("BUCKET", ""))
		details = aboutAppendIfSet(details, "Bucket TTL Seconds", aboutFirstNonEmpty(scope.Get("BUCKET_TTL_SECONDS", ""), scope.Get("BUCKET_TTL", "")))
		details = aboutAppendIfSet(details, "Description", scope.Get("DESCRIPTION", ""))
		details = aboutAppendIfSet(details, "History", scope.Get("HISTORY", ""))
		details = aboutAppendIfSet(details, "Max Bytes", scope.Get("MAX_BYTES", ""))
		details = aboutAppendIfSet(details, "Max Value Size", scope.Get("MAX_VALUE_SIZE", ""))
		details = aboutAppendIfSet(details, "Replicas", scope.Get("REPLICAS", ""))
		details = aboutAppendIfSet(details, "Storage", scope.Get("STORAGE", ""))
		details = aboutAppendIfSet(details, "Compressed", aboutTruthyField(scope.Get("COMPRESSED", "")))
	default:
		if url := strings.TrimSpace(scope.Get("URL", "")); url != "" {
			details = append(details, AboutField{Key: "URL", Value: url})
		} else if addr := strings.TrimSpace(scope.Get("ADDR", "")); addr != "" {
			details = append(details, AboutField{Key: "Address", Value: addr})
		} else if dsn := aboutMaskDSN(scope.Get("DSN", "")); dsn != "-" {
			details = append(details, AboutField{Key: "DSN", Value: dsn})
		} else if table := strings.TrimSpace(scope.Get("TABLE", "")); table != "" {
			details = append(details, AboutField{Key: "Table", Value: table})
		}
	}
	details = aboutAppendIfNot(details, "Prefix", scope.Get("PREFIX", ""), "app")
	details = aboutAppendIfNot(details, "Default TTL Seconds", scope.Get("DEFAULT_TTL_SECONDS", ""), "300")
	details = aboutAppendIfNot(details, "Compression", scope.Get("COMPRESSION", ""), "none")
	details = aboutAppendIfSet(details, "Max Value Bytes", scope.Get("MAX_VALUE_BYTES", ""))
	return details
}

func aboutQueueDetails(name string) []AboutField {
	scope := aboutPrimitiveScope("QUEUE", name)
	driver := NormalizeQueueDriver(scope.Get("DRIVER", "workerpool"))
	if driver == "" {
		driver = "workerpool"
	}
	details := []AboutField{
		{Key: "Driver", Value: driver},
	}
	switch driver {
	case "sync", "null":
	case "redis":
		details = append(details, AboutField{Key: "Address", Value: strings.TrimPrefix(aboutRedisSummary(scope, "QUEUE"), "redis://")})
		details = aboutAppendIfNot(details, "Server Log Level", queueRedisLogLevelAbout(scope), "error")
		details = aboutAppendIfSet(details, "Queues", strings.TrimSpace(scope.Get("QUEUES", scope.Get("REDIS_QUEUES", ""))))
	case "nats", "sqs", "rabbitmq":
		if url := strings.TrimSpace(scope.Get("URL", "")); url != "" {
			details = append(details, AboutField{Key: "URL", Value: url})
		}
		if driver == "sqs" {
			details = aboutAppendIfSet(details, "Region", scope.Get("REGION", ""))
			details = aboutAppendIfSet(details, "Endpoint", scope.Get("ENDPOINT", ""))
		}
	case "workerpool":
		details = append(details, AboutField{Key: "Workers", Value: strings.TrimSpace(scope.Get("WORKERS", scope.Get("WORKERPOOL_WORKERS", "30")))})
		details = aboutAppendIfSet(details, "Buffer", scope.Get("WORKERPOOL_BUFFER", ""))
		details = aboutAppendIfSet(details, "Task Timeout Seconds", scope.Get("WORKERPOOL_TASK_TIMEOUT_SECONDS", ""))
	default:
		if url := strings.TrimSpace(scope.Get("URL", "")); url != "" {
			details = append(details, AboutField{Key: "URL", Value: url})
		} else if dsn := aboutMaskDSN(scope.Get("DSN", "")); dsn != "-" {
			details = append(details, AboutField{Key: "DSN", Value: dsn})
		}
		details = aboutAppendIfSet(details, "Recovery Grace Seconds", scope.Get("PROCESSING_RECOVERY_GRACE_SECONDS", ""))
		details = aboutAppendIfSet(details, "Lease No Timeout Seconds", scope.Get("PROCESSING_LEASE_NO_TIMEOUT_SECONDS", ""))
	}
	if queue := strings.TrimSpace(scope.Get("DEFAULT_QUEUE", "default")); queue != "" && queue != "default" {
		details = append(details, AboutField{Key: "Default Queue", Value: queue})
	}
	details = aboutAppendIfNot(details, "Shutdown Timeout", env.Get("QUEUE_SHUTDOWN_TIMEOUT", ""), "10s")
	return details
}

