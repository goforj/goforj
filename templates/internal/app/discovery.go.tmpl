	driver := strings.TrimSpace(strings.ToLower(v))
	switch {
	case driver == "", driver == "-", driver == "nil", driver == "<nil>":
		return ""
	case strings.Contains(driver, "natsjetstream"):
		return "natsjetstream"
	case strings.Contains(driver, "gcppubsub"):
		return "gcppubsub"
	case strings.Contains(driver, "redis"):
		return "redis"
	case strings.Contains(driver, "nats"):
		return "nats"
	case strings.Contains(driver, "kafka"):
		return "kafka"
	case strings.Contains(driver, "sns"):
