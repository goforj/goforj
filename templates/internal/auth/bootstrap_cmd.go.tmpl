package auth

import "{{.GoModuleName}}/internal/console"

// BootstrapCmd runs the local bootstrap-user convenience flow explicitly.
type BootstrapCmd struct {
	authService *Service
}

// Signature defines CLI metadata for this command.
func (*BootstrapCmd) Signature() string {
	return `name:"auth:bootstrap" help:"Create the local bootstrap auth user from env"`
}

// NewBootstrapCmd creates a new BootstrapCmd.
func NewBootstrapCmd(authService *Service) *BootstrapCmd {
	return &BootstrapCmd{authService: authService}
}

// Run executes the command.
func (c *BootstrapCmd) Run() error {
	created, err := c.authService.EnsureLocalBootstrapUserFromEnv()
	if err != nil {
		return err
	}
	if !created {
		console.Infof("bootstrap user not created")
		return nil
	}
	console.Successf("bootstrap user ensured")
	return nil
}
