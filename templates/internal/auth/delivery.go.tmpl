package auth

import (
	"context"
	"fmt"
	"html"
	"net/url"
	"strings"

	"github.com/goforj/env/v2"
	"github.com/goforj/str/v2"
	"{{.GoModuleName}}/internal/logger"
)

// Delivery owns outbound auth account-flow notifications.
type Delivery interface {
	// SendPasswordReset delivers a password reset grant for a user.
	SendPasswordReset(context.Context, PasswordResetDelivery) error
	// SendEmailVerification delivers an email verification grant for a user.
	SendEmailVerification(context.Context, EmailVerificationDelivery) error
}

// PasswordResetDelivery is the payload for a password reset notification.
type PasswordResetDelivery struct {
	User      *User
	RawToken  string
	ExpiresAt string
	UserAgent string
	IPAddress string
}

// EmailVerificationDelivery is the payload for an email verification notification.
type EmailVerificationDelivery struct {
	User      *User
	RawToken  string
	ExpiresAt string
	UserAgent string
	IPAddress string
}

// LogDelivery logs auth delivery intents for local/dev and fallback production use.
type LogDelivery struct {
	logger *logger.AppLogger
}

// NewLogDelivery creates the default generated auth delivery implementation.
func NewLogDelivery(logger *logger.AppLogger) Delivery {
	return &LogDelivery{logger: logger}
}

// SendPasswordReset logs the password reset delivery intent.
func (d *LogDelivery) SendPasswordReset(_ context.Context, payload PasswordResetDelivery) error {
	d.logger.Info().
		Str("auth_flow", "password_reset").
		Str("email", payload.User.Email).
		Str("username", payload.User.Username).
		Str("expires_at", payload.ExpiresAt).
		Str("ip_address", payload.IPAddress).
		Str("user_agent", payload.UserAgent).
		Str("token", payload.RawToken).
		Str("reset_url", passwordResetURL(payload.RawToken)).
		Msg("auth password reset delivery")
	return nil
}

// SendEmailVerification logs the email verification delivery intent.
func (d *LogDelivery) SendEmailVerification(_ context.Context, payload EmailVerificationDelivery) error {
	d.logger.Info().
		Str("auth_flow", "email_verification").
		Str("email", payload.User.Email).
		Str("username", payload.User.Username).
		Str("expires_at", payload.ExpiresAt).
		Str("ip_address", payload.IPAddress).
		Str("user_agent", payload.UserAgent).
		Str("token", payload.RawToken).
		Msg("auth email verification delivery")
	return nil
}

// PasswordResetMessage builds the generated password reset subject and bodies.
func PasswordResetMessage(payload PasswordResetDelivery) (string, string, string) {
	return "Reset your password", passwordResetText(payload), passwordResetHTML(payload)
}

// EmailVerificationMessage builds the generated email verification subject and bodies.
func EmailVerificationMessage(payload EmailVerificationDelivery) (string, string, string) {
	return "Verify your email", emailVerificationText(payload), emailVerificationHTML(payload)
}

func deliveryName(user *User) string {
	if user == nil {
		return ""
	}
	if strings.TrimSpace(user.DisplayName) != "" {
		return user.DisplayName
	}
	return user.Username
}

func passwordResetText(payload PasswordResetDelivery) string {
	return fmt.Sprintf(
		"Hello %s,\n\nYou are receiving this email because we received a password reset request for your account.\n\nReset Password:\n%s\n\nThis password reset link expires at %s.\n\nIf you did not request a password reset, no further action is required.\n\nRegards,\nGoForj\n",
		deliveryGreeting(payload.User),
		passwordResetURL(payload.RawToken),
		payload.ExpiresAt,
	)
}

func passwordResetHTML(payload PasswordResetDelivery) string {
	return renderAuthEmail(
		"Password reset",
		fmt.Sprintf("Hello %s,", deliveryGreeting(payload.User)),
		"You are receiving this email because we received a password reset request for your account.",
		"Reset Password",
		passwordResetURL(payload.RawToken),
		fmt.Sprintf("This password reset link expires at %s.", payload.ExpiresAt),
		"If you did not request a password reset, no further action is required.",
	)
}

func emailVerificationText(payload EmailVerificationDelivery) string {
	return fmt.Sprintf(
		"Hello %s,\n\nPlease click the link below to verify your email address.\n\nVerify Email Address:\n%s\n\nThis verification link expires at %s.\n\nIf you did not create an account, no further action is required.\n\nRegards,\nGoForj\n",
		deliveryGreeting(payload.User),
		emailVerificationURL(payload.RawToken),
		payload.ExpiresAt,
	)
}

func emailVerificationHTML(payload EmailVerificationDelivery) string {
	return renderAuthEmail(
		"Verify your email",
		fmt.Sprintf("Hello %s,", deliveryGreeting(payload.User)),
		"Please click the button below to verify your email address.",
		"Verify Email Address",
		emailVerificationURL(payload.RawToken),
		fmt.Sprintf("This verification link expires at %s.", payload.ExpiresAt),
		"If you did not create an account, no further action is required.",
	)
}

func renderAuthEmail(title, greeting, intro, actionText, actionURL, outro, closing string) string {
	return fmt.Sprintf(`
<!doctype html>
<html lang="en">
  <body style="margin:0; padding:0; background:#09090b; color:#e4e4e7; font-family:Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;">
    <div style="margin:0; padding:32px 16px; background:#09090b;">
      <div style="max-width:600px; margin:0 auto;">
        <div style="background:#111114; border:1px solid #27272a; border-radius:20px; overflow:hidden; box-shadow:0 24px 64px rgba(0,0,0,0.35);">
          <div style="padding:40px 40px 32px;">
            <div style="display:inline-block; margin-bottom:20px; padding:7px 12px; border-radius:999px; border:1px solid #27272a; background:#18181b; color:#a1a1aa; font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.08em;">Account email</div>
            <h1 style="margin:0 0 16px; color:#fafafa; font-size:30px; line-height:1.15; letter-spacing:-0.03em;">%s</h1>
            <p style="margin:0 0 16px; color:#fafafa; font-size:16px; line-height:1.7;">%s</p>
            <p style="margin:0 0 28px; color:#a1a1aa; font-size:16px; line-height:1.7;">%s</p>
            <p style="margin:0 0 28px; color:#fafafa; font-size:16px; line-height:1.7;">
              <a href="%s" style="color:#fafafa; text-decoration:underline; font-weight:700;">%s</a>
            </p>
            <p style="margin:0 0 14px; color:#a1a1aa; font-size:15px; line-height:1.7;">%s</p>
            <p style="margin:0; color:#a1a1aa; font-size:15px; line-height:1.7;">%s</p>
          </div>
          <div style="border-top:1px solid #27272a; padding:24px 40px; background:#0d0d10;">
            <p style="margin:0; color:#a1a1aa; font-size:14px; line-height:1.7; word-break:break-all;">
              Direct link:<br>
              <a href="%s" style="color:#fafafa; text-decoration:underline;">%s</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>`,
		html.EscapeString(title),
		html.EscapeString(greeting),
		html.EscapeString(intro),
		html.EscapeString(actionURL),
		html.EscapeString(actionText),
		html.EscapeString(outro),
		html.EscapeString(closing),
		html.EscapeString(actionURL),
		html.EscapeString(actionURL),
	)
}

func deliveryGreeting(user *User) string {
	name := strings.TrimSpace(deliveryName(user))
	if name == "" {
		return "there"
	}
	return name
}

func passwordResetURL(rawToken string) string {
	baseURL := strings.TrimRight(str.Of(env.Get("APP_URL", "http://localhost:3000")).Trim().String(), "/")
	return baseURL + "/reset-password?token=" + url.QueryEscape(strings.TrimSpace(rawToken))
}

func emailVerificationURL(rawToken string) string {
	baseURL := strings.TrimRight(str.Of(env.Get("APP_URL", "http://localhost:3000")).Trim().String(), "/")
	return baseURL + "/verify-email?token=" + url.QueryEscape(strings.TrimSpace(rawToken))
}
