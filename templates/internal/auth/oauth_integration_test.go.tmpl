func TestAppleProviderResolveIdentityIntegration(t *testing.T) {
	signingKey, err := rsa.GenerateKey(rand.Reader, 2048)
	if err != nil {
		t.Fatalf("generate apple signing key: %v", err)
	}
	ecKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
	if err != nil {
		t.Fatalf("generate apple client secret key: %v", err)
	}
	ecDER, err := x509.MarshalPKCS8PrivateKey(ecKey)
	if err != nil {
		t.Fatalf("marshal apple private key: %v", err)
	}
	appleNonce := "apple-nonce"
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		switch r.URL.Path {
		case "/token":
			token := jwt.NewWithClaims(jwt.SigningMethodRS256, jwt.MapClaims{
				"iss":            "https://appleid.apple.com",
				"aud":            "apple-client",
				"sub":            "apple-sub",
				"email":          "apple@example.com",
				"email_verified": "true",
				"nonce":          appleNonce,
				"exp":            time.Now().UTC().Add(time.Hour).Unix(),
				"iat":            time.Now().UTC().Unix(),
			})
			token.Header["kid"] = "apple-rsa-kid"
			rawToken, err := token.SignedString(signingKey)
			if err != nil {
				t.Fatalf("sign apple id token: %v", err)
			}
			writeJSON(t, w, map[string]any{"access_token": "apple-access", "id_token": rawToken})
		case "/keys":
			n := base64.RawURLEncoding.EncodeToString(signingKey.PublicKey.N.Bytes())
			e := base64.RawURLEncoding.EncodeToString(big.NewInt(int64(signingKey.PublicKey.E)).Bytes())
			writeJSON(t, w, map[string]any{
				"keys": []map[string]any{
					{"kid": "apple-rsa-kid", "kty": "RSA", "n": n, "e": e},
				},
			})
		default:
			t.Fatalf("unexpected apple stub path: %s", r.URL.Path)
		}
	}))
	defer server.Close()

	t.Setenv("AUTH_OAUTH_APPLE_CLIENT_ID", "apple-client")
	t.Setenv("AUTH_OAUTH_APPLE_TEAM_ID", "apple-team")
	t.Setenv("AUTH_OAUTH_APPLE_KEY_ID", "apple-key")
	t.Setenv("AUTH_OAUTH_APPLE_PRIVATE_KEY", string(pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: ecDER})))
	t.Setenv("AUTH_OAUTH_APPLE_AUTH_URL", server.URL+"/authorize")
	t.Setenv("AUTH_OAUTH_APPLE_TOKEN_URL", server.URL+"/token")
	t.Setenv("AUTH_OAUTH_APPLE_JWKS_URL", server.URL+"/keys")
	t.Setenv("AUTH_OAUTH_APPLE_RESPONSE_MODE", "query")

	provider := NewAppleProvider()
	identity, err := provider.ResolveIdentity(context.Background(), OAuthCallback{
		Code:         "oauth-code",
		RedirectURI:  "https://app.example/callback",
		CodeVerifier: "verifier",
		Nonce:        appleNonce,
	})
	if err != nil {
		t.Fatalf("resolve apple identity: %v", err)
	}
	if identity.Subject != "apple-sub" || identity.Email != "apple@example.com" || !identity.EmailVerified {
		t.Fatalf("apple identity = %#v", identity)
	}
}

type oauthStubConfig struct {
	tokenResponse map[string]any
	userInfo      map[string]any
	extraHandlers map[string]http.HandlerFunc
}

func newOAuthStubServer(t *testing.T, cfg oauthStubConfig) *httptest.Server {
	t.Helper()
	mux := http.NewServeMux()
	mux.HandleFunc("/token", func(w http.ResponseWriter, r *http.Request) {
		writeJSON(t, w, cfg.tokenResponse)
	})
	mux.HandleFunc("/userinfo", func(w http.ResponseWriter, r *http.Request) {
		writeJSON(t, w, cfg.userInfo)
	})
	mux.HandleFunc("/authorize", func(w http.ResponseWriter, r *http.Request) {
		writeJSON(t, w, map[string]any{"ok": true})
	})
	for path, handler := range cfg.extraHandlers {
		mux.HandleFunc(path, handler)
	}
	server := httptest.NewServer(mux)
	t.Cleanup(server.Close)
	return server
}

func writeJSON(t *testing.T, w http.ResponseWriter, payload any) {
	t.Helper()
	w.Header().Set("Content-Type", "application/json")
	if err := json.NewEncoder(w).Encode(payload); err != nil {
		t.Fatalf("encode json response: %v", err)
	}
}

func firstQueryValue(t *testing.T, rawURL, key string) string {
	t.Helper()
	parsed, err := url.Parse(rawURL)
	if err != nil {
		t.Fatalf("parse url %q: %v", rawURL, err)
	}
	return parsed.Query().Get(key)
}
