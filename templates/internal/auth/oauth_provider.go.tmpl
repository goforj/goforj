// ErrProviderDisabled indicates that the requested OAuth provider is not configured.
var ErrProviderDisabled = errors.New("oauth provider disabled")

// OAuthCompletionResult is the outcome of an OAuth callback.
type OAuthCompletionResult struct {
	User       *User
	Identity   *AuthIdentity
	Tokens     SessionTokens
	RedirectTo string
	Linked     bool
}

// OAuthProvider starts and completes one provider-specific OAuth flow.
type OAuthProvider interface {
	Name() string
	Enabled() bool
	AuthCodeURL(state *OAuthStateToken, redirectURI string) (string, error)
	ResolveIdentity(context.Context, OAuthCallback) (ProviderIdentity, error)
}

// OAuthProviders indexes the configured OAuth providers by name.
type OAuthProviders struct {
	providers map[string]OAuthProvider
}

// NewOAuthProviders creates the built-in OAuth provider registry.
func NewOAuthProviders() *OAuthProviders {
	providers := map[string]OAuthProvider{}
	for _, provider := range []OAuthProvider{
		NewGitHubProvider(),
		NewGoogleProvider(),
		NewMicrosoftProvider(),
		NewAppleProvider(),
	} {
		providers[provider.Name()] = provider
	}
	return &OAuthProviders{providers: providers}
}

// ByName resolves one provider by its stable provider name.
func (p *OAuthProviders) ByName(name string) (OAuthProvider, bool) {
	provider, ok := p.providers[str.Of(name).ToLower().Trim().String()]
	return provider, ok
}

// Names returns the stable provider names in the registry.
func (p *OAuthProviders) Names() []string {
	names := make([]string, 0, len(p.providers))
	for name := range p.providers {
		names = append(names, name)
	}
	return names
}

type oauthProviderBase struct {
	name            string
	clientID        string
	clientSecret    string
	authURL         string
	tokenURL        string
	userInfoURL     string
	userEmailsURL   string
	jwksURL         string
	tenant          string
	scopes          []string
	extraAuthParams map[string]string
}

func (p oauthProviderBase) Name() string {
	return p.name
}

func (p oauthProviderBase) Enabled() bool {
	if strings.TrimSpace(p.clientID) == "" {
		return false
	}
	if p.name == "apple" {
		return strings.TrimSpace(env.Get("AUTH_OAUTH_APPLE_TEAM_ID", "")) != "" &&
			strings.TrimSpace(env.Get("AUTH_OAUTH_APPLE_KEY_ID", "")) != "" &&
			strings.TrimSpace(env.Get("AUTH_OAUTH_APPLE_PRIVATE_KEY", "")) != ""
	}
	return strings.TrimSpace(p.clientSecret) != ""
}

func (p oauthProviderBase) oauthConfig(redirectURI string) *oauth2.Config {
	return &oauth2.Config{
		ClientID:     p.clientID,
		ClientSecret: p.clientSecret,
		RedirectURL:  redirectURI,
		Scopes:       append([]string{}, p.scopes...),
		Endpoint: oauth2.Endpoint{
			AuthURL:  p.authURL,
			TokenURL: p.tokenURL,
		},
	}
}

func (p oauthProviderBase) AuthCodeURL(state *OAuthStateToken, redirectURI string) (string, error) {
	if !p.Enabled() {
		return "", ErrProviderDisabled
	}
	cfg := p.oauthConfig(redirectURI)
	opts := []oauth2.AuthCodeOption{
		oauth2.SetAuthURLParam("code_challenge", oauthCodeChallenge(state.CodeVerifier)),
		oauth2.SetAuthURLParam("code_challenge_method", "S256"),
	}
	if state.Nonce != "" {
		opts = append(opts, oauth2.SetAuthURLParam("nonce", state.Nonce))
	}
	for key, value := range p.extraAuthParams {
		opts = append(opts, oauth2.SetAuthURLParam(key, value))
	}
	return cfg.AuthCodeURL(state.State, opts...), nil
}

func oauthHTTPClient() *http.Client {
	return &http.Client{Timeout: 15 * time.Second}
}

func oauthGetJSON(ctx context.Context, endpoint, accessToken string, target any) error {
	req, err := http.NewRequestWithContext(ctx, http.MethodGet, endpoint, nil)
	if err != nil {
		return err
	}
	req.Header.Set("Accept", "application/json")
	if accessToken != "" {
		req.Header.Set("Authorization", "Bearer "+accessToken)
	}
	res, err := oauthHTTPClient().Do(req)
	if err != nil {
		return err
	}
	defer res.Body.Close()
	if res.StatusCode < 200 || res.StatusCode >= 300 {
		body, _ := io.ReadAll(io.LimitReader(res.Body, 2048))
		return fmt.Errorf("oauth request failed: %s (%s)", res.Status, strings.TrimSpace(string(body)))
	}
	return json.NewDecoder(res.Body).Decode(target)
}

func oauthPostFormJSON(ctx context.Context, endpoint string, values url.Values, headers map[string]string, target any) error {
	req, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint, strings.NewReader(values.Encode()))
	if err != nil {
		return err
	}
	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
	req.Header.Set("Accept", "application/json")
	for key, value := range headers {
		req.Header.Set(key, value)
	}
	res, err := oauthHTTPClient().Do(req)
	if err != nil {
		return err
	}
	defer res.Body.Close()
	if res.StatusCode < 200 || res.StatusCode >= 300 {
		body, _ := io.ReadAll(io.LimitReader(res.Body, 2048))
		return fmt.Errorf("oauth token request failed: %s (%s)", res.Status, strings.TrimSpace(string(body)))
	}
	return json.NewDecoder(res.Body).Decode(target)
}

func oauthCodeChallenge(codeVerifier string) string {
	sum := sha256.Sum256([]byte(codeVerifier))
	return base64.RawURLEncoding.EncodeToString(sum[:])
}

func generateOAuthCodeVerifier() (string, error) {
	buf := make([]byte, 48)
	if _, err := rand.Read(buf); err != nil {
		return "", err
	}
	return base64.RawURLEncoding.EncodeToString(buf), nil
}

func generateOAuthNonce() (string, error) {
	return randomToken(24)
}

func oauthStateTTL() time.Duration {
	return parseDurationEnv("AUTH_OAUTH_STATE_TTL", 10*time.Minute)
}

func oauthDefaultRedirectTo() string {
	return "/api/v1/auth/me"
}

func sanitizeOAuthRedirectTarget(value string) string {
	value = strings.TrimSpace(value)
	if value == "" {
		return oauthDefaultRedirectTo()
	}
	if !strings.HasPrefix(value, "/") || strings.HasPrefix(value, "//") {
		return oauthDefaultRedirectTo()
	}
	return value
}

func oauthCallbackURL(r web.Context, provider string) string {
	scheme := strings.TrimSpace(r.Scheme())
	if scheme == "" {
		scheme = "http"
	}
	return scheme + "://" + r.Host() + "/api/v1/auth/oauth/" + strings.TrimSpace(provider) + "/callback"
}

func parseBoolString(value string) bool {
	switch str.Of(value).Trim().ToLower().String() {
	case "1", "true", "yes", "on":
		return true
	default:
		return false
	}
}

// pemPrivateKeyFromEnv accepts encoded or literal PEM because deployment secret stores commonly support only one shape.
func pemPrivateKeyFromEnv(key string) (any, error) {
	raw := strings.TrimSpace(env.Get(key, ""))
	if raw == "" {
		return nil, fmt.Errorf("%s is required", key)
	}
	block, _ := pem.Decode([]byte(raw))
	if block == nil {
		decoded, err := base64.StdEncoding.DecodeString(raw)
		if err == nil {
			block, _ = pem.Decode(decoded)
		}
	}
	if block == nil {
		return nil, fmt.Errorf("decode PEM %s", key)
	}
	if privateKey, err := x509.ParsePKCS8PrivateKey(block.Bytes); err == nil {
		return privateKey, nil
	}
	if privateKey, err := x509.ParsePKCS1PrivateKey(block.Bytes); err == nil {
		return privateKey, nil
	}
	if privateKey, err := x509.ParseECPrivateKey(block.Bytes); err == nil {
		return privateKey, nil
	}
	return nil, fmt.Errorf("parse private key %s", key)
}

func rsaPublicKeyFromJWK(nRaw, eRaw string) (*rsa.PublicKey, error) {
	nBytes, err := base64.RawURLEncoding.DecodeString(nRaw)
	if err != nil {
		return nil, err
	}
	eBytes, err := base64.RawURLEncoding.DecodeString(eRaw)
	if err != nil {
		return nil, err
	}
	n := new(big.Int).SetBytes(nBytes)
	e := 0
	for _, b := range eBytes {
		e = e<<8 + int(b)
	}
	return &rsa.PublicKey{N: n, E: e}, nil
}
