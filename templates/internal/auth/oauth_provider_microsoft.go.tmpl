package auth

import (
	"context"
	"strings"

	"github.com/goforj/env/v2"
	"github.com/goforj/str"
	"golang.org/x/oauth2"
)

type MicrosoftProvider struct {
	oauthProviderBase
}

// NewMicrosoftProvider creates the built-in Microsoft OAuth provider.
func NewMicrosoftProvider() *MicrosoftProvider {
	tenant := strings.TrimSpace(env.Get("AUTH_OAUTH_MICROSOFT_TENANT", "common"))
	baseURL := "https://login.microsoftonline.com/" + tenant + "/oauth2/v2.0"
	return &MicrosoftProvider{
		oauthProviderBase: oauthProviderBase{
			name:         "microsoft",
			clientID:     env.Get("AUTH_OAUTH_MICROSOFT_CLIENT_ID", ""),
			clientSecret: env.Get("AUTH_OAUTH_MICROSOFT_CLIENT_SECRET", ""),
			authURL:      env.Get("AUTH_OAUTH_MICROSOFT_AUTH_URL", baseURL+"/authorize"),
			tokenURL:     env.Get("AUTH_OAUTH_MICROSOFT_TOKEN_URL", baseURL+"/token"),
			userInfoURL:  env.Get("AUTH_OAUTH_MICROSOFT_USERINFO_URL", "https://graph.microsoft.com/oidc/userinfo"),
			tenant:       tenant,
			scopes:       []string{"openid", "profile", "email"},
		},
	}
}

func (p *MicrosoftProvider) ResolveIdentity(ctx context.Context, callback OAuthCallback) (ProviderIdentity, error) {
	cfg := p.oauthConfig(callback.RedirectURI)
	token, err := cfg.Exchange(ctx, callback.Code, oauth2.SetAuthURLParam("code_verifier", callback.CodeVerifier))
	if err != nil {
		return ProviderIdentity{}, err
	}
	var user struct {
		Sub               string `json:"sub"`
		Email             string `json:"email"`
		EmailVerified     bool   `json:"email_verified"`
		Name              string `json:"name"`
		PreferredUsername string `json:"preferred_username"`
	}
	if err := oauthGetJSON(ctx, p.userInfoURL, token.AccessToken, &user); err != nil {
		return ProviderIdentity{}, err
	}
	email := str.Of(user.Email).ToLower().TrimSpace().String()
	if email == "" {
		email = str.Of(user.PreferredUsername).ToLower().TrimSpace().String()
	}
	return ProviderIdentity{
		Provider:      p.Name(),
		Subject:       strings.TrimSpace(user.Sub),
		Email:         email,
		EmailVerified: user.EmailVerified || email != "",
		Username:      strings.TrimSpace(user.PreferredUsername),
		DisplayName:   coalesceOAuthName(user.Name, user.PreferredUsername),
		AccessToken:   token.AccessToken,
	}, nil
}
