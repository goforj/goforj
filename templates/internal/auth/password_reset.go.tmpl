package auth

import (
	"time"

	"gorm.io/gorm"
	"{{.GoModuleName}}/internal/database"
)

// PasswordResetToken stores one password reset grant for a user.
type PasswordResetToken struct {
	ID        int64      `gorm:"column:id;primaryKey;autoIncrement" json:"id"`
	UserID    int64      `gorm:"column:user_id" json:"user_id"`
	TokenHash string     `gorm:"column:token_hash" json:"-"`
	ExpiresAt time.Time  `gorm:"column:expires_at" json:"expires_at"`
	UsedAt    *time.Time `gorm:"column:used_at" json:"used_at"`
	UserAgent string     `gorm:"column:user_agent" json:"user_agent"`
	IPAddress string     `gorm:"column:ip_address" json:"ip_address"`
	CreatedAt time.Time  `gorm:"column:created_at" json:"created_at"`
	UpdatedAt time.Time  `gorm:"column:updated_at" json:"updated_at"`
}

// TableName returns the database table name for password reset grants.
func (*PasswordResetToken) TableName() string {
	return "auth_password_resets"
}

// Relationships returns generated relationship metadata for model tooling.
func (*PasswordResetToken) Relationships() []string {
	return []string{}
}

// PasswordResetRepo provides persistence helpers for password reset grants.
type PasswordResetRepo struct {
	db *database.Connections
}

// NewPasswordResetRepo creates a password reset repository.
func NewPasswordResetRepo(db *database.Connections) *PasswordResetRepo {
	return &PasswordResetRepo{db: db}
}

func (r *PasswordResetRepo) connection() (*gorm.DB, error) {
	return r.db.Default()
}

// Save inserts or updates a password reset row.
func (r *PasswordResetRepo) Save(reset *PasswordResetToken) error {
	conn, err := r.connection()
	if err != nil {
		return err
	}
	now := time.Now().UTC()
	if reset.CreatedAt.IsZero() {
		reset.CreatedAt = now
	}
	reset.UpdatedAt = now
	return conn.Save(reset).Error
}

// ActiveByTokenHash loads an unused, unexpired password reset grant by token hash.
func (r *PasswordResetRepo) ActiveByTokenHash(tokenHash string, now time.Time) (*PasswordResetToken, error) {
	conn, err := r.connection()
	if err != nil {
		return nil, err
	}
	var reset PasswordResetToken
	if err := conn.
		Where("token_hash = ? AND used_at IS NULL AND expires_at > ?", tokenHash, now.UTC()).
		Limit(1).
		First(&reset).Error; err != nil {
		return nil, err
	}
	return &reset, nil
}

// RevokeActiveForUser expires every unused password reset grant for a user.
func (r *PasswordResetRepo) RevokeActiveForUser(userID int64, usedAt time.Time) error {
	conn, err := r.connection()
	if err != nil {
		return err
	}
	return conn.Model(&PasswordResetToken{}).
		Where("user_id = ? AND used_at IS NULL", userID).
		Updates(map[string]any{
			"used_at":    usedAt.UTC(),
			"updated_at": usedAt.UTC(),
		}).Error
}

// MarkUsed closes a password reset grant after successful redemption.
func (r *PasswordResetRepo) MarkUsed(id int64, usedAt time.Time) error {
	conn, err := r.connection()
	if err != nil {
		return err
	}
	return conn.Model(&PasswordResetToken{}).
		Where("id = ? AND used_at IS NULL", id).
		Updates(map[string]any{
			"used_at":    usedAt.UTC(),
			"updated_at": usedAt.UTC(),
		}).Error
}

// CleanupExpired deletes expired or already-used password reset rows.
func (r *PasswordResetRepo) CleanupExpired(now time.Time) (int64, error) {
	conn, err := r.connection()
	if err != nil {
		return 0, err
	}
	result := conn.
		Where("expires_at <= ? OR used_at IS NOT NULL", now.UTC()).
		Delete(&PasswordResetToken{})
	if result.Error != nil {
		return 0, result.Error
	}
	return result.RowsAffected, nil
}
