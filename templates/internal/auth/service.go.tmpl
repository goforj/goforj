func (s *Service) loginRateLimitDuration() time.Duration {
	return parseDurationEnv("AUTH_LOGIN_RATE_LIMIT_DURATION", 15*time.Minute)
}

func (s *Service) buildCookie(r web.Context, name, value string, expiresAt time.Time) *http.Cookie {
	now := time.Now().UTC()
	maxAge := int(expiresAt.Sub(now).Seconds())
	if value == "" || !expiresAt.After(now) {
		maxAge = -1
	}
	return &http.Cookie{
		Name:     name,
		Value:    value,
		Path:     "/",
		HttpOnly: true,
		Secure:   resolveCookieSecure(r),
		SameSite: http.SameSiteLaxMode,
		Expires:  expiresAt.UTC(),
		MaxAge:   maxAge,
	}
}

func resolveCookieSecure(r web.Context) bool {
	switch strings.ToLower(strings.TrimSpace(env.Get("AUTH_COOKIE_SECURE", "auto"))) {
	case "true", "1", "yes", "on":
		return true
	case "false", "0", "no", "off":
		return false
	default:
		return strings.EqualFold(strings.TrimSpace(r.Scheme()), "https")
	}
}

func parseDurationEnv(key string, fallback time.Duration) time.Duration {
	raw := strings.TrimSpace(env.Get(key, ""))
	if raw == "" {
		return fallback
	}
	value, err := time.ParseDuration(raw)
	if err != nil || value <= 0 {
		return fallback
	}
	return value
}

func parseIntEnv(key string, fallback int) int {
	raw := strings.TrimSpace(env.Get(key, ""))
	if raw == "" {
		return fallback
	}
	value, err := strconv.Atoi(raw)
	if err != nil || value <= 0 {
		return fallback
	}
	return value
}

func parseBoolEnv(key string, fallback bool) bool {
	raw := strings.ToLower(strings.TrimSpace(env.Get(key, "")))
	switch raw {
	case "1", "true", "yes", "on":
		return true
	case "0", "false", "no", "off":
		return false
	default:
		return fallback
	}
}

func resolveBool(key string, fallback bool) bool {
	raw := strings.ToLower(strings.TrimSpace(os.Getenv(key)))
	switch raw {
	case "1", "true", "yes", "on":
		return true
	case "0", "false", "no", "off":
		return false
	default:
		return fallback
	}
}

func (s *Service) validatePassword(password string) error {
	reasons := make([]string, 0, 5)
	if minLength := s.passwordMinLength(); minLength > 0 && utf8.RuneCountInString(password) < minLength {
		reasons = append(reasons, fmt.Sprintf("be at least %d characters", minLength))
	}

	var hasUpper, hasLower, hasNumber, hasSymbol bool
	for _, r := range password {
		switch {
		case unicode.IsUpper(r):
			hasUpper = true
		case unicode.IsLower(r):
			hasLower = true
		case unicode.IsNumber(r):
			hasNumber = true
		case unicode.IsPunct(r) || unicode.IsSymbol(r):
			hasSymbol = true
		}
	}

	if s.passwordRequireUpper() && !hasUpper {
		reasons = append(reasons, "include an uppercase letter")
	}
	if s.passwordRequireLower() && !hasLower {
		reasons = append(reasons, "include a lowercase letter")
	}
	if s.passwordRequireNumber() && !hasNumber {
		reasons = append(reasons, "include a number")
	}
	if s.passwordRequireSymbol() && !hasSymbol {
		reasons = append(reasons, "include a symbol")
	}
	if len(reasons) > 0 {
		return weakPasswordError("password must " + strings.Join(reasons, ", "))
	}
	return nil
}

func randomToken(numBytes int) (string, error) {
	buf := make([]byte, numBytes)
	if _, err := rand.Read(buf); err != nil {
		return "", err
	}
	return base64.RawURLEncoding.EncodeToString(buf), nil
}

func hashOpaqueToken(secret string) string {
	sum := sha256.Sum256([]byte(secret))
	return hex.EncodeToString(sum[:])
}

func hashRefreshSecret(secret string) string {
	return hashOpaqueToken(secret)
}

func buildRefreshToken(sessionID, secret string) string {
	return str.Of(sessionID).TrimSpace().String() + "." + str.Of(secret).TrimSpace().String()
}

func parseRefreshToken(value string) (string, string, error) {
	parts := strings.Split(strings.TrimSpace(value), ".")
	if len(parts) != 2 || parts[0] == "" || parts[1] == "" {
		return "", "", ErrUnauthorized
	}
	return parts[0], parts[1], nil
}

func normalizeLoginIdentifier(value string) string {
	return strings.ToLower(strings.TrimSpace(value))
}

func normalizeIPAddress(value string) string {
	raw := strings.TrimSpace(value)
	if raw == "" {
		return ""
	}
	host, _, err := net.SplitHostPort(raw)
	if err == nil && host != "" {
		return strings.TrimSpace(host)
	}
	return raw
}

func exposePasswordResetToken() bool {
	return env.IsAppEnvLocal() || resolveBool("AUTH_PASSWORD_RESET_RETURN_TOKEN", false)
}

func exposeEmailVerificationToken() bool {
	return env.IsAppEnvLocal() || resolveBool("AUTH_EMAIL_VERIFICATION_RETURN_TOKEN", false)
}

func (s *Service) loginAttemptBlocked(identifier, ipAddress string, now time.Time) (bool, error) {
	if identifier == "" {
		return false, nil
	}
	attempt, err := s.attempts.WithContext(context.Background()).ByScopeIdentifierIP("login", identifier, ipAddress)
	if err != nil {
		if errors.Is(err, gorm.ErrRecordNotFound) {
			return false, nil
		}
		return false, err
	}
	return attempt.BlockedUntil != nil && attempt.BlockedUntil.UTC().After(now), nil
}

func (s *Service) recordFailedLoginAttempt(ctx context.Context, identifier, ipAddress string, user *User, now time.Time) (bool, error) {
	if identifier == "" {
		return false, nil
	}
	attempt, err := s.attempts.WithContext(ctx).ByScopeIdentifierIP("login", identifier, ipAddress)
	if err != nil && !errors.Is(err, gorm.ErrRecordNotFound) {
		return false, err
	}
	if attempt == nil || errors.Is(err, gorm.ErrRecordNotFound) {
		attempt = &LoginAttempt{
			Scope:         "login",
			Identifier:    identifier,
			IPAddress:     ipAddress,
			FirstFailedAt: now,
		}
	}
	if attempt.BlockedUntil != nil && !attempt.BlockedUntil.UTC().After(now) {
		attempt.FailedAttempts = 0
		attempt.BlockedUntil = nil
		attempt.FirstFailedAt = now
	}
	attempt.LastFailedAt = now
	attempt.FailedAttempts++
	if attempt.FailedAttempts >= s.loginRateLimitAttempts() {
		blockedUntil := now.Add(s.loginRateLimitDuration())
		attempt.BlockedUntil = &blockedUntil
	}
	if err := s.attempts.WithContext(ctx).Save(attempt); err != nil {
		return false, err
	}
	if user != nil {
		user.FailedLoginAttempts++
		if user.FailedLoginAttempts >= s.loginLockoutAttempts() {
			lockedUntil := now.Add(s.loginLockoutDuration())
			user.LockedUntil = &lockedUntil
			user.FailedLoginAttempts = 0
		}
			if err := s.users.Save(ctx, user); err != nil {
			return false, err
		}
	}
	return attempt.BlockedUntil != nil && attempt.BlockedUntil.UTC().After(now), nil
}

func (s *Service) clearFailedLoginState(ctx context.Context, identifier, ipAddress string, user *User) {
	if identifier != "" {
		_ = s.attempts.WithContext(ctx).DeleteByScopeIdentifierIP("login", identifier, ipAddress)
	}
	if user == nil {
		return
	}
	if user.FailedLoginAttempts == 0 && user.LockedUntil == nil {
		return
	}
	user.FailedLoginAttempts = 0
	user.LockedUntil = nil
	_ = s.users.Save(ctx, user)
}

