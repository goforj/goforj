const (
	// AccessCookieName is the cookie that stores the short-lived access token.
	AccessCookieName = "auth_access"
	// RefreshCookieName is the cookie that stores the refresh-backed session token.
	RefreshCookieName = "auth_refresh"
	// lastSeenWriteInterval bounds how often request auth persists last_seen_at updates.
	lastSeenWriteInterval = 5 * time.Minute
	// refreshReplayGraceWindow tolerates short same-session refresh replay bursts
	// from concurrent browser requests right after access-cookie expiry.
	refreshReplayGraceWindow = 2 * time.Second
	// refreshSessionLockStripes bounds in-process refresh serialization memory.
	refreshSessionLockStripes = 64
)

var (
	// ErrInvalidCredentials collapses missing-user, inactive-user, and bad-password failures.
	ErrInvalidCredentials = errors.New("invalid credentials")
	// ErrUnauthorized indicates that the current request does not have a valid auth session.
	ErrUnauthorized = errors.New("unauthorized")
	// ErrInvalidConfig indicates that required auth configuration is missing or invalid.
	ErrInvalidConfig = errors.New("invalid auth configuration")
	// ErrRateLimited indicates that auth requests must back off temporarily.
	ErrRateLimited = errors.New("rate limited")
	// ErrAccountLocked indicates that the account is temporarily locked after repeated failures.
	ErrAccountLocked = errors.New("account locked")
	// ErrInvalidPasswordResetToken indicates that the reset grant is missing, expired, or already used.
	ErrInvalidPasswordResetToken = errors.New("invalid password reset token")
	// ErrInvalidEmailVerificationToken indicates that the verification grant is missing, expired, or already used.
	ErrInvalidEmailVerificationToken = errors.New("invalid email verification token")
	// ErrEmailTaken indicates that the requested email address is already claimed by another user.
	ErrEmailTaken = errors.New("email already in use")
	// ErrUsernameTaken indicates that the requested username is already claimed by another user.
	ErrUsernameTaken = errors.New("username already in use")
	// ErrWeakPassword indicates that the supplied password does not satisfy current policy.
	ErrWeakPassword = errors.New("weak password")
	// ErrIdentityLinkRequired indicates that a provider identity matches an existing account but is not linked yet.
	ErrIdentityLinkRequired = errors.New("identity link required")
	// ErrIdentityAlreadyLinked indicates that a provider identity is already linked to a different user.
	ErrIdentityAlreadyLinked = errors.New("identity already linked")
	// ErrIdentityNotFound indicates that the requested provider identity does not exist.
	ErrIdentityNotFound = errors.New("identity not found")
	// ErrLastAuthMethod indicates that removing the current auth method would strand the account.
	ErrLastAuthMethod = errors.New("last auth method")
	{{- if .Components.OAuth }}
	// ErrInvalidOAuthState indicates that the OAuth callback state is missing, expired, or already used.
	ErrInvalidOAuthState = errors.New("invalid oauth state")
	{{- end }}
)

type currentUserContextKey string

const currentUserKey currentUserContextKey = "auth.current_user"

// This fixed bcrypt hash is used only to keep missing-user auth failures
// closer in timing to wrong-password failures.
const invalidPasswordHash = "$2a$10$7EqJtq98hPqEX7fNZaFWoOHi9r4XN0S7MsOoJ162i3A1Q9nX6F6e6"

// Service owns authentication, session issuance, and session lifecycle policy.
type Service struct {
	users         *UserRepo
	sessions      *AuthSessionRepo
	{{- if .Components.OAuth }}
	identities    *AuthIdentityRepo
	oauthStates   *OAuthStateRepo
	providers     *OAuthProviders
	{{- end }}
	verifications *EmailVerificationRepo
	resets        *PasswordResetRepo
	attempts      *LoginAttemptRepo
	delivery      Delivery
	logger        *logger.AppLogger
	refreshLocks  [refreshSessionLockStripes]sync.Mutex
{{- if .Components.Metrics }}
	metrics       *metrics.Manager
{{- end }}
}

// SessionTokens contains the generated access and refresh token pair for a session.
type SessionTokens struct {
	AccessToken      string
	RefreshToken     string
	AccessExpiresAt  time.Time
	RefreshExpiresAt time.Time
	SessionID        string
}

type accessClaims struct {
	UserID    int64  `json:"uid"`
	SessionID string `json:"sid"`
	Username  string `json:"usr"`
	jwt.RegisteredClaims
}

type weakPasswordError string

func (e weakPasswordError) Error() string { return string(e) }

func (e weakPasswordError) Unwrap() error { return ErrWeakPassword }

// AuthenticateInput is the transport-neutral input required to start a local auth session.
type AuthenticateInput struct {
	Login     string
	Password  string
	Remember  bool
	UserAgent string
	IPAddress string
}

// RegisterInput is the transport-neutral input required to create a local user and start a session.
type RegisterInput struct {
	Username    string
	DisplayName string
	Email       string
	Password    string
	Remember    bool
	UserAgent   string
	IPAddress   string
}

type RegisterResult struct {
	User                      *User
	Tokens                    *SessionTokens
	RequiresEmailVerification bool
	VerificationToken         string
}

// TokenUser is the sanitized auth user payload returned to clients.
type TokenUser struct {
	ID              int64      `json:"id"`
	Username        string     `json:"username"`
	Email           string     `json:"email"`
	DisplayName     string     `json:"display_name"`
	AvatarURL       string     `json:"avatar_url"`
	Active          bool       `json:"active"`
	EmailVerifiedAt *time.Time `json:"email_verified_at"`
	LastLoginAt     *time.Time `json:"last_login_at"`
	LastSeenAt      *time.Time `json:"last_seen_at"`
	Timezone        string     `json:"timezone"`
	Locale          string     `json:"locale"`
}

// TokenSession is the sanitized auth session payload returned to clients.
type TokenSession struct {
	ID          string     `json:"id"`
	Current     bool       `json:"current"`
	DeviceLabel string     `json:"device_label"`
	ExpiresAt   time.Time  `json:"expires_at"`
	LastSeenAt  *time.Time `json:"last_seen_at"`
	UserAgent   string     `json:"user_agent"`
	IPAddress   string     `json:"ip_address"`
	CreatedAt   time.Time  `json:"created_at"`
}

// NewService creates the generated auth service.
func NewService(
	users *UserRepo,
	sessions *AuthSessionRepo,
	{{- if .Components.OAuth }}
	identities *AuthIdentityRepo,
	oauthStates *OAuthStateRepo,
	providers *OAuthProviders,
	{{- end }}
	verifications *EmailVerificationRepo,
	resets *PasswordResetRepo,
	attempts *LoginAttemptRepo,
	delivery Delivery,
	logger *logger.AppLogger,
	{{- if .Components.Metrics }}
	metrics *metrics.Manager,
	{{- end }}
) *Service {
	componentLogger := logger
	if componentLogger != nil {
		componentLogger = componentLogger.WithComponent("Auth")
	}
	return &Service{
		users:         users,
		sessions:      sessions,
		{{- if .Components.OAuth }}
		identities:    identities,
		oauthStates:   oauthStates,
		providers:     providers,
		{{- end }}
		verifications: verifications,
		resets:        resets,
		attempts:      attempts,
		delivery:      delivery,
		logger:        componentLogger,
		{{- if .Components.Metrics }}
		metrics:       metrics,
		{{- end }}
	}
}

{{- if .Components.Metrics }}
func (s *Service) recordAuthFlow(flow, status, reason, provider string, start time.Time) {
	if s.metrics == nil || !s.metrics.AuthEnabled() {
		return
	}
	s.metrics.RecordAuthFlow(flow, status, reason, provider, time.Since(start))
}

func (s *Service) noteAuthFlow(flow, status, reason, provider string) {
	if s.metrics == nil || !s.metrics.AuthEnabled() {
		return
	}
	s.metrics.RecordAuthFlow(flow, status, reason, provider, 0)
}

type authFlowRecorder struct {
	service   *Service
	flow      string
	status    string
	reason    string
	provider  string
	startedAt time.Time
}

func (s *Service) beginAuthFlow(flow, provider string) *authFlowRecorder {
	return &authFlowRecorder{
		service:   s,
		flow:      flow,
		status:    "failed",
		reason:    "other",
		provider:  provider,
		startedAt: time.Now(),
	}
}

func (r *authFlowRecorder) Set(status, reason string) {
	r.status = status
	r.reason = reason
}

func (r *authFlowRecorder) Done() {
	r.service.recordAuthFlow(r.flow, r.status, r.reason, r.provider, r.startedAt)
}
{{- end }}

// CurrentUser returns the authenticated user attached by auth middleware.
func CurrentUser(r web.Context) *User {
	user, _ := r.Get(string(currentUserKey)).(*User)
	return user
}

// RequireAuth ensures the request is authenticated before running the next handler.
func (s *Service) RequireAuth(next web.Handler) web.Handler {
	return func(r web.Context) error {
		_, err := s.AuthenticateRequest(r)
		if err != nil {
			// Do not clear cookies here. Protected requests can race with a
			// concurrent refresh flow, especially when a tab resumes and many
			// requests fan out together. Let the dedicated refresh/logout paths
			// own cookie invalidation instead of having arbitrary 401 responses
			// wipe browser auth state.
			return r.JSON(http.StatusUnauthorized, map[string]any{"ok": false, "error": "unauthorized"})
		}
		return next(r)
	}
}

// AuthenticateRequest validates the current request cookies and attaches the current user to the web context.
func (s *Service) AuthenticateRequest(r web.Context) (*User, error) {
	user, err := s.authenticateRequest(r)
	if err != nil {
		return nil, err
	}
	r.Set(string(currentUserKey), user)
	return user, nil
}

// Authenticate validates local credentials and issues a new session.
func (s *Service) Authenticate(ctx context.Context, input AuthenticateInput) (*User, SessionTokens, error) {
{{- if .Components.Metrics }}
	flow := s.beginAuthFlow("login", "na")
	defer flow.Done()
{{- end }}
	login := input.Login
	password := input.Password
	userAgent := input.UserAgent
	ipAddress := input.IPAddress
	normalizedLogin := normalizeLoginIdentifier(login)
	ipAddress = normalizeIPAddress(ipAddress)
	now := time.Now().UTC()
	blocked, err := s.loginAttemptBlocked(normalizedLogin, ipAddress, now)
	if err != nil {
		return nil, SessionTokens{}, err
	}
	if blocked {
{{- if .Components.Metrics }}
		flow.Set("rate_limited", "rate_limited")
{{- end }}
		return nil, SessionTokens{}, ErrRateLimited
	}
	user, err := s.users.WithContext(ctx).ByLogin(login)
	if err != nil {
		if errors.Is(err, gorm.ErrRecordNotFound) {
			// Spend roughly the same bcrypt work here so the missing-user path
			// does not return materially faster than the wrong-password path.
			_ = bcrypt.CompareHashAndPassword([]byte(invalidPasswordHash), []byte(password))
			limited, recordErr := s.recordFailedLoginAttempt(ctx, normalizedLogin, ipAddress, nil, now)
			if recordErr != nil {
				return nil, SessionTokens{}, recordErr
			}
			if limited {
{{- if .Components.Metrics }}
				flow.Set("rate_limited", "rate_limited")
{{- end }}
				return nil, SessionTokens{}, ErrRateLimited
			}
{{- if .Components.Metrics }}
			flow.Set("invalid", "invalid_credentials")
{{- end }}
			return nil, SessionTokens{}, ErrInvalidCredentials
		}
		return nil, SessionTokens{}, err
	}
	if user.LockedUntil != nil && user.LockedUntil.UTC().After(now) {
{{- if .Components.Metrics }}
		flow.Set("locked", "account_locked")
{{- end }}
		return nil, SessionTokens{}, ErrAccountLocked
	}
	if !user.Active {
{{- if .Components.Metrics }}
		flow.Set("invalid", "inactive_user")
{{- end }}
		return nil, SessionTokens{}, ErrInvalidCredentials
	}
	if err := bcrypt.CompareHashAndPassword([]byte(user.PasswordHash), []byte(password)); err != nil {
		limited, recordErr := s.recordFailedLoginAttempt(ctx, normalizedLogin, ipAddress, user, now)
		if recordErr != nil {
			return nil, SessionTokens{}, recordErr
		}
		if user.LockedUntil != nil && user.LockedUntil.UTC().After(now) {
{{- if .Components.Metrics }}
			flow.Set("locked", "account_locked")
{{- end }}
			return nil, SessionTokens{}, ErrAccountLocked
		}
		if limited {
{{- if .Components.Metrics }}
			flow.Set("rate_limited", "rate_limited")
{{- end }}
			return nil, SessionTokens{}, ErrRateLimited
		}
{{- if .Components.Metrics }}
		flow.Set("invalid", "invalid_credentials")
{{- end }}
		return nil, SessionTokens{}, ErrInvalidCredentials
	}
	tokens, err := s.issueSession(ctx, user, input.Remember, userAgent, ipAddress)
	if err != nil {
		return nil, SessionTokens{}, err
	}
	s.clearFailedLoginState(ctx, normalizedLogin, ipAddress, user)
	now = time.Now().UTC()
	user.LastLoginAt = &now
	user.LastSeenAt = &now
	if err := s.users.Save(ctx, user); err != nil {
		return nil, SessionTokens{}, err
	}
{{- if .Components.Metrics }}
	flow.Set("succeeded", "na")
{{- end }}
	return user, tokens, nil
}

// Register creates a local user and either starts a session or requires email verification first.
func (s *Service) Register(ctx context.Context, input RegisterInput) (*RegisterResult, error) {
	username := strings.TrimSpace(input.Username)
	displayName := strings.TrimSpace(input.DisplayName)
	email := strings.TrimSpace(input.Email)
	password := input.Password
	userAgent := input.UserAgent
	ipAddress := normalizeIPAddress(input.IPAddress)

	if displayName == "" || email == "" || password == "" {
		return nil, ErrInvalidCredentials
	}
	if username == "" {
		username = email
	}
	if _, err := s.users.WithContext(ctx).ByEmail(email); err == nil {
		return nil, ErrEmailTaken
	} else if err != nil && !errors.Is(err, gorm.ErrRecordNotFound) {
		return nil, err
	}
	if _, err := s.users.WithContext(ctx).ByLogin(username); err == nil {
		return nil, ErrUsernameTaken
	} else if err != nil && !errors.Is(err, gorm.ErrRecordNotFound) {
		return nil, err
	}

	user, err := s.CreateUser(ctx, username, email, password, displayName, true)
	if err != nil {
		return nil, err
	}
	if s.registerRequiresEmailVerification() {
		verificationToken, err := s.issueEmailVerification(ctx, user, userAgent, ipAddress)
		if err != nil {
			return nil, err
		}
		return &RegisterResult{
			User:                      user,
			RequiresEmailVerification: true,
			VerificationToken:         verificationToken,
		}, nil
	}
	tokens, err := s.issueSession(ctx, user, input.Remember, userAgent, ipAddress)
	if err != nil {
		return nil, err
	}
	now := time.Now().UTC()
	user.LastLoginAt = &now
	user.LastSeenAt = &now
	if err := s.users.Save(ctx, user); err != nil {
		return nil, err
	}
	return &RegisterResult{
		User:   user,
		Tokens: &tokens,
	}, nil
}

// RefreshSession rotates the current refresh-backed session and returns new tokens.
func (s *Service) RefreshSession(r web.Context) (*User, SessionTokens, error) {
	return s.handleRefreshSession(r, false, true)
}

func (s *Service) handleRefreshSession(r web.Context, allowReplay, rotate bool) (*User, SessionTokens, error) {
{{- if .Components.Metrics }}
	flow := s.beginAuthFlow("session_refresh", "na")
	defer flow.Done()
{{- end }}
	sessionID, err := s.refreshCookieSessionID(r)
	if err != nil {
{{- if .Components.Metrics }}
		flow.Set("unauthorized", "invalid_session")
{{- end }}
		return nil, SessionTokens{}, err
	}
	user, tokens, err := s.withSerializedRefreshSession(sessionID, func() (*User, SessionTokens, error) {
		user, session, refreshSecret, refreshCurrent, err := s.authenticateRefreshSession(r, allowReplay)
		if err != nil {
			return nil, SessionTokens{}, err
		}
		var tokens SessionTokens
		if rotate {
			tokens, err = s.rotateRefreshSession(r.Context(), user, session, r.Request().UserAgent(), r.RealIP())
		} else if refreshCurrent {
			tokens, err = s.issueTokenPairForSession(r.Context(), user, session, refreshSecret, r.Request().UserAgent(), r.RealIP())
		} else {
			tokens, err = s.issueAccessOnlyForSession(r.Context(), user, session, r.Request().UserAgent(), r.RealIP())
		}
		if err != nil {
			return nil, SessionTokens{}, err
		}
		lastSeenAt := time.Now().UTC()
		if session.LastSeenAt != nil {
			lastSeenAt = session.LastSeenAt.UTC()
		}
		s.users.TouchProfileLastSeen(r.Context(), user, lastSeenAt)
		if err := s.users.PersistLastSeen(r.Context(), user.ID, lastSeenAt); err != nil {
			return nil, SessionTokens{}, err
		}
		return user, tokens, nil
	})
	if err != nil {
{{- if .Components.Metrics }}
		flow.Set("unauthorized", "invalid_session")
{{- end }}
		return nil, SessionTokens{}, err
	}
	s.SetSessionCookies(r, tokens)
{{- if .Components.Metrics }}
	flow.Set("succeeded", "na")
{{- end }}
	return user, tokens, nil
}

// Logout revokes the current session when one can be identified.
func (s *Service) Logout(r web.Context) error {
{{- if .Components.Metrics }}
	flow := s.beginAuthFlow("logout", "na")
	flow.Set("succeeded", "no_session")
	defer flow.Done()
{{- end }}
	if sessionID := s.sessionIDFromRequest(r); sessionID != "" {
		if err := s.sessions.Revoke(r.Context(), sessionID, time.Now().UTC()); err != nil {
{{- if .Components.Metrics }}
			flow.Set("failed", "revoke_failed")
{{- end }}
			return err
		}
{{- if .Components.Metrics }}
		flow.Set("succeeded", "current_session")
{{- end }}
	}
	s.ClearSessionCookies(r)
	return nil
}

// LogoutAll revokes every active session for the current user.
func (s *Service) LogoutAll(r web.Context) error {
{{- if .Components.Metrics }}
	flow := s.beginAuthFlow("logout_all", "na")
	flow.Set("succeeded", "na")
	defer flow.Done()
{{- end }}
	userID := s.userIDFromRequest(r)
	if userID == 0 {
{{- if .Components.Metrics }}
		flow.Set("noop", "no_user")
{{- end }}
		s.ClearSessionCookies(r)
		return nil
	}
	if err := s.sessions.RevokeAllForUser(r.Context(), userID, time.Now().UTC()); err != nil {
{{- if .Components.Metrics }}
		flow.Set("failed", "revoke_failed")
{{- end }}
		return err
	}
	s.ClearSessionCookies(r)
	return nil
}

// CreateUser creates a local auth user explicitly through the service layer.
func (s *Service) CreateUser(ctx context.Context, username, email, password, displayName string, active bool) (*User, error) {
	if _, err := s.users.WithContext(ctx).ByLogin(username); err == nil {
		return nil, ErrUsernameTaken
	} else if err != nil && !errors.Is(err, gorm.ErrRecordNotFound) {
		return nil, err
	}
	if _, err := s.users.WithContext(ctx).ByEmail(email); err == nil {
		return nil, ErrEmailTaken
	} else if err != nil && !errors.Is(err, gorm.ErrRecordNotFound) {
		return nil, err
	}
	if err := s.validatePassword(password); err != nil {
		return nil, err
	}
	hash, err := bcrypt.GenerateFromPassword([]byte(password), bcrypt.DefaultCost)
	if err != nil {
		return nil, err
	}
	displayName = strings.TrimSpace(displayName)
	if displayName == "" {
		displayName = strings.TrimSpace(username)
	}
	user := &User{
		Username:     username,
		Email:        email,
		DisplayName:  displayName,
		PasswordHash: string(hash),
		Active:       active,
	}
	if err := s.users.Create(ctx, user); err != nil {
		return nil, err
	}
	return user, nil
}

// SetPassword replaces a local auth user's password and clears lockout state.
func (s *Service) SetPassword(ctx context.Context, login, password string) (*User, error) {
	user, err := s.users.WithContext(ctx).ByLogin(login)
	if err != nil {
		return nil, err
	}
	if err := s.validatePassword(password); err != nil {
		return nil, err
	}
	hash, err := bcrypt.GenerateFromPassword([]byte(password), bcrypt.DefaultCost)
	if err != nil {
		return nil, err
	}
	user.PasswordHash = string(hash)
	user.FailedLoginAttempts = 0
	user.LockedUntil = nil
	if err := s.users.Save(ctx, user); err != nil {
		return nil, err
	}
	return user, nil
}

{{- if .Components.OAuth }}
// BeginOAuthLogin builds the provider authorization URL for one OAuth login flow.
func (s *Service) BeginOAuthLogin(r web.Context, providerName string) (string, error) {
{{- if .Components.Metrics }}
	provider := strings.TrimSpace(strings.ToLower(providerName))
	flow := s.beginAuthFlow("oauth_login_start", provider)
	defer flow.Done()
{{- end }}
	url, err := s.beginOAuth(r, providerName, nil)
	if err != nil {
		if errors.Is(err, ErrProviderDisabled) {
{{- if .Components.Metrics }}
			flow.Set("not_found", "provider_unavailable")
{{- end }}
		}
		return "", err
	}
{{- if .Components.Metrics }}
	flow.Set("succeeded", "na")
{{- end }}
	return url, nil
}

// BeginOAuthLink builds the provider authorization URL for linking an OAuth identity.
func (s *Service) BeginOAuthLink(r web.Context, providerName string) (string, error) {
{{- if .Components.Metrics }}
	provider := strings.TrimSpace(strings.ToLower(providerName))
	flow := s.beginAuthFlow("oauth_link_start", provider)
	defer flow.Done()
{{- end }}
	userID := s.userIDFromRequest(r)
	if userID == 0 {
{{- if .Components.Metrics }}
		flow.Set("unauthorized", "unauthorized")
{{- end }}
		return "", ErrUnauthorized
	}
	url, err := s.beginOAuth(r, providerName, &userID)
	if err != nil {
		if errors.Is(err, ErrProviderDisabled) {
{{- if .Components.Metrics }}
			flow.Set("not_found", "provider_unavailable")
{{- end }}
		}
		return "", err
	}
{{- if .Components.Metrics }}
	flow.Set("succeeded", "na")
{{- end }}
	return url, nil
}

func (s *Service) beginOAuth(r web.Context, providerName string, linkUserID *int64) (string, error) {
	provider, ok := s.providers.ByName(providerName)
	if !ok || !provider.Enabled() {
		return "", ErrProviderDisabled
	}
	stateValue, err := randomToken(32)
	if err != nil {
		return "", err
	}
	codeVerifier, err := generateOAuthCodeVerifier()
	if err != nil {
		return "", err
	}
	nonce, err := generateOAuthNonce()
	if err != nil {
		return "", err
	}
	state := &OAuthStateToken{
		Provider:     strings.TrimSpace(strings.ToLower(provider.Name())),
		State:        stateValue,
		CodeVerifier: codeVerifier,
		Nonce:        nonce,
		LinkUserID:   linkUserID,
		RedirectTo:   sanitizeOAuthRedirectTarget(r.Query("next")),
		ExpiresAt:    time.Now().UTC().Add(oauthStateTTL()),
	}
	if err := s.oauthStates.WithContext(r.Context()).Save(state); err != nil {
		return "", err
	}
	return provider.AuthCodeURL(state, oauthCallbackURL(r, provider.Name()))
}

// CompleteOAuthCallback exchanges one OAuth callback and issues or links auth state.
func (s *Service) CompleteOAuthCallback(r web.Context, providerName, stateValue, code string) (*OAuthCompletionResult, error) {
{{- if .Components.Metrics }}
	providerLabel := strings.TrimSpace(strings.ToLower(providerName))
	flow := s.beginAuthFlow("oauth_callback", providerLabel)
	defer flow.Done()
{{- end }}
	provider, ok := s.providers.ByName(providerName)
	if !ok || !provider.Enabled() {
{{- if .Components.Metrics }}
		flow.Set("not_found", "provider_unavailable")
{{- end }}
		return nil, ErrProviderDisabled
	}
	now := time.Now().UTC()
	state, err := s.oauthStates.WithContext(r.Context()).ActiveByProviderState(strings.TrimSpace(strings.ToLower(provider.Name())), strings.TrimSpace(stateValue), now)
	if err != nil {
		if errors.Is(err, gorm.ErrRecordNotFound) {
{{- if .Components.Metrics }}
			flow.Set("invalid", "invalid_state")
{{- end }}
			return nil, ErrInvalidOAuthState
		}
		return nil, err
	}
	if err := s.oauthStates.WithContext(r.Context()).MarkUsed(state.ID, now); err != nil {
		return nil, err
	}
	callback := OAuthCallback{
		Code:         strings.TrimSpace(code),
		State:        state.State,
		RedirectURI:  oauthCallbackURL(r, provider.Name()),
		CodeVerifier: state.CodeVerifier,
		Nonce:        state.Nonce,
	}
	if state.LinkUserID != nil {
		identity, err := provider.ResolveIdentity(r.Context(), callback)
		if err != nil {
			return nil, err
		}
		authIdentity, err := s.LinkIdentity(r.Context(), *state.LinkUserID, identity)
		if err != nil {
			if errors.Is(err, ErrIdentityAlreadyLinked) {
{{- if .Components.Metrics }}
				flow.Set("conflict", "identity_already_linked")
{{- end }}
			}
			return nil, err
		}
		user, err := s.users.ByID(r.Context(), *state.LinkUserID)
		if err != nil {
			return nil, err
		}
{{- if .Components.Metrics }}
		flow.Set("succeeded", "linked")
{{- end }}
		return &OAuthCompletionResult{
			User:       user,
			Identity:   authIdentity,
			RedirectTo: state.RedirectTo,
			Linked:     true,
		}, nil
	}
	user, identity, tokens, err := s.AuthenticateWithProvider(r.Context(), provider, callback, r.Request().UserAgent(), r.RealIP())
	if err != nil {
		switch {
		case errors.Is(err, ErrIdentityLinkRequired):
{{- if .Components.Metrics }}
			flow.Set("conflict", "identity_link_required")
{{- end }}
		case errors.Is(err, ErrUnauthorized):
{{- if .Components.Metrics }}
			flow.Set("unauthorized", "unauthorized")
{{- end }}
		}
		return nil, err
	}
{{- if .Components.Metrics }}
	flow.Set("succeeded", "na")
{{- end }}
	return &OAuthCompletionResult{
		User:       user,
		Identity:   identity,
		Tokens:     tokens,
		RedirectTo: state.RedirectTo,
	}, nil
}
{{- end }}

{{- if .Components.OAuth }}
// FindOrCreateUserFromProviderIdentity resolves a linked provider identity or creates a provider-backed user.
func (s *Service) FindOrCreateUserFromProviderIdentity(ctx context.Context, identity ProviderIdentity) (*User, *AuthIdentity, bool, error) {
	identity = normalizeProviderIdentity(identity)
	if identity.Provider == "" || identity.Subject == "" {
		return nil, nil, false, ErrUnauthorized
	}
	existingIdentity, err := s.identities.WithContext(ctx).ByProviderSubject(identity.Provider, identity.Subject)
	if err == nil {
			user, userErr := s.users.ByIDFresh(ctx, existingIdentity.UserID)
		if userErr != nil {
			return nil, nil, false, userErr
		}
		if !user.Active {
			return nil, nil, false, ErrUnauthorized
		}
		if err := s.refreshIdentity(existingIdentity, identity, time.Now().UTC()); err != nil {
			return nil, nil, false, err
		}
		return user, existingIdentity, false, nil
	}
	if err != nil && !errors.Is(err, gorm.ErrRecordNotFound) {
		return nil, nil, false, err
	}
	if identity.Email != "" {
		user, emailErr := s.users.WithContext(ctx).ByEmail(identity.Email)
		if emailErr == nil {
			// Do not auto-link by shared email. Provider auth must explicitly link
			// to an authenticated account so same-email collisions stay deliberate.
			return user, nil, false, ErrIdentityLinkRequired
		}
		if emailErr != nil && !errors.Is(emailErr, gorm.ErrRecordNotFound) {
			return nil, nil, false, emailErr
		}
	}
	now := time.Now().UTC()
	user := &User{
		Username:     s.generateUniqueIdentityUsername(identity),
		Email:        s.generateIdentityEmail(identity),
		DisplayName:  s.identityDisplayName(identity),
		AvatarURL:    identity.AvatarURL,
		PasswordHash: invalidPasswordHash,
		Active:       true,
	}
	if identity.EmailVerified && user.Email != "" && !strings.HasSuffix(user.Email, ".oauth.invalid") {
		user.EmailVerifiedAt = &now
	}
	if err := s.users.Create(ctx, user); err != nil {
		return nil, nil, false, err
	}
	authIdentity := &AuthIdentity{
		UserID: user.ID,
	}
	if err := s.refreshIdentity(authIdentity, identity, now); err != nil {
		return nil, nil, false, err
	}
	return user, authIdentity, true, nil
}

// LinkIdentity attaches a provider identity to an existing user without auto-linking by email.
func (s *Service) LinkIdentity(ctx context.Context, userID int64, identity ProviderIdentity) (*AuthIdentity, error) {
	identity = normalizeProviderIdentity(identity)
	if identity.Provider == "" || identity.Subject == "" {
		return nil, ErrUnauthorized
	}
	user, err := s.users.ByIDFresh(ctx, userID)
	if err != nil {
		return nil, err
	}
	existingIdentity, err := s.identities.WithContext(ctx).ByProviderSubject(identity.Provider, identity.Subject)
	if err == nil {
		if existingIdentity.UserID != userID {
			return nil, ErrIdentityAlreadyLinked
		}
		if err := s.refreshIdentity(existingIdentity, identity, time.Now().UTC()); err != nil {
			return nil, err
		}
		return existingIdentity, nil
	}
	if err != nil && !errors.Is(err, gorm.ErrRecordNotFound) {
		return nil, err
	}
	authIdentity := &AuthIdentity{
		UserID: user.ID,
	}
	if err := s.refreshIdentity(authIdentity, identity, time.Now().UTC()); err != nil {
		return nil, err
	}
	if identity.EmailVerified && user.EmailVerifiedAt == nil && strings.EqualFold(user.Email, identity.Email) {
		now := time.Now().UTC()
		user.EmailVerifiedAt = &now
			if err := s.users.Save(ctx, user); err != nil {
			return nil, err
		}
	}
	return authIdentity, nil
}

// UnlinkIdentity removes one linked provider identity when another auth path remains.
func (s *Service) UnlinkIdentity(ctx context.Context, userID int64, provider, subject string) error {
	identity, err := s.identities.WithContext(ctx).ByProviderSubject(provider, subject)
	if err != nil {
		if errors.Is(err, gorm.ErrRecordNotFound) {
			return ErrIdentityNotFound
		}
		return err
	}
	if identity.UserID != userID {
		return ErrUnauthorized
	}
	user, err := s.users.ByIDFresh(ctx, userID)
	if err != nil {
		return err
	}
	count, err := s.identities.CountByUserID(userID)
	if err != nil {
		return err
	}
	if count <= 1 && !hasUsableLocalPassword(user) {
		return ErrLastAuthMethod
	}
	return s.identities.Delete(identity.ID)
}

// Identities returns the linked provider identities for one user.
func (s *Service) Identities(userID int64) ([]AuthIdentity, error) {
	return s.identities.ByUserID(userID)
}

// AuthenticateWithProvider resolves one provider identity and issues a local auth session.
func (s *Service) AuthenticateWithProvider(ctx context.Context, provider OAuthProvider, callback OAuthCallback, userAgent, ipAddress string) (*User, *AuthIdentity, SessionTokens, error) {
	identity, err := provider.ResolveIdentity(ctx, callback)
	if err != nil {
		return nil, nil, SessionTokens{}, err
	}
	if strings.TrimSpace(identity.Provider) == "" {
		identity.Provider = provider.Name()
	}
	user, authIdentity, _, err := s.FindOrCreateUserFromProviderIdentity(ctx, identity)
	if err != nil {
		return nil, nil, SessionTokens{}, err
	}
	if !user.Active {
		return nil, nil, SessionTokens{}, ErrUnauthorized
	}
	tokens, err := s.issueSession(ctx, user, false, userAgent, ipAddress)
	if err != nil {
		return nil, nil, SessionTokens{}, err
	}
	now := time.Now().UTC()
	user.LastLoginAt = &now
	user.LastSeenAt = &now
	if authIdentity != nil {
		authIdentity.LastLoginAt = &now
		if err := s.identities.WithContext(ctx).Save(authIdentity); err != nil {
			return nil, nil, SessionTokens{}, err
		}
	}
	if err := s.users.Save(ctx, user); err != nil {
		return nil, nil, SessionTokens{}, err
	}
	return user, authIdentity, tokens, nil
}
{{- end }}

// ChangePassword updates the current user's password and revokes other sessions.
func (s *Service) ChangePassword(r web.Context, currentPassword, newPassword string) (*User, error) {
{{- if .Components.Metrics }}
	flow := s.beginAuthFlow("password_change", "na")
	defer flow.Done()
{{- end }}
	userID := s.userIDFromRequest(r)
	currentSessionID := s.sessionIDFromRequest(r)
	if userID == 0 || currentSessionID == "" {
{{- if .Components.Metrics }}
		flow.Set("unauthorized", "unauthorized")
{{- end }}
		return nil, ErrUnauthorized
	}
	user, err := s.users.ByIDFresh(r.Context(), userID)
	if err != nil || !user.Active {
{{- if .Components.Metrics }}
		flow.Set("unauthorized", "unauthorized")
{{- end }}
		return nil, ErrUnauthorized
	}
	if err := bcrypt.CompareHashAndPassword([]byte(user.PasswordHash), []byte(currentPassword)); err != nil {
{{- if .Components.Metrics }}
		flow.Set("invalid", "invalid_credentials")
{{- end }}
		return nil, ErrInvalidCredentials
	}
	if err := s.validatePassword(newPassword); err != nil {
		return nil, err
	}
	hash, err := bcrypt.GenerateFromPassword([]byte(newPassword), bcrypt.DefaultCost)
	if err != nil {
		return nil, err
	}
	user.PasswordHash = string(hash)
	now := time.Now().UTC()
	user.LastSeenAt = &now
	if err := s.users.Save(r.Context(), user); err != nil {
		return nil, err
	}
	if err := s.sessions.RevokeAllForUserExcept(r.Context(), userID, currentSessionID, now); err != nil {
		return nil, err
	}
{{- if .Components.Metrics }}
	flow.Set("succeeded", "na")
{{- end }}
	return user, nil
}

// UpdateProfile updates the current user's editable account fields.
func (s *Service) UpdateProfile(r web.Context, displayName, email string) (*User, error) {
	userID := s.userIDFromRequest(r)
	if userID == 0 {
		return nil, ErrUnauthorized
	}
	user, err := s.users.ByIDFresh(r.Context(), userID)
	if err != nil || !user.Active {
		return nil, ErrUnauthorized
	}
	displayName = strings.TrimSpace(displayName)
	email = strings.TrimSpace(email)
	if displayName == "" || email == "" {
		return nil, errors.New("display_name and email are required")
	}
	existingUser, err := s.users.WithContext(r.Context()).ByEmail(email)
	switch {
	case err == nil && existingUser.ID != user.ID:
		return nil, ErrEmailTaken
	case err != nil && !errors.Is(err, gorm.ErrRecordNotFound):
		return nil, err
	}
	emailChanged := !strings.EqualFold(strings.TrimSpace(user.Email), email)
	user.DisplayName = displayName
	user.Email = email
	if emailChanged {
		user.EmailVerifiedAt = nil
	}
	now := time.Now().UTC()
	user.LastSeenAt = &now
	if err := s.users.Save(r.Context(), user); err != nil {
		return nil, err
	}
	return user, nil
}

// RequestPasswordReset issues a new password reset grant for a local user.
func (s *Service) RequestPasswordReset(ctx context.Context, login, userAgent, ipAddress string) (string, error) {
{{- if .Components.Metrics }}
	flow := s.beginAuthFlow("password_reset_request", "na")
	defer flow.Done()
{{- end }}
	normalizedLogin := normalizeLoginIdentifier(login)
	if normalizedLogin == "" {
{{- if .Components.Metrics }}
		flow.Set("noop", "empty_login")
{{- end }}
		return "", nil
	}
	ipAddress = normalizeIPAddress(ipAddress)
	user, err := s.users.WithContext(ctx).ByLogin(normalizedLogin)
	if err != nil {
		if errors.Is(err, gorm.ErrRecordNotFound) {
{{- if .Components.Metrics }}
			flow.Set("noop", "missing_user")
{{- end }}
			return "", nil
		}
		return "", err
	}
	if !user.Active {
{{- if .Components.Metrics }}
		flow.Set("noop", "inactive_user")
{{- end }}
		return "", nil
	}
	now := time.Now().UTC()
	if err := s.resets.WithContext(ctx).RevokeActiveForUser(user.ID, now); err != nil {
		return "", err
	}
	rawToken, err := randomToken(32)
	if err != nil {
		return "", err
	}
	reset := &PasswordResetToken{
		UserID:    user.ID,
		TokenHash: hashOpaqueToken(rawToken),
		ExpiresAt: now.Add(s.passwordResetTTL()),
		UserAgent: strings.TrimSpace(userAgent),
		IPAddress: strings.TrimSpace(ipAddress),
	}
	if err := s.resets.WithContext(ctx).Save(reset); err != nil {
		return "", err
	}
	if err := s.delivery.SendPasswordReset(ctx, PasswordResetDelivery{
		User:      user,
		RawToken:  rawToken,
		ExpiresAt: reset.ExpiresAt.UTC().Format(time.RFC3339),
		UserAgent: reset.UserAgent,
		IPAddress: reset.IPAddress,
	}); err != nil {
		return "", err
	}
	if exposePasswordResetToken() {
{{- if .Components.Metrics }}
		flow.Set("succeeded", "token_issued")
{{- end }}
		return rawToken, nil
	}
{{- if .Components.Metrics }}
	flow.Set("succeeded", "na")
{{- end }}
	return "", nil
}

