	flow := s.beginAuthFlow("password_reset_confirm", "na")
	defer flow.Done()
{{- end }}
	token = strings.TrimSpace(token)
	if token == "" {
{{- if .Components.Metrics }}
		flow.Set("invalid", "invalid_token")
{{- end }}
		return ErrInvalidPasswordResetToken
	}
	now := time.Now().UTC()
	reset, err := s.resets.WithContext(ctx).ActiveByTokenHash(hashOpaqueToken(token), now)
	if err != nil {
		if errors.Is(err, gorm.ErrRecordNotFound) {
{{- if .Components.Metrics }}
			flow.Set("invalid", "invalid_token")
{{- end }}
			return ErrInvalidPasswordResetToken
		}
