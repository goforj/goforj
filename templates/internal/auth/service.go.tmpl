// Cleanup is the auth-owned scheduler hook for periodic session retention.
// The scheduler registry should call this instead of reaching into auth
// persistence details directly.
func (s *Service) Cleanup(context.Context) error {
	now := time.Now().UTC()
	if _, err := s.CleanupExpiredSessions(now); err != nil {
		return err
	}
	if _, err := s.CleanupExpiredEmailVerifications(now); err != nil {
		return err
	}
	if _, err := s.CleanupExpiredPasswordResets(now); err != nil {
		return err
	}
	if _, err := s.CleanupExpiredLoginAttempts(now); err != nil {
		return err
	}
	{{- if .Components.OAuth }}
	_, err := s.CleanupExpiredOAuthStates(now)
	return err
	{{- else }}
	return nil
	{{- end }}
}

// SetSessionCookies writes the access and refresh cookies for the given session.
func (s *Service) SetSessionCookies(r web.Context, tokens SessionTokens) {
	r.SetCookie(s.buildCookie(r, AccessCookieName, tokens.AccessToken, tokens.AccessExpiresAt))
	r.SetCookie(s.buildCookie(r, RefreshCookieName, tokens.RefreshToken, tokens.RefreshExpiresAt))
}

// ClearSessionCookies clears the generated auth cookies from the response.
func (s *Service) ClearSessionCookies(r web.Context) {
	expired := time.Unix(0, 0).UTC()
	r.SetCookie(s.buildCookie(r, AccessCookieName, "", expired))
	r.SetCookie(s.buildCookie(r, RefreshCookieName, "", expired))
}

// EnsureBootstrapUserFromEnv creates the configured bootstrap user when allowed.
func (s *Service) EnsureBootstrapUserFromEnv() (bool, error) {
	username := strings.TrimSpace(env.Get("AUTH_BOOTSTRAP_USERNAME", ""))
	password := os.Getenv("AUTH_BOOTSTRAP_PASSWORD")
	email := strings.TrimSpace(env.Get("AUTH_BOOTSTRAP_EMAIL", ""))
	if username == "" || password == "" {
		return false, nil
	}
	if email == "" {
		email = username + "@local.invalid"
	}
	if !env.IsAppEnvLocal() {
		return false, nil
	}
	if _, err := s.users.ByLogin(username); err == nil {
		return false, nil
	} else if isMissingUsersTableError(err) {
		return false, nil
	} else if !errors.Is(err, gorm.ErrRecordNotFound) {
		return false, err
	}
	hash, err := bcrypt.GenerateFromPassword([]byte(password), bcrypt.DefaultCost)
	if err != nil {
		return false, err
	}
	user := &User{
		Username:     username,
		Email:        email,
		DisplayName:  "Administrator",
		PasswordHash: string(hash),
		Active:       true,
	}
	if err := s.users.Create(user); err != nil {
		if isMissingUsersTableError(err) {
			return false, nil
		}
		return false, err
	}
	return true, nil
}

// EnsureLocalBootstrapUserFromEnv runs the bootstrap convenience path only in local envs.
func (s *Service) EnsureLocalBootstrapUserFromEnv() (bool, error) {
	if !env.IsAppEnvLocal() {
		return false, fmt.Errorf("auth:bootstrap is available only when APP_ENV=local")
	}
	return s.EnsureBootstrapUserFromEnv()
}

func sanitizeUser(user *User) TokenUser {
	return TokenUser{
		ID:              user.ID,
		Username:        user.Username,
		Email:           user.Email,
		DisplayName:     user.DisplayName,
		AvatarURL:       user.AvatarURL,
		Active:          user.Active,
		EmailVerifiedAt: user.EmailVerifiedAt,
		LastLoginAt:     user.LastLoginAt,
		LastSeenAt:      user.LastSeenAt,
		Timezone:        user.Timezone,
		Locale:          user.Locale,
	}
}

func sanitizeSession(session *AuthSession, currentSessionID string) TokenSession {
	return TokenSession{
		ID:          session.ID,
		Current:     session.ID == currentSessionID,
		DeviceLabel: deviceLabelFromUserAgent(session.UserAgent),
		ExpiresAt:   session.ExpiresAt,
		LastSeenAt:  session.LastSeenAt,
		UserAgent:   session.UserAgent,
		IPAddress:   session.IPAddress,
		CreatedAt:   session.CreatedAt,
	}
}

func (s *Service) authenticateRequest(r web.Context) (*User, error) {
	if user, err := s.userFromAccessCookie(r); err == nil {
		return user, nil
	}
	user, _, err := s.RefreshSession(r)
	if err != nil {
		return nil, err
	}
	return user, nil
}

func (s *Service) userFromAccessCookie(r web.Context) (*User, error) {
	cookie, err := r.Cookie(AccessCookieName)
	if err != nil || strings.TrimSpace(cookie.Value) == "" {
		return nil, ErrUnauthorized
	}
	claims, err := s.parseAccessToken(cookie.Value)
	if err != nil {
		return nil, ErrUnauthorized
	}
	session, err := s.sessions.ByIDFresh(claims.SessionID)
	if err != nil {
		return nil, ErrUnauthorized
	}
	if session.RevokedAt != nil || time.Now().UTC().After(session.ExpiresAt.UTC()) {
		return nil, ErrUnauthorized
	}
	user, err := s.users.ByIDFresh(claims.UserID)
	if err != nil || !user.Active {
		return nil, ErrUnauthorized
	}
	s.persistRequestLastSeen(user, session, time.Now().UTC())
	return user, nil
}

func (s *Service) userFromRefreshCookie(r web.Context) (*User, *AuthSession, string, error) {
	cookie, err := r.Cookie(RefreshCookieName)
	if err != nil || strings.TrimSpace(cookie.Value) == "" {
		return nil, nil, "", ErrUnauthorized
	}
	sessionID, secret, err := parseRefreshToken(cookie.Value)
	if err != nil {
		return nil, nil, "", ErrUnauthorized
	}
	session, err := s.sessions.ByIDFresh(sessionID)
	if err != nil {
		return nil, nil, "", ErrUnauthorized
	}
	now := time.Now().UTC()
	if session.RevokedAt != nil || !session.ExpiresAt.UTC().After(now) {
		return nil, nil, "", ErrUnauthorized
	}
	if hashRefreshSecret(secret) != session.RefreshTokenHash {
		return nil, nil, "", ErrUnauthorized
	}
	user, err := s.users.ByIDFresh(session.UserID)
	if err != nil || !user.Active {
		return nil, nil, "", ErrUnauthorized
	}
	return user, session, secret, nil
}

func (s *Service) issueSession(user *User, userAgent, ipAddress string) (SessionTokens, error) {
	sessionID, err := randomToken(24)
	if err != nil {
		return SessionTokens{}, err
	}
	refreshSecret, err := randomToken(32)
	if err != nil {
		return SessionTokens{}, err
	}
	now := time.Now().UTC()
	session := &AuthSession{
		ID:               sessionID,
		UserID:           user.ID,
		RefreshTokenHash: hashRefreshSecret(refreshSecret),
		ExpiresAt:        now.Add(s.refreshTTL()),
		LastSeenAt:       &now,
		UserAgent:        strings.TrimSpace(userAgent),
		IPAddress:        normalizeIPAddress(ipAddress),
	}
	if err := s.sessions.Save(session); err != nil {
		return SessionTokens{}, err
	}
	return s.issueTokensForSession(user, session, refreshSecret)
}

func (s *Service) rotateSession(user *User, session *AuthSession, userAgent, ipAddress string) (SessionTokens, error) {
	refreshSecret, err := randomToken(32)
	if err != nil {
		return SessionTokens{}, err
	}
	now := time.Now().UTC()
	session.RefreshTokenHash = hashRefreshSecret(refreshSecret)
	session.ExpiresAt = now.Add(s.refreshTTL())
	session.LastSeenAt = &now
	session.UserAgent = strings.TrimSpace(userAgent)
	session.IPAddress = normalizeIPAddress(ipAddress)
	if err := s.sessions.Save(session); err != nil {
		return SessionTokens{}, err
	}
	return s.issueTokensForSession(user, session, refreshSecret)
}

func (s *Service) persistRequestLastSeen(user *User, session *AuthSession, now time.Time) {
	now = now.UTC()
	if session != nil && shouldPersistLastSeen(session.LastSeenAt, now) {
		session.LastSeenAt = &now
		_ = s.sessions.Save(session)
	}
	if user != nil && shouldPersistLastSeen(user.LastSeenAt, now) {
		user.LastSeenAt = &now
		_ = s.users.Save(user)
	}
}

func shouldPersistLastSeen(lastSeenAt *time.Time, now time.Time) bool {
	if lastSeenAt == nil {
		return true
	}
	return now.Sub(lastSeenAt.UTC()) >= lastSeenWriteInterval
}

func (s *Service) issueTokensForSession(user *User, session *AuthSession, refreshSecret string) (SessionTokens, error) {
	jwtSecret, err := s.jwtSecret()
	if err != nil {
		return SessionTokens{}, err
	}
	accessExpiresAt := time.Now().UTC().Add(s.accessTTL())
	token := jwt.NewWithClaims(jwt.SigningMethodHS256, accessClaims{
		UserID:    user.ID,
		SessionID: session.ID,
		Username:  user.Username,
		RegisteredClaims: jwt.RegisteredClaims{
			Subject:   fmt.Sprintf("%d", user.ID),
			ExpiresAt: jwt.NewNumericDate(accessExpiresAt),
			IssuedAt:  jwt.NewNumericDate(time.Now().UTC()),
		},
	})
	accessToken, err := token.SignedString([]byte(jwtSecret))
	if err != nil {
		return SessionTokens{}, err
	}
	return SessionTokens{
		AccessToken:      accessToken,
		RefreshToken:     buildRefreshToken(session.ID, refreshSecret),
		AccessExpiresAt:  accessExpiresAt,
		RefreshExpiresAt: session.ExpiresAt.UTC(),
		SessionID:        session.ID,
	}, nil
}

func (s *Service) parseAccessToken(raw string) (*accessClaims, error) {
	jwtSecret, err := s.jwtSecret()
	if err != nil {
		return nil, ErrUnauthorized
	}
	claims := &accessClaims{}
	token, err := jwt.ParseWithClaims(raw, claims, func(token *jwt.Token) (any, error) {
		if _, ok := token.Method.(*jwt.SigningMethodHMAC); !ok {
			return nil, ErrUnauthorized
		}
		return []byte(jwtSecret), nil
	})
	if err != nil || !token.Valid {
		return nil, ErrUnauthorized
	}
	return claims, nil
}

func (s *Service) sessionIDFromRequest(r web.Context) string {
	if cookie, err := r.Cookie(RefreshCookieName); err == nil && strings.TrimSpace(cookie.Value) != "" {
		sessionID, _, err := parseRefreshToken(cookie.Value)
		if err == nil {
			return sessionID
		}
	}
	if cookie, err := r.Cookie(AccessCookieName); err == nil && strings.TrimSpace(cookie.Value) != "" {
		if claims, err := s.parseAccessToken(cookie.Value); err == nil {
			return claims.SessionID
		}
	}
	return ""
}

func (s *Service) userIDFromRequest(r web.Context) int64 {
	if cookie, err := r.Cookie(AccessCookieName); err == nil && strings.TrimSpace(cookie.Value) != "" {
		if claims, err := s.parseAccessToken(cookie.Value); err == nil {
			return claims.UserID
		}
	}
	if sessionID := s.sessionIDFromRequest(r); sessionID != "" {
			session, err := s.sessions.ByIDFresh(sessionID)
		if err == nil {
			return session.UserID
		}
	}
	return 0
}

