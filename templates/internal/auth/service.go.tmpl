func deviceLabelFromUserAgent(userAgent string) string {
	raw := strings.TrimSpace(userAgent)
	if raw == "" {
		return "Unknown device"
	}
	platform := "Device"
	switch {
	case strings.Contains(raw, "iPhone"):
		platform = "iPhone"
	case strings.Contains(raw, "iPad"):
		platform = "iPad"
	case strings.Contains(raw, "Android"):
		platform = "Android"
	case strings.Contains(raw, "Macintosh"):
		platform = "Mac"
	case strings.Contains(raw, "Windows"):
		platform = "Windows"
	case strings.Contains(raw, "Linux"):
		platform = "Linux"
	}
	browser := "Browser"
	switch {
	case strings.Contains(raw, "Edg/"):
		browser = "Edge"
	case strings.Contains(raw, "Chrome/"):
		browser = "Chrome"
	case strings.Contains(raw, "Firefox/"):
		browser = "Firefox"
	case strings.Contains(raw, "Safari/") && strings.Contains(raw, "Version/"):
		browser = "Safari"
	case strings.HasPrefix(raw, "curl/"):
		browser = "curl"
	case strings.HasPrefix(raw, "Go-http-client/"):
		browser = "Go HTTP client"
	}
	return strings.TrimSpace(platform + " · " + browser)
}
