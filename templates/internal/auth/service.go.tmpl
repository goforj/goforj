func normalizeProviderIdentity(identity ProviderIdentity) ProviderIdentity {
	identity.Provider = strings.TrimSpace(strings.ToLower(identity.Provider))
	identity.Subject = strings.TrimSpace(identity.Subject)
	identity.Email = strings.TrimSpace(strings.ToLower(identity.Email))
	identity.Username = strings.TrimSpace(identity.Username)
	identity.DisplayName = strings.TrimSpace(identity.DisplayName)
	identity.AvatarURL = strings.TrimSpace(identity.AvatarURL)
	return identity
}

func (s *Service) refreshIdentity(authIdentity *AuthIdentity, identity ProviderIdentity, now time.Time) error {
	authIdentity.Provider = identity.Provider
	authIdentity.ProviderSubject = identity.Subject
	authIdentity.ProviderEmail = identity.Email
	authIdentity.ProviderEmailVerified = identity.EmailVerified
	authIdentity.ProviderUsername = identity.Username
	authIdentity.ProviderDisplayName = identity.DisplayName
	authIdentity.ProviderAvatarURL = identity.AvatarURL
	authIdentity.LastLoginAt = &now
	return s.identities.Save(authIdentity)
}

func (s *Service) generateUniqueIdentityUsername(identity ProviderIdentity) string {
	base := normalizeUsernameCandidate(identity.Username)
	if base == "" && identity.Email != "" {
		if local, _, ok := strings.Cut(identity.Email, "@"); ok {
			base = normalizeUsernameCandidate(local)
		}
	}
	if base == "" {
		base = normalizeUsernameCandidate(identity.DisplayName)
	}
	if base == "" {
		base = normalizeUsernameCandidate(identity.Provider + " " + identity.Subject)
	}
	if base == "" {
		base = "user"
	}
	candidate := base
	for i := 0; i < 1000; i++ {
		if _, err := s.users.ByLogin(candidate); errors.Is(err, gorm.ErrRecordNotFound) {
			return candidate
		}
		if i == 0 {
			candidate = base + "_" + identity.Provider
			continue
		}
		candidate = fmt.Sprintf("%s_%d", base, i+1)
	}
	return fmt.Sprintf("%s_%d", base, time.Now().UTC().Unix())
}

func (s *Service) generateIdentityEmail(identity ProviderIdentity) string {
	if identity.Email != "" {
		return identity.Email
	}
	local := normalizeUsernameCandidate(identity.Provider + " " + identity.Subject)
	if local == "" {
		local = fmt.Sprintf("user_%d", time.Now().UTC().Unix())
	}
	candidate := local + "@" + identity.Provider + ".oauth.invalid"
	for i := 0; i < 1000; i++ {
		if _, err := s.users.ByEmail(candidate); errors.Is(err, gorm.ErrRecordNotFound) {
			return candidate
		}
		candidate = fmt.Sprintf("%s_%d@%s.oauth.invalid", local, i+1, identity.Provider)
	}
	return fmt.Sprintf("%s_%d@%s.oauth.invalid", local, time.Now().UTC().Unix(), identity.Provider)
}

func (s *Service) identityDisplayName(identity ProviderIdentity) string {
	if identity.DisplayName != "" {
		return identity.DisplayName
	}
	if identity.Username != "" {
		return identity.Username
	}
	if identity.Email != "" {
		if local, _, ok := strings.Cut(identity.Email, "@"); ok && local != "" {
			return local
		}
	}
	return strings.TrimSpace(identity.Provider + " user")
}

func normalizeUsernameCandidate(value string) string {
	value = strings.TrimSpace(strings.ToLower(value))
	if value == "" {
		return ""
	}
	var b strings.Builder
	lastUnderscore := false
	for _, r := range value {
		switch {
		case r >= 'a' && r <= 'z':
			b.WriteRune(r)
			lastUnderscore = false
		case r >= '0' && r <= '9':
			b.WriteRune(r)
			lastUnderscore = false
		default:
			if !lastUnderscore && b.Len() > 0 {
				b.WriteByte('_')
				lastUnderscore = true
			}
		}
	}
	return strings.Trim(b.String(), "_")
}

func hasUsableLocalPassword(user *User) bool {
	return strings.TrimSpace(user.PasswordHash) != "" && user.PasswordHash != invalidPasswordHash
}
