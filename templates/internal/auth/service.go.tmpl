}

func (s *Service) authenticateRequest(r web.Context) (*User, error) {
	if user, err := s.userFromAccessCookie(r); err == nil {
{{- if .Components.Metrics }}
		s.noteAuthFlow("request_auth", "succeeded", "access_cookie", "na")
{{- end }}
		return user, nil
	}
	user, _, err := s.handleRefreshSession(r, true, false)
	if err != nil {
{{- if .Components.Metrics }}
		s.noteAuthFlow("request_auth", "unauthorized", "invalid_session", "na")
{{- end }}
		s.logAuthRequestDebug(r, "request_auth_failed", "refresh_fallback_rejected", nil, nil, nil, time.Now().UTC())
		return nil, err
	}
{{- if .Components.Metrics }}
	s.noteAuthFlow("request_auth", "succeeded", "refresh_fallback", "na")
{{- end }}
	return user, nil
}

func (s *Service) userFromAccessCookie(r web.Context) (*User, error) {
	cookie, err := r.Cookie(AccessCookieName)
	if err != nil || strings.TrimSpace(cookie.Value) == "" {
		s.logAuthRequestDebug(r, "access_cookie_rejected", "missing_access_cookie", nil, nil, nil, time.Now().UTC())
		return nil, ErrUnauthorized
	}
	claims, err := s.parseAccessToken(cookie.Value)
	if err != nil {
		s.logAuthRequestDebug(r, "access_cookie_rejected", "invalid_access_token", nil, nil, nil, time.Now().UTC())
		return nil, ErrUnauthorized
	}
	session, err := s.sessions.ByID(r.Context(), claims.SessionID)
	if err != nil {
		s.logAuthRequestDebug(r, "access_cookie_rejected", "session_not_found", claims, nil, nil, time.Now().UTC())
		return nil, ErrUnauthorized
	}
	now := time.Now().UTC()
	if session.RevokedAt != nil {
		s.logAuthRequestDebug(r, "access_cookie_rejected", "session_revoked", claims, session, nil, now)
		return nil, ErrUnauthorized
	}
	if now.After(session.ExpiresAt.UTC()) {
		s.logAuthRequestDebug(r, "access_cookie_rejected", "session_expired", claims, session, nil, now)
		return nil, ErrUnauthorized
	}
	if s.sessionIdleExpired(session, now) {
		s.logAuthRequestDebug(r, "access_cookie_rejected", "session_idle_expired", claims, session, nil, now)
		return nil, ErrUnauthorized
	}
	user, err := s.users.ByIDProfile(r.Context(), claims.UserID)
	if err != nil {
		s.logAuthRequestDebug(r, "access_cookie_rejected", "user_not_found", claims, session, nil, now)
		return nil, ErrUnauthorized
	}
	active, err := s.users.Active(r.Context(), claims.UserID)
	if err != nil {
		s.logAuthRequestDebug(r, "access_cookie_rejected", "user_not_found", claims, session, nil, now)
		return nil, ErrUnauthorized
	}
	if !active {
		s.logAuthRequestDebug(r, "access_cookie_rejected", "user_inactive", claims, session, user, now)
		return nil, ErrUnauthorized
	}
	user.Active = active
	s.persistRequestLastSeen(r.Context(), user, session, now)
	return user, nil
}

func (s *Service) authenticateRefreshSession(r web.Context, allowReplay bool) (*User, *AuthSession, string, bool, error) {
	cookie, err := r.Cookie(RefreshCookieName)
	if err != nil || strings.TrimSpace(cookie.Value) == "" {
		s.logAuthRequestDebug(r, "refresh_cookie_rejected", "missing_refresh_cookie", nil, nil, nil, time.Now().UTC())
		return nil, nil, "", false, ErrUnauthorized
	}
	sessionID, secret, err := parseRefreshToken(cookie.Value)
	if err != nil {
		s.logAuthRequestDebug(r, "refresh_cookie_rejected", "invalid_refresh_token", nil, nil, nil, time.Now().UTC())
		return nil, nil, "", false, ErrUnauthorized
	}
	session, err := s.sessions.ByIDFresh(r.Context(), sessionID)
	if err != nil {
		s.logAuthRequestDebug(r, "refresh_cookie_rejected", "session_not_found", &accessClaims{SessionID: sessionID}, nil, nil, time.Now().UTC())
		return nil, nil, "", false, ErrUnauthorized
	}
	now := time.Now().UTC()
	if session.RevokedAt != nil {
		s.logAuthRequestDebug(r, "refresh_cookie_rejected", "session_revoked", &accessClaims{SessionID: sessionID}, session, nil, now)
		return nil, nil, "", false, ErrUnauthorized
	}
	if !session.ExpiresAt.UTC().After(now) {
		s.logAuthRequestDebug(r, "refresh_cookie_rejected", "session_expired", &accessClaims{SessionID: sessionID}, session, nil, now)
		return nil, nil, "", false, ErrUnauthorized
	}
	if s.sessionIdleExpired(session, now) {
		s.logAuthRequestDebug(r, "refresh_cookie_rejected", "session_idle_expired", &accessClaims{SessionID: sessionID}, session, nil, now)
		return nil, nil, "", false, ErrUnauthorized
	}
	if hashRefreshSecret(secret) != session.RefreshTokenHash {
		if allowReplay && s.allowRefreshGraceReplay(session, r.Request().UserAgent(), r.RealIP(), now) {
			user, err := s.users.ByIDProfile(r.Context(), session.UserID)
			if err != nil {
				s.logAuthRequestDebug(r, "refresh_cookie_rejected", "user_not_found", &accessClaims{SessionID: sessionID, UserID: session.UserID}, session, nil, now)
				return nil, nil, "", false, ErrUnauthorized
			}
			active, err := s.users.Active(r.Context(), session.UserID)
			if err != nil {
				s.logAuthRequestDebug(r, "refresh_cookie_rejected", "user_not_found", &accessClaims{SessionID: sessionID, UserID: session.UserID}, session, nil, now)
				return nil, nil, "", false, ErrUnauthorized
			}
			if !active {
				s.logAuthRequestDebug(r, "refresh_cookie_rejected", "user_inactive", &accessClaims{SessionID: sessionID, UserID: session.UserID}, session, user, now)
				return nil, nil, "", false, ErrUnauthorized
			}
			user.Active = active
			s.logAuthRequestDebug(r, "refresh_cookie_recovered", "refresh_hash_mismatch_grace", &accessClaims{SessionID: sessionID, UserID: session.UserID}, session, user, now)
			return user, session, "", false, nil
		}
		s.logAuthRequestDebug(r, "refresh_cookie_rejected", "refresh_hash_mismatch", &accessClaims{SessionID: sessionID}, session, nil, now)
		return nil, nil, "", false, ErrUnauthorized
	}
	user, err := s.users.ByIDProfile(r.Context(), session.UserID)
	if err != nil {
		s.logAuthRequestDebug(r, "refresh_cookie_rejected", "user_not_found", &accessClaims{SessionID: sessionID, UserID: session.UserID}, session, nil, now)
		return nil, nil, "", false, ErrUnauthorized
	}
	active, err := s.users.Active(r.Context(), session.UserID)
	if err != nil {
		s.logAuthRequestDebug(r, "refresh_cookie_rejected", "user_not_found", &accessClaims{SessionID: sessionID, UserID: session.UserID}, session, nil, now)
		return nil, nil, "", false, ErrUnauthorized
	}
	if !active {
		s.logAuthRequestDebug(r, "refresh_cookie_rejected", "user_inactive", &accessClaims{SessionID: sessionID, UserID: session.UserID}, session, user, now)
		return nil, nil, "", false, ErrUnauthorized
	}
	user.Active = active
	return user, session, secret, true, nil
}

func (s *Service) refreshCookieSessionID(r web.Context) (string, error) {
	cookie, err := r.Cookie(RefreshCookieName)
	if err != nil || strings.TrimSpace(cookie.Value) == "" {
		return "", ErrUnauthorized
	}
	sessionID, _, err := parseRefreshToken(cookie.Value)
	if err != nil {
		return "", ErrUnauthorized
	}
	return sessionID, nil
}

func (s *Service) issueSession(ctx context.Context, user *User, remember bool, userAgent, ipAddress string) (SessionTokens, error) {
	sessionID, err := randomToken(24)
	if err != nil {
		return SessionTokens{}, err
	}
	refreshSecret, err := randomToken(32)
	if err != nil {
		return SessionTokens{}, err
	}
	now := time.Now().UTC()
	sessionTTL := s.refreshTTL()
	if remember {
		sessionTTL = s.rememberSessionTTL()
	}
	session := &AuthSession{
		ID:               sessionID,
		UserID:           user.ID,
		RefreshTokenHash: hashRefreshSecret(refreshSecret),
		ExpiresAt:        now.Add(sessionTTL),
		LastSeenAt:       &now,
		UserAgent:        strings.TrimSpace(userAgent),
		IPAddress:        normalizeIPAddress(ipAddress),
	}
	if err := s.sessions.Save(ctx, session); err != nil {
		return SessionTokens{}, err
	}
	return s.buildTokenPairForSession(user, session, refreshSecret)
}

func (s *Service) rotateRefreshSession(ctx context.Context, user *User, session *AuthSession, userAgent, ipAddress string) (SessionTokens, error) {
	refreshSecret, err := randomToken(32)
	if err != nil {
		return SessionTokens{}, err
	}
	now := time.Now().UTC()
	session.RefreshTokenHash = hashRefreshSecret(refreshSecret)
	session.RefreshRotatedAt = &now
	session.ExpiresAt = now.Add(s.refreshTTL())
	session.LastSeenAt = &now
	session.UserAgent = strings.TrimSpace(userAgent)
	session.IPAddress = normalizeIPAddress(ipAddress)
	if err := s.sessions.Save(ctx, session); err != nil {
		return SessionTokens{}, err
	}
	return s.buildTokenPairForSession(user, session, refreshSecret)
}

func (s *Service) issueTokenPairForSession(ctx context.Context, user *User, session *AuthSession, refreshSecret, userAgent, ipAddress string) (SessionTokens, error) {
	now := time.Now().UTC()
	session.ExpiresAt = now.Add(s.refreshTTL())
	session.LastSeenAt = &now
	session.UserAgent = strings.TrimSpace(userAgent)
	session.IPAddress = normalizeIPAddress(ipAddress)
	if err := s.sessions.Save(ctx, session); err != nil {
		return SessionTokens{}, err
	}
	return s.buildTokenPairForSession(user, session, refreshSecret)
}

func (s *Service) issueAccessOnlyForSession(ctx context.Context, user *User, session *AuthSession, userAgent, ipAddress string) (SessionTokens, error) {
	now := time.Now().UTC()
	session.LastSeenAt = &now
	session.UserAgent = strings.TrimSpace(userAgent)
	session.IPAddress = normalizeIPAddress(ipAddress)
	s.sessions.TouchLastSeen(ctx, session, now)
	if err := s.sessions.PersistLastSeen(ctx, session.ID, now); err != nil {
		return SessionTokens{}, err
	}
	return s.issueAccessForSession(user, session)
}

func (s *Service) withSerializedRefreshSession(sessionID string, fn func() (*User, SessionTokens, error)) (*User, SessionTokens, error) {
	lock := s.refreshSessionMutex(sessionID)
	lock.Lock()
	defer lock.Unlock()
	return fn()
}

func (s *Service) refreshSessionMutex(sessionID string) *sync.Mutex {
	sum := sha256.Sum256([]byte(strings.TrimSpace(sessionID)))
	return &s.refreshLocks[int(sum[0])%len(s.refreshLocks)]
}

func (s *Service) allowRefreshGraceReplay(session *AuthSession, userAgent, ipAddress string, now time.Time) bool {
	if session == nil || session.LastSeenAt == nil {
		return false
	}
	if now.UTC().Sub(session.LastSeenAt.UTC()) > refreshReplayGraceWindow {
		return false
	}
	if strings.TrimSpace(session.UserAgent) != strings.TrimSpace(userAgent) {
		return false
	}
	if normalizeIPAddress(session.IPAddress) != normalizeIPAddress(ipAddress) {
		return false
	}
	return true
}

func (s *Service) persistRequestLastSeen(ctx context.Context, user *User, session *AuthSession, now time.Time) {
	now = now.UTC()
	if session != nil {
		previousSessionSeenAt := session.LastSeenAt
		s.sessions.TouchLastSeen(ctx, session, now)
		if s.shouldPersistLastSeen(previousSessionSeenAt, now) {
			_ = s.sessions.PersistLastSeen(ctx, session.ID, now)
		}
	}
	if user != nil {
		previousUserSeenAt := user.LastSeenAt
		s.users.TouchProfileLastSeen(ctx, user, now)
		if s.shouldPersistLastSeen(previousUserSeenAt, now) {
			_ = s.users.PersistLastSeen(ctx, user.ID, now)
		}
	}
}

func (s *Service) shouldPersistLastSeen(lastSeenAt *time.Time, now time.Time) bool {
	if lastSeenAt == nil {
		return true
	}
	return now.Sub(lastSeenAt.UTC()) >= lastSeenWriteInterval
}

func (s *Service) sessionIdleExpired(session *AuthSession, now time.Time) bool {
	idleTTL := s.sessionIdleTTL()
	if idleTTL <= 0 {
		return false
	}
	reference := session.CreatedAt.UTC()
	if session.LastSeenAt != nil {
		reference = session.LastSeenAt.UTC()
	}
	return !reference.Add(idleTTL).After(now.UTC())
}

func (s *Service) sessionIdleDeadline(session *AuthSession) (time.Time, bool) {
	if session == nil {
		return time.Time{}, false
	}
	idleTTL := s.sessionIdleTTL()
	if idleTTL <= 0 {
		return time.Time{}, false
	}
	reference := session.CreatedAt.UTC()
	if session.LastSeenAt != nil {
		reference = session.LastSeenAt.UTC()
	}
	return reference.Add(idleTTL), true
}

// logAuthRequestDebug emits a narrow allowlist of auth diagnostic fields.
//
// Allowed categories:
// - request routing context: path, method, normalized ip, user agent
// - auth outcome metadata: auth_outcome, auth_reason, ttl windows
// - stable identifiers and timing metadata: user_id, session_id, created/seen/expiry timestamps
//
// Never add raw access tokens, raw refresh tokens, reset tokens, verification
// tokens, password hashes, OAuth provider tokens, secrets, or full cookie/header
// values here. Keep this path safe for inspect timelines and debug logs.
func (s *Service) logAuthRequestDebug(r web.Context, outcome, reason string, claims *accessClaims, session *AuthSession, user *User, now time.Time) {
	if s == nil || s.logger == nil || r == nil {
		return
	}
	event := s.logger.WithContext(r.Request().Context()).Debug()
	if event == nil {
		return
	}
	req := r.Request()
	if req != nil {
		event = event.
			Str("path", req.URL.Path).
			Str("method", req.Method).
			Str("user_agent", req.UserAgent()).
			Str("ip_address", normalizeIPAddress(r.RealIP()))
	}
	event = event.
		Str("auth_outcome", outcome).
		Str("auth_reason", reason).
		Time("now", now.UTC()).
		Dur("access_ttl", s.accessTTL()).
		Dur("session_idle_ttl", s.sessionIdleTTL()).
		Dur("session_ttl", s.refreshTTL())
	if claims != nil {
		if claims.SessionID != "" {
			event = event.Str("session_id", claims.SessionID)
		}
		if claims.UserID != 0 {
			event = event.Int64("user_id", claims.UserID)
		}
		if claims.ExpiresAt != nil {
			expiresAt := claims.ExpiresAt.Time.UTC()
			event = event.
				Time("access_expires_at", expiresAt).
				Dur("access_remaining", expiresAt.Sub(now.UTC()))
		}
	}
	if session != nil {
		event = event.
			Str("session_id", session.ID).
			Int64("session_user_id", session.UserID).
			Time("session_expires_at", session.ExpiresAt.UTC()).
			Dur("session_remaining", session.ExpiresAt.UTC().Sub(now.UTC()))
		if session.LastSeenAt != nil {
			event = event.Time("session_last_seen_at", session.LastSeenAt.UTC())
		}
		if session.RefreshRotatedAt != nil {
			event = event.Time("session_refresh_rotated_at", session.RefreshRotatedAt.UTC())
		}
		if !session.CreatedAt.IsZero() {
			event = event.Time("session_created_at", session.CreatedAt.UTC())
		}
		if idleDeadline, ok := s.sessionIdleDeadline(session); ok {
			event = event.
				Time("session_idle_expires_at", idleDeadline.UTC()).
				Dur("session_idle_remaining", idleDeadline.UTC().Sub(now.UTC()))
		}
		if session.RevokedAt != nil {
			event = event.Time("session_revoked_at", session.RevokedAt.UTC())
		}
	}
	if user != nil {
		event = event.
			Int64("user_id", user.ID).
			Bool("user_active", user.Active)
		if user.LastSeenAt != nil {
			event = event.Time("user_last_seen_at", user.LastSeenAt.UTC())
		}
	}
	event.Msg("auth session debug")
}

func (s *Service) buildTokenPairForSession(user *User, session *AuthSession, refreshSecret string) (SessionTokens, error) {
	tokens, err := s.issueAccessForSession(user, session)
	if err != nil {
		return SessionTokens{}, err
	}
	tokens.RefreshToken = buildRefreshToken(session.ID, refreshSecret)
	return tokens, nil
}

func (s *Service) issueAccessForSession(user *User, session *AuthSession) (SessionTokens, error) {
	jwtSecret, err := s.jwtSecret()
	if err != nil {
		return SessionTokens{}, err
	}
	accessExpiresAt := time.Now().UTC().Add(s.accessTTL())
	token := jwt.NewWithClaims(jwt.SigningMethodHS256, accessClaims{
		UserID:    user.ID,
		SessionID: session.ID,
		Username:  user.Username,
		RegisteredClaims: jwt.RegisteredClaims{
			Subject:   fmt.Sprintf("%d", user.ID),
			ExpiresAt: jwt.NewNumericDate(accessExpiresAt),
			IssuedAt:  jwt.NewNumericDate(time.Now().UTC()),
		},
	})
	accessToken, err := token.SignedString([]byte(jwtSecret))
	if err != nil {
		return SessionTokens{}, err
	}
	return SessionTokens{
		AccessToken:      accessToken,
		AccessExpiresAt:  accessExpiresAt,
		RefreshExpiresAt: session.ExpiresAt.UTC(),
		SessionID:        session.ID,
	}, nil
}

func (s *Service) parseAccessToken(raw string) (*accessClaims, error) {
	jwtSecret, err := s.jwtSecret()
	if err != nil {
		return nil, ErrUnauthorized
	}
	claims := &accessClaims{}
	token, err := jwt.ParseWithClaims(raw, claims, func(token *jwt.Token) (any, error) {
		if _, ok := token.Method.(*jwt.SigningMethodHMAC); !ok {
			return nil, ErrUnauthorized
		}
		return []byte(jwtSecret), nil
	})
	if err != nil || !token.Valid {
		return nil, ErrUnauthorized
	}
	return claims, nil
}

func (s *Service) sessionIDFromRequest(r web.Context) string {
	if cookie, err := r.Cookie(RefreshCookieName); err == nil && strings.TrimSpace(cookie.Value) != "" {
		sessionID, _, err := parseRefreshToken(cookie.Value)
		if err == nil {
			return sessionID
		}
	}
	if cookie, err := r.Cookie(AccessCookieName); err == nil && strings.TrimSpace(cookie.Value) != "" {
		if claims, err := s.parseAccessToken(cookie.Value); err == nil {
			return claims.SessionID
		}
	}
	return ""
}

func (s *Service) userIDFromRequest(r web.Context) int64 {
	if cookie, err := r.Cookie(AccessCookieName); err == nil && strings.TrimSpace(cookie.Value) != "" {
		if claims, err := s.parseAccessToken(cookie.Value); err == nil {
			return claims.UserID
		}
	}
	if sessionID := s.sessionIDFromRequest(r); sessionID != "" {
		session, err := s.sessions.ByID(r.Context(), sessionID)
		if err == nil {
			return session.UserID
		}
	}
	return 0
}

func (s *Service) jwtSecret() (string, error) {
	secret := strings.TrimSpace(env.Get("API_JWT_SECRET_KEY", ""))
	if secret == "" {
		return "", ErrInvalidConfig
	}
	return secret, nil
}

