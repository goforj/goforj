// RevokeSession revokes one active session owned by the current user.
func (s *Service) RevokeSession(r web.Context, sessionID string) (bool, error) {
{{- if .Components.Metrics }}
	flow := s.beginAuthFlow("session_revoke", "na")
	defer flow.Done()
{{- end }}
	userID := s.userIDFromRequest(r)
	if userID == 0 {
{{- if .Components.Metrics }}
		flow.Set("unauthorized", "unauthorized")
{{- end }}
		return false, ErrUnauthorized
	}
	sessionID = strings.TrimSpace(sessionID)
	if sessionID == "" {
{{- if .Components.Metrics }}
		flow.Set("unauthorized", "missing_session")
{{- end }}
		return false, ErrUnauthorized
	}
	session, err := s.sessions.ByIDFresh(r.Context(), sessionID)
	if err != nil {
{{- if .Components.Metrics }}
		flow.Set("unauthorized", "invalid_session")
{{- end }}
		return false, ErrUnauthorized
	}
	if session.UserID != userID {
{{- if .Components.Metrics }}
		flow.Set("unauthorized", "unauthorized")
{{- end }}
		return false, ErrUnauthorized
	}
	if err := s.sessions.Revoke(r.Context(), sessionID, time.Now().UTC()); err != nil {
		return false, err
	}
	current := sessionID == s.sessionIDFromRequest(r)
	if current {
		s.ClearSessionCookies(r)
{{- if .Components.Metrics }}
		flow.Set("succeeded", "current_session")
{{- end }}
	} else {
{{- if .Components.Metrics }}
		flow.Set("succeeded", "other_session")
{{- end }}
	}
	return current, nil
}

