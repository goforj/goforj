func (s *Service) issueEmailVerification(ctx context.Context, user *User, userAgent, ipAddress string) (string, error) {
	now := time.Now().UTC()
	if err := s.verifications.WithContext(ctx).RevokeActiveForUser(user.ID, now); err != nil {
		return "", err
	}
	rawToken, err := randomToken(32)
	if err != nil {
		return "", err
	}
	verification := &EmailVerificationToken{
		UserID:    user.ID,
		TokenHash: hashOpaqueToken(rawToken),
		ExpiresAt: now.Add(s.emailVerificationTTL()),
		UserAgent: strings.TrimSpace(userAgent),
		IPAddress: normalizeIPAddress(ipAddress),
	}
	if err := s.verifications.WithContext(ctx).Save(verification); err != nil {
		return "", err
	}
	if err := s.delivery.SendEmailVerification(ctx, EmailVerificationDelivery{
		User:      user,
		RawToken:  rawToken,
		ExpiresAt: verification.ExpiresAt.UTC().Format(time.RFC3339),
		UserAgent: verification.UserAgent,
		IPAddress: verification.IPAddress,
	}); err != nil {
		return "", err
	}
	if exposeEmailVerificationToken() {
		return rawToken, nil
	}
	return "", nil
}

