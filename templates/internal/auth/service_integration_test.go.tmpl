		t.Fatalf("authenticate old password error = %v, want %v", err, ErrInvalidCredentials)
	}
	if _, _, err := h.service.Authenticate(context.Background(), AuthenticateInput{Login: user.Username, Password: "new-Secret-pass", UserAgent: "ua-new", IPAddress: "127.0.0.33"}); err != nil {
		t.Fatalf("authenticate new password: %v", err)
	}
}

