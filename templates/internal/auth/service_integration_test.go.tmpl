	}
	if reloadedCached.Active {
		t.Fatalf("cached profile active = %v, want false", reloadedCached.Active)
	}
	if reloadedCached.LockedUntil != nil {
		t.Fatalf("cached profile locked_until = %v, want nil", reloadedCached.LockedUntil)
	}
