	}
	if reloadedFresh.UserAgent != "db-only-agent" {
		t.Fatalf("fresh session user_agent = %q, want %q", reloadedFresh.UserAgent, "db-only-agent")
	}
	if !timesEqualPtr(reloadedFresh.RefreshRotatedAt, &rotatedAt) {
		t.Fatalf("fresh session refresh_rotated_at = %v, want %v", reloadedFresh.RefreshRotatedAt, rotatedAt)
	}
}

