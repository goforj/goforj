func TestLoginSetsSecureCookieDefaultsIntegration(t *testing.T) {
	h := newAuthIntegrationHarness(t)
	h.createUser(t, authIntegrationUserInput{
		Username: "alice",
		Email:    "alice@example.com",
		Password: "secret-pass",
		Active:   true,
	})

	loginRec := h.doJSON(
		http.MethodPost,
		"/auth/login",
		map[string]any{"login": "alice", "password": "secret-pass"},
		h.controller.Login,
		nil,
		nil,
	)
	if loginRec.Code != http.StatusOK {
		t.Fatalf("login status = %d, want %d\nbody:\n%s", loginRec.Code, http.StatusOK, loginRec.Body.String())
	}

	for _, name := range []string{AccessCookieName, RefreshCookieName} {
		cookie := h.cookie(loginRec, name)
		if cookie == nil {
			t.Fatalf("expected %s cookie", name)
		}
		if !cookie.HttpOnly {
			t.Fatalf("%s HttpOnly = false, want true", name)
		}
		if cookie.SameSite != http.SameSiteLaxMode {
			t.Fatalf("%s SameSite = %v, want %v", name, cookie.SameSite, http.SameSiteLaxMode)
		}
		if cookie.Path != "/" {
			t.Fatalf("%s Path = %q, want %q", name, cookie.Path, "/")
		}
		if cookie.Secure {
			t.Fatalf("%s Secure = true, want false for local test harness", name)
		}
	}
}

