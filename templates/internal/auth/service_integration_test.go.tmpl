	if err != nil {
		t.Fatalf("authenticate: %v", err)
	}

	cachedSession, err := h.sessions.ByID(context.Background(), tokens.SessionID)
	if err != nil {
		t.Fatalf("prime cached session: %v", err)
	}
	rotatedAt := time.Now().UTC().Add(time.Minute).Truncate(time.Second)

	db, err := h.conns.Default()
	if err != nil {
		t.Fatalf("default db: %v", err)
	}
	if err := db.Model(&AuthSession{}).
		Where("id = ?", tokens.SessionID).
		Updates(map[string]any{
			"refresh_token_hash": "db-only-refresh-hash",
			"refresh_rotated_at": rotatedAt,
			"user_agent":         "db-only-agent",
		}).Error; err != nil {
		t.Fatalf("update session directly: %v", err)
	}

	reloadedCached, err := h.sessions.ByID(context.Background(), tokens.SessionID)
	if err != nil {
		t.Fatalf("load cached session: %v", err)
	}
	if reloadedCached.RefreshTokenHash != cachedSession.RefreshTokenHash {
		t.Fatalf("cached session refresh_token_hash = %q, want original cached value", reloadedCached.RefreshTokenHash)
	}
	if reloadedCached.UserAgent != cachedSession.UserAgent {
		t.Fatalf("cached session user_agent = %q, want %q", reloadedCached.UserAgent, cachedSession.UserAgent)
	}
	if !timesEqualPtr(reloadedCached.RefreshRotatedAt, cachedSession.RefreshRotatedAt) {
		t.Fatalf("cached session refresh_rotated_at = %v, want cached value %v", reloadedCached.RefreshRotatedAt, cachedSession.RefreshRotatedAt)
	}

	reloadedFresh, err := h.sessions.ByIDFresh(context.Background(), tokens.SessionID)
	if err != nil {
		t.Fatalf("load fresh session: %v", err)
	}
	if reloadedFresh.RefreshTokenHash != "db-only-refresh-hash" {
