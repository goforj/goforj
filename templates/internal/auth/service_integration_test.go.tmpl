	}
	requestHandler := h.service.RequireAuth()(h.controller.RequestEmailVerification)
	cookies := []*http.Cookie{
		{Name: AccessCookieName, Value: tokens.AccessToken},
		{Name: RefreshCookieName, Value: tokens.RefreshToken},
	}

	requestRec := h.doJSON(http.MethodPost, "/auth/email-verification/request", nil, requestHandler, nil, cookies)
	token, _ := h.decodeJSON(requestRec)["verification_token"].(string)
	if token == "" {
		t.Fatal("expected verification token")
	}

	time.Sleep(40 * time.Millisecond)

	expiredRec := h.doJSON(
		http.MethodPost,
		"/auth/email-verification/confirm",
		map[string]any{"token": token},
		h.controller.VerifyEmail,
		nil,
		nil,
	)
	if expiredRec.Code != http.StatusUnauthorized {
		t.Fatalf("expired verification token status = %d, want %d\nbody:\n%s", expiredRec.Code, http.StatusUnauthorized, expiredRec.Body.String())
	}

	t.Setenv("AUTH_EMAIL_VERIFICATION_TTL", "24h")
	if err := env.Load(); err != nil {
		t.Fatalf("reload env after expiry assertion: %v", err)
	}

	requestRec = h.doJSON(http.MethodPost, "/auth/email-verification/request", nil, requestHandler, nil, cookies)
	token, _ = h.decodeJSON(requestRec)["verification_token"].(string)
	if token == "" {
		t.Fatal("expected second verification token")
	}

	firstUseRec := h.doJSON(
		http.MethodPost,
		"/auth/email-verification/confirm",
		map[string]any{"token": token},
		h.controller.VerifyEmail,
		nil,
		nil,
	)
	if firstUseRec.Code != http.StatusOK {
		t.Fatalf("first verification token use status = %d, want %d\nbody:\n%s", firstUseRec.Code, http.StatusOK, firstUseRec.Body.String())
	}

	reuseRec := h.doJSON(
		http.MethodPost,
		"/auth/email-verification/confirm",
		map[string]any{"token": token},
		h.controller.VerifyEmail,
		nil,
		nil,
	)
	if reuseRec.Code != http.StatusUnauthorized {
		t.Fatalf("reused verification token status = %d, want %d\nbody:\n%s", reuseRec.Code, http.StatusUnauthorized, reuseRec.Body.String())
	}

	reloadedUser, err := h.users.ByID(user.ID)
	if err != nil {
		t.Fatalf("reload verified user: %v", err)
	}
	reloadedUser.EmailVerifiedAt = nil
	reloadedUser.Active = true
	if err := h.users.Save(reloadedUser); err != nil {
		t.Fatalf("reset user email verification: %v", err)
	}
	requestRec = h.doJSON(http.MethodPost, "/auth/email-verification/request", nil, requestHandler, nil, cookies)
	inactiveToken, _ := h.decodeJSON(requestRec)["verification_token"].(string)
	if inactiveToken == "" {
		t.Fatal("expected inactive verification token")
	}
	reloadedUser.Active = false
	if err := h.users.Save(reloadedUser); err != nil {
		t.Fatalf("deactivate user: %v", err)
	}

	inactiveRec := h.doJSON(
		http.MethodPost,
		"/auth/email-verification/confirm",
		map[string]any{"token": inactiveToken},
		h.controller.VerifyEmail,
		nil,
		nil,
	)
	if inactiveRec.Code != http.StatusUnauthorized {
		t.Fatalf("inactive user verification token status = %d, want %d\nbody:\n%s", inactiveRec.Code, http.StatusUnauthorized, inactiveRec.Body.String())
	}
}

