	if userMap, ok := confirmBody["user"].(map[string]any); !ok {
		t.Fatalf("expected user payload in email verification confirm response, got %#v", confirmBody)
	} else if got := userMap["email_verified_at"]; got == nil {
		t.Fatal("expected email_verified_at to be populated after verification")
	}

	reloadedUser, err := h.users.ByID(user.ID)
	if err != nil {
		t.Fatalf("reload verified user: %v", err)
	}
	if reloadedUser.EmailVerifiedAt == nil {
		t.Fatal("expected persisted email_verified_at after verification")
	}
	if _, err := h.verifications.ActiveByTokenHash(hashOpaqueToken(verificationToken), time.Now().UTC()); !errors.Is(err, gorm.ErrRecordNotFound) {
		t.Fatalf("active verification lookup error = %v, want %v", err, gorm.ErrRecordNotFound)
	}
}

