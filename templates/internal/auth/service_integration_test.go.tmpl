func TestAuthenticateWithProviderIntegration(t *testing.T) {
	h := newAuthIntegrationHarness(t)
	provider := fakeOAuthProvider{
		name: "google",
		identity: ProviderIdentity{
			Subject:       "google-subject-6",
			Email:         "alice@example.com",
			EmailVerified: true,
			Username:      "alice",
			DisplayName:   "Alice Example",
		},
	}

	user, identity, tokens, err := h.service.AuthenticateWithProvider(context.Background(), provider, OAuthCallback{
		Code:        "oauth-code",
		State:       "oauth-state",
		RedirectURI: "http://localhost/callback",
	}, "Mozilla/5.0", "127.0.0.1")
	if err != nil {
		t.Fatalf("authenticate with provider: %v", err)
	}
	if user.LastLoginAt == nil || user.LastSeenAt == nil {
		t.Fatal("expected provider auth to record user login activity")
	}
	if identity == nil || identity.LastLoginAt == nil {
		t.Fatalf("identity last_login_at = %#v, want non-nil", identity)
	}
	if tokens.SessionID == "" || tokens.RefreshToken == "" || tokens.AccessToken == "" {
		t.Fatalf("provider tokens = %#v, want populated session tokens", tokens)
	}
	session, err := h.sessions.ByID(context.Background(), tokens.SessionID)
	if err != nil {
		t.Fatalf("load provider session: %v", err)
	}
	if session.UserID != user.ID {
		t.Fatalf("provider session user_id = %d, want %d", session.UserID, user.ID)
	}

	localUser := h.createUser(t, authIntegrationUserInput{
		Username: "bob",
		Email:    "bob@example.com",
		Password: "Secret-pass",
		Active:   true,
	})
	blockedProvider := fakeOAuthProvider{
		name: "github",
		identity: ProviderIdentity{
			Subject:       "github-subject-1",
			Email:         "bob@example.com",
			EmailVerified: true,
			Username:      "bob-gh",
		},
	}
	if _, _, _, err := h.service.AuthenticateWithProvider(context.Background(), blockedProvider, OAuthCallback{}, "ua", "127.0.0.1"); !errors.Is(err, ErrIdentityLinkRequired) {
		t.Fatalf("provider auth same-email auto-link error = %v, want %v", err, ErrIdentityLinkRequired)
	}
	if _, err := h.service.LinkIdentity(context.Background(), localUser.ID, ProviderIdentity{
		Provider:      "github",
		Subject:       "github-subject-1",
		Email:         "bob@example.com",
		EmailVerified: true,
		Username:      "bob-gh",
	}); err != nil {
		t.Fatalf("link provider for existing user: %v", err)
	}
	linkedUser, linkedIdentity, linkedTokens, err := h.service.AuthenticateWithProvider(context.Background(), blockedProvider, OAuthCallback{}, "ua", "127.0.0.1")
	if err != nil {
		t.Fatalf("authenticate linked provider: %v", err)
	}
	if linkedUser.ID != localUser.ID {
		t.Fatalf("linked provider user id = %d, want %d", linkedUser.ID, localUser.ID)
	}
	if linkedIdentity == nil || linkedIdentity.UserID != localUser.ID {
		t.Fatalf("linked provider identity = %#v, want user %d", linkedIdentity, localUser.ID)
	}
	if linkedTokens.SessionID == "" {
		t.Fatal("expected linked provider auth to issue a session")
	}
}
