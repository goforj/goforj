	if err != nil {
		t.Fatalf("load original session: %v", err)
	}
	if originalSession.RefreshRotatedAt != nil {
		t.Fatalf("original session refresh_rotated_at = %v, want nil", originalSession.RefreshRotatedAt)
	}

	time.Sleep(25 * time.Millisecond)

	initialCookies := []*http.Cookie{
		{Name: AccessCookieName, Value: tokens.AccessToken},
		{Name: RefreshCookieName, Value: tokens.RefreshToken},
	}

	firstRefreshRec := h.doJSON(http.MethodPost, "/auth/refresh", nil, h.controller.Refresh, nil, initialCookies)
	if firstRefreshRec.Code != http.StatusOK {
		t.Fatalf("first refresh status = %d, want %d\nbody:\n%s", firstRefreshRec.Code, http.StatusOK, firstRefreshRec.Body.String())
	}
	rotatedSession, err := h.sessions.ByIDFresh(context.Background(), tokens.SessionID)
	if err != nil {
		t.Fatalf("load rotated session: %v", err)
	}
	if rotatedSession.RefreshRotatedAt == nil {
		t.Fatal("expected explicit refresh to set refresh_rotated_at")
	}
		if !timeAtOrAfterStoredPrecision(rotatedSession.RefreshRotatedAt.UTC(), originalSession.CreatedAt.UTC()) {
			t.Fatalf("refresh_rotated_at = %v, want at or after created_at %v at stored precision", rotatedSession.RefreshRotatedAt.UTC(), originalSession.CreatedAt.UTC())
		}

	replayRec := h.doJSON(http.MethodPost, "/auth/refresh", nil, h.controller.Refresh, nil, initialCookies)
	if replayRec.Code != http.StatusUnauthorized {
		t.Fatalf("replayed refresh status = %d, want %d\nbody:\n%s", replayRec.Code, http.StatusUnauthorized, replayRec.Body.String())
	}
	for _, cookie := range replayRec.Result().Cookies() {
