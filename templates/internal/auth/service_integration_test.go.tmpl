func TestControllerLoginMeLogoutIntegration(t *testing.T) {
	h := newAuthIntegrationHarness(t)
	user := h.createUser(t, authIntegrationUserInput{
		Username: "alice",
		Email:    "alice@example.com",
		Password: "Secret-pass",
		Active:   true,
	})

	loginRec := h.doJSON(
		http.MethodPost,
		"/auth/login",
		map[string]any{"login": "alice", "password": "Secret-pass"},
		h.controller.Login,
		nil,
		nil,
	)
	if loginRec.Code != http.StatusOK {
		t.Fatalf("login status = %d, want %d\nbody:\n%s", loginRec.Code, http.StatusOK, loginRec.Body.String())
	}
	if h.cookie(loginRec, AccessCookieName) == nil || h.cookie(loginRec, RefreshCookieName) == nil {
		t.Fatalf("expected auth cookies after login, got %#v", loginRec.Result().Cookies())
	}

	meHandler := h.service.RequireAuth()(h.controller.Me)
	meRec := h.doJSON(http.MethodGet, "/auth/me", nil, meHandler, nil, loginRec.Result().Cookies())
	if meRec.Code != http.StatusOK {
		t.Fatalf("me status = %d, want %d\nbody:\n%s", meRec.Code, http.StatusOK, meRec.Body.String())
	}
	meBody := h.decodeJSON(meRec)
	if userMap, ok := meBody["user"].(map[string]any); !ok {
		t.Fatalf("expected user payload in me response, got %#v", meBody)
	} else if got := userMap["username"]; got != user.Username {
		t.Fatalf("me username = %#v, want %q", got, user.Username)
	} else if got := userMap["avatar_url"]; got != user.AvatarURL {
		t.Fatalf("me avatar_url = %#v, want %q", got, user.AvatarURL)
	} else if got := userMap["timezone"]; got != user.Timezone {
		t.Fatalf("me timezone = %#v, want %q", got, user.Timezone)
	} else if got := userMap["locale"]; got != user.Locale {
		t.Fatalf("me locale = %#v, want %q", got, user.Locale)
	} else if got := userMap["active"]; got != user.Active {
		t.Fatalf("me active = %#v, want %v", got, user.Active)
	} else if got := userMap["last_login_at"]; got == nil {
		t.Fatal("expected me last_login_at to be populated")
	} else if got := userMap["last_seen_at"]; got == nil {
		t.Fatal("expected me last_seen_at to be populated")
	}

	logoutRec := h.doJSON(http.MethodPost, "/auth/logout", nil, h.controller.Logout, nil, loginRec.Result().Cookies())
	if logoutRec.Code != http.StatusOK {
		t.Fatalf("logout status = %d, want %d\nbody:\n%s", logoutRec.Code, http.StatusOK, logoutRec.Body.String())
	}

	logoutCtx, _ := h.newContext(http.MethodPost, "/auth/logout", nil, loginRec.Result().Cookies(), nil)
	sessionID := h.service.sessionIDFromRequest(logoutCtx)
	session, err := h.sessions.ByID(context.Background(), sessionID)
	if err != nil {
		t.Fatalf("load revoked session: %v", err)
	}
	if session.RevokedAt == nil {
		t.Fatal("expected session to be revoked after logout")
	}
}

