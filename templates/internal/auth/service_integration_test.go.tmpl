func TestControllerSessionsListsOnlyCurrentUsersActiveSessionsIntegration(t *testing.T) {
	h := newAuthIntegrationHarness(t)
	alice := h.createUser(t, authIntegrationUserInput{
		Username: "alice",
		Email:    "alice@example.com",
		Password: "Secret-pass",
