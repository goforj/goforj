type sharedAuthIntegrationContainer struct {
	container testcontainers.Container
	host      string
	port      string
	stop      func()
}

var (
	sharedAuthMySQLOnce      sync.Once
	sharedAuthMySQL          *sharedAuthIntegrationContainer
	sharedAuthMySQLErr       error
	sharedAuthPostgresOnce   sync.Once
	sharedAuthPostgres       *sharedAuthIntegrationContainer
	sharedAuthPostgresErr    error
)

func TestMain(m *testing.M) {
	code := m.Run()
	stopSharedAuthIntegrationContainers()
	os.Exit(code)
}

func stopSharedAuthIntegrationContainers() {
	if sharedAuthMySQL != nil && sharedAuthMySQL.stop != nil {
		sharedAuthMySQL.stop()
		sharedAuthMySQL = nil
	}
	if sharedAuthPostgres != nil && sharedAuthPostgres.stop != nil {
		sharedAuthPostgres.stop()
		sharedAuthPostgres = nil
	}
}

func waitForContainerExecSuccess(container testcontainers.Container, cmd []string, timeout time.Duration) error {
	deadline := time.Now().Add(timeout)
	var lastErr error
	for time.Now().Before(deadline) {
		exitCode, output, err := container.Exec(context.Background(), cmd)
		if err != nil {
			lastErr = err
			time.Sleep(500 * time.Millisecond)
			continue
		}
		if exitCode == 0 {
			if output != nil {
				_, _ = io.Copy(io.Discard, output)
			}
			return nil
		}
		body := ""
		if output != nil {
			data, _ := io.ReadAll(output)
			body = strings.TrimSpace(string(data))
		}
		if body == "" {
			body = fmt.Sprintf("exit code %d", exitCode)
		}
		lastErr = fmt.Errorf("%s", body)
		time.Sleep(500 * time.Millisecond)
	}
	if lastErr != nil {
		return lastErr
	}
	return fmt.Errorf("container command did not succeed before timeout")
}

func waitForTCPReadyAddress(host, port string, timeout time.Duration) error {
	deadline := time.Now().Add(timeout)
	address := net.JoinHostPort(host, port)
	var lastErr error
	for time.Now().Before(deadline) {
		conn, err := net.DialTimeout("tcp", address, 2*time.Second)
		if err == nil {
			_ = conn.Close()
			return nil
		}
		lastErr = err
		time.Sleep(500 * time.Millisecond)
	}
	if lastErr != nil {
		return fmt.Errorf("tcp endpoint %s not ready: %w", address, lastErr)
	}
	return fmt.Errorf("tcp endpoint %s not ready", address)
}

func waitForDefaultDatabaseReady(timeout time.Duration) error {
	deadline := time.Now().Add(timeout)
	var lastErr error
	for time.Now().Before(deadline) {
		conns := database.NewConnections({{- if .Components.Metrics }}metrics.NewManager(), {{- end }}nil)
		db, err := conns.Default()
		if err == nil {
			sqlDB, sqlErr := db.DB()
			if sqlErr == nil {
				pingCtx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
				pingErr := sqlDB.PingContext(pingCtx)
				cancel()
				if pingErr == nil {
					_ = conns.Close(context.Background())
					return nil
				}
				lastErr = pingErr
			} else {
				lastErr = sqlErr
			}
		} else {
			lastErr = err
		}
		_ = conns.Close(context.Background())
		time.Sleep(500 * time.Millisecond)
	}
	if lastErr != nil {
		return lastErr
	}
	return fmt.Errorf("database connection did not succeed before timeout")
}

func ensureSharedMySQLAuthIntegrationContainer(t *testing.T) *sharedAuthIntegrationContainer {
	t.Helper()

	sharedAuthMySQLOnce.Do(func() {
		ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
		container, err := testcontainers.GenericContainer(ctx, testcontainers.GenericContainerRequest{
			ContainerRequest: testcontainers.ContainerRequest{
				Image:        "mysql:8.4",
				ExposedPorts: []string{"3306/tcp"},
				Env: map[string]string{
					"MYSQL_DATABASE":      "app",
					"MYSQL_USER":          "app",
					"MYSQL_PASSWORD":      "secret",
					"MYSQL_ROOT_HOST":     "%",
					"MYSQL_ROOT_PASSWORD": "rootsecret",
				},
				WaitingFor: wait.ForLog("ready for connections").WithStartupTimeout(90 * time.Second),
			},
			Started: true,
		})
		if err != nil {
			cancel()
			sharedAuthMySQLErr = fmt.Errorf("start shared mysql testcontainer: %w", err)
			return
		}
		host, err := container.Host(ctx)
		if err != nil {
			_ = container.Terminate(context.Background())
			cancel()
			sharedAuthMySQLErr = fmt.Errorf("shared mysql host: %w", err)
			return
		}
		port, err := container.MappedPort(ctx, "3306/tcp")
		if err != nil {
			_ = container.Terminate(context.Background())
			cancel()
			sharedAuthMySQLErr = fmt.Errorf("shared mysql port: %w", err)
			return
		}
		if err := waitForTCPReadyAddress(host, port.Port(), 60*time.Second); err != nil {
			_ = container.Terminate(context.Background())
			cancel()
			sharedAuthMySQLErr = fmt.Errorf("wait for shared mysql tcp readiness: %w", err)
			return
		}
		if err := waitForContainerExecSuccess(
			container,
			[]string{
				"sh", "-lc",
				`mysql -h 127.0.0.1 -u"$MYSQL_USER" -p"$MYSQL_PASSWORD" "$MYSQL_DATABASE" -e 'SELECT 1'`,
			},
			60*time.Second,
		); err != nil {
			_ = container.Terminate(context.Background())
			cancel()
			sharedAuthMySQLErr = fmt.Errorf("wait for shared mysql authenticated readiness: %w", err)
			return
		}
		sharedAuthMySQL = &sharedAuthIntegrationContainer{
			container: container,
			host:      host,
			port:      port.Port(),
			stop: func() {
				_ = container.Terminate(context.Background())
				cancel()
			},
		}
	})
	if sharedAuthMySQLErr != nil {
		t.Fatal(sharedAuthMySQLErr)
	}
	return sharedAuthMySQL
}

