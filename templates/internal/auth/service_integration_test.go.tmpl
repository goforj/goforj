func TestAuthenticateByUsernameAndEmailIntegration(t *testing.T) {
	h := newAuthIntegrationHarness(t)
	user := h.createUser(t, authIntegrationUserInput{
		Username:        "alice",
		Email:           "alice@example.com",
		DisplayName:     "Alice Example",
		AvatarURL:       "https://cdn.example.com/alice.png",
		Password:        "secret-pass",
		Active:          true,
		Timezone:        "America/New_York",
		Locale:          "en-US",
		EmailVerifiedAt: ptrTime(time.Date(2026, 4, 8, 12, 0, 0, 0, time.UTC)),
	})

	authenticated, tokens, err := h.service.Authenticate("alice", "secret-pass", "ua-one", "127.0.0.1")
	if err != nil {
		t.Fatalf("authenticate by username: %v", err)
	}
	if authenticated.ID != user.ID {
		t.Fatalf("authenticated user id = %d, want %d", authenticated.ID, user.ID)
	}
	if authenticated.DisplayName != "Alice Example" {
		t.Fatalf("authenticated display_name = %q, want %q", authenticated.DisplayName, "Alice Example")
	}
	if authenticated.AvatarURL != "https://cdn.example.com/alice.png" {
		t.Fatalf("authenticated avatar_url = %q, want %q", authenticated.AvatarURL, "https://cdn.example.com/alice.png")
	}
	if authenticated.Timezone != "America/New_York" {
		t.Fatalf("authenticated timezone = %q, want %q", authenticated.Timezone, "America/New_York")
	}
	if authenticated.Locale != "en-US" {
		t.Fatalf("authenticated locale = %q, want %q", authenticated.Locale, "en-US")
	}
	if authenticated.EmailVerifiedAt == nil {
		t.Fatal("expected authenticated email_verified_at to be set")
	}
	if authenticated.LastLoginAt == nil {
		t.Fatal("expected authenticated last_login_at to be set")
	}
	if authenticated.LastSeenAt == nil {
		t.Fatal("expected authenticated last_seen_at to be set")
	}
	if tokens.AccessToken == "" || tokens.RefreshToken == "" || tokens.SessionID == "" {
		t.Fatalf("expected non-empty session tokens, got %#v", tokens)
	}

	session, err := h.sessions.ByID(tokens.SessionID)
	if err != nil {
		t.Fatalf("load created session: %v", err)
	}
	if session.UserAgent != "ua-one" {
		t.Fatalf("session user agent = %q, want %q", session.UserAgent, "ua-one")
	}
	if session.IPAddress != "127.0.0.1" {
		t.Fatalf("session ip = %q, want %q", session.IPAddress, "127.0.0.1")
	}

	reloadedUser, err := h.users.ByID(user.ID)
	if err != nil {
		t.Fatalf("reload user after login: %v", err)
	}
	if reloadedUser.LastLoginAt == nil {
		t.Fatal("expected persisted user last_login_at after login")
	}
	if reloadedUser.LastSeenAt == nil {
		t.Fatal("expected persisted user last_seen_at after login")
	}

	byEmail, _, err := h.service.Authenticate("alice@example.com", "secret-pass", "ua-two", "127.0.0.2")
	if err != nil {
		t.Fatalf("authenticate by email: %v", err)
	}
	if byEmail.ID != user.ID {
		t.Fatalf("email-authenticated user id = %d, want %d", byEmail.ID, user.ID)
	}
}

