	})
	bob := h.createUser(t, authIntegrationUserInput{
		Username: "bob",
		Email:    "bob@example.com",
		Password: "Secret-pass",
		Active:   true,
	})

	_, aliceCurrent, err := h.service.Authenticate(context.Background(), AuthenticateInput{
		Login:     alice.Username,
		Password:  "Secret-pass",
		UserAgent: "Mozilla/5.0 (Macintosh; Intel Mac OS X 14_4) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.4 Safari/605.1.15",
		IPAddress: "127.0.0.10",
	})
	if err != nil {
		t.Fatalf("authenticate alice current session: %v", err)
	}
	_, aliceOther, err := h.service.Authenticate(context.Background(), AuthenticateInput{Login: alice.Username, Password: "Secret-pass", UserAgent: "ua-other", IPAddress: "127.0.0.11"})
	if err != nil {
		t.Fatalf("authenticate alice other session: %v", err)
	}
	_, bobTokens, err := h.service.Authenticate(context.Background(), AuthenticateInput{Login: bob.Username, Password: "Secret-pass", UserAgent: "ua-bob", IPAddress: "127.0.0.12"})
	if err != nil {
		t.Fatalf("authenticate bob session: %v", err)
	}
	if err := h.sessions.Revoke(context.Background(), aliceOther.SessionID, time.Now().UTC()); err != nil {
		t.Fatalf("revoke alice other session: %v", err)
	}

	sessionsHandler := h.service.RequireAuth()(h.controller.Sessions)
	rec := h.doJSON(
		http.MethodGet,
		"/auth/sessions",
		nil,
		sessionsHandler,
		nil,
		[]*http.Cookie{
			{Name: AccessCookieName, Value: aliceCurrent.AccessToken},
			{Name: RefreshCookieName, Value: aliceCurrent.RefreshToken},
		},
	)
	if rec.Code != http.StatusOK {
		t.Fatalf("sessions status = %d, want %d\nbody:\n%s", rec.Code, http.StatusOK, rec.Body.String())
	}

	body := h.decodeJSON(rec)
	rawSessions, ok := body["sessions"].([]any)
	if !ok {
		t.Fatalf("expected sessions array, got %#v", body)
	}
	if len(rawSessions) != 1 {
		t.Fatalf("sessions length = %d, want %d", len(rawSessions), 1)
	}

	sessionMap, ok := rawSessions[0].(map[string]any)
	if !ok {
		t.Fatalf("expected session object, got %#v", rawSessions[0])
	}
	if got := sessionMap["id"]; got != aliceCurrent.SessionID {
		t.Fatalf("session id = %#v, want %q", got, aliceCurrent.SessionID)
	}
	if got := sessionMap["current"]; got != true {
		t.Fatalf("session current = %#v, want true", got)
	}
	if got := sessionMap["user_agent"]; got != "Mozilla/5.0 (Macintosh; Intel Mac OS X 14_4) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.4 Safari/605.1.15" {
		t.Fatalf("session user_agent = %#v, want safari ua", got)
	}
	if got := sessionMap["device_label"]; got != "Mac · Safari" {
		t.Fatalf("session device_label = %#v, want %q", got, "Mac · Safari")
	}
	if got := sessionMap["ip_address"]; got != "127.0.0.10" {
		t.Fatalf("session ip_address = %#v, want %q", got, "127.0.0.10")
	}
	if got := sessionMap["created_at"]; got == nil {
		t.Fatal("expected session created_at to be populated")
	}
	if got := sessionMap["expires_at"]; got == nil {
		t.Fatal("expected session expires_at to be populated")
	}

	if _, err := h.sessions.ByID(context.Background(), bobTokens.SessionID); err != nil {
		t.Fatalf("expected bob session to remain present: %v", err)
	}
}

func TestControllerPasswordResetRequestAndConfirmIntegration(t *testing.T) {
	h := newAuthIntegrationHarness(t)
	user := h.createUser(t, authIntegrationUserInput{
		Username: "alice",
		Email:    "alice@example.com",
		Password: "Secret-pass",
		Active:   true,
	})

	_, existingTokens, err := h.service.Authenticate(context.Background(), AuthenticateInput{Login: user.Username, Password: "Secret-pass", UserAgent: "ua-current", IPAddress: "127.0.0.40"})
	if err != nil {
		t.Fatalf("authenticate current session: %v", err)
	}
	if _, err := h.sessions.ByID(context.Background(), existingTokens.SessionID); err != nil {
		t.Fatalf("prime existing session cache: %v", err)
	}

	requestRec := h.doJSON(
		http.MethodPost,
		"/auth/password-reset/request",
		map[string]any{"login": "alice"},
		h.controller.RequestPasswordReset,
		nil,
		nil,
	)
	if requestRec.Code != http.StatusOK {
		t.Fatalf("password reset request status = %d, want %d\nbody:\n%s", requestRec.Code, http.StatusOK, requestRec.Body.String())
	}
	requestBody := h.decodeJSON(requestRec)
	resetToken, _ := requestBody["reset_token"].(string)
	if resetToken == "" {
		t.Fatalf("expected reset_token in local password reset request, got %#v", requestBody)
	}

	confirmRec := h.doJSON(
		http.MethodPost,
		"/auth/password-reset/confirm",
		map[string]any{"token": resetToken, "new_password": "Better-secret"},
		h.controller.ResetPassword,
		nil,
		nil,
	)
	if confirmRec.Code != http.StatusOK {
		t.Fatalf("password reset confirm status = %d, want %d\nbody:\n%s", confirmRec.Code, http.StatusOK, confirmRec.Body.String())
	}

	if _, _, err := h.service.Authenticate(context.Background(), AuthenticateInput{Login: user.Username, Password: "Secret-pass", UserAgent: "ua-old", IPAddress: "127.0.0.41"}); !errors.Is(err, ErrInvalidCredentials) {
		t.Fatalf("authenticate old password after reset error = %v, want %v", err, ErrInvalidCredentials)
	}
	if _, _, err := h.service.Authenticate(context.Background(), AuthenticateInput{Login: user.Username, Password: "Better-secret", UserAgent: "ua-new", IPAddress: "127.0.0.42"}); err != nil {
		t.Fatalf("authenticate new password after reset: %v", err)
	}

	existingSession, err := h.sessions.ByID(context.Background(), existingTokens.SessionID)
	if err != nil {
		t.Fatalf("load existing session after password reset: %v", err)
	}
	if existingSession.RevokedAt == nil {
		t.Fatal("expected password reset to revoke existing sessions")
	}

	if _, err := h.resets.ActiveByTokenHash(hashOpaqueToken(resetToken), time.Now().UTC()); !errors.Is(err, gorm.ErrRecordNotFound) {
		t.Fatalf("active reset lookup error = %v, want %v", err, gorm.ErrRecordNotFound)
	}
}

