func TestControllerEmailVerificationRejectsExpiredReusedAndInactiveTokensIntegration(t *testing.T) {
	h := newAuthIntegrationHarness(t)
	t.Setenv("AUTH_EMAIL_VERIFICATION_TTL", "25ms")
	if err := env.Load(); err != nil {
		t.Fatalf("reload env: %v", err)
	}
	user := h.createUser(t, authIntegrationUserInput{
		Username: "alice",
		Email:    "alice@example.com",
		Password: "secret-pass",
		Active:   true,
	})
	_, tokens, err := h.service.Authenticate(user.Username, "secret-pass", "ua-current", "127.0.0.45")
