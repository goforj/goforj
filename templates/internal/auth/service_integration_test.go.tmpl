func TestRequireAuthSkipsLastSeenWriteWhenFreshIntegration(t *testing.T) {
	h := newAuthIntegrationHarness(t)
	user := h.createUser(t, authIntegrationUserInput{
		Username: "alice",
		Email:    "alice@example.com",
		Password: "Secret-pass",
		Active:   true,
	})

	_, tokens, err := h.service.Authenticate(context.Background(), AuthenticateInput{Login: user.Username, Password: "Secret-pass", UserAgent: "ua-one", IPAddress: "127.0.0.1"})
	if err != nil {
		t.Fatalf("authenticate: %v", err)
	}

	originalSession, err := h.sessions.ByIDFresh(context.Background(), tokens.SessionID)
	if err != nil {
		t.Fatalf("load original session: %v", err)
	}
	originalUser, err := h.users.ByIDFresh(context.Background(), user.ID)
	if err != nil {
		t.Fatalf("load original user: %v", err)
	}
	if originalSession.LastSeenAt == nil || originalUser.LastSeenAt == nil {
		t.Fatal("expected last_seen_at to be set after login")
	}

	handler := h.service.RequireAuth()(func(r web.Context) error {
		return r.JSON(http.StatusOK, map[string]any{"ok": true})
	})
	rec := h.doJSON(
		http.MethodGet,
		"/hello",
		nil,
		handler,
		nil,
		[]*http.Cookie{
			{Name: AccessCookieName, Value: tokens.AccessToken},
			{Name: RefreshCookieName, Value: tokens.RefreshToken},
		},
	)
	if rec.Code != http.StatusOK {
		t.Fatalf("fresh access auth status = %d, want %d\nbody:\n%s", rec.Code, http.StatusOK, rec.Body.String())
	}

	reloadedSession, err := h.sessions.ByIDFresh(context.Background(), tokens.SessionID)
	if err != nil {
		t.Fatalf("reload session: %v", err)
	}
	reloadedUser, err := h.users.ByIDFresh(context.Background(), user.ID)
	if err != nil {
		t.Fatalf("reload user: %v", err)
	}
	if reloadedSession.LastSeenAt == nil || reloadedUser.LastSeenAt == nil {
		t.Fatal("expected reloaded last_seen_at values")
	}
	if !timesEqualAtStoredPrecision(reloadedSession.LastSeenAt.UTC(), originalSession.LastSeenAt.UTC()) {
		t.Fatalf("session last_seen_at changed for fresh request: got %v want %v", reloadedSession.LastSeenAt, originalSession.LastSeenAt)
	}
	if !timesEqualAtStoredPrecision(reloadedUser.LastSeenAt.UTC(), originalUser.LastSeenAt.UTC()) {
		t.Fatalf("user last_seen_at changed for fresh request: got %v want %v", reloadedUser.LastSeenAt, originalUser.LastSeenAt)
	}
}

func TestRequireAuthUsesCachedSessionForFreshAccessIntegration(t *testing.T) {
	h := newAuthIntegrationHarness(t)
	user := h.createUser(t, authIntegrationUserInput{
		Username: "alice",
		Email:    "alice@example.com",
		Password: "Secret-pass",
		Active:   true,
	})

	_, tokens, err := h.service.Authenticate(context.Background(), AuthenticateInput{Login: user.Username, Password: "Secret-pass", UserAgent: "ua-one", IPAddress: "127.0.0.1"})
	if err != nil {
		t.Fatalf("authenticate: %v", err)
	}

	// Prime both repo caches before mutating the backing rows.
	cachedSession, err := h.sessions.ByID(context.Background(), tokens.SessionID)
	if err != nil {
		t.Fatalf("prime session cache: %v", err)
	}

	db, err := h.conns.Default()
	if err != nil {
		t.Fatalf("default db: %v", err)
	}
	expiredAt := time.Now().UTC().Add(-time.Hour)
	if err := db.Exec(
		"UPDATE auth_sessions SET revoked_at = ?, expires_at = ? WHERE id = ?",
		expiredAt,
		expiredAt,
		tokens.SessionID,
	).Error; err != nil {
		t.Fatalf("expire session row: %v", err)
	}

	handler := h.service.RequireAuth()(func(r web.Context) error {
		current := CurrentUser(r)
		if current == nil {
			t.Fatal("expected current user in auth middleware")
		}
		return r.JSON(http.StatusOK, map[string]any{
			"ok":       true,
			"username": current.Username,
		})
	})
	rec := h.doJSON(
		http.MethodGet,
		"/hello",
		nil,
		handler,
		nil,
		[]*http.Cookie{
			{Name: AccessCookieName, Value: tokens.AccessToken},
			{Name: RefreshCookieName, Value: tokens.RefreshToken},
		},
	)
	if rec.Code != http.StatusOK {
		t.Fatalf("cached access auth status = %d, want %d\nbody:\n%s", rec.Code, http.StatusOK, rec.Body.String())
	}

	reloadedSession, err := h.sessions.ByID(context.Background(), tokens.SessionID)
	if err != nil {
		t.Fatalf("reload cached session: %v", err)
	}
	if reloadedSession.RevokedAt != nil {
		t.Fatalf("cached session unexpectedly reflected db mutation: got revoked_at %v", reloadedSession.RevokedAt)
	}
	if !reloadedSession.ExpiresAt.Equal(cachedSession.ExpiresAt) {
		t.Fatalf("cached session expires_at = %v, want %v", reloadedSession.ExpiresAt, cachedSession.ExpiresAt)
	}
}

func TestRequireAuthPersistsLastSeenWhenStaleIntegration(t *testing.T) {
	h := newAuthIntegrationHarness(t)
	user := h.createUser(t, authIntegrationUserInput{
		Username: "alice",
		Email:    "alice@example.com",
		Password: "Secret-pass",
		Active:   true,
	})

	_, tokens, err := h.service.Authenticate(context.Background(), AuthenticateInput{Login: user.Username, Password: "Secret-pass", UserAgent: "ua-one", IPAddress: "127.0.0.1"})
	if err != nil {
		t.Fatalf("authenticate: %v", err)
	}

	staleSeenAt := time.Now().UTC().Add(-(lastSeenWriteInterval + time.Minute))
	session, err := h.sessions.ByID(context.Background(), tokens.SessionID)
	if err != nil {
		t.Fatalf("load session: %v", err)
	}
	session.LastSeenAt = &staleSeenAt
	if err := h.sessions.Save(context.Background(), session); err != nil {
		t.Fatalf("persist stale session: %v", err)
	}

	reloadedUser, err := h.users.ByID(context.Background(), user.ID)
	if err != nil {
		t.Fatalf("load user: %v", err)
	}
	reloadedUser.LastSeenAt = &staleSeenAt
	if err := h.users.Save(context.Background(), reloadedUser); err != nil {
		t.Fatalf("persist stale user: %v", err)
	}

	handler := h.service.RequireAuth()(func(r web.Context) error {
		return r.JSON(http.StatusOK, map[string]any{"ok": true})
	})
	before := time.Now().UTC()
	rec := h.doJSON(
		http.MethodGet,
		"/hello",
		nil,
		handler,
		nil,
		[]*http.Cookie{
			{Name: AccessCookieName, Value: tokens.AccessToken},
			{Name: RefreshCookieName, Value: tokens.RefreshToken},
		},
	)
	if rec.Code != http.StatusOK {
		t.Fatalf("stale access auth status = %d, want %d\nbody:\n%s", rec.Code, http.StatusOK, rec.Body.String())
	}

	updatedSession, err := h.sessions.ByIDFresh(context.Background(), tokens.SessionID)
	if err != nil {
		t.Fatalf("reload updated session: %v", err)
	}
	updatedUser, err := h.users.ByIDFresh(context.Background(), user.ID)
	if err != nil {
		t.Fatalf("reload updated user: %v", err)
	}
	if updatedSession.LastSeenAt == nil || updatedUser.LastSeenAt == nil {
		t.Fatal("expected updated last_seen_at values")
	}
	lowerBound := before.Add(-time.Second)
	if !updatedSession.LastSeenAt.After(staleSeenAt) || updatedSession.LastSeenAt.Before(lowerBound) {
		t.Fatalf("session last_seen_at = %v, want refreshed after %v and near %v", updatedSession.LastSeenAt, staleSeenAt, before)
	}
	if !updatedUser.LastSeenAt.After(staleSeenAt) || updatedUser.LastSeenAt.Before(lowerBound) {
		t.Fatalf("user last_seen_at = %v, want refreshed after %v and near %v", updatedUser.LastSeenAt, staleSeenAt, before)
	}
}

