		t.Fatalf("authenticate other session: %v", err)
	}
	if _, err := h.sessions.ByID(context.Background(), currentTokens.SessionID); err != nil {
		t.Fatalf("prime current session cache: %v", err)
	}
	if _, err := h.sessions.ByID(context.Background(), otherTokens.SessionID); err != nil {
		t.Fatalf("prime other session cache: %v", err)
	}

	changePasswordHandler := h.service.RequireAuth()(h.controller.ChangePassword)
	rec := h.doJSON(
		http.MethodPost,
		"/auth/change-password",
		map[string]any{
			"current_password": "Secret-pass",
			"new_password":     "new-Secret-pass",
		},
		changePasswordHandler,
		nil,
		[]*http.Cookie{
			{Name: AccessCookieName, Value: currentTokens.AccessToken},
			{Name: RefreshCookieName, Value: currentTokens.RefreshToken},
		},
