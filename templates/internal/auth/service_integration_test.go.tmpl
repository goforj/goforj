func TestFindOrCreateUserFromProviderIdentityCreatesProviderUserIntegration(t *testing.T) {
	h := newAuthIntegrationHarness(t)

	user, identity, created, err := h.service.FindOrCreateUserFromProviderIdentity(ProviderIdentity{
		Provider:      "google",
		Subject:       "google-subject-1",
		Email:         "alice@example.com",
		EmailVerified: true,
		Username:      "alice",
		DisplayName:   "Alice Example",
		AvatarURL:     "https://example.com/alice.png",
	})
	if err != nil {
		t.Fatalf("find or create user from provider identity: %v", err)
	}
	if !created {
		t.Fatal("expected provider identity to create a new user")
	}
	if user.PasswordHash != invalidPasswordHash {
		t.Fatal("expected provider-created user to have an unusable local password hash")
	}
	if user.EmailVerifiedAt == nil {
		t.Fatal("expected provider-created verified email to set email_verified_at")
	}
	if identity.UserID != user.ID {
		t.Fatalf("identity user_id = %d, want %d", identity.UserID, user.ID)
	}
	if identity.Provider != "google" || identity.ProviderSubject != "google-subject-1" {
		t.Fatalf("identity linkage = %s/%s, want google/google-subject-1", identity.Provider, identity.ProviderSubject)
	}
	if _, _, err := h.service.Authenticate("alice@example.com", "secret-pass", "ua", "127.0.0.1"); !errors.Is(err, ErrInvalidCredentials) {
		t.Fatalf("provider-only local password authenticate error = %v, want %v", err, ErrInvalidCredentials)
	}
	identities, err := h.service.Identities(user.ID)
	if err != nil {
		t.Fatalf("list identities: %v", err)
	}
	if len(identities) != 1 {
		t.Fatalf("identities length = %d, want %d", len(identities), 1)
	}
}

func TestFindOrCreateUserFromProviderIdentityRequiresExplicitLinkIntegration(t *testing.T) {
	h := newAuthIntegrationHarness(t)
	user := h.createUser(t, authIntegrationUserInput{
		Username: "alice",
		Email:    "alice@example.com",
		Password: "secret-pass",
		Active:   true,
	})

	matchedUser, identity, created, err := h.service.FindOrCreateUserFromProviderIdentity(ProviderIdentity{
		Provider:      "google",
		Subject:       "google-subject-2",
		Email:         "alice@example.com",
		EmailVerified: true,
	})
	if !errors.Is(err, ErrIdentityLinkRequired) {
		t.Fatalf("find or create same-email provider identity error = %v, want %v", err, ErrIdentityLinkRequired)
	}
	if matchedUser == nil || matchedUser.ID != user.ID {
		t.Fatalf("matched user = %#v, want existing user %d", matchedUser, user.ID)
	}
	if identity != nil {
		t.Fatalf("identity = %#v, want nil", identity)
	}
	if created {
		t.Fatal("expected no user creation when link is required")
	}
}

func TestFindOrCreateUserFromProviderIdentityReusesExistingIdentityIntegration(t *testing.T) {
	h := newAuthIntegrationHarness(t)

	user, identity, created, err := h.service.FindOrCreateUserFromProviderIdentity(ProviderIdentity{
		Provider:    "google",
		Subject:     "google-subject-reuse",
		Username:    "alice",
		DisplayName: "Alice One",
	})
	if err != nil {
		t.Fatalf("create provider identity user: %v", err)
	}
	if !created {
		t.Fatal("expected first provider identity to create a user")
	}

	reusedUser, reusedIdentity, reusedCreated, err := h.service.FindOrCreateUserFromProviderIdentity(ProviderIdentity{
		Provider:    "google",
		Subject:     "google-subject-reuse",
		Username:    "alice-updated",
		DisplayName: "Alice Two",
		AvatarURL:   "https://example.com/alice-two.png",
	})
	if err != nil {
		t.Fatalf("reuse provider identity: %v", err)
	}
	if reusedCreated {
		t.Fatal("expected existing provider identity to be reused")
	}
	if reusedUser.ID != user.ID {
		t.Fatalf("reused user id = %d, want %d", reusedUser.ID, user.ID)
	}
	if reusedIdentity.ID != identity.ID {
		t.Fatalf("reused identity id = %d, want %d", reusedIdentity.ID, identity.ID)
	}
	reloadedIdentity, err := h.identities.ByProviderSubject("google", "google-subject-reuse")
	if err != nil {
		t.Fatalf("reload reused identity: %v", err)
	}
	if reloadedIdentity.ProviderDisplayName != "Alice Two" {
		t.Fatalf("reloaded identity display name = %q, want %q", reloadedIdentity.ProviderDisplayName, "Alice Two")
	}
	if reloadedIdentity.ProviderAvatarURL != "https://example.com/alice-two.png" {
		t.Fatalf("reloaded identity avatar = %q, want %q", reloadedIdentity.ProviderAvatarURL, "https://example.com/alice-two.png")
	}
}

func TestLinkIdentityIntegration(t *testing.T) {
	h := newAuthIntegrationHarness(t)
	user := h.createUser(t, authIntegrationUserInput{
		Username: "alice",
		Email:    "alice@example.com",
		Password: "secret-pass",
		Active:   true,
	})

	identity, err := h.service.LinkIdentity(user.ID, ProviderIdentity{
		Provider:      "google",
		Subject:       "google-subject-3",
		Email:         "alice@example.com",
		EmailVerified: true,
		Username:      "alice-google",
		DisplayName:   "Alice Example",
		AvatarURL:     "https://example.com/alice-google.png",
	})
	if err != nil {
		t.Fatalf("link identity: %v", err)
	}
	if identity.UserID != user.ID {
		t.Fatalf("identity user_id = %d, want %d", identity.UserID, user.ID)
	}
	reloadedUser, err := h.users.ByID(user.ID)
	if err != nil {
		t.Fatalf("reload linked user: %v", err)
	}
	if reloadedUser.EmailVerifiedAt == nil {
		t.Fatal("expected verified provider email to mark the user verified when emails match")
	}
	identities, err := h.service.Identities(user.ID)
	if err != nil {
		t.Fatalf("list linked identities: %v", err)
	}
	if len(identities) != 1 {
		t.Fatalf("identities length = %d, want %d", len(identities), 1)
	}
	if identities[0].ProviderDisplayName != "Alice Example" {
		t.Fatalf("identity display name = %q, want %q", identities[0].ProviderDisplayName, "Alice Example")
	}
}

