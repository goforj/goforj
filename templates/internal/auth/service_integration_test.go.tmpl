func TestEnsureBootstrapUserCreatesLocalAdminIntegration(t *testing.T) {
	h := newAuthIntegrationHarness(t)

	t.Setenv("AUTH_BOOTSTRAP_USERNAME", "admin")
	t.Setenv("AUTH_BOOTSTRAP_PASSWORD", "admin")
	t.Setenv("AUTH_BOOTSTRAP_EMAIL", "admin@example.com")
	created, err := h.service.EnsureBootstrapUserFromEnv()
	if err != nil {
		t.Fatalf("ensure bootstrap user: %v", err)
	}
	if !created {
		t.Fatal("expected bootstrap user to be created")
	}

	user, err := h.users.ByLogin("admin")
	if err != nil {
		t.Fatalf("find bootstrap user: %v", err)
	}
	if user.Email != "admin@example.com" {
		t.Fatalf("bootstrap user email = %q, want %q", user.Email, "admin@example.com")
	}
	if !user.Active {
		t.Fatal("expected bootstrap user to be active")
	}
	if user.DisplayName != "Administrator" {
		t.Fatalf("bootstrap user display_name = %q, want %q", user.DisplayName, "Administrator")
	}
	if user.AvatarURL != "" {
		t.Fatalf("bootstrap user avatar_url = %q, want empty", user.AvatarURL)
	}
	if user.Timezone != "" {
		t.Fatalf("bootstrap user timezone = %q, want empty", user.Timezone)
	}
	if user.Locale != "" {
		t.Fatalf("bootstrap user locale = %q, want empty", user.Locale)
	}
	if user.LastLoginAt != nil {
		t.Fatalf("bootstrap user last_login_at = %v, want nil", user.LastLoginAt)
	}
	if user.LastSeenAt != nil {
		t.Fatalf("bootstrap user last_seen_at = %v, want nil", user.LastSeenAt)
	}

	createdAgain, err := h.service.EnsureBootstrapUserFromEnv()
	if err != nil {
		t.Fatalf("ensure bootstrap user again: %v", err)
	}
	if createdAgain {
		t.Fatal("expected second bootstrap run to no-op")
	}
}

func TestEnsureBootstrapUserNoOpsBeforeMigrationsIntegration(t *testing.T) {
	t.Setenv("APP_ENV", "local")
	t.Setenv("AUTH_BOOTSTRAP_USERNAME", "admin")
	t.Setenv("AUTH_BOOTSTRAP_PASSWORD", "admin")
	t.Setenv("AUTH_BOOTSTRAP_EMAIL", "admin@example.com")
	provisionAuthIntegrationDatabase(t)
	if err := env.Load(); err != nil {
		t.Fatalf("load env: %v", err)
	}

	conns := database.NewConnections({{- if .Components.Metrics }}metrics.NewManager(), {{- end }}nil)
	t.Cleanup(func() {
		_ = conns.Close(context.Background())
	})
	db, err := conns.Default()
	if err != nil {
		t.Fatalf("default db: %v", err)
	}
	for _, statement := range []string{
		"DROP TABLE IF EXISTS auth_sessions",
		{{- if .Components.OAuth }}
		"DROP TABLE IF EXISTS auth_oauth_states",
		"DROP TABLE IF EXISTS auth_identities",
		{{- end }}
		"DROP TABLE IF EXISTS auth_email_verifications",
		"DROP TABLE IF EXISTS auth_password_resets",
		"DROP TABLE IF EXISTS auth_login_attempts",
		"DROP TABLE IF EXISTS users",
		"DROP TABLE IF EXISTS migrations",
	} {
		if err := db.Exec(statement).Error; err != nil {
			t.Fatalf("reset pre-migration auth schema with %q: %v", statement, err)
		}
	}
	cacheManager, err := caches.NewManager()
	if err != nil {
		t.Fatalf("new cache manager: %v", err)
	}
	sessionCache := cacheManager.Sessions()

	service := NewService(
		NewUserRepo(conns, sessionCache),
		NewAuthSessionRepo(conns, sessionCache),
		{{- if .Components.OAuth }}
		NewAuthIdentityRepo(conns),
		NewOAuthStateRepo(conns),
		NewOAuthProviders(),
		{{- end }}
		NewEmailVerificationRepo(conns),
		NewPasswordResetRepo(conns),
		NewLoginAttemptRepo(conns),
		NewLogDelivery(logger.NewSilentLogger()),
		logger.NewSilentLogger(),
		{{- if .Components.Metrics }}
		metrics.NewManager(),
		{{- end }}
	)
	created, err := service.EnsureBootstrapUserFromEnv()
	if err != nil {
		t.Fatalf("ensure bootstrap user without migrations: %v", err)
	}
	if created {
		t.Fatal("expected bootstrap user creation to no-op before migrations")
	}
}

