func TestRequireAuthRefreshesExpiredAccessTokenIntegration(t *testing.T) {
	t.Setenv("AUTH_ACCESS_TOKEN_TTL", "1s")
	t.Setenv("AUTH_SESSION_TTL", "30m")

	h := newAuthIntegrationHarness(t)
	h.createUser(t, authIntegrationUserInput{
		Username: "alice",
		Email:    "alice@example.com",
		Password: "Secret-pass",
		Active:   true,
	})

	_, tokens, err := h.service.Authenticate(context.Background(), AuthenticateInput{Login: "alice", Password: "Secret-pass", UserAgent: "ua-one", IPAddress: "127.0.0.1"})
	if err != nil {
		t.Fatalf("authenticate: %v", err)
	}
	originalSession, err := h.sessions.ByID(context.Background(), tokens.SessionID)
	if err != nil {
		t.Fatalf("load session: %v", err)
	}
	originalRefreshHash := originalSession.RefreshTokenHash

	time.Sleep(1200 * time.Millisecond)

	handler := h.service.RequireAuth()(func(r web.Context) error {
		user := CurrentUser(r)
		if user == nil {
			t.Fatal("expected current user in auth middleware")
		}
		return r.JSON(http.StatusOK, map[string]any{"ok": true, "username": user.Username})
	})
	rec := h.doJSON(
		http.MethodGet,
		"/hello",
		nil,
		handler,
		nil,
		[]*http.Cookie{
			{Name: AccessCookieName, Value: tokens.AccessToken},
			{Name: RefreshCookieName, Value: tokens.RefreshToken},
		},
	)
	if rec.Code != http.StatusOK {
		t.Fatalf("refresh-through-middleware status = %d, want %d\nbody:\n%s", rec.Code, http.StatusOK, rec.Body.String())
	}

	refreshedRefresh := h.cookie(rec, RefreshCookieName)
	if refreshedRefresh != nil && refreshedRefresh.Value != tokens.RefreshToken {
		t.Fatal("expected middleware refresh to preserve refresh cookie when reissued")
	}

	updatedSession, err := h.sessions.ByID(context.Background(), tokens.SessionID)
	if err != nil {
		t.Fatalf("load updated session: %v", err)
	}
	if updatedSession.RefreshTokenHash != originalRefreshHash {
		t.Fatal("expected middleware refresh to preserve refresh token hash")
	}
	if updatedSession.RefreshRotatedAt != nil {
		t.Fatalf("middleware refresh refresh_rotated_at = %v, want nil", updatedSession.RefreshRotatedAt)
	}
	if updatedSession.LastSeenAt == nil {
		t.Fatal("expected session last_seen_at to be updated")
	}

	reloadedUser, err := h.users.ByID(context.Background(), updatedSession.UserID)
	if err != nil {
		t.Fatalf("reload user after refresh: %v", err)
	}
	if reloadedUser.LastSeenAt == nil {
		t.Fatal("expected user last_seen_at to be updated on refresh")
	}
}

func TestRequireAuthAllowsProtectedRequestsAfterConcurrentRefreshRotationIntegration(t *testing.T) {
	t.Setenv("AUTH_ACCESS_TOKEN_TTL", "1s")
	t.Setenv("AUTH_SESSION_TTL", "30m")

	h := newAuthIntegrationHarness(t)
	h.createUser(t, authIntegrationUserInput{
		Username: "alice",
		Email:    "alice@example.com",
		Password: "Secret-pass",
		Active:   true,
	})

	_, tokens, err := h.service.Authenticate(context.Background(), AuthenticateInput{
		Login:     "alice",
		Password:  "Secret-pass",
		UserAgent: "ua-one",
		IPAddress: "127.0.0.1",
	})
	if err != nil {
		t.Fatalf("authenticate: %v", err)
	}

	time.Sleep(1200 * time.Millisecond)

	initialCookies := []*http.Cookie{
		{Name: AccessCookieName, Value: tokens.AccessToken},
		{Name: RefreshCookieName, Value: tokens.RefreshToken},
	}

	refreshRec := h.doJSON(http.MethodPost, "/auth/refresh", nil, h.controller.Refresh, nil, initialCookies)
	if refreshRec.Code != http.StatusOK {
		t.Fatalf("refresh status = %d, want %d\nbody:\n%s", refreshRec.Code, http.StatusOK, refreshRec.Body.String())
	}
	rotatedSession, err := h.sessions.ByIDFresh(context.Background(), tokens.SessionID)
	if err != nil {
		t.Fatalf("load rotated session: %v", err)
	}
	if rotatedSession.RefreshRotatedAt == nil {
		t.Fatal("expected explicit refresh to set refresh_rotated_at")
	}

	protected := h.service.RequireAuth()(func(r web.Context) error {
		user := CurrentUser(r)
		if user == nil {
			t.Fatal("expected current user in protected handler")
		}
		return r.JSON(http.StatusOK, map[string]any{"ok": true, "username": user.Username})
	})

	const concurrentRequests = 6
	var wg sync.WaitGroup
	type result struct {
		code int
		body string
	}
	results := make([]result, concurrentRequests)
	start := make(chan struct{})

	for i := 0; i < concurrentRequests; i++ {
		wg.Add(1)
		go func(idx int) {
			defer wg.Done()
			<-start
			rec := h.doJSON(http.MethodGet, "/hello", nil, protected, nil, initialCookies)
			results[idx] = result{
				code: rec.Code,
				body: rec.Body.String(),
			}
		}(i)
	}

	close(start)
	wg.Wait()

	for i, rec := range results {
		if rec.code != http.StatusOK {
			t.Fatalf("protected request %d status = %d, want %d\nbody:\n%s", i, rec.code, http.StatusOK, rec.body)
		}
	}
	recoveredSession, err := h.sessions.ByIDFresh(context.Background(), tokens.SessionID)
	if err != nil {
		t.Fatalf("load recovered session: %v", err)
	}
	if recoveredSession.RefreshRotatedAt == nil {
		t.Fatal("expected refresh_rotated_at to remain set after stale middleware recovery")
	}
	if !recoveredSession.RefreshRotatedAt.UTC().Equal(rotatedSession.RefreshRotatedAt.UTC()) {
		t.Fatalf("refresh_rotated_at = %v, want unchanged %v", recoveredSession.RefreshRotatedAt.UTC(), rotatedSession.RefreshRotatedAt.UTC())
	}

	replayRec := h.doJSON(http.MethodPost, "/auth/refresh", nil, h.controller.Refresh, nil, initialCookies)
	if replayRec.Code != http.StatusUnauthorized {
		t.Fatalf("stale refresh replay status = %d, want %d\nbody:\n%s", replayRec.Code, http.StatusUnauthorized, replayRec.Body.String())
	}
}

