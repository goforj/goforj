func TestControllerRevokeSessionRevokesOnlyRequestedOwnedSessionIntegration(t *testing.T) {
	h := newAuthIntegrationHarness(t)
	user := h.createUser(t, authIntegrationUserInput{
		Username: "alice",
		Email:    "alice@example.com",
		Password: "Secret-pass",
		Active:   true,
	})

	_, currentTokens, err := h.service.Authenticate(context.Background(), AuthenticateInput{Login: user.Username, Password: "Secret-pass", UserAgent: "ua-current", IPAddress: "127.0.0.20"})
	if err != nil {
		t.Fatalf("authenticate current session: %v", err)
	}
	_, otherTokens, err := h.service.Authenticate(context.Background(), AuthenticateInput{Login: user.Username, Password: "Secret-pass", UserAgent: "ua-other", IPAddress: "127.0.0.21"})
	if err != nil {
		t.Fatalf("authenticate other session: %v", err)
	}

	revokeHandler := h.service.RequireAuth()(h.controller.RevokeSession)
	rec := h.doJSON(
		http.MethodPost,
		"/auth/sessions/:id/revoke",
		nil,
		revokeHandler,
		map[string]string{"id": otherTokens.SessionID},
		[]*http.Cookie{
			{Name: AccessCookieName, Value: currentTokens.AccessToken},
			{Name: RefreshCookieName, Value: currentTokens.RefreshToken},
		},
	)
	if rec.Code != http.StatusOK {
		t.Fatalf("revoke session status = %d, want %d\nbody:\n%s", rec.Code, http.StatusOK, rec.Body.String())
	}

	currentSession, err := h.sessions.ByID(context.Background(), currentTokens.SessionID)
	if err != nil {
		t.Fatalf("load current session: %v", err)
	}
	if currentSession.RevokedAt != nil {
		t.Fatal("expected current session to remain active")
	}

	otherSession, err := h.sessions.ByID(context.Background(), otherTokens.SessionID)
	if err != nil {
		t.Fatalf("load other session: %v", err)
	}
	if otherSession.RevokedAt == nil {
		t.Fatal("expected other session to be revoked")
	}
}

func TestControllerChangePasswordRevokesOtherSessionsIntegration(t *testing.T) {
	h := newAuthIntegrationHarness(t)
	user := h.createUser(t, authIntegrationUserInput{
		Username: "alice",
		Email:    "alice@example.com",
