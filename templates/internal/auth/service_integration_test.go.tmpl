func TestAuthSessionRepoByIDCachesAndPreservesRefreshTokenHashIntegration(t *testing.T) {
	h := newAuthIntegrationHarness(t)
	user := h.createUser(t, authIntegrationUserInput{
		Username: "alice",
		Email:    "alice@example.com",
