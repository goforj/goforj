func waitForContainerExecSuccess(container testcontainers.Container, cmd []string, timeout time.Duration) error {
	deadline := time.Now().Add(timeout)
	var lastErr error
	for time.Now().Before(deadline) {
		exitCode, output, err := container.Exec(context.Background(), cmd)
		if err != nil {
			lastErr = err
			time.Sleep(500 * time.Millisecond)
			continue
		}
		if exitCode == 0 {
			if output != nil {
				_, _ = io.Copy(io.Discard, output)
			}
			return nil
		}
		body := ""
		if output != nil {
			data, _ := io.ReadAll(output)
			body = strings.TrimSpace(string(data))
		}
		if body == "" {
			body = fmt.Sprintf("exit code %d", exitCode)
		}
		lastErr = fmt.Errorf("%s", body)
		time.Sleep(500 * time.Millisecond)
	}
	if lastErr != nil {
		return lastErr
	}
	return fmt.Errorf("container command did not succeed before timeout")
}

func waitForTCPReadyAddress(host, port string, timeout time.Duration) error {
	deadline := time.Now().Add(timeout)
	address := net.JoinHostPort(host, port)
	var lastErr error
	for time.Now().Before(deadline) {
		conn, err := net.DialTimeout("tcp", address, 2*time.Second)
		if err == nil {
			_ = conn.Close()
			return nil
		}
		lastErr = err
		time.Sleep(500 * time.Millisecond)
	}
	if lastErr != nil {
		return fmt.Errorf("tcp endpoint %s not ready: %w", address, lastErr)
	}
	return fmt.Errorf("tcp endpoint %s not ready", address)
}

func waitForDefaultDatabaseReady(timeout time.Duration) error {
	deadline := time.Now().Add(timeout)
	var lastErr error
	for time.Now().Before(deadline) {
		conns := database.NewConnections()
		db, err := conns.Default()
		if err == nil {
			sqlDB, sqlErr := db.DB()
			if sqlErr == nil {
				pingCtx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
				pingErr := sqlDB.PingContext(pingCtx)
				cancel()
				if pingErr == nil {
					_ = conns.Close(context.Background())
					return nil
				}
				lastErr = pingErr
			} else {
				lastErr = sqlErr
			}
		} else {
			lastErr = err
		}
		_ = conns.Close(context.Background())
		time.Sleep(500 * time.Millisecond)
	}
	if lastErr != nil {
		return lastErr
	}
	return fmt.Errorf("database connection did not succeed before timeout")
}

func TestEnsureBootstrapUserCreatesLocalAdminIntegration(t *testing.T) {
	h := newAuthIntegrationHarness(t)

	t.Setenv("AUTH_BOOTSTRAP_USERNAME", "admin")
	t.Setenv("AUTH_BOOTSTRAP_PASSWORD", "admin")
	t.Setenv("AUTH_BOOTSTRAP_EMAIL", "admin@example.com")
	t.Setenv("AUTH_BOOTSTRAP_ENABLED", "true")

	created, err := h.service.EnsureBootstrapUserFromEnv()
	if err != nil {
		t.Fatalf("ensure bootstrap user: %v", err)
	}
	if !created {
		t.Fatal("expected bootstrap user to be created")
	}

	user, err := h.users.ByLogin("admin")
	if err != nil {
		t.Fatalf("find bootstrap user: %v", err)
	}
	if user.Email != "admin@example.com" {
		t.Fatalf("bootstrap user email = %q, want %q", user.Email, "admin@example.com")
	}
	if !user.Active {
		t.Fatal("expected bootstrap user to be active")
	}
	if user.DisplayName != "Administrator" {
		t.Fatalf("bootstrap user display_name = %q, want %q", user.DisplayName, "Administrator")
	}
	if user.AvatarURL != "" {
		t.Fatalf("bootstrap user avatar_url = %q, want empty", user.AvatarURL)
	}
	if user.Timezone != "" {
		t.Fatalf("bootstrap user timezone = %q, want empty", user.Timezone)
	}
	if user.Locale != "" {
		t.Fatalf("bootstrap user locale = %q, want empty", user.Locale)
	}
	if user.LastLoginAt != nil {
		t.Fatalf("bootstrap user last_login_at = %v, want nil", user.LastLoginAt)
	}
	if user.LastSeenAt != nil {
		t.Fatalf("bootstrap user last_seen_at = %v, want nil", user.LastSeenAt)
	}

	createdAgain, err := h.service.EnsureBootstrapUserFromEnv()
	if err != nil {
		t.Fatalf("ensure bootstrap user again: %v", err)
	}
	if createdAgain {
		t.Fatal("expected second bootstrap run to no-op")
	}
}

