func TestCreateUserIntegration(t *testing.T) {
	h := newAuthIntegrationHarness(t)

	user, err := h.service.CreateUser(context.Background(), "alice", "alice@example.com", "Secret-pass", "", true)
	if err != nil {
		t.Fatalf("create user: %v", err)
	}
	if user.Username != "alice" {
		t.Fatalf("created username = %q, want %q", user.Username, "alice")
	}
	if user.DisplayName != "alice" {
		t.Fatalf("created display_name = %q, want %q", user.DisplayName, "alice")
	}
	if !user.Active {
		t.Fatal("expected created user to be active")
	}
	if user.PasswordHash == "" {
		t.Fatal("expected created user password hash")
	}

	reloadedUser, err := h.users.ByLogin("alice")
	if err != nil {
		t.Fatalf("reload created user: %v", err)
	}
	if reloadedUser.Email != "alice@example.com" {
		t.Fatalf("created email = %q, want %q", reloadedUser.Email, "alice@example.com")
	}
	if err := bcrypt.CompareHashAndPassword([]byte(reloadedUser.PasswordHash), []byte("Secret-pass")); err != nil {
		t.Fatalf("created password hash mismatch: %v", err)
	}

	if _, err := h.service.CreateUser(context.Background(), "alice", "alice2@example.com", "Secret-pass", "", true); err == nil {
		t.Fatal("expected duplicate user create to fail")
	}
}

func TestCreateUserEnforcesConfiguredPasswordPolicyIntegration(t *testing.T) {
	h := newAuthIntegrationHarness(t)
	t.Setenv("AUTH_PASSWORD_REQUIRE_NUMBER", "true")

	if _, err := h.service.CreateUser(context.Background(), "alice", "alice@example.com", "Secret-pass", "", true); !errors.Is(err, ErrWeakPassword) {
		t.Fatalf("create user weak password error = %v, want %v", err, ErrWeakPassword)
	}
	if _, err := h.service.CreateUser(context.Background(), "alice", "alice@example.com", "Secret-pass1", "", true); err != nil {
		t.Fatalf("create user with number: %v", err)
	}
}

func TestCreateUserReportsCombinedPasswordRequirementsIntegration(t *testing.T) {
	h := newAuthIntegrationHarness(t)
	t.Setenv("AUTH_PASSWORD_MIN_LENGTH", "10")
	t.Setenv("AUTH_PASSWORD_REQUIRE_UPPER", "true")
	t.Setenv("AUTH_PASSWORD_REQUIRE_NUMBER", "true")
	t.Setenv("AUTH_PASSWORD_REQUIRE_SYMBOL", "false")

	_, err := h.service.CreateUser(context.Background(), "alice", "alice@example.com", "short", "", true)
	if !errors.Is(err, ErrWeakPassword) {
		t.Fatalf("create user combined password policy error = %v, want %v", err, ErrWeakPassword)
	}
	if err == nil || err.Error() != "password must be at least 10 characters, include an uppercase letter, include a number" {
		t.Fatalf("combined password policy error = %v", err)
	}
}

func TestSetPasswordIntegration(t *testing.T) {
	h := newAuthIntegrationHarness(t)
	user := h.createUser(t, authIntegrationUserInput{
		Username: "alice",
		Email:    "alice@example.com",
		Password: "Secret-pass",
		Active:   true,
	})
	lockUntil := time.Now().UTC().Add(time.Hour)
	user.FailedLoginAttempts = 3
	user.LockedUntil = &lockUntil
	if err := h.users.Save(context.Background(), user); err != nil {
		t.Fatalf("seed locked user: %v", err)
	}

	updatedUser, err := h.service.SetPassword(context.Background(), "alice", "Better-secret")
	if err != nil {
		t.Fatalf("set password: %v", err)
	}
	if updatedUser.FailedLoginAttempts != 0 {
		t.Fatalf("updated failed_login_attempts = %d, want 0", updatedUser.FailedLoginAttempts)
	}
	if updatedUser.LockedUntil != nil {
		t.Fatalf("updated locked_until = %v, want nil", updatedUser.LockedUntil)
	}

	if _, _, err := h.service.Authenticate(context.Background(), AuthenticateInput{Login: "alice", Password: "Secret-pass", UserAgent: "ua-old", IPAddress: "127.0.0.1"}); !errors.Is(err, ErrInvalidCredentials) {
		t.Fatalf("authenticate old password error = %v, want %v", err, ErrInvalidCredentials)
	}
	if _, _, err := h.service.Authenticate(context.Background(), AuthenticateInput{Login: "alice", Password: "Better-secret", UserAgent: "ua-new", IPAddress: "127.0.0.1"}); err != nil {
		t.Fatalf("authenticate new password: %v", err)
	}
}

