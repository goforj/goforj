func TestUserRepoActiveCachesSecurityStateAndSaveRefreshesItIntegration(t *testing.T) {
	h := newAuthIntegrationHarness(t)
	user := h.createUser(t, authIntegrationUserInput{
		Username: "alice",
		Email:    "alice@example.com",
		Password: "Secret-pass",
		Active:   true,
	})

	if err := h.users.cache.WithContext(context.Background()).Delete(cacheUserSecurityKey(user.ID)); err != nil {
		t.Fatalf("clear security cache: %v", err)
	}

	active, err := h.users.Active(context.Background(), user.ID)
	if err != nil {
		t.Fatalf("prime active cache: %v", err)
	}
	if !active {
		t.Fatalf("active = %v, want true", active)
	}

	db, err := h.conns.Default()
	if err != nil {
		t.Fatalf("default db: %v", err)
	}
	if err := db.Model(&User{}).
		Where("id = ?", user.ID).
		Update("active", false).Error; err != nil {
		t.Fatalf("update user active directly after cold load: %v", err)
	}

	cachedAfterColdLoad, err := h.users.Active(context.Background(), user.ID)
	if err != nil {
		t.Fatalf("reload cached active after cold load: %v", err)
	}
	if !cachedAfterColdLoad {
		t.Fatalf("cached active after cold load = %v, want cached true", cachedAfterColdLoad)
	}
	if err := db.Model(&User{}).
		Where("id = ?", user.ID).
		Update("active", false).Error; err != nil {
		t.Fatalf("update user active directly: %v", err)
	}

	cachedActive, err := h.users.Active(context.Background(), user.ID)
	if err != nil {
		t.Fatalf("reload cached active: %v", err)
	}
	if !cachedActive {
		t.Fatalf("cached active = %v, want cached true", cachedActive)
	}

	user.Active = false
	if err := h.users.Save(context.Background(), user); err != nil {
		t.Fatalf("save user inactive: %v", err)
	}

	reloadedActive, err := h.users.Active(context.Background(), user.ID)
	if err != nil {
		t.Fatalf("reload active after save: %v", err)
	}
	if reloadedActive {
		t.Fatalf("active after save = %v, want false", reloadedActive)
	}

	freshActive, err := h.users.ActiveFresh(context.Background(), user.ID)
	if err != nil {
		t.Fatalf("reload fresh active: %v", err)
	}
	if freshActive {
		t.Fatalf("fresh active = %v, want false", freshActive)
	}
}

