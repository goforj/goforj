func TestRequireAuthRefreshesExpiredAccessTokenIntegration(t *testing.T) {
	t.Setenv("AUTH_ACCESS_TTL", "5ms")
	t.Setenv("AUTH_REFRESH_TTL", "30m")

	h := newAuthIntegrationHarness(t)
	h.createUser(t, authIntegrationUserInput{
		Username: "alice",
		Email:    "alice@example.com",
		Password: "secret-pass",
		Active:   true,
	})

	_, tokens, err := h.service.Authenticate("alice", "secret-pass", "ua-one", "127.0.0.1")
	if err != nil {
		t.Fatalf("authenticate: %v", err)
	}
	originalSession, err := h.sessions.ByID(tokens.SessionID)
	if err != nil {
		t.Fatalf("load session: %v", err)
	}
	originalRefreshHash := originalSession.RefreshTokenHash

	time.Sleep(25 * time.Millisecond)

	handler := h.service.RequireAuth()(func(r web.Context) error {
		user := CurrentUser(r)
		if user == nil {
			t.Fatal("expected current user in auth middleware")
		}
		return r.JSON(http.StatusOK, map[string]any{"ok": true, "username": user.Username})
	})
	rec := h.doJSON(
		http.MethodGet,
		"/hello",
		nil,
		handler,
		nil,
		[]*http.Cookie{
			{Name: AccessCookieName, Value: tokens.AccessToken},
			{Name: RefreshCookieName, Value: tokens.RefreshToken},
		},
	)
	if rec.Code != http.StatusOK {
		t.Fatalf("refresh-through-middleware status = %d, want %d\nbody:\n%s", rec.Code, http.StatusOK, rec.Body.String())
	}

	refreshedAccess := h.cookie(rec, AccessCookieName)
	refreshedRefresh := h.cookie(rec, RefreshCookieName)
	if refreshedAccess == nil || strings.TrimSpace(refreshedAccess.Value) == "" {
		t.Fatal("expected refreshed access cookie")
	}
	if refreshedRefresh == nil || strings.TrimSpace(refreshedRefresh.Value) == "" {
		t.Fatal("expected refreshed refresh cookie")
	}
	if refreshedRefresh.Value == tokens.RefreshToken {
		t.Fatal("expected refresh cookie to rotate")
	}

	updatedSession, err := h.sessions.ByID(tokens.SessionID)
	if err != nil {
		t.Fatalf("load updated session: %v", err)
	}
	if updatedSession.RefreshTokenHash == originalRefreshHash {
		t.Fatal("expected refresh token hash to rotate")
	}
	if updatedSession.LastSeenAt == nil {
		t.Fatal("expected session last_seen_at to be updated")
	}

	reloadedUser, err := h.users.ByID(updatedSession.UserID)
	if err != nil {
		t.Fatalf("reload user after refresh: %v", err)
	}
	if reloadedUser.LastSeenAt == nil {
		t.Fatal("expected user last_seen_at to be updated on refresh")
	}
}

func TestCleanupExpiredSessionsRemovesExpiredRowsIntegration(t *testing.T) {
	h := newAuthIntegrationHarness(t)
	user := h.createUser(t, authIntegrationUserInput{
		Username: "alice",
		Email:    "alice@example.com",
		Password: "secret-pass",
		Active:   true,
	})

	expiredSession := &AuthSession{
		ID:               "expired-session",
		UserID:           user.ID,
		RefreshTokenHash: "expired-hash",
		ExpiresAt:        time.Now().UTC().Add(-time.Hour),
	}
	if err := h.sessions.Save(expiredSession); err != nil {
		t.Fatalf("save expired session: %v", err)
	}

	activeSession := &AuthSession{
		ID:               "active-session",
		UserID:           user.ID,
		RefreshTokenHash: "active-hash",
		ExpiresAt:        time.Now().UTC().Add(time.Hour),
	}
	if err := h.sessions.Save(activeSession); err != nil {
		t.Fatalf("save active session: %v", err)
	}

	removed, err := h.service.CleanupExpiredSessions(time.Now().UTC())
	if err != nil {
		t.Fatalf("cleanup expired sessions: %v", err)
	}
	if removed != 1 {
		t.Fatalf("cleanup removed = %d, want %d", removed, 1)
	}

	if _, err := h.sessions.ByID(expiredSession.ID); !errors.Is(err, gorm.ErrRecordNotFound) {
		t.Fatalf("expired session lookup error = %v, want %v", err, gorm.ErrRecordNotFound)
	}
	if _, err := h.sessions.ByID(activeSession.ID); err != nil {
		t.Fatalf("active session should remain, got %v", err)
	}
}

type authIntegrationHarness struct {
	conns         *database.Connections
	users         *UserRepo
	sessions      *AuthSessionRepo
	{{- if .Components.OAuth }}
	identities    *AuthIdentityRepo
	oauthStates   *OAuthStateRepo
	{{- end }}
	verifications *EmailVerificationRepo
	resets        *PasswordResetRepo
	attempts      *LoginAttemptRepo
	delivery      Delivery
	service       *Service
	controller    *Controller
}

type authIntegrationUserInput struct {
	Username        string
	Email           string
	DisplayName     string
	AvatarURL       string
	Password        string
	Active          bool
	EmailVerifiedAt *time.Time
	Timezone        string
	Locale          string
}

func newAuthIntegrationHarness(t *testing.T) authIntegrationHarness {
	t.Helper()

	t.Setenv("APP_ENV", "local")
	t.Setenv("AUTH_COOKIE_SECURE", "false")
	provisionAuthIntegrationDatabase(t)
	if err := env.Load(); err != nil {
		t.Fatalf("load env: %v", err)
	}

	conns := database.NewConnections()
	t.Cleanup(func() {
		_ = conns.Close(context.Background())
	})

	migrate := migrations.NewMigrateCmd(logger.NewSilentLogger(), conns)
	if err := migrate.Run(); err != nil {
		t.Fatalf("run migrations: %v", err)
	}

	db, err := conns.Default()
	if err != nil {
		t.Fatalf("default db: %v", err)
	}
	if err := db.Exec("DELETE FROM auth_sessions").Error; err != nil {
		t.Fatalf("clear auth_sessions: %v", err)
	}
	{{- if .Components.OAuth }}
	if err := db.Exec("DELETE FROM auth_oauth_states").Error; err != nil {
		t.Fatalf("clear auth_oauth_states: %v", err)
	}
	if err := db.Exec("DELETE FROM auth_identities").Error; err != nil {
		t.Fatalf("clear auth_identities: %v", err)
	}
	{{- end }}
	if err := db.Exec("DELETE FROM auth_email_verifications").Error; err != nil {
		t.Fatalf("clear auth_email_verifications: %v", err)
	}
	if err := db.Exec("DELETE FROM auth_password_resets").Error; err != nil {
		t.Fatalf("clear auth_password_resets: %v", err)
	}
	if err := db.Exec("DELETE FROM auth_login_attempts").Error; err != nil {
		t.Fatalf("clear auth_login_attempts: %v", err)
	}
	if err := db.Exec("DELETE FROM users").Error; err != nil {
		t.Fatalf("clear users: %v", err)
	}

	users := NewUserRepo(conns)
	sessions := NewAuthSessionRepo(conns)
	{{- if .Components.OAuth }}
	identities := NewAuthIdentityRepo(conns)
	oauthStates := NewOAuthStateRepo(conns)
	{{- end }}
	verifications := NewEmailVerificationRepo(conns)
	resets := NewPasswordResetRepo(conns)
	attempts := NewLoginAttemptRepo(conns)
	delivery := NewLogDelivery(logger.NewSilentLogger())
	service := NewService(
		users,
		sessions,
		{{- if .Components.OAuth }}
		identities,
		oauthStates,
		NewOAuthProviders(),
		{{- end }}
		verifications,
		resets,
		attempts,
		delivery,
	)
	controller := NewController(service)

	return authIntegrationHarness{
		conns:         conns,
		users:         users,
		sessions:      sessions,
		{{- if .Components.OAuth }}
		identities:    identities,
		oauthStates:   oauthStates,
		{{- end }}
		verifications: verifications,
		resets:        resets,
		attempts:      attempts,
		delivery:      delivery,
		service:       service,
		controller:    controller,
	}
}

func provisionAuthIntegrationDatabase(t *testing.T) {
	t.Helper()

	_ = env.Load()
	driver := strings.ToLower(strings.TrimSpace(os.Getenv("DB_DRIVER")))
	if driver == "" {
		driver = strings.ToLower(strings.TrimSpace(env.Get("DB_DRIVER", "")))
	}
	hasConfiguredDatabaseEnv := strings.TrimSpace(env.Get("DB_HOST", os.Getenv("DB_HOST"))) != "" &&
		strings.TrimSpace(env.Get("DB_PORT", os.Getenv("DB_PORT"))) != "" &&
		strings.TrimSpace(env.Get("DB_DATABASE", os.Getenv("DB_DATABASE"))) != "" &&
		strings.TrimSpace(env.Get("DB_USERNAME", os.Getenv("DB_USERNAME"))) != ""
	switch driver {
	case "", "sqlite", "sqlite3":
		t.Setenv("DB_DRIVER", "sqlite")
		t.Setenv("DB_DATABASE", filepath.Join(t.TempDir(), "auth-integration.db"))
	case "mysql", "mariadb":
		if hasConfiguredDatabaseEnv {
			t.Setenv("DB_DRIVER", "mysql")
			return
		}
		ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
		t.Cleanup(cancel)
		container, err := testcontainers.GenericContainer(ctx, testcontainers.GenericContainerRequest{
			ContainerRequest: testcontainers.ContainerRequest{
				Image:        "mysql:8.4",
				ExposedPorts: []string{"3306/tcp"},
				Env: map[string]string{
					"MYSQL_DATABASE":      "app",
					"MYSQL_USER":          "app",
					"MYSQL_PASSWORD":      "secret",
					"MYSQL_ROOT_PASSWORD": "rootsecret",
				},
				WaitingFor: wait.ForLog("ready for connections").WithStartupTimeout(90 * time.Second),
			},
			Started: true,
		})
		if err != nil {
			t.Fatalf("start mysql testcontainer: %v", err)
		}
		t.Cleanup(func() {
			_ = container.Terminate(context.Background())
		})
		host, err := container.Host(ctx)
		if err != nil {
			t.Fatalf("mysql testcontainer host: %v", err)
		}
		port, err := container.MappedPort(ctx, "3306/tcp")
		if err != nil {
			t.Fatalf("mysql testcontainer port: %v", err)
		}
		t.Setenv("DB_DRIVER", "mysql")
		t.Setenv("DB_HOST", host)
		t.Setenv("DB_PORT", port.Port())
		t.Setenv("DB_DATABASE", "app")
		t.Setenv("DB_USERNAME", "app")
		t.Setenv("DB_PASSWORD", "secret")
		if err := waitForTCPReadyAddress(host, port.Port(), 60*time.Second); err != nil {
			t.Fatalf("wait for mysql tcp readiness: %v", err)
		}
		if err := waitForContainerExecSuccess(
			container,
			[]string{
				"sh", "-lc",
				`mysql -h 127.0.0.1 -u"$MYSQL_USER" -p"$MYSQL_PASSWORD" "$MYSQL_DATABASE" -e 'SELECT 1'`,
			},
			60*time.Second,
		); err != nil {
			t.Fatalf("wait for mysql authenticated readiness: %v", err)
		}
		if err := waitForDefaultDatabaseReady(60 * time.Second); err != nil {
			t.Fatalf("wait for mysql client readiness: %v", err)
		}
	case "postgres", "postgresql":
		if hasConfiguredDatabaseEnv {
			t.Setenv("DB_DRIVER", "postgres")
			return
		}
		ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
		t.Cleanup(cancel)
		container, err := testcontainers.GenericContainer(ctx, testcontainers.GenericContainerRequest{
			ContainerRequest: testcontainers.ContainerRequest{
				Image:        "postgres:16-alpine",
				ExposedPorts: []string{"5432/tcp"},
				Env: map[string]string{
					"POSTGRES_DB":       "app",
					"POSTGRES_USER":     "app",
					"POSTGRES_PASSWORD": "secret",
				},
				WaitingFor: wait.ForLog("database system is ready to accept connections").WithStartupTimeout(60 * time.Second),
			},
			Started: true,
		})
		if err != nil {
			t.Fatalf("start postgres testcontainer: %v", err)
		}
		t.Cleanup(func() {
			_ = container.Terminate(context.Background())
		})
		host, err := container.Host(ctx)
		if err != nil {
			t.Fatalf("postgres testcontainer host: %v", err)
		}
		port, err := container.MappedPort(ctx, "5432/tcp")
		if err != nil {
			t.Fatalf("postgres testcontainer port: %v", err)
		}
		t.Setenv("DB_DRIVER", "postgres")
		t.Setenv("DB_HOST", host)
		t.Setenv("DB_PORT", port.Port())
		t.Setenv("DB_DATABASE", "app")
		t.Setenv("DB_USERNAME", "app")
		t.Setenv("DB_PASSWORD", "secret")
	default:
		t.Fatalf("unsupported DB_DRIVER for auth integration: %q", driver)
	}
}

func (h authIntegrationHarness) createUser(t *testing.T, input authIntegrationUserInput) *User {
	t.Helper()

	hash, err := bcrypt.GenerateFromPassword([]byte(input.Password), bcrypt.DefaultCost)
	if err != nil {
		t.Fatalf("hash password: %v", err)
	}
	user := &User{
		Username:        input.Username,
		Email:           input.Email,
		DisplayName:     input.DisplayName,
		AvatarURL:       input.AvatarURL,
		PasswordHash:    string(hash),
		Active:          input.Active,
		EmailVerifiedAt: input.EmailVerifiedAt,
		Timezone:        input.Timezone,
		Locale:          input.Locale,
	}
	if user.DisplayName == "" {
		user.DisplayName = input.Username
	}
	if err := h.users.Create(user); err != nil {
		t.Fatalf("create user: %v", err)
	}
	return user
}

func (h authIntegrationHarness) newContext(method, path string, body any, cookies []*http.Cookie, params map[string]string) (*webtest.Context, *httptest.ResponseRecorder) {
	var payload []byte
	if body != nil {
		payload, _ = json.Marshal(body)
	}
	req := httptest.NewRequest(method, path, bytes.NewReader(payload))
	req.Header.Set("Content-Type", "application/json")
	req.RemoteAddr = "127.0.0.1:1234"
	req.Header.Set("X-Forwarded-For", "127.0.0.1")
	for _, cookie := range cookies {
		req.AddCookie(cookie)
	}
	rec := httptest.NewRecorder()
	return webtest.NewContext(req, rec, path, webtest.PathParams(params)), rec
}

func (h authIntegrationHarness) doJSON(method, path string, body any, handler web.Handler, params map[string]string, cookies []*http.Cookie) *httptest.ResponseRecorder {
	ctx, rec := h.newContext(method, path, body, cookies, params)
	if err := handler(ctx); err != nil {
		rec.Code = http.StatusInternalServerError
		_, _ = rec.WriteString(err.Error())
	}
	return rec
}

func (h authIntegrationHarness) decodeJSON(rec *httptest.ResponseRecorder) map[string]any {
	var out map[string]any
	_ = json.Unmarshal(rec.Body.Bytes(), &out)
	return out
}

func assertClearedCookie(t *testing.T, cookie *http.Cookie, name string) {
	t.Helper()
	if cookie == nil {
		t.Fatalf("expected cleared %s cookie", name)
	}
	if cookie.Value != "" {
		t.Fatalf("cleared %s cookie value = %q, want empty", name, cookie.Value)
	}
	if cookie.MaxAge >= 0 {
		t.Fatalf("cleared %s cookie MaxAge = %d, want negative", name, cookie.MaxAge)
	}
}

func ptrTime(v time.Time) *time.Time {
	return &v
}

func (h authIntegrationHarness) cookie(rec *httptest.ResponseRecorder, name string) *http.Cookie {
	for _, cookie := range rec.Result().Cookies() {
		if cookie.Name == name {
			return cookie
		}
	}
	return nil
}
