	reloadedCached, err := h.users.ByID(context.Background(), user.ID)
	if err != nil {
		t.Fatalf("load cached user: %v", err)
	}
	if reloadedCached.DisplayName != cachedUser.DisplayName {
		t.Fatalf("cached user display_name = %q, want %q", reloadedCached.DisplayName, cachedUser.DisplayName)
	}
	if reloadedCached.PasswordHash != cachedUser.PasswordHash {
		t.Fatalf("cached user password_hash = %q, want original cached value", reloadedCached.PasswordHash)
	}

	reloadedFresh, err := h.users.ByIDFresh(context.Background(), user.ID)
	if err != nil {
		t.Fatalf("load fresh user: %v", err)
	}
	if reloadedFresh.DisplayName != "Changed In DB" {
		t.Fatalf("fresh user display_name = %q, want %q", reloadedFresh.DisplayName, "Changed In DB")
	}
	if reloadedFresh.PasswordHash != "db-only-hash" {
		t.Fatalf("fresh user password_hash = %q, want %q", reloadedFresh.PasswordHash, "db-only-hash")
	}
}

