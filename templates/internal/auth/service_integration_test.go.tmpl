type authIntegrationHarness struct {
	conns         *database.Connections
	{{- if .Components.Metrics }}
	metrics       *metrics.Manager
	{{- end }}
	users         *UserRepo
	sessions      *AuthSessionRepo
	{{- if .Components.OAuth }}
	identities    *AuthIdentityRepo
	oauthStates   *OAuthStateRepo
	{{- end }}
	verifications *EmailVerificationRepo
	resets        *PasswordResetRepo
	attempts      *LoginAttemptRepo
	delivery      Delivery
	service       *Service
	controller    *Controller
}

type authIntegrationUserInput struct {
	Username        string
	Email           string
	DisplayName     string
	AvatarURL       string
	Password        string
	Active          bool
	EmailVerifiedAt *time.Time
	Timezone        string
	Locale          string
}

func newAuthIntegrationHarness(t *testing.T) authIntegrationHarness {
	t.Helper()

	authEnv := snapshotAuthIntegrationEnv()
	authEnv["AUTH_COOKIE_SECURE"] = "false"
	t.Setenv("APP_ENV", "local")
	t.Setenv("AUTH_COOKIE_SECURE", "false")
	provisionAuthIntegrationDatabase(t)
	if err := env.Load(); err != nil {
		t.Fatalf("load env: %v", err)
	}
	restoreAuthIntegrationEnv(t, authEnv)

	conns := database.NewConnections({{- if .Components.Metrics }}metrics.NewManager(), {{- end }}nil)
	t.Cleanup(func() {
		_ = conns.Close(context.Background())
	})

	migrate := migrations.NewMigrateCmd(logger.NewSilentLogger(), conns)
	if err := migrate.Run(); err != nil {
		t.Fatalf("run migrations: %v", err)
	}

	db, err := conns.Default()
	if err != nil {
		t.Fatalf("default db: %v", err)
	}
	if err := db.Exec("DELETE FROM auth_sessions").Error; err != nil {
		t.Fatalf("clear auth_sessions: %v", err)
	}
	{{- if .Components.OAuth }}
	if err := db.Exec("DELETE FROM auth_oauth_states").Error; err != nil {
		t.Fatalf("clear auth_oauth_states: %v", err)
	}
	if err := db.Exec("DELETE FROM auth_identities").Error; err != nil {
		t.Fatalf("clear auth_identities: %v", err)
	}
	{{- end }}
	if err := db.Exec("DELETE FROM auth_email_verifications").Error; err != nil {
		t.Fatalf("clear auth_email_verifications: %v", err)
	}
	if err := db.Exec("DELETE FROM auth_password_resets").Error; err != nil {
		t.Fatalf("clear auth_password_resets: %v", err)
	}
	if err := db.Exec("DELETE FROM auth_login_attempts").Error; err != nil {
		t.Fatalf("clear auth_login_attempts: %v", err)
	}
	if err := db.Exec("DELETE FROM users").Error; err != nil {
		t.Fatalf("clear users: %v", err)
	}

	cacheManager, err := caches.NewManager()
	if err != nil {
		t.Fatalf("new cache manager: %v", err)
	}
	sessionCache := cacheManager.Sessions()
	{{- if .Components.Metrics }}
	metricsManager := metrics.NewManager()
	{{- end }}
	users := NewUserRepo(conns, sessionCache)
	sessions := NewAuthSessionRepo(conns, sessionCache)
	{{- if .Components.OAuth }}
	identities := NewAuthIdentityRepo(conns)
	oauthStates := NewOAuthStateRepo(conns)
	{{- end }}
	verifications := NewEmailVerificationRepo(conns)
	resets := NewPasswordResetRepo(conns)
	attempts := NewLoginAttemptRepo(conns)
	delivery := NewLogDelivery(logger.NewSilentLogger())
	service := NewService(
		users,
		sessions,
		{{- if .Components.OAuth }}
		identities,
		oauthStates,
		NewOAuthProviders(),
		{{- end }}
		verifications,
		resets,
		attempts,
		delivery,
		logger.NewSilentLogger(),
		{{- if .Components.Metrics }}
		metricsManager,
		{{- end }}
	)
	controller := NewController(service)

	return authIntegrationHarness{
		conns:         conns,
		{{- if .Components.Metrics }}
		metrics:       metricsManager,
		{{- end }}
		users:         users,
		sessions:      sessions,
		{{- if .Components.OAuth }}
		identities:    identities,
		oauthStates:   oauthStates,
		{{- end }}
		verifications: verifications,
		resets:        resets,
		attempts:      attempts,
		delivery:      delivery,
		service:       service,
		controller:    controller,
	}
}

func snapshotAuthIntegrationEnv() map[string]string {
	values := map[string]string{}
	for _, entry := range os.Environ() {
		key, value, ok := strings.Cut(entry, "=")
		if !ok || !strings.HasPrefix(key, "AUTH_") {
			continue
		}
		values[key] = value
	}
	return values
}

func restoreAuthIntegrationEnv(t *testing.T, values map[string]string) {
	t.Helper()
	for key, value := range values {
		t.Setenv(key, value)
	}
}

func provisionAuthIntegrationDatabase(t *testing.T) {
	t.Helper()

	explicitEnv := func(key string) string {
		return strings.TrimSpace(os.Getenv(key))
	}
	explicitDBHost := explicitEnv("DB_HOST")
	explicitDBPort := explicitEnv("DB_PORT")
	explicitDBDatabase := explicitEnv("DB_DATABASE")
	explicitDBUsername := explicitEnv("DB_USERNAME")
	explicitDBPassword := explicitEnv("DB_PASSWORD")

	_ = env.Load()
	currentEnv := func(key string) string {
		if value := strings.TrimSpace(os.Getenv(key)); value != "" {
			return value
		}
		return strings.TrimSpace(env.Get(key, ""))
	}
	driver := strings.ToLower(currentEnv("DB_DRIVER"))
	useConfiguredDatabase := strings.EqualFold(explicitEnv("AUTH_INTEGRATION_USE_CONFIGURED_DB"), "true")
	hasConfiguredDatabaseEnv := useConfiguredDatabase &&
		explicitDBHost != "" &&
		explicitDBPort != "" &&
		explicitDBDatabase != "" &&
		explicitDBUsername != ""
	switch driver {
	case "", "sqlite", "sqlite3":
		t.Setenv("DB_DRIVER", "sqlite")
		t.Setenv("DB_DATABASE", filepath.Join(t.TempDir(), "auth-integration.db"))
	case "mysql", "mariadb":
		if hasConfiguredDatabaseEnv {
			t.Setenv("DB_DRIVER", "mysql")
			t.Setenv("DB_HOST", explicitDBHost)
			t.Setenv("DB_PORT", explicitDBPort)
			t.Setenv("DB_DATABASE", explicitDBDatabase)
			t.Setenv("DB_USERNAME", explicitDBUsername)
			t.Setenv("DB_PASSWORD", explicitDBPassword)
			t.Setenv(
				"DB_DSN",
				fmt.Sprintf(
					"%s:%s@tcp(%s:%s)/%s?charset=utf8mb4&parseTime=True&loc=Local",
					explicitDBUsername,
					explicitDBPassword,
					explicitDBHost,
					explicitDBPort,
					explicitDBDatabase,
				),
			)
			return
		}
		shared := ensureSharedMySQLAuthIntegrationContainer(t)
		t.Setenv("DB_DRIVER", "mysql")
		t.Setenv("DB_HOST", shared.host)
		t.Setenv("DB_PORT", shared.port)
		t.Setenv("DB_DATABASE", "app")
		t.Setenv("DB_USERNAME", "app")
		t.Setenv("DB_PASSWORD", "secret")
		if err := waitForDefaultDatabaseReady(60 * time.Second); err != nil {
			t.Fatalf("wait for mysql client readiness: %v", err)
		}
	case "postgres", "postgresql":
		if hasConfiguredDatabaseEnv {
			t.Setenv("DB_DRIVER", "postgres")
			t.Setenv("DB_HOST", explicitDBHost)
			t.Setenv("DB_PORT", explicitDBPort)
			t.Setenv("DB_DATABASE", explicitDBDatabase)
			t.Setenv("DB_USERNAME", explicitDBUsername)
			t.Setenv("DB_PASSWORD", explicitDBPassword)
			t.Setenv(
				"DB_DSN",
				fmt.Sprintf(
					"host=%s user=%s password=%s dbname=%s port=%s sslmode=disable",
					explicitDBHost,
					explicitDBUsername,
					explicitDBPassword,
					explicitDBDatabase,
					explicitDBPort,
				),
			)
			return
		}
		shared := ensureSharedPostgresAuthIntegrationContainer(t)
		t.Setenv("DB_DRIVER", "postgres")
		t.Setenv("DB_HOST", shared.host)
		t.Setenv("DB_PORT", shared.port)
		t.Setenv("DB_DATABASE", "app")
		t.Setenv("DB_USERNAME", "app")
		t.Setenv("DB_PASSWORD", "secret")
		if err := waitForDefaultDatabaseReady(60 * time.Second); err != nil {
			t.Fatalf("wait for postgres client readiness: %v", err)
		}
	default:
		t.Fatalf("unsupported DB_DRIVER for auth integration: %q", driver)
	}
}

func timesEqualAtStoredPrecision(stored, expected time.Time) bool {
	stored = stored.UTC()
	expected = expected.UTC()
	switch {
	case stored.Nanosecond() == 0:
		return stored.Equal(expected.Truncate(time.Second))
	case stored.Nanosecond()%1_000 == 0:
		return stored.Equal(expected.Truncate(time.Microsecond))
	case stored.Nanosecond()%1_000_000 == 0:
		return stored.Equal(expected.Truncate(time.Millisecond))
	default:
		return stored.Equal(expected)
	}
}

func timeAtOrAfterStoredPrecision(stored, lowerBound time.Time) bool {
	stored = stored.UTC()
	lowerBound = lowerBound.UTC()
	switch {
	case stored.Nanosecond() == 0:
		return !stored.Before(lowerBound.Truncate(time.Second))
	case stored.Nanosecond()%1_000 == 0:
		return !stored.Before(lowerBound.Truncate(time.Microsecond))
	case stored.Nanosecond()%1_000_000 == 0:
		return !stored.Before(lowerBound.Truncate(time.Millisecond))
	default:
		return !stored.Before(lowerBound)
	}
}

func timesEqualPtr(stored, expected *time.Time) bool {
	if stored == nil || expected == nil {
		return stored == nil && expected == nil
	}
	return timesEqualAtStoredPrecision(stored.UTC(), expected.UTC())
}

func (h authIntegrationHarness) createUser(t *testing.T, input authIntegrationUserInput) *User {
	t.Helper()

	hash, err := bcrypt.GenerateFromPassword([]byte(input.Password), bcrypt.DefaultCost)
	if err != nil {
		t.Fatalf("hash password: %v", err)
	}
	user := &User{
		Username:        input.Username,
		Email:           input.Email,
		DisplayName:     input.DisplayName,
		AvatarURL:       input.AvatarURL,
		PasswordHash:    string(hash),
		Active:          input.Active,
		EmailVerifiedAt: input.EmailVerifiedAt,
		Timezone:        input.Timezone,
		Locale:          input.Locale,
	}
	if user.DisplayName == "" {
		user.DisplayName = input.Username
	}
	if err := h.users.Create(context.Background(), user); err != nil {
		t.Fatalf("create user: %v", err)
	}
	return user
}

func (h authIntegrationHarness) newContext(method, path string, body any, cookies []*http.Cookie, params map[string]string) (*webtest.Context, *httptest.ResponseRecorder) {
	var payload []byte
	if body != nil {
		payload, _ = json.Marshal(body)
	}
	req := httptest.NewRequest(method, path, bytes.NewReader(payload))
	req.Header.Set("Content-Type", "application/json")
	req.RemoteAddr = "127.0.0.1:1234"
	req.Header.Set("X-Forwarded-For", "127.0.0.1")
	for _, cookie := range cookies {
		req.AddCookie(cookie)
	}
	rec := httptest.NewRecorder()
	return webtest.NewContext(req, rec, path, webtest.PathParams(params)), rec
}

func (h authIntegrationHarness) doJSON(method, path string, body any, handler web.Handler, params map[string]string, cookies []*http.Cookie) *httptest.ResponseRecorder {
	ctx, rec := h.newContext(method, path, body, cookies, params)
	if err := handler(ctx); err != nil {
		rec.Code = http.StatusInternalServerError
		_, _ = rec.WriteString(err.Error())
	}
	return rec
}

func (h authIntegrationHarness) decodeJSON(rec *httptest.ResponseRecorder) map[string]any {
	var out map[string]any
	_ = json.Unmarshal(rec.Body.Bytes(), &out)
	return out
}

func assertClearedCookie(t *testing.T, cookie *http.Cookie, name string) {
	t.Helper()
	if cookie == nil {
		t.Fatalf("expected cleared %s cookie", name)
	}
	if cookie.Value != "" {
		t.Fatalf("cleared %s cookie value = %q, want empty", name, cookie.Value)
	}
	if cookie.MaxAge >= 0 {
		t.Fatalf("cleared %s cookie MaxAge = %d, want negative", name, cookie.MaxAge)
	}
}

func ptrTime(v time.Time) *time.Time {
	return &v
}

func (h authIntegrationHarness) cookie(rec *httptest.ResponseRecorder, name string) *http.Cookie {
	for _, cookie := range rec.Result().Cookies() {
		if cookie.Name == name {
			return cookie
		}
	}
	return nil
}
