func TestCleanupRemovesExpiredEmailVerificationsPasswordResetsAndLoginAttemptsIntegration(t *testing.T) {
	h := newAuthIntegrationHarness(t)
	user := h.createUser(t, authIntegrationUserInput{
		Username: "alice",
		Email:    "alice@example.com",
		Password: "secret-pass",
		Active:   true,
	})
	now := time.Now().UTC()

	expiredVerification := &EmailVerificationToken{
		UserID:    user.ID,
		TokenHash: "expired-verification-hash",
		ExpiresAt: now.Add(-time.Hour),
	}
	if err := h.verifications.Save(expiredVerification); err != nil {
		t.Fatalf("save expired verification: %v", err)
	}
	activeVerification := &EmailVerificationToken{
		UserID:    user.ID,
		TokenHash: "active-verification-hash",
		ExpiresAt: now.Add(time.Hour),
	}
	if err := h.verifications.Save(activeVerification); err != nil {
		t.Fatalf("save active verification: %v", err)
	}
	expiredReset := &PasswordResetToken{
		UserID:    user.ID,
		TokenHash: "expired-reset-hash",
		ExpiresAt: now.Add(-time.Hour),
	}
	if err := h.resets.Save(expiredReset); err != nil {
		t.Fatalf("save expired reset: %v", err)
	}
	activeReset := &PasswordResetToken{
		UserID:    user.ID,
		TokenHash: "active-reset-hash",
		ExpiresAt: now.Add(time.Hour),
	}
	if err := h.resets.Save(activeReset); err != nil {
		t.Fatalf("save active reset: %v", err)
	}
	expiredAttempt := &LoginAttempt{
		Scope:          "login",
		Identifier:     "expired@example.com",
		IPAddress:      "127.0.0.50",
		FailedAttempts: 3,
		FirstFailedAt:  now.Add(-2 * time.Hour),
		LastFailedAt:   now.Add(-time.Hour),
		BlockedUntil:   ptrTime(now.Add(-time.Minute)),
	}
	if err := h.attempts.Save(expiredAttempt); err != nil {
		t.Fatalf("save expired login attempt: %v", err)
	}
	activeAttempt := &LoginAttempt{
		Scope:          "login",
		Identifier:     "active@example.com",
		IPAddress:      "127.0.0.51",
		FailedAttempts: 2,
		FirstFailedAt:  now.Add(-2 * time.Minute),
		LastFailedAt:   now.Add(-time.Minute),
		BlockedUntil:   ptrTime(now.Add(time.Hour)),
	}
	if err := h.attempts.Save(activeAttempt); err != nil {
		t.Fatalf("save active login attempt: %v", err)
	}

	if err := h.service.Cleanup(context.Background()); err != nil {
		t.Fatalf("run auth cleanup: %v", err)
	}

	if _, err := h.verifications.ActiveByTokenHash(expiredVerification.TokenHash, now); !errors.Is(err, gorm.ErrRecordNotFound) {
		t.Fatalf("expired verification lookup error = %v, want %v", err, gorm.ErrRecordNotFound)
	}
	if _, err := h.verifications.ActiveByTokenHash(activeVerification.TokenHash, now); err != nil {
		t.Fatalf("active verification lookup: %v", err)
	}
	if _, err := h.resets.ActiveByTokenHash(expiredReset.TokenHash, now); !errors.Is(err, gorm.ErrRecordNotFound) {
		t.Fatalf("expired reset lookup error = %v, want %v", err, gorm.ErrRecordNotFound)
	}
	if _, err := h.resets.ActiveByTokenHash(activeReset.TokenHash, now); err != nil {
		t.Fatalf("active reset lookup: %v", err)
	}
	if _, err := h.attempts.ByScopeIdentifierIP("login", expiredAttempt.Identifier, expiredAttempt.IPAddress); !errors.Is(err, gorm.ErrRecordNotFound) {
		t.Fatalf("expired attempt lookup error = %v, want %v", err, gorm.ErrRecordNotFound)
	}
	if _, err := h.attempts.ByScopeIdentifierIP("login", activeAttempt.Identifier, activeAttempt.IPAddress); err != nil {
		t.Fatalf("active attempt lookup: %v", err)
	}
}

