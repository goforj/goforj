package auth

import "{{.GoModuleName}}/internal/console"

// SetPasswordCmd replaces a local auth user's password explicitly from the CLI.
type SetPasswordCmd struct {
	authService *Service

	Login    string `help:"Username or email for the user" required:""`
	Password string `help:"New password for the user" required:""`
}

// Signature defines the kong metadata for this command.
func (*SetPasswordCmd) Signature() string {
	return `name:"auth:set-password" help:"Set a local auth user's password"`
}

// NewSetPasswordCmd creates a new SetPasswordCmd.
func NewSetPasswordCmd(authService *Service) *SetPasswordCmd {
	return &SetPasswordCmd{authService: authService}
}

// Run executes the command.
func (c *SetPasswordCmd) Run() error {
	user, err := c.authService.SetPassword(c.Login, c.Password)
	if err != nil {
		return err
	}
	console.Successf("updated password for %s", user.Username)
	return nil
}
