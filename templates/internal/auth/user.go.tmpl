package auth

import (
	"context"
	"strconv"
	"strings"
	"time"

	"github.com/goforj/cache"
	"gorm.io/gorm"
	"{{.GoModuleName}}/internal/database"
)

const authCacheTTL = 5 * time.Minute

// User is the generated local-auth account model.
type User struct {
	ID                  int64      `gorm:"column:id;primaryKey;autoIncrement" json:"id"`
	Username            string     `gorm:"column:username" json:"username"`
	Email               string     `gorm:"column:email" json:"email"`
	DisplayName         string     `gorm:"column:display_name" json:"display_name"`
	AvatarURL           string     `gorm:"column:avatar_url" json:"avatar_url"`
	PasswordHash        string     `gorm:"column:password_hash" json:"-"`
	Active              bool       `gorm:"column:active" json:"active"`
	FailedLoginAttempts int        `gorm:"column:failed_login_attempts" json:"failed_login_attempts"`
	EmailVerifiedAt     *time.Time `gorm:"column:email_verified_at" json:"email_verified_at"`
	LastLoginAt         *time.Time `gorm:"column:last_login_at" json:"last_login_at"`
	LastSeenAt          *time.Time `gorm:"column:last_seen_at" json:"last_seen_at"`
	LockedUntil         *time.Time `gorm:"column:locked_until" json:"locked_until"`
	Timezone            string     `gorm:"column:timezone" json:"timezone"`
	Locale              string     `gorm:"column:locale" json:"locale"`
	CreatedAt           time.Time  `gorm:"column:created_at" json:"created_at"`
	UpdatedAt           time.Time  `gorm:"column:updated_at" json:"updated_at"`
}

// TableName returns the database table name for users.
func (*User) TableName() string {
	return "users"
}

// Relationships returns generated relationship metadata for model tooling.
func (*User) Relationships() []string {
	return []string{}
}

// UserRepo provides persistence helpers for user records.
type UserRepo struct {
	db    *database.Connections
	cache *cache.Cache
}

type cachedUser struct {
	ID                  int64      `json:"id"`
	Username            string     `json:"username"`
	Email               string     `json:"email"`
	DisplayName         string     `json:"display_name"`
	AvatarURL           string     `json:"avatar_url"`
	PasswordHash        string     `json:"password_hash"`
	Active              bool       `json:"active"`
	FailedLoginAttempts int        `json:"failed_login_attempts"`
	EmailVerifiedAt     *time.Time `json:"email_verified_at"`
	LastLoginAt         *time.Time `json:"last_login_at"`
	LastSeenAt          *time.Time `json:"last_seen_at"`
	LockedUntil         *time.Time `json:"locked_until"`
	Timezone            string     `json:"timezone"`
	Locale              string     `json:"locale"`
}

// NewUserRepo creates a user repository.
func NewUserRepo(db *database.Connections, cacheStore *cache.Cache) *UserRepo {
	return &UserRepo{
		db:    db,
		cache: cacheStore,
	}
}

func (r *UserRepo) connection() (*gorm.DB, error) {
	return r.db.Default()
}

// ByID loads a user by primary key.
func (r *UserRepo) ByID(ctx context.Context, id int64) (*User, error) {
	if r.cache != nil {
		if snapshot, ok, err := cache.Get[cachedUser](r.cache.WithContext(ctx), cacheUserKey(id)); err == nil && ok {
			return hydrateUser(snapshot), nil
		}
	}
	return r.ByIDFresh(ctx, id)
}

// ByIDFresh loads a user by primary key directly from the database.
func (r *UserRepo) ByIDFresh(ctx context.Context, id int64) (*User, error) {
	conn, err := r.connection()
	if err != nil {
		return nil, err
	}
	var user User
	if err := conn.Where("id = ?", id).Limit(1).First(&user).Error; err != nil {
		return nil, err
	}
	r.cacheUser(ctx, &user)
	return &user, nil
}

// ByLogin resolves a user by normalized username or email.
func (r *UserRepo) ByLogin(login string) (*User, error) {
	conn, err := r.connection()
	if err != nil {
		return nil, err
	}
	normalized := strings.ToLower(strings.TrimSpace(login))
	if normalized == "" {
		return nil, gorm.ErrRecordNotFound
	}
	var user User
	if err := conn.
		Where("LOWER(username) = ? OR LOWER(email) = ?", normalized, normalized).
		Limit(1).
		First(&user).Error; err != nil {
		return nil, err
	}
	return &user, nil
}

// ByEmail loads a user by normalized email address.
func (r *UserRepo) ByEmail(email string) (*User, error) {
	conn, err := r.connection()
	if err != nil {
		return nil, err
	}
	normalized := strings.ToLower(strings.TrimSpace(email))
	if normalized == "" {
		return nil, gorm.ErrRecordNotFound
	}
	var user User
	if err := conn.
		Where("LOWER(email) = ?", normalized).
		Limit(1).
		First(&user).Error; err != nil {
		return nil, err
	}
	return &user, nil
}

// Create inserts a new user row.
func (r *UserRepo) Create(ctx context.Context, user *User) error {
	conn, err := r.connection()
	if err != nil {
		return err
	}
	now := time.Now().UTC()
	user.Username = strings.TrimSpace(user.Username)
	user.Email = strings.TrimSpace(user.Email)
	user.DisplayName = strings.TrimSpace(user.DisplayName)
	user.AvatarURL = strings.TrimSpace(user.AvatarURL)
	user.Timezone = strings.TrimSpace(user.Timezone)
	user.Locale = strings.TrimSpace(user.Locale)
	user.CreatedAt = now
	user.UpdatedAt = now
	if err := conn.Create(user).Error; err != nil {
		return err
	}
	r.cacheUser(ctx, user)
	return nil
}

// Save updates an existing user row.
func (r *UserRepo) Save(ctx context.Context, user *User) error {
	conn, err := r.connection()
	if err != nil {
		return err
	}
	user.Username = strings.TrimSpace(user.Username)
	user.Email = strings.TrimSpace(user.Email)
	user.DisplayName = strings.TrimSpace(user.DisplayName)
	user.AvatarURL = strings.TrimSpace(user.AvatarURL)
	user.Timezone = strings.TrimSpace(user.Timezone)
	user.Locale = strings.TrimSpace(user.Locale)
	user.UpdatedAt = time.Now().UTC()
	if err := conn.Save(user).Error; err != nil {
		return err
	}
	r.cacheUser(ctx, user)
	return nil
}

// TouchLastSeen updates the cached last_seen_at for a user without forcing a database write.
func (r *UserRepo) TouchLastSeen(ctx context.Context, user *User, seenAt time.Time) {
	if user == nil {
		return
	}
	seenAt = seenAt.UTC()
	user.LastSeenAt = &seenAt
	r.cacheUser(ctx, user)
}

func cacheUserKey(userID int64) string {
	return "auth:user:" + strconv.FormatInt(userID, 10)
}

func snapshotUser(user *User) cachedUser {
	return cachedUser{
		ID:                  user.ID,
		Username:            user.Username,
		Email:               user.Email,
		DisplayName:         user.DisplayName,
		AvatarURL:           user.AvatarURL,
		PasswordHash:        user.PasswordHash,
		Active:              user.Active,
		FailedLoginAttempts: user.FailedLoginAttempts,
		EmailVerifiedAt:     user.EmailVerifiedAt,
		LastLoginAt:         user.LastLoginAt,
		LastSeenAt:          user.LastSeenAt,
		LockedUntil:         user.LockedUntil,
		Timezone:            user.Timezone,
		Locale:              user.Locale,
	}
}

func hydrateUser(snapshot cachedUser) *User {
	return &User{
		ID:                  snapshot.ID,
		Username:            snapshot.Username,
		Email:               snapshot.Email,
		DisplayName:         snapshot.DisplayName,
		AvatarURL:           snapshot.AvatarURL,
		PasswordHash:        snapshot.PasswordHash,
		Active:              snapshot.Active,
		FailedLoginAttempts: snapshot.FailedLoginAttempts,
		EmailVerifiedAt:     snapshot.EmailVerifiedAt,
		LastLoginAt:         snapshot.LastLoginAt,
		LastSeenAt:          snapshot.LastSeenAt,
		LockedUntil:         snapshot.LockedUntil,
		Timezone:            snapshot.Timezone,
		Locale:              snapshot.Locale,
	}
}

func (r *UserRepo) cacheUser(ctx context.Context, user *User) {
	if user == nil || user.ID == 0 {
		return
	}
	_ = cache.Set(r.cache.WithContext(ctx), cacheUserKey(user.ID), snapshotUser(user), authCacheTTL)
}

func isMissingUsersTableError(err error) bool {
	if err == nil {
		return false
	}
	msg := strings.ToLower(err.Error())
	return strings.Contains(msg, "no such table") ||
		strings.Contains(msg, "doesn't exist") ||
		strings.Contains(msg, "undefined table") ||
		strings.Contains(msg, "relation") && strings.Contains(msg, "does not exist")
}
