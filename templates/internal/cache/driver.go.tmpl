package cache

import (
	"github.com/goforj/env/v2"
	"github.com/goforj/str"
)

// Driver identifies cache backend.
type Driver string

const (
	DriverMemory Driver = "memory"
	DriverRedis  Driver = "redis"
)

// ActiveDriver resolves cache backend from environment.
func ActiveDriver() Driver {
	value := str.Of(env.Get("CACHE_DRIVER", string(DriverMemory))).
		TrimSpace().
		ToLower().
		String()

	switch Driver(value) {
	case DriverRedis:
		return DriverRedis
	default:
		return DriverMemory
	}
}

// UsesRedis reports whether cache uses Redis.
func UsesRedis() bool {
	return ActiveDriver() == DriverRedis
}

