package cache

import (
	"context"

	"github.com/redis/go-redis/v9"
)

// NewStore resolves cache backend and returns concrete store.
func NewStore(_ context.Context, redisClient *redis.Client) Store {
	switch ActiveDriver() {
	case DriverRedis:
		return newRedisStore(redisClient)
	default:
		return newMemoryStore()
	}
}

