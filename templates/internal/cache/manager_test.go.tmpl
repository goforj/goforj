package cache

import "testing"

func TestNewManagerBuildsDefaultStore(t *testing.T) {
	t.Setenv("CACHE_DRIVER", "memory")

	mgr, err := NewManager()
	if err != nil {
		t.Fatalf("NewManager returned error: %v", err)
	}

	if err := mgr.Default().SetString("hello", "world", 0); err != nil {
		t.Fatalf("SetString returned error: %v", err)
	}
	got, ok, err := mgr.Default().GetString("hello")
	if err != nil {
		t.Fatalf("GetString returned error: %v", err)
	}
	if !ok || got != "world" {
		t.Fatalf("GetString = (%q, %v), want (%q, true)", got, ok, "world")
	}
}

func TestNewManagerSupportsNamedStores(t *testing.T) {
	t.Setenv("CACHE_DRIVER", "memory")
	t.Setenv("CACHE_SESSIONS_DRIVER", "file")
	t.Setenv("CACHE_SESSIONS_FILE_DIR", t.TempDir())

	mgr, err := NewManager()
	if err != nil {
		t.Fatalf("NewManager returned error: %v", err)
	}

	if err := mgr.Sessions().SetString("session", "active", 0); err != nil {
		t.Fatalf("SetString returned error: %v", err)
	}
	got, ok, err := mgr.Sessions().GetString("session")
	if err != nil {
		t.Fatalf("GetString returned error: %v", err)
	}
	if !ok || got != "active" {
		t.Fatalf("GetString = (%q, %v), want (%q, true)", got, ok, "active")
	}
}
