// AboutCmd prints a concise snapshot of the current app environment and configured services.
type AboutCmd struct {
	JSON bool `help:"Print as JSON"`
}

type AboutReport struct {
	App         string                `json:"app"`
	Environment AboutEnvironment      `json:"environment"`
	Build       AboutBuild            `json:"build"`
	Network     AboutNetwork          `json:"network"`
	Databases   []AboutDatabase       `json:"databases,omitempty"`
	Caches      []AboutCache          `json:"caches"`
	Queues      []AboutQueue          `json:"queues,omitempty"`
	Storages    []AboutStorage        `json:"storages"`
	Events      []AboutEvent          `json:"events"`
}

type AboutEnvironment struct {
	AppName       string `json:"app_name"`
	Module        string `json:"module"`
	Environment   string `json:"environment"`
	Debug         bool   `json:"debug"`
	GoVersion     string `json:"go_version"`
	GoForjVersion string `json:"goforj_version"`
}

type AboutBuild struct {
	Components      []string `json:"components"`
	WireGenerated   string   `json:"wire_generated"`
	FrontendDist    string   `json:"frontend_dist,omitempty"`
	MigrationsPath  string   `json:"migrations_path,omitempty"`
}

type AboutNetwork struct {
	AppURL        string `json:"app_url,omitempty"`
	APIURL        string `json:"api_url,omitempty"`
	LighthouseURL string `json:"lighthouse_url,omitempty"`
}

type AboutDatabase struct {
	Name      string `json:"name"`
	IsDefault bool   `json:"is_default"`
	Driver    string `json:"driver"`
	Host      string `json:"host,omitempty"`
	Port      string `json:"port,omitempty"`
	Database  string `json:"database,omitempty"`
	DSN       string `json:"dsn,omitempty"`
	Summary   string `json:"summary"`
}

type AboutCache struct {
	Name      string `json:"name"`
	IsDefault bool   `json:"is_default"`
	Driver    string `json:"driver"`
	Summary   string `json:"summary"`
}

type AboutQueue struct {
	Name         string `json:"name"`
	IsDefault    bool   `json:"is_default"`
	Driver       string `json:"driver"`
	DefaultQueue string `json:"default_queue,omitempty"`
	Workers      string `json:"workers,omitempty"`
	Summary      string `json:"summary"`
}

type AboutStorage struct {
	Name      string `json:"name"`
	IsDefault bool   `json:"is_default"`
	Driver    string `json:"driver"`
	Root      string `json:"root,omitempty"`
	Summary   string `json:"summary"`
}

type AboutEvent struct {
	Name      string `json:"name"`
	IsDefault bool   `json:"is_default"`
	Driver    string `json:"driver"`
	Summary   string `json:"summary"`
}

type aboutRow struct {
	key   string
	value string
}

type aboutSection struct {
	title string
	value string
	rows  []aboutRow
}

// Signature defines the kong metadata for this command.
func (*AboutCmd) Signature() string {
	return `name:"about" help:"Show environment and configured services for this app"`
}

// NewAboutCmd creates a new AboutCmd.
func NewAboutCmd() *AboutCmd {
	return &AboutCmd{}
}

// Run executes the command.
func (c *AboutCmd) Run() error {
	report := c.report()
	if c.JSON {
		out, err := json.MarshalIndent(report, "", "  ")
		if err != nil {
			return err
		}
		fmt.Println(string(out))
		return nil
	}
	sections := c.sections(report)
	keyWidth := aboutKeyWidth(sections)
	fmt.Println(" " + strings.ToLower(strings.TrimSpace(report.App)) + " about")
	fmt.Println()
	for i, section := range sections {
		if i > 0 {
			fmt.Println()
		}
		fmt.Print(renderAboutSection(section, keyWidth))
	}
	return nil
}

func (c *AboutCmd) report() AboutReport {
	report := AboutReport{
		App: strings.TrimSpace(env.Get("APP_NAME", "app")),
		Environment: AboutEnvironment{
			AppName:       env.Get("APP_NAME", "app"),
			Module:        "{{.GoModuleName}}",
			Environment:   env.Get("APP_ENV", "local"),
			Debug:         env.Get("APP_DEBUG", "0") != "0",
			GoVersion:     runtime.Version(),
			GoForjVersion: aboutForjVersion(),
		},
		Build: AboutBuild{
			Components:    aboutComponents(),
			WireGenerated: aboutPresence(filepath.Join("wire", "wire_gen.go")),
{{- if .Components.WebUI }}
			FrontendDist: aboutPresence(filepath.Join("frontend", "dist", "index.html")),
{{- end }}
{{- if .Components.HasDatabase }}
			MigrationsPath: aboutPresence("migrations"),
{{- end }}
		},
		Network: AboutNetwork{
			AppURL: env.Get("APP_URL", "http://localhost:3000"),
{{- if .Components.WebAPI }}
			APIURL: strings.TrimRight(env.Get("APP_URL", "http://localhost:3000"), "/") + "/api",
{{- end }}
		},
		Caches:   aboutCacheReports(),
{{- if .Components.Jobs }}
		Queues:   aboutQueueReports(),
{{- end }}
		Storages: aboutStorageReports(),
		Events:   aboutEventReports(),
	}
	if raw := strings.TrimSpace(env.Get("LIGHTHOUSE_URL", "")); raw != "" {
		if env.GetBool("LIGHTHOUSE_ENABLED", "true") {
			report.Network.LighthouseURL = raw
		} else {
			report.Network.LighthouseURL = "disabled"
		}
	}
{{- if .Components.HasDatabase }}
	report.Databases = aboutDatabaseReports()
{{- end }}
	return report
}

func (c *AboutCmd) sections(report AboutReport) []aboutSection {
	sections := []aboutSection{
		{
			title: "Environment",
			rows: []aboutRow{
				{key: "App", value: report.Environment.AppName},
				{key: "Module", value: report.Environment.Module},
				{key: "Environment", value: report.Environment.Environment},
				{key: "Debug", value: aboutEnabled(report.Environment.Debug)},
				{key: "Go", value: report.Environment.GoVersion},
				{key: "GoForj Version", value: report.Environment.GoForjVersion},
			},
		},
		{
			title: "Build",
			rows: aboutBuildRows(report.Build),
		},
	}

	if network := aboutNetworkRows(report.Network); len(network) > 0 {
		sections = append(sections, aboutSection{title: "Network", rows: network})
	}

{{- if .Components.HasDatabase }}
	sections = append(sections, aboutSection{title: "Databases", value: aboutSectionValue(len(report.Databases)), rows: aboutDatabaseRows(report)})
{{- end }}
	sections = append(sections,
		aboutSection{title: "Caches", value: aboutSectionValue(len(report.Caches)), rows: aboutCacheRows(report)},
{{- if .Components.Jobs }}
		aboutSection{title: "Queues", value: aboutSectionValue(len(report.Queues)), rows: aboutQueueRows(report)},
{{- end }}
		aboutSection{title: "Storages", value: aboutSectionValue(len(report.Storages)), rows: aboutStorageRows(report)},
		aboutSection{title: "Events", value: aboutSectionValue(len(report.Events)), rows: aboutEventRows(report)},
	)

	return sections
}

func aboutForjVersion() string {
	cfg, err := lighthouse.LoadProjectConfig()
	if err != nil || cfg == nil {
		return "-"
	}
	value := strings.TrimSpace(cfg.Render.GoForjVersion)
	if value == "" {
		return "-"
	}
	return value
}

func aboutBuildRows(build AboutBuild) []aboutRow {
	rows := []aboutRow{
		{key: "Components", value: strings.Join(build.Components, ", ")},
		{key: "Wire Generated", value: build.WireGenerated},
	}
	if strings.TrimSpace(build.FrontendDist) != "" {
		rows = append(rows, aboutRow{key: "Frontend Dist", value: build.FrontendDist})
	}
	if strings.TrimSpace(build.MigrationsPath) != "" {
		rows = append(rows, aboutRow{key: "Migrations Path", value: build.MigrationsPath})
	}
	return rows
}

func aboutNetworkRows(network AboutNetwork) []aboutRow {
	rows := []aboutRow{}
	if strings.TrimSpace(network.AppURL) != "" {
		rows = append(rows, aboutRow{key: "App URL", value: network.AppURL})
	}
	if strings.TrimSpace(network.APIURL) != "" {
		rows = append(rows, aboutRow{key: "API URL", value: network.APIURL})
	}
	if strings.TrimSpace(network.LighthouseURL) != "" {
		rows = append(rows, aboutRow{key: "Lighthouse URL", value: network.LighthouseURL})
	}
	return rows
}

func aboutDatabaseRows(report AboutReport) []aboutRow {
	rows := []aboutRow{
		{key: "Default", value: aboutDatabaseDefaultName()},
	}
	for _, database := range report.Databases {
		rows = append(rows, aboutRow{key: database.Name, value: database.Summary})
	}
	return rows
}

func aboutCacheRows(report AboutReport) []aboutRow {
	rows := []aboutRow{}
	for _, cache := range report.Caches {
		rows = append(rows, aboutRow{key: cache.Name, value: cache.Summary})
	}
	return rows
}

func aboutQueueRows(report AboutReport) []aboutRow {
	rows := []aboutRow{}
	for _, queue := range report.Queues {
		rows = append(rows, aboutRow{key: queue.Name, value: queue.Summary})
	}
	return rows
}

func aboutStorageRows(report AboutReport) []aboutRow {
	rows := []aboutRow{}
	for _, storage := range report.Storages {
		rows = append(rows, aboutRow{key: storage.Name, value: storage.Summary})
	}
	return rows
}

func aboutEventRows(report AboutReport) []aboutRow {
	rows := make([]aboutRow, 0, len(report.Events))
	for _, event := range report.Events {
		rows = append(rows, aboutRow{key: event.Name, value: event.Summary})
	}
	return rows
}

func aboutSectionValue(count int) string {
	return fmt.Sprintf("(%d)", count)
}

