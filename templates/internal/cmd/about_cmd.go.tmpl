// AboutCmd prints a concise snapshot of the current app environment and configured services.
type AboutCmd struct{}

type aboutRow struct {
	key   string
	value string
}

type aboutSection struct {
	title string
	value string
	rows  []aboutRow
}

// Signature defines the kong metadata for this command.
func (*AboutCmd) Signature() string {
	return `name:"about" help:"Show environment and configured services for this app"`
}

// NewAboutCmd creates a new AboutCmd.
func NewAboutCmd() *AboutCmd {
	return &AboutCmd{}
}

// Run executes the command.
func (c *AboutCmd) Run() error {
	sections := c.sections()
	width := aboutKeyWidth(sections)
	fmt.Println(" " + strings.ToLower(strings.TrimSpace(env.Get("APP_NAME", "app"))) + " about")
	fmt.Println()
	for i, section := range sections {
		if i > 0 {
			fmt.Println()
		}
		fmt.Print(renderAboutSection(section, width))
	}
	return nil
}

func (c *AboutCmd) sections() []aboutSection {
	forjVersion := aboutForjVersion()
	sections := []aboutSection{
		{
			title: "Environment",
			rows: []aboutRow{
				{key: "App", value: env.Get("APP_NAME", "app")},
				{key: "Module", value: "{{.GoModuleName}}"},
				{key: "Environment", value: env.Get("APP_ENV", "local")},
				{key: "Debug", value: aboutEnabled(env.Get("APP_DEBUG", "0") != "0")},
				{key: "Go", value: runtime.Version()},
				{key: "GoForj Version", value: forjVersion},
			},
		},
		{
			title: "Build",
			rows: aboutBuildRows(),
		},
	}

	if network := aboutNetworkRows(); len(network) > 0 {
		sections = append(sections, aboutSection{title: "Network", rows: network})
	}

{{- if .Components.HasDatabase }}
	sections = append(sections, aboutSection{title: "Databases", value: aboutSectionValue(aboutDatabaseCount()), rows: aboutDatabaseRows()})
{{- end }}
	sections = append(sections,
		aboutSection{title: "Caches", value: aboutSectionValue(aboutCacheCount()), rows: aboutCacheRows()},
{{- if .Components.Jobs }}
		aboutSection{title: "Queues", value: aboutSectionValue(aboutQueueCount()), rows: aboutQueueRows()},
{{- end }}
		aboutSection{title: "Storages", value: aboutSectionValue(aboutStorageCount()), rows: aboutStorageRows()},
		aboutSection{title: "Events", value: aboutSectionValue(aboutEventCount()), rows: aboutEventRows()},
	)

	return sections
}

func aboutForjVersion() string {
	cfg, err := lighthouse.LoadProjectConfig()
	if err != nil || cfg == nil {
		return "-"
	}
	value := strings.TrimSpace(cfg.Render.GoForjVersion)
	if value == "" {
		return "-"
	}
	return value
}

func aboutBuildRows() []aboutRow {
	rows := []aboutRow{
		{key: "Components", value: strings.Join(aboutComponents(), ", ")},
		{key: "Wire Generated", value: aboutPresence(filepath.Join("wire", "wire_gen.go"))},
	}
{{- if .Components.WebUI }}
	rows = append(rows, aboutRow{key: "Frontend Dist", value: aboutPresence(filepath.Join("frontend", "dist", "index.html"))})
{{- end }}
{{- if .Components.HasDatabase }}
	rows = append(rows, aboutRow{key: "Migrations Path", value: aboutPresence("migrations")})
{{- end }}
	return rows
}

func aboutNetworkRows() []aboutRow {
	rows := []aboutRow{
		{key: "App URL", value: env.Get("APP_URL", "http://localhost:3000")},
	}
{{- if .Components.WebAPI }}
	rows = append(rows, aboutRow{key: "API URL", value: strings.TrimRight(env.Get("APP_URL", "http://localhost:3000"), "/") + "/api"})
{{- end }}
	if raw := strings.TrimSpace(env.Get("LIGHTHOUSE_URL", "")); raw != "" {
		if env.GetBool("LIGHTHOUSE_ENABLED", "true") {
			rows = append(rows, aboutRow{key: "Lighthouse URL", value: raw})
		} else {
			rows = append(rows, aboutRow{key: "Lighthouse URL", value: "disabled"})
		}
	}
	return rows
}

func aboutDatabaseRows() []aboutRow {
	names := aboutDatabaseNames()
	rows := []aboutRow{
		{key: "Default", value: aboutDatabaseDefaultName()},
	}
	for _, name := range names {
		rows = append(rows, aboutRow{key: name, value: aboutDatabaseSummary(name)})
	}
	return rows
}

func aboutCacheRows() []aboutRow {
	names := aboutScopedNames("CACHE", aboutCacheRootKeys)
	rows := []aboutRow{}
	for _, name := range names {
		rows = append(rows, aboutRow{key: name, value: aboutCacheSummary(name)})
	}
	return rows
}

