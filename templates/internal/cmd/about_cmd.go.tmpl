func aboutEventRows(report AboutReport) []aboutRow {
	rows := make([]aboutRow, 0, len(report.Events))
	for _, event := range report.Events {
		rows = append(rows, aboutRow{key: event.Name, value: event.Driver})
	}
	return rows
