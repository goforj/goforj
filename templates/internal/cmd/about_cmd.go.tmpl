package cmd

import (
	"encoding/json"
	"fmt"
	"strings"

	appinfo "{{.GoModuleName}}/internal/app"
)

const (
	aboutANSIReset = "\033[0m"
	aboutANSIBold  = "\033[1m"
	aboutFGMuted   = "\033[90m"
	aboutFGAccent  = "\033[36m"
)

// AboutCmd prints a concise snapshot of the current app environment and configured services.
type AboutCmd struct {
	JSON    bool `help:"Print as JSON"`
	NoColor bool `help:"Disable ANSI colors"`

	service *appinfo.AboutService
}

// Signature defines CLI metadata for this command.
func (*AboutCmd) Signature() string {
	return `name:"about" help:"Show environment and configured services for this app" goforj:"skip_boot"`
}

// NewAboutCmd creates a new AboutCmd.
func NewAboutCmd() *AboutCmd {
	return &AboutCmd{service: appinfo.NewAboutService()}
}

// Run executes the command.
func (c *AboutCmd) Run() error {
	report := c.aboutService().Build()
	if c.JSON {
		out, err := json.MarshalIndent(report, "", "  ")
		if err != nil {
			return err
		}
		fmt.Println(string(out))
		return nil
	}

	sections := report.Sections
	keyWidth := aboutKeyWidth(sections)
	detailWidth := aboutPrimitiveDetailWidth(sections)
	flatSections, primitiveSections := aboutSplitSections(sections)
	for i, section := range flatSections {
		if i > 0 {
			fmt.Println()
		}
		fmt.Print(c.renderAboutSection(section, keyWidth))
	}
	if len(primitiveSections) > 0 {
		if len(flatSections) > 0 {
			fmt.Println()
		}
		fmt.Print(c.renderPrimitiveSectionGrid(primitiveSections, detailWidth))
	}
	return nil
}

func (c *AboutCmd) aboutService() *appinfo.AboutService {
	if c.service == nil {
		c.service = appinfo.NewAboutService()
	}
	return c.service
}

func aboutKeyWidth(sections []appinfo.AboutSectionData) int {
	width := 0
	for _, section := range sections {
		for _, row := range section.Rows {
			if len(row.Key) > width {
				width = len(row.Key)
			}
		}
	}
	return width
}

func (c *AboutCmd) renderAboutSection(section appinfo.AboutSectionData, width int) string {
	const leftPad = " "
	lines := []string{leftPad + c.colorize("", aboutANSIBold, section.Title)}
	for _, row := range c.renderSectionRows(section, width) {
		if row == "" {
			lines = append(lines, "")
			continue
		}
		lines = append(lines, leftPad+row)
	}
	return strings.Join(lines, "\n") + "\n"
}

func (c *AboutCmd) renderPrimitiveSectionGrid(sections []appinfo.AboutSectionData, detailWidth int) string {
	ordered := make([]appinfo.AboutSectionData, 0, len(sections))
	for _, title := range []string{"Databases", "Storages", "Caches", "Queues", "Events"} {
		section, ok := aboutFindSection(sections, title)
		if !ok {
			continue
		}
		ordered = append(ordered, section)
	}
	termWidth := aboutTerminalWidth()
	cols := aboutPrimitiveGridColumns(len(ordered), termWidth, 3)
	blocks := make([]aboutGridBlock, 0, len(ordered))
	for _, section := range ordered {
		blocks = append(blocks, aboutGridBlock{
			lines: c.renderPrimitiveSectionLines(section, detailWidth),
		})
	}
	if cols <= 1 {
		rendered := make([]string, 0, len(blocks)*4)
		for idx, block := range blocks {
			if idx > 0 {
				rendered = append(rendered, "")
			}
			rendered = append(rendered, block.lines...)
		}
		return strings.Join(rendered, "\n") + "\n"
	}
	return aboutRenderGrid(aboutStackBlocks(blocks, cols), cols) + "\n"
}

func (c *AboutCmd) renderPrimitiveSectionLines(section appinfo.AboutSectionData, detailWidth int) []string {
	const leftPad = " "
	lines := []string{c.colorize("", aboutANSIBold, section.Title)}
	for _, row := range c.renderPrimitiveDetailRows(section, detailWidth) {
		if row == "" {
			lines = append(lines, "")
			continue
		}
		lines = append(lines, leftPad+row)
	}
	return lines
}

func (c *AboutCmd) renderSectionRows(section appinfo.AboutSectionData, width int) []string {
	lines := make([]string, 0, len(section.Rows))
	for _, row := range section.Rows {
		key := padAboutKey(row.Key, width)
		value := row.Value
		if strings.TrimSpace(value) == "" {
			value = c.colorize(aboutFGMuted, "", "-")
		} else {
			value = c.colorize(aboutFGMuted, "", value)
		}
		lines = append(lines, key+" "+value)
	}
	return lines
}

func (c *AboutCmd) renderPrimitiveDetailRows(section appinfo.AboutSectionData, detailWidth int) []string {
	lines := make([]string, 0, len(section.Connections)*4)
	for idx, connection := range section.Connections {
		lines = append(lines, c.renderConnectionHeader(connection.Name, connection.IsDefault))
		for _, detail := range connection.Details {
			lines = append(lines, c.renderPrimitiveDetailRow(detail, detailWidth))
		}
		if idx < len(section.Connections)-1 {
			lines = append(lines, "")
		}
	}
	return lines
}

func (c *AboutCmd) renderPrimitiveDetailRow(detail appinfo.AboutField, detailWidth int) string {
	key := padAboutKey(detail.Key, detailWidth)
	value := c.colorize(aboutFGMuted, "", detail.Value)
	if detail.Key == "Driver" {
		value = c.colorize(aboutFGAccent, "", detail.Value)
	}
	return " " + c.colorize(aboutFGMuted, "", "·") + " " + key + " " + value
}

func (c *AboutCmd) renderConnectionHeader(name string, isDefault bool) string {
	if isDefault {
		return c.colorize(aboutFGAccent, "", "→") + " " + c.colorize("", aboutANSIBold, name)
	}
	return c.colorize(aboutFGMuted, "", "→") + " " + c.colorize("", aboutANSIBold, name)
}

func aboutPrimitiveDetailWidth(sections []appinfo.AboutSectionData) int {
	width := 0
	for _, section := range sections {
		for _, connection := range section.Connections {
			for _, detail := range connection.Details {
				if len(detail.Key) > width {
					width = len(detail.Key)
				}
			}
		}
	}
	return width
}

func padAboutKey(value string, width int) string {
	return fmt.Sprintf("%-*s", width, value)
}

func (c *AboutCmd) colorize(fg string, attrs string, value string) string {
	if c.NoColor || value == "" {
		return value
	}
	return fg + attrs + value + aboutANSIReset
}
