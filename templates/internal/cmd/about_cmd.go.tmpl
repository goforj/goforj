func aboutScopedNames(prefix string, rootKeys []string) []string {
	scope := env.WithPrefix(prefix)
	names := []string{"default"}
	children := scope.ChildNames(rootKeys)
	normalized := make([]string, 0, len(children))
	for _, child := range children {
		name := str.Of(child).TrimSpace().ToLower().String()
		if name == "" {
			continue
		}
		childScope := scope.Child(str.Of(name).Snake("_").ToUpper().String())
		if !aboutPrimitiveChildDefined(prefix, childScope) {
			continue
		}
		normalized = append(normalized, name)
	}
	sort.Strings(normalized)
	return append(names, normalized...)
}

func aboutDatabaseNames() []string {
	scope := env.WithPrefix("DB")
	children := scope.ChildNames(aboutDatabaseRootKeys)
	names := []string{"default"}
	normalized := make([]string, 0, len(children))
	for _, child := range children {
		name := str.Of(child).TrimSpace().ToLower().String()
		if name == "" {
			continue
		}
		childScope := scope.Child(str.Of(name).Snake("_").ToUpper().String())
		if !aboutDatabaseChildDefined(childScope) {
			continue
		}
		normalized = append(normalized, name)
	}
	sort.Strings(normalized)
	return append(names, normalized...)
}

func aboutDatabaseDefaultName() string {
	if value := str.Of(env.Get("DB_DEFAULT", "")).TrimSpace().ToLower().String(); value != "" {
		return value
	}
	return "default"
}

func aboutDatabaseSummary(name string) string {
	driver := str.Of(aboutDatabaseEnv(name, "DRIVER")).TrimSpace().ToLower().String()
	if driver == "" {
		return "-"
	}
	if dsn := strings.TrimSpace(aboutDatabaseEnv(name, "DSN")); dsn != "" {
		return driver + " · " + aboutMaskDSN(dsn)
	}
	switch driver {
	case "postgres", "postgresql", "mysql", "mariadb":
		host := strings.TrimSpace(aboutDatabaseEnv(name, "HOST"))
		port := strings.TrimSpace(aboutDatabaseEnv(name, "PORT"))
		database := strings.TrimSpace(aboutDatabaseEnv(name, "DATABASE"))
		if host == "" || port == "" || database == "" {
			return driver
		}
		return fmt.Sprintf("%s · %s:%s/%s", driver, host, port, database)
	case "sqlite", "sqlite3":
		database := strings.TrimSpace(aboutDatabaseEnv(name, "DATABASE"))
		if database == "" {
			return "sqlite"
		}
		return "sqlite · " + database
	default:
		return driver
	}
}

func aboutDatabaseReports() []AboutDatabase {
	names := aboutDatabaseNames()
	reports := make([]AboutDatabase, 0, len(names))
	for _, name := range names {
		driver := str.Of(aboutDatabaseEnv(name, "DRIVER")).TrimSpace().ToLower().String()
		reports = append(reports, AboutDatabase{
			Name:      name,
			IsDefault: name == aboutDatabaseDefaultName(),
			Driver:    driver,
			Host:      strings.TrimSpace(aboutDatabaseEnv(name, "HOST")),
			Port:      strings.TrimSpace(aboutDatabaseEnv(name, "PORT")),
			Database:  strings.TrimSpace(aboutDatabaseEnv(name, "DATABASE")),
			DSN:       aboutMaskDSN(aboutDatabaseEnv(name, "DSN")),
			Summary:   aboutDatabaseSummary(name),
		})
	}
	return reports
}

func aboutDatabaseEnv(name, suffix string) string {
	scope := env.WithPrefix("DB")
	if name == "" || name == "default" {
		return scope.Get(suffix, "")
	}
	child := scope.Child(str.Of(name).Snake("_").ToUpper().String())
	if value := child.Get(suffix, ""); value != "" {
		return value
	}
	return scope.Get(suffix, "")
}

func aboutCacheSummary(name string) string {
	scope := aboutPrimitiveScope("CACHE", name)
	driver := str.Of(scope.Get("DRIVER", "memory")).TrimSpace().ToLower().String()
	switch driver {
	case "", "memory":
		return "memory"
	case "file":
		dir := strings.TrimSpace(scope.Get("FILE_DIR", ""))
		if dir == "" {
			dir = filepath.Join(os.TempDir(), "cache-file")
			if name != "default" {
				dir = filepath.Join(dir, name)
			}
		}
		return "file · " + dir
	case "redis":
		return "redis · " + aboutRedisSummary(scope, "CACHE")
	default:
		return driver
	}
}

func aboutCacheReports() []AboutCache {
	names := aboutScopedNames("CACHE", aboutCacheRootKeys)
	reports := make([]AboutCache, 0, len(names))
	for _, name := range names {
		scope := aboutPrimitiveScope("CACHE", name)
		reports = append(reports, AboutCache{
			Name:      name,
			IsDefault: name == "default",
			Driver:    str.Of(scope.Get("DRIVER", "memory")).TrimSpace().ToLower().String(),
			Summary:   aboutCacheSummary(name),
		})
	}
	return reports
}

func aboutQueueSummary(name string) string {
	scope := aboutPrimitiveScope("QUEUE", name)
	driver := str.Of(scope.Get("DRIVER", "workerpool")).TrimSpace().ToLower().String()
	switch driver {
	case "", "workerpool":
		workers := scope.Get("WORKERS", scope.Get("WORKERPOOL_WORKERS", "30"))
		return "workerpool · workers=" + strings.TrimSpace(workers)
	case "sync", "null":
		return driver
	case "redis":
		return "redis · " + aboutRedisSummary(scope, "QUEUE")
	default:
		return driver
	}
}

func aboutQueueReports() []AboutQueue {
	names := aboutScopedNames("QUEUE", aboutQueueRootKeys)
	reports := make([]AboutQueue, 0, len(names))
	for _, name := range names {
		scope := aboutPrimitiveScope("QUEUE", name)
		driver := str.Of(scope.Get("DRIVER", "workerpool")).TrimSpace().ToLower().String()
		if driver == "" {
			driver = "workerpool"
		}
		reports = append(reports, AboutQueue{
			Name:         name,
			IsDefault:    name == "default",
			Driver:       driver,
			DefaultQueue: strings.TrimSpace(scope.Get("DEFAULT_QUEUE", "default")),
			Workers:      strings.TrimSpace(scope.Get("WORKERS", scope.Get("WORKERPOOL_WORKERS", "30"))),
			Summary:      aboutQueueSummary(name),
		})
	}
	return reports
}

func aboutStorageSummary(name string) string {
	scope := aboutPrimitiveScope("STORAGE", name)
	driver := str.Of(scope.Get("DRIVER", "local")).TrimSpace().ToLower().String()
	switch driver {
	case "", "local":
		root := strings.TrimSpace(scope.Get("ROOT", ""))
		if root == "" {
			root = filepath.Join("storage", "app", name)
			if name == "default" {
				root = filepath.Join("storage", "app", "private")
			}
		}
		return "local · " + root
	case "memory":
		return "memory"
	case "redis":
		return "redis · " + aboutRedisSummary(scope, "STORAGE")
	case "s3":
		bucket := strings.TrimSpace(scope.Get("BUCKET", ""))
		region := strings.TrimSpace(scope.Get("REGION", ""))
		if bucket == "" {
			return "s3"
		}
		if region == "" {
			return "s3 · " + bucket
		}
		return "s3 · " + bucket + " (" + region + ")"
	default:
		return driver
	}
}

func aboutStorageReports() []AboutStorage {
	names := aboutScopedNames("STORAGE", aboutStorageRootKeys)
	reports := make([]AboutStorage, 0, len(names))
	for _, name := range names {
		scope := aboutPrimitiveScope("STORAGE", name)
		driver := str.Of(scope.Get("DRIVER", "local")).TrimSpace().ToLower().String()
		if driver == "" {
			driver = "local"
		}
		root := strings.TrimSpace(scope.Get("ROOT", ""))
		if root == "" && driver == "local" {
			root = filepath.Join("storage", "app", name)
			if name == "default" {
				root = filepath.Join("storage", "app", "private")
			}
		}
		reports = append(reports, AboutStorage{
			Name:      name,
			IsDefault: name == "default",
			Driver:    driver,
			Root:      root,
			Summary:   aboutStorageSummary(name),
		})
	}
	return reports
}

func aboutEventSummary() string {
	scope := env.WithPrefix("EVENTS")
	driver := str.Of(scope.Get("DRIVER", "inproc")).TrimSpace().ToLower().String()
	switch driver {
	case "", "inproc":
		return "inproc"
	case "null":
		return "null"
	case "redis":
		return "redis · " + aboutRedisSummary(scope, "EVENTS")
	case "nats", "natsjetstream":
		if url := strings.TrimSpace(scope.Get("URL", "")); url != "" {
			return driver + " · " + url
		}
		return driver
	case "kafka":
		if brokers := strings.TrimSpace(scope.Get("BROKERS", "")); brokers != "" {
			return "kafka · " + brokers
		}
		return "kafka"
	default:
		return driver
	}
}

func aboutEventReports() []AboutEvent {
	scope := env.WithPrefix("EVENTS")
	driver := str.Of(scope.Get("DRIVER", "inproc")).TrimSpace().ToLower().String()
	if driver == "" {
		driver = "inproc"
	}
	return []AboutEvent{
		{
			Name:      "default",
			IsDefault: true,
			Driver:    driver,
			Summary:   aboutEventSummary(),
		},
	}
}

func aboutPrimitiveScope(prefix, name string) env.Scope {
	scope := env.WithPrefix(prefix)
	if name == "" || name == "default" {
		return scope
	}
	return scope.Child(str.Of(name).Snake("_").ToUpper().String())
}

func aboutPrimitiveChildDefined(prefix string, scope env.Scope) bool {
	switch prefix {
	case "CACHE":
		return aboutAnySet(scope, "DRIVER", "FILE_DIR", "ADDR", "URL", "DSN")
	case "QUEUE":
		return aboutAnySet(scope, "DRIVER", "ADDR", "URL", "DSN", "WORKERS", "DEFAULT_QUEUE", "WORKERPOOL_WORKERS", "QUEUES")
	case "STORAGE":
		return aboutAnySet(scope, "DRIVER", "ROOT", "BUCKET", "REMOTE", "URL", "ADDR")
	default:
		return false
	}
}

func aboutDatabaseChildDefined(scope env.Scope) bool {
	return aboutAnySet(scope, "DRIVER", "DSN", "DATABASE", "HOST")
}

func aboutAnySet(scope env.Scope, keys ...string) bool {
	for _, key := range keys {
		if strings.TrimSpace(scope.Get(key, "")) != "" {
			return true
		}
	}
	return false
}

func aboutRedisSummary(scope env.Scope, prefix string) string {
	host := strings.TrimSpace(scope.Get("HOST", env.Get("REDIS_HOST", "")))
	if host == "" {
		host = strings.TrimSpace(scope.Get("ADDR", ""))
	}
	port := strings.TrimSpace(scope.Get("PORT", env.Get("REDIS_PORT", "")))
	db := strings.TrimSpace(scope.Get("DB", env.Get("REDIS_DB", "")))
	if addr := strings.TrimSpace(scope.Get("ADDR", "")); addr != "" && !strings.Contains(addr, ":") {
		host = addr
	}
	if addr := strings.TrimSpace(scope.Get("ADDR", "")); strings.Contains(addr, ":") {
		if db == "" {
			return "redis://" + addr
		}
		return "redis://" + addr + "/" + db
	}
	if host == "" {
		return strings.ToLower(prefix)
	}
	if port == "" {
		port = "6379"
	}
	if db == "" {
		db = "0"
	}
	return fmt.Sprintf("redis://%s:%s/%s", host, port, db)
}

func aboutMaskDSN(dsn string) string {
	dsn = strings.TrimSpace(dsn)
	if dsn == "" {
		return "-"
	}
	if strings.Contains(dsn, "@") && strings.Contains(dsn, ":") {
		parts := strings.SplitN(dsn, "@", 2)
		if len(parts) == 2 {
			creds := parts[0]
			if idx := strings.Index(creds, ":"); idx != -1 {
				return creds[:idx] + ":***@" + parts[1]
			}
		}
	}
	return dsn
}

func aboutPresence(path string) string {
	if _, err := os.Stat(path); err == nil {
		return "present"
	}
	return "missing"
}

func aboutEnabled(enabled bool) string {
	if enabled {
		return "true"
	}
	return "false"
}

func aboutKeyWidth(sections []aboutSection) int {
	width := 0
	for _, section := range sections {
		for _, row := range section.rows {
			if len(row.key) > width {
				width = len(row.key)
			}
		}
	}
	return width
}

func renderAboutSection(section aboutSection, width int) string {
	const leftPad = " "
	lines := []string{
		leftPad + console.Colorize(console.ColorGray, section.title) + " " + console.Colorize(console.ColorGray, section.value),
	}
	for _, row := range section.rows {
		key := fmt.Sprintf("%-*s", width, row.key)
		value := row.value
		if strings.TrimSpace(value) == "" {
			value = console.Colorize(console.ColorGray, "-")
		}
		lines = append(lines, leftPad+key+"  "+value)
	}
	return strings.Join(lines, "\n") + "\n"
}
