	signal.Notify(signals, os.Interrupt, syscall.SIGTERM)
	defer signal.Stop(signals)
	return waitCacheShellProcess(
		launch.Command,
		waitCh,
		signals,
		cacheShellDelegatedInterruptNeedsForwarding(),
		cmd.Process.Signal,
	)
}

