	for {
		select {
		case err := <-waitCh:
			if err == nil {
				return nil
			}
			return cacheShellProcessError(command, err)
		case received := <-signals:
			if received == os.Interrupt {
				if !forwardInterrupt || interruptForwarded {
					continue
				}
				interruptForwarded = true
			}
			_ = signalProcess(received)
