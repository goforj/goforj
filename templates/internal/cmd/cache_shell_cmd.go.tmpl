// parseCacheShellExec tokenizes single-quoted, double-quoted, and backslash-escaped values without evaluating shell expansions.
func parseCacheShellExec(value string) ([]string, error) {
	args := []string{}
	var token strings.Builder
	var quote rune
	escaped := false
	tokenStarted := false

	for _, char := range value {
		if escaped {
			token.WriteRune(char)
			escaped = false
			tokenStarted = true
			continue
		}
		if quote == '\'' {
			if char == '\'' {
				quote = 0
			} else {
				token.WriteRune(char)
			}
			tokenStarted = true
			continue
		}
		if char == '\\' {
			escaped = true
			tokenStarted = true
			continue
		}
		if quote == '"' {
			if char == '"' {
				quote = 0
			} else {
				token.WriteRune(char)
			}
			tokenStarted = true
			continue
		}
		switch char {
		case '\'', '"':
			quote = char
			tokenStarted = true
		default:
			if unicode.IsSpace(char) {
				if tokenStarted {
					args = append(args, token.String())
					token.Reset()
					tokenStarted = false
				}
				continue
			}
			token.WriteRune(char)
			tokenStarted = true
		}
	}
	if escaped {
		return nil, fmt.Errorf("command ends with an incomplete escape")
	}
	if quote != 0 {
		kind := "single"
		if quote == '"' {
			kind = "double"
		}
		return nil, fmt.Errorf("command has an unterminated %s quote", kind)
	}
	if tokenStarted {
		args = append(args, token.String())
	}
	if len(args) == 0 {
		return nil, fmt.Errorf("command is empty")
	}
	return args, nil
}

