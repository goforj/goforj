			code := exitErr.ExitCode()
			if status, ok := exitErr.Sys().(syscall.WaitStatus); ok && status.Signaled() {
				code = 128 + int(status.Signal())
			}
			return &cacheShellProcessExit{Command: command, Code: code}
		}
		return err
	}
	return nil
}

// cacheShellProcessEnv replaces inherited values so stale credentials cannot win by position.
func cacheShellProcessEnv(inherited []string, overrides map[string]string) []string {
	out := make([]string, 0, len(inherited)+len(overrides))
	for _, assignment := range inherited {
		key, _, _ := strings.Cut(assignment, "=")
		if _, replaced := overrides[key]; replaced {
			continue
		}
		out = append(out, assignment)
	}
	for _, key := range cacheShellSortedEnvKeys(overrides) {
		out = append(out, key+"="+overrides[key])
	}
	return out
}

// cacheShellSortedEnvKeys keeps argv and diagnostic output deterministic.
func cacheShellSortedEnvKeys(values map[string]string) []string {
	keys := make([]string, 0, len(values))
	for key := range values {
		keys = append(keys, key)
	}
	sort.Strings(keys)
	return keys
}

// localClient maps external store drivers to their native command-line clients.
func (s cacheShellStore) localClient() string {
	switch s.Driver {
	case "redis":
		return "redis-cli"
	default:
		return ""
	}
}

// composeService maps only generated local infrastructure to its stable service name.
func (s cacheShellStore) composeService() string {
	switch s.Driver {
	case "redis":
		return "redis"
	default:
		return ""
	}
}

// validateComposeTarget prevents fallback from changing the selected cache resource identity.
func (s cacheShellStore) validateComposeTarget(service string) error {
	host, _ := s.redisEndpoint(false)
	normalized := strings.Trim(strings.ToLower(strings.TrimSpace(host)), "[]")
	if normalized == "" {
		if address := strings.TrimSpace(s.Addr); address != "" {
			return fmt.Errorf("cache store %s has malformed Redis address %q and is not mapped to docker compose service %s", s.Name, maskCacheShellValue(address), service)
		}
		return fmt.Errorf("cache store %s has no Redis host and is not mapped to docker compose service %s", s.Name, service)
	}
	if normalized == strings.ToLower(service) || normalized == "localhost" {
		return nil
	}
	if ip := net.ParseIP(normalized); ip != nil && ip.IsLoopback() {
		return nil
	}
	return fmt.Errorf("cache store %s targets %s and is not mapped to docker compose service %s", s.Name, maskCacheShellValue(host), service)
}

// redisEndpoint preserves configured host addressing locally and uses container-loopback addressing in Compose.
func (s cacheShellStore) redisEndpoint(compose bool) (string, string) {
	if compose {
		return "127.0.0.1", "6379"
	}
	if address := strings.TrimSpace(s.Addr); address != "" {
		return splitCacheShellRedisAddress(address)
	}
	host := strings.TrimSpace(s.Host)
	if host == "" {
		host = strings.TrimSpace(env.Get("REDIS_HOST", ""))
	}
	if host == "" {
		host = "redis"
	}
	port := strings.TrimSpace(s.Port)
	if port == "" {
		port = strings.TrimSpace(env.Get("REDIS_PORT", ""))
	}
	if port == "" {
		port = "6379"
	}
	return host, port
}

// splitCacheShellRedisAddress preserves IPv4, hostnames, and bracketed IPv6 endpoints.
func splitCacheShellRedisAddress(address string) (string, string) {
	if host, port, err := net.SplitHostPort(address); err == nil {
		return host, port
	}
	if net.ParseIP(strings.Trim(address, "[]")) != nil {
		return strings.Trim(address, "[]"), "6379"
	}
	if strings.Count(address, ":") == 1 {
		host, port, _ := strings.Cut(address, ":")
		return strings.TrimSpace(host), strings.TrimSpace(port)
	}
	return address, "6379"
}

// summary renders a selector-safe endpoint description without exposing credentials.
func (s cacheShellStore) summary() string {
	switch s.Driver {
	case "redis":
		host, port := s.redisEndpoint(false)
		db := strings.TrimSpace(s.DB)
		if db == "" {
			db = "0"
		}
		return maskCacheShellValue(host+":"+port) + "/" + db
	}
	return "-"
}

// cacheShellInteractive requires both input and output terminals before enabling selectors or Compose TTY allocation.
func cacheShellInteractive() bool {
	stdin, err := os.Stdin.Stat()
	if err != nil || stdin.Mode()&os.ModeCharDevice == 0 {
		return false
	}
	stdout, err := os.Stdout.Stat()
	return err == nil && stdout.Mode()&os.ModeCharDevice != 0
}

// cacheShellEnv mirrors generated cache scoping and shared Redis fallbacks for one discovered instance.
func cacheShellEnv(name, suffix string) string {
	if suffix == "HOST" {
		return strings.TrimSpace(env.Get("REDIS_HOST", ""))
	}
	if suffix == "PORT" {
		return strings.TrimSpace(env.Get("REDIS_PORT", ""))
	}
	scope := env.WithPrefix("CACHE")
	selected := scope
	if name != "" && name != "default" {
		selected = scope.Child(str.Of(name).Snake().ToUpper().String())
	}
	if suffix == "DB" {
		db := selected.GetInt("DB", env.Get("REDIS_DB", "0"))
		if db < 0 {
			db = 0
		}
		return strconv.Itoa(db)
	}
	value := selected.Get(suffix, "")
	if suffix == "PASSWORD" {
		if value != "" {
			return value
		}
	} else if value = strings.TrimSpace(value); value != "" {
		return value
	}
	switch suffix {
	case "PASSWORD":
		return env.Get("REDIS_PASSWORD", "")
	default:
		return ""
	}
}

// cacheShellBoolEnv accepts the same common truthy spellings used by generated environment configuration.
func cacheShellBoolEnv(name, suffix string) bool {
	value := str.Of(cacheShellEnv(name, suffix)).ToLower().Trim().String()
	return value == "1" || value == "true" || value == "yes" || value == "on"
}

// cacheShellEnvKey formats actionable diagnostics with generated snake-case environment keys.
func cacheShellEnvKey(name, suffix string) string {
	if name == "" || name == "default" {
		return "CACHE_" + suffix
	}
	return "CACHE_" + str.Of(name).Snake().ToUpper().String() + "_" + suffix
}

// normalizeCacheShellStoreName presents discovered snake-case names through the documented kebab-case CLI contract.
func normalizeCacheShellStoreName(name string) string {
	value := str.Of(name).Trim().Kebab().ToLower().String()
	if value == "" {
		return "default"
	}
	return value
}

// cacheShellCheckDockerCompose verifies the Compose plugin before taking over the terminal.
func cacheShellCheckDockerCompose() error {
	if _, err := exec.LookPath("docker"); err != nil {
		return fmt.Errorf("docker client not found: %w", err)
	}
	check := exec.Command("docker", "compose", "version")
	check.Stdout = io.Discard
	check.Stderr = io.Discard
	if err := check.Run(); err != nil {
		return fmt.Errorf("docker compose command is not available: %w", err)
	}
	return nil
}

// cacheShellComposeServiceExists limits fallback to the generated Compose file in the App root.
func cacheShellComposeServiceExists(service string) bool {
	if service == "" {
		return false
	}
	data, err := os.ReadFile("docker-compose.yml")
	if err != nil {
		return false
	}
	return cacheShellComposeDefinesService(data, service)
}

// cacheShellComposeDefinesService ignores same-named volumes and other nested YAML keys.
func cacheShellComposeDefinesService(source []byte, service string) bool {
	inServices := false
	for _, line := range strings.Split(string(source), "\n") {
		trimmed := strings.TrimSpace(line)
		if trimmed == "" || strings.HasPrefix(trimmed, "#") {
			continue
		}
		indent := len(line) - len(strings.TrimLeft(line, " "))
		if indent == 0 {
			inServices = trimmed == "services:"
			continue
		}
		if inServices && indent == 2 && trimmed == service+":" {
			return true
		}
	}
	return false
}

// formatCacheShellCommand renders a shell-readable diagnostic without exposing Redis credentials.
func formatCacheShellCommand(launch cacheShellLaunch, mask bool) string {
	parts := []string{}
	for _, key := range cacheShellSortedEnvKeys(launch.Env) {
		value := launch.Env[key]
		if mask && value != "" {
			value = "***"
		}
		parts = append(parts, key+"="+shellQuoteCacheShell(value))
	}
	parts = append(parts, launch.Command)
	args := append([]string(nil), launch.Args...)
	if mask {
		args = maskCacheShellArgs(args)
	}
	for _, arg := range args {
		parts = append(parts, shellQuoteCacheShell(arg))
	}
	return strings.Join(parts, " ")
}

// maskCacheShellArgs redacts redis-cli credential flags, AUTH commands, assignments, and URLs.
func maskCacheShellArgs(args []string) []string {
	out := append([]string(nil), args...)
	maskCommandRemainder := false
	for i := 0; i < len(out); i++ {
		if maskCommandRemainder {
			out[i] = "***"
			continue
		}
		lower := strings.ToLower(out[i])
		if lower == "auth" || lower == "requirepass" || lower == "masterauth" {
			maskCommandRemainder = true
			continue
		}
		switch lower {
		case "-a", "--pass", "--password", "--auth":
			if i+1 < len(out) {
				out[i+1] = "***"
				i++
			}
			continue
		}
		for _, prefix := range []string{"--pass=", "--password=", "--auth=", "rediscli_auth="} {
			if strings.HasPrefix(lower, prefix) {
				key, _, _ := strings.Cut(out[i], "=")
				out[i] = key + "=***"
				lower = strings.ToLower(out[i])
				break
			}
		}
		if strings.HasPrefix(lower, "-a") && len(out[i]) > 2 {
			out[i] = "-a***"
			continue
		}
		out[i] = maskCacheShellValue(out[i])
	}
	return out
}

// shellQuoteCacheShell makes printed argv unambiguous without participating in execution.
func shellQuoteCacheShell(value string) string {
	if value == "" {
		return "''"
	}
	if strings.IndexFunc(value, func(r rune) bool {
		return !(r == '-' || r == '_' || r == '.' || r == '/' || r == ':' || r == '=' || r == '@' || r == ',' || r == '+' || r >= '0' && r <= '9' || r >= 'A' && r <= 'Z' || r >= 'a' && r <= 'z')
	}) == -1 {
		return value
	}
	return "'" + strings.ReplaceAll(value, "'", "'\"'\"'") + "'"
}

// maskCacheShellValue removes URL credentials and explicit secret assignments from diagnostics.
func maskCacheShellValue(value string) string {
	value = maskCacheShellRawSecrets(value)
	if parsed, err := url.Parse(value); err == nil && parsed.Scheme != "" && parsed.Host != "" {
		changed := false
		if parsed.User != nil {
			if _, ok := parsed.User.Password(); ok {
				parsed.User = url.UserPassword(parsed.User.Username(), "***")
				changed = true
			}
		}
		query := parsed.Query()
		for key := range query {
			if cacheShellSecretKey(key) {
				query.Set(key, "***")
				changed = true
			}
		}
		if changed {
			parsed.RawQuery = query.Encode()
			value = parsed.String()
		}
	}
	if key, _, ok := strings.Cut(value, "="); ok && cacheShellSecretKey(key) {
		return key + "=***"
	}
	return value
}

// maskCacheShellRawSecrets conservatively redacts user-info and secret query assignments even when URL parsing fails.
func maskCacheShellRawSecrets(value string) string {
	value = maskCacheShellRawUserInfo(value)
	queryStart := strings.IndexByte(value, '?')
	if queryStart < 0 {
		return value
	}
	queryEnd := strings.IndexByte(value[queryStart+1:], '#')
	if queryEnd < 0 {
		queryEnd = len(value)
	} else {
		queryEnd += queryStart + 1
	}
	parts := strings.Split(value[queryStart+1:queryEnd], "&")
	for i, part := range parts {
		key, _, ok := strings.Cut(part, "=")
		decodedKey, err := url.QueryUnescape(key)
		if err != nil {
			decodedKey = key
		}
		if ok && cacheShellSecretKey(decodedKey) {
			parts[i] = key + "=***"
		}
	}
	return value[:queryStart+1] + strings.Join(parts, "&") + value[queryEnd:]
}

// maskCacheShellRawUserInfo removes a password-shaped authority segment without requiring a valid URL.
func maskCacheShellRawUserInfo(value string) string {
	authorityStart := 0
	if scheme := strings.Index(value, "://"); scheme >= 0 {
		authorityStart = scheme + 3
	}
	authorityEnd := len(value)
	if boundary := strings.IndexAny(value[authorityStart:], "/?#"); boundary >= 0 {
		authorityEnd = authorityStart + boundary
	}
	authority := value[authorityStart:authorityEnd]
	at := strings.LastIndexByte(authority, '@')
	if at < 0 {
		return value
	}
	colon := strings.IndexByte(authority[:at], ':')
	if colon < 0 {
		return value
	}
	secretStart := authorityStart + colon + 1
	secretEnd := authorityStart + at
	return value[:secretStart] + "***" + value[secretEnd:]
}

// cacheShellSecretKey identifies values that must never appear in diagnostic output.
func cacheShellSecretKey(key string) bool {
	lower := strings.ToLower(strings.TrimSpace(key))
	return strings.Contains(lower, "password") || strings.Contains(lower, "passwd") || strings.Contains(lower, "pwd") || strings.Contains(lower, "token") || strings.Contains(lower, "secret") || strings.Contains(lower, "auth")
}
