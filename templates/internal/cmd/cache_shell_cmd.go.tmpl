		service := ""
		for i := 0; i < len(launch.Args); i++ {
			if launch.Args[i] == "-T" {
				continue
			}
			if launch.Args[i] == "-e" {
				i++
				continue
			}
			if i >= 2 {
				service = launch.Args[i]
				break
			}
		}
		if service != "" {
			return "docker compose service " + service
		}
		return "docker compose"
	}
	return "local " + launch.Command
}

