// TestCacheShellComposeAvailabilityRequiresPlugin verifies an installed Docker CLI alone is insufficient.
func TestCacheShellComposeAvailabilityRequiresPlugin(t *testing.T) {
	if runtime.GOOS == "windows" {
		t.Skip("requires a POSIX shell fixture to emulate a failing Docker CLI")
	}
	root := t.TempDir()
	if err := os.WriteFile(filepath.Join(root, "docker-compose.yml"), []byte("services:\n  redis:\n    image: redis\n"), 0o600); err != nil {
		t.Fatalf("write compose file: %v", err)
	}
	bin := filepath.Join(root, "bin")
	if err := os.Mkdir(bin, 0o700); err != nil {
		t.Fatalf("make bin directory: %v", err)
	}
	docker := filepath.Join(bin, "docker")
	if err := os.WriteFile(docker, []byte("#!/bin/sh\nprintf '%s' \"$*\" > \"$CACHE_SHELL_DOCKER_LOG\"\nexit 23\n"), 0o700); err != nil {
		t.Fatalf("write fake docker: %v", err)
	}
	logPath := filepath.Join(root, "docker.log")
	t.Setenv("PATH", bin)
	t.Setenv("CACHE_SHELL_DOCKER_LOG", logPath)
	previous, err := os.Getwd()
	if err != nil {
		t.Fatalf("working directory: %v", err)
	}
	if err := os.Chdir(root); err != nil {
		t.Fatalf("change working directory: %v", err)
	}
	t.Cleanup(func() { _ = os.Chdir(previous) })

	command := &CacheShellCmd{Method: "compose"}
	_, err = command.composeLaunch(cacheShellStore{Name: "default", Driver: "redis", Addr: "redis:6379"})
	if err == nil || !strings.Contains(err.Error(), "docker compose command is not available") {
		t.Fatalf("compose availability error = %v", err)
	}
	called, readErr := os.ReadFile(logPath)
	if readErr != nil {
		t.Fatalf("read fake docker log: %v", readErr)
	}
	if strings.TrimSpace(string(called)) != "compose version" {
		t.Fatalf("docker check args = %q, want compose version", called)
	}
}

