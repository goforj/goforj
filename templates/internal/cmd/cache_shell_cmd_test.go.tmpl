// TestCacheShellPrintMasksRedisCredentials verifies positional, inline, command, assignment, and URL secrets never reach --print.
func TestCacheShellPrintMasksRedisCredentials(t *testing.T) {
	launch := cacheShellLaunch{
		Command: "redis-cli",
		Env:     map[string]string{"REDISCLI_AUTH": "environment-secret"},
		Args: []string{
			"-a", "short-secret",
			"--pass", "long-secret",
			"--pass=inline-secret",
			"-u", "rediss://app:url-secret@redis:6379/0",
			"REDISCLI_AUTH=assignment-secret",
			"AUTH", "command-secret",
		},
	}
	printed := formatCacheShellCommand(launch, true)
	for _, secret := range []string{
		"environment-secret",
		"short-secret",
		"long-secret",
		"inline-secret",
		"url-secret",
		"assignment-secret",
		"command-secret",
	} {
		if strings.Contains(printed, secret) {
			t.Fatalf("formatCacheShellCommand() exposed %q in %q", secret, printed)
		}
	}
	if !strings.Contains(printed, "***") || !strings.Contains(printed, "redis-cli") {
		t.Fatalf("formatCacheShellCommand() = %q, want masked runnable shape", printed)
	}
	if cleared := formatCacheShellCommand(cacheShellLaunch{Command: "redis-cli", Env: map[string]string{"REDISCLI_AUTH": ""}}, true); !strings.Contains(cleared, "REDISCLI_AUTH=''") {
		t.Fatalf("empty auth diagnostic = %q, want explicit clearing", cleared)
	}
}

