// TestWaitCacheShellProcessForwardsDelegatedInterruptOnce verifies source-delegated SIGINT reaches the client without repeated delivery.
func TestWaitCacheShellProcessForwardsDelegatedInterruptOnce(t *testing.T) {
	waitCh := make(chan error, 1)
	signals := make(chan os.Signal, 3)
	forwarded := make(chan os.Signal, 3)
	done := make(chan error, 1)
	go func() {
		done <- waitCacheShellProcess("redis-cli", waitCh, signals, true, func(signal os.Signal) error {
			forwarded <- signal
			return nil
		})
	}()
	signals <- os.Interrupt
	signals <- os.Interrupt
	signals <- syscall.SIGTERM
	if first, second := <-forwarded, <-forwarded; first != os.Interrupt || second != syscall.SIGTERM {
		t.Fatalf("forwarded signals = [%v %v], want [interrupt terminated]", first, second)
	}
	waitCh <- nil
	if err := <-done; err != nil {
		t.Fatalf("waitCacheShellProcess() error = %v", err)
	}
	if len(forwarded) != 0 {
		t.Fatalf("waitCacheShellProcess() forwarded repeated interrupt")
	}
	directWait := make(chan error, 1)
	directSignals := make(chan os.Signal, 2)
	directForwarded := make(chan os.Signal, 1)
	directDone := make(chan error, 1)
	go func() {
		directDone <- waitCacheShellProcess("redis-cli", directWait, directSignals, false, func(signal os.Signal) error {
			directForwarded <- signal
			return nil
		})
	}()
	directSignals <- os.Interrupt
	directSignals <- syscall.SIGTERM
	if received := <-directForwarded; received != syscall.SIGTERM {
		t.Fatalf("direct forwarded signal = %v, want SIGTERM", received)
	}
	directWait <- nil
	if err := <-directDone; err != nil {
		t.Fatalf("direct waitCacheShellProcess() error = %v", err)
	}
	t.Setenv("FORJ_COMMAND_PREFIX", "forj")
	if !cacheShellDelegatedInterruptNeedsForwarding() {
		t.Fatal("delegated interrupt was not detected")
	}
	t.Setenv("FORJ_COMMAND_PREFIX", "")
	if cacheShellDelegatedInterruptNeedsForwarding() {
		t.Fatal("direct command unexpectedly enabled interrupt forwarding")
	}
}

