package cmd

import (
	"github.com/goforj/str"
	"{{.GoModuleName}}/internal/dbconns"
)

// GenerateAllCmd runs all available generators.
type GenerateAllCmd struct {
	// Only limits generation to the selected generator names.
	Only []string `help:"Run only the selected generators" placeholder:"dbconns" short:"o"`

	// DbConns controls DB connection accessor generation.
	DbConns bool `help:"Generate DB connection accessors" default:"true"`

	generateDbConns *dbconns.GenerateCmd
}

// NewGenerateAllCmd creates a new GenerateAllCmd.
func NewGenerateAllCmd(generateDbConns *dbconns.GenerateCmd) *GenerateAllCmd {
	return &GenerateAllCmd{
		generateDbConns: generateDbConns,
	}
}

// Run executes enabled generators.
func (c *GenerateAllCmd) Run() error {
	only := map[string]struct{}{}
	for _, name := range c.Only {
		for _, part := range str.Of(name).Split(",") {
			trimmed := str.Of(part).TrimSpace().String()
			if str.Of(trimmed).IsEmpty() {
				continue
			}
			only[trimmed] = struct{}{}
		}
	}
	if len(only) > 0 {
		if _, ok := only["dbconns"]; ok {
			if err := c.generateDbConns.Run(); err != nil {
				return err
			}
		}
		return nil
	}

	if c.DbConns {
		if err := c.generateDbConns.Run(); err != nil {
			return err
		}
	}
	return nil
}
