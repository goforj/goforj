package cmd

import (
	"context"
	"encoding/json"
	"fmt"
	"io"
	"net/http"
	"net/url"
	"strings"
	"time"

	"github.com/goforj/env/v2"
	"github.com/goforj/httpx"
	"{{.GoModuleName}}/internal/console"
	"{{.GoModuleName}}/internal/runtime"
)

const (
	healthSectionMarker = "♦"
	healthContentIndent = "  "
	healthColumnGap     = "  "
)

// HealthCmd queries a live app health or readiness endpoint without booting local runtime dependencies.
type HealthCmd struct {
	URL       string `help:"Base app URL or full probe URL"`
	Probe     string `help:"Probe to query" enum:"ready,health" default:"ready"`
	TimeoutMs int    `help:"Request timeout in milliseconds" default:"2000"`
	JSON      bool   `help:"Print command result as JSON"`
	NoColor   bool   `help:"Disable ANSI colors"`
	Fail      bool   `help:"Exit non-zero when probe is not healthy"`
}

type healthProbeResponse struct {
	Status string             `json:"status"`
	Checks []healthProbeCheck `json:"checks,omitempty"`
}

type healthProbeCheck struct {
	Type   string `json:"type"`
	Name   string `json:"name"`
	Status string `json:"status"`
	Driver string `json:"driver,omitempty"`
	Error  string `json:"error,omitempty"`
}

// Signature defines CLI metadata for this command.
func (*HealthCmd) Signature() string {
	return `name:"health" help:"Query a live app readiness or liveness endpoint" goforj:"preboot"`
}

// NewHealthCmd creates a new HealthCmd.
func NewHealthCmd() *HealthCmd {
	return &HealthCmd{Probe: "ready", TimeoutMs: 2000}
}

// Run executes the command.
func (c *HealthCmd) Run(ctx context.Context) error {
	if strings.TrimSpace(c.Probe) == "" {
		c.Probe = "ready"
	}
	if c.TimeoutMs <= 0 {
		c.TimeoutMs = 2000
	}

	endpoint, err := c.probeURL()
	if err != nil {
		return err
	}

	reqCtx, cancel := context.WithTimeout(ctx, time.Duration(c.TimeoutMs)*time.Millisecond)
	defer cancel()

	client := httpx.New()
	req := client.Req().R().SetContext(reqCtx)
	if token := strings.TrimSpace(env.Get("APP_DIAG_TOKEN", "")); token != "" && c.Probe == "ready" {
		req.SetHeader("Authorization", "Bearer "+token)
	}
	resp, err := req.Get(endpoint)
	if err != nil {
		return fmt.Errorf("request probe: %w", err)
	}
	if resp == nil || resp.Response == nil {
		return fmt.Errorf("request probe: empty response")
	}
	defer resp.Response.Body.Close()

	body, err := io.ReadAll(resp.Response.Body)
	if err != nil {
		return fmt.Errorf("read probe response: %w", err)
	}

	var payload healthProbeResponse
	if err := json.Unmarshal(body, &payload); err != nil {
		return fmt.Errorf("decode probe response: %w", err)
	}

	if c.JSON {
		return printJSON(map[string]any{
			"url":         endpoint,
			"probe":       c.Probe,
			"http_status": resp.Response.StatusCode,
			"ok":          c.probeOK(resp.Response.StatusCode, payload),
			"status":      payload.Status,
			"checks":      payload.Checks,
		})
	}

	c.printHealthReport(endpoint, resp.Response.StatusCode, payload)
	if c.Fail && !c.probeOK(resp.Response.StatusCode, payload) {
		return fmt.Errorf("probe reported %s", payloadStatusLabel(payload.Status, resp.Response.StatusCode))
	}
	return nil
}

func (c *HealthCmd) probeURL() (string, error) {
	raw := strings.TrimSpace(c.URL)
	if raw == "" {
		raw = strings.TrimSpace(env.Get("APP_URL", ""))
	}
	if raw == "" {
		raw = "http://127.0.0.1:" + runtime.HTTPPort()
	}
	if !strings.Contains(raw, "://") {
		raw = "http://" + raw
	}

	parsed, err := url.Parse(raw)
	if err != nil {
		return "", fmt.Errorf("parse url: %w", err)
	}
	if parsed.Host == "" {
		return "", fmt.Errorf("url must include a host")
	}
	switch parsed.Path {
	case "", "/":
		parsed.Path = "/-/" + c.Probe
	case "/-/health", "/-/ready":
	default:
	}
	return parsed.String(), nil
}

func (c *HealthCmd) probeOK(statusCode int, payload healthProbeResponse) bool {
	switch c.Probe {
	case "health":
		return statusCode == http.StatusOK && strings.EqualFold(strings.TrimSpace(payload.Status), "ok")
	default:
		return statusCode == http.StatusOK && strings.EqualFold(strings.TrimSpace(payload.Status), "ready")
	}
}

func (c *HealthCmd) printHealthReport(endpoint string, statusCode int, payload healthProbeResponse) {
	fmt.Printf("%s · HTTP %d · %s\n", c.renderStatus(payload.Status, statusCode), statusCode, c.colorize(console.ColorGray, endpoint))

	rows := healthReportRows(c.Probe, statusCode, payload)
	if len(rows) == 0 {
		return
	}
	fmt.Println()

	widths := computeHealthReportColumnWidths(rows)
	sections := healthReportSections(rows)
	for idx, section := range sections {
		if idx > 0 {
			fmt.Println()
		}
		fmt.Println(c.renderHealthSectionHeader(section.Title))
		for _, row := range section.Rows {
			fmt.Println(c.renderHealthRow(row, widths))
		}
	}
}

func (c *HealthCmd) renderStatus(status string, statusCode int) string {
	label := payloadStatusLabel(status, statusCode)
	return c.colorize(c.statusColor(status, statusCode), c.statusSymbol(status, statusCode)+" "+label)
}

func (c *HealthCmd) renderCheckStatus(status string) string {
	label := payloadStatusLabel(status, 0)
	if strings.TrimSpace(label) == "" {
		label = "unknown"
	}
	return c.colorize(c.statusColor(status, 0), c.statusSymbol(status, 0)+" "+label)
}

func (c *HealthCmd) statusSymbol(status string, statusCode int) string {
	switch strings.ToLower(strings.TrimSpace(status)) {
	case "ok", "ready":
		return "✓"
	case "failed", "not_ready":
		return "✗"
	}
	if statusCode >= 500 {
		return "✗"
	}
	if statusCode >= 400 {
		return "!"
	}
	return "·"
}

func (c *HealthCmd) statusColor(status string, statusCode int) string {
	switch strings.ToLower(strings.TrimSpace(status)) {
	case "ok", "ready":
		return console.ColorGreen
	case "failed", "not_ready":
		return console.ColorRed
	}
	if statusCode >= 500 {
		return console.ColorRed
	}
	if statusCode >= 400 {
		return console.ColorYellow
	}
	return console.ColorGray
}

func (c *HealthCmd) renderHealthSectionHeader(title string) string {
	return c.colorize(console.ColorCyan, healthSectionMarker) + " " + c.colorize(console.ColorBoldWhite, title)
}

func (c *HealthCmd) renderHealthRow(row healthReportRow, widths healthReportColumnWidths) string {
	name := fmt.Sprintf("%-*s", widths.name, row.Name)
	parts := []string{healthContentIndent + name}
	if widths.driver > 0 {
		driver := fmt.Sprintf("%-*s", widths.driver, renderDriver(row.Driver))
		parts = append(parts, c.colorize(console.ColorGreen, driver))
	}
	parts = append(parts, c.renderCheckStatus(row.Status))
	if detail := strings.TrimSpace(row.Details); detail != "" {
		parts = append(parts, c.colorize(console.ColorGray, detail))
	}
	return strings.Join(parts, healthColumnGap)
}

func (c *HealthCmd) colorize(color string, value string) string {
	if c.NoColor {
		return value
	}
	return console.Colorize(color, value)
}

type healthReportRow struct {
	Type    string
	Name    string
	Driver  string
	Status  string
	Details string
}

type healthReportSection struct {
	Title string
	Rows  []healthReportRow
}

type healthReportColumnWidths struct {
	name   int
	driver int
}

func healthReportRows(probe string, statusCode int, payload healthProbeResponse) []healthReportRow {
	if len(payload.Checks) == 0 {
		return []healthReportRow{
			{
				Type:   probe,
				Name:   "overall",
				Status: payload.Status,
			},
		}
	}

	rows := make([]healthReportRow, 0, len(payload.Checks))
	for _, check := range payload.Checks {
		rows = append(rows, healthReportRow{
			Type:    check.Type,
			Name:    healthDisplayValue(check.Name, "default"),
			Driver:  strings.TrimSpace(check.Driver),
			Status:  check.Status,
			Details: strings.TrimSpace(check.Error),
		})
	}
	return rows
}

func healthReportSections(rows []healthReportRow) []healthReportSection {
	sections := make([]healthReportSection, 0)
	sectionIndexes := map[string]int{}
	for _, row := range rows {
		title := healthSectionTitle(row.Type)
		idx, ok := sectionIndexes[title]
		if !ok {
			idx = len(sections)
			sectionIndexes[title] = idx
			sections = append(sections, healthReportSection{Title: title})
		}
		sections[idx].Rows = append(sections[idx].Rows, row)
	}
	return sections
}

func computeHealthReportColumnWidths(rows []healthReportRow) healthReportColumnWidths {
	widths := healthReportColumnWidths{name: 7}
	for _, row := range rows {
		if width := len(row.Name); width > widths.name {
			widths.name = width
		}
		if driver := renderDriver(row.Driver); driver != "" && driver != "-" && len(driver) > widths.driver {
			widths.driver = len(driver)
		}
	}
	return widths
}

func healthSectionTitle(value string) string {
	switch strings.ToLower(strings.TrimSpace(value)) {
	case "cache", "caches":
		return "Caches"
	case "db", "database", "databases":
		return "Databases"
	case "storage", "storages":
		return "Storages"
	case "event", "events":
		return "Events"
	case "queue", "queues":
		return "Queues"
	case "health":
		return "Health"
	case "ready", "readiness":
		return "Ready"
	default:
		clean := strings.TrimSpace(value)
		if clean == "" {
			return "Checks"
		}
		return strings.ToUpper(clean[:1]) + clean[1:]
	}
}

func healthDisplayValue(value string, fallback string) string {
	value = strings.TrimSpace(value)
	if value == "" {
		return fallback
	}
	return value
}

func payloadStatusLabel(status string, statusCode int) string {
	label := strings.TrimSpace(status)
	if label != "" {
		return strings.ReplaceAll(label, "_", " ")
	}
	if statusCode == http.StatusOK {
		return "ok"
	}
	return http.StatusText(statusCode)
}
func renderDriver(driver string) string {
	driver = strings.TrimSpace(driver)
	if driver == "" {
		return ""
	}
	return driver
}
