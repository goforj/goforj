package cmd

import (
	"bytes"
	"net/http"
	"net/http/httptest"
	"os"
	"strings"
	"testing"
)

func TestHealthCmdReadinessTable(t *testing.T) {
	t.Setenv("CACHE_DRIVER", "memory")
	t.Setenv("DB_DRIVER", "mysql")

	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if r.URL.Path != "/-/ready" {
			t.Fatalf("unexpected path %q", r.URL.Path)
		}
		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(http.StatusServiceUnavailable)
		_, _ = w.Write([]byte(`{"status":"not_ready","checks":[{"type":"cache","name":"default","status":"ok"},{"type":"db","name":"default","status":"failed"}]}`))
	}))
	defer server.Close()

	cmd := NewHealthCmd()
	cmd.URL = server.URL
	cmd.NoColor = true

	output := captureHealthCmdStdout(t, func() error {
		return cmd.Run()
	})
	if !strings.Contains(output, "not ready") {
		t.Fatalf("expected output to include overall not ready status, got:\n%s", output)
	}
	if !strings.Contains(output, "Driver") {
		t.Fatalf("expected output to include driver column, got:\n%s", output)
	}
	if !strings.Contains(output, "memory") || !strings.Contains(output, "mysql") {
		t.Fatalf("expected output to include inferred drivers, got:\n%s", output)
	}
}

func TestHealthCmdEnrichHealthChecksInfersDrivers(t *testing.T) {
	t.Setenv("CACHE_DRIVER", "memory")
	t.Setenv("DB_DRIVER", "mysql")
	t.Setenv("STORAGE_DRIVER", "local")

	checks := []healthProbeCheck{
		{Type: "cache", Name: "default", Status: "ok"},
		{Type: "db", Name: "default", Status: "failed"},
		{Type: "storage", Name: "default", Status: "ok"},
		{Type: "queue", Name: "missing", Status: "ok"},
	}

	cmd := NewHealthCmd()
	cmd.enrichHealthChecks(checks)

	if checks[0].Driver != "memory" {
		t.Fatalf("cache driver = %q, want memory", checks[0].Driver)
	}
	if checks[1].Driver != "mysql" {
		t.Fatalf("db driver = %q, want mysql", checks[1].Driver)
	}
	if checks[2].Driver != "local" {
		t.Fatalf("storage driver = %q, want local", checks[2].Driver)
	}
	if checks[3].Driver != "" {
		t.Fatalf("missing queue driver = %q, want empty", checks[3].Driver)
	}
}

func TestHealthCmdJSON(t *testing.T) {
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if r.URL.Path != "/-/health" {
			t.Fatalf("unexpected path %q", r.URL.Path)
		}
		w.Header().Set("Content-Type", "application/json")
		_, _ = w.Write([]byte(`{"status":"ok"}`))
	}))
	defer server.Close()

	cmd := NewHealthCmd()
	cmd.URL = server.URL
	cmd.Probe = "health"
	cmd.JSON = true

	output := captureHealthCmdStdout(t, func() error {
		return cmd.Run()
	})
	if !strings.Contains(output, `"http_status":200`) {
		t.Fatalf("expected json output to include http status, got:\n%s", output)
	}
	if !strings.Contains(output, `"status":"ok"`) {
		t.Fatalf("expected json output to include status, got:\n%s", output)
	}
}

func TestHealthCmdFailReturnsError(t *testing.T) {
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(http.StatusServiceUnavailable)
		_, _ = w.Write([]byte(`{"status":"not_ready","checks":[]}`))
	}))
	defer server.Close()

	cmd := NewHealthCmd()
	cmd.URL = server.URL
	cmd.NoColor = true
	cmd.Fail = true

	err := cmd.Run()
	if err == nil {
		t.Fatal("expected fail mode to return an error")
	}
	if !strings.Contains(err.Error(), "not ready") {
		t.Fatalf("expected not ready error, got %v", err)
	}
}

func captureHealthCmdStdout(t *testing.T, run func() error) string {
	t.Helper()

	orig := os.Stdout
	r, w, err := os.Pipe()
	if err != nil {
		t.Fatalf("pipe stdout: %v", err)
	}
	os.Stdout = w
	defer func() {
		os.Stdout = orig
	}()

	runErr := run()
	_ = w.Close()

	var buf bytes.Buffer
	if _, err := buf.ReadFrom(r); err != nil {
		t.Fatalf("read stdout: %v", err)
	}
	_ = r.Close()

	if runErr != nil && !strings.Contains(runErr.Error(), "not ready") {
		t.Fatalf("run health cmd: %v", runErr)
	}

	return buf.String()
}
