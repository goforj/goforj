func TestHealthCmdReadinessInventory(t *testing.T) {
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if r.URL.Path != "/-/ready" {
			t.Fatalf("unexpected path %q", r.URL.Path)
		}
		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(http.StatusServiceUnavailable)
		_, _ = w.Write([]byte(`{"status":"not_ready"}`))
	}))
	defer server.Close()

	cmd := NewHealthCmd()
	cmd.URL = server.URL
	cmd.NoColor = true

	output := captureHealthCmdStdout(t, func() error {
		return cmd.Run(context.Background())
	})
	if !strings.Contains(output, "not ready") {
		t.Fatalf("expected output to include overall not ready status, got:\n%s", output)
	}
	if !strings.Contains(output, "overall") {
		t.Fatalf("expected output to include overall readiness row, got:\n%s", output)
	}
	if !strings.Contains(output, "♦ Ready") {
		t.Fatalf("expected output to include ready section, got:\n%s", output)
	}
	if strings.Contains(output, "TYPE") || strings.Contains(output, "┌") {
		t.Fatalf("expected inventory output without table headers or borders, got:\n%s", output)
	}
}

func TestHealthCmdUsesAppDiagTokenForFullDetail(t *testing.T) {
	t.Setenv("APP_DIAG_TOKEN", "diag-token")

	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if got := r.Header.Get("Authorization"); got != "Bearer diag-token" {
			t.Fatalf("authorization header = %q", got)
		}
		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(http.StatusServiceUnavailable)
		_, _ = w.Write([]byte(`{"status":"not_ready","checks":[{"type":"cache","name":"default","driver":"memory","status":"failed","error":"cache backend unavailable"}]}`))
	}))
	defer server.Close()

	cmd := NewHealthCmd()
	cmd.URL = server.URL
	cmd.NoColor = true

	output := captureHealthCmdStdout(t, func() error {
		return cmd.Run(context.Background())
	})
	if !strings.Contains(output, "cache backend unavailable") {
		t.Fatalf("expected output to include detailed error, got:\n%s", output)
	}
	if !strings.Contains(output, "♦ Caches") {
		t.Fatalf("expected output to group cache checks, got:\n%s", output)
	}
}

func TestHealthCmdGroupsResourceChecks(t *testing.T) {
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		_, _ = w.Write([]byte(`{"status":"ready","checks":[{"type":"cache","name":"default","driver":"redis","status":"ok"},{"type":"db","name":"primary","driver":"mysql","status":"ok"},{"type":"cache","name":"sessions","driver":"memory","status":"ok"},{"type":"queue","name":"email","driver":"redis","status":"ok"}]}`))
	}))
	defer server.Close()

	cmd := NewHealthCmd()
	cmd.URL = server.URL
	cmd.NoColor = true

	output := captureHealthCmdStdout(t, func() error {
		return cmd.Run(context.Background())
	})
	for _, want := range []string{
		"✓ ready · HTTP 200 · ",
		"♦ Caches",
		"  default   redis   ✓ ok",
		"  sessions  memory  ✓ ok",
		"♦ Databases",
		"  primary   mysql   ✓ ok",
		"♦ Queues",
		"  email     redis   ✓ ok",
	} {
		if !strings.Contains(output, want) {
			t.Fatalf("expected health output to contain %q, got:\n%s", want, output)
		}
	}
	if count := strings.Count(output, "♦ Caches"); count != 1 {
		t.Fatalf("expected cache checks to share one section, got %d cache sections:\n%s", count, output)
	}
}

func TestHealthCmdDefaultsToAppURL(t *testing.T) {
	t.Setenv("APP_URL", "http://localhost:3015")

	cmd := NewHealthCmd()
	got, err := cmd.probeURL()
	if err != nil {
		t.Fatalf("probeURL returned error: %v", err)
	}
	if got != "http://localhost:3015/-/ready" {
		t.Fatalf("probeURL = %q, want target app URL", got)
	}
}

func TestHealthCmdJSON(t *testing.T) {
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if r.URL.Path != "/-/health" {
			t.Fatalf("unexpected path %q", r.URL.Path)
		}
		w.Header().Set("Content-Type", "application/json")
		_, _ = w.Write([]byte(`{"status":"ok"}`))
	}))
	defer server.Close()

	cmd := NewHealthCmd()
	cmd.URL = server.URL
	cmd.Probe = "health"
	cmd.JSON = true

	output := captureHealthCmdStdout(t, func() error {
		return cmd.Run(context.Background())
	})
	if !strings.Contains(output, `"http_status":200`) {
		t.Fatalf("expected json output to include http status, got:\n%s", output)
	}
	if !strings.Contains(output, `"status":"ok"`) {
		t.Fatalf("expected json output to include status, got:\n%s", output)
	}
}

func TestHealthCmdFailReturnsError(t *testing.T) {
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(http.StatusServiceUnavailable)
		_, _ = w.Write([]byte(`{"status":"not_ready","checks":[]}`))
	}))
	defer server.Close()

	cmd := NewHealthCmd()
	cmd.URL = server.URL
	cmd.NoColor = true
	cmd.Fail = true

	err := cmd.Run(context.Background())
	if err == nil {
		t.Fatal("expected fail mode to return an error")
	}
	if !strings.Contains(err.Error(), "not ready") {
		t.Fatalf("expected not ready error, got %v", err)
	}
}

func captureHealthCmdStdout(t *testing.T, run func() error) string {
	t.Helper()

	orig := os.Stdout
	r, w, err := os.Pipe()
	if err != nil {
		t.Fatalf("pipe stdout: %v", err)
	}
	os.Stdout = w
	defer func() {
		os.Stdout = orig
	}()

	runErr := run()
	_ = w.Close()

	var buf bytes.Buffer
	if _, err := buf.ReadFrom(r); err != nil {
		t.Fatalf("read stdout: %v", err)
	}
	_ = r.Close()

	if runErr != nil && !strings.Contains(runErr.Error(), "not ready") {
		t.Fatalf("run health cmd: %v", runErr)
	}

	return buf.String()
}
