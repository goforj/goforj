package cmd

import (
	"fmt"

	"github.com/goforj/console"
	"{{.GoModuleName}}/internal/runtime"
)

// MaintenanceEnableCmd places the selected App into maintenance mode without booting its dependency graph.
type MaintenanceEnableCmd struct{}

// Signature defines CLI metadata for the maintenance enable command.
func (*MaintenanceEnableCmd) Signature() string {
	return `name:"maintenance:enable" help:"Enable maintenance mode for this App" goforj:"preboot"`
}

// NewMaintenanceEnableCmd creates a maintenance enable command.
func NewMaintenanceEnableCmd() *MaintenanceEnableCmd {
	return &MaintenanceEnableCmd{}
}

// Run enables maintenance mode.
func (*MaintenanceEnableCmd) Run() error {
	if err := runtime.EnableMaintenance(); err != nil {
		return fmt.Errorf("enable maintenance mode: %w", err)
	}
	console.Success("Application is now in maintenance mode")
	return nil
}

// MaintenanceDisableCmd returns the selected App to normal operation without booting its dependency graph.
type MaintenanceDisableCmd struct{}

// Signature defines CLI metadata for the maintenance disable command.
func (*MaintenanceDisableCmd) Signature() string {
	return `name:"maintenance:disable" help:"Disable maintenance mode for this App" goforj:"preboot"`
}

// NewMaintenanceDisableCmd creates a maintenance disable command.
func NewMaintenanceDisableCmd() *MaintenanceDisableCmd {
	return &MaintenanceDisableCmd{}
}

// Run disables command-managed maintenance mode.
func (*MaintenanceDisableCmd) Run() error {
	if err := runtime.DisableMaintenance(); err != nil {
		return fmt.Errorf("disable maintenance mode: %w", err)
	}
	if runtime.MaintenanceEnabled() {
		return fmt.Errorf("maintenance mode remains enabled by APP_MAINTENANCE_ENABLED")
	}
	console.Success("Application is now live")
	return nil
}
