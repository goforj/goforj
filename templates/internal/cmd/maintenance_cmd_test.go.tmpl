package cmd

import (
	"os"
	"testing"

	"{{.GoModuleName}}/internal/runtime"
)

// TestMaintenanceCommandsRoundTrip verifies the preboot commands update shared runtime state.
func TestMaintenanceCommandsRoundTrip(t *testing.T) {
	t.Chdir(t.TempDir())
	t.Setenv("APP_MAINTENANCE_ENABLED", "false")
	t.Setenv("FORJ_APP", "app")
	if err := (&DownCmd{}).Run(); err != nil {
		t.Fatalf("down: %v", err)
	}
	if !runtime.MaintenanceEnabled() {
		t.Fatal("down did not enable maintenance")
	}
	if err := (&UpCmd{}).Run(); err != nil {
		t.Fatalf("up: %v", err)
	}
	if runtime.MaintenanceEnabled() {
		t.Fatal("up did not disable maintenance")
	}
	if _, err := os.Stat(runtime.MaintenancePath()); !os.IsNotExist(err) {
		t.Fatalf("maintenance file remained after up: %v", err)
	}
}

// TestUpCommandCannotOverrideEnvironment verifies operators receive a clear error when deployment configuration owns maintenance state.
func TestUpCommandCannotOverrideEnvironment(t *testing.T) {
	t.Chdir(t.TempDir())
	t.Setenv("APP_MAINTENANCE_ENABLED", "true")
	t.Setenv("FORJ_APP", "app")
	if err := (&UpCmd{}).Run(); err == nil {
		t.Fatal("up unexpectedly overrode APP_MAINTENANCE_ENABLED")
	}
}
