package cmd

import (
	"encoding/json"
	"fmt"
	{{- if and .Components.DemoApp .Components.HasDatabase .Components.Jobs }}
	"context"
	{{- end }}

	"{{.GoModuleName}}/internal/console"
	{{- if and .Components.DemoApp .Components.HasDatabase .Components.Jobs }}
	"{{.GoModuleName}}/internal/monitoring"
	"{{.GoModuleName}}/internal/queue"
	{{- end }}
)

// MonitorPollCmd manually enqueues one immediate poll cycle across monitors.
type MonitorPollCmd struct {
	MonitorID string `help:"Optional monitor id to poll instead of all enabled monitors"`
	Sync bool `help:"Run checks synchronously in-process and wait for completion"`
	JSON bool `help:"Print command result as JSON"`
	{{- if and .Components.DemoApp .Components.HasDatabase .Components.Jobs }}
	monitorCheckJob *monitoring.MonitorCheckJob
	{{- end }}
}

// Signature defines the kong metadata for this command.
func (*MonitorPollCmd) Signature() string {
	return `name:"monitor:poll" help:"Run or enqueue one polling cycle (supports --monitor, --sync, --json)"`
}

// NewMonitorPollCmd creates a new MonitorPollCmd.
func NewMonitorPollCmd(
	{{- if and .Components.DemoApp .Components.HasDatabase .Components.Jobs }}
	monitorCheckJob *monitoring.MonitorCheckJob,
	{{- end }}
) *MonitorPollCmd {
	return &MonitorPollCmd{
		{{- if and .Components.DemoApp .Components.HasDatabase .Components.Jobs }}
		monitorCheckJob: monitorCheckJob,
		{{- end }}
	}
}

// Run executes the command.
func (c *MonitorPollCmd) Run() error {
	{{- if not (and .Components.DemoApp .Components.HasDatabase .Components.Jobs) }}
	console.Warnf("monitor:poll is available only when Demo App, Database, and Jobs components are enabled")
	return nil
	{{- end }}
	{{- if and .Components.DemoApp .Components.HasDatabase .Components.Jobs }}
	if c.monitorCheckJob == nil {
		return fmt.Errorf("monitor check job not configured")
	}
	if c.Sync {
		summary, err := c.monitorCheckJob.RunNow(context.Background(), c.MonitorID)
		if err != nil {
			return err
		}
		if c.JSON {
			return printJSON(map[string]any{
				"ok":                 true,
				"mode":               "sync",
				"driver":             string(queue.ActiveDriver()),
				"monitor_id":         c.MonitorID,
				"total":              summary.Total,
				"succeeded":          summary.Succeeded,
				"failed":             summary.Failed,
				"failed_monitor_ids": summary.FailedMonitorIDs,
			})
		}
		if summary.Failed > 0 {
			console.Warnf("monitor poll cycle complete · total %d · ok %d · failed %d", summary.Total, summary.Succeeded, summary.Failed)
			return nil
		}
		console.Successf("monitor poll cycle complete · total %d · ok %d", summary.Total, summary.Succeeded)
		return nil
	}
	enqueued, err := c.monitorCheckJob.QueueNow(c.MonitorID)
	if err != nil {
		return err
	}
	if c.JSON {
		return printJSON(map[string]any{
			"ok":         true,
			"mode":       "queued",
			"driver":     string(queue.ActiveDriver()),
			"monitor_id": c.MonitorID,
			"enqueued":   enqueued,
		})
	}
	console.Successf("monitor poll cycle queued · monitors %d", enqueued)
	return nil
	{{- end }}
}

func printJSON(payload any) error {
	body, err := json.Marshal(payload)
	if err != nil {
		return err
	}
	fmt.Println(string(body))
	return nil
}
