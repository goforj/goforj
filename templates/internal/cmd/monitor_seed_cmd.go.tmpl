// MonitorSeedCmd seeds monitoring targets for load testing.
type MonitorSeedCmd struct {
	{{- if and .Components.DemoApp .Components.HasDatabase }}
	monitorRepo *models.MonitorRepo
	{{- end }}

	Source   string `help:"Seed source (tranco, file path, CSV URL, or comma-separated domains)" default:"tranco"`
	Count    int    `help:"Number of monitors to seed" default:"10000"`
	Interval int    `help:"Monitor interval in seconds" default:"60"`
	Timeout  int    `help:"Monitor timeout in milliseconds" default:"5000"`
	Tag      string `help:"Optional tag label for seeded monitors" default:"loadtest"`
	Validate bool   `help:"Validate targets are reachable before insert" default:"true"`
	ValidateTimeoutMS int `help:"Validation timeout in milliseconds" default:"3000"`
	DryRun   bool   `help:"Preview monitors without writing to the database"`
}

// Signature defines the kong metadata for this command.
func (*MonitorSeedCmd) Signature() string {
	return `name:"monitor:seed" help:"Seed monitoring targets for load testing"`
}

// NewMonitorSeedCmd creates a new MonitorSeedCmd.
func NewMonitorSeedCmd(
	{{- if and .Components.DemoApp .Components.HasDatabase }}
	monitorRepo *models.MonitorRepo,
	{{- end }}
) *MonitorSeedCmd {
	return &MonitorSeedCmd{
		{{- if and .Components.DemoApp .Components.HasDatabase }}
		monitorRepo: monitorRepo,
		{{- end }}
	}
}

// Run executes the command.
func (c *MonitorSeedCmd) Run() error {
	{{- if not (and .Components.DemoApp .Components.HasDatabase) }}
	console.Warnf("monitor:seed is available only when Demo App and Database components are enabled")
	return nil
	{{- end }}
	{{- if and .Components.DemoApp .Components.HasDatabase }}
	if c.monitorRepo == nil {
		return errors.New("monitor repository not configured")
	}
	if c.Count <= 0 {
		return fmt.Errorf("count must be greater than zero")
	}
	if c.Interval <= 0 {
		c.Interval = 60
	}
	if c.Timeout <= 0 {
		c.Timeout = 5000
	}
	if c.ValidateTimeoutMS <= 0 {
		c.ValidateTimeoutMS = 3000
	}

	domains, sourceLabel, err := c.resolveDomains(c.Source, c.Count)
	if err != nil {
		return err
	}
	if len(domains) == 0 {
		return fmt.Errorf("no seed domains found from source %q", sourceLabel)
	}

	existing, err := c.monitorRepo.TargetSetByType("http")
	if err != nil {
		return err
	}

	candidateTargets := make([]string, 0, c.Count*2)
	skippedExisting := 0
	for _, domain := range domains {
		target := normalizeTarget(domain)
		if target == "" {
			continue
		}
		if _, ok := existing[target]; ok {
			skippedExisting++
			continue
		}
		if _, seen := existing[target]; seen {
			continue
		}
		candidateTargets = append(candidateTargets, target)
		existing[target] = struct{}{}
	}

	validTargets := make([]string, 0, c.Count)
	skippedUnreachable := 0
	if c.Validate {
		for _, target := range candidateTargets {
			if len(validTargets) >= c.Count {
				break
			}
			ok := checkTargetReachable(target, time.Duration(c.ValidateTimeoutMS)*time.Millisecond)
			if !ok {
				skippedUnreachable++
				continue
			}
			validTargets = append(validTargets, target)
		}
	} else {
		for _, target := range candidateTargets {
			if len(validTargets) >= c.Count {
				break
			}
			validTargets = append(validTargets, target)
		}
	}

	now := time.Now().UTC()
	seedRows := make([]models.Monitor, 0, c.Count)
	for _, target := range validTargets {
		if len(seedRows) >= c.Count {
			break
		}
		id := fmt.Sprintf("monitor_seed_%d", now.UnixNano()+int64(len(seedRows)))
		name := buildMonitorName(target, len(seedRows)+1)
		seedRows = append(seedRows, models.Monitor{
			Id:              null.StringFrom(id),
			Name:            name,
			MonitorType:     "http",
			Target:          target,
			IntervalSeconds: c.Interval,
			TimeoutMs:       c.Timeout,
			Enabled:         true,
			CreatedAt:       now,
			UpdatedAt:       now,
		})
	}

	if len(seedRows) == 0 {
		console.Infof(
			"no new monitors to seed · requested %d · skipped_existing %d · skipped_unreachable %d · source %s",
			c.Count,
			skippedExisting,
			skippedUnreachable,
			sourceLabel,
		)
		return nil
	}

	if c.DryRun {
		preview := make([]string, 0, 5)
		for i := 0; i < len(seedRows) && i < 5; i++ {
			preview = append(preview, seedRows[i].Target)
		}
		console.Infof(
			"monitor seed dry-run complete · requested %d · prepared %d · skipped_existing %d · skipped_unreachable %d · source %s · preview %s",
			c.Count,
			len(seedRows),
			skippedExisting,
			skippedUnreachable,
			sourceLabel,
			strings.Join(preview, ", "),
		)
		return nil
	}

	if err := c.monitorRepo.CreateBatch(seedRows); err != nil {
		return err
	}

	console.Successf(
		"monitor seed complete · requested %d · seeded %d · skipped_existing %d · skipped_unreachable %d · source %s",
		c.Count,
		len(seedRows),
		skippedExisting,
		skippedUnreachable,
		sourceLabel,
	)
	return nil
	{{- end }}
}

