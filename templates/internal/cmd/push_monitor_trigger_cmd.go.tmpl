package cmd

import (
	{{- if and .Components.DemoApp .Components.HasDatabase .Components.Jobs }}
	"fmt"
	{{- end }}

	"{{.GoModuleName}}/internal/console"
	{{- if and .Components.DemoApp .Components.HasDatabase .Components.Jobs }}
	"{{.GoModuleName}}/internal/monitoring"
	{{- end }}
)

// PushMonitorTriggerCmd writes a synthetic heartbeat for the push monitor.
type PushMonitorTriggerCmd struct {
	{{- if and .Components.DemoApp .Components.HasDatabase .Components.Jobs }}
	monitorCheckJob *monitoring.MonitorCheckJob
	{{- end }}
}

// Signature defines the kong metadata for this command.
func (*PushMonitorTriggerCmd) Signature() string {
	return `name:"push-monitor-trigger" help:"Emit a synthetic heartbeat for the push monitor"`
}

// NewPushMonitorTriggerCmd creates a new PushMonitorTriggerCmd.
func NewPushMonitorTriggerCmd(
	{{- if and .Components.DemoApp .Components.HasDatabase .Components.Jobs }}
	monitorCheckJob *monitoring.MonitorCheckJob,
	{{- end }}
) *PushMonitorTriggerCmd {
	return &PushMonitorTriggerCmd{
		{{- if and .Components.DemoApp .Components.HasDatabase .Components.Jobs }}
		monitorCheckJob: monitorCheckJob,
		{{- end }}
	}
}

// Run executes the command.
func (c *PushMonitorTriggerCmd) Run() error {
	{{- if not (and .Components.DemoApp .Components.HasDatabase .Components.Jobs) }}
	console.Warnf("push-monitor-trigger is available only when App, Database, and Jobs components are enabled")
	return nil
	{{- end }}
	{{- if and .Components.DemoApp .Components.HasDatabase .Components.Jobs }}
	if c.monitorCheckJob == nil {
		return fmt.Errorf("monitor check job not configured")
	}
	if err := c.monitorCheckJob.TriggerPushMonitor(); err != nil {
		return err
	}
	console.Successf("push monitor heartbeat recorded")
	return nil
	{{- end }}
}
