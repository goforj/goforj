package cmd

import (
	{{- if and .Components.StressTest .Components.Jobs }}
	"context"
	"time"

	"github.com/goforj/env/v2"
	"{{.GoModuleName}}/internal/jobs"
	"{{.GoModuleName}}/internal/logger"
	{{- end }}
	{{- if not (and .Components.StressTest .Components.Jobs) }}
	"{{.GoModuleName}}/internal/console"
	{{- end }}
)

// QueueStressTickCmd enqueues synthetic jobs across multiple queues.
type QueueStressTickCmd struct {
	{{- if and .Components.StressTest .Components.Jobs }}
	logger    *logger.AppLogger
	stressJob *jobs.StressJob
	{{- end }}
}

func (*QueueStressTickCmd) Signature() string {
	return `name:"queue:stress:tick" help:"Enqueue synthetic jobs across queues for stress testing"`
}

func NewQueueStressTickCmd(
	{{- if and .Components.StressTest .Components.Jobs }}
	logger *logger.AppLogger,
	stressJob *jobs.StressJob,
	{{- end }}
) *QueueStressTickCmd {
	return &QueueStressTickCmd{
		{{- if and .Components.StressTest .Components.Jobs }}
		logger:    logger,
		stressJob: stressJob,
		{{- end }}
	}
}

func (c *QueueStressTickCmd) Run() error {
	{{- if not (and .Components.StressTest .Components.Jobs) }}
	console.Warnf("queue:stress:tick is available only when Stress Test and Jobs components are enabled")
	return nil
	{{- end }}
	{{- if and .Components.StressTest .Components.Jobs }}
	if !env.GetBool("QUEUE_STRESS_ENABLED", "false") {
		return nil
	}
	if c.stressJob == nil {
		return nil
	}

	defaultPerTick := clamp(env.GetInt("QUEUE_STRESS_DEFAULT_PER_TICK", "2"), 0, 100)
	criticalPerTick := clamp(env.GetInt("QUEUE_STRESS_CRITICAL_PER_TICK", "1"), 0, 100)
	lowPerTick := clamp(env.GetInt("QUEUE_STRESS_LOW_PER_TICK", "1"), 0, 100)

	sleepDefault := clamp(env.GetInt("QUEUE_STRESS_DEFAULT_SLEEP_MS", "120"), 0, 15000)
	sleepCritical := clamp(env.GetInt("QUEUE_STRESS_CRITICAL_SLEEP_MS", "180"), 0, 15000)
	sleepLow := clamp(env.GetInt("QUEUE_STRESS_LOW_SLEEP_MS", "60"), 0, 15000)

	failEvery := env.GetInt("QUEUE_STRESS_FAIL_EVERY", "0")
	tickUnix := time.Now().Unix()
	sequence := 0
	queued := 0
	ctx := context.Background()

	enqueueMany := func(queueName string, n int, sleepMs int) error {
		for i := 0; i < n; i++ {
			sequence++
			shouldFail := failEvery > 0 && ((int(tickUnix)+sequence)%failEvery == 0)
			err := c.stressJob.Enqueue(ctx, queueName, jobs.StressJobPayload{
				Queue:   queueName,
				SleepMs: sleepMs,
				Fail:    shouldFail,
			})
			if err != nil {
				return err
			}
			queued++
		}
		return nil
	}

	if err := enqueueMany("default", defaultPerTick, sleepDefault); err != nil {
		return err
	}
	if err := enqueueMany("critical", criticalPerTick, sleepCritical); err != nil {
		return err
	}
	if err := enqueueMany("low", lowPerTick, sleepLow); err != nil {
		return err
	}

	if env.GetBool("QUEUE_STRESS_LOG_TICKS", "false") {
		c.logger.Info().
			Int("queued", queued).
			Int("default", defaultPerTick).
			Int("critical", criticalPerTick).
			Int("low", lowPerTick).
			Msg("stress tick queued")
	}
	return nil
	{{- end }}
}

func clamp(value int, minValue int, maxValue int) int {
	if value < minValue {
		return minValue
	}
	if value > maxValue {
		return maxValue
	}
	return value
}
