	if ip := net.ParseIP(strings.Trim(value, "[]")); ip != nil && ip.IsLoopback() {
		return nil
	}
	if value == "" {
		return fmt.Errorf("docker compose method requires REDIS_HOST to identify the generated local Redis service")
	}
	return fmt.Errorf(
		"docker compose method refuses external REDIS_HOST %q; expected redis, localhost, or a loopback address",
		maskRedisShellURL(value),
