	waitCh := make(chan error, 1)
	go func() {
		waitCh <- cmd.Wait()
	}()

	signals := make(chan os.Signal, 2)
	signal.Notify(signals, os.Interrupt, syscall.SIGTERM)
	defer signal.Stop(signals)
	return waitRedisShellProcess(
		launch.Command,
		waitCh,
		signals,
		redisShellDelegatedInterruptNeedsForwarding(),
		cmd.Process.Signal,
	)
}

// waitRedisShellProcess forwards wrapper-targeted interrupts once while avoiding duplicate terminal-group delivery.
