// redisShellMergedEnvironment replaces inherited credentials instead of emitting duplicate environment keys.
func redisShellMergedEnvironment(base []string, overrides map[string]string) []string {
	if len(overrides) == 0 {
		return append([]string(nil), base...)
	}
	out := make([]string, 0, len(base)+len(overrides))
	for _, entry := range base {
		key, _, _ := strings.Cut(entry, "=")
		if _, replaced := overrides[key]; replaced {
			continue
		}
		out = append(out, entry)
	}
	keys := make([]string, 0, len(overrides))
	for key := range overrides {
		keys = append(keys, key)
	}
	sort.Strings(keys)
	for _, key := range keys {
		out = append(out, key+"="+overrides[key])
	}
	return out
}

// formatRedisShellCommand renders a shell-readable diagnostic while masking every known credential form.
func formatRedisShellCommand(launch redisShellLaunch, mask bool) string {
	parts := make([]string, 0, len(launch.Env)+len(launch.Args)+1)
	keys := make([]string, 0, len(launch.Env))
	for key := range launch.Env {
		keys = append(keys, key)
	}
	sort.Strings(keys)
	for _, key := range keys {
		value := launch.Env[key]
		if mask && value != "" {
			value = "***"
		}
		parts = append(parts, key+"="+shellQuoteRedisShell(value))
	}
	parts = append(parts, launch.Command)
	args := append([]string(nil), launch.Args...)
	if mask {
		args = maskRedisShellArgs(args)
	}
	for _, arg := range args {
		parts = append(parts, shellQuoteRedisShell(arg))
	}
	return strings.Join(parts, " ")
}

// maskRedisShellArgs covers redis-cli password flags, credential commands, auth environment syntax, and Redis URLs.
func maskRedisShellArgs(args []string) []string {
	out := append([]string(nil), args...)
	maskCommandRemainder := false
	for i := 0; i < len(out); i++ {
		if maskCommandRemainder {
			out[i] = "***"
			continue
		}
		lower := strings.ToLower(out[i])
		if lower == "auth" || lower == "requirepass" || lower == "masterauth" {
			maskCommandRemainder = true
			continue
		}
		switch lower {
		case "-a", "--pass", "--password", "--auth":
			if i+1 < len(out) {
				out[i+1] = "***"
				i++
			}
			continue
		}
		for _, prefix := range []string{"--pass=", "--password=", "--auth=", "rediscli_auth="} {
			if strings.HasPrefix(lower, prefix) {
				key, _, _ := strings.Cut(out[i], "=")
				out[i] = key + "=***"
				lower = strings.ToLower(out[i])
				break
			}
		}
		if strings.HasPrefix(lower, "-a") && len(out[i]) > 2 {
			out[i] = "-a***"
			continue
		}
		out[i] = maskRedisShellURL(out[i])
	}
	return out
}

// maskRedisShellURL removes user-info and secret query values from Redis URLs.
func maskRedisShellURL(value string) string {
	lower := strings.ToLower(value)
	if !strings.HasPrefix(lower, "redis://") && !strings.HasPrefix(lower, "rediss://") {
		return value
	}
	value = maskRedisShellRawSecrets(value)
	parsed, err := url.Parse(value)
	if err != nil || parsed == nil {
		return value
	}
	scheme := strings.ToLower(parsed.Scheme)
	if parsed.Host == "" || (scheme != "redis" && scheme != "rediss") {
		return value
	}
	changed := false
	if parsed.User != nil {
		if _, ok := parsed.User.Password(); ok {
			parsed.User = url.UserPassword(parsed.User.Username(), "***")
			changed = true
		}
	}
	query := parsed.Query()
	for key := range query {
		if redisShellSecretKey(key) {
			query.Set(key, "***")
			changed = true
		}
	}
	if !changed {
		return value
	}
	parsed.RawQuery = query.Encode()
	return parsed.String()
}

