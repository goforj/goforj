	command string,
	waitCh <-chan error,
	signals <-chan os.Signal,
	forwardInterrupt bool,
	signalProcess func(os.Signal) error,
) error {
	interruptForwarded := false
	for {
		select {
		case err := <-waitCh:
			return redisShellProcessError(command, err)
		case received := <-signals:
			if received == os.Interrupt {
				if !forwardInterrupt || interruptForwarded {
					continue
				}
				interruptForwarded = true
			}
			_ = signalProcess(received)
		}
	}
}

