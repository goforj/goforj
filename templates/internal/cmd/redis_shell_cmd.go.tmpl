// ExitCode exposes the native client status to launchers that preserve process codes.
func (e *redisShellExitError) ExitCode() int {
	if status, ok := e.err.Sys().(syscall.WaitStatus); ok && status.Signaled() {
		return 128 + int(status.Signal())
	}
	return e.err.ExitCode()
