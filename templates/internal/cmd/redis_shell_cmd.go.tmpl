func maskRedisShellRawSecrets(value string) string {
	value = maskRedisShellRawUserInfo(value)
	queryStart := strings.IndexByte(value, '?')
	if queryStart < 0 {
		return value
	}
	queryEnd := strings.IndexByte(value[queryStart+1:], '#')
	if queryEnd < 0 {
		queryEnd = len(value)
	} else {
		queryEnd += queryStart + 1
	}
	parts := strings.Split(value[queryStart+1:queryEnd], "&")
	for i, part := range parts {
		key, _, ok := strings.Cut(part, "=")
		decodedKey, decodeErr := url.QueryUnescape(key)
		if decodeErr != nil {
			decodedKey = key
		}
		if ok && redisShellSecretKey(decodedKey) {
			parts[i] = key + "=***"
		}
	}
	return value[:queryStart+1] + strings.Join(parts, "&") + value[queryEnd:]
}

// maskRedisShellRawUserInfo removes a password-shaped authority segment without requiring a valid URL.
func maskRedisShellRawUserInfo(value string) string {
	authorityStart := 0
	if scheme := strings.Index(value, "://"); scheme >= 0 {
		authorityStart = scheme + 3
	}
	authorityEnd := len(value)
	if boundary := strings.IndexAny(value[authorityStart:], "/?#"); boundary >= 0 {
		authorityEnd = authorityStart + boundary
	}
	authority := value[authorityStart:authorityEnd]
	at := strings.LastIndexByte(authority, '@')
	if at < 0 {
		return value
	}
	colon := strings.IndexByte(authority[:at], ':')
	if colon < 0 {
		return value
	}
	secretStart := authorityStart + colon + 1
	secretEnd := authorityStart + at
	return value[:secretStart] + "***" + value[secretEnd:]
}

// redisShellSecretKey identifies query values that must never appear in diagnostics.
func redisShellSecretKey(key string) bool {
	lower := strings.ToLower(strings.TrimSpace(key))
	return strings.Contains(lower, "password") || strings.Contains(lower, "passwd") || strings.Contains(lower, "pwd") || strings.Contains(lower, "token") || strings.Contains(lower, "secret") || strings.Contains(lower, "auth")
}

// shellQuoteRedisShell makes printed argv unambiguous without participating in execution.
func shellQuoteRedisShell(value string) string {
	if value == "" {
		return "''"
	}
	if strings.IndexFunc(value, func(r rune) bool {
		return !(r == '-' || r == '_' || r == '.' || r == '/' || r == ':' || r == '=' || r == '@' || r == ',' || r == '+' || r >= '0' && r <= '9' || r >= 'A' && r <= 'Z' || r >= 'a' && r <= 'z')
	}) == -1 {
		return value
	}
	return "'" + strings.ReplaceAll(value, "'", "'\"'\"'") + "'"
}
