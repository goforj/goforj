// TestRedisShellPrintMasksCredentials verifies environment, flags, and URLs cannot leak through --print.
func TestRedisShellPrintMasksCredentials(t *testing.T) {
	launch := redisShellLaunch{
		Command: "redis-cli",
		Env: map[string]string{
			"REDISCLI_AUTH": "environment-secret",
		},
		Args: []string{
			"-h", "cache.internal",
			"-a", "argument-secret",
			"--pass", "separate-secret",
			"--pass=inline-secret",
			"-u", "rediss://app:url-secret@cache.internal:6380/0?password=query-password&token=query-token&auth=query-auth&db=0",
			"REDISCLI_AUTH=assignment-secret",
			"AUTH", "command-secret",
		},
	}
	printed := formatRedisShellCommand(launch, true)
	for _, secret := range []string{
		"environment-secret",
		"argument-secret",
		"separate-secret",
		"inline-secret",
		"url-secret",
		"query-password",
		"query-token",
		"query-auth",
		"assignment-secret",
		"command-secret",
	} {
		if strings.Contains(printed, secret) {
			t.Fatalf("formatRedisShellCommand() exposed %q in %q", secret, printed)
		}
	}
	if !strings.Contains(printed, "***") || !strings.Contains(printed, "redis-cli") {
		t.Fatalf("formatRedisShellCommand() = %q, want masked runnable shape", printed)
	}
	if cleared := formatRedisShellCommand(redisShellLaunch{Command: "redis-cli", Env: map[string]string{"REDISCLI_AUTH": ""}}, true); !strings.Contains(cleared, "REDISCLI_AUTH=''") {
		t.Fatalf("empty auth diagnostic = %q, want explicit clearing", cleared)
	}
}

