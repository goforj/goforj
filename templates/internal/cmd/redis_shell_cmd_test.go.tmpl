// TestRedisShellCommandContract verifies the public command name, alias, and local-first default.
func TestRedisShellCommandContract(t *testing.T) {
	cmd := NewRedisShellCmd()
	if cmd.Method != "auto" {
		t.Fatalf("NewRedisShellCmd().Method = %q, want auto", cmd.Method)
	}
	signature := cmd.Signature()
	for _, want := range []string{
		`name:"redis:shell"`,
		`aliases:"redis"`,
		`goforj:"preboot"`,
	} {
		if !strings.Contains(signature, want) {
			t.Fatalf("RedisShellCmd.Signature() = %q, want %q", signature, want)
		}
	}
}

