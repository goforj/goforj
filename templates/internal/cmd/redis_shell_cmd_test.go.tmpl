	child.Env = redisShellMergedEnvironment(os.Environ(), map[string]string{
		"GOFORJ_REDIS_SHELL_HELPER":      "1",
		"GOFORJ_REDIS_SHELL_HELPER_MODE": "wait",
	})
	stdout, err := child.StdoutPipe()
	if err != nil {
		t.Fatalf("StdoutPipe() error = %v", err)
	}
	if err := child.Start(); err != nil {
		t.Fatalf("Start() error = %v", err)
	}
	reader := bufio.NewReader(stdout)
	if ready, err := reader.ReadString('\n'); err != nil || strings.TrimSpace(ready) != "ready" {
		t.Fatalf("child readiness = %q, %v", ready, err)
	}
	if err := child.Process.Signal(syscall.SIGTERM); err != nil {
		t.Fatalf("Signal(SIGTERM) error = %v", err)
	}
	mapped := redisShellProcessError("redis-cli", child.Wait())
	var exitCode interface{ ExitCode() int }
	if !errors.As(mapped, &exitCode) || exitCode.ExitCode() != 128+int(syscall.SIGTERM) {
		t.Fatalf("redisShellProcessError() = %T %v, want signal exit %d", mapped, mapped, 128+int(syscall.SIGTERM))
	}
}

// TestRedisShellProcessHelper provides a platform-neutral child process for exit-status tests.
func TestRedisShellProcessHelper(t *testing.T) {
	if os.Getenv("GOFORJ_REDIS_SHELL_HELPER") != "1" {
		return
	}
	if os.Getenv("GOFORJ_REDIS_SHELL_HELPER_MODE") == "wait" {
		if _, err := os.Stdout.WriteString("ready\n"); err != nil {
			os.Exit(98)
		}
		select {}
	}
	code, err := strconv.Atoi(os.Getenv("GOFORJ_REDIS_SHELL_HELPER_CODE"))
	if err != nil {
		os.Exit(99)
	}
	os.Exit(code)
}

// redisShellTestWriteCompose writes the generated filename expected by safe fallback detection.
func redisShellTestWriteCompose(t *testing.T, source string) {
	t.Helper()
	if err := os.WriteFile("docker-compose.yml", []byte(source), 0o644); err != nil {
		t.Fatalf("write docker-compose.yml: %v", err)
	}
}

// redisShellTestWriteExecutable creates a PATH-visible client without requiring Redis in unit tests.
func redisShellTestWriteExecutable(t *testing.T, dir string, name string) {
	t.Helper()
	if runtime.GOOS == "windows" {
		name += ".exe"
	}
	path := dir + string(os.PathSeparator) + name
	if err := os.WriteFile(path, nil, 0o755); err != nil {
		t.Fatalf("write fake %s: %v", name, err)
	}
}
