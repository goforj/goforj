// TestRedisShellDatabaseValidation covers configured and command-line logical database failures.
func TestRedisShellDatabaseValidation(t *testing.T) {
	tests := []struct {
		name       string
		configured string
		override   string
		want       string
		wantErr    string
	}{
		{name: "configured", configured: "3", want: "3"},
		{name: "default", want: "0"},
		{name: "override", configured: "3", override: "7", want: "7"},
		{name: "invalid configured", configured: "many", wantErr: "REDIS_DB"},
		{name: "negative configured", configured: "-1", wantErr: "REDIS_DB"},
		{name: "invalid override", configured: "3", override: "many", wantErr: "--db"},
		{name: "negative override", configured: "3", override: "-1", wantErr: "--db"},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			cmd := &RedisShellCmd{DB: tt.override}
			got, err := cmd.selectedDB(tt.configured)
			if tt.wantErr != "" {
				if err == nil || !strings.Contains(err.Error(), tt.wantErr) {
					t.Fatalf("selectedDB() error = %v, want %q", err, tt.wantErr)
				}
				return
			}
			if err != nil {
				t.Fatalf("selectedDB() error = %v", err)
			}
			if got != tt.want {
				t.Fatalf("selectedDB() = %q, want %q", got, tt.want)
			}
		})
	}
}

