package cmd

import (
	"context"
	"fmt"

	"{{.GoModuleName}}/internal/runtime"
{{- if or .ProjectComponents.WebAPI .ProjectComponents.WebUI }}
	"{{.GoModuleName}}/internal/http"
{{- end }}
{{- if .ProjectComponents.Jobs }}
	"{{.GoModuleName}}/internal/jobs"
{{- end }}
	"{{.GoModuleName}}/internal/logger"
{{- if .ProjectComponents.Metrics }}
	"{{.GoModuleName}}/internal/metrics"
{{- end }}
{{- if .ProjectComponents.Scheduler }}
	"{{.GoModuleName}}/internal/schedules"
{{- end }}
)

// RunCmd starts enabled app runtimes together in a single host process.
type RunCmd struct {
	logger *logger.AppLogger
{{- if or .ProjectComponents.WebAPI .ProjectComponents.WebUI }}
	httpRuntime *http.Runtime
{{- end }}
{{- if .ProjectComponents.Scheduler }}
	schedulerRuntime *schedules.Runtime
{{- end }}
{{- if .ProjectComponents.Jobs }}
	jobsRuntime *jobs.Runtime
{{- end }}
{{- if .ProjectComponents.Metrics }}
	metricsManager *metrics.Manager
{{- end }}
}

// NewRunCmd creates a new run command.
func NewRunCmd(
	logger *logger.AppLogger,
{{- if or .ProjectComponents.WebAPI .ProjectComponents.WebUI }}
	httpRuntime *http.Runtime,
{{- end }}
{{- if .ProjectComponents.Scheduler }}
	schedulerRuntime *schedules.Runtime,
{{- end }}
{{- if .ProjectComponents.Jobs }}
	jobsRuntime *jobs.Runtime,
{{- end }}
{{- if .ProjectComponents.Metrics }}
	metricsManager *metrics.Manager,
{{- end }}
) *RunCmd {
	return &RunCmd{
		logger: logger,
{{- if or .ProjectComponents.WebAPI .ProjectComponents.WebUI }}
		httpRuntime: httpRuntime,
{{- end }}
{{- if .ProjectComponents.Scheduler }}
		schedulerRuntime: schedulerRuntime,
{{- end }}
{{- if .ProjectComponents.Jobs }}
		jobsRuntime: jobsRuntime,
{{- end }}
{{- if .ProjectComponents.Metrics }}
		metricsManager: metricsManager,
{{- end }}
	}
}

// Signature defines CLI metadata for this command.
func (*RunCmd) Signature() string {
	return `name:"run" aliases:"app" help:"Run enabled app runtimes together"`
}

func (c *RunCmd) Run(ctx context.Context) error {
	runtimes := make([]runtime.Runtime, 0, 3)
{{- if or .ProjectComponents.WebAPI .ProjectComponents.WebUI }}
	if c.httpRuntime != nil {
		httpRuntime := c.httpRuntime
		runtimes = append(runtimes, runtime.RuntimeFunc{
			RuntimeIdentity: httpRuntime.Identity(),
			RunFn: func(ctx context.Context) error {
				return httpRuntime.RunWithConfig(ctx, http.RuntimeConfig{
					DisableMetricsEndpoint: true,
				})
			},
		})
	}
{{- end }}
{{- if .ProjectComponents.Scheduler }}
	if c.schedulerRuntime != nil {
		schedulerRuntime := c.schedulerRuntime
		runtimes = append(runtimes, runtime.RuntimeFunc{
			RuntimeIdentity: schedulerRuntime.Identity(),
			RunFn: func(ctx context.Context) error {
				return schedulerRuntime.RunWithConfig(ctx, schedules.RuntimeConfig{
					DisableMetricsEndpoint: true,
				})
			},
		})
	}
{{- end }}
{{- if .ProjectComponents.Jobs }}
	if c.jobsRuntime != nil {
		jobsRuntime := c.jobsRuntime
		runtimes = append(runtimes, runtime.RuntimeFunc{
			RuntimeIdentity: jobsRuntime.Identity(),
			RunFn: func(ctx context.Context) error {
				return jobsRuntime.RunWithConfig(ctx, jobs.RuntimeConfig{
					DisableMetricsEndpoint: true,
				})
			},
		})
	}
{{- end }}
	if len(runtimes) == 0 {
		return fmt.Errorf("run: no runtimes are enabled for this app")
	}

{{- if .ProjectComponents.Metrics }}
	if c.metricsManager != nil && c.metricsManager.Registry() != nil && c.httpRuntime == nil {
		metricsLogger := c.logger
		if metricsLogger != nil {
			metricsLogger = metricsLogger.WithComponent("Metrics")
		}
		if err := metrics.StartPrometheusEndpoint(ctx, metricsLogger, "app", runtime.MetricsPort(), c.metricsManager.Registry()); err != nil {
			return err
		}
	}
{{- end }}

	return runtime.NewRuntimeHost(runtimes...).Run(ctx)
}
