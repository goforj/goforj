package cmd

import (
	"os"
	"strings"
)

// ApplyLaunchTarget sets the default app target identity for directly executed binaries.
func ApplyLaunchTarget(target string) {
	target = strings.TrimSpace(target)
	if target == "" {
		target = "app"
	}
	if strings.TrimSpace(os.Getenv("FORJ_APP_TARGET")) == "" {
		_ = os.Setenv("FORJ_APP_TARGET", target)
	}
	if strings.TrimSpace(os.Getenv("APP_TARGET")) == "" {
		_ = os.Setenv("APP_TARGET", target)
	}
}
