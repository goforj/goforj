package database

import (
	"os"
	"path/filepath"
	"strings"
	"testing"
	"time"

	"github.com/goforj/env/v2"
	"github.com/goforj/str/v2"
	"gorm.io/gorm"
{{- if .Components.Metrics }}
	"{{.GoModuleName}}/internal/metrics"
{{- end }}
)

func TestGeneratedAccessorsConnect(t *testing.T) {
	if str.Of(env.Get("DB_DRIVER", "")).Trim().String() == "" {
		t.Skip("db driver not configured")
	}
	if _, err := os.Stat(filepath.Join("internal", "database", "connections_gen.go")); err != nil {
		t.Fatalf("connections_gen.go missing: %v", err)
	}
	conns := NewConnections({{- if .Components.Metrics }}metrics.NewManager(), {{- end }}nil)
	defaultDB, err := conns.Default()
	if err != nil {
		t.Fatalf("default connection failed: %v", err)
	}
	analyticsDB, err := conns.GetAnalytics()
	if err != nil {
		t.Fatalf("analytics accessor failed: %v", err)
	}
	if defaultDB == analyticsDB {
		t.Fatalf("expected distinct db handles for default and analytics")
	}

	driver := str.Of(env.Get("DB_DRIVER", "")).Trim().ToLower().String()
	switch driver {
	case "mysql", "mariadb":
		assertMySQLDatabaseName(t, defaultDB, str.Of(env.Get("DB_DATABASE", "")).Trim().String())
		assertMySQLDatabaseName(t, analyticsDB, str.Of(env.Get("DB_ANALYTICS_DATABASE", "")).Trim().String())
		assertMySQLUTCContract(t, defaultDB)
		assertMySQLUTCContract(t, analyticsDB)
	case "postgres", "postgresql":
		assertPostgresDatabaseName(t, defaultDB, str.Of(env.Get("DB_DATABASE", "")).Trim().String())
		assertPostgresDatabaseName(t, analyticsDB, str.Of(env.Get("DB_ANALYTICS_DATABASE", "")).Trim().String())
		assertPostgresUTCContract(t, defaultDB)
		assertPostgresUTCContract(t, analyticsDB)
	case "sqlite", "sqlite3":
		assertSQLitePath(t, defaultDB, str.Of(env.Get("DB_DATABASE", "")).Trim().String())
		assertSQLitePath(t, analyticsDB, str.Of(env.Get("DB_ANALYTICS_DATABASE", "")).Trim().String())
	}
}

// assertMySQLUTCContract proves each pooled session and parsed database timestamp use UTC.
func assertMySQLUTCContract(t *testing.T, db *gorm.DB) {
	t.Helper()
	sqlDB, err := db.DB()
	if err != nil {
		t.Fatalf("get mysql sql handle: %v", err)
	}
	var sessionTimezone string
	var generatedAt time.Time
	if err := sqlDB.QueryRow("SELECT @@session.time_zone, CURRENT_TIMESTAMP(6)").Scan(&sessionTimezone, &generatedAt); err != nil {
		t.Fatalf("read mysql UTC state: %v", err)
	}
	if sessionTimezone != "+00:00" {
		t.Fatalf("expected mysql session timezone +00:00, got %q", sessionTimezone)
	}
	if generatedAt.Location() != time.UTC {
		t.Fatalf("expected database timestamp in UTC, got %s", generatedAt.Location())
	}
	if delta := time.Since(generatedAt); delta < -5*time.Second || delta > 5*time.Second {
		t.Fatalf("database timestamp differs from UTC clock by %s", delta)
	}
}

func assertMySQLDatabaseName(t *testing.T, db *gorm.DB, expected string) {
	t.Helper()
	var name string
	if err := db.Raw("SELECT DATABASE()").Scan(&name).Error; err != nil {
		t.Fatalf("read mysql db name: %v", err)
	}
	if name != expected {
		t.Fatalf("expected mysql db %s, got %s", expected, name)
	}
}

// assertPostgresUTCContract proves generated connections establish UTC sessions.
func assertPostgresUTCContract(t *testing.T, db *gorm.DB) {
	t.Helper()
	var sessionTimezone string
	if err := db.Raw("SHOW TIME ZONE").Scan(&sessionTimezone).Error; err != nil {
		t.Fatalf("read postgres session timezone: %v", err)
	}
	if sessionTimezone != "UTC" {
		t.Fatalf("expected postgres session timezone UTC, got %q", sessionTimezone)
	}
}

func assertPostgresDatabaseName(t *testing.T, db *gorm.DB, expected string) {
	t.Helper()
	var name string
	if err := db.Raw("SELECT current_database()").Scan(&name).Error; err != nil {
		t.Fatalf("read postgres db name: %v", err)
	}
	if name != expected {
		t.Fatalf("expected postgres db %s, got %s", expected, name)
	}
}

func assertSQLitePath(t *testing.T, db *gorm.DB, expected string) {
	t.Helper()
	var rows []struct {
		File string
	}
	if err := db.Raw("PRAGMA database_list").Scan(&rows).Error; err != nil {
		t.Fatalf("read sqlite db list: %v", err)
	}
	var found string
	for _, row := range rows {
		if row.File != "" {
			found = row.File
			break
		}
	}
	if found == "" {
		t.Fatalf("sqlite database file not found")
	}
	if !strings.HasSuffix(found, filepath.Base(expected)) {
		t.Fatalf("expected sqlite path to end with %s, got %s", filepath.Base(expected), found)
	}
}
