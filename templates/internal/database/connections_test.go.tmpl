func TestClassifyDBOperation(t *testing.T) {
	cases := map[string]string{
		"SELECT * FROM users":               "query",
		"with recent as (select 1) select": "query",
		"INSERT INTO users VALUES (1)":     "create",
		"UPDATE users SET name='a'":        "update",
		"DELETE FROM users":                "delete",
		"BEGIN":                            "other",
	}
	for sql, want := range cases {
		if got := classifyDBOperation(sql); got != want {
			t.Fatalf("classifyDBOperation(%q): got %q want %q", sql, got, want)
		}
	}
}

func TestClassifyDBTarget(t *testing.T) {
	cases := map[string]string{
		"SELECT * FROM users":                                                 "users",
		"SELECT * FROM `auth_sessions` WHERE id = 1":                          "auth_sessions",
		"INSERT INTO users VALUES (1)":                                        "users",
		"UPDATE users SET name='a'":                                           "users",
		"DELETE FROM users WHERE id = 1":                                      "users",
		"WITH recent AS (SELECT 1) SELECT * FROM monitor_checks LIMIT 10":     "monitor_checks",
		"SHOW TABLES":                                                         "tables",
		"PRAGMA table_info(users)":                                            "table_info",
		"BEGIN":                                                               "other",
		"":                                                                    "unknown",
	}
	for sql, want := range cases {
		if got := classifyDBTarget(sql); got != want {
			t.Fatalf("classifyDBTarget(%q): got %q want %q", sql, got, want)
		}
	}
}

func TestMetricsQueryLoggerRecordsMetrics(t *testing.T) {
	manager := appmetrics.NewManager()
	logger := newMetricsQueryLogger(newGORMQueryLogger(gormLogger.Silent), manager, "default", "mysql")

	logger.Trace(context.Background(), time.Now().Add(-50*time.Millisecond), func() (string, int64) {
		return "SELECT * FROM users", 1
	}, nil)

	var got uint64
	for _, counter := range manager.Registry().Snapshot().Counters {
		if counter.Descriptor.Name != "database.operations" {
			continue
		}
		if sameMetricsLabels(counter.Labels, []gmetrics.Label{
			{Key: "connection", Value: "default"},
			{Key: "driver", Value: "mysql"},
			{Key: "operation", Value: "query"},
			{Key: "target", Value: "users"},
			{Key: "status", Value: "ok"},
		}) {
			got = counter.Value
			break
		}
	}
	if got != 1 {
		t.Fatalf("database op total: got %d want 1", got)
	}
}

func sameMetricsLabels(a, b []gmetrics.Label) bool {
	if len(a) != len(b) {
		return false
	}
	for i := range a {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}
