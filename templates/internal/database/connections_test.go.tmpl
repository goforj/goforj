func TestMetricsQueryLoggerSamplesPoolStatsAtInterval(t *testing.T) {
	logger := newMetricsQueryLogger(newGORMQueryLogger(gormLogger.Silent, 250*time.Millisecond), metrics.NewManager(), nil, "default", "mysql", 250*time.Millisecond).(*metricsQueryLogger)

	now := time.Unix(100, 0)
	if !logger.shouldSamplePoolStats(now) {
		t.Fatal("expected first pool stats sample to pass")
	}
	if logger.shouldSamplePoolStats(now.Add(200 * time.Millisecond)) {
		t.Fatal("expected second pool stats sample inside interval to be skipped")
	}
	if !logger.shouldSamplePoolStats(now.Add(databasePoolStatsSampleInterval + time.Millisecond)) {
		t.Fatal("expected pool stats sample after interval to pass")
	}
}

func TestNewConnectionsDisablesDatabaseMetricsWithoutDisablingInspects(t *testing.T) {
	t.Setenv("LIGHTHOUSE_INSPECT_ENABLED", "true")
	t.Setenv("LIGHTHOUSE_INSPECT_SAMPLE_RATE", "1.0")
	manager := metrics.NewManagerWithConfig(metrics.Config{
		HTTP:     true,
		{{- if .ProjectComponents.Storage }}
		Storage:  true,
		{{- end }}
		{{- if .ProjectComponents.Events }}
		Events:   true,
		{{- end }}
		Database: false,
		{{- if .Components.Auth }}
		Auth:     true,
		{{- end }}
		{{- if .Components.Jobs }}
		Queue:    true,
		{{- end }}
		{{- if .Components.Scheduler }}
		Scheduler: true,
		{{- end }}
		{{- if .Components.Mail }}
		Mail:     true,
		{{- end }}
	})
	inspectManager := inspects.NewManager()
	conns := NewConnections(manager, inspectManager)
	if conns.metrics == nil {
		t.Fatal("expected metrics manager to be stored on connections")
	}
	if conns.metrics.DatabaseEnabled() {
		t.Fatal("expected database metrics to be disabled")
	}
	logger := newMetricsQueryLogger(newGORMQueryLogger(gormLogger.Silent, 250*time.Millisecond), nil, conns.inspectManager, "default", "sqlite", 250*time.Millisecond)
	ctx := inspectManager.Begin(context.Background(), "http", "GET /users", nil)
	recorder := inspects.RecorderFromContext(ctx)
	if recorder == nil {
		t.Fatal("expected inspect recorder")
	}
	logger.Trace(ctx, time.Now().Add(-10*time.Millisecond), func() (string, int64) {
		return "SELECT * FROM users", 1
	}, nil)
	inspectManager.Finish(ctx, "ok", nil)

	record, ok, err := inspectManager.ByID(context.Background(), recorder.InspectID())
	if err != nil {
		t.Fatalf("lookup inspect record: %v", err)
	}
	if !ok {
		t.Fatal("expected inspect record")
	}
	if len(record.Events) != 1 || record.Events[0].Kind != inspects.EventKindQuery {
		t.Fatalf("expected one query inspect event, got %#v", record.Events)
	}
}

func sameMetricsLabels(a, b []gmetrics.Label) bool {
	b = expectedMetricsLabels(b)
	if len(a) != len(b) {
		return false
	}
	for i := range a {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

func expectedMetricsLabels(labels []gmetrics.Label) []gmetrics.Label {
	for _, label := range labels {
		if label.Key == "app" {
			return labels
		}
	}
	out := make([]gmetrics.Label, 0, len(labels)+1)
	out = append(out, gmetrics.Label{Key: "app", Value: "app"})
	out = append(out, labels...)
	return out
}
