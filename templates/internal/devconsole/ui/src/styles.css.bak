@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --radius: 0.65rem;
    --background: 0 0% 100%;
    --foreground: 222.2 84% 4.9%;
    --card: 0 0% 100%;
    --card-foreground: 222.2 84% 4.9%;
    --popover: 0 0% 100%;
    --popover-foreground: 222.2 84% 4.9%;
    --primary: 222.2 47.4% 11.2%;
    --primary-foreground: 210 40% 98%;
    --secondary: 210 40% 96.1%;
    --secondary-foreground: 222.2 47.4% 11.2%;
    --muted: 210 40% 96.1%;
    --muted-foreground: 215.4 16.3% 46.9%;
    --accent: 210 40% 96.1%;
    --accent-foreground: 222.2 47.4% 11.2%;
    --destructive: 0 84.2% 60.2%;
    --destructive-foreground: 210 40% 98%;
    --border: 214.3 31.8% 91.4%;
    --input: 214.3 31.8% 91.4%;
    --ring: 222.2 84% 4.9%;
    --chart-1: 220 70% 50%;
    --chart-2: 160 60% 45%;
    --chart-3: 30 80% 55%;
    --chart-4: 280 65% 60%;
    --chart-5: 340 75% 55%;
    --sidebar: 0 0% 100%;
    --sidebar-foreground: 222.2 84% 4.9%;
    --sidebar-primary: 222.2 47.4% 11.2%;
    --sidebar-primary-foreground: 210 40% 98%;
    --sidebar-accent: 210 40% 96.1%;
    --sidebar-accent-foreground: 222.2 47.4% 11.2%;
    --sidebar-border: 214.3 31.8% 91.4%;
    --sidebar-ring: 222.2 84% 4.9%;
  }

  .dark {
    --background: 222.2 84% 4.9%;
    --foreground: 210 40% 98%;
    --card: 222.2 84% 4.9%;
    --card-foreground: 210 40% 98%;
    --popover: 222.2 84% 4.9%;
    --popover-foreground: 210 40% 98%;
    --primary: 210 40% 98%;
    --primary-foreground: 222.2 47.4% 11.2%;
    --secondary: 217.2 32.6% 17.5%;
    --secondary-foreground: 210 40% 98%;
    --muted: 217.2 32.6% 17.5%;
    --muted-foreground: 215 20.2% 65.1%;
    --accent: 217.2 32.6% 17.5%;
    --accent-foreground: 210 40% 98%;
    --destructive: 0 62.8% 30.6%;
    --destructive-foreground: 210 40% 98%;
    --border: 217.2 32.6% 17.5%;
    --input: 217.2 32.6% 17.5%;
    --ring: 212.7 26.8% 83.9%;
    --chart-1: 220 70% 50%;
    --chart-2: 160 60% 45%;
    --chart-3: 30 80% 55%;
    --chart-4: 280 65% 60%;
    --chart-5: 340 75% 55%;
    --sidebar: 222.2 84% 4.9%;
    --sidebar-foreground: 210 40% 98%;
    --sidebar-primary: 210 40% 98%;
    --sidebar-primary-foreground: 222.2 47.4% 11.2%;
    --sidebar-accent: 217.2 32.6% 17.5%;
    --sidebar-accent-foreground: 210 40% 98%;
    --sidebar-border: 217.2 32.6% 17.5%;
    --sidebar-ring: 212.7 26.8% 83.9%;
  }
}


body {
  @apply bg-background text-foreground;
  font-family: "Space Grotesk", "Plus Jakarta Sans", "IBM Plex Sans", "Noto Sans", sans-serif;
}

.text-muted {
  color: hsl(var(--muted-foreground));
}

[v-cloak] {
  display: none;
}

.app-bg {
  background-color: hsl(var(--background));
}

.app-shell {
  @apply flex min-h-screen w-full;
}

.sidebar-surface {
  @apply fixed left-0 top-0 flex h-screen w-72 flex-col overflow-y-auto bg-sidebar text-sidebar-foreground border-r border-sidebar-border;
}

.main-surface {
  @apply flex-1 min-w-0 bg-background px-6 py-6;
  margin-left: 18rem;
}

.main-surface-login {
  @apply flex w-full items-center justify-center bg-background px-6 py-12;
}

.nav-item {
  @apply flex w-full items-center gap-2 rounded-xl px-4 py-2 text-left text-sm text-muted transition;
}

.nav-item-active {
  @apply bg-sidebar-accent text-sidebar-foreground;
}

.sidebar-brand {
  @apply flex items-center gap-3 rounded-lg border border-sidebar-border bg-sidebar-accent px-3 py-2;
}

.sidebar-brand-icon {
  @apply flex h-[3.25rem] w-[4.25rem] items-center justify-center rounded-lg bg-sidebar px-1;
}

.sidebar-brand-icon img {
  @apply h-[4.25rem] w-[4.25rem] object-contain;
}

.sidebar-group {
  @apply flex flex-col;
}

.sidebar-group-label {
  @apply px-2 text-[10px] uppercase tracking-[0.3em] text-muted;
}

.sidebar-menu-button {
  @apply flex w-full items-center gap-3 rounded-lg px-2 py-1 text-left text-[12px] font-medium leading-none text-sidebar-foreground/70 transition;
}

.nav-link {
  @apply flex h-7 w-full items-center gap-3 rounded-md px-2 text-left text-[12px] font-medium leading-none text-sidebar-foreground/70 transition;
  border: 1px solid transparent;
}

.nav-link:hover {
  @apply text-sidebar-foreground bg-sidebar-accent;
  border-color: hsl(var(--sidebar-border));
}

.nav-link-active {
  @apply text-sidebar-foreground bg-sidebar-accent;
  border-color: hsl(var(--sidebar-border));
  box-shadow: inset 0 0 0 1px hsl(var(--sidebar-border));
}

.status-pill {
  @apply inline-flex items-center gap-2 rounded-full border border-border/60 bg-muted/60 px-3 py-1 text-xs text-muted-foreground;
}

.status-pill-sm {
  @apply gap-1 px-2 py-0.5 text-[10px];
}

.status-dot {
  @apply h-2 w-2 rounded-full;
}

.status-dot-live {
  @apply bg-emerald-400;
  box-shadow: 0 0 10px rgba(123, 228, 149, 0.6);
}

.status-dot-offline {
  @apply bg-red-400;
  box-shadow: 0 0 10px rgba(248, 113, 113, 0.6);
}

.pill-toggle {
  @apply inline-flex items-center rounded-full border border-border/60 bg-muted/60 px-3 py-1 text-[10px] uppercase tracking-[0.2em] text-muted-foreground transition;
}

.pill-toggle-active {
  @apply text-foreground bg-background;
  border-color: hsl(var(--border));
}

.devwatch-controls {
  @apply flex flex-wrap items-center justify-end gap-3;
}

.devwatch-settings {
  @apply flex flex-wrap items-center gap-3;
}

.card-texture {
  background-image: none;
}

.terminal-pane {
  @apply relative max-h-[70vh] min-h-[280px] overflow-auto rounded-xl border border-border bg-muted/20 p-4 text-xs text-foreground;
  font-family: "JetBrains Mono", "SFMono-Regular", "Menlo", "Monaco", "Consolas", "Liberation Mono", monospace;
  white-space: pre-wrap;
}

.terminal-lines {
  position: relative;
  width: 100%;
}

.terminal-empty {
  position: absolute;
  top: 16px;
  left: 16px;
  pointer-events: none;
}

.terminal-line {
  @apply block text-[13px];
  line-height: 1.3;
}
.terminal-line-content {
  @apply inline;
  word-break: break-word;
}
.terminal-line-actions {
  @apply inline-flex gap-2 items-center;
  opacity: 0;
  transition: opacity 120ms ease;
  pointer-events: none;
  user-select: none;
  vertical-align: text-top;
  margin-left: 0.5rem;
}
.terminal-line:hover .terminal-line-actions {
  opacity: 1;
  pointer-events: auto;
}
.terminal-line-action {
  @apply inline-flex h-4 items-center justify-center rounded-full border border-border/50 bg-white/10 px-2 text-[10px] uppercase tracking-[0.18em] text-muted;
  font-weight: 600;
  min-width: 42px;
  user-select: none;
}

.terminal-follow-wrap {
  position: sticky;
  bottom: 16px;
  display: flex;
  justify-content: flex-end;
  pointer-events: none;
  padding-right: 0.75rem;
}

.terminal-follow {
  pointer-events: auto;
  @apply inline-flex items-center rounded-full border border-border/60 bg-white/5 px-3 py-1 text-[10px] uppercase tracking-[0.2em] text-muted;
  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.32);
}

.toaster {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  position: fixed;
  right: 1.5rem;
  bottom: 1.5rem;
  z-index: 50;
  pointer-events: none;
}

.toaster .toast {
  font-size: 0.75rem;
  color: #f8fafc;
  gap: 0.65rem;
  align-items: center;
  display: flex;
  padding: 0.85rem 1rem;
  border-radius: 1.5rem;
  background: linear-gradient(120deg, rgba(255, 255, 255, 0.04), rgba(5, 8, 12, 0.88));
  border: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 25px 45px rgba(0, 0, 0, 0.65);
  backdrop-filter: blur(16px);
  pointer-events: auto;
}

.toaster .toast-description {
  color: rgba(255, 255, 255, 0.8);
}

.toaster .toast-action {
  background: rgba(255, 255, 255, 0.12);
  border-color: rgba(255, 255, 255, 0.2);
  color: #f8fafc;
  padding: 0.1rem 0.4rem;
  border-radius: 999px;
}
