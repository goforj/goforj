package events

import (
	"context"
	"fmt"
	"runtime"
	"sync"
	"sync/atomic"
	"time"

	"github.com/goforj/env/v2"
)

type inprocBus struct {
	mu           sync.RWMutex
	subs         map[string]map[uint64]Handler
	nextID       uint64
	workQueue    chan inprocDelivery
	shutdownCh   chan struct{}
	shutdownOnce sync.Once
	startOnce    sync.Once
	workersWG    sync.WaitGroup
	shuttingDown atomic.Bool
	workers      int
	bufferSize   int
}

type inprocDelivery struct {
	topic   string
	payload []byte
	handler Handler
}

type inprocSubscription struct {
	bus   *inprocBus
	topic string
	id    uint64
	once  sync.Once
}

func newInprocBus() Bus {
	workers := env.GetInt("EVENTS_INPROC_WORKERS", "0")
	if workers <= 0 {
		workers = runtime.NumCPU()
	}
	if workers <= 0 {
		workers = 1
	}
	bufferSize := env.GetInt("EVENTS_INPROC_BUFFER", "1024")
	if bufferSize <= 0 {
		bufferSize = workers
	}

	return &inprocBus{
		subs:       make(map[string]map[uint64]Handler),
		shutdownCh: make(chan struct{}),
		workers:    workers,
		bufferSize: bufferSize,
	}
}

func (b *inprocBus) Driver() Driver {
	return DriverInproc
}

func (b *inprocBus) Start(_ context.Context) error {
	if b.shuttingDown.Load() {
		return fmt.Errorf("events bus is shutting down")
	}
	b.startOnce.Do(func() {
		b.workQueue = make(chan inprocDelivery, b.bufferSize)
		for i := 0; i < b.workers; i++ {
			b.workersWG.Add(1)
			go b.worker()
		}
	})
	return nil
}

func (b *inprocBus) Publish(ctx context.Context, topic string, payload []byte) error {
	if topic == "" {
		return fmt.Errorf("topic is required")
	}
	if b.shuttingDown.Load() {
		return fmt.Errorf("events bus is shutting down")
	}
	if err := b.Start(ctx); err != nil {
		return err
	}

	handlers := b.snapshotHandlers(topic)
	if len(handlers) == 0 {
		return nil
	}

	for _, handler := range handlers {
		delivery := inprocDelivery{
			topic:   topic,
			payload: cloneBytes(payload),
			handler: handler,
		}
		select {
		case b.workQueue <- delivery:
		case <-ctx.Done():
			return ctx.Err()
		case <-b.shutdownCh:
			return fmt.Errorf("events bus is shutting down")
		}
	}
	return nil
}

func (b *inprocBus) Subscribe(_ context.Context, topic string, handler Handler) (Subscription, error) {
	if topic == "" {
		return nil, fmt.Errorf("topic is required")
	}
	if handler == nil {
		return nil, fmt.Errorf("handler is required")
	}
	if b.shuttingDown.Load() {
		return nil, fmt.Errorf("events bus is shutting down")
	}
	if err := b.Start(context.Background()); err != nil {
		return nil, err
	}

	id := atomic.AddUint64(&b.nextID, 1)
	b.mu.Lock()
	if _, ok := b.subs[topic]; !ok {
		b.subs[topic] = make(map[uint64]Handler)
	}
	b.subs[topic][id] = handler
	b.mu.Unlock()

	return &inprocSubscription{
		bus:   b,
		topic: topic,
		id:    id,
	}, nil
}

func (b *inprocBus) Close(ctx context.Context) error {
	b.shutdownOnce.Do(func() {
		b.shuttingDown.Store(true)
		close(b.shutdownCh)
		if b.workQueue != nil {
			close(b.workQueue)
		}
	})
	return waitWithContext(ctx, &b.workersWG)
}

func (b *inprocBus) worker() {
	defer b.workersWG.Done()
	for delivery := range b.workQueue {
		_ = delivery.handler(context.Background(), Event{
			Topic:      delivery.topic,
			Payload:    cloneBytes(delivery.payload),
			OccurredAt: time.Now().UTC(),
		})
	}
}

func (b *inprocBus) snapshotHandlers(topic string) []Handler {
	b.mu.RLock()
	defer b.mu.RUnlock()
	entries, ok := b.subs[topic]
	if !ok || len(entries) == 0 {
		return nil
	}
	handlers := make([]Handler, 0, len(entries))
	for _, handler := range entries {
		handlers = append(handlers, handler)
	}
	return handlers
}

func (s *inprocSubscription) Close() error {
	if s == nil || s.bus == nil {
		return nil
	}
	s.once.Do(func() {
		s.bus.mu.Lock()
		defer s.bus.mu.Unlock()
		entries, ok := s.bus.subs[s.topic]
		if !ok {
			return
		}
		delete(entries, s.id)
		if len(entries) == 0 {
			delete(s.bus.subs, s.topic)
		}
	})
	return nil
}

func waitWithContext(ctx context.Context, waitGroup *sync.WaitGroup) error {
	done := make(chan struct{})
	go func() {
		waitGroup.Wait()
		close(done)
	}()
	if ctx == nil {
		<-done
		return nil
	}
	select {
	case <-done:
		return nil
	case <-ctx.Done():
		return ctx.Err()
	}
}
