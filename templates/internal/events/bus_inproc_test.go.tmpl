package events

import (
	"context"
	"sync/atomic"
	"testing"
	"time"
)

func TestInprocBusPublishSubscribe(t *testing.T) {
	bus := newInprocBus()
	t.Cleanup(func() { _ = bus.Close(context.Background()) })

	received := make(chan Event, 1)
	sub, err := bus.Subscribe(context.Background(), "monitor.down", func(_ context.Context, event Event) error {
		received <- event
		return nil
	})
	if err != nil {
		t.Fatalf("subscribe failed: %v", err)
	}
	t.Cleanup(func() { _ = sub.Close() })

	if err := bus.Publish(context.Background(), "monitor.down", []byte("payload")); err != nil {
		t.Fatalf("publish failed: %v", err)
	}

	select {
	case event := <-received:
		if event.Topic != "monitor.down" {
			t.Fatalf("expected topic monitor.down, got %q", event.Topic)
		}
		if string(event.Payload) != "payload" {
			t.Fatalf("expected payload, got %q", string(event.Payload))
		}
	case <-time.After(300 * time.Millisecond):
		t.Fatal("expected subscription to receive event")
	}
}

func TestInprocBusMultipleSubscribers(t *testing.T) {
	bus := newInprocBus()
	t.Cleanup(func() { _ = bus.Close(context.Background()) })

	var hits atomic.Int64
	for i := 0; i < 2; i++ {
		_, err := bus.Subscribe(context.Background(), "topic", func(_ context.Context, _ Event) error {
			hits.Add(1)
			return nil
		})
		if err != nil {
			t.Fatalf("subscribe failed: %v", err)
		}
	}

	if err := bus.Publish(context.Background(), "topic", []byte("x")); err != nil {
		t.Fatalf("publish failed: %v", err)
	}

	deadline := time.Now().Add(500 * time.Millisecond)
	for time.Now().Before(deadline) {
		if hits.Load() == 2 {
			return
		}
		time.Sleep(10 * time.Millisecond)
	}
	t.Fatalf("expected 2 handler hits, got %d", hits.Load())
}

func TestInprocSubscriptionCloseStopsDelivery(t *testing.T) {
	bus := newInprocBus()
	t.Cleanup(func() { _ = bus.Close(context.Background()) })

	var hits atomic.Int64
	sub, err := bus.Subscribe(context.Background(), "topic", func(_ context.Context, _ Event) error {
		hits.Add(1)
		return nil
	})
	if err != nil {
		t.Fatalf("subscribe failed: %v", err)
	}
	if err := sub.Close(); err != nil {
		t.Fatalf("subscription close failed: %v", err)
	}

	if err := bus.Publish(context.Background(), "topic", []byte("x")); err != nil {
		t.Fatalf("publish failed: %v", err)
	}
	time.Sleep(80 * time.Millisecond)
	if hits.Load() != 0 {
		t.Fatalf("expected no handler calls after close, got %d", hits.Load())
	}
}

func TestInprocBusCloseWaitsForRunningHandlers(t *testing.T) {
	t.Setenv("EVENTS_INPROC_WORKERS", "1")
	bus := newInprocBus()

	started := make(chan struct{}, 1)
	finished := make(chan struct{}, 1)
	_, err := bus.Subscribe(context.Background(), "topic", func(_ context.Context, _ Event) error {
		started <- struct{}{}
		time.Sleep(100 * time.Millisecond)
		finished <- struct{}{}
		return nil
	})
	if err != nil {
		t.Fatalf("subscribe failed: %v", err)
	}

	if err := bus.Publish(context.Background(), "topic", []byte("x")); err != nil {
		t.Fatalf("publish failed: %v", err)
	}
	select {
	case <-started:
	case <-time.After(250 * time.Millisecond):
		t.Fatal("handler did not start")
	}

	done := make(chan error, 1)
	go func() {
		done <- bus.Close(context.Background())
	}()
	select {
	case <-done:
		t.Fatal("close returned before handler finished")
	case <-time.After(40 * time.Millisecond):
	}

	select {
	case <-finished:
	case <-time.After(300 * time.Millisecond):
		t.Fatal("handler did not finish")
	}
	select {
	case err := <-done:
		if err != nil {
			t.Fatalf("close failed: %v", err)
		}
	case <-time.After(300 * time.Millisecond):
		t.Fatal("expected close to return after handler completion")
	}
}

func TestInprocBusPublishAfterCloseFails(t *testing.T) {
	bus := newInprocBus()
	if err := bus.Close(context.Background()); err != nil {
		t.Fatalf("close failed: %v", err)
	}
	if err := bus.Publish(context.Background(), "topic", []byte("x")); err == nil {
		t.Fatal("expected publish to fail after close")
	}
}
