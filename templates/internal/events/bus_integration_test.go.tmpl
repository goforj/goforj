//go:build integration
// +build integration

package events

import (
	"context"
	"testing"
	"time"
)

// inprocIntegrationEvent keeps the transport test independent of optional application examples.
type inprocIntegrationEvent struct {
	ID string
}

// Topic returns the stable topic used by the in-process transport integration test.
func (inprocIntegrationEvent) Topic() string {
	return "events.integration"
}

// TestInprocBusIntegration verifies the generated in-process transport can publish typed events.
func TestInprocBusIntegration(t *testing.T) {
	t.Setenv("EVENTS_DRIVER", "inproc")
	bus := NewBus(context.Background())
	t.Cleanup(func() { _ = bus.Close(context.Background()) })

	received := make(chan string, 1)
	sub, err := bus.WithContext(context.Background()).Subscribe(func(_ context.Context, payload inprocIntegrationEvent) error {
		received <- payload.ID
		return nil
	})
	if err != nil {
		t.Fatalf("subscribe failed: %v", err)
	}
	t.Cleanup(func() { _ = sub.Close() })

	err = bus.WithContext(context.Background()).Publish(inprocIntegrationEvent{
		ID: "event_1",
	})
	if err != nil {
		t.Fatalf("publish failed: %v", err)
	}

	select {
	case id := <-received:
		if id != "event_1" {
			t.Fatalf("expected event_1, got %q", id)
		}
	case <-time.After(500 * time.Millisecond):
		t.Fatal("expected inproc event delivery")
	}
}

// TestUnknownDriverReturnsErrorBus verifies an active driver cannot bypass the generated build contract.
func TestUnknownDriverReturnsErrorBus(t *testing.T) {
	t.Setenv("EVENTS_DRIVER", "unknown")
	bus := NewBus(context.Background())
	t.Cleanup(func() { _ = bus.Close(context.Background()) })

	if err := bus.Start(context.Background()); err == nil {
		t.Fatal("expected unknown driver to return an error")
	}
}
