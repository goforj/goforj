//go:build integration
// +build integration

package events

import (
	"context"
	"testing"
	"time"
)

func TestInprocBusIntegration(t *testing.T) {
	t.Setenv("EVENTS_DRIVER", "inproc")
	bus := NewBus(context.Background())
	t.Cleanup(func() { _ = bus.Close(context.Background()) })

	received := make(chan string, 1)
	sub, err := bus.WithContext(context.Background()).Subscribe(func(_ context.Context, payload MonitorDown) error {
		received <- payload.MonitorID
		return nil
	})
	if err != nil {
		t.Fatalf("subscribe failed: %v", err)
	}
	t.Cleanup(func() { _ = sub.Close() })

	err = bus.WithContext(context.Background()).Publish(MonitorDown{
		MonitorID: "monitor_1",
		Status:    "down",
		CheckedAt: time.Now().UTC().Format(time.RFC3339),
	})
	if err != nil {
		t.Fatalf("publish failed: %v", err)
	}

	select {
	case id := <-received:
		if id != "monitor_1" {
			t.Fatalf("expected monitor_1, got %q", id)
		}
	case <-time.After(500 * time.Millisecond):
		t.Fatal("expected inproc event delivery")
	}
}

func TestUnsupportedGeneratedDriverReturnsErrorBus(t *testing.T) {
	t.Setenv("EVENTS_DRIVER", "redis")
	bus := NewBus(context.Background())
	t.Cleanup(func() { _ = bus.Close(context.Background()) })

	if err := bus.Start(context.Background()); err == nil {
		t.Fatal("expected unsupported generated driver to return an error")
	}
}
