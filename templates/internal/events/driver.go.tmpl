package events

import (
	"github.com/goforj/env/v2"
	"github.com/goforj/str"
)

// Driver identifies the events backend.
type Driver string

const (
	DriverInproc Driver = "inproc"
	DriverRedis  Driver = "redis"
)

// ActiveDriver resolves the events driver from environment.
func ActiveDriver() Driver {
	value := str.Of(env.Get("EVENTS_DRIVER", string(DriverInproc))).
		TrimSpace().
		ToLower().
		String()

	switch Driver(value) {
	case DriverRedis:
		return DriverRedis
	default:
		return DriverInproc
	}
}

// UsesRedis reports whether redis-backed pub/sub is active.
func UsesRedis() bool {
	return ActiveDriver() == DriverRedis
}
