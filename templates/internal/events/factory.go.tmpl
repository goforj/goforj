package events

import (
	"context"

	"github.com/redis/go-redis/v9"
)

// NewBus resolves the events backend from environment.
func NewBus(_ context.Context, redisClient *redis.Client) Bus {
	switch ActiveDriver() {
	case DriverRedis:
		return newRedisBus(redisClient)
	default:
		return newInprocBus()
	}
}
