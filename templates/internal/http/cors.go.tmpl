package http

import (
	"github.com/goforj/env/v2"
	"github.com/goforj/web"
	"github.com/goforj/web/webmiddleware"
	"net/http"
	"strings"
)

// mountCors configures the CORS middleware.
func (s *Server) mountCors(router web.Router) error {
	// cors
	corsAllow := env.Get("HTTP_CORS_ALLOW_ENDPOINTS", "")
	endpoints := strings.Split(corsAllow, ",")

	// remove empty strings
	for i := len(endpoints) - 1; i >= 0; i-- {
		if endpoints[i] == "" {
			endpoints = append(endpoints[:i], endpoints[i+1:]...)
		}
	}

	if len(endpoints) == 0 && env.IsAppEnvLocal() {
		// If no endpoints are specified and the app is in dev mode, allow all origins
		endpoints = []string{"http://localhost:8080"}
	}

	router.Use(webmiddleware.CORSWithConfig(webmiddleware.CORSConfig{
		AllowOrigins: endpoints,
		AllowMethods: []string{
			http.MethodOptions,
			http.MethodGet,
			http.MethodHead,
			http.MethodPut,
			http.MethodPatch,
			http.MethodPost,
			http.MethodDelete,
		},
		AllowCredentials: true,
	}))
	return nil
}
