package http

import (
	"context"
	"{{.GoModuleName}}/internal/devconsole"
	"{{.GoModuleName}}/internal/logger"
)

// StartDevConsoleAgent boots the dev console agent for the API process.
func StartDevConsoleAgent(ctx context.Context, server *Server, logger *logger.AppLogger) {
	if !devconsole.Enabled() {
		return
	}
	agent := devconsole.NewAgent(devconsole.LoadAgentConfig("api"))
	logger.AddSink(devconsole.NewLogSink(agent))
	agent.RegisterCapability("cli")
	agent.RegisterCapability("routes")
	agent.RegisterCommand("routes:list", func(cmd devconsole.Command) (any, error) {
		return map[string]any{
			"routes": server.RoutesForConsole(),
		}, nil
	})
	agent.RegisterCommand("cli:run", func(cmd devconsole.Command) (any, error) {
		params, err := devconsole.Decode[struct {
			Args []string `json:"args"`
		}](cmd)
		if err != nil {
			return nil, err
		}
		result, _ := devconsole.RunCLICommand(ctx, params.Args)
		return map[string]any{
			"result": result,
		}, nil
	})
	agent.RegisterCommand("cli:list", func(cmd devconsole.Command) (any, error) {
		commands, err := devconsole.ListCLICommands(ctx)
		if err != nil {
			return nil, err
		}
		return map[string]any{
			"commands": commands,
		}, nil
	})
	go func() {
		_ = agent.Start(ctx)
	}()
}
