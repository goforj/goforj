package http

import (
	"context"
	"net/http"
	"strings"
	"time"

	"github.com/goforj/env/v2"
	"github.com/goforj/web"
)

var healthStatusOKJSON = []byte(`{"status":"ok"}`)

// healthRoutes returns lightweight liveness/readiness probe routes.
func (s *Server) healthRoutes() []web.RouteGroup {
	return []web.RouteGroup{
		web.NewRouteGroup(
			"",
			[]web.Route{
				web.NewRoute(http.MethodGet, "/-/health", s.healthStatus),
				web.NewRoute(http.MethodGet, "/-/ready", s.readinessStatus),
			},
		),
	}
}

func (s *Server) healthStatus(r web.Context) error {
	// The hot health path returns a stable payload, so keep it allocation-light
	// by reusing a precomputed JSON body instead of rebuilding a map each time.
	return r.Blob(http.StatusOK, "application/json; charset=UTF-8", healthStatusOKJSON)
}

func (s *Server) readinessStatus(r web.Context) error {
	detailed := diagnosticsAuthorized(r)
	statusCode, payload := s.readinessResponse(r.Context(), detailed, detailed)
	return r.JSON(statusCode, payload)
}

type readinessCheckResult struct {
	Type   string `json:"type"`
	Name   string `json:"name"`
	Driver string `json:"driver,omitempty"`
	Status string `json:"status"`
	Error  string `json:"error,omitempty"`
}

func (s *Server) readinessResponse(ctx context.Context, includeChecks bool, includeErrors bool) (int, map[string]any) {
	if len(s.readinessChecks) == 0 {
		return readinessPayload(http.StatusOK, includeChecks, nil)
	}

	results := make([]readinessCheckResult, 0, len(s.readinessChecks))
	hasFailures := false
	for _, check := range s.readinessChecks {
		checkType, checkName := splitReadinessCheckName(check.Name)
		result := readinessCheckResult{
			Type:   checkType,
			Name:   checkName,
			Status: "ok",
		}
		if includeChecks {
			result.Driver = readinessCheckDriver(checkType, checkName)
		}
		checkCtx, cancel := context.WithTimeout(ctx, 2*time.Second)
		err := check.Check(checkCtx)
		cancel()
		if err != nil {
			result.Status = "failed"
			if includeErrors {
				result.Error = err.Error()
			}
			logEvent := s.logger.Error().
				Err(err).
				Any("check_type", checkType).
				Any("check_name", checkName)
			if driver := readinessCheckDriver(checkType, checkName); driver != "" {
				logEvent = logEvent.Any("driver", driver)
			}
			logEvent.Msg("Readiness check failed")
			hasFailures = true
		}
		results = append(results, result)
	}

	if hasFailures {
		return readinessPayload(http.StatusServiceUnavailable, includeChecks, results)
	}

	return readinessPayload(http.StatusOK, includeChecks, results)
}

func splitReadinessCheckName(raw string) (string, string) {
	kind, entity, ok := strings.Cut(strings.TrimSpace(raw), "_")
	if !ok || kind == "" || entity == "" {
		return "unknown", raw
	}
	return kind, entity
}

func diagnosticsAuthorized(r web.Context) bool {
	token := strings.TrimSpace(env.Get("APP_DIAG_TOKEN", ""))
	if token == "" {
		return false
	}
	auth := strings.TrimSpace(r.Header("Authorization"))
	if strings.HasPrefix(strings.ToLower(auth), "bearer ") {
		return strings.TrimSpace(auth[len("Bearer "):]) == token
	}
	return false
}

func readinessPayload(statusCode int, includeChecks bool, checks []readinessCheckResult) (int, map[string]any) {
	status := "ready"
	if statusCode != http.StatusOK {
		status = "not_ready"
	}
	payload := map[string]any{
		"status": status,
	}
	if includeChecks {
		if checks == nil {
			checks = []readinessCheckResult{}
		}
		payload["checks"] = checks
	}
	return statusCode, payload
}

func readinessCheckDriver(checkType string, checkName string) string {
	switch strings.ToLower(strings.TrimSpace(checkType)) {
	case "cache":
		return cacheDriver(checkName)
	case "db":
		return dbDriver(checkName)
	case "storage":
		return storageDriver(checkName)
	case "events":
		return eventDriver(checkName)
	case "queue":
		return queueDriver(checkName)
	default:
		return ""
	}
}

func cacheDriver(name string) string {
	key := "CACHE_DRIVER"
	if !strings.EqualFold(strings.TrimSpace(name), "default") {
		key = "CACHE_" + strings.ToUpper(strings.TrimSpace(name)) + "_DRIVER"
	}
	return strings.TrimSpace(env.Get(key, env.Get("CACHE_DRIVER", "memory")))
}

