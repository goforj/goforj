package http

import (
	"context"
	"net/http"
	"strings"
	"time"

	appinfo "{{.GoModuleName}}/internal/app"
	"github.com/labstack/echo/v4"
)

// registerHealthRoutes adds lightweight liveness/readiness probes.
func (s *Server) registerHealthRoutes(e *echo.Echo) {
	e.GET("/-/health", func(c echo.Context) error {
		return c.JSON(http.StatusOK, map[string]string{"status": "ok"})
	})
	e.GET("/-/ready", func(c echo.Context) error {
		statusCode, payload := s.readinessResponse(c.Request().Context(), readinessDetailRequested(c))
		return c.JSON(statusCode, payload)
	})
}

type readinessCheckResult struct {
	Type   string `json:"type"`
	Name   string `json:"name"`
	Status string `json:"status"`
}

func (s *Server) readinessResponse(ctx context.Context, includeChecks bool) (int, map[string]any) {
	if len(s.readinessChecks) == 0 {
		return readinessPayload(http.StatusOK, includeChecks, nil)
	}

	results := make([]readinessCheckResult, 0, len(s.readinessChecks))
	hasFailures := false
	for _, check := range s.readinessChecks {
		checkType, checkName := splitReadinessCheckName(check.Name)
		result := readinessCheckResult{
			Type:   checkType,
			Name:   checkName,
			Status: "ok",
		}
		checkCtx, cancel := context.WithTimeout(ctx, 2*time.Second)
		err := check.Check(checkCtx)
		cancel()
		if err != nil {
			result.Status = "failed"
			logEvent := s.logger.Error().
				Err(err).
				Any("check_type", checkType).
				Any("check_name", checkName)
			if driver := readinessCheckDriver(checkType, checkName); driver != "" {
				logEvent = logEvent.Any("driver", driver)
			}
			logEvent.Msg("Readiness check failed")
			hasFailures = true
		}
		results = append(results, result)
	}

	if hasFailures {
		return readinessPayload(http.StatusServiceUnavailable, includeChecks, results)
	}

	return readinessPayload(http.StatusOK, includeChecks, results)
}

func splitReadinessCheckName(raw string) (string, string) {
	kind, entity, ok := strings.Cut(strings.TrimSpace(raw), "_")
	if !ok || kind == "" || entity == "" {
		return "unknown", raw
	}
	return kind, entity
}

func readinessDetailRequested(c echo.Context) bool {
	switch strings.ToLower(strings.TrimSpace(c.QueryParam("detail"))) {
	case "1", "true", "yes", "on":
		return true
	default:
		return false
	}
}

func readinessPayload(statusCode int, includeChecks bool, checks []readinessCheckResult) (int, map[string]any) {
	status := "ready"
	if statusCode != http.StatusOK {
		status = "not_ready"
	}
	payload := map[string]any{
		"status": status,
	}
	if includeChecks {
		if checks == nil {
			checks = []readinessCheckResult{}
		}
		payload["checks"] = checks
	}
	return statusCode, payload
}

func readinessCheckDriver(checkType string, checkName string) string {
	lookup := func(instances []appinfo.PrimitiveInstance) string {
		for _, instance := range instances {
			if strings.EqualFold(strings.TrimSpace(instance.Name), strings.TrimSpace(checkName)) {
				return instance.Driver
			}
		}
		return ""
	}

	switch strings.ToLower(strings.TrimSpace(checkType)) {
	case "cache":
		return lookup(appinfo.DiscoverCacheInstances())
	case "db":
		return lookup(appinfo.DiscoverDatabaseInstances())
	case "storage":
		return lookup(appinfo.DiscoverStorageInstances())
	case "events":
		return lookup(appinfo.DiscoverEventInstances())
	case "queue":
		return lookup(appinfo.DiscoverQueueInstances())
	default:
		return ""
	}
}
