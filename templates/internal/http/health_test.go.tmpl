package http

import (
	"context"
	"errors"
	"fmt"
	"net/http"
	"net/http/httptest"
	"testing"

	"{{.GoModuleName}}/internal/logger"
	"github.com/stretchr/testify/assert"
)

func TestHealthAndReadinessEndpoints(t *testing.T) {
	s := &Server{
		logger:          logger.NewSilentLogger(),
		readinessChecks: []ReadinessCheck{},
	}
	e := s.bootstrap()

	testCases := []struct {
		path         string
		expectedBody string
	}{
		{path: "/-/health", expectedBody: `{"status":"ok"}`},
		{path: "/-/ready", expectedBody: `{"status":"ready"}`},
		{path: "/-/ready?detail=1", expectedBody: `{"status":"ready","checks":[]}`},
	}

	for _, testCase := range testCases {
		t.Run(testCase.path, func(t *testing.T) {
			req := httptest.NewRequest(http.MethodGet, testCase.path, nil)
			rec := httptest.NewRecorder()

			e.ServeHTTP(rec, req)

			assert.Equal(t, http.StatusOK, rec.Code)
			assert.JSONEq(t, testCase.expectedBody, rec.Body.String(), fmt.Sprintf("unexpected payload for %s", testCase.path))
		})
	}
}

func TestReadinessEndpointsReturn503WhenDependencyFails(t *testing.T) {
	s := &Server{
		logger: logger.NewSilentLogger(),
		readinessChecks: []ReadinessCheck{
			{
				Name: "cache_default",
				Check: func(_ context.Context) error {
					return nil
				},
			},
			{
				Name: "db_default",
				Check: func(_ context.Context) error {
					return errors.New("dial tcp 127.0.0.1:5432: connect: connection refused")
				},
			},
		},
	}
	e := s.bootstrap()

	req := httptest.NewRequest(http.MethodGet, "/-/ready", nil)
	rec := httptest.NewRecorder()

	e.ServeHTTP(rec, req)

	assert.Equal(t, http.StatusServiceUnavailable, rec.Code)
	assert.JSONEq(
		t,
		`{"status":"not_ready"}`,
		rec.Body.String(),
	)
}

func TestReadinessDetailReturnsChecksWhenRequested(t *testing.T) {
	s := &Server{
		logger: logger.NewSilentLogger(),
		readinessChecks: []ReadinessCheck{
			{
				Name: "cache_default",
				Check: func(_ context.Context) error {
					return nil
				},
			},
			{
				Name: "db_default",
				Check: func(_ context.Context) error {
					return errors.New("dial tcp 127.0.0.1:5432: connect: connection refused")
				},
			},
		},
	}
	e := s.bootstrap()

	req := httptest.NewRequest(http.MethodGet, "/-/ready?detail=1", nil)
	rec := httptest.NewRecorder()

	e.ServeHTTP(rec, req)

	assert.Equal(t, http.StatusServiceUnavailable, rec.Code)
	assert.JSONEq(
		t,
		`{"status":"not_ready","checks":[{"type":"cache","name":"default","status":"ok"},{"type":"db","name":"default","status":"failed"}]}`,
		rec.Body.String(),
	)
}
