func TestHealthAndReadinessEndpoints(t *testing.T) {
	t.Setenv("APP_DIAG_TOKEN", "diag-token")

	s := NewServer(logger.NewSilentLogger(), runtime.NewTimeouts(), nil, []ReadinessCheck{}, nil, nil, nil{{- if .Components.Metrics }}, metrics.NewManager(){{- end }})
	e, err := s.bootstrap("")
	assert.NoError(t, err)

	testCases := []struct {
		path         string
		expectedBody string
		expectedCode int
	}{
		{path: "/-/health", expectedBody: `{"status":"ok"}`, expectedCode: http.StatusOK},
		{path: "/-/ready", expectedBody: `{"status":"ready"}`, expectedCode: http.StatusOK},
	}

	for _, testCase := range testCases {
		t.Run(testCase.path, func(t *testing.T) {
			req := httptest.NewRequest(http.MethodGet, testCase.path, nil)
			rec := httptest.NewRecorder()

			e.ServeHTTP(rec, req)

			assert.Equal(t, testCase.expectedCode, rec.Code)
			assert.JSONEq(t, testCase.expectedBody, rec.Body.String(), fmt.Sprintf("unexpected payload for %s", testCase.path))
		})
	}
}

func TestReadinessEndpointsReturn503WhenDependencyFails(t *testing.T) {
	s := NewServer(logger.NewSilentLogger(), runtime.NewTimeouts(), nil, []ReadinessCheck{
			{
				Name: "cache_default",
				Check: func(_ context.Context) error {
					return nil
				},
			},
			{
				Name: "db_default",
				Check: func(_ context.Context) error {
					return errors.New("dial tcp 127.0.0.1:5432: connect: connection refused")
				},
			},
		}, nil, nil, nil{{- if .Components.Metrics }}, metrics.NewManager(){{- end }})
	e, err := s.bootstrap("")
	assert.NoError(t, err)

	req := httptest.NewRequest(http.MethodGet, "/-/ready", nil)
	rec := httptest.NewRecorder()

	e.ServeHTTP(rec, req)

	assert.Equal(t, http.StatusServiceUnavailable, rec.Code)
	assert.JSONEq(
		t,
		`{"status":"not_ready"}`,
		rec.Body.String(),
	)
}

func TestReadinessFullReturnsErrorsWhenAuthorized(t *testing.T) {
	t.Setenv("APP_DIAG_TOKEN", "diag-token")
	t.Setenv("DB_DRIVER", "mysql")

	s := NewServer(logger.NewSilentLogger(), runtime.NewTimeouts(), nil, []ReadinessCheck{
			{
				Name: "db_default",
				Check: func(_ context.Context) error {
					return errors.New("dial tcp 127.0.0.1:5432: connect: connection refused")
				},
			},
		}, nil, nil, nil{{- if .Components.Metrics }}, metrics.NewManager(){{- end }})
	e, err := s.bootstrap("")
	assert.NoError(t, err)

	req := httptest.NewRequest(http.MethodGet, "/-/ready", nil)
	req.Header.Set("Authorization", "Bearer diag-token")
	rec := httptest.NewRecorder()

	e.ServeHTTP(rec, req)

	assert.Equal(t, http.StatusServiceUnavailable, rec.Code)
	assert.JSONEq(
		t,
		`{"status":"not_ready","checks":[{"type":"db","name":"default","driver":"mysql","status":"failed","error":"dial tcp 127.0.0.1:5432: connect: connection refused"}]}`,
		rec.Body.String(),
	)
}
