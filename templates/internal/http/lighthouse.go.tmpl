const (
	lighthouseStoragePreviewMaxBytes  int64 = 2 << 20  // 2 MiB
	lighthouseStorageUploadMaxBytes   int64 = 10 << 20 // 10 MiB
	lighthouseStorageDownloadMaxBytes int64 = 32 << 20 // 32 MiB
	lighthouseCachePreviewMaxBytes    int64 = 1 << 20  // 1 MiB
)

// LighthouseRuntime boots the dev console agent for the HTTP process.
type LighthouseRuntime struct {
	agent   *lighthouse.Agent
	logger  *logger.AppLogger
	server  *Server
	caches  *caches.Manager
	storage *storages.Manager
	inspects *inspects.Manager
{{- if .Components.Metrics }}
	metrics *metrics.Manager
{{- end }}
}

// NewLighthouseRuntime creates the Lighthouse runtime for the HTTP process.
func NewLighthouseRuntime(logger *logger.AppLogger, server *Server, caches *caches.Manager, storage *storages.Manager, inspectManager *inspects.Manager{{- if .Components.Metrics }}, metricsManager *metrics.Manager{{- end }}) *LighthouseRuntime {
	componentLogger := logger
	if componentLogger != nil {
		componentLogger = componentLogger.WithComponent("HTTP")
	}
	return &LighthouseRuntime{
		agent:   lighthouse.NewAgent(lighthouse.LoadAgentConfig("http")),
		logger:  componentLogger,
		server:  server,
		caches:  caches,
		storage: storage,
		inspects: inspectManager,
{{- if .Components.Metrics }}
		metrics: metricsManager,
{{- end }}
	}
}

// Start boots the dev console agent for the HTTP process.
func (r *LighthouseRuntime) Start(ctx context.Context) {
	if !lighthouse.Enabled() {
		return
	}
	r.logger.AddSink(lighthouse.NewLogSink(r.agent))
	if r.inspects != nil {
		publisher := lighthouse.NewInspectPublisher(r.agent{{- if .Components.Metrics }}, r.metrics{{- end }})
		r.inspects.SetPublisher(publisher)
		r.inspects.SetPublishOnly(true)
		go publisher.Start(ctx)
		r.agent.RegisterCapability("inspects")
	}
	r.agent.RegisterCapability("cli")
	r.agent.RegisterCapability("routes")
	if len(r.cacheStores()) > 0 {
		r.agent.RegisterCapability("cache")
	}
	if len(r.storageDisks()) > 0 {
		r.agent.RegisterCapability("storage")
	}
	r.agent.RegisterCommand("routes:list", func(cmd lighthouse.Command) (any, error) {
		return map[string]any{
			"routes": web.BuildRouteEntries(r.server.GetRoutes()),
		}, nil
	})
	r.agent.RegisterCommand("cache:list", func(cmd lighthouse.Command) (any, error) {
		params, err := lighthouse.Decode[struct {
			Store  string `json:"store"`
			Query  string `json:"query"`
			Prefix string `json:"prefix"`
			Offset int    `json:"offset"`
			Limit  int    `json:"limit"`
		}](cmd)
		if err != nil {
			return nil, err
		}
		query := strings.TrimSpace(params.Query)
		if query == "" {
			query = strings.TrimSpace(params.Prefix)
		}
		return r.cacheListPayload(ctx, params.Store, query, params.Offset, params.Limit)
	})
	r.agent.RegisterCommand("cache:get", func(cmd lighthouse.Command) (any, error) {
		params, err := lighthouse.Decode[struct {
			Store string `json:"store"`
			Key   string `json:"key"`
		}](cmd)
		if err != nil {
			return nil, err
		}
		return r.cacheGetPayload(ctx, params.Store, params.Key)
	})
	r.agent.RegisterCommand("cache:delete", func(cmd lighthouse.Command) (any, error) {
		params, err := lighthouse.Decode[struct {
			Store string `json:"store"`
			Key   string `json:"key"`
		}](cmd)
		if err != nil {
			return nil, err
		}
		return r.cacheDeletePayload(ctx, params.Store, params.Key)
	})
	r.agent.RegisterCommand("cache:set", func(cmd lighthouse.Command) (any, error) {
		params, err := lighthouse.Decode[struct {
			Store      string `json:"store"`
			Key        string `json:"key"`
			Data       string `json:"data"`
			TTLSeconds int    `json:"ttl_seconds"`
		}](cmd)
		if err != nil {
			return nil, err
		}
		return r.cacheSetPayload(ctx, params.Store, params.Key, []byte(params.Data), params.TTLSeconds)
	})
	r.agent.RegisterCommand("storage:list", func(cmd lighthouse.Command) (any, error) {
		params, err := lighthouse.Decode[struct {
			Disk   string `json:"disk"`
			Path   string `json:"path"`
			Offset int    `json:"offset"`
			Limit  int    `json:"limit"`
		}](cmd)
		if err != nil {
			return nil, err
		}
		return r.storageListPayload(ctx, params.Disk, params.Path, params.Offset, params.Limit)
	})
	r.agent.RegisterCommand("storage:get", func(cmd lighthouse.Command) (any, error) {
		params, err := lighthouse.Decode[struct {
			Disk string `json:"disk"`
			Path string `json:"path"`
		}](cmd)
		if err != nil {
			return nil, err
		}
		return r.storageDownloadPayload(ctx, params.Disk, params.Path)
	})
	r.agent.RegisterCommand("storage:url", func(cmd lighthouse.Command) (any, error) {
		params, err := lighthouse.Decode[struct {
			Disk string `json:"disk"`
			Path string `json:"path"`
		}](cmd)
		if err != nil {
			return nil, err
		}
		return r.storageURLPayload(ctx, params.Disk, params.Path)
	})
	r.agent.RegisterCommand("storage:put", func(cmd lighthouse.Command) (any, error) {
		params, err := lighthouse.Decode[struct {
			Disk        string `json:"disk"`
			Path        string `json:"path"`
			Data        []byte `json:"data"`
			ContentType string `json:"content_type"`
		}](cmd)
		if err != nil {
			return nil, err
		}
		return r.storagePutPayload(ctx, params.Disk, params.Path, params.Data)
	})
	r.agent.RegisterCommand("storage:mkdir", func(cmd lighthouse.Command) (any, error) {
		params, err := lighthouse.Decode[struct {
			Disk string `json:"disk"`
			Path string `json:"path"`
		}](cmd)
		if err != nil {
			return nil, err
		}
		return r.storageMkdirPayload(ctx, params.Disk, params.Path)
	})
	r.agent.RegisterCommand("storage:delete", func(cmd lighthouse.Command) (any, error) {
		params, err := lighthouse.Decode[struct {
			Disk string `json:"disk"`
			Path string `json:"path"`
		}](cmd)
		if err != nil {
			return nil, err
		}
		return r.storageDeletePayload(ctx, params.Disk, params.Path)
	})
	r.agent.RegisterCommand("storage:move", func(cmd lighthouse.Command) (any, error) {
		params, err := lighthouse.Decode[struct {
			Disk string `json:"disk"`
			From string `json:"from"`
			To   string `json:"to"`
		}](cmd)
		if err != nil {
			return nil, err
		}
		return r.storageMovePayload(ctx, params.Disk, params.From, params.To)
	})
	r.agent.RegisterCommand("cli:run", func(cmd lighthouse.Command) (any, error) {
		params, err := lighthouse.Decode[struct {
			Args []string `json:"args"`
		}](cmd)
		if err != nil {
			return nil, err
		}
		result, _ := lighthouse.RunCLICommand(ctx, params.Args)
		return map[string]any{
			"result": result,
		}, nil
	})
	r.agent.RegisterCommand("cli:list", func(cmd lighthouse.Command) (any, error) {
		commands, err := lighthouse.ListCLICommands(ctx)
		if err != nil {
			return nil, err
		}
		return map[string]any{
			"commands": commands,
		}, nil
	})
	go func() {
		_ = r.agent.Start(ctx)
	}()
}

type cacheStoreInfo struct {
	Name        string `json:"name"`
	Driver      string `json:"driver"`
	Inspectable bool   `json:"inspectable"`
	CanRead     bool   `json:"can_read"`
	CanDelete   bool   `json:"can_delete"`
	CanTTL      bool   `json:"can_ttl"`
	IsDefault   bool   `json:"is_default"`
}

type cacheEntryInfo struct {
	Key       string `json:"key"`
	Size      int64  `json:"size"`
	ExpiresAt int64  `json:"expires_at,omitempty"`
}

func (r *LighthouseRuntime) cacheStores() []cacheStoreInfo {
	return cacheStores(r.caches)
}

func cacheStores(manager *caches.Manager) []cacheStoreInfo {
	if manager == nil {
		return nil
	}
	instances := manager.Instances()
	stores := make([]cacheStoreInfo, 0, len(instances))
	for _, instance := range instances {
		if instance.Store == nil {
			continue
		}
		inspector, inspectable := instance.Store.Inspector()
		caps := cachecore.InspectorCapabilities{
			CanRead:   true,
			CanDelete: true,
		}
		if inspectable {
			caps = inspector.Capabilities()
		}
		stores = append(stores, cacheStoreInfo{
			Name:        strings.TrimSpace(instance.Name),
			Driver:      strings.TrimSpace(string(instance.Store.Driver())),
			Inspectable: inspectable,
			CanRead:     caps.CanRead,
			CanDelete:   caps.CanDelete,
			CanTTL:      caps.CanTTL,
			IsDefault:   instance.IsDefault,
		})
	}
	sort.Slice(stores, func(i, j int) bool {
		if stores[i].IsDefault != stores[j].IsDefault {
			return stores[i].IsDefault
		}
		return stores[i].Name < stores[j].Name
	})
	return stores
}

func (r *LighthouseRuntime) cacheListPayload(ctx context.Context, storeName string, query string, offset int, limit int) (map[string]any, error) {
	selectedStore, cacheStore, err := resolveCacheStore(r.caches, storeName)
	if err != nil {
		return nil, err
	}
	stores := r.cacheStores()
	inspector, ok := cacheStore.Inspector()
	if !ok {
		return map[string]any{
			"stores":        stores,
			"current_store": selectedStore,
			"query":         strings.TrimSpace(query),
			"inspectable":   false,
			"entries":       []cacheEntryInfo{},
		}, nil
	}
	if offset < 0 {
		offset = 0
	}
	if limit <= 0 {
		limit = 100
	}
	page, err := inspector.ListPage(ctx, cachecore.ListPageOptions{
		Query:  strings.TrimSpace(query),
		Cursor: cachecore.EncodeOffsetCursor(offset),
		Limit:  limit,
	})
	if err != nil {
		return nil, err
	}
	entries := make([]cacheEntryInfo, 0, len(page.Entries))
	for _, entry := range page.Entries {
		item := cacheEntryInfo{
			Key:  entry.Key,
			Size: int64(entry.SizeBytes),
		}
		if entry.ExpiresAt != nil {
			item.ExpiresAt = *entry.ExpiresAt
		}
		entries = append(entries, item)
	}
	return map[string]any{
		"stores":        stores,
		"current_store": selectedStore,
		"query":         strings.TrimSpace(query),
		"inspectable":   true,
		"offset":        offset,
		"limit":         limit,
		"has_more":      page.HasMore,
		"entries":       entries,
	}, nil
}

func (r *LighthouseRuntime) cacheGetPayload(ctx context.Context, storeName string, key string) (map[string]any, error) {
	selectedStore, cacheStore, err := resolveCacheStore(r.caches, storeName)
	if err != nil {
		return nil, err
	}
	key = strings.TrimSpace(key)
	if key == "" {
		return nil, fmt.Errorf("cache: key is required")
	}
	body, ok, err := cacheStore.WithContext(ctx).GetBytes(key)
	if err != nil {
		return nil, err
	}
	if !ok {
		return nil, fmt.Errorf("cache: key %q not found in store %q", key, selectedStore)
	}
	if int64(len(body)) > lighthouseCachePreviewMaxBytes {
		return nil, fmt.Errorf("cache preview exceeds %d bytes", lighthouseCachePreviewMaxBytes)
	}
	return map[string]any{
		"store": selectedStore,
		"key":   key,
		"data":  body,
	}, nil
}

func (r *LighthouseRuntime) cacheDeletePayload(ctx context.Context, storeName string, key string) (map[string]any, error) {
	selectedStore, cacheStore, err := resolveCacheStore(r.caches, storeName)
	if err != nil {
		return nil, err
	}
	key = strings.TrimSpace(key)
	if key == "" {
		return nil, fmt.Errorf("cache: key is required")
	}
	if err := cacheStore.WithContext(ctx).Delete(key); err != nil {
		return nil, err
	}
	return map[string]any{
		"store":   selectedStore,
		"key":     key,
		"deleted": true,
	}, nil
}

func (r *LighthouseRuntime) cacheSetPayload(ctx context.Context, storeName string, key string, data []byte, ttlSeconds int) (map[string]any, error) {
	selectedStore, cacheStore, err := resolveCacheStore(r.caches, storeName)
	if err != nil {
		return nil, err
	}
	key = strings.TrimSpace(key)
	if key == "" {
		return nil, fmt.Errorf("cache: key is required")
	}
	var ttl time.Duration
	if ttlSeconds > 0 {
		ttl = time.Duration(ttlSeconds) * time.Second
	}
	if err := cacheStore.WithContext(ctx).SetBytes(key, data, ttl); err != nil {
		return nil, err
	}
	return map[string]any{
		"store": selectedStore,
		"key":   key,
		"set":   true,
	}, nil
}

func resolveCacheStore(manager *caches.Manager, storeName string) (string, *cachepkg.Cache, error) {
	if manager == nil {
		return "", nil, fmt.Errorf("cache: manager unavailable")
	}
	selected := strings.TrimSpace(storeName)
	if selected == "" {
		selected = "default"
	}
	store := manager.Named(selected)
	if store == nil {
		return "", nil, fmt.Errorf("cache: store %q not found", selected)
	}
	return selected, store, nil
}

type storageDiskInfo struct {
	Name       string `json:"name"`
	Driver     string `json:"driver"`
	URLCapable bool   `json:"url_capable"`
	IsDefault  bool   `json:"is_default"`
}

type storageEntryInfo struct {
	Name         string `json:"name"`
	Path         string `json:"path"`
	Size         int64  `json:"size"`
	IsDir        bool   `json:"is_dir"`
	Downloadable bool   `json:"downloadable"`
	URLCapable   bool   `json:"url_capable"`
}

func (r *LighthouseRuntime) storageDisks() []storageDiskInfo {
	return storageDisks(r.storage)
}

func storageDisks(manager *storages.Manager) []storageDiskInfo {
	if manager == nil {
		return nil
	}
	instances := manager.Instances()
	disks := make([]storageDiskInfo, 0, len(instances))
	for _, instance := range instances {
		if instance.Disk == nil {
			continue
		}
		disks = append(disks, storageDiskInfo{
			Name:       strings.TrimSpace(instance.Name),
			Driver:     strings.TrimSpace(instance.Driver),
			URLCapable: storageDriverSupportsPublicURL(instance.Driver),
			IsDefault:  instance.IsDefault,
		})
	}
	sort.Slice(disks, func(i, j int) bool {
		if disks[i].IsDefault != disks[j].IsDefault {
			return disks[i].IsDefault
		}
		return disks[i].Name < disks[j].Name
	})
	return disks
}

func (r *LighthouseRuntime) storageListPayload(ctx context.Context, diskName string, rawPath string, offset int, limit int) (map[string]any, error) {
	selectedDisk, disk, err := resolveStorageDisk(r.storage, diskName)
	if err != nil {
		return nil, err
	}
	currentPath, err := normalizeStoragePath(rawPath)
	if err != nil {
		return nil, err
	}
	var (
		entries []storage.Entry
		hasMore bool
		pageErr error
	)
	if offset < 0 {
		offset = 0
	}
	if limit > 0 {
		var page storage.ListPageResult
		page, pageErr = storageListPage(ctx, disk, currentPath, offset, limit)
		if pageErr == nil {
			entries = page.Entries
			hasMore = page.HasMore
			offset = page.Offset
			limit = page.Limit
		} else {
			entries, err = storageList(ctx, disk, currentPath)
			if err != nil {
				return nil, err
			}
			if offset > len(entries) {
				offset = len(entries)
			}
			end := offset + limit
			if end > len(entries) {
				end = len(entries)
			}
			hasMore = end < len(entries)
			entries = entries[offset:end]
		}
	} else {
		entries, err = storageList(ctx, disk, currentPath)
		if err != nil {
			return nil, err
		}
	}
	items := make([]storageEntryInfo, 0, len(entries))
	for _, entry := range entries {
		name := pathpkg.Base(strings.TrimSuffix(entry.Path, "/"))
		if name == "." || name == "/" || name == "" {
			name = entry.Path
		}
		items = append(items, storageEntryInfo{
			Name:         name,
			Path:         entry.Path,
			Size:         entry.Size,
			IsDir:        entry.IsDir,
			Downloadable: !entry.IsDir,
			URLCapable:   !entry.IsDir && storageDriverSupportsPublicURL(driverNameForDisk(r.storage, selectedDisk)),
		})
	}
	sort.Slice(items, func(i, j int) bool {
		if items[i].IsDir != items[j].IsDir {
			return items[i].IsDir
		}
		return strings.ToLower(items[i].Name) < strings.ToLower(items[j].Name)
	})
	return map[string]any{
		"disks":         r.storageDisks(),
		"current_disk":  selectedDisk,
		"path":          currentPath,
		"parent":        storageParentPath(currentPath),
		"offset":        offset,
		"limit":         limit,
		"has_more":      hasMore,
		"backend_paged": pageErr == nil && limit > 0,
		"entries":       items,
	}, nil
}

func (r *LighthouseRuntime) storageDownloadPayload(ctx context.Context, diskName string, rawPath string) (map[string]any, error) {
	selectedDisk, disk, err := resolveStorageDisk(r.storage, diskName)
	if err != nil {
		return nil, err
	}
	currentPath, err := normalizeStoragePath(rawPath)
	if err != nil {
		return nil, err
	}
	if currentPath == "" {
		return nil, fmt.Errorf("storage: path is required")
	}
	entry, err := storageStat(ctx, disk, currentPath)
	if err != nil {
		return nil, err
	}
	if entry.IsDir {
		return nil, fmt.Errorf("storage: cannot download directory %q", currentPath)
	}
	if entry.Size > lighthouseStoragePreviewMaxBytes {
		return nil, fmt.Errorf("storage: preview limit exceeded (%s > %s)", formatStorageBytes(entry.Size), formatStorageBytes(lighthouseStoragePreviewMaxBytes))
	}
	data, err := storageGet(ctx, disk, currentPath)
	if err != nil {
		return nil, err
	}
	return map[string]any{
		"disk":         selectedDisk,
		"path":         currentPath,
		"name":         pathpkg.Base(currentPath),
		"size":         entry.Size,
		"content_type": http.DetectContentType(data),
		"data":         data,
	}, nil
}

func (r *LighthouseRuntime) storageURLPayload(ctx context.Context, diskName string, rawPath string) (map[string]any, error) {
	selectedDisk, disk, err := resolveStorageDisk(r.storage, diskName)
	if err != nil {
		return nil, err
	}
	currentPath, err := normalizeStoragePath(rawPath)
	if err != nil {
		return nil, err
	}
	if currentPath == "" {
		return nil, fmt.Errorf("storage: path is required")
	}
	entry, err := storageStat(ctx, disk, currentPath)
	if err != nil {
		return nil, err
	}
	if entry.IsDir {
		return nil, fmt.Errorf("storage: cannot resolve URL for directory %q", currentPath)
	}
	urlValue, err := storageURL(ctx, disk, currentPath)
	if err != nil {
		return nil, err
	}
	return map[string]any{
		"disk": selectedDisk,
		"path": currentPath,
		"url":  urlValue,
	}, nil
}

func (r *LighthouseRuntime) storagePutPayload(ctx context.Context, diskName string, rawPath string, data []byte) (map[string]any, error) {
	selectedDisk, disk, err := resolveStorageDisk(r.storage, diskName)
	if err != nil {
		return nil, err
	}
	currentPath, err := normalizeStoragePath(rawPath)
	if err != nil {
		return nil, err
	}
	if currentPath == "" {
		return nil, fmt.Errorf("storage: path is required")
	}
	if len(data) == 0 {
		return nil, fmt.Errorf("storage: file contents are required")
	}
	if int64(len(data)) > lighthouseStorageUploadMaxBytes {
		return nil, fmt.Errorf("storage: upload limit exceeded (%s > %s)", formatStorageBytes(int64(len(data))), formatStorageBytes(lighthouseStorageUploadMaxBytes))
	}
	if err := storagePut(ctx, disk, currentPath, data); err != nil {
		return nil, err
	}
	entry, err := storageStat(ctx, disk, currentPath)
	if err != nil {
		return nil, err
	}
	return map[string]any{
		"disk": selectedDisk,
		"path": currentPath,
		"entry": storageEntryInfo{
			Name:         pathpkg.Base(currentPath),
			Path:         entry.Path,
			Size:         entry.Size,
			IsDir:        entry.IsDir,
			Downloadable: !entry.IsDir,
			URLCapable:   !entry.IsDir && storageDriverSupportsPublicURL(driverNameForDisk(r.storage, selectedDisk)),
		},
	}, nil
}

func (r *LighthouseRuntime) storageDeletePayload(ctx context.Context, diskName string, rawPath string) (map[string]any, error) {
	selectedDisk, disk, err := resolveStorageDisk(r.storage, diskName)
	if err != nil {
		return nil, err
	}
	currentPath, err := normalizeStoragePath(rawPath)
	if err != nil {
		return nil, err
	}
	if currentPath == "" {
		return nil, fmt.Errorf("storage: path is required")
	}
	if err := storageDelete(ctx, disk, currentPath); err != nil {
		return nil, err
	}
	return map[string]any{
		"disk": selectedDisk,
		"path": currentPath,
	}, nil
}

func (r *LighthouseRuntime) storageMkdirPayload(ctx context.Context, diskName string, rawPath string) (map[string]any, error) {
	selectedDisk, disk, err := resolveStorageDisk(r.storage, diskName)
	if err != nil {
		return nil, err
	}
	currentPath, err := normalizeStoragePath(rawPath)
	if err != nil {
		return nil, err
	}
	if currentPath == "" {
		return nil, fmt.Errorf("storage: path is required")
	}
	if err := storageMakeDir(ctx, disk, currentPath); err != nil {
		return nil, err
	}
	entry, err := storageStat(ctx, disk, currentPath)
	if err != nil {
		return nil, err
	}
	return map[string]any{
		"disk": selectedDisk,
		"path": currentPath,
		"entry": storageEntryInfo{
			Name:         pathpkg.Base(currentPath),
			Path:         entry.Path,
			Size:         entry.Size,
			IsDir:        entry.IsDir,
			Downloadable: !entry.IsDir,
			URLCapable:   false,
		},
	}, nil
}

func (r *LighthouseRuntime) storageMovePayload(ctx context.Context, diskName string, rawFrom string, rawTo string) (map[string]any, error) {
	selectedDisk, disk, err := resolveStorageDisk(r.storage, diskName)
	if err != nil {
		return nil, err
	}
	fromPath, err := normalizeStoragePath(rawFrom)
	if err != nil {
		return nil, err
	}
	toPath, err := normalizeStoragePath(rawTo)
	if err != nil {
		return nil, err
	}
	if fromPath == "" || toPath == "" {
		return nil, fmt.Errorf("storage: source and destination paths are required")
	}
	if fromPath == toPath {
		return nil, fmt.Errorf("storage: destination path must differ from source path")
	}
	if err := storageMove(ctx, disk, fromPath, toPath); err != nil {
		return nil, err
	}
	movedEntry, err := storageStat(ctx, disk, toPath)
	if err != nil {
		return nil, err
	}
	return map[string]any{
		"disk": selectedDisk,
		"from": fromPath,
		"to":   toPath,
		"entry": storageEntryInfo{
			Name:         pathpkg.Base(toPath),
			Path:         movedEntry.Path,
			Size:         movedEntry.Size,
			IsDir:        movedEntry.IsDir,
			Downloadable: !movedEntry.IsDir,
			URLCapable:   !movedEntry.IsDir && storageDriverSupportsPublicURL(driverNameForDisk(r.storage, selectedDisk)),
		},
	}, nil
}

func resolveStorageDisk(manager *storages.Manager, name string) (string, storage.Storage, error) {
	if manager == nil {
		return "", nil, fmt.Errorf("storage: manager unavailable")
	}
	requested := strings.ToLower(strings.TrimSpace(name))
	instances := manager.Instances()
	if requested == "" {
		for _, instance := range instances {
			if instance.IsDefault && instance.Disk != nil {
				return strings.TrimSpace(instance.Name), instance.Disk, nil
			}
		}
	}
	for _, instance := range instances {
		if instance.Disk == nil {
			continue
		}
		candidate := strings.ToLower(strings.TrimSpace(instance.Name))
		if candidate == requested {
			return strings.TrimSpace(instance.Name), instance.Disk, nil
		}
	}
	return "", nil, fmt.Errorf("storage: disk %q not found", name)
}

func driverNameForDisk(manager *storages.Manager, name string) string {
	if manager == nil {
		return ""
	}
	requested := strings.ToLower(strings.TrimSpace(name))
	for _, instance := range manager.Instances() {
		if strings.ToLower(strings.TrimSpace(instance.Name)) == requested {
			return strings.TrimSpace(instance.Driver)
		}
	}
	if requested == "" {
		for _, instance := range manager.Instances() {
			if instance.IsDefault {
				return strings.TrimSpace(instance.Driver)
			}
		}
	}
	return ""
}

func storageDriverSupportsPublicURL(driver string) bool {
	switch strings.ToLower(strings.TrimSpace(driver)) {
	case "dropbox", "gcs", "rclone", "s3":
		return true
	default:
		return false
	}
}

func (s *Server) lighthouseStorageDownload(r web.Context, diskName string, rawPath string) error {
	selectedDisk, disk, err := resolveStorageDisk(s.storage, diskName)
	if err != nil {
		return r.JSON(http.StatusBadRequest, map[string]any{"error": err.Error()})
	}
	currentPath, err := normalizeStoragePath(rawPath)
	if err != nil {
		return r.JSON(http.StatusBadRequest, map[string]any{"error": err.Error()})
	}
	if currentPath == "" {
		return r.JSON(http.StatusBadRequest, map[string]any{"error": "storage: path is required"})
	}
	entry, err := storageStat(r.Request().Context(), disk, currentPath)
	if err != nil {
		return r.JSON(http.StatusNotFound, map[string]any{"error": err.Error()})
	}
	if entry.IsDir {
		return r.JSON(http.StatusBadRequest, map[string]any{"error": fmt.Sprintf("storage: cannot download directory %q", currentPath)})
	}
	if entry.Size > lighthouseStorageDownloadMaxBytes {
		return r.JSON(http.StatusRequestEntityTooLarge, map[string]any{
			"error": fmt.Sprintf("storage: download limit exceeded (%s > %s)", formatStorageBytes(entry.Size), formatStorageBytes(lighthouseStorageDownloadMaxBytes)),
		})
	}
	data, err := storageGet(r.Request().Context(), disk, currentPath)
	if err != nil {
		return r.JSON(http.StatusInternalServerError, map[string]any{"error": err.Error()})
	}
	contentType := http.DetectContentType(data)
	filename := pathpkg.Base(currentPath)
	r.ResponseWriter().Header().Set("Content-Type", contentType)
	r.ResponseWriter().Header().Set("Content-Length", fmt.Sprintf("%d", len(data)))
	r.ResponseWriter().Header().Set("Content-Disposition", fmt.Sprintf("attachment; filename=%q", filename))
	r.ResponseWriter().Header().Set("X-Lighthouse-Storage-Disk", selectedDisk)
	return r.Blob(http.StatusOK, contentType, data)
}

func storageList(ctx context.Context, disk storage.Storage, currentPath string) ([]storage.Entry, error) {
	return disk.WithContext(ctx).List(currentPath)
}

func storageListPage(ctx context.Context, disk storage.Storage, currentPath string, offset int, limit int) (storage.ListPageResult, error) {
	if diskPaged, ok := disk.WithContext(ctx).(storage.PagedStorage); ok {
		return diskPaged.ListPage(currentPath, offset, limit)
	}
	return storage.ListPageResult{}, fmt.Errorf("%w: paged list not supported", storage.ErrUnsupported)
}

func storageStat(ctx context.Context, disk storage.Storage, currentPath string) (storage.Entry, error) {
	return disk.WithContext(ctx).Stat(currentPath)
}

func storageGet(ctx context.Context, disk storage.Storage, currentPath string) ([]byte, error) {
	return disk.WithContext(ctx).Get(currentPath)
}

func storageURL(ctx context.Context, disk storage.Storage, currentPath string) (string, error) {
	return disk.WithContext(ctx).URL(currentPath)
}

func storagePut(ctx context.Context, disk storage.Storage, currentPath string, data []byte) error {
	return disk.WithContext(ctx).Put(currentPath, data)
}

func storageMakeDir(ctx context.Context, disk storage.Storage, currentPath string) error {
	return disk.WithContext(ctx).MakeDir(currentPath)
}

func storageDelete(ctx context.Context, disk storage.Storage, currentPath string) error {
	return disk.WithContext(ctx).Delete(currentPath)
}

func storageMove(ctx context.Context, disk storage.Storage, fromPath string, toPath string) error {
	return disk.WithContext(ctx).Move(fromPath, toPath)
}

func normalizeStoragePath(raw string) (string, error) {
	cleaned := pathpkg.Clean("/" + strings.TrimSpace(raw))
	cleaned = strings.TrimPrefix(cleaned, "/")
	if cleaned == "." {
		return "", nil
	}
	if cleaned == ".." || strings.HasPrefix(cleaned, "../") {
		return "", fmt.Errorf("storage: invalid path")
	}
	return cleaned, nil
}

func formatStorageBytes(value int64) string {
	if value <= 0 {
		return "0 B"
	}
	units := []string{"B", "KB", "MB", "GB", "TB"}
	size := float64(value)
	unit := 0
	for size >= 1024 && unit < len(units)-1 {
		size /= 1024
		unit++
	}
	if size >= 10 || unit == 0 {
		return fmt.Sprintf("%.0f %s", size, units[unit])
	}
	return fmt.Sprintf("%.1f %s", size, units[unit])
}

func storageParentPath(currentPath string) string {
	if currentPath == "" {
		return ""
	}
	parent := pathpkg.Dir("/" + currentPath)
	parent = strings.TrimPrefix(parent, "/")
	if parent == "." {
		return ""
	}
	return parent
}
