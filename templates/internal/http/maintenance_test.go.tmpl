// TestMaintenanceModeServesBrowserAndAPIResponses verifies starter-kit navigation and API clients receive appropriate 503 representations.
func TestMaintenanceModeServesBrowserAndAPIResponses(t *testing.T) {
	t.Setenv("APP_ENV", "testing")
	t.Setenv("APP_MAINTENANCE_ENABLED", "true")
	t.Setenv("APP_NAME", `<Acme & Co>`)
	t.Setenv("HTTP_ACCESS_LOG_ENABLED", "false")
	server := newMaintenanceTestServer(t)

	request := httptest.NewRequest(http.MethodGet, "/", nil)
	recorder := httptest.NewRecorder()
	server.ServeHTTP(recorder, request)
	require.Equal(t, http.StatusServiceUnavailable, recorder.Code)
	assert.Contains(t, recorder.Header().Get("Content-Type"), "text/html")
	assert.Equal(t, "no-store, max-age=0", recorder.Header().Get("Cache-Control"))
	assert.Contains(t, recorder.Body.String(), "We&rsquo;ll be right back")
	assert.Contains(t, recorder.Body.String(), "&lt;Acme &amp; Co&gt;")
	assert.NotContains(t, recorder.Body.String(), `<Acme & Co>`)

	request = httptest.NewRequest(http.MethodGet, "/api/v1/hello", nil)
	recorder = httptest.NewRecorder()
	server.ServeHTTP(recorder, request)
	require.Equal(t, http.StatusServiceUnavailable, recorder.Code)
	assert.Contains(t, recorder.Header().Get("Content-Type"), "application/json")
	assert.JSONEq(t, `{"ok":false,"error":"service unavailable","maintenance":true}`, recorder.Body.String())
}

// TestMaintenanceModeHeadResponseOmitsBody verifies probes and clients can inspect availability without downloading the page.
func TestMaintenanceModeHeadResponseOmitsBody(t *testing.T) {
	t.Setenv("APP_ENV", "testing")
	t.Setenv("APP_MAINTENANCE_ENABLED", "true")
	t.Setenv("HTTP_ACCESS_LOG_ENABLED", "false")
	server := newMaintenanceTestServer(t)

	request := httptest.NewRequest(http.MethodHead, "/", nil)
	recorder := httptest.NewRecorder()
	server.ServeHTTP(recorder, request)
	require.Equal(t, http.StatusServiceUnavailable, recorder.Code)
	assert.Empty(t, recorder.Body.String())
}

// TestMaintenanceModeKeepsOperationalRoutesReachable verifies planned maintenance does not masquerade as process failure.
func TestMaintenanceModeKeepsOperationalRoutesReachable(t *testing.T) {
	t.Setenv("APP_ENV", "testing")
	t.Setenv("APP_MAINTENANCE_ENABLED", "true")
	t.Setenv("HTTP_ACCESS_LOG_ENABLED", "false")
	server := newMaintenanceTestServer(t)

	for _, path := range []string{"/-/health", "/-/ready", "/metrics", "/lighthouse/ws/agent"} {
		t.Run(strings.ReplaceAll(path, "/", "_"), func(t *testing.T) {
			request := httptest.NewRequest(http.MethodGet, path, nil)
			recorder := httptest.NewRecorder()
			server.ServeHTTP(recorder, request)
			assert.NotEqual(t, http.StatusServiceUnavailable, recorder.Code)
		})
	}
}

// TestMaintenanceModeDisabledPreservesApplicationTraffic verifies the default environment adds no availability gate.
func TestMaintenanceModeDisabledPreservesApplicationTraffic(t *testing.T) {
	t.Chdir(t.TempDir())
	t.Setenv("APP_ENV", "testing")
	t.Setenv("APP_MAINTENANCE_ENABLED", "false")
	t.Setenv("HTTP_ACCESS_LOG_ENABLED", "false")
	t.Setenv("FORJ_APP", "app")
	server := newMaintenanceTestServer(t)

	request := httptest.NewRequest(http.MethodGet, "/api/v1/hello", nil)
	recorder := httptest.NewRecorder()
	server.ServeHTTP(recorder, request)
	require.Equal(t, http.StatusNoContent, recorder.Code)

	require.NoError(t, maintenance.Enable())
	request = httptest.NewRequest(http.MethodGet, "/api/v1/hello", nil)
	recorder = httptest.NewRecorder()
	server.ServeHTTP(recorder, request)
	require.Equal(t, http.StatusServiceUnavailable, recorder.Code)

	require.NoError(t, maintenance.Disable())
	request = httptest.NewRequest(http.MethodGet, "/api/v1/hello", nil)
	recorder = httptest.NewRecorder()
	server.ServeHTTP(recorder, request)
	require.Equal(t, http.StatusNoContent, recorder.Code)
}

// newMaintenanceTestServer builds the real adapter pipeline so middleware order and route bypasses remain covered.
func newMaintenanceTestServer(t *testing.T) http.Handler {
	t.Helper()
	groups := []web.RouteGroup{
		web.NewRouteGroup("/api/v1", []web.Route{
			web.NewRoute(http.MethodGet, "/hello", func(r web.Context) error {
				return r.NoContent(http.StatusNoContent)
			}),
		}),
	}
	server := NewServer(
		logger.NewSilentLogger(),
		runtime.NewTimeouts(),
		groups,
		[]ReadinessCheck{},
		nil,
{{- if .ProjectComponents.Storage }}
		nil,
{{- end }}
		nil,
{{- if .ProjectComponents.Metrics }}
		metrics.NewManager(),
{{- end }}
	)
	adapter, err := server.bootstrap("")
	require.NoError(t, err)
	return adapter
}
