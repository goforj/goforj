// TestMaintenanceModeLetsInflightRequestsFinish verifies enabling maintenance gates admission without canceling accepted work.
func TestMaintenanceModeLetsInflightRequestsFinish(t *testing.T) {
	t.Chdir(t.TempDir())
	t.Setenv("APP_ENV", "testing")
	t.Setenv("APP_MAINTENANCE_ENABLED", "false")
	t.Setenv("HTTP_ACCESS_LOG_ENABLED", "false")
	t.Setenv("FORJ_APP", "app")
	started := make(chan struct{})
	release := make(chan struct{})
	groups := []web.RouteGroup{
		web.NewRouteGroup("/api/v1", []web.Route{
			web.NewRoute(http.MethodGet, "/blocking", func(r web.Context) error {
				close(started)
				<-release
				return r.NoContent(http.StatusNoContent)
			}),
		}),
	}
	server := newMaintenanceTestServerWithGroups(t, groups, lighthouse.NewHub())
	result := make(chan int, 1)
	go func() {
		recorder := httptest.NewRecorder()
		server.ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, "/api/v1/blocking", nil))
		result <- recorder.Code
	}()
	<-started
	setTestMaintenance(t, server, "enable", http.StatusOK)
	close(release)
	assert.Equal(t, http.StatusNoContent, <-result)

	recorder := httptest.NewRecorder()
	server.ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, "/api/v1/blocking", nil))
	assert.Equal(t, http.StatusServiceUnavailable, recorder.Code)
}

// newMaintenanceTestServer builds the real adapter pipeline so middleware order and route bypasses remain covered.
func newMaintenanceTestServer(t *testing.T) http.Handler {
	t.Helper()
	groups := []web.RouteGroup{
		web.NewRouteGroup("/api/v1", []web.Route{
			web.NewRoute(http.MethodGet, "/hello", func(r web.Context) error {
				return r.NoContent(http.StatusNoContent)
			}),
		}),
	}
	return newMaintenanceTestServerWithGroups(t, groups, lighthouse.NewHub())
}

// newMaintenanceTestServerWithGroups builds a maintenance server with explicit application routes and operator dependencies.
func newMaintenanceTestServerWithGroups(t *testing.T, groups []web.RouteGroup, consoleHub *lighthouse.Hub) http.Handler {
	t.Helper()
	t.Setenv("APP_DIAG_TOKEN", "maintenance-test-token")
	server := NewServer(
		logger.NewSilentLogger(),
		runtime.NewTimeouts(),
		groups,
		[]ReadinessCheck{},
		consoleHub,
		newTestMaintenanceState(t),
{{- if .ProjectComponents.Storage }}
		nil,
{{- end }}
		nil,
{{- if .ProjectComponents.Metrics }}
		metrics.NewManager(),
{{- end }}
	)
	adapter, err := server.bootstrap("")
	require.NoError(t, err)
	return adapter
}

// setTestMaintenance exercises the same authenticated endpoint used by generated commands.
func setTestMaintenance(t *testing.T, server http.Handler, action string, wantStatus int) {
	t.Helper()
	request := httptest.NewRequest(http.MethodPost, "/-/maintenance/"+action, nil)
	request.RemoteAddr = "127.0.0.1:32100"
	request.Header.Set("Authorization", "Bearer maintenance-test-token")
	recorder := httptest.NewRecorder()
	server.ServeHTTP(recorder, request)
	if recorder.Code != wantStatus {
		t.Fatalf("maintenance %s status = %d, want %d: %s", action, recorder.Code, wantStatus, recorder.Body.String())
	}
}

// newTestMaintenanceState builds the HTTP template variant without weakening required production wiring.
func newTestMaintenanceState(tb testing.TB) *maintenance.State {
	tb.Helper()
	tb.Setenv("APP_MAINTENANCE_DRIVER", "memory")
	state, err := maintenance.NewState()
	if err != nil {
		tb.Fatalf("NewState() error = %v", err)
	}
	return state
}
