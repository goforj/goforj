// TestMaintenanceModeServesBrowserAndAPIResponses verifies starter-kit navigation and API clients receive appropriate 503 representations.
func TestMaintenanceModeServesBrowserAndAPIResponses(t *testing.T) {
	t.Setenv("APP_ENV", "testing")
	t.Setenv("APP_MAINTENANCE_ENABLED", "true")
	t.Setenv("APP_NAME", `<Acme & Co>`)
	t.Setenv("HTTP_ACCESS_LOG_ENABLED", "false")
	server := newMaintenanceTestServer(t)

	request := httptest.NewRequest(http.MethodGet, "/", nil)
	recorder := httptest.NewRecorder()
	server.ServeHTTP(recorder, request)
	require.Equal(t, http.StatusServiceUnavailable, recorder.Code)
	assert.Contains(t, recorder.Header().Get("Content-Type"), "text/html")
	assert.Equal(t, "no-store, max-age=0", recorder.Header().Get("Cache-Control"))
	assert.Contains(t, recorder.Body.String(), "We&rsquo;ll be right back")
	assert.Contains(t, recorder.Body.String(), "&lt;Acme &amp; Co&gt;")
	assert.NotContains(t, recorder.Body.String(), `<Acme & Co>`)

	request = httptest.NewRequest(http.MethodGet, "/api/v1/hello", nil)
	recorder = httptest.NewRecorder()
	server.ServeHTTP(recorder, request)
	require.Equal(t, http.StatusServiceUnavailable, recorder.Code)
	assert.Contains(t, recorder.Header().Get("Content-Type"), "application/json")
	assert.JSONEq(t, `{"ok":false,"error":"service unavailable","maintenance":true}`, recorder.Body.String())
}

// TestMaintenanceModeHeadResponseOmitsBody verifies probes and clients can inspect availability without downloading the page.
func TestMaintenanceModeHeadResponseOmitsBody(t *testing.T) {
	t.Setenv("APP_ENV", "testing")
	t.Setenv("APP_MAINTENANCE_ENABLED", "true")
	t.Setenv("HTTP_ACCESS_LOG_ENABLED", "false")
	server := newMaintenanceTestServer(t)

	request := httptest.NewRequest(http.MethodHead, "/", nil)
	recorder := httptest.NewRecorder()
	server.ServeHTTP(recorder, request)
	require.Equal(t, http.StatusServiceUnavailable, recorder.Code)
	assert.Empty(t, recorder.Body.String())
}

// TestMaintenanceModeKeepsOperationalRoutesReachable verifies planned maintenance does not masquerade as process failure.
func TestMaintenanceModeKeepsOperationalRoutesReachable(t *testing.T) {
	t.Setenv("APP_ENV", "testing")
	t.Setenv("APP_MAINTENANCE_ENABLED", "true")
	t.Setenv("HTTP_ACCESS_LOG_ENABLED", "false")
	server := newMaintenanceTestServer(t)

	checks := []struct {
		path   string
		status int
	}{
		{path: "/-/health", status: http.StatusOK},
		{path: "/-/ready", status: http.StatusOK},
		{path: "/lighthouse", status: http.StatusOK},
{{- if .ProjectComponents.Metrics }}
		{path: "/metrics", status: http.StatusOK},
{{- end }}
	}
	for _, check := range checks {
		t.Run(strings.ReplaceAll(check.path, "/", "_"), func(t *testing.T) {
			request := httptest.NewRequest(http.MethodGet, check.path, nil)
			recorder := httptest.NewRecorder()
			server.ServeHTTP(recorder, request)
			assert.Equal(t, check.status, recorder.Code)
		})
	}
}

// TestMaintenanceModeRejectsOperationalLookalikes verifies only mounted framework surfaces bypass the application gate.
func TestMaintenanceModeRejectsOperationalLookalikes(t *testing.T) {
	t.Setenv("APP_ENV", "testing")
	t.Setenv("APP_MAINTENANCE_ENABLED", "true")
	t.Setenv("LIGHTHOUSE_ENABLED", "false")
	t.Setenv("HTTP_ACCESS_LOG_ENABLED", "false")
	groups := []web.RouteGroup{
		web.NewRouteGroup("/lighthouse", []web.Route{
			web.NewRoute(http.MethodGet, "/webhook", func(r web.Context) error {
				return r.NoContent(http.StatusNoContent)
			}),
		}),
	{{- if not .ProjectComponents.Metrics }}
		web.NewRouteGroup("", []web.Route{
			web.NewRoute(http.MethodGet, "/metrics", func(r web.Context) error {
				return r.NoContent(http.StatusNoContent)
			}),
		}),
	{{- end }}
	}
	server := newMaintenanceTestServerWithGroups(t, groups, nil)

	for _, request := range []*http.Request{
		httptest.NewRequest(http.MethodGet, "/lighthouse/webhook", nil),
		httptest.NewRequest(http.MethodPost, "/-/ready", nil),
		httptest.NewRequest(http.MethodPost, "/metrics", nil),
	{{- if not .ProjectComponents.Metrics }}
		httptest.NewRequest(http.MethodGet, "/metrics", nil),
	{{- end }}
	} {
		recorder := httptest.NewRecorder()
		server.ServeHTTP(recorder, request)
		assert.Equal(t, http.StatusServiceUnavailable, recorder.Code)
	}

	t.Setenv("LIGHTHOUSE_ENABLED", "true")
	server = newMaintenanceTestServerWithGroups(t, groups, lighthouse.NewHub())
	recorder := httptest.NewRecorder()
	server.ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, "/lighthouse/webhook", nil))
	assert.Equal(t, http.StatusServiceUnavailable, recorder.Code)
}

// TestMaintenanceModeDisabledPreservesApplicationTraffic verifies the default environment adds no availability gate.
func TestMaintenanceModeDisabledPreservesApplicationTraffic(t *testing.T) {
	t.Chdir(t.TempDir())
	t.Setenv("APP_ENV", "testing")
	t.Setenv("APP_MAINTENANCE_ENABLED", "false")
	t.Setenv("HTTP_ACCESS_LOG_ENABLED", "false")
	t.Setenv("FORJ_APP", "app")
	server := newMaintenanceTestServer(t)

	request := httptest.NewRequest(http.MethodGet, "/api/v1/hello", nil)
	recorder := httptest.NewRecorder()
	server.ServeHTTP(recorder, request)
	require.Equal(t, http.StatusNoContent, recorder.Code)

	require.NoError(t, maintenance.Enable())
	request = httptest.NewRequest(http.MethodGet, "/api/v1/hello", nil)
	recorder = httptest.NewRecorder()
	server.ServeHTTP(recorder, request)
	require.Equal(t, http.StatusServiceUnavailable, recorder.Code)

	require.NoError(t, maintenance.Disable())
	request = httptest.NewRequest(http.MethodGet, "/api/v1/hello", nil)
	recorder = httptest.NewRecorder()
	server.ServeHTTP(recorder, request)
	require.Equal(t, http.StatusNoContent, recorder.Code)
}

// TestMaintenanceModeLetsInflightRequestsFinish verifies enabling maintenance gates admission without canceling accepted work.
func TestMaintenanceModeLetsInflightRequestsFinish(t *testing.T) {
	t.Chdir(t.TempDir())
	t.Setenv("APP_ENV", "testing")
	t.Setenv("APP_MAINTENANCE_ENABLED", "false")
	t.Setenv("HTTP_ACCESS_LOG_ENABLED", "false")
	t.Setenv("FORJ_APP", "app")
	t.Cleanup(func() { _ = maintenance.Disable() })
	started := make(chan struct{})
	release := make(chan struct{})
	groups := []web.RouteGroup{
		web.NewRouteGroup("/api/v1", []web.Route{
			web.NewRoute(http.MethodGet, "/blocking", func(r web.Context) error {
				close(started)
				<-release
				return r.NoContent(http.StatusNoContent)
			}),
		}),
	}
	server := newMaintenanceTestServerWithGroups(t, groups, lighthouse.NewHub())
	result := make(chan int, 1)
	go func() {
		recorder := httptest.NewRecorder()
		server.ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, "/api/v1/blocking", nil))
		result <- recorder.Code
	}()
	<-started
	require.NoError(t, maintenance.Enable())
	close(release)
	assert.Equal(t, http.StatusNoContent, <-result)

	recorder := httptest.NewRecorder()
	server.ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, "/api/v1/blocking", nil))
	assert.Equal(t, http.StatusServiceUnavailable, recorder.Code)
}

// newMaintenanceTestServer builds the real adapter pipeline so middleware order and route bypasses remain covered.
func newMaintenanceTestServer(t *testing.T) http.Handler {
	t.Helper()
	groups := []web.RouteGroup{
		web.NewRouteGroup("/api/v1", []web.Route{
			web.NewRoute(http.MethodGet, "/hello", func(r web.Context) error {
				return r.NoContent(http.StatusNoContent)
			}),
		}),
	}
	return newMaintenanceTestServerWithGroups(t, groups, lighthouse.NewHub())
}

// newMaintenanceTestServerWithGroups builds a maintenance server with explicit application routes and operator dependencies.
func newMaintenanceTestServerWithGroups(t *testing.T, groups []web.RouteGroup, consoleHub *lighthouse.Hub) http.Handler {
	t.Helper()
	require.NoError(t, maintenance.Disable())
	server := NewServer(
		logger.NewSilentLogger(),
		runtime.NewTimeouts(),
		groups,
		[]ReadinessCheck{},
		consoleHub,
{{- if .ProjectComponents.Storage }}
		nil,
{{- end }}
		nil,
{{- if .ProjectComponents.Metrics }}
		metrics.NewManager(),
{{- end }}
	)
	adapter, err := server.bootstrap("")
	require.NoError(t, err)
	return adapter
}
