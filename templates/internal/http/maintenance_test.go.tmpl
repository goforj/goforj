// TestMaintenanceModeKeepsOperationalRoutesReachable verifies planned maintenance does not masquerade as process failure.
func TestMaintenanceModeKeepsOperationalRoutesReachable(t *testing.T) {
	t.Setenv("APP_ENV", "testing")
	t.Setenv("APP_MAINTENANCE_ENABLED", "true")
	t.Setenv("HTTP_ACCESS_LOG_ENABLED", "false")
	server := newMaintenanceTestServer(t)

	checks := []struct {
		path   string
		status int
	}{
		{path: "/-/health", status: http.StatusOK},
		{path: "/-/ready", status: http.StatusOK},
		{path: "/lighthouse", status: http.StatusOK},
{{- if .ProjectComponents.Metrics }}
		{path: "/metrics", status: http.StatusOK},
{{- end }}
	}
	for _, check := range checks {
		t.Run(strings.ReplaceAll(check.path, "/", "_"), func(t *testing.T) {
			request := httptest.NewRequest(http.MethodGet, check.path, nil)
			recorder := httptest.NewRecorder()
			server.ServeHTTP(recorder, request)
			assert.Equal(t, check.status, recorder.Code)
		})
	}
}

// TestMaintenanceModeRejectsOperationalLookalikes verifies only mounted framework surfaces bypass the application gate.
func TestMaintenanceModeRejectsOperationalLookalikes(t *testing.T) {
	t.Setenv("APP_ENV", "testing")
	t.Setenv("APP_MAINTENANCE_ENABLED", "true")
	t.Setenv("LIGHTHOUSE_ENABLED", "false")
	t.Setenv("HTTP_ACCESS_LOG_ENABLED", "false")
	groups := []web.RouteGroup{
		web.NewRouteGroup("/lighthouse", []web.Route{
			web.NewRoute(http.MethodGet, "/webhook", func(r web.Context) error {
				return r.NoContent(http.StatusNoContent)
			}),
		}),
	{{- if not .ProjectComponents.Metrics }}
		web.NewRouteGroup("", []web.Route{
			web.NewRoute(http.MethodGet, "/metrics", func(r web.Context) error {
				return r.NoContent(http.StatusNoContent)
			}),
		}),
	{{- end }}
	}
	server := newMaintenanceTestServerWithGroups(t, groups, nil)

	for _, request := range []*http.Request{
		httptest.NewRequest(http.MethodGet, "/lighthouse/webhook", nil),
		httptest.NewRequest(http.MethodPost, "/-/ready", nil),
		httptest.NewRequest(http.MethodPost, "/metrics", nil),
	{{- if not .ProjectComponents.Metrics }}
		httptest.NewRequest(http.MethodGet, "/metrics", nil),
	{{- end }}
	} {
		recorder := httptest.NewRecorder()
		server.ServeHTTP(recorder, request)
		assert.Equal(t, http.StatusServiceUnavailable, recorder.Code)
	}

	t.Setenv("LIGHTHOUSE_ENABLED", "true")
	server = newMaintenanceTestServerWithGroups(t, groups, lighthouse.NewHub())
	recorder := httptest.NewRecorder()
	server.ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, "/lighthouse/webhook", nil))
	assert.Equal(t, http.StatusServiceUnavailable, recorder.Code)
}

// TestMaintenanceModeDisabledPreservesApplicationTraffic verifies the default environment adds no availability gate.
func TestMaintenanceModeDisabledPreservesApplicationTraffic(t *testing.T) {
	t.Chdir(t.TempDir())
	t.Setenv("APP_ENV", "testing")
	t.Setenv("APP_MAINTENANCE_ENABLED", "false")
	t.Setenv("HTTP_ACCESS_LOG_ENABLED", "false")
	t.Setenv("FORJ_APP", "app")
	server := newMaintenanceTestServer(t)

	request := httptest.NewRequest(http.MethodGet, "/api/v1/hello", nil)
	recorder := httptest.NewRecorder()
	server.ServeHTTP(recorder, request)
	require.Equal(t, http.StatusNoContent, recorder.Code)

	setTestMaintenance(t, server, "enable", http.StatusOK)
	request = httptest.NewRequest(http.MethodGet, "/api/v1/hello", nil)
	recorder = httptest.NewRecorder()
	server.ServeHTTP(recorder, request)
	require.Equal(t, http.StatusServiceUnavailable, recorder.Code)

	setTestMaintenance(t, server, "disable", http.StatusOK)
	request = httptest.NewRequest(http.MethodGet, "/api/v1/hello", nil)
	recorder = httptest.NewRecorder()
	server.ServeHTTP(recorder, request)
	require.Equal(t, http.StatusNoContent, recorder.Code)
}

// TestMaintenanceControlRequiresDiagnosticToken prevents unauthenticated callers from changing availability.
func TestMaintenanceControlRequiresDiagnosticToken(t *testing.T) {
	t.Setenv("APP_MAINTENANCE_ENABLED", "false")
	server := newMaintenanceTestServer(t)
	request := httptest.NewRequest(http.MethodPost, "/-/maintenance/enable", nil)
	request.RemoteAddr = "127.0.0.1:32100"
	recorder := httptest.NewRecorder()
	server.ServeHTTP(recorder, request)
	require.Equal(t, http.StatusUnauthorized, recorder.Code)

	applicationRequest := httptest.NewRequest(http.MethodGet, "/api/v1/hello", nil)
	applicationRecorder := httptest.NewRecorder()
	server.ServeHTTP(applicationRecorder, applicationRequest)
	require.Equal(t, http.StatusNoContent, applicationRecorder.Code)
}

