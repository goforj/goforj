package http

import (
	"github.com/goforj/web"
	"github.com/goforj/web/webmiddleware"
)

// logNon200ResponseBodyMiddleware captures response body for non-200 statuses.
func (s *Server) logNon200ResponseBodyMiddleware() web.Middleware {
	return webmiddleware.ErrorBodyDump(func(r web.Context, status int, body []byte) {
		s.logger.Info().
			Any("status", status).
			Str("body", string(body)).
			Msg("Non-200 HTTP Response")
	})
}
