	e := bootstrapOpenAPITestServer(t)

	req := httptest.NewRequest(http.MethodGet, "/openapi/doc.json", nil)
	rec := httptest.NewRecorder()
	e.ServeHTTP(rec, req)
	require.Equal(t, http.StatusOK, rec.Code)
	assert.JSONEq(t, `{"openapi":"3.0.3","paths":{"/override":{}}}`, rec.Body.String())
	assert.NotContains(t, rec.Body.String(), "/wrong-default")
	assert.NotContains(t, rec.Body.String(), "/wrong-selected")
}

// TestOpenAPISpecMissingDoesNotFallBack verifies a stale default artifact cannot masquerade as the selected app document.
func TestOpenAPISpecMissingDoesNotFallBack(t *testing.T) {
	t.Setenv("API_OPENAPI_ENABLED", "true")
	t.Setenv("FORJ_APP", "customer-portal")
	t.Setenv("OPENAPI_SPEC_PATH", "")

	root := t.TempDir()
	writeOpenAPITestSpec(t, filepath.Join(root, "build", "openapi.json"), `{"openapi":"3.0.3","paths":{"/wrong-default":{}}}`)
	useOpenAPITestWorkingDirectory(t, root)
	e := bootstrapOpenAPITestServer(t)

	req := httptest.NewRequest(http.MethodGet, "/openapi/doc.json", nil)
	rec := httptest.NewRecorder()
	e.ServeHTTP(rec, req)
	require.Equal(t, http.StatusNotFound, rec.Code)
	assert.Contains(t, rec.Header().Get("Content-Type"), "application/json")
	assert.JSONEq(t, `{
		"error":"OpenAPI document is missing",
		"app":"customer-portal",
		"path":"build/customer-portal/openapi.json",
		"hint":"Run \"forj customer-portal build:api-index\" before opening the API reference."
	}`, rec.Body.String())
	assert.NotContains(t, rec.Body.String(), "/wrong-default")
}

