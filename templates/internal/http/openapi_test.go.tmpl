// TestOpenAPIUIAndSpecRoutes verifies the default App serves its artifact and a version-pinned Scalar page.
func TestOpenAPIUIAndSpecRoutes(t *testing.T) {
	t.Setenv("API_OPENAPI_ENABLED", "true")
	t.Setenv("FORJ_APP", "app")
	t.Setenv("OPENAPI_SPEC_PATH", "")

	root := t.TempDir()
	writeOpenAPITestSpec(t, filepath.Join(root, "build", "openapi.json"), `{"openapi":"3.0.3","paths":{"/default-app":{}}}`)
	writeOpenAPITestSpec(t, filepath.Join(root, "build", "customer-portal", "openapi.json"), `{"openapi":"3.0.3","paths":{"/wrong-app":{}}}`)
	useOpenAPITestWorkingDirectory(t, root)
	e := bootstrapOpenAPITestServer(t)

	for _, path := range []string{"/openapi", "/openapi/", "/swagger", "/swagger/"} {
		t.Run(path, func(t *testing.T) {
			req := httptest.NewRequest(http.MethodGet, path, nil)
			rec := httptest.NewRecorder()
			e.ServeHTTP(rec, req)
			assert.Equal(t, http.StatusOK, rec.Code)
			assert.Contains(t, rec.Body.String(), "https://cdn.jsdelivr.net/npm/@scalar/api-reference@1.62.5")
			assert.Contains(t, rec.Body.String(), "Scalar.createApiReference('#app'")
			assert.Contains(t, rec.Body.String(), "url: '/openapi/doc.json'")
		})
	}

	req := httptest.NewRequest(http.MethodGet, "/openapi/doc.json", nil)
	rec := httptest.NewRecorder()
	e.ServeHTTP(rec, req)
	assert.Equal(t, http.StatusOK, rec.Code)
	assert.JSONEq(t, `{"openapi":"3.0.3","paths":{"/default-app":{}}}`, rec.Body.String())
	assert.NotContains(t, rec.Body.String(), "/wrong-app")
}

