// bootstrapOpenAPITestServer centralizes framework setup so route assertions stay focused on OpenAPI behavior.
func bootstrapOpenAPITestServer(t *testing.T) http.Handler {
	t.Helper()
	s := NewServer(logger.NewSilentLogger(), runtime.NewTimeouts(), nil, []ReadinessCheck{}, nil, newTestMaintenanceState(t),{{- if .ProjectComponents.Storage }} nil,{{- end }} nil{{- if .ProjectComponents.Metrics }}, metrics.NewManager(){{- end }})
	e, err := s.bootstrap("")
	require.NoError(t, err)
	return e
}

// writeOpenAPITestSpec keeps competing App fixtures explicit in tests that guard against cross-App fallback.
func writeOpenAPITestSpec(t *testing.T, path string, body string) {
	t.Helper()
	require.NoError(t, os.MkdirAll(filepath.Dir(path), 0o755))
	require.NoError(t, os.WriteFile(path, []byte(body), 0o644))
}

// useOpenAPITestWorkingDirectory makes relative build artifacts behave exactly as they do in a launched project.
func useOpenAPITestWorkingDirectory(t *testing.T, root string) {
	t.Helper()
	wd, err := os.Getwd()
	require.NoError(t, err)
	require.NoError(t, os.Chdir(root))
	t.Cleanup(func() {
		require.NoError(t, os.Chdir(wd))
	})
}

// unsetOpenAPITestEnv preserves absence semantics needed to exercise the legacy fallback branch.
func unsetOpenAPITestEnv(t *testing.T, name string) {
	t.Helper()
	value, exists := os.LookupEnv(name)
	require.NoError(t, os.Unsetenv(name))
	t.Cleanup(func() {
		if exists {
			require.NoError(t, os.Setenv(name, value))
			return
		}
		require.NoError(t, os.Unsetenv(name))
	})
}

// TestOpenAPIEnvironmentPrecedence preserves old opt-outs while giving the canonical setting priority.
func TestOpenAPIEnvironmentPrecedence(t *testing.T) {
	for _, test := range []struct {
		name      string
		canonical string
		previous  string
		legacy    string
		enabled   bool
	}{
		{name: "default", enabled: true},
		{name: "canonical disables", canonical: "false", previous: "true", legacy: "true"},
		{name: "canonical enables", canonical: "true", previous: "false", legacy: "false", enabled: true},
		{name: "previous disables", previous: "false", legacy: "true"},
		{name: "previous enables", previous: "true", legacy: "false", enabled: true},
		{name: "legacy disables", legacy: "false"},
		{name: "zero disables", canonical: "0"},
		{name: "off disables", canonical: "off"},
		{name: "blank inherits", canonical: " ", previous: "false"},
	} {
		t.Run(test.name, func(t *testing.T) {
			t.Setenv("API_OPENAPI_ENABLED", test.canonical)
			t.Setenv("API_SWAGGER_ENABLED", test.previous)
			t.Setenv("SWAGGER_ENABLED", test.legacy)
			e := bootstrapOpenAPITestServer(t)
			for _, path := range []string{"/openapi", "/openapi/", "/swagger", "/swagger/"} {
				rec := httptest.NewRecorder()
				e.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, path, nil))
				want := http.StatusNotFound
				if test.enabled {
					want = http.StatusOK
				}
				assert.Equal(t, want, rec.Code, path)
			}
		})
	}
}

// TestOpenAPILegacySpecURLPreservesAppSelection keeps bookmarked document URLs scoped to the active App.
func TestOpenAPILegacySpecURLPreservesAppSelection(t *testing.T) {
	t.Setenv("API_OPENAPI_ENABLED", "true")
	t.Setenv("FORJ_APP", "customer-portal")
	t.Setenv("OPENAPI_SPEC_PATH", "")
	root := t.TempDir()
	writeOpenAPITestSpec(t, filepath.Join(root, "build", "openapi.json"), `{"openapi":"3.0.3","paths":{"/wrong-app":{}}}`)
	writeOpenAPITestSpec(t, filepath.Join(root, "build", "customer-portal", "openapi.json"), `{"openapi":"3.0.3","paths":{"/selected":{}}}`)
	useOpenAPITestWorkingDirectory(t, root)
	e := bootstrapOpenAPITestServer(t)
	for _, path := range []string{"/openapi/doc.json", "/swagger/doc.json"} {
		rec := httptest.NewRecorder()
		e.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, path, nil))
		require.Equal(t, http.StatusOK, rec.Code)
		assert.Contains(t, rec.Body.String(), "/selected")
		assert.NotContains(t, rec.Body.String(), "/wrong-app")
	}
}
