package http

import (
	"context"

{{- if .Components.HasDatabase }}
	"{{.GoModuleName}}/internal/database"
{{- end }}
{{- if .Components.Jobs }}
	"github.com/goforj/queue"
{{- end }}
	"github.com/goforj/cache/cachecore"
)

// ReadinessCheck represents a dependency check used by readiness probes.
type ReadinessCheck struct {
	Name  string
	Check func(context.Context) error
}

// ProvideReadinessChecks builds the dependency checks for readiness probes.
func ProvideReadinessChecks(
{{- if .Components.HasDatabase }}
	db *database.Connections,
{{- end }}
	cacheStore cachecore.Store,
{{- if .Components.Jobs }}
	appQueue *queue.Queue,
{{- end }}
) []ReadinessCheck {
	checks := make([]ReadinessCheck, 0)

{{- if .Components.HasDatabase }}
	checks = append(checks, ReadinessCheck{
		Name: "db_default",
		Check: func(ctx context.Context) error {
			conn, err := db.Default()
			if err != nil {
				return err
			}

			sqlDB, err := conn.DB()
			if err != nil {
				return err
			}

			return sqlDB.PingContext(ctx)
		},
	})
{{- end }}

	checks = append(checks, ReadinessCheck{
		Name: "cache",
		Check: func(ctx context.Context) error {
			if cacheStore == nil {
				return nil
			}
			return cacheReady(ctx, cacheStore)
		},
	})

{{- if .Components.Jobs }}
	checks = append(checks, ReadinessCheck{
		Name: "queue",
		Check: func(ctx context.Context) error {
			if appQueue == nil {
				return nil
			}
			return appQueue.Ready(ctx)
		},
	})
{{- end }}

	return checks
}

func cacheReady(ctx context.Context, store cachecore.Store) error {
	if ready, ok := any(store).(interface {
		Ready(context.Context) error
	}); ok {
		return ready.Ready(ctx)
	}
	return nil
}
