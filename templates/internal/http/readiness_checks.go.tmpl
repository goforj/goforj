package http

import (
	"context"
	"fmt"
	"strings"

{{- if .Components.HasDatabase }}
	"{{.GoModuleName}}/internal/dbconns"
{{- end }}
{{- if .Components.Jobs }}
	"{{.GoModuleName}}/internal/queue"
{{- end }}
	"github.com/goforj/env/v2"
	"github.com/redis/go-redis/v9"
)

// ReadinessCheck represents a dependency check used by readiness probes.
type ReadinessCheck struct {
	Name  string
	Check func(context.Context) error
}

// ProvideReadinessChecks builds the dependency checks for readiness probes.
func ProvideReadinessChecks(
{{- if .Components.HasDatabase }}
	db *dbconns.Connections,
{{- end }}
) []ReadinessCheck {
	checks := make([]ReadinessCheck, 0)

{{- if .Components.HasDatabase }}
	checks = append(checks, ReadinessCheck{
		Name: "db_default",
		Check: func(ctx context.Context) error {
			conn, err := db.Default()
			if err != nil {
				return err
			}

			sqlDB, err := conn.DB()
			if err != nil {
				return err
			}

			return sqlDB.PingContext(ctx)
		},
	})
{{- end }}

	checks = append(checks, ReadinessCheck{
		Name: "cache_redis",
		Check: func(ctx context.Context) error {
			if !cacheUsesRedis() {
				return nil
			}

			client := newReadinessRedisClient()
			defer client.Close()

			return client.Ping(ctx).Err()
		},
	})

{{- if .Components.Jobs }}
	checks = append(checks, ReadinessCheck{
		Name: "queue_redis",
		Check: func(ctx context.Context) error {
			if !queue.UsesRedis() {
				return nil
			}

			client := newReadinessRedisClient()
			defer client.Close()

			return client.Ping(ctx).Err()
		},
	})
{{- end }}

	return checks
}

func cacheUsesRedis() bool {
	return strings.EqualFold(env.Get("CACHE_DRIVER", "memory"), "redis")
}

func newReadinessRedisClient() *redis.Client {
	addr := fmt.Sprintf(
		"%s:%s",
		env.Get("REDIS_HOST", "redis"),
		env.Get("REDIS_PORT", "6379"),
	)
	return redis.NewClient(&redis.Options{
		Addr:     addr,
		Password: env.Get("REDIS_PASSWORD", ""),
		DB:       env.GetInt("REDIS_DB", "0"),
	})
}
