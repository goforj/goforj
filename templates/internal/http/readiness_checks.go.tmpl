package http

import (
	"context"

	"{{.GoModuleName}}/internal/caches"
{{- if .ProjectComponents.HasDatabase }}
	"{{.GoModuleName}}/internal/database"
{{- end }}
{{- if .ProjectComponents.Events }}
	"{{.GoModuleName}}/internal/events"
{{- end }}
{{- if .ProjectComponents.Jobs }}
	"{{.GoModuleName}}/internal/queues"
{{- end }}
{{- if .ProjectComponents.Storage }}
	"{{.GoModuleName}}/internal/storages"
{{- end }}
)

// ReadinessCheck represents a dependency check used by readiness probes.
type ReadinessCheck struct {
	Name  string
	Check func(context.Context) error
}

// ProvideReadinessChecks builds the dependency checks for readiness probes.
func ProvideReadinessChecks(
	caches *caches.Manager,
{{- if .ProjectComponents.Storage }}
	storage *storages.Manager,
{{- end }}
{{- if .ProjectComponents.Events }}
	events *events.Manager,
{{- end }}
{{- if .ProjectComponents.Jobs }}
	queues *queues.Manager,
{{- end }}
{{- if .ProjectComponents.HasDatabase }}
	db *database.Connections,
{{- end }}
) []ReadinessCheck {
	checks := make([]ReadinessCheck, 0)
	if caches != nil {
		for _, check := range caches.ReadinessChecks() {
			checks = append(checks, ReadinessCheck{
				Name:  check.Name,
				Check: check.Check,
			})
		}
	}

{{- if .ProjectComponents.HasDatabase }}
	if db != nil {
		for _, check := range db.ReadinessChecks() {
			checks = append(checks, ReadinessCheck{
				Name:  check.Name,
				Check: check.Check,
			})
		}
	}
{{- end }}

{{- if .ProjectComponents.Storage }}
	if storage != nil {
		for _, check := range storage.ReadinessChecks() {
			checks = append(checks, ReadinessCheck{
				Name:  check.Name,
				Check: check.Check,
			})
		}
	}
{{- end }}

{{- if .ProjectComponents.Events }}
	if events != nil {
		for _, check := range events.ReadinessChecks() {
			checks = append(checks, ReadinessCheck{
				Name:  check.Name,
				Check: check.Check,
			})
		}
	}
{{- end }}

{{- if .ProjectComponents.Jobs }}
	if queues != nil {
		for _, check := range queues.ReadinessChecks() {
			checks = append(checks, ReadinessCheck{
				Name:  check.Name,
				Check: check.Check,
			})
		}
	}
{{- end }}

	return checks
}
