package http

import (
	"github.com/goforj/web"
	"reflect"
	"runtime"
)

// NewRoute creates a new route using the app-facing web handler contract directly.
func NewRoute(
	method string,
	route string,
	handler web.Handler,
	middlewares ...web.Middleware,
) Route {
	return Route{
		method:      method,
		route:       route,
		handler:     handler,
		handlerName: qualifyHandler(runtime.FuncForPC(reflect.ValueOf(handler).Pointer()).Name()),
		middlewares: middlewares,
	}
}

// Route represents a single route in the application.
type Route struct {
	method          string
	route           string
	handler         web.Handler
	handlerName     string
	middlewares     []web.Middleware
	middlewareNames []string
}

// Method returns the HTTP method
func (r *Route) Method() string {
	return r.method
}

// Path returns the path of the route
func (r *Route) Path() string {
	return r.route
}

// Handler returns the handler method
func (r *Route) Handler() web.Handler {
	return r.handler
}

// HandlerName returns the original handler name for route reporting.
func (r *Route) HandlerName() string {
	return r.handlerName
}

// Middlewares returns the middlewares
// to be applied to the route
func (r *Route) Middlewares() []web.Middleware {
	if len(r.middlewares) > 0 {
		return r.middlewares
	}

	return []web.Middleware{}
}

// MiddlewareNames returns the original middleware names for route reporting.
func (r *Route) MiddlewareNames() []string {
	return r.middlewareNames
}

// NewRouteGroup wraps routes and their accompanied web middleware.
func NewRouteGroup(
	prefix string,
	routes []Route,
	middlewares ...web.Middleware,
) RouteGroup {
	return RouteGroup{
		routePrefix: prefix,
		routes:      routes,
		middlewares: middlewares,
	}
}

// RouteGroup represents a group of routes
type RouteGroup struct {
	routePrefix     string
	routes          []Route
	middlewares     []web.Middleware
	middlewareNames []string
}

// RoutePrefix returns the prefix of the route group
func (c *RouteGroup) RoutePrefix() string {
	return c.routePrefix
}

// Routes returns the routes in the group
func (c *RouteGroup) Routes() []Route {
	return c.routes
}

// Middlewares returns the middlewares for the group
func (c *RouteGroup) Middlewares() []web.Middleware {
	return c.middlewares
}

// MiddlewareNames returns the original middleware names for route reporting.
func (c *RouteGroup) MiddlewareNames() []string {
	return c.middlewareNames
}
