package http

import (
	"fmt"
	"os"
	"strings"

	"github.com/goforj/web"
	"{{.GoModuleName}}/internal/logger"
)

// RouteListCmd lists registered routes.
type RouteListCmd struct {
	logger *logger.AppLogger
	server *Server
}

// NewRouteListCmd creates a new RouteListCmd instance.
func NewRouteListCmd(logger *logger.AppLogger, server *Server) *RouteListCmd {
	return &RouteListCmd{logger: logger, server: server}
}

// Signature defines CLI metadata for this command.
func (*RouteListCmd) Signature() string {
	return `name:"route:list" help:"List HTTP routes"`
}

// Run executes the command to list all registered routes.
func (c *RouteListCmd) Run() error {
	entries := web.BuildRouteEntries(c.server.GetRoutes())
	fmt.Printf("App: %s\n\n", routeListApp())
	fmt.Println(web.RenderRouteTable(entries))
	return nil
}

func routeListApp() string {
	if app := strings.TrimSpace(os.Getenv("FORJ_APP")); app != "" {
		return app
	}
	return "app"
}
