package http

import (
	"net/http"
	"net/http/httptest"
	"testing"

	"{{.GoModuleName}}/internal/runtime"
	"{{.GoModuleName}}/internal/inspects"
	"{{.GoModuleName}}/internal/logger"
{{- if .ProjectComponents.Metrics }}
	"{{.GoModuleName}}/internal/metrics"
{{- end }}
)

type httpRuntimeBenchmarkMode struct {
	name       string
	accessLogs bool
	inspect    bool
{{- if .ProjectComponents.Metrics }}
	metrics    bool
{{- end }}
}

type noopRuntimeBenchmarkPublisher struct{}

func (noopRuntimeBenchmarkPublisher) Publish(inspects.Record) {}

func BenchmarkHTTPRuntimeModes(b *testing.B) {
	req := httptest.NewRequest(http.MethodGet, "/-/health", nil)
	req.Header.Set("Accept", "application/json")
	req.Header.Set("X-Request-ID", "bench-health-123")

	modes := []httpRuntimeBenchmarkMode{
		{
			name:       "baseline",
			accessLogs: false,
			inspect:    false,
{{- if .ProjectComponents.Metrics }}
			metrics:    false,
{{- end }}
		},
{{- if .ProjectComponents.Metrics }}
		{
			name:       "metrics_only",
			accessLogs: false,
			inspect:    false,
			metrics:    true,
		},
{{- end }}
		{
			name:       "logging_only",
			accessLogs: true,
			inspect:    false,
{{- if .ProjectComponents.Metrics }}
			metrics:    false,
{{- end }}
		},
		{
			name:       "inspect_only",
			accessLogs: false,
			inspect:    true,
{{- if .ProjectComponents.Metrics }}
			metrics:    false,
{{- end }}
		},
		{
			name:       "full_stack",
			accessLogs: true,
			inspect:    true,
{{- if .ProjectComponents.Metrics }}
			metrics:    true,
{{- end }}
		},
	}

	b.Run("health_route", func(b *testing.B) {
		for _, mode := range modes {
			mode := mode
			b.Run(mode.name, func(b *testing.B) {
				handler := newHTTPRuntimeBenchmarkServer(b, mode)
				b.ReportAllocs()
				b.ResetTimer()

				for i := 0; i < b.N; i++ {
					rec := httptest.NewRecorder()
					handler.ServeHTTP(rec, req)
					if rec.Code != http.StatusOK {
						b.Fatalf("unexpected status code: got %d want %d", rec.Code, http.StatusOK)
					}
				}
			})
		}
	})
}

// newHTTPRuntimeBenchmarkServer isolates each benchmark mode's optional runtime dependencies.
func newHTTPRuntimeBenchmarkServer(b *testing.B, mode httpRuntimeBenchmarkMode) http.Handler {
	b.Helper()

	if mode.accessLogs {
		b.Setenv("HTTP_ACCESS_LOG_ENABLED", "true")
	} else {
		b.Setenv("HTTP_ACCESS_LOG_ENABLED", "false")
	}

{{- if .ProjectComponents.Metrics }}
	if mode.metrics {
		b.Setenv("METRICS_HTTP_ENABLED", "true")
	} else {
		b.Setenv("METRICS_HTTP_ENABLED", "false")
	}
{{- end }}

	var inspectManager *inspects.Manager
	if mode.inspect {
		inspectManager = inspects.NewManager()
		inspectManager.SetPublisher(noopRuntimeBenchmarkPublisher{})
		inspectManager.SetPublishOnly(true)
	}

{{- if .ProjectComponents.Metrics }}
	var metricsManager *metrics.Manager
	if mode.metrics {
		metricsManager = metrics.NewManager()
	}
{{- end }}

	s := NewServer(
		logger.NewSilentLogger(),
		runtime.NewTimeouts(),
		nil,
		nil,
		nil,
{{- if .ProjectComponents.Storage }}
		nil,
{{- end }}
		inspectManager,
{{- if .ProjectComponents.Metrics }}
		metricsManager,
{{- end }}
	)
	server, err := s.bootstrap("")
	if err != nil {
		b.Fatalf("bootstrap server: %v", err)
	}
	return server
}
