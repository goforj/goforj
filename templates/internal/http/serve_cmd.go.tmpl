package http

import (
	"context"
	"os/signal"
	"strings"
	"syscall"

{{- if .Components.Metrics }}
	appmetrics "{{.GoModuleName}}/internal/metrics"
{{- end }}
)

// ServeCmd represents the command to start the HTTP server.
type ServeCmd struct {
	server     *Server
	lighthouse *LighthouseRuntime
{{- if .Components.Metrics }}
	metricsManager *appmetrics.Manager
{{- end }}

	// flags / args
	Host string `help:"Host or interface to bind to" env:"API_HTTP_HOST" default:"0.0.0.0" optional:""`
	Port string `help:"Port to listen on" env:"API_HTTP_PORT" default:"3000" optional:""`
{{- if .Components.Metrics }}
	MetricsPort string `help:"Port for the dedicated API metrics endpoint" env:"METRICS_API_PORT" default:"9100" optional:""`
{{- end }}
}

// NewServeCmd creates a new instance of ServeCmd.
func NewServeCmd(
	server *Server,
	lighthouse *LighthouseRuntime,
{{- if .Components.Metrics }}
	metricsManager *appmetrics.Manager,
{{- end }}
) *ServeCmd {
	return &ServeCmd{
		server:     server,
		lighthouse: lighthouse,
{{- if .Components.Metrics }}
		metricsManager: metricsManager,
{{- end }}
	}
}

// Run executes the command.
func (c *ServeCmd) Run() error {
	runCtx, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stop()
	return c.RunWithContext(runCtx)
}

// RunWithContext executes the command with a caller-provided lifecycle context.
func (c *ServeCmd) RunWithContext(runCtx context.Context) error {
	if runCtx == nil {
		runCtx = context.Background()
	}
	host := strings.TrimSpace(c.Host)
	port := strings.TrimSpace(c.Port)

{{- if .Components.Metrics }}
	if c.metricsManager != nil && c.metricsManager.Registry() != nil {
		if err := appmetrics.StartPrometheusEndpoint(runCtx, c.server.logger, "api", c.MetricsPort, c.metricsManager.Registry()); err != nil {
			return err
		}
	}
{{- end }}
	c.lighthouse.Start(runCtx)
	return c.server.Serve(runCtx, host, port)
}
