package http

import (
	"context"
)

// ServeCmd represents the command to start the HTTP server.
type ServeCmd struct {
	runtime *Runtime

	// flags / args
	Host string `help:"Host or interface to bind to" env:"API_HTTP_HOST" default:"0.0.0.0" optional:""`
	Port string `help:"Port to listen on" optional:""`
{{- if .Components.Metrics }}
	MetricsPort string `help:"Port for the dedicated API metrics endpoint" optional:""`
{{- end }}
}

// NewServeCmd creates a new instance of ServeCmd.
func NewServeCmd(
	runtime *Runtime,
) *ServeCmd {
	return &ServeCmd{
		runtime: runtime,
	}
}

// Signature defines CLI metadata for this command.
func (*ServeCmd) Signature() string {
	return `name:"http:serve" aliases:"api" help:"Start the HTTP server"`
}

// Run executes the command.
func (c *ServeCmd) Run(ctx context.Context) error {
	return c.runtime.RunWithConfig(ctx, RuntimeConfig{
		Host: c.Host,
		Port: c.Port,
{{- if .Components.Metrics }}
		MetricsPort: c.MetricsPort,
{{- end }}
	})
}
