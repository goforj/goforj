// Server is a struct that represents an HTTP server.
type Server struct {
	logger          *logger.AppLogger
	groups          []web.RouteGroup
	readinessChecks []ReadinessCheck
	consoleHub      *lighthouse.Hub
	httpAccessLogs  bool
	port            string
}

// NewServer creates a new instance of Server.
func NewServer(
	logger *logger.AppLogger,
	groups []web.RouteGroup,
	readinessChecks []ReadinessCheck,
	consoleHub *lighthouse.Hub,
) *Server {
	return &Server{
		logger:          logger,
		groups:          groups,
		readinessChecks: readinessChecks,
		consoleHub:      consoleHub,
		httpAccessLogs:  resolveHTTPAccessLogsEnabled(),
	}
}

// bootstrap initializes the web adapter, registers routes, and sets up middlewares.
func (s *Server) bootstrap() *echoweb.Adapter {
	adapter := echoweb.New()
	router := adapter.Router()

	// register probe endpoints for deployment tooling
	s.registerHealthRoutes(router)

	// register Swagger UI + OpenAPI spec routes
	s.registerSwaggerRoutes(router)

	// register single page applications (SPAs)
	s.registerSinglePageApplications(router)

	// register routes
	s.registerRoutes(router)

	// register dev console
	if s.consoleHub != nil && lighthouse.Enabled() {
		lighthouse.Attach(router, s.consoleHub, lighthouse.ServerConfig{
			Token: os.Getenv("LIGHTHOUSE_TOKEN"),
		})
	}
{{ if .Components.Jobs }}
{{- end }}

	// Cross Origin Resource Sharing (CORS)
	s.registerCors(router)

	// captures response body for non-200 statuses, useful for debugging
	router.Use(s.logNon200ResponseBodyMiddleware())

	// logger
	if s.httpAccessLogs {
		router.Use(webmiddleware.RequestLoggerWithConfig(webmiddleware.RequestLoggerConfig{
			LogValuesFunc: s.Log,
		}))
	}

	return adapter
}

// Serve starts the HTTP server and listens on the given port.
func (s *Server) Serve(ctx context.Context, port string) error {
	// boot the server
	adapter := s.bootstrap()

	// print route list on boot
	s.PrintRoutesList()

	// announce server start
	s.logger.Info().Any("port", port).Msg("Starting HTTP server")

	addr := fmt.Sprintf(":%s", port)
	httpServer := &http.Server{
		Addr:    addr,
		Handler: adapter,
	}

	serverErr := make(chan error, 1)
	go func() {
		serverErr <- httpServer.ListenAndServe()
	}()

	select {
	case err := <-serverErr:
		if err == nil || errors.Is(err, http.ErrServerClosed) {
			return nil
		}
		return err
	case <-ctx.Done():
		s.logger.Info().Msg("Shutting down HTTP server")

		shutdownCtx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
		defer cancel()

		if err := httpServer.Shutdown(shutdownCtx); err != nil {
			return err
		}

		err := <-serverErr
		if err != nil && !errors.Is(err, http.ErrServerClosed) {
			return err
		}

		s.logger.Info().Msg("HTTP server shut down")
		return nil
	}
}

// GetRoutes returns all registered routes in the server.
// this is used for route:list command and for debugging purposes.
func (s *Server) GetRoutes() []web.RouteGroup {
	return s.groups
}

// Log is a middleware function that logs HTTP requests.
func (s *Server) Log(r web.Context, v webmiddleware.RequestLoggerValues) error {
	if !s.httpAccessLogs {
		return nil
	}
	// Devwatch source is an internal producer websocket and can reconnect frequently.
	// Skip it to avoid spamming request logs when no console client is attached.
	if strings.HasPrefix(v.URI, "/lighthouse/ws/devwatch") && strings.Contains(v.URI, "role=source") {
		return nil
	}

	l := s.logger.Info().
		Any("uri", v.URI).
		Any("status", v.Status).
		Any("method", v.Method).
		Any("latency", fmt.Sprintf("%.2fms", float64(v.Latency)/float64(time.Millisecond)))

	if v.Error != nil {
		l = l.Err(v.Error)
	}

	l.Msg("HTTP Request")

	return nil
}

func resolveHTTPAccessLogsEnabled() bool {
	raw := strings.ToLower(strings.TrimSpace(env.Get("HTTP_ACCESS_LOG_ENABLED", "true")))
	return raw != "false" && raw != "0" && raw != "off" && raw != "no"
}

// registerSinglePageApplications registers single page applications (SPAs) with the Echo server.
func (s *Server) registerSinglePageApplications(router web.Router) {
	// register single page applications
	for _, spa := range GetSpas() {
		g := router.Group(spa.BaseUri())
		g.Use(webmiddleware.StaticWithConfig(webmiddleware.StaticConfig{
			HTML5:      true,
			Root:       spa.FileRoot(),
			Filesystem: http.FS(spa.Filesystem()),
			Index:      "index.html",
			Skipper: func(r web.Context) bool {
				requestPath := strings.TrimPrefix(r.Request().URL.Path, "/")
				// Inline check for file extension (treat anything with a dot as an asset)
				if ext := path.Ext(requestPath); ext != "" {
					// Check if file exists in the embedded FS
					if _, err := spa.Filesystem().Open(path.Join(spa.FileRoot(), requestPath)); err != nil {
						_ = r.Text(http.StatusNotFound, "File not found")
						return true
					}
				}

				// Continue to Static middleware for SPA fallback or valid files
				return false
			},
		}))
	}
}

// registerRoutes registers all route groups and their routes with the Echo server.
func (s *Server) registerRoutes(router web.Router) {
	// loop through all route groups and register them
	for _, group := range s.groups {
		s.logger.Debug().Any("prefix", group.RoutePrefix()).Msg("Registering route group")
		var g web.Router = router.Group(group.RoutePrefix(), group.Middlewares()...)

		// register routes
		for _, r := range group.Routes() {
			s.logger.Debug().
				Any("prefix", group.RoutePrefix()).
				Any("route", r.Path()).
				Any("method", r.Method()).
			Msg("Registering route")
			switch r.Method() {
			case http.MethodGet:
				g.GET(r.Path(), r.Handler(), r.Middlewares()...)
			case http.MethodHead:
				g.HEAD(r.Path(), r.Handler(), r.Middlewares()...)
			case http.MethodOptions:
				g.OPTIONS(r.Path(), r.Handler(), r.Middlewares()...)
			case http.MethodConnect:
				g.CONNECT(r.Path(), r.Handler(), r.Middlewares()...)
			case http.MethodPost:
				g.POST(r.Path(), r.Handler(), r.Middlewares()...)
			case http.MethodPut:
				g.PUT(r.Path(), r.Handler(), r.Middlewares()...)
			case http.MethodPatch:
				g.PATCH(r.Path(), r.Handler(), r.Middlewares()...)
			case http.MethodDelete:
				g.DELETE(r.Path(), r.Handler(), r.Middlewares()...)
			case http.MethodTrace:
				g.TRACE(r.Path(), r.Handler(), r.Middlewares()...)
			default:
				s.logger.Warn().Any("method", r.Method()).Any("route", r.Path()).Msg("Unsupported route method")
			}
		}
	}
}
