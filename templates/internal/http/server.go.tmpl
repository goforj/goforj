// Server is a struct that represents an HTTP server.
type Server struct {
	logger          *logger.AppLogger
	groups          []web.RouteGroup
	readinessChecks []ReadinessCheck
	consoleHub      *lighthouse.Hub
	httpAccessLogs  bool
	appTimeouts     *runtime.Timeouts
{{- if .ProjectComponents.Storage }}
	storage         *storages.Manager
{{- end }}
	inspectManager  *inspects.Manager
	inspectEnabled  bool
{{- if .ProjectComponents.Metrics }}
	metrics         *metrics.Manager
{{- end }}
}

// NewServer creates a new instance of Server.
func NewServer(
	logger *logger.AppLogger,
	appTimeouts *runtime.Timeouts,
	groups []web.RouteGroup,
	readinessChecks []ReadinessCheck,
	consoleHub *lighthouse.Hub,
{{- if .ProjectComponents.Storage }}
	storage *storages.Manager,
{{- end }}
	inspectManager *inspects.Manager,
{{- if .ProjectComponents.Metrics }}
	metricsManager *metrics.Manager,
{{- end }}
) *Server {
	componentLogger := logger
	if componentLogger != nil {
		componentLogger = componentLogger.WithComponent("HTTP")
	}
	s := &Server{
		logger:          componentLogger,
		readinessChecks: readinessChecks,
		consoleHub:      consoleHub,
		httpAccessLogs:  resolveHTTPAccessLogsEnabled(),
		appTimeouts:     appTimeouts,
{{- if .ProjectComponents.Storage }}
		storage:         storage,
{{- end }}
		inspectManager:  inspectManager,
		inspectEnabled:  inspectManager != nil && inspectManager.Enabled(),
{{- if .ProjectComponents.Metrics }}
		metrics:         metricsManager,
{{- end }}
	}
	s.groups = append(append([]web.RouteGroup{}, groups...), s.frameworkRouteGroups()...)
	return s
}

// frameworkRouteGroups keeps project-wide route types available while optional App dependencies decide whether they contribute routes.
func (s *Server) frameworkRouteGroups() []web.RouteGroup {
	groups := make([]web.RouteGroup, 0, 2)
	groups = append(groups, s.healthRoutes()...)
	groups = append(groups, s.swaggerRoutes()...)
{{- if .ProjectComponents.Metrics }}
	groups = append(groups, s.metricsRoutes()...)
{{- end }}
	return groups
}

// bootstrap builds the web-owned HTTP server surface from routes and mounts.
func (s *Server) bootstrap(addr string) (*echoweb.Server, error) {
	return echoweb.NewServer(echoweb.ServerConfig{
		Addr:            addr,
		RouteGroups:     s.groups,
		Mounts:          s.routerMounts(),
		ShutdownTimeout: s.appTimeouts.ShutdownTimeout(),
	})
}

// Serve starts the HTTP server and listens on the given host and port.
func (s *Server) Serve(ctx context.Context, host string, port string) error {
	addr := fmt.Sprintf("%s:%s", strings.TrimSpace(host), strings.TrimSpace(port))
	server, err := s.bootstrap(addr)
	if err != nil {
		return err
	}

	routeCount := len(web.BuildRouteEntries(s.groups))
	s.logger.Info().
		CompactValues(httpListenAddress(host, port), fmt.Sprintf("%d %s", routeCount, pluralizeHTTPRoutes(routeCount))).
		Any("host", host).
		Any("port", port).
		Any("addr", addr).
		Any("count", routeCount).
		Msg("HTTP server started")
	err = server.Serve(ctx)
	if err != nil {
		return err
	}
	s.logger.Info().Msg("HTTP server shut down")
	return nil
}

// httpListenAddress keeps wildcard listeners concise without hiding a specifically configured interface.
func httpListenAddress(host string, port string) string {
	host = strings.TrimSpace(host)
	port = strings.TrimSpace(port)
	if host == "" || host == "0.0.0.0" || host == "::" {
		return ":" + port
	}
	return net.JoinHostPort(host, port)
}

// pluralizeHTTPRoutes keeps the startup summary grammatical at every route count.
func pluralizeHTTPRoutes(count int) string {
	if count == 1 {
		return "route"
	}
	return "routes"
}

// GetRoutes returns all registered routes in the server.
// this is used for route:list command and for debugging purposes.
func (s *Server) GetRoutes() []web.RouteGroup {
	return s.groups
}

// Log is a middleware function that logs HTTP requests.
func (s *Server) Log(r web.Context, v webmiddleware.RequestLoggerValues) error {
	isInternalDevwatch := strings.HasPrefix(v.URI, "/lighthouse/ws/devwatch") && strings.Contains(v.URI, "role=source")
{{- if .ProjectComponents.Metrics }}
	if s.metrics != nil && s.metrics.HTTPEnabled() && !isInternalDevwatch {
		s.metrics.RecordHTTPRequest(r, v.Status, v.Latency)
	}
{{- end }}
	if s.inspectEnabled && s.inspectManager != nil && !isInternalDevwatch {
		s.inspectManager.Finish(r.Context(), httpInspectStatus(v.Status, v.Error), v.Error)
	}
	if !s.httpAccessLogs {
		return nil
	}
	// Devwatch source is an internal producer websocket and can reconnect frequently.
	// Skip it to avoid spamming request logs when no console client is attached.
	if isInternalDevwatch {
		return nil
	}
	if isGoForjDevReadinessProbe(r) {
		return nil
	}

	s.logger.HTTPAccess(v.URI, v.Status, v.Method, v.Latency, v.Error, r.RealIP())

	return nil
}

// isGoForjDevReadinessProbe authenticates private dev-loop traffic so ordinary health requests remain observable.
func isGoForjDevReadinessProbe(r web.Context) bool {
	token := strings.TrimSpace(env.Get("GOFORJ_DEV_READINESS_TOKEN", ""))
	return token != "" && r.Request().Header.Get("X-GoForj-Dev-Readiness") == token
}

func resolveHTTPAccessLogsEnabled() bool {
	raw := str.Of(env.Get("HTTP_ACCESS_LOG_ENABLED", "true")).Trim().ToLower().String()
	return raw != "false" && raw != "0" && raw != "off" && raw != "no"
}

// logHTTPErrorResponses captures local error response bodies for debugging.
func (s *Server) logHTTPErrorResponses() web.Middleware {
	localEnv := env.IsAppEnvLocal()
	return func(next web.Handler) web.Handler {
		if !localEnv {
			return next
		}
		return func(r web.Context) error {
			originalWriter := r.ResponseWriter()
			writer := newHTTPErrorCaptureResponseWriter(originalWriter)
			r.SetResponseWriter(writer)
			defer func() {
				r.SetResponseWriter(originalWriter)
				releaseHTTPErrorCaptureResponseWriter(writer)
			}()

			err := next(r)
			if status := writer.StatusCode(); status >= http.StatusBadRequest {
				s.recordHTTPErrorResponse(r, status, writer.Body())
			}
			return err
		}
	}
}

func (s *Server) recordHTTPErrorResponse(r web.Context, status int, body []byte) {
	if status < 400 {
		return
	}

	entry := s.logger.Info().
		Any("status", status).
		Any("method", r.Method()).
		Any("uri", r.URI())

	if payload := strings.TrimSpace(string(body)); payload != "" {
		entry = entry.Str("body", payload)
	}

	entry.Msg("HTTP error response")
}

var httpErrorCaptureResponseWriterPool = sync.Pool{
	New: func() any {
		return &httpErrorCaptureResponseWriter{}
	},
}

type httpErrorCaptureResponseWriter struct {
	http.ResponseWriter
	status      int
	wroteHeader bool
	body        bytes.Buffer
}

func newHTTPErrorCaptureResponseWriter(writer http.ResponseWriter) *httpErrorCaptureResponseWriter {
	captured := httpErrorCaptureResponseWriterPool.Get().(*httpErrorCaptureResponseWriter)
	captured.ResponseWriter = writer
	captured.status = 0
	captured.wroteHeader = false
	resetPooledCaptureBuffer(&captured.body, pooledCaptureBufferMaxRetain)
	return captured
}

func releaseHTTPErrorCaptureResponseWriter(writer *httpErrorCaptureResponseWriter) {
	if writer == nil {
		return
	}
	writer.ResponseWriter = nil
	writer.status = 0
	writer.wroteHeader = false
	resetPooledCaptureBuffer(&writer.body, pooledCaptureBufferMaxRetain)
	httpErrorCaptureResponseWriterPool.Put(writer)
}

func (w *httpErrorCaptureResponseWriter) WriteHeader(code int) {
	if w.wroteHeader {
		return
	}
	w.status = code
	w.wroteHeader = true
	w.ResponseWriter.WriteHeader(code)
}

func (w *httpErrorCaptureResponseWriter) Write(body []byte) (int, error) {
	if !w.wroteHeader {
		w.status = http.StatusOK
		w.wroteHeader = true
	}
	if w.status >= http.StatusBadRequest {
		_, _ = w.body.Write(body)
	}
	return w.ResponseWriter.Write(body)
}

func (w *httpErrorCaptureResponseWriter) Flush() {
	if flusher, ok := w.ResponseWriter.(http.Flusher); ok {
		flusher.Flush()
	}
}

func (w *httpErrorCaptureResponseWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
	hijacker, ok := w.ResponseWriter.(http.Hijacker)
	if !ok {
		return nil, nil, http.ErrNotSupported
	}
	return hijacker.Hijack()
}

func (w *httpErrorCaptureResponseWriter) Push(target string, opts *http.PushOptions) error {
	if p, ok := w.ResponseWriter.(http.Pusher); ok {
		return p.Push(target, opts)
	}
	return http.ErrNotSupported
}

func (w *httpErrorCaptureResponseWriter) Unwrap() http.ResponseWriter {
	return w.ResponseWriter
}

func (w *httpErrorCaptureResponseWriter) StatusCode() int {
	if w == nil {
		return 0
	}
	if w.status == 0 {
		return http.StatusOK
	}
	return w.status
}

func (w *httpErrorCaptureResponseWriter) Body() []byte {
	if w == nil || w.body.Len() == 0 {
		return nil
	}
	return w.body.Bytes()
}

// mountSinglePageApplications mounts SPA/static application surfaces.
func (s *Server) mountSinglePageApplications(router web.Router) error {
	// register single page applications
	for _, spa := range GetSpas() {
		handler := webmiddleware.StaticWithConfig(webmiddleware.StaticConfig{
			HTML5:      true,
			Root:       spa.FileRoot(),
			Filesystem: http.FS(spa.Filesystem()),
			Index:      "index.html",
			Skipper: func(r web.Context) bool {
				requestPath, _, _ := strings.Cut(strings.TrimPrefix(r.URI(), "/"), "?")
				// Inline check for file extension (treat anything with a dot as an asset)
				if ext := path.Ext(requestPath); ext != "" {
					// Check if file exists in the embedded FS
					if _, err := spa.Filesystem().Open(path.Join(spa.FileRoot(), requestPath)); err != nil {
						_ = r.Text(http.StatusNotFound, "File not found")
						return true
					}
				}

				// Continue to Static middleware for SPA fallback or valid files
				return false
			},
		})(func(r web.Context) error {
			// Signal a miss so the static middleware can drive its HTML5
			// fallback to index.html for client-side routes.
			return errors.New("spa route miss")
		})
		router.GET(spa.BaseUri(), handler)
		router.HEAD(spa.BaseUri(), handler)
	}
	return nil
}

// routerMounts composes optional framework routes only when their runtime dependencies are available.
func (s *Server) routerMounts() []web.RouterMount {
	mounts := []web.RouterMount{
		s.mountSinglePageApplications,
		s.mountCors,
		s.mountRuntimeMiddleware,
	}
	if s.consoleHub != nil && lighthouse.Enabled() {
		mounts = append(mounts, func(router web.Router) error {
{{- if .ProjectComponents.Storage }}
			var storageDownload func(web.Context, string, string) error
			if s.storage != nil {
				storageDownload = s.lighthouseStorageDownload
			}
{{- end }}
			lighthouse.Attach(router, s.consoleHub, lighthouse.ServerConfig{
				Secret: lighthouse.SharedSecretFromEnv(),
{{- if .ProjectComponents.Storage }}
				StorageDownload: storageDownload,
{{- end }}
				Inspects: s.inspectManager,
			})
			return nil
		})
	}
	return mounts
}

// mountRuntimeMiddleware activates only middleware backed by dependencies enabled for this App.
func (s *Server) mountRuntimeMiddleware(router web.Router) error {
	if s.inspectEnabled {
		router.Use(s.inspectContextMiddleware())
	} else {
		router.Use(s.sourceContextMiddleware(runtime.SourceHTTP))
	}
{{- if .ProjectComponents.Metrics }}
	if s.metrics != nil && s.metrics.HTTPEnabled() {
		router.Use(s.metrics.HTTPMiddleware())
	}
{{- end }}
	router.Use(s.logHTTPErrorResponses())
	if s.httpAccessLogs {
		router.Use(webmiddleware.RequestLoggerWithConfig(webmiddleware.RequestLoggerConfig{
			LogValuesFunc: s.Log,
		}))
	}
	if s.inspectEnabled {
		// Body dump must unwind before request logging so the captured
		// http_exchange event is recorded before Log() finalizes the inspect.
		router.Use(s.captureHTTPExchange())
	}
	return nil
}

func (s *Server) captureHTTPExchange() web.Middleware {
	return func(next web.Handler) web.Handler {
		return func(r web.Context) error {
			uri := r.URI()
			if strings.HasPrefix(uri, "/lighthouse/ws/") {
				return next(r)
			}
			if strings.Contains(strings.ToLower(r.Header("Upgrade")), "websocket") {
				return next(r)
			}
			if inspects.RecorderFromContext(r.Context()) == nil {
				return next(r)
			}

			req := web.RawRequest(r)
			ctx := r.Context()
			var reqBody []byte
			if req != nil && req.Body != nil && shouldCaptureInspectRequestBody(req) {
				body, err := io.ReadAll(req.Body)
					if err != nil {
					return err
				}
				reqBody = body
				req.Body = io.NopCloser(bytes.NewReader(body))
				r.SetRequest(req)
			}

			originalWriter := r.ResponseWriter()
			writer := newInspectCaptureResponseWriter(originalWriter)
			r.SetResponseWriter(writer)
			defer func() {
				r.SetResponseWriter(originalWriter)
				releaseInspectCaptureResponseWriter(writer)
			}()

			err := next(r)
			s.recordHTTPExchange(ctx, r, req, writer, reqBody, writer.Body())
			if !s.httpAccessLogs && s.inspectManager != nil {
				s.inspectManager.Finish(r.Context(), httpInspectStatus(r.StatusCode(), err), err)
			}
			return err
		}
	}
}

const inspectCaptureBodyLimit = 1024 * 1024
const pooledCaptureBufferMaxRetain = 64 * 1024

var inspectCaptureResponseWriterPool = sync.Pool{
	New: func() any {
		return &inspectCaptureResponseWriter{}
	},
}

func shouldCaptureInspectRequestBody(req *http.Request) bool {
	if req == nil || req.Body == nil {
		return false
	}
	if req.ContentLength > 0 {
		return true
	}
	return len(req.TransferEncoding) > 0
}

type inspectCaptureResponseWriter struct {
	http.ResponseWriter
	body bytes.Buffer
}

func newInspectCaptureResponseWriter(writer http.ResponseWriter) *inspectCaptureResponseWriter {
	captured := inspectCaptureResponseWriterPool.Get().(*inspectCaptureResponseWriter)
	captured.ResponseWriter = writer
	resetPooledCaptureBuffer(&captured.body, pooledCaptureBufferMaxRetain)
	return captured
}

func releaseInspectCaptureResponseWriter(writer *inspectCaptureResponseWriter) {
	if writer == nil {
		return
	}
	writer.ResponseWriter = nil
	resetPooledCaptureBuffer(&writer.body, pooledCaptureBufferMaxRetain)
	inspectCaptureResponseWriterPool.Put(writer)
}

func (w *inspectCaptureResponseWriter) Write(body []byte) (int, error) {
	if remaining := inspectCaptureBodyLimit - w.body.Len(); remaining > 0 {
		if len(body) > remaining {
			_, _ = w.body.Write(body[:remaining])
		} else {
			_, _ = w.body.Write(body)
		}
	}
	return w.ResponseWriter.Write(body)
}

func (w *inspectCaptureResponseWriter) Flush() {
	if flusher, ok := w.ResponseWriter.(http.Flusher); ok {
		flusher.Flush()
	}
}

func (w *inspectCaptureResponseWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
	hijacker, ok := w.ResponseWriter.(http.Hijacker)
	if !ok {
		return nil, nil, http.ErrNotSupported
	}
	return hijacker.Hijack()
}

func (w *inspectCaptureResponseWriter) Unwrap() http.ResponseWriter {
	return w.ResponseWriter
}

func (w *inspectCaptureResponseWriter) Body() []byte {
	if w == nil || w.body.Len() == 0 {
		return nil
	}
	return w.body.Bytes()
}

// resetPooledCaptureBuffer keeps common-case buffers reusable while letting
// unusually large responses fall out of the pool instead of bloating it.
func resetPooledCaptureBuffer(buf *bytes.Buffer, maxRetain int) {
	if buf == nil {
		return
	}
	if maxRetain > 0 && buf.Cap() > maxRetain {
		*buf = bytes.Buffer{}
		return
	}
	buf.Reset()
}

func (s *Server) sourceContextMiddleware(source runtime.Source) web.Middleware {
	sourceName := source.String()
	return func(next web.Handler) web.Handler {
		return func(r web.Context) error {
			if carrier, ok := r.(interface{ SetAppSourceName(string) }); ok {
				carrier.SetAppSourceName(sourceName)
			} else {
				web.BindContext(r, runtime.WithSource(r.Context(), source))
			}
			return next(r)
		}
	}
}

func (s *Server) inspectContextMiddleware() web.Middleware {
	return func(next web.Handler) web.Handler {
		return func(r web.Context) error {
			if s.inspectManager == nil || !s.inspectManager.CaptureAllowed() {
				return next(r)
			}
			path, _, _ := strings.Cut(r.URI(), "?")
			name := r.Method() + " " + path
			web.BindContext(r, s.inspectManager.BeginHTTP(r.Context(), name))
			return next(r)
		}
	}
}

func httpInspectStatus(status int, err error) string {
	if err != nil {
		return "error"
	}
	if status >= http.StatusInternalServerError {
		return "error"
	}
	if status == http.StatusRequestTimeout {
		return "canceled"
	}
	return "ok"
}

func (s *Server) recordHTTPExchange(ctx context.Context, r web.Context, req *http.Request, writer *inspectCaptureResponseWriter, reqBody, resBody []byte) {
	if s.inspectManager == nil || req == nil {
		return
	}
	requestHeaders := req.Header
	requestContentType := requestHeaders.Get("Content-Type")
	s.inspectManager.RecordHTTPExchangeFromHeaders(
		ctx,
		req.Method,
		r.Scheme(),
		r.Host(),
		r.URI(),
		httpBodyForInspect(requestContentType, reqBody),
		requestHeaders,
		httpBodyForInspectRaw(requestContentType, reqBody),
		r.StatusCode(),
		writer.Header(),
		httpBodyForInspect(writer.Header().Get("Content-Type"), resBody),
	)
}

func httpBodyForInspect(contentType string, body []byte) string {
	return httpBodyForInspectWithOptions(contentType, body, true)
}

func httpBodyForInspectRaw(contentType string, body []byte) string {
	return httpBodyForInspectWithOptions(contentType, body, false)
}

func httpBodyForInspectWithOptions(contentType string, body []byte, redact bool) string {
	if len(body) == 0 {
		return ""
	}
	const maxBodyBytes = 1024 * 1024
	if fast, ok := httpBodyForInspectFastPath(contentType, body, redact, maxBodyBytes); ok {
		return fast
	}
	body = bytes.TrimSpace(body)
	if len(body) == 0 {
		return ""
	}
	if !isInspectableHTTPBody(contentType, body) {
		return fmt.Sprintf("[non-text payload omitted: %d bytes]", len(body))
	}
	if redact {
		body = redactHTTPBodyForInspect(contentType, body)
	}
	if len(body) > maxBodyBytes {
		return string(body[:maxBodyBytes]) + "\n...[truncated]"
	}
	return string(body)
}

// httpBodyForInspectFastPath handles the common lower-case JSON/form cases
// without paying the generic content-type normalization and inspectability path.
func httpBodyForInspectFastPath(contentType string, body []byte, redact bool, maxBodyBytes int) (string, bool) {
	if len(body) == 0 {
		return "", true
	}
	body = trimInspectBodyFast(body)
	if len(body) == 0 {
		return "", true
	}
	switch {
	case hasCommonJSONInspectContentType(contentType):
		if redact && mayContainSensitiveJSONInspectField(body) {
			body = redactJSONBodyForInspect(body)
		}
		return formatInspectBodyString(body, maxBodyBytes), true
	case hasCommonFormInspectContentType(contentType):
		if redact && mayContainSensitiveFormInspectField(body) {
			body = redactFormBodyForInspect(body)
		}
		return formatInspectBodyString(body, maxBodyBytes), true
	default:
		return "", false
	}
}

func trimInspectBodyFast(body []byte) []byte {
	if len(body) == 0 {
		return nil
	}
	if !isInspectSpace(body[0]) && !isInspectSpace(body[len(body)-1]) {
		return body
	}
	return bytes.TrimSpace(body)
}

func isInspectSpace(b byte) bool {
	switch b {
	case ' ', '\t', '\n', '\r', '\f', '\v':
		return true
	default:
		return false
	}
}

func hasCommonJSONInspectContentType(contentType string) bool {
	return strings.HasPrefix(contentType, "application/json") || strings.Contains(contentType, "+json")
}

func hasCommonFormInspectContentType(contentType string) bool {
	return strings.HasPrefix(contentType, "application/x-www-form-urlencoded")
}

func formatInspectBodyString(body []byte, maxBodyBytes int) string {
	if len(body) > maxBodyBytes {
		return string(body[:maxBodyBytes]) + "\n...[truncated]"
	}
	return string(body)
}

func redactHTTPBodyForInspect(contentType string, body []byte) []byte {
	contentType = str.Of(contentType).Trim().ToLower().String()
	if strings.Contains(contentType, "application/json") || strings.Contains(contentType, "+json") {
		if !mayContainSensitiveJSONInspectField(body) {
			return body
		}
		return redactJSONBodyForInspect(body)
	}
	if strings.Contains(contentType, "application/x-www-form-urlencoded") {
		if !mayContainSensitiveFormInspectField(body) {
			return body
		}
		return redactFormBodyForInspect(body)
	}
	return body
}

func redactJSONBodyForInspect(body []byte) []byte {
	var decoded any
	if err := json.Unmarshal(body, &decoded); err != nil {
		return body
	}
	redactJSONValueForInspect(decoded)
	encoded, err := json.Marshal(decoded)
	if err != nil {
		return body
	}
	return encoded
}

func redactJSONValueForInspect(value any) {
	switch typed := value.(type) {
	case map[string]any:
		for key, child := range typed {
			if isSensitiveInspectField(key) {
				typed[key] = "[redacted]"
				continue
			}
			redactJSONValueForInspect(child)
		}
	case []any:
		for _, child := range typed {
			redactJSONValueForInspect(child)
		}
	}
}

func redactFormBodyForInspect(body []byte) []byte {
	values, err := url.ParseQuery(string(body))
	if err != nil {
		return body
	}
	changed := false
	for key := range values {
		if !isSensitiveInspectField(key) {
			continue
		}
		values[key] = []string{"[redacted]"}
		changed = true
	}
	if !changed {
		return body
	}
	return []byte(values.Encode())
}

func isSensitiveInspectField(key string) bool {
	normalized := str.Of(key).Trim().ToLower().String()
	if normalized == "" {
		return false
	}
	switch normalized {
	case "authorization",
		"cookie",
		"password",
		"passwd",
		"secret",
		"token",
		"access_token",
		"refresh_token",
		"id_token",
		"api_key",
		"apikey",
		"client_secret":
		return true
	}
	return strings.HasSuffix(normalized, "_token") ||
		strings.HasSuffix(normalized, "_secret") ||
		strings.HasSuffix(normalized, "_password")
}

var sensitiveInspectJSONFieldHints = [][]byte{
	[]byte(`"authorization"`),
	[]byte(`"cookie"`),
	[]byte(`"password"`),
	[]byte(`"passwd"`),
	[]byte(`"secret"`),
	[]byte(`"token"`),
	[]byte(`"access_token"`),
	[]byte(`"refresh_token"`),
	[]byte(`"id_token"`),
	[]byte(`"auth_token"`),
	[]byte(`"api_key"`),
	[]byte(`"apikey"`),
	[]byte(`"client_secret"`),
	[]byte(`"_token"`),
	[]byte(`"_secret"`),
	[]byte(`"_password"`),
}

var sensitiveInspectFormFieldHints = [][]byte{
	[]byte("authorization="),
	[]byte("cookie="),
	[]byte("password="),
	[]byte("passwd="),
	[]byte("secret="),
	[]byte("token="),
	[]byte("access_token="),
	[]byte("refresh_token="),
	[]byte("id_token="),
	[]byte("api_key="),
	[]byte("apikey="),
	[]byte("client_secret="),
	[]byte("_token="),
	[]byte("_secret="),
	[]byte("_password="),
}

// mayContainSensitiveJSONInspectField cheaply avoids a full JSON parse on
// obviously harmless payloads like health responses.
func mayContainSensitiveJSONInspectField(body []byte) bool {
	return containsSensitiveInspectHint(body, sensitiveInspectJSONFieldHints)
}

// mayContainSensitiveFormInspectField cheaply avoids a full form parse on
// bodies that clearly do not contain sensitive keys.
func mayContainSensitiveFormInspectField(body []byte) bool {
	return containsSensitiveInspectHint(body, sensitiveInspectFormFieldHints)
}

func containsSensitiveInspectHint(body []byte, hints [][]byte) bool {
	for _, hint := range hints {
		if containsASCIIFold(body, hint) {
			return true
		}
	}
	return false
}

func containsASCIIFold(body, needle []byte) bool {
	if len(needle) == 0 || len(body) < len(needle) {
		return false
	}
	limit := len(body) - len(needle)
	for i := 0; i <= limit; i++ {
		if asciiEqualFoldBytes(body[i:i+len(needle)], needle) {
			return true
		}
	}
	return false
}

func asciiEqualFoldBytes(a, b []byte) bool {
	if len(a) != len(b) {
		return false
	}
	for i := range a {
		if asciiToLower(a[i]) != asciiToLower(b[i]) {
			return false
		}
	}
	return true
}

func asciiToLower(b byte) byte {
	if b >= 'A' && b <= 'Z' {
		return b + ('a' - 'A')
	}
	return b
}

func isInspectableHTTPBody(contentType string, body []byte) bool {
	contentType = str.Of(contentType).Trim().ToLower().String()
	if contentType == "" {
		return isLikelyText(body)
	}
	return strings.Contains(contentType, "json") ||
		strings.Contains(contentType, "xml") ||
		strings.Contains(contentType, "yaml") ||
		strings.Contains(contentType, "text/") ||
		strings.Contains(contentType, "application/x-www-form-urlencoded") ||
		strings.Contains(contentType, "application/javascript") ||
		strings.Contains(contentType, "application/graphql") ||
		isLikelyText(body)
}

func isLikelyText(body []byte) bool {
	if len(body) == 0 {
		return false
	}
	sample := body
	if len(sample) > 512 {
		sample = sample[:512]
	}
	reader := bytes.NewReader(sample)
	buf := make([]byte, len(sample))
	n, _ := reader.Read(buf)
	if n == 0 {
		return false
	}
	return utf8PrintableRatio(buf[:n]) > 0.9
}

func utf8PrintableRatio(body []byte) float64 {
	if len(body) == 0 {
		return 0
	}
	printable := 0
	total := 0
	for len(body) > 0 {
		r, size := utf8.DecodeRune(body)
		if r == utf8.RuneError && size == 1 {
			return 0
		}
		total++
		if r == '\n' || r == '\r' || r == '\t' || (r != 0 && unicode.IsPrint(r)) {
			printable++
		}
		body = body[size:]
	}
	if total == 0 {
		return 0
	}
	return float64(printable) / float64(total)
}
