func TestHTTPListenAddress(t *testing.T) {
	assert.Equal(t, ":3000", httpListenAddress("0.0.0.0", "3000"))
	assert.Equal(t, ":3000", httpListenAddress("::", "3000"))
	assert.Equal(t, "127.0.0.1:3000", httpListenAddress("127.0.0.1", "3000"))
	assert.Equal(t, "[::1]:3000", httpListenAddress("::1", "3000"))
}

func TestPluralizeHTTPRoutes(t *testing.T) {
	assert.Equal(t, "route", pluralizeHTTPRoutes(1))
	assert.Equal(t, "routes", pluralizeHTTPRoutes(0))
	assert.Equal(t, "routes", pluralizeHTTPRoutes(2))
}

func TestLogSuppressesAuthenticatedDevReadinessProbe(t *testing.T) {
	t.Setenv("GOFORJ_DEV_READINESS_TOKEN", "test-readiness-token")
	ctx := webtest.NewContext(nil, nil, "/-/health", nil)
	ctx.Request().Header.Set("X-GoForj-Dev-Readiness", "test-readiness-token")
	assert.True(t, isGoForjDevReadinessProbe(ctx))

	server := &Server{httpAccessLogs: true}
	assert.NoError(t, server.Log(ctx, webmiddleware.RequestLoggerValues{
		URI:    "/-/health",
		Method: "GET",
		Status: 200,
	}))

	ctx.Request().Header.Set("X-GoForj-Dev-Readiness", "untrusted-token")
	assert.False(t, isGoForjDevReadinessProbe(ctx))
}

// TestSuppressRoutineSPAAccessLog verifies only successful registered SPA routes are quiet by default.
func TestSuppressRoutineSPAAccessLog(t *testing.T) {
	spas := []Spa{
		{baseUri: "/*"},
		{baseUri: "/admin/*"},
	}
	tests := []struct {
		name    string
		route   string
		values  webmiddleware.RequestLoggerValues
		spas    []Spa
		want    bool
	}{
		{name: "successful SPA asset", route: "/*", values: webmiddleware.RequestLoggerValues{Method: http.MethodGet, Status: http.StatusOK}, want: true},
		{name: "successful additional SPA asset", route: "/admin/*", values: webmiddleware.RequestLoggerValues{Method: http.MethodGet, Status: http.StatusOK}, want: true},
		{name: "cached SPA asset", route: "/*", values: webmiddleware.RequestLoggerValues{Method: http.MethodGet, Status: http.StatusNotModified}, want: true},
		{name: "failed SPA asset", route: "/*", values: webmiddleware.RequestLoggerValues{Method: http.MethodGet, Status: http.StatusNotFound}, want: false},
		{name: "SPA handler error", route: "/*", values: webmiddleware.RequestLoggerValues{Method: http.MethodGet, Status: http.StatusOK, Error: errors.New("delivery failed")}, want: false},
		{name: "application request", route: "/api/v1/reports", values: webmiddleware.RequestLoggerValues{Method: http.MethodGet, Status: http.StatusOK}, want: false},
		{name: "no registered SPAs", route: "/*", values: webmiddleware.RequestLoggerValues{Method: http.MethodGet, Status: http.StatusOK}, spas: []Spa{}, want: false},
	}
	for _, test := range tests {
		t.Run(test.name, func(t *testing.T) {
			registered := spas
			if test.spas != nil {
				registered = test.spas
			}
			assert.Equal(t, test.want, suppressRoutineSPAAccessLog(test.route, test.values, registered))
		})
	}
}

// BenchmarkSuppressRoutineSPAAccessLog guards registered-route and ordinary request checks against allocations.
func BenchmarkSuppressRoutineSPAAccessLog(b *testing.B) {
	spas := []Spa{
		{baseUri: "/*"},
	}
	values := webmiddleware.RequestLoggerValues{Method: http.MethodGet, Status: http.StatusOK}
	for _, benchmark := range []struct {
		name  string
		route string
		want  bool
	}{
		{name: "application_request", route: "/api/v1/reports"},
		{name: "SPA_request", route: "/*", want: true},
	} {
		b.Run(benchmark.name, func(b *testing.B) {
			b.ReportAllocs()
			for b.Loop() {
				if got := suppressRoutineSPAAccessLog(benchmark.route, values, spas); got != benchmark.want {
					b.Fatalf("suppressRoutineSPAAccessLog() = %t, want %t", got, benchmark.want)
				}
			}
		})
	}
}

// TestLogSuppressesOnlySuccessfulSPATraffic verifies env policy does not hide SPA failures or application requests.
func TestLogSuppressesOnlySuccessfulSPATraffic(t *testing.T) {
	t.Setenv("APP_LOG_FORMAT", "json")
	t.Setenv("APP_LOG_DEDUPE_ENABLED", "false")
	entries := make([]logger.LogEntry, 0, 2)
	appLogger := logger.NewAppLogger()
	appLogger.AddSink(func(entry logger.LogEntry) {
		entries = append(entries, entry)
	})
	server := &Server{logger: appLogger, httpAccessLogs: true}
	spaContext := webtest.NewContext(nil, nil, "/assets/*", nil)
	appContext := webtest.NewContext(nil, nil, "/api/v1/reports", nil)
	server.spas = []Spa{
		{baseUri: "/assets/*"},
	}

	assert.NoError(t, server.Log(spaContext, webmiddleware.RequestLoggerValues{
		URI: "/assets/app.js", Method: http.MethodGet, Status: http.StatusOK, Latency: time.Millisecond,
	}))
	assert.Empty(t, entries)

	assert.NoError(t, server.Log(spaContext, webmiddleware.RequestLoggerValues{
		URI: "/assets/missing.js", Method: http.MethodGet, Status: http.StatusNotFound, Latency: time.Millisecond,
	}))
	assert.NoError(t, server.Log(appContext, webmiddleware.RequestLoggerValues{
		URI: "/api/v1/reports", Method: http.MethodGet, Status: http.StatusOK, Latency: time.Millisecond,
	}))
	assert.Len(t, entries, 2)

	server.spaAccessLogs = true
	assert.NoError(t, server.Log(spaContext, webmiddleware.RequestLoggerValues{
		URI: "/assets/app.js", Method: http.MethodGet, Status: http.StatusOK, Latency: time.Millisecond,
	}))
	assert.Len(t, entries, 3)
}

