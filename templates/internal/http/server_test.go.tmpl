// TestSuppressRoutineFrameworkAccessLog verifies only successful framework-owned scrapes bypass access logging.
func TestSuppressRoutineFrameworkAccessLog(t *testing.T) {
	tests := []struct {
		name       string
		uri        string
		method     string
		status     int
		requestErr error
		want       bool
	}{
		{name: "successful metrics scrape", uri: "/metrics", method: http.MethodGet, status: http.StatusOK, want: true},
		{name: "successful metrics head", uri: "/metrics", method: http.MethodHead, status: http.StatusNoContent, want: true},
		{name: "failed metrics scrape", uri: "/metrics", method: http.MethodGet, status: http.StatusInternalServerError, want: false},
		{name: "metrics handler error", uri: "/metrics", method: http.MethodGet, status: http.StatusOK, requestErr: errors.New("scrape failed"), want: false},
		{name: "unexpected metrics method", uri: "/metrics", method: http.MethodPost, status: http.StatusMethodNotAllowed, want: false},
		{name: "manual metrics query", uri: "/metrics?debug=true", method: http.MethodGet, status: http.StatusOK, want: false},
		{name: "application request", uri: "/api/v1/reports", method: http.MethodGet, status: http.StatusOK, want: false},
	}
	for _, test := range tests {
		t.Run(test.name, func(t *testing.T) {
			assert.Equal(t, test.want, suppressRoutineFrameworkAccessLog(test.uri, test.method, test.status, test.requestErr))
		})
	}
}

// BenchmarkSuppressRoutineFrameworkAccessLog guards the request hot path against allocations and expensive matching.
func BenchmarkSuppressRoutineFrameworkAccessLog(b *testing.B) {
	b.Run("application_request", func(b *testing.B) {
		uri := benchmarkAccessLogURI("/api/v1/reports")
		b.ReportAllocs()
		for b.Loop() {
			if suppressRoutineFrameworkAccessLog(uri, http.MethodGet, http.StatusOK, nil) {
				b.Fatal("application request was suppressed")
			}
		}
	})
	b.Run("metrics_scrape", func(b *testing.B) {
		uri := benchmarkAccessLogURI("/metrics")
		b.ReportAllocs()
		for b.Loop() {
			if !suppressRoutineFrameworkAccessLog(uri, http.MethodGet, http.StatusOK, nil) {
				b.Fatal("metrics scrape was not suppressed")
			}
		}
	})
}

// benchmarkAccessLogURI prevents constant folding from hiding the real exact-match cost.
func benchmarkAccessLogURI(fallback string) string {
	if value := os.Getenv("GOFORJ_BENCHMARK_ACCESS_LOG_URI"); value != "" {
		return value
	}
	return fallback
}

// TestLogSuppressesOnlyRoutineFrameworkMetricsTraffic verifies the logger boundary preserves failures and application requests.
func TestLogSuppressesOnlyRoutineFrameworkMetricsTraffic(t *testing.T) {
	t.Setenv("APP_LOG_FORMAT", "json")
	t.Setenv("APP_LOG_DEDUPE_ENABLED", "false")
	entries := make([]logger.LogEntry, 0, 2)
	appLogger := logger.NewAppLogger()
	appLogger.AddSink(func(entry logger.LogEntry) {
		entries = append(entries, entry)
	})
	server := &Server{logger: appLogger, httpAccessLogs: true}
	ctx := webtest.NewContext(nil, nil, "/metrics", nil)

	assert.NoError(t, server.Log(ctx, webmiddleware.RequestLoggerValues{
		URI: "/metrics", Method: http.MethodGet, Status: http.StatusOK, Latency: time.Millisecond,
	}))
	assert.Empty(t, entries)

	assert.NoError(t, server.Log(ctx, webmiddleware.RequestLoggerValues{
		URI: "/metrics", Method: http.MethodGet, Status: http.StatusInternalServerError, Latency: time.Millisecond,
	}))
	assert.NoError(t, server.Log(ctx, webmiddleware.RequestLoggerValues{
		URI: "/api/v1/reports", Method: http.MethodGet, Status: http.StatusOK, Latency: time.Millisecond,
	}))
	assert.Len(t, entries, 2)
}
