package http

import (
	"errors"
	"fmt"
	"net/http"
	"os"
	"path/filepath"
	"strings"

	"github.com/goforj/env/v2"
	"github.com/goforj/web"
)

// defaultOpenAPISpecPath keeps the default App artifact compatible with existing GoForj projects.
const defaultOpenAPISpecPath = "build/openapi.json"

// scalarAPIReferenceURL pins the generated UI so a CDN release cannot change application behavior between builds.
const scalarAPIReferenceURL = "https://cdn.jsdelivr.net/npm/@scalar/api-reference@1.62.5"

// swaggerRoutes keeps API documentation opt-out while honoring the legacy environment variable during migration.
func (s *Server) swaggerRoutes() []web.RouteGroup {
	legacyDefault := "true"
	if legacy, ok := os.LookupEnv("SWAGGER_ENABLED"); ok {
		legacyDefault = legacy
	}
	if !env.GetBool("API_SWAGGER_ENABLED", legacyDefault) {
		return nil
	}

	return []web.RouteGroup{
		web.NewRouteGroup(
			"",
			[]web.Route{
				web.NewRoute(http.MethodGet, "/swagger", s.swaggerUIHandler),
				web.NewRoute(http.MethodGet, "/swagger/", s.swaggerUIHandler),
				web.NewRoute(http.MethodGet, "/swagger/doc.json", s.swaggerSpecHandler),
			},
		),
	}
}

// swaggerUIHandler renders Scalar against the App-specific OpenAPI endpoint served by this process.
func (s *Server) swaggerUIHandler(r web.Context) error {
	return r.HTML(http.StatusOK, fmt.Sprintf(`<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>API Reference</title>
</head>
<body>
	<div id="app"></div>
	<script src="%s"></script>
	<script>
		Scalar.createApiReference('#app', {
			url: '/swagger/doc.json',
		})
	</script>
</body>
</html>`, scalarAPIReferenceURL))
}

// swaggerSpecHandler serves only the active App artifact and explains how to create it when absent.
func (s *Server) swaggerSpecHandler(r web.Context) error {
	specPath := os.Getenv("OPENAPI_SPEC_PATH")
	if specPath == "" {
		specPath = defaultOpenAPISpecPathForApp()
	}
	info, err := os.Stat(specPath)
	if errors.Is(err, os.ErrNotExist) {
		return r.JSON(http.StatusNotFound, map[string]string{
			"error": "OpenAPI document is missing",
			"app":   activeOpenAPIAppName(),
			"path":  specPath,
			"hint":  fmt.Sprintf(`Run %q before opening the API reference.`, apiIndexBuildCommandForApp()),
		})
	}
	if err != nil {
		return fmt.Errorf("inspect OpenAPI document %q: %w", specPath, err)
	}
	if info.IsDir() {
		return r.JSON(http.StatusInternalServerError, map[string]string{
			"error": "OpenAPI document path is a directory",
			"app":   activeOpenAPIAppName(),
			"path":  specPath,
		})
	}
	return r.File(specPath)
}

// defaultOpenAPISpecPathForApp maps the process App identity to the artifact layout used by the build pipeline.
func defaultOpenAPISpecPathForApp() string {
	app := activeOpenAPIAppName()
	if app == "" || app == "app" {
		return defaultOpenAPISpecPath
	}
	return filepath.Join("build", app, "openapi.json")
}

// activeOpenAPIAppName normalizes an unset process identity to the conventional default App name.
func activeOpenAPIAppName() string {
	app := strings.TrimSpace(os.Getenv("FORJ_APP"))
	if !isSafeOpenAPIAppName(app) {
		return "app"
	}
	return app
}

// isSafeOpenAPIAppName keeps implicit App selection inside the generated build directory; OPENAPI_SPEC_PATH remains the explicit path override.
func isSafeOpenAPIAppName(name string) bool {
	if name == "" || name == "." || name == ".." || strings.HasPrefix(name, "-") || strings.HasSuffix(name, "-") {
		return false
	}
	previousWasSeparator := false
	for index, character := range name {
		if character >= 'a' && character <= 'z' {
			previousWasSeparator = false
			continue
		}
		if index > 0 && character >= '0' && character <= '9' {
			previousWasSeparator = false
			continue
		}
		if character == '-' && !previousWasSeparator {
			previousWasSeparator = true
			continue
		}
		return false
	}
	return true
}

// apiIndexBuildCommandForApp gives additional apps a command users can run directly from the project root.
func apiIndexBuildCommandForApp() string {
	app := activeOpenAPIAppName()
	if app == "app" {
		return "forj build:api-index"
	}
	return "forj " + app + " build:api-index"
}
