// TestSwaggerRoutesDisabledByEnv verifies the current opt-out hides both the UI and its document endpoint.
func TestSwaggerRoutesDisabledByEnv(t *testing.T) {
	t.Setenv("API_SWAGGER_ENABLED", "false")

	e := bootstrapSwaggerTestServer(t)

	for _, path := range []string{"/swagger", "/swagger/", "/swagger/doc.json"} {
		t.Run(path, func(t *testing.T) {
			req := httptest.NewRequest(http.MethodGet, path, nil)
			rec := httptest.NewRecorder()
			e.ServeHTTP(rec, req)
			assert.Equal(t, http.StatusNotFound, rec.Code)
		})
	}
}

// TestSwaggerRoutesRespectsLegacyEnvWhenNewEnvMissing verifies old projects retain their documented opt-out.
func TestSwaggerRoutesRespectsLegacyEnvWhenNewEnvMissing(t *testing.T) {
