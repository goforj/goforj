// TestSwaggerSpecPreservesPathOverride verifies an explicit artifact path wins over every App-derived default.
func TestSwaggerSpecPreservesPathOverride(t *testing.T) {
	t.Setenv("API_SWAGGER_ENABLED", "true")
	t.Setenv("FORJ_APP", "customer-portal")

	root := t.TempDir()
	overridePath := filepath.Join(root, "custom", "selected-openapi.json")
	t.Setenv("OPENAPI_SPEC_PATH", overridePath)
	writeSwaggerTestSpec(t, filepath.Join(root, "build", "openapi.json"), `{"openapi":"3.0.3","paths":{"/wrong-default":{}}}`)
	writeSwaggerTestSpec(t, filepath.Join(root, "build", "customer-portal", "openapi.json"), `{"openapi":"3.0.3","paths":{"/wrong-selected":{}}}`)
	writeSwaggerTestSpec(t, overridePath, `{"openapi":"3.0.3","paths":{"/override":{}}}`)
	useSwaggerTestWorkingDirectory(t, root)
	e := bootstrapSwaggerTestServer(t)

	req := httptest.NewRequest(http.MethodGet, "/swagger/doc.json", nil)
	rec := httptest.NewRecorder()
	e.ServeHTTP(rec, req)
	require.Equal(t, http.StatusOK, rec.Code)
	assert.JSONEq(t, `{"openapi":"3.0.3","paths":{"/override":{}}}`, rec.Body.String())
	assert.NotContains(t, rec.Body.String(), "/wrong-default")
	assert.NotContains(t, rec.Body.String(), "/wrong-selected")
}

// TestSwaggerSpecMissingDoesNotFallBack verifies a stale default artifact cannot masquerade as the selected app document.
func TestSwaggerSpecMissingDoesNotFallBack(t *testing.T) {
	t.Setenv("API_SWAGGER_ENABLED", "true")
	t.Setenv("FORJ_APP", "customer-portal")
	t.Setenv("OPENAPI_SPEC_PATH", "")

	root := t.TempDir()
	writeSwaggerTestSpec(t, filepath.Join(root, "build", "openapi.json"), `{"openapi":"3.0.3","paths":{"/wrong-default":{}}}`)
	useSwaggerTestWorkingDirectory(t, root)
	e := bootstrapSwaggerTestServer(t)

	req := httptest.NewRequest(http.MethodGet, "/swagger/doc.json", nil)
	rec := httptest.NewRecorder()
	e.ServeHTTP(rec, req)
	require.Equal(t, http.StatusNotFound, rec.Code)
	assert.Contains(t, rec.Header().Get("Content-Type"), "application/json")
	assert.JSONEq(t, `{
		"error":"OpenAPI document is missing",
		"app":"customer-portal",
		"path":"build/customer-portal/openapi.json",
		"hint":"Run \"forj customer-portal build:api-index\" before opening the API reference."
	}`, rec.Body.String())
	assert.NotContains(t, rec.Body.String(), "/wrong-default")
}

