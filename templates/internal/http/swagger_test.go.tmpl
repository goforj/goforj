// bootstrapSwaggerTestServer centralizes framework setup so route assertions stay focused on Swagger behavior.
func bootstrapSwaggerTestServer(t *testing.T) http.Handler {
	t.Helper()
	s := NewServer(logger.NewSilentLogger(), runtime.NewTimeouts(), nil, []ReadinessCheck{}, nil,{{- if .ProjectComponents.Storage }} nil,{{- end }} nil{{- if .ProjectComponents.Metrics }}, metrics.NewManager(){{- end }})
	e, err := s.bootstrap("")
	require.NoError(t, err)
	return e
}

// writeSwaggerTestSpec keeps competing App fixtures explicit in tests that guard against cross-App fallback.
func writeSwaggerTestSpec(t *testing.T, path string, body string) {
	t.Helper()
	require.NoError(t, os.MkdirAll(filepath.Dir(path), 0o755))
	require.NoError(t, os.WriteFile(path, []byte(body), 0o644))
}

// useSwaggerTestWorkingDirectory makes relative build artifacts behave exactly as they do in a launched project.
func useSwaggerTestWorkingDirectory(t *testing.T, root string) {
	t.Helper()
	wd, err := os.Getwd()
	require.NoError(t, err)
	require.NoError(t, os.Chdir(root))
	t.Cleanup(func() {
		require.NoError(t, os.Chdir(wd))
	})
}

// unsetSwaggerTestEnv preserves absence semantics needed to exercise the legacy fallback branch.
func unsetSwaggerTestEnv(t *testing.T, name string) {
	t.Helper()
	value, exists := os.LookupEnv(name)
	require.NoError(t, os.Unsetenv(name))
	t.Cleanup(func() {
		if exists {
			require.NoError(t, os.Setenv(name, value))
			return
		}
		require.NoError(t, os.Unsetenv(name))
	})
}
