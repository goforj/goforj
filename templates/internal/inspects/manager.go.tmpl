type inspectContext struct {
	context.Context
	source   app.Source
	recorder *Recorder
}

func (c *inspectContext) AppSource() app.Source {
	if c == nil {
		return ""
	}
	return c.source
}

func (c *inspectContext) InspectRecorder() *Recorder {
	if c == nil {
		return nil
	}
	return c.recorder
}

func (c *inspectContext) Value(key any) any {
	switch key {
	case recorderContextKey{}:
		return c.recorder
	case inspectIDContextKey{}:
		if c.recorder == nil {
			return ""
		}
		return c.recorder.inspectID
	default:
		return c.Context.Value(key)
	}
}

