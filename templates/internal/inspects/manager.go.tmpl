// RecordEvent appends a normalized inspect event.
func (r *Recorder) RecordEvent(event InspectEvent) {
	if r == nil || r.manager == nil || !r.manager.Enabled() {
		return
	}
	_ = r.manager.appendEvent(context.Background(), r.inspectID, event)
}

// Finish finalizes the inspect and records terminal error details when present.
func (r *Recorder) Finish(status string, err error) {
	if r == nil || r.manager == nil || !r.manager.Enabled() {
		return
	}
	r.once.Do(func() {
		_ = r.manager.finishRecord(context.Background(), r.inspectID, normalizeStatus(status, err), err)
	})
}

func (m *Manager) beginRecord(ctx context.Context, recorder *Recorder) error {
	record := Record{
		Summary: InspectSummary{
			TraceID:   recorder.inspectID,
			Source:    recorder.source.String(),
			Name:      recorder.name,
			Status:    statusRunning,
			StartedAt: m.now(),
			UpdatedAt: m.now(),
			Labels:    cloneStringMap(recorder.labels),
		},
		Events: []InspectEvent{},
	}
	if err := m.setRecord(ctx, record); err != nil {
		return err
	}
	return m.upsertRecent(ctx, record.Summary)
}

func (m *Manager) appendEvent(ctx context.Context, inspectID string, event InspectEvent) error {
	inspectID = strings.TrimSpace(inspectID)
	if inspectID == "" || !m.Enabled() {
		return nil
	}
	return m.withLock(ctx, inspectID, func(cache *goforjcache.Cache) error {
		record, ok, err := goforjcache.Get[Record](cache, inspectRecordKey(inspectID))
		if err != nil {
			return err
		}
		if !ok {
			return nil
		}
		record.Summary.EventCount++
		record.Summary.UpdatedAt = m.now()
		event.Seq = int64(record.Summary.EventCount)
		if event.At.IsZero() {
			event.At = m.now()
		}
		record.Events = append(record.Events, event)
		if len(record.Events) > m.config.MaxEvents {
			record.Events = append([]InspectEvent(nil), record.Events[len(record.Events)-m.config.MaxEvents:]...)
		}
		if err := m.setRecordWithCache(cache, record); err != nil {
			return err
		}
		return m.upsertRecentWithCache(cache, record.Summary)
	})
}

func (m *Manager) finishRecord(ctx context.Context, inspectID, status string, err error) error {
	inspectID = strings.TrimSpace(inspectID)
	if inspectID == "" || !m.Enabled() {
		return nil
	}
	return m.withLock(ctx, inspectID, func(cache *goforjcache.Cache) error {
		record, ok, getErr := goforjcache.Get[Record](cache, inspectRecordKey(inspectID))
		if getErr != nil {
			return getErr
		}
		if !ok {
			return nil
		}
		if err != nil {
			record.Summary.EventCount++
			record.Events = append(record.Events, InspectEvent{
				Seq:     int64(record.Summary.EventCount),
				At:      m.now(),
				Kind:    EventKindError,
				Message: err.Error(),
				Status:  statusError,
			})
			if len(record.Events) > m.config.MaxEvents {
				record.Events = append([]InspectEvent(nil), record.Events[len(record.Events)-m.config.MaxEvents:]...)
			}
		}
		now := m.now()
		record.Summary.Status = normalizeStatus(status, err)
		record.Summary.UpdatedAt = now
		record.Summary.EndedAt = now
		record.Summary.DurationMS = maxInt64(0, now.Sub(record.Summary.StartedAt).Milliseconds())
		if setErr := m.setRecordWithCache(cache, record); setErr != nil {
			return setErr
		}
		return m.upsertRecentWithCache(cache, record.Summary)
	})
}

func (m *Manager) setRecord(ctx context.Context, record Record) error {
	return m.setRecordWithCache(m.internalCache(ctx), record)
}

func (m *Manager) setRecordWithCache(cache *goforjcache.Cache, record Record) error {
	return goforjcache.Set(cache, inspectRecordKey(record.Summary.TraceID), record, m.config.TTL)
}

func (m *Manager) upsertRecent(ctx context.Context, summary InspectSummary) error {
	return m.withIndexLock(ctx, func(cache *goforjcache.Cache) error {
		return m.upsertRecentLists(cache, summary)
	})
}

func (m *Manager) upsertRecentWithCache(cache *goforjcache.Cache, summary InspectSummary) error {
	return m.upsertRecentLists(cache, summary)
}

func (m *Manager) upsertRecentLists(cache *goforjcache.Cache, summary InspectSummary) error {
	all, _, err := goforjcache.Get[[]InspectSummary](cache, inspectRecentKey)
	if err != nil {
		return err
	}
	all, dropped := upsertSummary(all, summary, m.config.Max)
	if err := goforjcache.Set(cache, inspectRecentKey, all, m.config.TTL); err != nil {
		return err
	}
	if err := m.pruneDroppedSummaries(cache, dropped); err != nil {
		return err
	}
	if strings.TrimSpace(summary.Source) == "" {
		return nil
	}
	sourceKey := inspectRecentBySourcePrefix + summary.Source
	bySource, _, err := goforjcache.Get[[]InspectSummary](cache, sourceKey)
	if err != nil {
		return err
	}
	bySource, _ = upsertSummary(bySource, summary, m.config.MaxPerSource)
	return goforjcache.Set(cache, sourceKey, bySource, m.config.TTL)
}

func (m *Manager) pruneDroppedSummaries(cache *goforjcache.Cache, dropped []InspectSummary) error {
	if len(dropped) == 0 {
		return nil
	}
	seenSources := make(map[string]struct{}, len(dropped))
	for _, summary := range dropped {
		inspectID := strings.TrimSpace(summary.TraceID)
		if inspectID == "" {
			continue
		}
		if err := cache.Delete(inspectRecordKey(inspectID)); err != nil {
			return err
		}
		source := strings.TrimSpace(summary.Source)
		if source != "" {
			seenSources[source] = struct{}{}
		}
	}
	for source := range seenSources {
		sourceKey := inspectRecentBySourcePrefix + source
		bySource, _, err := goforjcache.Get[[]InspectSummary](cache, sourceKey)
		if err != nil {
			return err
		}
		trimmed := removeSummaries(bySource, dropped)
		if len(trimmed) == 0 {
			if err := cache.Delete(sourceKey); err != nil {
				return err
			}
			continue
		}
		if err := goforjcache.Set(cache, sourceKey, trimmed, m.config.TTL); err != nil {
			return err
		}
	}
	return nil
}

func (m *Manager) withLock(ctx context.Context, inspectID string, fn func(*goforjcache.Cache) error) error {
	cache := m.internalCache(ctx)
	locked, err := cache.Lock(inspectLockPrefix+inspectID, inspectLockTTL, inspectLockTimeout)
	if err != nil || !locked {
		if err != nil {
			return err
		}
		return errors.New("inspect lock not acquired")
	}
	defer func() { _ = cache.Unlock(inspectLockPrefix + inspectID) }()
	return fn(cache)
}

func (m *Manager) withIndexLock(ctx context.Context, fn func(*goforjcache.Cache) error) error {
	cache := m.internalCache(ctx)
	locked, err := cache.Lock(inspectLockPrefix+"recent", inspectLockTTL, inspectLockTimeout)
	if err != nil || !locked {
		if err != nil {
			return err
		}
		return errors.New("inspect index lock not acquired")
	}
	defer func() { _ = cache.Unlock(inspectLockPrefix + "recent") }()
	return fn(cache)
}

func (m *Manager) internalCache(ctx context.Context) *goforjcache.Cache {
	return m.cache.WithContext(WithInternalContext(ctx))
}

func inspectRecordKey(inspectID string) string {
	return inspectRecordKeyPrefix + strings.TrimSpace(inspectID)
}

func upsertSummary(list []InspectSummary, summary InspectSummary, limit int) ([]InspectSummary, []InspectSummary) {
	out := make([]InspectSummary, 0, len(list)+1)
	dropped := make([]InspectSummary, 0)
	out = append(out, summary)
	for _, item := range list {
		if item.TraceID == summary.TraceID {
			continue
		}
		if limit > 0 && len(out) >= limit {
			dropped = append(dropped, item)
			continue
		}
		out = append(out, item)
	}
	return out, dropped
}

func removeSummaries(list []InspectSummary, dropped []InspectSummary) []InspectSummary {
	if len(list) == 0 || len(dropped) == 0 {
		return append([]InspectSummary(nil), list...)
	}
	droppedIDs := make(map[string]struct{}, len(dropped))
	for _, item := range dropped {
		inspectID := strings.TrimSpace(item.TraceID)
		if inspectID == "" {
			continue
		}
		droppedIDs[inspectID] = struct{}{}
	}
	out := make([]InspectSummary, 0, len(list))
	for _, item := range list {
		if _, ok := droppedIDs[strings.TrimSpace(item.TraceID)]; ok {
			continue
		}
		out = append(out, item)
	}
	return out
}

func normalizeInspectName(name string) string {
	name = strings.TrimSpace(name)
	if name == "" {
		return defaultInspectName
	}
	return name
}

func normalizeStatus(status string, err error) string {
	switch {
	case err != nil && errors.Is(err, context.Canceled):
		return statusCanceled
	case err != nil:
		return statusError
	}
	status = strings.ToLower(strings.TrimSpace(status))
	switch status {
	case statusOK, statusError, statusCanceled, statusRunning:
		return status
	case "":
		return statusOK
	default:
		return status
	}
}

func statusFromError(err error) string {
	return normalizeStatus("", err)
}

func normalizeStatusFromHTTP(status int) string {
	if status >= 500 {
		return statusError
	}
	if status >= 400 {
		return "warning"
	}
	return statusOK
}

func durationMS(d time.Duration) int64 {
	if d <= 0 {
		return 0
	}
	return d.Milliseconds()
}

func durationNS(d time.Duration) int64 {
	if d <= 0 {
		return 0
	}
	return d.Nanoseconds()
}

func newInspectID() string {
	buf := make([]byte, 16)
	if _, err := rand.Read(buf); err != nil {
		return hex.EncodeToString([]byte(time.Now().Format(time.RFC3339Nano)))
	}
	return hex.EncodeToString(buf)
}

func cloneStringMap(in map[string]string) map[string]string {
	if len(in) == 0 {
		return nil
	}
	out := make(map[string]string, len(in))
	for key, value := range in {
		out[key] = value
	}
	return out
}

func cloneAnyMap(in map[string]any) map[string]any {
	if len(in) == 0 {
		return nil
	}
	out := make(map[string]any, len(in))
	for key, value := range in {
		out[key] = value
	}
	return out
}

func maxInt64(a, b int64) int64 {
	if a > b {
		return a
	}
	return b
}
