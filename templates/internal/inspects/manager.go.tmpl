)

type inspectIDContextKey struct{}
type recorderContextKey struct{}
type internalContextKey struct{}

// EventKind classifies a normalized inspect event.
type EventKind string

const (
	EventKindLog        EventKind = "log"
	EventKindCache      EventKind = "cache"
	EventKindStorage    EventKind = "storage"
	EventKindEventBus   EventKind = "event"
	EventKindMail       EventKind = "mail"
	EventKindQueue      EventKind = "queue"
	EventKindQuery      EventKind = "query"
	EventKindHTTP       EventKind = "http"
	EventKindError      EventKind = "error"
	EventKindAnnotation EventKind = "annotation"
)

const (
	statusRunning  = "running"
	statusOK       = "ok"
	statusError    = "error"
	statusCanceled = "canceled"
)

const (
	inspectRecordKeyPrefix      = "lighthouse:inspect:record:"
	inspectRecentKey            = "lighthouse:inspect:recent"
	inspectRecentBySourcePrefix = "lighthouse:inspect:recent:source:"
	inspectLockPrefix           = "lighthouse:inspect:lock:"
	defaultInspectName          = "inspect"
	defaultInspectTTL           = time.Hour
	defaultInspectMax           = 250
	defaultInspectMaxPerSource  = 50
	defaultInspectMaxEvents     = 200
	inspectLockTTL              = 5 * time.Second
	inspectLockTimeout          = 2 * time.Second
)

// Config controls inspect capture retention and storage behavior.
type Config struct {
	Enabled      bool
	Max          int
	MaxPerSource int
	MaxEvents    int
	TTL          time.Duration
}

// InspectSummary is the list-friendly view of an inspect record.
type InspectSummary struct {
	TraceID    string            `json:"trace_id"`
	Source     string            `json:"source"`
	Name       string            `json:"name"`
	Status     string            `json:"status"`
	StartedAt  time.Time         `json:"started_at"`
	UpdatedAt  time.Time         `json:"updated_at"`
	EndedAt    time.Time         `json:"ended_at,omitempty"`
	DurationMS int64             `json:"duration_ms,omitempty"`
	EventCount int               `json:"event_count"`
	Labels     map[string]string `json:"labels,omitempty"`
}

// InspectEvent is a normalized event captured within an inspect.
type InspectEvent struct {
	Seq        int64          `json:"seq"`
	At         time.Time      `json:"at"`
	Kind       EventKind      `json:"kind"`
	Level      string         `json:"level,omitempty"`
	Name       string         `json:"name,omitempty"`
	Message    string         `json:"message,omitempty"`
	Status     string         `json:"status,omitempty"`
	Attributes map[string]any `json:"attributes,omitempty"`
}

// Record is the persisted inspect document.
type Record struct {
	Summary InspectSummary `json:"summary"`
	Events  []InspectEvent `json:"events"`
}

// RecentQuery controls recent-inspect lookup.
type RecentQuery struct {
	Source app.Source
	Limit  int
}

// Manager owns inspect capture and a cache-backed inspect store.
type Manager struct {
	cache  *goforjcache.Cache
	config Config
	now    func() time.Time
}

// Recorder is the lightweight execution-scoped inspect handle.
type Recorder struct {
	manager *Manager
	inspectID string
	source  app.Source
	name    string
	labels  map[string]string
	once    sync.Once
}

// NewConfig resolves inspect config from env.
func NewConfig() Config {
	enabledDefault := env.GetBool("LIGHTHOUSE_ENABLED", "false")
	enabled := env.GetBool("LIGHTHOUSE_INSPECT_ENABLED", "")
	if strings.TrimSpace(env.Get("LIGHTHOUSE_INSPECT_ENABLED", "")) == "" {
		enabled = enabledDefault
	}
	cfg := Config{
		Enabled:      enabled,
		Max:          env.GetInt("LIGHTHOUSE_INSPECT_MAX", "250"),
		MaxPerSource: env.GetInt("LIGHTHOUSE_INSPECT_MAX_PER_SOURCE", "50"),
		MaxEvents:    env.GetInt("LIGHTHOUSE_INSPECT_MAX_EVENTS", "200"),
		TTL:          env.GetDuration("LIGHTHOUSE_INSPECT_TTL", "1h"),
	}
	if cfg.Max <= 0 {
		cfg.Max = defaultInspectMax
	}
	if cfg.MaxPerSource <= 0 {
		cfg.MaxPerSource = defaultInspectMaxPerSource
	}
	if cfg.MaxEvents <= 0 {
		cfg.MaxEvents = defaultInspectMaxEvents
	}
	if cfg.TTL <= 0 {
		cfg.TTL = defaultInspectTTL
	}
	return cfg
}

// NewManager creates a new inspect manager for the provided cache.
func NewManager(store *goforjcache.Cache) *Manager {
	return &Manager{
		cache:  store,
		config: NewConfig(),
		now:    time.Now,
	}
}

// Enabled reports whether inspect capture is active.
func (m *Manager) Enabled() bool {
	return m != nil && m.cache != nil && m.config.Enabled
}

// WithInspectID annotates ctx with inspectID.
func WithInspectID(ctx context.Context, inspectID string) context.Context {
	if ctx == nil {
		ctx = context.Background()
	}
	inspectID = strings.TrimSpace(inspectID)
	if inspectID == "" {
		return ctx
	}
	return context.WithValue(ctx, inspectIDContextKey{}, inspectID)
}

// InspectIDFromContext returns the inspect id bound to ctx.
func InspectIDFromContext(ctx context.Context) string {
	if ctx == nil {
		return ""
	}
	inspectID, _ := ctx.Value(inspectIDContextKey{}).(string)
	return strings.TrimSpace(inspectID)
}

// WithRecorder binds a recorder handle to ctx.
func WithRecorder(ctx context.Context, recorder *Recorder) context.Context {
	if ctx == nil {
		ctx = context.Background()
	}
	if recorder == nil {
		return ctx
	}
	return context.WithValue(ctx, recorderContextKey{}, recorder)
}

// RecorderFromContext returns the recorder attached to ctx.
func RecorderFromContext(ctx context.Context) *Recorder {
	if ctx == nil {
		return nil
	}
	recorder, _ := ctx.Value(recorderContextKey{}).(*Recorder)
	return recorder
}

// WithInternalContext marks ctx as an internal inspect-store operation.
func WithInternalContext(ctx context.Context) context.Context {
	if ctx == nil {
		ctx = context.Background()
	}
	return context.WithValue(ctx, internalContextKey{}, true)
}

// IsInternalContext reports whether ctx is reserved for internal inspect-store operations.
func IsInternalContext(ctx context.Context) bool {
	if ctx == nil {
		return false
	}
	internal, _ := ctx.Value(internalContextKey{}).(bool)
	return internal
}

// Begin starts an inspect for the current execution boundary and returns a derived context.
func (m *Manager) Begin(ctx context.Context, source app.Source, name string, labels map[string]string) context.Context {
	if ctx == nil {
		ctx = context.Background()
	}
	if !m.Enabled() {
		return ctx
	}
	if existing := RecorderFromContext(ctx); existing != nil {
		return WithInspectID(ctx, existing.inspectID)
	}
	if source == "" {
		source = app.SourceFromContext(ctx)
	}
	if source == "" {
		source = app.SourceApp
	}
	inspectID := InspectIDFromContext(ctx)
	if inspectID == "" {
		inspectID = newInspectID()
	}
	recorder := &Recorder{
		manager: m,
		inspectID: inspectID,
		source:  source,
		name:    normalizeInspectName(name),
		labels:  cloneStringMap(labels),
	}
	_ = m.beginRecord(ctx, recorder)
	ctx = WithInspectID(ctx, inspectID)
	return WithRecorder(ctx, recorder)
}

// Finish finalizes the active inspect in ctx when one exists.
func (m *Manager) Finish(ctx context.Context, status string, err error) {
	recorder := RecorderFromContext(ctx)
	if recorder == nil {
		return
	}
	recorder.Finish(status, err)
}

// Recent returns recent inspect summaries ordered by most recently updated first.
func (m *Manager) Recent(ctx context.Context, query RecentQuery) ([]InspectSummary, error) {
	if !m.Enabled() {
		return []InspectSummary{}, nil
	}
	key := inspectRecentKey
	if query.Source != "" {
		key = inspectRecentBySourcePrefix + query.Source.String()
	}
	list, ok, err := goforjcache.Get[[]InspectSummary](m.internalCache(ctx), key)
	if err != nil || !ok {
		if err != nil {
			return nil, err
		}
		return []InspectSummary{}, nil
	}
	limit := query.Limit
	if limit <= 0 || limit > len(list) {
		limit = len(list)
	}
	return append([]InspectSummary(nil), list[:limit]...), nil
}

// ByID returns a full inspect record by id.
func (m *Manager) ByID(ctx context.Context, inspectID string) (Record, bool, error) {
	if !m.Enabled() {
		return Record{}, false, nil
	}
	inspectID = strings.TrimSpace(inspectID)
	if inspectID == "" {
		return Record{}, false, nil
	}
	record, ok, err := goforjcache.Get[Record](m.internalCache(ctx), inspectRecordKey(inspectID))
	if err != nil || !ok {
		return Record{}, ok, err
	}
	return record, true, nil
}

// InspectID returns the recorder inspect id.
func (r *Recorder) InspectID() string {
	if r == nil {
		return ""
	}
	return r.inspectID
}

// RecordLog appends a normalized log event to the current inspect.
func (m *Manager) RecordLog(ctx context.Context, level, message string, fields map[string]any) {
	recorder := RecorderFromContext(ctx)
	event := InspectEvent{
		Kind:    EventKindLog,
		Level:   strings.ToLower(strings.TrimSpace(level)),
		Message: strings.TrimSpace(message),
		Attributes: cloneAnyMap(fields),
	}
	if recorder != nil {
		recorder.RecordEvent(event)
		return
	}
	inspectID := InspectIDFromContext(ctx)
	if inspectID == "" {
		return
	}
	_ = m.appendEvent(context.Background(), inspectID, event)
}

// RecordCacheEvent appends a normalized cache event to the current inspect.
func (m *Manager) RecordCacheEvent(ctx context.Context, name, op, driver string, hit bool, err error, dur time.Duration) {
	recorder := RecorderFromContext(ctx)
	if recorder == nil {
		return
	}
	attrs := map[string]any{
		"cache":       strings.TrimSpace(name),
		"operation":   strings.TrimSpace(op),
		"driver":      strings.TrimSpace(driver),
		"hit":         hit,
		"duration_ms": durationMS(dur),
		"duration_ns": durationNS(dur),
	}
	if err != nil {
		attrs["error"] = err.Error()
	}
	recorder.RecordEvent(InspectEvent{
		Kind:       EventKindCache,
		Name:       strings.TrimSpace(op),
		Status:     statusFromError(err),
		Message:    "cache operation",
		Attributes: attrs,
	})
}

