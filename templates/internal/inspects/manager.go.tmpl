	recorder := RecorderFromContext(ctx)
	if recorder == nil {
		return
	}
	recorder.RecordEvent(InspectEvent{
		Kind:    EventKindHTTP,
		Name:    "http_exchange",
		Status:  normalizeStatusFromHTTP(event.ResponseStatus),
		Message: "http exchange",
		HTTP: &HTTPExchange{
			Method:            strings.TrimSpace(event.Method),
			Scheme:            strings.TrimSpace(event.Scheme),
			Host:              strings.TrimSpace(event.Host),
			URI:               strings.TrimSpace(event.URI),
			RequestBody:       event.RequestBody,
			RequestHeadersRaw: event.RequestHeadersRaw,
			RequestBodyRaw:    event.RequestBodyRaw,
			ResponseStatus:    event.ResponseStatus,
			ResponseHeaders:   event.ResponseHeaders,
			ResponseBody:      event.ResponseBody,
		},
	})
}

// RecordEvent appends a normalized inspect event.
func (r *Recorder) RecordEvent(event InspectEvent) {
	if r == nil || r.manager == nil || !r.manager.Enabled() {
		return
	}
	if r.state != nil && r.manager.appendEvent(r.state, event) {
		return
	}
	_ = r.manager.recordEventByInspectID(context.Background(), r.inspectID, event)
}

// Finish finalizes the inspect and records terminal error details when present.
func (r *Recorder) Finish(status string, err error) {
	if r == nil || r.manager == nil || !r.manager.Enabled() {
		return
	}
	r.once.Do(func() {
		if r.state != nil {
			_ = r.manager.finishState(context.Background(), r.inspectID, r.state, normalizeStatus(status, err), err)
			r.state = nil
			return
		}
		_ = r.manager.finishRecord(context.Background(), r.inspectID, normalizeStatus(status, err), err)
	})
}

func (m *Manager) beginRecord(recorder *Recorder) *inflightInspect {
	now := m.now()
	record := Record{
		Summary: InspectSummary{
			TraceID:   recorder.inspectID,
			Source:    recorder.source.String(),
			Name:      recorder.name,
			Status:    statusRunning,
			StartedAt: now,
			UpdatedAt: now,
			Labels:    cloneStringMap(recorder.labels),
		},
		Events: make([]InspectEvent, 0, 1),
	}
	state := inflightInspectPool.Get().(*inflightInspect)
	state.record = record
	state.finished = false
	state.indexed = recorder.source != app.SourceHTTP
	if state.indexed {
		m.inflightMu.Lock()
		m.inflight[recorder.inspectID] = state
		m.inflightMu.Unlock()
	}
	return state
}

func (m *Manager) recordEventByInspectID(ctx context.Context, inspectID string, event InspectEvent) error {
	inspectID = strings.TrimSpace(inspectID)
	if inspectID == "" || !m.Enabled() {
		return nil
	}
	if appended := m.appendEventToInflight(inspectID, event); appended {
		return nil
	}
	return nil
}

func (m *Manager) appendEventToInflight(inspectID string, event InspectEvent) bool {
	m.inflightMu.RLock()
	state := m.inflight[inspectID]
	m.inflightMu.RUnlock()
	if state == nil {
		return false
	}
	return m.appendEvent(state, event)
}

func (m *Manager) appendEvent(state *inflightInspect, event InspectEvent) bool {
	state.mu.Lock()
	defer state.mu.Unlock()
	if state.finished {
		return false
	}
	state.record.Summary.EventCount++
	state.record.Summary.UpdatedAt = m.now()
	event.Seq = int64(state.record.Summary.EventCount)
	if event.At.IsZero() {
		event.At = m.now()
	}
	state.record.Events = append(state.record.Events, event)
	if len(state.record.Events) > m.config.MaxEvents {
		state.record.Events = append([]InspectEvent(nil), state.record.Events[len(state.record.Events)-m.config.MaxEvents:]...)
	}
	return true
}

func (m *Manager) finishRecord(ctx context.Context, inspectID, status string, err error) error {
	inspectID = strings.TrimSpace(inspectID)
	if inspectID == "" || !m.Enabled() {
		return nil
	}
	m.inflightMu.RLock()
	state := m.inflight[inspectID]
	m.inflightMu.RUnlock()
	if state == nil {
		return nil
	}
	return m.finishState(ctx, inspectID, state, status, err)
}

func (m *Manager) finishState(ctx context.Context, inspectID string, state *inflightInspect, status string, err error) error {
	state.mu.Lock()
	if state.finished {
		state.mu.Unlock()
		return nil
	}
	state.finished = true
	if err != nil {
		state.record.Summary.EventCount++
		state.record.Events = append(state.record.Events, InspectEvent{
			Seq:     int64(state.record.Summary.EventCount),
			At:      m.now(),
			Kind:    EventKindError,
			Message: err.Error(),
			Status:  statusError,
		})
		if len(state.record.Events) > m.config.MaxEvents {
			state.record.Events = append([]InspectEvent(nil), state.record.Events[len(state.record.Events)-m.config.MaxEvents:]...)
		}
	}
	now := m.now()
	state.record.Summary.Status = normalizeStatus(status, err)
	state.record.Summary.UpdatedAt = now
	state.record.Summary.EndedAt = now
	state.record.Summary.DurationMS = maxInt64(0, now.Sub(state.record.Summary.StartedAt).Milliseconds())
	record := normalizeRecord(state.record)
	persistErr := m.persistFinishedRecord(ctx, record)
	state.mu.Unlock()
	if persistErr != nil {
		return persistErr
	}
	if state.indexed {
		m.inflightMu.Lock()
		delete(m.inflight, inspectID)
		m.inflightMu.Unlock()
	}
	releaseInflightInspect(state)
	m.releaseInflight()
	return nil
}

func (m *Manager) persistFinishedRecord(ctx context.Context, record Record) error {
	publisher, publishOnly := m.publishModeSnapshot()
	if publishOnly {
		if publisher != nil {
			publisher.Publish(record)
		}
		return nil
	}
	return m.withLock(ctx, record.Summary.TraceID, func(cache *goforjcache.Cache) error {
		if err := m.setRecordWithCache(cache, record); err != nil {
			return err
		}
		if err := m.upsertRecentWithCache(cache, record.Summary); err != nil {
			return err
		}
		if publisher != nil {
			publisher.Publish(record)
		}
		return nil
	})
}

func (m *Manager) setRecord(ctx context.Context, record Record) error {
	return m.setRecordWithCache(m.internalCache(ctx), record)
}

func (m *Manager) setRecordWithCache(cache *goforjcache.Cache, record Record) error {
	if err := goforjcache.Set(cache, inspectSummaryKey(record.Summary.TraceID), record.Summary, inspectStorageTTL); err != nil {
		return err
	}
	return goforjcache.Set(cache, inspectEventsKey(record.Summary.TraceID), record.Events, inspectStorageTTL)
}

func (m *Manager) upsertRecentWithCache(cache *goforjcache.Cache, summary InspectSummary) error {
	return m.withCacheIndexLock(cache, func(lockedCache *goforjcache.Cache) error {
		return m.upsertRecentSlots(lockedCache, summary)
	})
}

func (m *Manager) withLock(ctx context.Context, inspectID string, fn func(*goforjcache.Cache) error) error {
	cache := m.internalCache(ctx)
	locked, err := cache.Lock(inspectLockPrefix+inspectID, inspectLockTTL, inspectLockTimeout)
	if err != nil || !locked {
		if err != nil {
			return err
		}
		return errors.New("inspect lock not acquired")
	}
	defer func() { _ = cache.Unlock(inspectLockPrefix + inspectID) }()
	return fn(cache)
}

func (m *Manager) withCacheIndexLock(cache *goforjcache.Cache, fn func(*goforjcache.Cache) error) error {
	locked, err := cache.Lock(inspectLockPrefix+"recent", inspectLockTTL, inspectLockTimeout)
	if err != nil || !locked {
		if err != nil {
			return err
		}
		return errors.New("inspect index lock not acquired")
	}
	defer func() { _ = cache.Unlock(inspectLockPrefix + "recent") }()
	return fn(cache)
}

func (m *Manager) internalCache(ctx context.Context) *goforjcache.Cache {
	return m.cache.WithContext(WithInternalContext(ctx))
}

func inspectRecordKey(inspectID string) string {
	return inspectRecordKeyPrefix + strings.TrimSpace(inspectID)
}

func inspectSummaryKey(inspectID string) string {
	return inspectSummaryKeyPrefix + strings.TrimSpace(inspectID)
}

func inspectEventsKey(inspectID string) string {
	return inspectEventsKeyPrefix + strings.TrimSpace(inspectID)
}

func inspectSlotTraceKey(slot int) string {
	return inspectSlotTracePrefix + strconv.Itoa(slot)
}

func inspectSlotIndexKey(inspectID string) string {
	return inspectSlotIndexPrefix + strings.TrimSpace(inspectID)
}

func (m *Manager) upsertRecentSlots(cache *goforjcache.Cache, summary InspectSummary) error {
	inspectID := strings.TrimSpace(summary.TraceID)
	if inspectID == "" {
		return nil
	}
	if m.config.MaxTotal <= 0 {
		return nil
	}
	cursor, _, err := goforjcache.Get[int64](cache, inspectCursorKey)
	if err != nil {
		return err
	}
	slot := int(cursor % int64(m.config.MaxTotal))
	existingTrace, _, err := goforjcache.Get[string](cache, inspectSlotTraceKey(slot))
	if err != nil {
		return err
	}
	if currentSlot, ok, err := goforjcache.Get[int](cache, inspectSlotIndexKey(inspectID)); err != nil {
		return err
	} else if ok && currentSlot != slot {
		slotTrace, _, getErr := goforjcache.Get[string](cache, inspectSlotTraceKey(currentSlot))
		if getErr != nil {
			return getErr
		}
		if strings.TrimSpace(slotTrace) == inspectID {
			if err := cache.Delete(inspectSlotTraceKey(currentSlot)); err != nil {
				return err
			}
		}
	}
	if existingTrace != "" && strings.TrimSpace(existingTrace) != inspectID {
		if err := m.deletePersistedInspect(cache, existingTrace); err != nil {
			return err
		}
		if err := cache.Delete(inspectSlotIndexKey(existingTrace)); err != nil {
			return err
		}
	}
	if err := goforjcache.Set(cache, inspectSlotTraceKey(slot), inspectID, inspectStorageTTL); err != nil {
		return err
	}
	if err := goforjcache.Set(cache, inspectSlotIndexKey(inspectID), slot, inspectStorageTTL); err != nil {
		return err
	}
	return goforjcache.Set(cache, inspectCursorKey, cursor+1, inspectStorageTTL)
}

func (m *Manager) deletePersistedInspect(cache *goforjcache.Cache, inspectID string) error {
	inspectID = strings.TrimSpace(inspectID)
	if inspectID == "" {
		return nil
	}
	if err := cache.Delete(inspectSummaryKey(inspectID)); err != nil {
		return err
	}
	if err := cache.Delete(inspectEventsKey(inspectID)); err != nil {
		return err
	}
	return cache.Delete(inspectRecordKey(inspectID))
}

func (m *Manager) loadRecordWithCache(cache *goforjcache.Cache, inspectID string) (Record, bool, error) {
	summary, ok, err := goforjcache.Get[InspectSummary](cache, inspectSummaryKey(inspectID))
	if err != nil {
		return Record{}, false, err
	}
	if ok {
		events, _, err := goforjcache.Get[[]InspectEvent](cache, inspectEventsKey(inspectID))
		if err != nil {
			return Record{}, false, err
		}
		return Record{
			Summary: summary,
			Events:  events,
		}, true, nil
	}
	record, ok, err := goforjcache.Get[Record](cache, inspectRecordKey(inspectID))
	if err != nil || !ok {
		return Record{}, ok, err
	}
	return record, true, nil
}

func normalizeRecord(record Record) Record {
	record.Summary.TraceID = strings.TrimSpace(record.Summary.TraceID)
	record.Summary.Source = strings.TrimSpace(record.Summary.Source)
	record.Summary.Name = normalizeInspectName(record.Summary.Name)
	if record.Summary.Status == "" {
		record.Summary.Status = statusOK
	}
	record.Summary.Labels = cloneStringMap(record.Summary.Labels)
	record.Events = append([]InspectEvent(nil), record.Events...)
	record.Summary.EventCount = len(record.Events)
	sort.SliceStable(record.Events, func(i, j int) bool {
		left := record.Events[i]
		right := record.Events[j]
		if left.Seq > 0 && right.Seq > 0 && left.Seq != right.Seq {
			return left.Seq < right.Seq
		}
		if !left.At.Equal(right.At) {
			return left.At.Before(right.At)
		}
		return strings.TrimSpace(left.Name+left.Message) < strings.TrimSpace(right.Name+right.Message)
	})
	for idx := range record.Events {
		record.Events[idx].Kind = EventKind(strings.TrimSpace(string(record.Events[idx].Kind)))
		record.Events[idx].Level = strings.TrimSpace(record.Events[idx].Level)
		record.Events[idx].Name = strings.TrimSpace(record.Events[idx].Name)
		record.Events[idx].Message = strings.TrimSpace(record.Events[idx].Message)
		record.Events[idx].Status = strings.TrimSpace(record.Events[idx].Status)
		record.Events[idx].Attributes = cloneAnyMap(record.Events[idx].Attributes)
		record.Events[idx].HTTP = cloneHTTPExchange(record.Events[idx].HTTP)
		record.Events[idx].Seq = int64(idx + 1)
		if record.Events[idx].At.IsZero() {
			record.Events[idx].At = record.Summary.UpdatedAt
		}
	}
	return record
}

func normalizeInspectName(name string) string {
	name = strings.TrimSpace(name)
	if name == "" {
		return defaultInspectName
	}
	return name
}

func normalizeStatus(status string, err error) string {
	switch {
	case err != nil && errors.Is(err, context.Canceled):
		return statusCanceled
	case err != nil:
		return statusError
	}
	status = strings.ToLower(strings.TrimSpace(status))
	switch status {
	case statusOK, statusError, statusCanceled, statusRunning:
		return status
	case "":
		return statusOK
	default:
		return status
	}
}

func statusFromError(err error) string {
	return normalizeStatus("", err)
}

func normalizeStatusFromHTTP(status int) string {
	if status >= 500 {
		return statusError
	}
	if status >= 400 {
		return "warning"
	}
	return statusOK
}

func durationMS(d time.Duration) int64 {
	if d <= 0 {
		return 0
	}
	return d.Milliseconds()
}

func durationNS(d time.Duration) int64 {
	if d <= 0 {
		return 0
	}
	return d.Nanoseconds()
}

func newInspectID() string {
	seq := inspectIDCounter.Add(1)
	var buf [48]byte
	out := buf[:0]
	out = append(out, inspectIDSeed...)
	out = strconv.AppendUint(out, seq, 36)
	return string(out)
}

func cloneStringMap(in map[string]string) map[string]string {
	if len(in) == 0 {
		return nil
	}
	out := make(map[string]string, len(in))
	for key, value := range in {
		out[key] = value
	}
	return out
}

func cloneAnyMap(in map[string]any) map[string]any {
	if len(in) == 0 {
		return nil
	}
	out := make(map[string]any, len(in))
	for key, value := range in {
		out[key] = value
	}
	return out
}

func cloneHTTPHeaders(in []HTTPHeader) []HTTPHeader {
	if len(in) == 0 {
		return nil
	}
	out := make([]HTTPHeader, len(in))
	copy(out, in)
	return out
}

func cloneHTTPExchange(in *HTTPExchange) *HTTPExchange {
	if in == nil {
		return nil
	}
	out := *in
	out.RequestHeadersRaw = cloneHTTPHeaders(in.RequestHeadersRaw)
	out.ResponseHeaders = cloneHTTPHeaders(in.ResponseHeaders)
	return &out
}

func releaseInflightInspect(state *inflightInspect) {
	if state == nil {
		return
	}
	for idx := range state.record.Events {
		state.record.Events[idx] = InspectEvent{}
	}
	state.record.Events = state.record.Events[:0]
	state.record.Summary = InspectSummary{}
	state.finished = false
	state.indexed = false
	inflightInspectPool.Put(state)
}

func maxInt64(a, b int64) int64 {
	if a > b {
		return a
	}
	return b
}

func minInt(a, b int) int {
	if a < b {
		return a
	}
	return b
}

func minInt64(a, b int64) int64 {
	if a < b {
		return a
	}
	return b
}
