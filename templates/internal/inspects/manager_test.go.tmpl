func assertIntAttr(t *testing.T, value any, want int, name string) {
	t.Helper()

	switch got := value.(type) {
	case int:
		if got != want {
			t.Fatalf("%s attr = %v, want %d", name, got, want)
		}
	case int64:
		if got != int64(want) {
			t.Fatalf("%s attr = %v, want %d", name, got, want)
		}
	case float64:
		if got != float64(want) {
			t.Fatalf("%s attr = %v, want %d", name, got, want)
		}
	default:
		t.Fatalf("%s attr = %v (%T), want %d", name, value, value, want)
	}
}

