// TestMessageContextPropagationRetainsIdentityAndReceiverLifetime covers sampled and unsampled cross-process carriers.
func TestMessageContextPropagationRetainsIdentityAndReceiverLifetime(t *testing.T) {
	state, err := trace.ParseTraceState("vendor=value")
	if err != nil {
		t.Fatal(err)
	}
	for _, flags := range []trace.TraceFlags{0, trace.FlagsSampled} {
		identity := trace.NewSpanContext(trace.SpanContextConfig{TraceID: trace.TraceID{1}, SpanID: trace.SpanID{2}, TraceFlags: flags, TraceState: state})
		producer := trace.ContextWithSpanContext(context.Background(), identity)
		propagator := MessageContextPropagator{}
		headers := propagator.Inject(producer)
		if len(headers) != 2 {
			t.Fatalf("carrier=%v", headers)
		}
		deadline := time.Now().Add(time.Hour)
		receiver, cancel := context.WithDeadline(runtime.WithSource(context.Background(), runtime.SourceEvents), deadline)
		extracted := propagator.Extract(receiver, map[string]string{"TraceParent": headers["traceparent"], "TraceState": headers["tracestate"], "baggage": "must-not-propagate"})
		actual := trace.SpanContextFromContext(extracted)
		if !actual.Equal(identity.WithRemote(true)) || runtime.SourceFromContext(extracted) != runtime.SourceEvents {
			t.Fatal("identity, sampling decision, or receiver values changed")
		}
		if got, ok := extracted.Deadline(); !ok || !got.Equal(deadline) {
			t.Fatal("receiver deadline changed")
		}
		cancel()
		if extracted.Err() != context.Canceled {
			t.Fatal("receiver cancellation was detached")
		}
		if got := propagator.Extract(producer, headers); got != producer {
			t.Fatal("same-process parent was unnecessarily marked remote")
		}
	}
	if got := executionSpanKind(runtime.SourceEvents); got != trace.SpanKindConsumer {
		t.Fatalf("event execution kind=%s", got)
	}
}

// TestMessageContextPropagationRejectsMalformedMetadata keeps invalid trace input from changing application execution.
func TestMessageContextPropagationRejectsMalformedMetadata(t *testing.T) {
	propagator := MessageContextPropagator{}
	receiver := context.Background()
	many := map[string]string{}
	for index := range 33 {
		many[strings.Repeat("x", index+1)] = "ignored"
	}
	for _, headers := range []map[string]string{nil, {}, many, {"traceparent": "invalid"}, {"traceparent": strings.Repeat("x", 513)}, {"tracestate": strings.Repeat("x", 513)}, {"traceparent": "first", "Traceparent": "second"}, {"tracestate": "first", "Tracestate": "second"}} {
		if got := propagator.Extract(receiver, headers); trace.SpanContextFromContext(got).IsValid() {
			t.Fatal("invalid metadata created a parent")
		}
	}
	if propagator.Extract(nil, nil) == nil {
		t.Fatal("nil input was not normalized")
	}
	if headers := propagator.Inject(context.Background()); len(headers) != 0 {
		t.Fatal("untraced publication acquired headers")
	}
}

// TestMessageContextPropagationHeaderCases preserves input ownership and identity with canonical and normalized keys.
func TestMessageContextPropagationHeaderCases(t *testing.T) {
	propagator := MessageContextPropagator{}
	identity := trace.NewSpanContext(trace.SpanContextConfig{TraceID: trace.TraceID{1}, SpanID: trace.SpanID{2}, TraceFlags: trace.FlagsSampled})
	canonical := propagator.Inject(trace.ContextWithSpanContext(context.Background(), identity))
	for _, parentKey := range []string{"traceparent", "TraceParent"} {
		for _, stateKey := range []string{"tracestate", "TraceState", "traceſtate"} {
			headers := map[string]string{parentKey: canonical["traceparent"], stateKey: "vendor=value", "baggage": "private=value"}
			before := maps.Clone(headers)
			got := trace.SpanContextFromContext(propagator.Extract(context.Background(), headers))
			if !got.IsRemote() || got.TraceID() != identity.TraceID() || got.SpanID() != identity.SpanID() || got.TraceState().String() != "vendor=value" {
				t.Fatalf("keys=%s/%s: identity or trace state changed", parentKey, stateKey)
			}
			if !maps.Equal(headers, before) {
				t.Fatal("extraction mutated its input headers")
			}
		}
	}
}

// BenchmarkMessageContextPropagationExtract measures real W3C parsing separately from broker and span creation costs.
func BenchmarkMessageContextPropagationExtract(b *testing.B) {
	const parent = "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01"
	for _, name := range []string{"canonical", "mixed_case", "empty"} {
		b.Run(name, func(b *testing.B) {
			headers := map[string]string{"traceparent": parent, "tracestate": "vendor=benchmark"}
			if name == "mixed_case" {
				headers = map[string]string{"TraceParent": parent, "TraceState": "vendor=benchmark"}
			} else if name == "empty" {
				headers = nil
			}
			propagator := MessageContextPropagator{}
			ctx := context.Background()
			if got := trace.SpanContextFromContext(propagator.Extract(ctx, headers)); got.IsValid() != (name != "empty") {
				b.Fatal("unexpected extracted identity")
			}
			b.ReportAllocs()
			b.ResetTimer()
			for range b.N {
				propagator.Extract(ctx, headers)
			}
		})
	}
}

// TestMessageContextPropagationPreservesFutureExtensions leaves unknown version fields opaque, matching the OpenTelemetry contract.
func TestMessageContextPropagationPreservesFutureExtensions(t *testing.T) {
	const parent = "01-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01"
	propagator := MessageContextPropagator{}
	for _, suffix := range []string{"", "-extra", "-extra,opaque", "-extra,00-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-bbbbbbbbbbbbbbbb-01"} {
		got := trace.SpanContextFromContext(propagator.Extract(context.Background(), map[string]string{"traceparent": parent + suffix}))
		if !got.IsRemote() || !got.IsSampled() || got.TraceID().String() != "4bf92f3577b34da6a3ce929d0e0e4736" || got.SpanID().String() != "00f067aa0ba902b7" {
			t.Fatal("unknown future-version fields changed core identity")
		}
	}
}

// TestMessageContextPropagationStateBudget preserves parent identity when optional state exceeds the transport budget.
func TestMessageContextPropagationStateBudget(t *testing.T) {
	largeMembers := make([]string, 32)
	for index := range largeMembers {
		largeMembers[index] = fmt.Sprintf("v%02d=%s", index, strings.Repeat("x", 256))
	}
	for _, test := range []struct {
		name  string
		state string
		bytes int
	}{
		{"boundary", "a=" + strings.Repeat("x", 256) + ",b=" + strings.Repeat("y", 251), 512},
		{"over_boundary", "a=" + strings.Repeat("x", 256) + ",b=" + strings.Repeat("y", 252), 513},
		{"sdk_large", strings.Join(largeMembers[:2], ","), 521},
		{"sdk_max_members", strings.Join(largeMembers, ","), 8351},
	} {
		t.Run(test.name, func(t *testing.T) {
			state, err := trace.ParseTraceState(test.state)
			if err != nil || len(state.String()) != test.bytes {
				t.Fatalf("state bytes=%d, error=%v", len(state.String()), err)
			}
			for _, flags := range []trace.TraceFlags{0, trace.FlagsSampled} {
				identity := trace.NewSpanContext(trace.SpanContextConfig{TraceID: trace.TraceID{1}, SpanID: trace.SpanID{2}, TraceFlags: flags, TraceState: state})
				producer := trace.ContextWithSpanContext(context.Background(), identity)
				sdkHeaders := propagation.MapCarrier{}
				propagation.TraceContext{}.Inject(producer, sdkHeaders)
				if sdkHeaders["tracestate"] != test.state {
					t.Fatal("SDK did not retain valid input state")
				}
				propagator := MessageContextPropagator{}
				headers := propagator.Inject(producer)
				if headers["traceparent"] != sdkHeaders["traceparent"] {
					t.Fatal("injection changed parent identity or sampling flags")
				}
				wantState := state
				if test.bytes > 512 {
					wantState = trace.TraceState{}
					if _, exists := headers["tracestate"]; exists {
						t.Fatal("oversized state field was not omitted")
					}
				} else if headers["tracestate"] != test.state {
					t.Fatal("state at the budget boundary changed")
				}
				encoded, err := json.Marshal(headers)
				if err != nil || len(encoded) > 8192 {
					t.Fatalf("carrier bytes=%d, error=%v", len(encoded), err)
				}
				for _, carrier := range []map[string]string{headers, sdkHeaders} {
					before := maps.Clone(carrier)
					got := trace.SpanContextFromContext(propagator.Extract(context.Background(), carrier))
					if !got.Equal(identity.WithTraceState(wantState).WithRemote(true)) {
						t.Fatal("round trip changed parent identity, flags, or expected state")
					}
					if !maps.Equal(carrier, before) {
						t.Fatal("extraction mutated input headers")
					}
				}
			}
		})
	}
}

// TestMessageContextPropagationDiscardsInvalidState keeps optional metadata failures separate from parent validation.
func TestMessageContextPropagationDiscardsInvalidState(t *testing.T) {
	for _, flags := range []trace.TraceFlags{0, trace.FlagsSampled} {
		identity := trace.NewSpanContext(trace.SpanContextConfig{TraceID: trace.TraceID{1}, SpanID: trace.SpanID{2}, TraceFlags: flags})
		propagator := MessageContextPropagator{}
		parent := propagator.Inject(trace.ContextWithSpanContext(context.Background(), identity))["traceparent"]
		for _, test := range []struct {
			name  string
			state map[string]string
		}{
			{"malformed", map[string]string{"tracestate": "invalid"}},
			{"oversized_malformed", map[string]string{"tracestate": strings.Repeat("x", 513)}},
			{"duplicate_case", map[string]string{"tracestate": "a=one", "TraceState": "b=two"}},
			{"duplicate_unicode", map[string]string{"TraceState": "a=one", "traceſtate": "b=two"}},
			{"oversized_duplicate", map[string]string{"tracestate": strings.Repeat("x", 513), "TraceState": "b=two"}},
		} {
			t.Run(fmt.Sprintf("%s/flags_%d", test.name, flags), func(t *testing.T) {
				headers := maps.Clone(test.state)
				headers["traceparent"] = parent
				before := maps.Clone(headers)
				deadline := time.Now().Add(time.Hour)
				receiver, cancel := context.WithDeadline(runtime.WithSource(context.Background(), runtime.SourceEvents), deadline)
				defer cancel()
				extracted := propagator.Extract(receiver, headers)
				if got := trace.SpanContextFromContext(extracted); !got.Equal(identity.WithRemote(true)) {
					t.Fatal("invalid optional state changed parent identity or flags")
				}
				if got, ok := extracted.Deadline(); !ok || !got.Equal(deadline) || runtime.SourceFromContext(extracted) != runtime.SourceEvents {
					t.Fatal("extraction changed the receiver deadline or values")
				}
				cancel()
				if extracted.Err() != context.Canceled {
					t.Fatal("extraction detached receiver cancellation")
				}
				if !maps.Equal(headers, before) {
					t.Fatal("extraction mutated input headers")
				}
				for _, invalidParent := range []map[string]string{
					{"traceparent": parent, "TraceParent": parent},
					{"traceparent": "invalid"},
					{"traceparent": strings.Repeat("x", 513)},
				} {
					carrier := maps.Clone(test.state)
					maps.Copy(carrier, invalidParent)
					if got := propagator.Extract(receiver, carrier); got != receiver {
						t.Fatal("invalid or ambiguous parent was accepted with invalid state")
					}
				}
			})
		}
	}
}
