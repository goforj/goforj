// TestTelemetryExporterDiagnosticSubprocess serves credential-bearing collector failures over a local receiver.
func TestTelemetryExporterDiagnosticSubprocess(t *testing.T) {
	mode := os.Getenv("GOFORJ_EXPORTER_PRIVACY_CHILD")
	if mode == "" {
		t.Skip("invoked by diagnostic matrix")
	}
	clearTelemetryEnv(t)
	received := make(chan struct{}, 1)
	receiver := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if r.URL.Path != "/ingest/fake-review-path-token" || r.Header.Get("Authorization") != "Bearer fake-review-header-token" {
			t.Error("export destination or authorization changed")
		}
		w.WriteHeader(http.StatusUnauthorized)
		_, _ = fmt.Fprint(w, "rejected "+r.Header.Get("Authorization")+" fake-review-response-body")
		received <- struct{}{}
	}))
	defer receiver.Close()
	t.Setenv("OTEL_TRACES_EXPORTER", "otlp")
	t.Setenv("OTEL_TRACES_SAMPLER", "always_on")
	t.Setenv("OTEL_EXPORTER_OTLP_TRACES_ENDPOINT", receiver.URL+"/ingest/fake-review-path-token")
	t.Setenv("OTEL_EXPORTER_OTLP_HEADERS", "Authorization=Bearer%20fake-review-header-token")
	t.Setenv("OTEL_EXPORTER_OTLP_TRACES_HEADERS", "")
	t.Setenv("OTEL_BSP_SCHEDULE_DELAY", "60000")
	if mode == "background" {
		t.Setenv("OTEL_BSP_SCHEDULE_DELAY", "1")
	}
	m := NewManager()
	if err := m.ConfigureTelemetry(context.Background()); err != nil {
		t.Fatal(err)
	}
	_, span := m.TracerProvider().Tracer("review").Start(context.Background(), "request")
	span.End()
	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
	defer cancel()
	if mode == "forceflush" {
		err := m.TracerProvider().ForceFlush(ctx)
		if err == nil || err.Error() != "OTLP trace export failed" {
			t.Fatal("ForceFlush did not preserve a safe failure")
		}
		var safe *telemetryExportError
		if !errors.As(err, &safe) || !strings.Contains(safe.Unwrap().Error(), "fake-review-header-token") {
			t.Fatal("typed cause was not retained for explicit inspection")
		}
		log.Printf("ForceFlush result: %v", err)
	} else if mode == "shutdown" {
		log.Printf("Shutdown result: %v", m.Shutdown(ctx))
	}
	select {
	case <-received:
	case <-ctx.Done():
		t.Fatal("collector request missing")
	}
	if mode == "background" {
		time.Sleep(20 * time.Millisecond)
	}
	if mode != "shutdown" {
		log.Printf("Shutdown result: %v", m.Shutdown(ctx))
	}
}
