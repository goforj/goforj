// recorderBindingValueKey distinguishes caller metadata from recorder and SDK context state.
type recorderBindingValueKey struct{}

// TestRecorderBindingSelectsExecutionSpan preserves explicit binding semantics with or without an upstream span.
func TestRecorderBindingSelectsExecutionSpan(t *testing.T) {
	for _, upstream := range []bool{false, true} {
		name := "without upstream"
		if upstream {
			name = "with upstream"
		}
		t.Run(name, func(t *testing.T) {
			manager := newTestManager(t)
			exporter := tracetest.NewInMemoryExporter()
			manager.TracerProvider().RegisterSpanProcessor(sdktrace.NewSimpleSpanProcessor(exporter))
			base := context.WithValue(context.Background(), recorderBindingValueKey{}, "caller value")
			if upstream {
				parent := trace.NewSpanContext(trace.SpanContextConfig{
					TraceID: trace.TraceID{1}, SpanID: trace.SpanID{2}, TraceFlags: trace.FlagsSampled,
				})
				base = trace.ContextWithRemoteSpanContext(base, parent)
			}
			base, cancel := context.WithCancel(base)
			defer cancel()
			recorder := manager.BeginHTTPRecorder(base, "GET /binding")
			if recorder == nil {
				t.Fatal("execution recorder missing")
			}
			ctx := WithRecorder(base, recorder)
			if RecorderFromContext(ctx) != recorder || ctx.Value(recorderBindingValueKey{}) != "caller value" {
				t.Fatal("binding lost recorder or caller metadata")
			}
			if ctx.Done() != base.Done() {
				t.Fatal("binding replaced caller cancellation")
			}
			manager.RecordCacheEvent(ctx, CacheOperationInspectEvent{Name: "default", Operation: "get"})
			childCtx, child := manager.TracerProvider().Tracer("regression/application").Start(ctx, "application child")
			// Explicit rebinding returns to the execution span even when the caller currently holds a child span.
			rebound := WithRecorder(childCtx, recorder)
			if got, want := trace.SpanContextFromContext(rebound), trace.SpanContextFromContext(ctx); !got.Equal(want) {
				t.Fatal("explicit rebinding did not select the execution span")
			}
			child.End()
			cancel()
			if !errors.Is(ctx.Err(), context.Canceled) {
				t.Fatal("binding lost caller cancellation state")
			}
			manager.Finish(ctx, "ok", nil)
			spans := exporter.GetSpans()
			if len(spans) != 3 {
				t.Fatalf("exported spans = %d, want cache, application child, and execution", len(spans))
			}
			root := spans[2]
			if got := trace.SpanContextFromContext(ctx); !got.Equal(root.SpanContext) {
				t.Fatalf("bound span = %v, want execution %v", got, root.SpanContext)
			}
			if upstream && (root.SpanContext.TraceID() != (trace.TraceID{1}) || root.Parent.SpanID() != (trace.SpanID{2})) {
				t.Fatal("execution lost upstream parent")
			}
			for _, span := range spans[:2] {
				if span.SpanContext.TraceID() != root.SpanContext.TraceID() || span.Parent.SpanID() != root.SpanContext.SpanID() {
					t.Fatalf("span %q does not descend from the bound execution", span.Name)
				}
			}
		})
	}
}

// recorderContractAnnotator models a standard processor enriching every span at creation.
type recorderContractAnnotator struct{}

// OnStart provides a distinguishable native event for each span's Lighthouse owner.
func (recorderContractAnnotator) OnStart(_ context.Context, span sdktrace.ReadWriteSpan) {
	span.AddEvent("recorder contract annotation", trace.WithAttributes(attribute.String("annotated.span", span.Name())))
}

// OnEnd leaves projection and export to the other registered processors.
func (recorderContractAnnotator) OnEnd(sdktrace.ReadOnlySpan) {}

// Shutdown has no resources to release for this synchronous processor.
func (recorderContractAnnotator) Shutdown(context.Context) error { return nil }

// ForceFlush has no buffered state for this synchronous processor.
func (recorderContractAnnotator) ForceFlush(context.Context) error { return nil }

// TestRecorderDirectEventKeepsProcessorOwnership exercises the documented recorder method at root and nested boundaries.
func TestRecorderDirectEventKeepsProcessorOwnership(t *testing.T) {
	for _, nested := range []bool{false, true} {
		name := "root"
		if nested {
			name = "nested"
		}
		t.Run(name, func(t *testing.T) {
			manager := newTestManager(t)
			manager.TracerProvider().RegisterSpanProcessor(recorderContractAnnotator{})
			outer := manager.Begin(context.Background(), runtime.SourceHTTP, "outer", nil)
			ctx := outer
			if nested {
				ctx = manager.Begin(outer, runtime.SourceJobs, "inner", nil)
			}
			RecorderFromContext(ctx).RecordEvent(InspectEvent{Kind: EventKindCache, Name: "get"})
			manager.Finish(ctx, "ok", nil)
			if nested {
				manager.Finish(outer, "ok", nil)
			}
			record, ok, err := manager.ByID(context.Background(), InspectIDFromContext(ctx))
			if err != nil || !ok {
				t.Fatalf("target inspect missing: %v", err)
			}
			var operationID string
			for _, event := range record.Events {
				if event.Kind == EventKindCache {
					operationID = event.SpanID
				}
			}
			if operationID == "" {
				t.Fatal("rich operation event missing its span identity")
			}
			operationAnnotations := 0
			for _, event := range record.Events {
				if event.Name == "recorder contract annotation" && event.Attributes["annotated.span"] == "cache get" {
					operationAnnotations++
					if event.SpanID != operationID {
						t.Fatal("operation annotation and rich event have different identities")
					}
				}
			}
			if operationAnnotations != 1 {
				t.Fatalf("operation annotations in target inspect = %d, want 1", operationAnnotations)
			}
			if nested {
				outerRecord, ok, err := manager.ByID(context.Background(), InspectIDFromContext(outer))
				if err != nil || !ok {
					t.Fatalf("outer inspect missing: %v", err)
				}
				for _, event := range outerRecord.Events {
					if event.SpanID == operationID {
						t.Fatal("nested operation annotation leaked into outer inspect")
					}
				}
			}
		})
	}
}

// TestRecorderNewTraceDoesNotProjectIntoOldCapture prevents standalone traces from inheriting an unrelated inspect identity.
func TestRecorderNewTraceDoesNotProjectIntoOldCapture(t *testing.T) {
	manager := newTestManager(t)
	exporter := tracetest.NewInMemoryExporter()
