// TestTelemetryHTTPClientUnsampled preserves propagation without recording or filtering metadata that cannot be exported.
func TestTelemetryHTTPClientUnsampled(t *testing.T) {
	t.Setenv("LIGHTHOUSE_INSPECT_ENABLED", "false")
	manager := NewManager()
	defer manager.Shutdown(context.Background())
	exporter := tracetest.NewInMemoryExporter()
	manager.TracerProvider().RegisterSpanProcessor(sdktrace.NewSimpleSpanProcessor(exporter))
	var observed trace.SpanContext
	client := manager.HTTPClient(&http.Client{Transport: telemetryPrivacyRoundTripper(func(r *http.Request) (*http.Response, error) {
		span := trace.SpanFromContext(r.Context())
		observed = trace.SpanContextFromContext((propagation.TraceContext{}).Extract(context.Background(), propagation.HeaderCarrier(r.Header)))
		if span.IsRecording() || !observed.Equal(span.SpanContext().WithRemote(true)) || r.URL.RawQuery != "signature=private" {
			t.Error("unsampled client changed request or propagation")
		}
		return &http.Response{StatusCode: 200, Header: make(http.Header), Body: http.NoBody, Request: r}, nil
	})})
	response, err := client.Get("https://example.com/resource?signature=private")
	if err != nil {
		t.Fatal(err)
	}
	if err := response.Body.Close(); err != nil {
		t.Fatal(err)
	}
	if !observed.IsValid() || observed.IsSampled() || len(exporter.GetSpans()) != 0 {
		t.Fatal("unsampled client recorded a span or lost its propagated identity")
	}
}

// TestTelemetryHTTPClientURLAttributePrivacy keeps sanitization bounded to client URL fields without mutating attribute inputs.
func TestTelemetryHTTPClientURLAttributePrivacy(t *testing.T) {
	manager := newTestManager(t)
	defer manager.Shutdown(context.Background())
	exporter := tracetest.NewInMemoryExporter()
	manager.TracerProvider().RegisterSpanProcessor(sdktrace.NewSimpleSpanProcessor(exporter))
	for _, test := range []struct{ name, key, value, expected string }{
		{"standard", "url.full", "https://user:private@example.com/a%2Fb?custom=private#private", "https://example.com/a%2Fb"},
		{"legacy", "http.url", "https://example.com/a?private=secret", "https://example.com/a"},
		{"malformed", "url.full", "https://example.com/private/%zz", "[redacted]"},
		{"opaque", "url.full", "https:private-opaque?private=secret#private", "https:"},
		{"empty", "url.full", "", ""},
	} {
		t.Run(test.name, func(t *testing.T) {
			ctx, span := (httpClientTracerProvider{TracerProvider: manager.TracerProvider()}).Tracer("client/privacy").Start(context.Background(), test.name)
			if trace.SpanFromContext(ctx) != span || span.TracerProvider() != manager.TracerProvider() {
				t.Fatal("client wrapper changed context span or native provider identity")
			}
			input := []attribute.KeyValue{attribute.String(test.key, test.value), attribute.String("custom", "preserved")}
			span.SetAttributes(input...)
			span.SetAttributes(attribute.Bool("complete", true))
			span.End()
			if input[0].Value.AsString() != test.value || input[1].Value.AsString() != "preserved" {
				t.Fatal("client privacy policy mutated the caller's attribute slice")
			}
			spans := exporter.GetSpans()
			values := telemetryAttributes(spans[len(spans)-1].Attributes)
			if values[test.key] != test.expected || values["custom"] != "preserved" || values["complete"] != true {
				t.Fatalf("client metadata = %v", values)
			}
		})
	}
}

// telemetryPrivacyBody exercises instrumentation that finishes after RoundTrip returns.
type telemetryPrivacyBody struct{ err error }

// Read returns the original dependency error to the caller.
func (b telemetryPrivacyBody) Read([]byte) (int, error) { return 0, b.err }

// Write preserves the response body's optional write interface and error.
func (b telemetryPrivacyBody) Write([]byte) (int, error) { return 0, b.err }

// Close allows the instrumentation to complete without adding another error.
func (telemetryPrivacyBody) Close() error { return nil }

// TestTelemetryHTTPClientBodyErrorPrivacy retains body errors without exporting their messages.
func TestTelemetryHTTPClientBodyErrorPrivacy(t *testing.T) {
	for _, operation := range []string{"read", "write"} {
		t.Run(operation, func(t *testing.T) {
			manager := newTestManager(t)
			defer manager.Shutdown(context.Background())
			exporter := tracetest.NewInMemoryExporter()
			manager.TracerProvider().RegisterSpanProcessor(sdktrace.NewSimpleSpanProcessor(exporter))
			original := errors.New("body failure includes private-credential")
			client := manager.HTTPClient(&http.Client{Transport: telemetryPrivacyRoundTripper(func(r *http.Request) (*http.Response, error) {
				return &http.Response{StatusCode: 200, Header: make(http.Header), Body: telemetryPrivacyBody{err: original}, Request: r}, nil
			})})
			response, err := client.Get("https://example.com/resource")
			if err != nil {
				t.Fatal(err)
			}
			if operation == "read" {
				_, err = response.Body.Read(make([]byte, 1))
			} else {
				writer, ok := response.Body.(io.Writer)
				if !ok {
					t.Fatal("client dropped the response body's writer interface")
				}
				_, err = writer.Write([]byte("request"))
			}
			if !errors.Is(err, original) {
				t.Fatal("client changed the body error")
			}
			if len(exporter.GetSpans()) != 0 {
				t.Fatal("client span ended before response body completion")
			}
			if err := response.Body.Close(); err != nil {
				t.Fatal(err)
			}
			spans := exporter.GetSpans()
			if len(spans) != 1 || spans[0].Status.Code != codes.Error || spans[0].Status.Description != "request failed" {
				t.Fatalf("client error span = %+v", spans)
			}
		})
	}
}

// TestTelemetryIndexedLogsDuringFinish keeps old-ID writers active while a subsequent capture can acquire recycled state.
func TestTelemetryIndexedLogsDuringFinish(t *testing.T) {
	manager := newTestManager(t)
	defer manager.Shutdown(context.Background())
	for range 500 {
		ctx := manager.Begin(context.Background(), runtime.SourceCLI, "old", nil)
		idCtx := WithInspectID(context.Background(), InspectIDFromContext(ctx))
		var workers sync.WaitGroup
		done := make(chan struct{})
		ready := make(chan struct{}, 8)
		for range 8 {
			workers.Add(1)
			go func() {
				defer workers.Done()
				manager.RecordLog(idCtx, LogInspectEvent{Message: "old payload"})
				ready <- struct{}{}
				for {
					select {
					case <-done:
						return
					default:
					}
					manager.RecordLog(idCtx, LogInspectEvent{Message: "old payload"})
				}
			}()
		}
		for range 8 {
			<-ready
		}
		manager.Finish(ctx, "ok", nil)
		next := manager.Begin(context.Background(), runtime.SourceCLI, "new", nil)
		nextID := InspectIDFromContext(next)
		manager.RecordLog(next, LogInspectEvent{Message: "new payload"})
		manager.Finish(next, "ok", nil)
		close(done)
		workers.Wait()
		record, ok, err := manager.ByID(context.Background(), nextID)
		if err != nil || !ok || len(record.Events) != 1 || record.Events[0].Message != "new payload" {
			t.Fatalf("reused capture contaminated by stale ID writer: %+v %v %v", record, ok, err)
		}
	}
}

// telemetryEventAnnotator represents a third-party processor enriching framework operation spans.
