// TestTelemetryProviderFailureClosesPendingExporter protects ownership before a new batch processor is installed.
func TestTelemetryProviderFailureClosesPendingExporter(t *testing.T) {
	for _, test := range []struct {
		name         string
		export       bool
		cleanupFails bool
	}{
		{name: "no exporter"},
		{name: "exporter", export: true},
		{name: "exporter cleanup failure", export: true, cleanupFails: true},
	} {
		t.Run(test.name, func(t *testing.T) {
			manager := newTestManager(t)
			oldProvider := manager.TracerProvider()
			shutdownErr := errors.New("previous processor shutdown failed")
			oldProcessor := &handoffSpanProcessor{shutdownErr: shutdownErr}
			oldProvider.RegisterSpanProcessor(oldProcessor)
			pending := &handoffSpanExporter{}
			if test.cleanupFails {
				pending.shutdownErr = errors.New("pending exporter shutdown failed")
			}
			var exporter sdktrace.SpanExporter
			if test.export {
				exporter = pending
			}
			err := manager.installTelemetryProvider(context.Background(), exporter)
			if !errors.Is(err, shutdownErr) {
				t.Fatalf("configuration error = %v, want previous shutdown error", err)
			}
			if test.cleanupFails && !errors.Is(err, pending.shutdownErr) {
				t.Fatalf("configuration error = %v, want pending exporter cleanup error", err)
			}
			if manager.TracerProvider() != oldProvider {
				t.Fatal("failed handoff installed a new provider")
			}
			if got := oldProcessor.shutdownCalls.Load(); got != 1 {
				t.Fatalf("old processor shutdown calls = %d, want 1", got)
			}
			want := int64(0)
			if test.export {
				want = 1
			}
			if got := pending.shutdownCalls.Load(); got != want {
				t.Fatalf("pending exporter shutdown calls = %d, want %d", got, want)
			}
			if got := pending.exportedSpans.Load(); got != 0 {
				t.Fatalf("pending exporter received %d spans after failed handoff", got)
			}
		})
	}
}

// TestTelemetryProviderSuccessTransfersExporterOwnership verifies the installed provider closes its exporter once.
func TestTelemetryProviderSuccessTransfersExporterOwnership(t *testing.T) {
	manager := newTestManager(t)
	t.Cleanup(func() { _ = manager.Shutdown(context.Background()) })
	oldProvider := manager.TracerProvider()
	oldProcessor := &handoffSpanProcessor{}
	oldProvider.RegisterSpanProcessor(oldProcessor)
	exporter := &handoffSpanExporter{}
	if err := manager.installTelemetryProvider(context.Background(), exporter, sdktrace.WithSampler(sdktrace.AlwaysSample())); err != nil {
		t.Fatal(err)
	}
	if manager.TracerProvider() == oldProvider {
		t.Fatal("successful handoff retained the old provider")
	}
	if got := oldProcessor.shutdownCalls.Load(); got != 1 {
		t.Fatalf("old processor shutdown calls = %d, want 1", got)
	}
	if got := exporter.shutdownCalls.Load(); got != 0 {
		t.Fatalf("owned exporter was closed before provider shutdown: %d", got)
	}
	_, span := manager.TracerProvider().Tracer("test/handoff").Start(context.Background(), "new-provider-work")
	span.End()
	if err := manager.Shutdown(context.Background()); err != nil {
		t.Fatal(err)
	}
	if got := exporter.shutdownCalls.Load(); got != 1 {
		t.Fatalf("owned exporter shutdown calls = %d, want 1", got)
	}
	if got := exporter.exportedSpans.Load(); got != 1 {
		t.Fatalf("owned exporter spans = %d, want 1", got)
	}
}

// handoffSpanProcessor makes the previous provider's failure independent of transport timing.
type handoffSpanProcessor struct {
	shutdownErr   error
	shutdownCalls atomic.Int64
}

// OnStart leaves span processing to the owning SDK.
func (*handoffSpanProcessor) OnStart(context.Context, sdktrace.ReadWriteSpan) {}

// OnEnd avoids exporting spans from the previous provider under test.
func (*handoffSpanProcessor) OnEnd(sdktrace.ReadOnlySpan) {}

// ForceFlush has no buffered state to flush.
func (*handoffSpanProcessor) ForceFlush(context.Context) error { return nil }

// Shutdown exposes the old provider's failure while recording its ownership release.
func (p *handoffSpanProcessor) Shutdown(context.Context) error {
	p.shutdownCalls.Add(1)
	return p.shutdownErr
}

// handoffSpanExporter records resource ownership without starting a network transport.
type handoffSpanExporter struct {
	shutdownErr   error
	shutdownCalls atomic.Int64
	exportedSpans atomic.Int64
}

// ExportSpans retains only the span count required to verify successful handoff.
func (e *handoffSpanExporter) ExportSpans(_ context.Context, spans []sdktrace.ReadOnlySpan) error {
	e.exportedSpans.Add(int64(len(spans)))
	return nil
}

// Shutdown makes cleanup failures observable without depending on background worker scheduling.
func (e *handoffSpanExporter) Shutdown(context.Context) error {
	e.shutdownCalls.Add(1)
	return e.shutdownErr
}

// TestTelemetryCanceledShutdownReleasesOwnedExporter protects SDK resources when the app has consumed its shutdown budget.
func TestTelemetryCanceledShutdownReleasesOwnedExporter(t *testing.T) {
	for _, cancelBeforeCall := range []bool{true, false} {
		name := "canceled by previous processor"
		if cancelBeforeCall {
			name = "already canceled"
		}
		t.Run(name, func(t *testing.T) {
			manager := newTestManager(t)
			exporter := &budgetShutdownExporter{done: make(chan struct{})}
			ctx, cancel := context.WithCancel(context.Background())
			defer cancel()
			options := []sdktrace.TracerProviderOption{}
			if !cancelBeforeCall {
				options = append(options, sdktrace.WithSpanProcessor(&budgetShutdownProcessor{shutdown: func(context.Context) error { cancel(); return nil }}))
			}
			if err := manager.installTelemetryProvider(context.Background(), exporter, options...); err != nil {
				t.Fatal(err)
			}
			if cancelBeforeCall {
				cancel()
			}
			if err := manager.Shutdown(ctx); !errors.Is(err, context.Canceled) {
				t.Fatalf("shutdown error = %v, want context.Canceled", err)
			}
			select {
			case <-exporter.done:
			case <-time.After(2 * time.Second):
				t.Fatal("owned exporter was not released after shutdown budget expired")
			}
			if err := manager.Shutdown(context.Background()); err != nil {
				t.Fatal(err)
			}
			if got := exporter.shutdownCalls.Load(); got != 1 {
				t.Fatalf("owned exporter shutdown calls = %d, want 1", got)
			}
		})
	}
}

// TestTelemetryShutdownAllowsRecursiveProcessor protects application processors that request manager shutdown while being closed.
func TestTelemetryShutdownAllowsRecursiveProcessor(t *testing.T) {
	manager := newTestManager(t)
	exporter := &budgetShutdownExporter{done: make(chan struct{})}
	processor := &budgetShutdownProcessor{shutdown: manager.Shutdown}
	if err := manager.installTelemetryProvider(context.Background(), exporter, sdktrace.WithSpanProcessor(processor)); err != nil {
		t.Fatal(err)
	}
	returned := make(chan error, 1)
	go func() { returned <- manager.Shutdown(context.Background()) }()
	select {
	case err := <-returned:
		if err != nil {
			t.Fatal(err)
		}
	case <-time.After(2 * time.Second):
		t.Fatal("recursive processor shutdown did not complete")
	}
	if got := processor.shutdownCalls.Load(); got != 1 {
		t.Fatalf("recursive processor shutdown calls = %d, want 1", got)
	}
	if got := exporter.shutdownCalls.Load(); got != 1 {
		t.Fatalf("owned exporter shutdown calls = %d, want 1", got)
	}
}

// TestTelemetryShutdownAllowsRecursiveExporter protects both public shutdown entry points from callbacks out of the owned batch processor.
func TestTelemetryShutdownAllowsRecursiveExporter(t *testing.T) {
	for _, directSDK := range []bool{false, true} {
		name := "manager entry"
		if directSDK {
			name = "SDK entry"
		}
		t.Run(name, func(t *testing.T) {
			manager := newTestManager(t)
			exporter := &budgetShutdownExporter{done: make(chan struct{}), shutdown: manager.Shutdown}
			if err := manager.installTelemetryProvider(context.Background(), exporter); err != nil {
				t.Fatal(err)
			}
			shutdown := manager.Shutdown
			if directSDK {
				shutdown = manager.TracerProvider().Shutdown
			}
			returned := make(chan error, 1)
			go func() { returned <- shutdown(context.Background()) }()
			select {
			case err := <-returned:
				if err != nil {
					t.Fatal(err)
				}
			case <-time.After(2 * time.Second):
				t.Fatal("recursive exporter shutdown did not complete")
			}
			select {
			case <-exporter.done:
			default:
				t.Fatal("recursive exporter ownership release did not finish")
			}
			if err := manager.Shutdown(context.Background()); err != nil {
				t.Fatal(err)
			}
			if got := exporter.shutdownCalls.Load(); got != 1 {
				t.Fatalf("recursive exporter shutdown calls = %d, want 1", got)
			}
		})
	}
}

// budgetShutdownProcessor provides deterministic cancellation or recursion before the owned batch processor is closed.
type budgetShutdownProcessor struct {
	shutdown      func(context.Context) error
	shutdownCalls atomic.Int64
}

// OnStart leaves processing to the SDK under test.
func (*budgetShutdownProcessor) OnStart(context.Context, sdktrace.ReadWriteSpan) {}

// OnEnd has no buffered spans to retain.
func (*budgetShutdownProcessor) OnEnd(sdktrace.ReadOnlySpan) {}

// ForceFlush has no state to flush.
func (*budgetShutdownProcessor) ForceFlush(context.Context) error { return nil }

// Shutdown applies the callback once through the owning SDK's processor contract.
func (p *budgetShutdownProcessor) Shutdown(ctx context.Context) error {
	p.shutdownCalls.Add(1)
	return p.shutdown(ctx)
}

// budgetShutdownExporter signals resource release without involving transport workers or collector timing.
type budgetShutdownExporter struct {
	done          chan struct{}
	shutdown      func(context.Context) error
	shutdownCalls atomic.Int64
	once          sync.Once
}

// ExportSpans leaves tests focused on ownership rather than delivery.
func (*budgetShutdownExporter) ExportSpans(context.Context, []sdktrace.ReadOnlySpan) error {
	return nil
}

// Shutdown makes asynchronous SDK resource release observable through a channel.
func (e *budgetShutdownExporter) Shutdown(ctx context.Context) error {
	e.shutdownCalls.Add(1)
	var err error
	if e.shutdown != nil {
		err = e.shutdown(ctx)
	}
	e.once.Do(func() { close(e.done) })
	return err
}

