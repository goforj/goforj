	}
	_, explicit := m.TracerProvider().Tracer("application/privacy").Start(context.Background(), "explicit")
	explicit.SetAttributes(attribute.String("url.full", "https://example.invalid/?intentional=explicit-value"))
	explicit.SetStatus(codes.Error, "explicit application description")
	explicit.End()
