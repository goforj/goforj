// TestTelemetryOTLPGRPCExportsWithoutLighthouse verifies the alternate standard transport flushes to a local receiver.
func TestTelemetryOTLPGRPCExportsWithoutLighthouse(t *testing.T) {
	clearTelemetryEnv(t)
	previous, propagator := otel.GetTracerProvider(), otel.GetTextMapPropagator()
	t.Cleanup(func() { otel.SetTracerProvider(previous); otel.SetTextMapPropagator(propagator) })
	listener, err := net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	server := grpc.NewServer()
	receiver := &otlpReceiver{received: make(chan *v1.ExportTraceServiceRequest, 2)}
	v1.RegisterTraceServiceServer(server, receiver)
	go server.Serve(listener)
	defer server.Stop()
	t.Setenv("OTEL_TRACES_EXPORTER", "otlp")
	t.Setenv("OTEL_EXPORTER_OTLP_TRACES_PROTOCOL", "grpc")
	t.Setenv("OTEL_EXPORTER_OTLP_TRACES_ENDPOINT", "http://"+listener.Addr().String())
	t.Setenv("LIGHTHOUSE_INSPECT_ENABLED", "false")
	manager := NewManager()
	if err := manager.ConfigureTelemetry(context.Background()); err != nil {
		t.Fatal(err)
	}
	ctx := manager.Begin(context.Background(), runtime.SourceCLI, "grpc-command", nil)
	manager.Finish(ctx, "ok", nil)
	if err := manager.Shutdown(context.Background()); err != nil {
		t.Fatal(err)
	}
	select {
	case request := <-receiver.received:
		if len(request.ResourceSpans) != 1 || request.ResourceSpans[0].ScopeSpans[0].Spans[0].Name != "grpc-command" {
			t.Fatal("missing exported execution span")
		}
	default:
		t.Fatal("gRPC shutdown returned without exporting")
	}
}

// otlpReceiver checks standard wire compatibility independently from Lighthouse transport.
type otlpReceiver struct {
	v1.UnimplementedTraceServiceServer
	received chan *v1.ExportTraceServiceRequest
}

// Export accepts complete OTLP trace batches for transport assertions.
func (r *otlpReceiver) Export(_ context.Context, request *v1.ExportTraceServiceRequest) (*v1.ExportTraceServiceResponse, error) {
	r.received <- request
	return &v1.ExportTraceServiceResponse{}, nil
}

// TestTelemetryMultipleExecutionsShareTraceWithoutOverwrite protects inspect lookup identity in distributed traces.
func TestTelemetryMultipleExecutionsShareTraceWithoutOverwrite(t *testing.T) {
	manager := newTestManager(t)
	parent := trace.NewSpanContext(trace.SpanContextConfig{TraceID: trace.TraceID{1}, SpanID: trace.SpanID{1}, TraceFlags: trace.FlagsSampled, Remote: true})
	var ids []string
	for range 2 {
		ctx := manager.Begin(trace.ContextWithRemoteSpanContext(context.Background(), parent), runtime.SourceHTTP, "GET /probe", nil)
		ids = append(ids, InspectIDFromContext(ctx))
		manager.Finish(ctx, "ok", nil)
	}
	if ids[0] == ids[1] {
		t.Fatal("inspect lookup IDs collided")
	}
	summaries, err := manager.Recent(context.Background(), RecentQuery{})
	if err != nil || len(summaries) != 2 {
		t.Fatalf("shared trace overwrote an execution: %v, %v", summaries, err)
	}
	for _, summary := range summaries {
		if summary.OTelTraceID != parent.TraceID().String() {
			t.Fatal("trace identity changed")
		}
	}
}

// fixedSpanIDGenerator exercises the OTel contract that span IDs need only be unique within a trace.
type fixedSpanIDGenerator struct{}

// NewIDs supplies a valid root identity for the generator interface.
func (fixedSpanIDGenerator) NewIDs(context.Context) (trace.TraceID, trace.SpanID) {
	return trace.TraceID{9}, trace.SpanID{3}
}

// NewSpanID deliberately reuses an ID across different incoming traces.
func (fixedSpanIDGenerator) NewSpanID(context.Context, trace.TraceID) trace.SpanID {
	return trace.SpanID{3}
}

// TestTelemetryProjectionScopesSpanIdentityToTrace protects concurrent incoming traces using equal span IDs.
func TestTelemetryProjectionScopesSpanIdentityToTrace(t *testing.T) {
	manager := newTestManager(t)
	if err := manager.Shutdown(context.Background()); err != nil {
		t.Fatal(err)
	}
	manager.tracing.provider = sdktrace.NewTracerProvider(sdktrace.WithIDGenerator(fixedSpanIDGenerator{}), sdktrace.WithSpanProcessor(&lighthouseProcessor{manager: manager}))
	manager.tracing.tracer = manager.tracing.provider.Tracer("github.com/goforj/goforj")
	defer manager.Shutdown(context.Background())
	var contexts []context.Context
	for _, id := range []byte{1, 2} {
		parent := trace.NewSpanContext(trace.SpanContextConfig{TraceID: trace.TraceID{id}, SpanID: trace.SpanID{2}, TraceFlags: trace.FlagsSampled, Remote: true})
		contexts = append(contexts, manager.Begin(trace.ContextWithRemoteSpanContext(context.Background(), parent), runtime.SourceHTTP, "request", nil))
	}
	for index, ctx := range contexts {
		manager.Finish(ctx, "ok", nil)
		record, ok, err := manager.ByID(context.Background(), InspectIDFromContext(ctx))
		expected := trace.TraceID{byte(index + 1)}
		if err != nil || !ok || record.Summary.OTelTraceID != expected.String() {
			t.Fatalf("trace identity collision: %+v, %v", record, err)
		}
	}
}

// TestTelemetryNestedExecutionsHaveIndependentLifecycles preserves sync job and nested schedule boundaries.
func TestTelemetryNestedExecutionsHaveIndependentLifecycles(t *testing.T) {
	manager := newTestManager(t)
	outer := manager.Begin(context.Background(), runtime.SourceJobs, "outer", nil)
	inner := manager.Begin(outer, runtime.SourceJobs, "inner", nil)
	if InspectIDFromContext(outer) == InspectIDFromContext(inner) {
		t.Fatal("nested executions share one lifecycle")
	}
	manager.Finish(inner, "ok", nil)
	manager.Finish(outer, "ok", nil)
	outerRecord, _, _ := manager.ByID(context.Background(), InspectIDFromContext(outer))
	innerRecord, _, _ := manager.ByID(context.Background(), InspectIDFromContext(inner))
	if outerRecord.Summary.OTelTraceID != innerRecord.Summary.OTelTraceID || innerRecord.Summary.ParentSpanID != outerRecord.Summary.SpanID {
		t.Fatal("nested execution lost its OTel parent")
	}
}

// TestTelemetryPreservesRuntimeSourceWithoutCapture keeps OTel enablement from changing existing metric labels.
func TestTelemetryPreservesRuntimeSourceWithoutCapture(t *testing.T) {
	for _, source := range []runtime.Source{"", runtime.SourceHTTP} {
		manager := newTestManager(t)
		manager.tracing.external = true
		manager.SetCaptureGate(func() bool { return false })
		original := runtime.WithSource(context.Background(), source)
		ctx := manager.Begin(original, runtime.SourceHTTP, "request", nil)
		if got := runtime.SourceFromContext(ctx); got != source {
			t.Fatalf("runtime source changed from %q to %q", source, got)
		}
		manager.Finish(ctx, "ok", nil)
	}
}

