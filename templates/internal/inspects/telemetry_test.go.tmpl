// telemetryDiagnosticExporter exposes typed failures and call arguments for wrapper validation.
type telemetryDiagnosticExporter struct {
	failure     error
	exportCtx   context.Context
	shutdownCtx context.Context
	spans       []sdktrace.ReadOnlySpan
}

// ExportSpans records the unchanged export call and returns the selected result.
func (e *telemetryDiagnosticExporter) ExportSpans(ctx context.Context, spans []sdktrace.ReadOnlySpan) error {
	e.exportCtx = ctx
	e.spans = spans
	return e.failure
}

// Shutdown records cleanup ownership and returns the selected result.
func (e *telemetryDiagnosticExporter) Shutdown(ctx context.Context) error {
	e.shutdownCtx = ctx
	return e.failure
}

// TestTelemetryExporterErrorContract preserves results and structured dependency inspection without leaking strings.
func TestTelemetryExporterErrorContract(t *testing.T) {
	ctx := context.WithValue(context.Background(), struct{}{}, "marker")
	spans := []sdktrace.ReadOnlySpan{nil}
	for _, cause := range []error{nil, context.Canceled, context.DeadlineExceeded, &url.Error{Op: "Post", URL: "https://collector.invalid/ingest/fake-review-path-token", Err: errors.New("fake-review-body-token")}} {
		delegate := &telemetryDiagnosticExporter{failure: cause}
		wrapped := telemetryExporter{SpanExporter: delegate}
		for _, operation := range []string{"export", "shutdown"} {
			var err error
			if operation == "export" {
				err = wrapped.ExportSpans(ctx, spans)
			} else {
				err = wrapped.Shutdown(ctx)
			}
			if cause == nil {
				if err != nil {
					t.Fatal("successful operation changed")
				}
				continue
			}
			if err == nil || err.Error() != "OTLP trace "+operation+" failed" || strings.Contains(fmt.Sprintf("%v", err), "fake-review-") {
				t.Fatal("diagnostic leaked or error disappeared")
			}
			if !errors.Is(err, cause) {
				t.Fatal("errors.Is lost underlying result")
			}
			if original, ok := cause.(*url.Error); ok {
				var typed *url.Error
				if !errors.As(err, &typed) || typed != original {
					t.Fatal("errors.As lost typed failure")
				}
			}
		}
		if delegate.exportCtx != ctx || delegate.shutdownCtx != ctx || len(delegate.spans) != 1 || &delegate.spans[0] != &spans[0] {
			t.Fatal("wrapper changed delegated arguments")
		}
	}
}

