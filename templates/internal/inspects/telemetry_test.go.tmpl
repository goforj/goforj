// reentrantInspectPublisher exposes synchronous publisher callbacks to lifecycle regressions.
type reentrantInspectPublisher func(Record)

// Publish exercises the manager's public callback boundary without adding its own locks.
func (p reentrantInspectPublisher) Publish(record Record) { p(record) }

// TestTelemetryPublisherReentry preserves callback access after the finishing recorder has been detached.
func TestTelemetryPublisherReentry(t *testing.T) {
	for _, source := range []runtime.Source{runtime.SourceHTTP, runtime.SourceCLI} {
		for _, operation := range []string{"capture query", "application span", "nested execution", "inspect ID log and read"} {
			t.Run(source.String()+"/"+operation, func(t *testing.T) {
				manager := newTestManager(t)
				defer manager.Shutdown(context.Background())
				ctx := manager.Begin(context.Background(), source, "request", nil)
				recorder := RecorderFromContext(ctx)
				recorder.RecordEvent(InspectEvent{Kind: EventKindLog, Message: "original request payload"})
				rootID := recorder.InspectID()
				var callbackCalls atomic.Int64
				var callbackErr error
				manager.SetPublisher(reentrantInspectPublisher(func(record Record) {
					// Nested execution completion also publishes; only reenter for the original request.
					if record.Summary.TraceID != rootID {
						return
					}
					callbackCalls.Add(1)
					switch operation {
					case "capture query":
						if manager.Capturing(ctx) {
							callbackErr = fmt.Errorf("finished request still captures during publication")
						}
					case "application span":
						_, child := manager.TracerProvider().Tracer("publisher").Start(ctx, "publish")
						child.End()
					case "inspect ID log and read":
						inspectCtx := WithInspectID(context.Background(), rootID)
						manager.RecordLog(inspectCtx, LogInspectEvent{Message: "late callback log"})
						stored, ok, err := manager.ByID(inspectCtx, rootID)
						if err != nil || !ok || stored.Summary.Status != "ok" || len(stored.Events) != 1 || stored.Events[0].Message != "original request payload" {
							callbackErr = fmt.Errorf("finished indexed capture unavailable during callback: record=%+v, exists=%v, error=%v", stored, ok, err)
						}
					case "nested execution":
						nested := manager.Begin(ctx, runtime.SourceApp, "publish", nil)
						manager.RecordLog(nested, LogInspectEvent{Message: "nested payload"})
						manager.Finish(nested, "ok", nil)
					}
					if record.Summary.TraceID != rootID || len(record.Events) != 1 || record.Events[0].Message != "original request payload" {
						callbackErr = fmt.Errorf("publication payload changed during callback: %+v", record)
					}
				}))
				finished := make(chan struct{})
				go func() {
					manager.Finish(ctx, "ok", nil)
					close(finished)
				}()
				select {
				case <-finished:
				case <-time.After(2 * time.Second):
					t.Fatal("publisher callback blocked request completion")
				}
				if callbackErr != nil {
					t.Fatal(callbackErr)
				}
				if got := callbackCalls.Load(); got != 1 {
					t.Fatalf("root callback calls = %d, want 1", got)
				}
				record, ok, err := manager.ByID(context.Background(), rootID)
				if err != nil || !ok || record.Summary.Name != "request" || record.Summary.Status != "ok" || len(record.Events) != 1 || record.Events[0].Message != "original request payload" {
					t.Fatalf("finished request payload was not preserved: record=%+v, exists=%v, error=%v", record, ok, err)
				}
				manager.tracing.mu.Lock()
				associations := len(manager.tracing.owners)
				indexedChildren := len(recorder.childSpans)
				inlineChild := recorder.childSpan
				manager.tracing.mu.Unlock()
				if associations != 0 || indexedChildren != 0 || inlineChild != (spanIdentity{}) {
					t.Fatalf("publication retained span associations: owners=%d, children=%d, inline=%v", associations, indexedChildren, inlineChild)
				}
				if inflight := manager.inflightCount.Load(); inflight != 0 {
					t.Fatalf("publication retained %d inflight captures", inflight)
				}
			})
		}
	}
}

// TestTelemetryNativeRootExceptionsSurviveFailure preserves explicit exception events when the framework also records a terminal failure.
func TestTelemetryNativeRootExceptionsSurviveFailure(t *testing.T) {
	m := newTestManager(t)
	defer m.Shutdown(context.Background())
	exporter := tracetest.NewInMemoryExporter()
	m.TracerProvider().RegisterSpanProcessor(sdktrace.NewSimpleSpanProcessor(exporter))
	ctx := m.Begin(context.Background(), runtime.SourceHTTP, "request", nil)
	span := trace.SpanFromContext(ctx)
	span.RecordError(errors.New("explicit application exception"), trace.WithAttributes(attribute.String("stage", "application")))
	span.AddEvent("exception", trace.WithAttributes(attribute.String("exception.message", "third-party exception"), attribute.String("stage", "third-party")))
	frameworkErr := errors.New("private framework terminal error")
	m.Finish(ctx, "error", frameworkErr)
	record, ok, err := m.ByID(context.Background(), InspectIDFromContext(ctx))
	if err != nil || !ok {
		t.Fatal("missing inspect")
	}
	projected := map[string]bool{}
	frameworkLocal := 0
	for _, event := range record.Events {
		if event.Name == "exception" {
			if event.Attributes["exception.message"] == "execution failed" {
				t.Fatal("generic framework exception was duplicated in Lighthouse")
			}
			if stage, ok := event.Attributes["stage"].(string); ok {
				projected[stage] = true
			}
		}
		if event.Kind == EventKindError && event.Message == frameworkErr.Error() {
			frameworkLocal++
		}
	}
	if !projected["application"] || !projected["third-party"] || frameworkLocal != 1 {
		t.Fatalf("Lighthouse lost explicit events or local framework detail: %+v", record.Events)
	}
	spans := exporter.GetSpans()
	if len(spans) != 1 {
		t.Fatalf("SDK spans=%d", len(spans))
	}
	sdkExplicit := map[string]bool{}
	sdkGeneric := 0
	for _, event := range spans[0].Events {
		attrs := telemetryAttributes(event.Attributes)
		for _, value := range event.Attributes {
			if strings.Contains(value.Value.Emit(), frameworkErr.Error()) {
				t.Fatal("SDK exposed raw framework error")
			}
		}
		if event.Name != "exception" {
			continue
		}
		if stage, ok := attrs["stage"].(string); ok {
			sdkExplicit[stage] = true
		}
		if attrs["exception.message"] == "execution failed" {
			sdkGeneric++
			if attrs["goforj.inspect.event"] != true {
				t.Fatal("framework exception lacks duplicate marker")
			}
		}
	}
	if !sdkExplicit["application"] || !sdkExplicit["third-party"] || sdkGeneric != 1 {
		t.Fatalf("SDK lost explicit or generic events: %+v", spans[0].Events)
	}
}

