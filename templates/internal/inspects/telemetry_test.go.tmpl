	newRoot.End()
	manager.Finish(ctx, "ok", nil)
	spans := exporter.GetSpans()
	if len(spans) != 4 {
		t.Fatalf("exported spans = %d, want all four SDK spans", len(spans))
	}
	for _, span := range spans[:2] {
		if span.SpanContext.TraceID() != spans[2].SpanContext.TraceID() || span.Parent.SpanID() != spans[2].SpanContext.SpanID() {
			t.Fatalf("span %q lost its independent trace or parent relationship", span.Name)
		}
	}
	if spans[0].Name != "cache get" || spans[0].SpanKind != trace.SpanKindClient {
		t.Fatal("cache operation lost its SDK client span")
	}
	if spans[2].SpanContext.TraceID() == spans[3].SpanContext.TraceID() {
		t.Fatal("WithNewRoot did not create an independent trace")
	}
	record, ok, err := manager.ByID(context.Background(), InspectIDFromContext(ctx))
	if err != nil || !ok {
		t.Fatalf("captured execution missing: %v", err)
	}
	if len(record.Events) != 1 || record.Events[0].Kind != EventKindCache {
		t.Fatalf("rich cache event missing or unrelated native spans projected: %+v", record.Events)
	}
	if record.Events[0].SpanID != "" || record.Events[0].ParentSpanID != "" {
		t.Fatalf("rich event carries an unrelated trace identity: %+v", record.Events[0])
	}
}

// TestTelemetryFrameworkErrorPrivacy keeps framework error enrichment local while preserving application OTel policy.
func TestTelemetryFrameworkErrorPrivacy(t *testing.T) {
	manager := newTestManager(t)
	defer manager.Shutdown(context.Background())
	exporter := tracetest.NewInMemoryExporter()
	manager.TracerProvider().RegisterSpanProcessor(sdktrace.NewSimpleSpanProcessor(exporter))
	const privateMessage = "invalid request password=private-framework-password"
	ctx := manager.Begin(context.Background(), runtime.SourceHTTP, "POST /login", nil)
	_, app := manager.TracerProvider().Tracer("example/app").Start(ctx, "application-controlled-error")
	app.RecordError(errors.New(privateMessage))
	app.End()
	manager.Finish(ctx, "error", errors.New(privateMessage))
	record, ok, err := manager.ByID(context.Background(), InspectIDFromContext(ctx))
	if err != nil || !ok {
		t.Fatalf("framework error inspect missing: %v", err)
	}
	localError := false
	for _, event := range record.Events {
		if event.Kind == EventKindError && event.Message == privateMessage {
			localError = true
		}
	}
	if !localError {
		t.Fatal("raw framework error missing from local Lighthouse enrichment")
	}
	rootException, appException := false, false
	for _, span := range exporter.GetSpans() {
		for _, event := range span.Events {
			if event.Name != "exception" {
				continue
			}
			exceptionType, exceptionMessage := "", ""
			for _, attr := range event.Attributes {
				switch string(attr.Key) {
				case "exception.type":
					exceptionType = attr.Value.AsString()
				case "exception.message":
					exceptionMessage = attr.Value.AsString()
				}
				if span.Name != "application-controlled-error" && strings.Contains(attr.Value.Emit(), "private-framework-password") {
					t.Fatal("raw framework error escaped through an SDK exception attribute")
				}
			}
			if span.Name == "application-controlled-error" {
				appException = exceptionMessage == privateMessage
			} else {
				rootException = exceptionType != "" && exceptionMessage != "" && exceptionMessage != privateMessage
			}
		}
	}
	if !rootException {
		t.Fatal("framework exception must retain type and a safe nonempty message")
	}
	if !appException {
		t.Fatal("explicit application RecordError capture policy changed")
	}
}

// TestTelemetryMalformedHeaderPrivacy checks the SDK's actual process logger without changing shared logging state.
func TestTelemetryMalformedHeaderPrivacy(t *testing.T) {
	for _, protocol := range []string{"http/protobuf", "grpc"} {
		for _, key := range []string{"OTEL_EXPORTER_OTLP_HEADERS", "OTEL_EXPORTER_OTLP_TRACES_HEADERS"} {
			for _, item := range []struct{ name, value string }{
				{"missing_equals", "private-header-secret"},
				{"empty_key", "=private-header-secret"},
				{"invalid_key", "private header secret=value"},
				{"invalid_escape", "Authorization=Bearer%20private-header-secret%zz"},
				{"trailing_separator", "Authorization=private-header-secret,"},
			} {
				t.Run(protocol+"/"+key+"/"+item.name, func(t *testing.T) {
					command := exec.Command(os.Args[0], "-test.run=^TestTelemetryHeaderPrivacySubprocess$", "-test.count=1")
					for _, entry := range os.Environ() {
						if strings.HasPrefix(entry, "OTEL_") || strings.HasPrefix(entry, "LIGHTHOUSE_") || strings.HasPrefix(entry, "GOFORJ_HEADER_PRIVACY_") {
							continue
						}
						command.Env = append(command.Env, entry)
					}
					command.Env = append(command.Env,
						"GOFORJ_HEADER_PRIVACY_CHILD=1", "GOFORJ_HEADER_PRIVACY_KEY="+key,
						"OTEL_TRACES_EXPORTER=otlp", "OTEL_TRACES_SAMPLER=always_on",
						"OTEL_EXPORTER_OTLP_TRACES_PROTOCOL="+protocol,
						"OTEL_EXPORTER_OTLP_HEADERS=X-Valid=generic", "OTEL_EXPORTER_OTLP_TRACES_HEADERS=X-Valid=signal",
					)
					// Replace the selected variable so generic validation still runs when a valid signal override exists.
					filtered := command.Env[:0]
					for _, entry := range command.Env {
						if !strings.HasPrefix(entry, key+"=") {
							filtered = append(filtered, entry)
						}
					}
					command.Env = append(filtered, key+"="+item.value)
					output, err := command.CombinedOutput()
					if strings.Contains(string(output), "private-header-secret") || strings.Contains(string(output), "private header secret") {
						t.Fatal("malformed OTLP credentials escaped into process output")
					}
					if err != nil {
						t.Fatalf("header prevalidation failed: %v; output: %s", err, output)
					}
				})
			}
		}
	}
}

// TestTelemetryHeaderPrivacySubprocess isolates the SDK global logger and captures all malformed-header diagnostics in its parent.
func TestTelemetryHeaderPrivacySubprocess(t *testing.T) {
	if os.Getenv("GOFORJ_HEADER_PRIVACY_CHILD") != "1" {
		t.Skip("invoked by malformed-header privacy matrix")
	}
	t.Setenv("LIGHTHOUSE_ENABLED", "true")
	t.Setenv("LIGHTHOUSE_INSPECT_ENABLED", "true")
	manager := NewManager()
	defer manager.Shutdown(context.Background())
	previousProvider := manager.TracerProvider()
	err := manager.ConfigureTelemetry(context.Background())
	if err == nil {
		t.Fatal("accepted malformed OTLP header configuration")
	}
	if !strings.Contains(err.Error(), os.Getenv("GOFORJ_HEADER_PRIVACY_KEY")) {
		t.Fatal("header validation error must identify the setting without its secret value")
	}
	if strings.Contains(err.Error(), "private-header-secret") || strings.Contains(err.Error(), "private header secret") {
		t.Fatal("header validation error exposed a credential")
	}
	if manager.TracerProvider() != previousProvider {
		t.Fatal("rejected header configuration replaced the previous provider")
	}
	ctx := manager.Begin(context.Background(), runtime.SourceHTTP, "GET /after-invalid-config", nil)
	if RecorderFromContext(ctx) == nil {
		t.Fatal("rejected header configuration shut down the previous provider")
	}
	manager.Finish(ctx, "ok", nil)
}

