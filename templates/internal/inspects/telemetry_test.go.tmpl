			exporter := tracetest.NewInMemoryExporter()
			manager.TracerProvider().RegisterSpanProcessor(sdktrace.NewSimpleSpanProcessor(exporter))
			ctx := manager.Begin(context.Background(), runtime.SourceHTTP, "canceled", nil)
			var terminalError error
			switch mode {
			case "error":
				terminalError = context.Canceled
			case "wrapped-error":
				terminalError = errors.Join(errors.New("request stopped"), context.Canceled)
			}
			manager.Finish(ctx, "canceled", terminalError)
			record, ok, err := manager.ByID(context.Background(), InspectIDFromContext(ctx))
