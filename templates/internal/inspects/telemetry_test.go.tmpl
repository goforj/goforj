// telemetryPrivacyRoundTripper exposes the wire request without remote network access.
type telemetryPrivacyRoundTripper func(*http.Request) (*http.Response, error)

// RoundTrip invokes the test transport without changing the request.
func (f telemetryPrivacyRoundTripper) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }

// TestTelemetryHTTPClientURLPrivacy preserves wire semantics while omitting credential carriers.
func TestTelemetryHTTPClientURLPrivacy(t *testing.T) {
	m := newTestManager(t)
	defer m.Shutdown(context.Background())
	exporter := tracetest.NewInMemoryExporter()
	m.TracerProvider().RegisterSpanProcessor(sdktrace.NewSimpleSpanProcessor(exporter))
	ctx, parent := m.TracerProvider().Tracer("application/privacy").Start(context.Background(), "parent")
	const destination = "https://review-user:fake-review-password@example.invalid:8443/objects/report.csv?X-Amz-Signature=fake-review-signature&access_token=fake-review-token&custom_signed_name=opaque-value#fake-review-fragment"
	var wireURL string
	var propagated trace.SpanContext
	transport := telemetryPrivacyRoundTripper(func(r *http.Request) (*http.Response, error) {
		wireURL = r.URL.String()
		propagated = trace.SpanContextFromContext((propagation.TraceContext{}).Extract(context.Background(), propagation.HeaderCarrier(r.Header)))
		return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader("ok")), Request: r}, nil
	})
	base := &http.Client{Transport: transport}
	client := m.HTTPClient(base)
	req, _ := http.NewRequestWithContext(ctx, http.MethodGet, destination, nil)
	resp, err := client.Do(req)
	if err != nil {
		t.Fatal(err)
	}
	_, _ = io.ReadAll(resp.Body)
	_ = resp.Body.Close()
	if wireURL != destination || req.URL.String() != destination {
		t.Fatal("privacy handling changed the wire or caller URL")
	}
	parent.End()
	spans := exporter.GetSpans()
	if len(spans) != 2 {
		t.Fatalf("span count = %d, want 2", len(spans))
	}
	clientSpan := spans[0]
	if clientSpan.SpanKind != trace.SpanKindClient || clientSpan.Parent.SpanID() != parent.SpanContext().SpanID() || clientSpan.SpanContext.TraceID() != parent.SpanContext().TraceID() {
		t.Fatal("parent identity changed")
	}
	if !propagated.Equal(clientSpan.SpanContext.WithRemote(true)) {
		t.Fatal("propagation does not identify client span")
	}
	attrs := map[attribute.Key]attribute.Value{}
	for _, item := range clientSpan.Attributes {
		attrs[item.Key] = item.Value
		if strings.Contains(item.Value.Emit(), "fake-review-") || strings.Contains(item.Value.Emit(), "opaque-value") {
			t.Fatal("credential entered attributes")
		}
	}
	if attrs["url.full"].AsString() != "https://example.invalid:8443/objects/report.csv" {
		t.Fatalf("sanitized URL = %q", attrs["url.full"].AsString())
	}
	if attrs["server.address"].AsString() != "example.invalid" || attrs["server.port"].AsInt64() != 8443 || attrs["http.request.method"].AsString() != "GET" || attrs["http.response.status_code"].AsInt64() != 200 {
		t.Fatalf("standard metadata changed: %v", attrs)
	}
	if base.Transport == nil || http.DefaultClient.Transport != nil {
		t.Fatal("construction changed shared transport")
	}
}

// TestTelemetryHTTPClientErrorPrivacy retains caller errors without exporting dependency details.
func TestTelemetryHTTPClientErrorPrivacy(t *testing.T) {
	m := newTestManager(t)
	defer m.Shutdown(context.Background())
	exporter := tracetest.NewInMemoryExporter()
	m.TracerProvider().RegisterSpanProcessor(sdktrace.NewSimpleSpanProcessor(exporter))
	original := errors.New("upstream rejected credential fake-review-error-token")
	client := m.HTTPClient(&http.Client{Transport: telemetryPrivacyRoundTripper(func(*http.Request) (*http.Response, error) { return nil, original })})
	_, err := client.Get("https://example.invalid/resource?custom_auth=fake-review-query-token")
	if !errors.Is(err, original) || !strings.Contains(err.Error(), "fake-review-error-token") {
		t.Fatal("caller lost original error")
