// TestTelemetryNativeEndConcurrentFinish protects terminal state when callers also use the native SDK span handle.
func TestTelemetryNativeEndConcurrentFinish(t *testing.T) {
	manager := newTestManager(t)
	for range 200 {
		ctx := manager.Begin(context.Background(), runtime.SourceHTTP, "request", nil)
		span := trace.SpanFromContext(ctx)
		start := make(chan struct{})
		var wg sync.WaitGroup
		wg.Add(2)
		go func() {
			defer wg.Done()
			<-start
			span.End()
		}()
		go func() {
			defer wg.Done()
			<-start
			manager.Finish(ctx, "canceled", context.Canceled)
