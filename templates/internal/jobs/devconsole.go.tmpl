package jobs

import (
	"context"
	"encoding/json"
	"fmt"
	"{{.GoModuleName}}/internal/devconsole"
	"github.com/goforj/env/v2"
	"github.com/hibiken/asynq"
	"github.com/redis/go-redis/v9"
	"{{.GoModuleName}}/internal/logger"
	"{{.GoModuleName}}/internal/queue"
