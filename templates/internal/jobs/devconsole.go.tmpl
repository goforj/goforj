package jobs

import (
	"context"
	"fmt"
	"sort"
	"time"

	"{{.GoModuleName}}/internal/devconsole"
	"{{.GoModuleName}}/internal/logger"
	"github.com/goforj/queue"
)

// StartDevConsoleAgent boots the dev console agent for the jobs process.
func StartDevConsoleAgent(ctx context.Context, logger *logger.AppLogger, appQueue *queue.Queue) {
	if !devconsole.Enabled() {
		return
	}
	agent := devconsole.NewAgent(devconsole.LoadAgentConfig("jobs"))
	logger.AddSink(devconsole.NewLogSink(agent))
	agent.RegisterCapability("cli")
	agent.RegisterCapability("jobs")
	if appQueue != nil {
		agent.RegisterCapability("asynq")
	}

	agent.RegisterCommand("cli:run", func(cmd devconsole.Command) (any, error) {
		params, err := devconsole.Decode[struct {
			Args []string `json:"args"`
		}](cmd)
		if err != nil {
			return nil, err
		}
		result, _ := devconsole.RunCLICommand(ctx, params.Args)
		return map[string]any{"result": result}, nil
	})

	agent.RegisterCommand("cli:list", func(cmd devconsole.Command) (any, error) {
		commands, err := devconsole.ListCLICommands(ctx)
		if err != nil {
			return nil, err
		}
		return map[string]any{"commands": commands}, nil
	})

	agent.RegisterCommand("asynq:queues", func(cmd devconsole.Command) (any, error) {
		snapshot, err := queueStats(ctx, appQueue)
		if err != nil {
			return nil, err
		}
		queues := make([]QueueSnapshot, 0, len(snapshot.ByQueue))
		names := make([]string, 0, len(snapshot.ByQueue))
		for name := range snapshot.ByQueue {
			names = append(names, name)
		}
		sort.Strings(names)
		now := time.Now().Format(time.RFC3339)
		for _, name := range names {
			counters := snapshot.ByQueue[name]
			queues = append(queues, QueueSnapshot{
				Name:       name,
				Pending:    int(counters.Pending),
				Active:     int(counters.Active),
				Scheduled:  int(counters.Scheduled),
				Retry:      int(counters.Retry),
				Archived:   int(counters.Archived),
				Processed:  int(counters.Processed),
				Failed:     int(counters.Failed),
				Paused:     counters.Paused > 0,
				Timestamp:  now,
			})
		}
		return map[string]any{"queues": queues}, nil
	})

	agent.RegisterCommand("asynq:queue:pause", func(cmd devconsole.Command) (any, error) {
		params, err := devconsole.Decode[struct {
			Queue string `json:"queue"`
		}](cmd)
		if err != nil {
			return nil, err
		}
		if params.Queue == "" {
			return nil, fmt.Errorf("queue is required")
		}
		if appQueue == nil {
			return nil, fmt.Errorf("queue is not configured")
		}
		if err := appQueue.Pause(ctx, params.Queue); err != nil {
			return nil, err
		}
		return map[string]any{"ok": true}, nil
	})

	agent.RegisterCommand("asynq:queue:resume", func(cmd devconsole.Command) (any, error) {
		params, err := devconsole.Decode[struct {
			Queue string `json:"queue"`
		}](cmd)
		if err != nil {
			return nil, err
		}
		if params.Queue == "" {
			return nil, fmt.Errorf("queue is required")
		}
		if appQueue == nil {
			return nil, fmt.Errorf("queue is not configured")
		}
		if err := appQueue.Resume(ctx, params.Queue); err != nil {
			return nil, err
		}
		return map[string]any{"ok": true}, nil
	})

	unsupported := func(op string) func(devconsole.Command) (any, error) {
		return func(cmd devconsole.Command) (any, error) {
			return nil, fmt.Errorf("%s is unavailable without backend-specific inspector", op)
		}
	}
	agent.RegisterCommand("asynq:queue:history", unsupported("queue history"))
	agent.RegisterCommand("asynq:jobs", unsupported("job listing"))
	agent.RegisterCommand("asynq:job:cancel", unsupported("job cancel"))
	agent.RegisterCommand("asynq:job:delete", unsupported("job delete"))
	agent.RegisterCommand("asynq:job:retry", unsupported("job retry"))
	agent.RegisterCommand("asynq:queue:clear", unsupported("queue clear"))

	agent.RegisterCommand("queue:metrics", func(cmd devconsole.Command) (any, error) {
		params, err := devconsole.Decode[struct {
			Queue string `json:"queue"`
		}](cmd)
		if err != nil {
			return nil, err
		}
		if params.Queue == "" {
			return nil, fmt.Errorf("queue is required")
		}
		snapshot, err := queueStats(ctx, appQueue)
		if err != nil {
			return nil, err
		}
		counters, ok := snapshot.ByQueue[params.Queue]
		if !ok {
			return map[string]any{"points": []QueueMetricPoint{}}, nil
		}
		now := time.Now()
		point := QueueMetricPoint{
			Queue:     params.Queue,
			Timestamp: now.Unix(),
			Date:      now.Format(time.RFC3339),
			Processed: int(counters.Processed),
			Failed:    int(counters.Failed),
			Pending:   int(counters.Pending),
			Active:    int(counters.Active),
			Scheduled: int(counters.Scheduled),
			Retry:     int(counters.Retry),
			Archived:  int(counters.Archived),
		}
		return map[string]any{"points": []QueueMetricPoint{point}}, nil
	})

	go func() {
		_ = agent.Start(ctx)
	}()
}

func queueStats(ctx context.Context, appQueue *queue.Queue) (queue.StatsSnapshot, error) {
	if appQueue == nil {
		return queue.StatsSnapshot{}, fmt.Errorf("queue is not configured")
	}
	return appQueue.Stats(ctx)
}

// QueueSnapshot describes a queue state for the dev console.
type QueueSnapshot struct {
	Name      string `json:"name"`
	Pending   int    `json:"pending"`
	Active    int    `json:"active"`
	Scheduled int    `json:"scheduled"`
	Retry     int    `json:"retry"`
	Archived  int    `json:"archived"`
	Processed int    `json:"processed"`
	Failed    int    `json:"failed"`
	Paused    bool   `json:"paused"`
	Timestamp string `json:"timestamp"`
}

// QueueMetricPoint describes a queue metrics snapshot for charting.
type QueueMetricPoint struct {
	Queue     string `json:"queue"`
	Timestamp int64  `json:"ts"`
	Date      string `json:"date"`
	Processed int    `json:"processed"`
	Failed    int    `json:"failed"`
	Pending   int    `json:"pending"`
	Active    int    `json:"active"`
	Scheduled int    `json:"scheduled"`
	Retry     int    `json:"retry"`
	Archived  int    `json:"archived"`
}
