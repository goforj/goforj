package jobs

import (
	"context"
	"encoding/json"
	"fmt"
	"github.com/hibiken/asynq"
	"{{.GoModuleName}}/internal/queue"
	"time"
)

// ExampleHelloJob is a struct that represents a job for sending a hello message.
type ExampleHelloJob struct {
	dispatcher queue.Dispatcher
}

const ExampleHelloJobTypeName = "hello"

// ExampleHelloJobPayload is the payload for the ExampleHelloJob.
type ExampleHelloJobPayload struct {
	User   string `json:"user"`
}

// NewExampleHelloJob creates a new ExampleHelloJob with the given queue.
func NewExampleHelloJob(dispatcher queue.Dispatcher) *ExampleHelloJob {
	job := &ExampleHelloJob{dispatcher: dispatcher}
	if dispatcher != nil {
		dispatcher.Register(ExampleHelloJobTypeName, job.HandleTask)
	}
	return job
}

// Queue enqueues a task with the given name.
func (t *ExampleHelloJob) Queue(name string) error {
	var p ExampleHelloJobPayload
	p.User = name

	payload, err := json.Marshal(p)
	if err != nil {
		return err
	}
	if t.dispatcher == nil {
		return fmt.Errorf("queue dispatcher unavailable")
	}
	return t.dispatcher.Enqueue(
		context.Background(),
		queue.Task{Type: ExampleHelloJobTypeName, Payload: payload},
		queue.WithTimeout(3*time.Minute),
	)
}

// Handle processes the task and sends a hello message.
func (t *ExampleHelloJob) Handle(ctx context.Context, task *asynq.Task) error {
	return t.handlePayload(ctx, task.Payload())
}

// HandleTask processes queue.Task payloads.
func (t *ExampleHelloJob) HandleTask(ctx context.Context, task queue.Task) error {
	return t.handlePayload(ctx, task.Payload)
}

func (t *ExampleHelloJob) handlePayload(_ context.Context, payload []byte) error {
	var p ExampleHelloJobPayload
	if err := json.Unmarshal(payload, &p); err != nil {
		return fmt.Errorf("json.Unmarshal failed: %v: %w", err, asynq.SkipRetry)
	}
	fmt.Printf("Hello %v!\n", p.User)
	return nil
}
