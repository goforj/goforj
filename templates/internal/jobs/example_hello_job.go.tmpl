package jobs

import (
	"context"
	"encoding/json"
	"fmt"
	"{{.GoModuleName}}/internal/queues"
	"github.com/goforj/queue"
	"time"
)

// ExampleHelloJob is a struct that represents a job for sending a hello message.
type ExampleHelloJob struct {
	queues *queues.Manager
}

const ExampleHelloJobTypeName = "hello"

// ExampleHelloJobPayload is the payload for the ExampleHelloJob.
type ExampleHelloJobPayload struct {
	User string `json:"user"`
}

// NewExampleHelloJob creates a new ExampleHelloJob with the given queue manager.
func NewExampleHelloJob(queueManager *queues.Manager) *ExampleHelloJob {
	return &ExampleHelloJob{queues: queueManager}
}

// Queue enqueues a task with the given name.
func (t *ExampleHelloJob) Queue(name string) error {
	var p ExampleHelloJobPayload
	p.User = name

	payload, err := json.Marshal(p)
	if err != nil {
		return err
	}
	_, err = t.queues.Default().DispatchCtx(
		context.Background(),
		queue.NewJob(ExampleHelloJobTypeName).
			Payload(payload).
			Timeout(3*time.Minute),
	)
	return err
}

// HandleTask processes queue payloads.
func (t *ExampleHelloJob) HandleTask(_ context.Context, msg queue.Message) error {
	var p ExampleHelloJobPayload
	if err := msg.Bind(&p); err != nil {
		return fmt.Errorf("json.Unmarshal failed: %w", err)
	}
	fmt.Printf("Hello %v!\n", p.User)
	return nil
}
