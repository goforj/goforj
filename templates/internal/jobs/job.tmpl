const {{ .StructName }}TypeName = "{{ .TaskName }}"

// {{ .StructName }}Payload is the payload for the {{ .StructName }} job.
type {{ .StructName }}Payload struct {
	// add your payload fields here
}

// {{ .StructName }} is a struct that represents a queue job.
type {{ .StructName }} struct {
	dispatcher queue.Dispatcher
}

// New{{ .StructName }} creates a new {{ .StructName }} with the given queue.
func New{{ .StructName }}(dispatcher queue.Dispatcher) *{{ .StructName }} {
	job := &{{ .StructName }}{dispatcher: dispatcher}
	if dispatcher != nil {
		dispatcher.Register({{ .StructName }}TypeName, job.HandleTask)
	}
	return job
}

// Queue creates a new task and enqueues it to the queue.
// Add your inputs as args to the function
func (t *{{ .StructName }}) Queue(name string) error {
	var p {{ .StructName }}Payload
	// add your payload fields here
	// p.User = name

	payload, err := json.Marshal(p)
	if err != nil {
		return err
	}
	if t.dispatcher == nil {
		return fmt.Errorf("queue dispatcher unavailable")
	}
	return t.dispatcher.Enqueue(
		context.Background(),
		queue.Task{Type: {{ .StructName }}TypeName, Payload: payload},
		// queue.WithTimeout(1*time.Minute), // uncomment if you want to set a timeout
	)
}

// Handle processes the task from the queue.
func (t *{{ .StructName }}) Handle(ctx context.Context, task *asynq.Task) error {
	return t.handlePayload(ctx, task.Payload())
}

// HandleTask processes queue.Task payloads.
func (t *{{ .StructName }}) HandleTask(ctx context.Context, task queue.Task) error {
	return t.handlePayload(ctx, task.Payload)
}

func (t *{{ .StructName }}) handlePayload(_ context.Context, payload []byte) error {
	var p {{ .StructName }}Payload
	if err := json.Unmarshal(payload, &p); err != nil {
		return fmt.Errorf("json.Unmarshal failed: %v: %w", err, asynq.SkipRetry)
	}
	return nil
}
