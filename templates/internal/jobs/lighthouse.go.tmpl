// LighthouseRuntime boots the dev console agent for the jobs process.
type LighthouseRuntime struct {
	agent        *lighthouse.Agent
	logger       *logger.AppLogger
	queues       *queues.Manager
	defaultQueue *queue.Queue
	benchmarks   *benchmarkRunner
	inspects     *inspects.Manager
{{- if .ProjectComponents.Metrics }}
	metrics      *metrics.Manager
{{- end }}
}

