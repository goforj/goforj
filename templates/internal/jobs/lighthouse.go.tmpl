// enforceBenchmarkDriver reconciles benchmark metadata with each generated runtime driver contract.
func enforceBenchmarkDriver(report BenchmarkSuiteResult) BenchmarkSuiteResult {
	if report.Extra == nil {
		report.Extra = map[string]any{}
	}
	switch report.Suite {
{{- if .ProjectComponents.Cache }}
	case "cache":
		driver := runtime.NormalizeCacheDriver(fmt.Sprint(report.Extra["configured_driver"]))
		if driver == "" {
			driver = runtime.NormalizeCacheDriver(fmt.Sprint(report.Extra["driver"]))
		}
		if driver == "" {
			driver = runtime.NormalizeCacheDriver(report.Driver)
		}
		if driver == "" {
			driver = runtime.NormalizeCacheDriver(env.Get("CACHE_DRIVER", "memory"))
		}
		if driver == "" {
			driver = string(cachecore.DriverMemory)
		}
		report.Driver = driver
		report.Extra["driver"] = driver
		report.Extra["configured_driver"] = driver
{{- end }}
	case "queue":
		driver := runtime.NormalizeQueueDriver(fmt.Sprint(report.Extra["configured_driver"]))
		if driver == "" {
			driver = runtime.NormalizeQueueDriver(fmt.Sprint(report.Extra["driver"]))
		}
		if driver == "" {
			driver = runtime.NormalizeQueueDriver(report.Driver)
		}
		if driver != "" {
			report.Driver = driver
			report.Extra["driver"] = driver
			report.Extra["configured_driver"] = driver
		}
{{- if .ProjectComponents.Storage }}
	case "storage":
		driver := runtime.NormalizeStorageDriver(fmt.Sprint(report.Extra["driver"]))
		if driver == "" {
			driver = runtime.NormalizeStorageDriver(report.Driver)
		}
		if driver != "" {
			report.Driver = driver
			report.Extra["driver"] = driver
		}
{{- end }}
	case "db":
		driver := runtime.NormalizeDBDriver(fmt.Sprint(report.Extra["driver"]))
		if driver == "" {
			driver = runtime.NormalizeDBDriver(report.Driver)
		}
		if driver == "" {
			driver = runtime.NormalizeDBDriver(env.Get("DB_DRIVER", ""))
		}
		if driver != "" {
			report.Driver = driver
			report.Extra["driver"] = driver
		}
	}
	return report
}

