type lighthouseBenchmarkDBRecord struct {
	ID          uint64 `gorm:"primaryKey;autoIncrement:false"`
	Value       string `gorm:"size:512;not null"`
	UpdatedAtMS int64  `gorm:"column:updated_at_ms;not null"`
}

// TableName isolates benchmark records from application-owned tables.
func (lighthouseBenchmarkDBRecord) TableName() string {
	return "lighthouse_benchmark_records"
}

// runDBBenchmark selects a generated connection before starting a bounded benchmark run.
func runDBBenchmark(
	ctx context.Context,
	dbConnections *database.Connections,
	duration time.Duration,
	concurrency int,
	payloadSize int,
	started time.Time,
) (BenchmarkSuiteResult, error) {
	connectionNames := make([]string, 0, len(runtime.DiscoverDatabaseInstances()))
	for _, instance := range runtime.DiscoverDatabaseInstances() {
		connectionNames = append(connectionNames, normalizedBenchmarkName(instance.Name))
	}
	if len(connectionNames) == 0 {
		connectionNames = []string{"default"}
	}

	perConnection := make([]BenchmarkSuiteResult, 0, len(connectionNames))
	var totalOps int64
	var totalErrors int64
	var totalReadOps int64
	var totalUpdateOps int64
	var totalWriteOps int64
	var totalSeedRows int64
	var weightedP50 float64
	var weightedP95 float64
	var weightedP99 float64
	var totalWeight float64
	var totalOpsPerSec float64
	var maxElapsedMS int64
	errClasses := map[string]int64{}
	driversSeen := map[string]struct{}{}

	for _, name := range connectionNames {
		report, err := runDBBenchmarkConnection(ctx, dbConnections, name, duration, concurrency, payloadSize, started)
		if err != nil {
			return BenchmarkSuiteResult{}, err
		}
		perConnection = append(perConnection, report)
		totalOps += report.Ops
		totalErrors += report.Errors
		totalOpsPerSec += report.OpsPerSec
		if report.ElapsedMS > maxElapsedMS {
			maxElapsedMS = report.ElapsedMS
		}
		weight := float64(report.Ops)
		if weight <= 0 {
			weight = 1
		}
		totalWeight += weight
		weightedP50 += report.P50MS * weight
		weightedP95 += report.P95MS * weight
		weightedP99 += report.P99MS * weight

		if report.Extra != nil {
			if v, ok := report.Extra["read_ops"].(int64); ok {
				totalReadOps += v
			}
			if v, ok := report.Extra["update_ops"].(int64); ok {
				totalUpdateOps += v
			}
			if v, ok := report.Extra["write_ops"].(int64); ok {
				totalWriteOps += v
			}
			if v, ok := report.Extra["seed_rows"].(int); ok {
				totalSeedRows += int64(v)
			}
			if cls, ok := report.Extra["error_classes"].(map[string]int64); ok {
				for key, count := range cls {
					errClasses[key] += count
				}
			}
		}
		if report.Driver != "" {
			driversSeen[report.Driver] = struct{}{}
		}
	}
	if maxElapsedMS <= 0 {
		maxElapsedMS = int64(duration / time.Millisecond)
		if maxElapsedMS <= 0 {
			maxElapsedMS = 1
		}
	}
	if totalWeight <= 0 {
		totalWeight = 1
	}

	connectionRows := make([]map[string]any, 0, len(perConnection))
	for _, report := range perConnection {
		row := map[string]any{
			"name":        report.Queue,
			"driver":      report.Driver,
			"ops":         report.Ops,
			"ops_per_sec": report.OpsPerSec,
			"errors":      report.Errors,
			"p95_ms":      report.P95MS,
			"elapsed_ms":  report.ElapsedMS,
		}
		connectionRows = append(connectionRows, row)
	}

	driverLabel := "-"
	if len(driversSeen) > 0 {
		drivers := make([]string, 0, len(driversSeen))
		for d := range driversSeen {
			drivers = append(drivers, d)
		}
		sort.Strings(drivers)
		driverLabel = strings.Join(drivers, ",")
	}

	result := BenchmarkSuiteResult{
		Suite:       "db",
		Driver:      driverLabel,
		DurationMS:  int64(duration / time.Millisecond),
		Concurrency: concurrency,
		StartedAt:   started.UTC().Format(time.RFC3339),
		CompletedAt: time.Now().UTC().Format(time.RFC3339),
		ElapsedMS:   maxElapsedMS,
		Ops:         totalOps,
		OpsPerSec:   totalOpsPerSec,
		Errors:      totalErrors,
		P50MS:       weightedP50 / totalWeight,
		P95MS:       weightedP95 / totalWeight,
		P99MS:       weightedP99 / totalWeight,
		Extra: map[string]any{
			"profile":            "mixed",
			"connection_count":   len(perConnection),
			"connections":        connectionRows,
			"read_ops":           totalReadOps,
			"update_ops":         totalUpdateOps,
			"write_ops":          totalWriteOps,
			"seed_rows":          totalSeedRows,
			"driver":             driverLabel,
			"throughput_metric":  "db_ops_per_sec",
			"error_classes":      errClasses,
		},
	}
	enrichBenchmarkResult(&result)
	return result, nil
}

// runDBBenchmarkConnection confines writes to run-owned identifiers and records bounded latency samples.
func runDBBenchmarkConnection(
	ctx context.Context,
	dbConnections *database.Connections,
	connectionName string,
	duration time.Duration,
	concurrency int,
	payloadSize int,
	started time.Time,
) (BenchmarkSuiteResult, error) {
	warmup := benchmarkWarmup(duration)
	measureStart := started.Add(warmup)
	deadline := measureStart.Add(duration)
	db, err := dbConnections.Connection(connectionName)
	if err != nil {
		return BenchmarkSuiteResult{}, err
	}
	if err := db.WithContext(ctx).AutoMigrate(&lighthouseBenchmarkDBRecord{}); err != nil {
		return BenchmarkSuiteResult{}, err
	}
	payload := bytes.Repeat([]byte{'d'}, payloadSize)
	payloadStr := string(payload)
	if payloadStr == "" {
		payloadStr = "benchmark"
	}
	seedRows := concurrency * 200
	if seedRows < 500 {
		seedRows = 500
	}
	runBaseID := uint64(started.UnixNano()) * 100000
	if runBaseID == 0 {
		runBaseID = 100000
	}
	firstRunID := runBaseID + 1
	nowMS := time.Now().UnixMilli()
	seed := make([]lighthouseBenchmarkDBRecord, 0, seedRows)
	for i := 1; i <= seedRows; i++ {
		seed = append(seed, lighthouseBenchmarkDBRecord{
			ID:          runBaseID + uint64(i),
			Value:       payloadStr,
			UpdatedAtMS: nowMS,
		})
	}
	if err := db.WithContext(ctx).CreateInBatches(seed, 200).Error; err != nil {
		return BenchmarkSuiteResult{}, err
	}
	maxBenchmarkID := int64(runBaseID + uint64(seedRows))
	maxID := maxBenchmarkID
	defer cleanupDBBenchmarkRun(ctx, db, firstRunID, func() uint64 {
		current := atomic.LoadInt64(&maxID)
		if current < int64(firstRunID) {
			current = int64(firstRunID)
		}
		return uint64(current)
	}())

	var ops int64
	var errs int64
	var readOps int64
	var writeOps int64
	var updateOps int64
	errClasses := map[string]int64{}
	var errClassMu sync.Mutex
	latencies := make([]float64, 0, 2048)
	var latMu sync.Mutex
	windowCounts := initWindowCounts(duration)
	var windowMu sync.Mutex

	dialect := strings.ToLower(db.Dialector.Name())
	driver := detectDBDriver(connectionName, dialect)
	isSQLite := strings.Contains(dialect, "sqlite")
	workerConcurrency := concurrency
	readPercent := 70
	updatePercent := 20
	writePercent := 10
	if isSQLite {
		// SQLite has coarse write locks; use a read-heavy profile to reduce lock noise.
		readPercent = 95
		updatePercent = 5
		writePercent = 0
		if workerConcurrency > 4 {
			workerConcurrency = 4
		}
	}
	var wg sync.WaitGroup
	for worker := 0; worker < workerConcurrency; worker++ {
		wg.Add(1)
		go func(workerID int) {
			defer wg.Done()
			rng := rand.New(rand.NewSource(time.Now().UnixNano() + int64(workerID+1)*7919))
			for {
				if time.Now().After(deadline) {
					return
				}
				opStarted := time.Now()
				measured := !time.Now().Before(measureStart)
				opKind := rng.Intn(100)
				readThreshold := readPercent
				updateThreshold := readPercent + updatePercent
				switch {
				case opKind < readThreshold:
					id := firstRunID + uint64(rng.Int63n(maxID-int64(firstRunID)+1))
					var row lighthouseBenchmarkDBRecord
					err := runDBOpWithRetry(isSQLite, func() error {
						return db.WithContext(ctx).Select("id", "value").Where("id = ?", id).Take(&row).Error
					})
					if err != nil {
						if !errors.Is(err, gorm.ErrRecordNotFound) {
							if measured {
								atomic.AddInt64(&errs, 1)
								errClassMu.Lock()
								errClasses[classifyDBError(err)]++
								errClassMu.Unlock()
							}
						}
						continue
					}
					if measured {
						atomic.AddInt64(&readOps, 1)
					}
				case opKind < updateThreshold:
					id := firstRunID + uint64(rng.Int63n(maxID-int64(firstRunID)+1))
					err := runDBOpWithRetry(isSQLite, func() error {
						return db.WithContext(ctx).
							Model(&lighthouseBenchmarkDBRecord{}).
							Where("id = ?", id).
							Updates(map[string]any{
								"value":         payloadStr,
								"updated_at_ms": time.Now().UnixMilli(),
							}).Error
					})
					if err != nil {
						if measured {
							atomic.AddInt64(&errs, 1)
							errClassMu.Lock()
							errClasses[classifyDBError(err)]++
							errClassMu.Unlock()
						}
						continue
					}
					if measured {
						atomic.AddInt64(&updateOps, 1)
					}
				default:
					id := uint64(atomic.AddInt64(&maxID, 1))
					err := runDBOpWithRetry(isSQLite, func() error {
						return db.WithContext(ctx).Create(&lighthouseBenchmarkDBRecord{
							ID:          id,
							Value:       payloadStr,
							UpdatedAtMS: time.Now().UnixMilli(),
						}).Error
					})
					if err != nil {
						if measured {
							atomic.AddInt64(&errs, 1)
							errClassMu.Lock()
							errClasses[classifyDBError(err)]++
							errClassMu.Unlock()
						}
						continue
					}
					if measured {
						atomic.AddInt64(&writeOps, 1)
					}
				}
				if measured {
					atomic.AddInt64(&ops, 1)
					ms := float64(time.Since(opStarted)) / float64(time.Millisecond)
					latMu.Lock()
					latencies = append(latencies, ms)
					latMu.Unlock()
					recordWindowCount(windowCounts, &windowMu, measureStart, time.Now())
				}
			}
		}(worker)
	}
	wg.Wait()

	completed := time.Now()
	elapsed := completed.Sub(measureStart)
	if elapsed <= 0 {
		elapsed = time.Millisecond
	}
	p50, p95, p99 := latencyPercentiles(latencies)

	result := BenchmarkSuiteResult{
		Suite:       "db",
		Driver:      driver,
		DurationMS:  int64(duration / time.Millisecond),
		Concurrency: concurrency,
		Queue:       connectionName,
		StartedAt:   started.UTC().Format(time.RFC3339),
		CompletedAt: completed.UTC().Format(time.RFC3339),
		ElapsedMS:   int64(elapsed / time.Millisecond),
		Ops:         ops,
		OpsPerSec:   float64(ops) / elapsed.Seconds(),
		Errors:      errs,
		P50MS:       p50,
		P95MS:       p95,
		P99MS:       p99,
		Extra: map[string]any{
			"connection":         connectionName,
			"profile":            "mixed",
			"mix_read_percent":   readPercent,
			"mix_update_percent": updatePercent,
			"mix_write_percent":  writePercent,
			"read_ops":           readOps,
			"update_ops":         updateOps,
			"write_ops":          writeOps,
			"seed_rows":          seedRows,
			"dialect":            dialect,
			"driver":             driver,
			"worker_concurrency": workerConcurrency,
			"throughput_metric":  "db_ops_per_sec",
			"error_classes":      errClasses,
			"warmup_ms":          int64(warmup / time.Millisecond),
			"window_ms":          1000,
			"window_ops":         buildWindowOps(windowCounts),
		},
	}
	enrichBenchmarkResult(&result)
	return result, nil
}

// cleanupDBBenchmarkRun removes only records created by the current benchmark identifier range.
func cleanupDBBenchmarkRun(ctx context.Context, db *gorm.DB, firstID, lastID uint64) {
	if db == nil || firstID == 0 || lastID < firstID {
		return
	}
	_ = db.WithContext(ctx).
		Where("id >= ? AND id <= ?", firstID, lastID).
		Delete(&lighthouseBenchmarkDBRecord{}).Error
}

// detectDBDriver reconciles generated connection metadata with the active dialect.
func detectDBDriver(connectionName, dialect string) string {
	key := "DB_DRIVER"
	if connectionName != "" && connectionName != "default" {
		key = "DB_" + strings.ToUpper(connectionName) + "_DRIVER"
	}
	candidates := []string{
		env.Get(key, ""),
		env.Get("DB_DRIVER", ""),
		dialect,
	}
	for _, candidate := range candidates {
		if normalized := runtime.NormalizeDBDriver(candidate); normalized != "" {
			return normalized
		}
	}
	return "-"
}

