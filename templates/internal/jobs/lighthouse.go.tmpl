func runQueueBenchmarkInstance(ctx context.Context, queueInstance *queue.Queue, duration time.Duration, concurrency, payloadSize int, instanceName, queueName string, started time.Time) (BenchmarkSuiteResult, error) {
	warmup := time.Duration(0)
	startStats, err := queueInstance.Stats(ctx)
	if err != nil {
		return BenchmarkSuiteResult{}, err
	}
	startCounters := startStats.ByQueue[queueName]
	resumedInitiallyPaused := false
	if startCounters.Paused > 0 {
		if err := queueInstance.Resume(ctx, queueName); err != nil {
			return BenchmarkSuiteResult{}, fmt.Errorf("queue %q is paused and could not be resumed: %w", queueName, err)
		}
		if err := waitForQueuePauseState(ctx, queueInstance, queueName, false, 3*time.Second); err != nil {
			return BenchmarkSuiteResult{}, err
		}
		resumedInitiallyPaused = true
	}

	payloadBody, err := json.Marshal(lighthouseBenchmarkQueuePayload{Bytes: payloadSize})
	if err != nil {
		return BenchmarkSuiteResult{}, err
	}
	runID := newBenchmarkQueueRunID()
	runState := &benchmarkQueueRun{}
	benchmarkQueueRuns.Store(runID, runState)
	defer benchmarkQueueRuns.Delete(runID)
	defer cleanupQueueBenchmarkRun(ctx, queueInstance, queueName, runID)
	payloadBody, err = json.Marshal(lighthouseBenchmarkQueuePayload{
		RunID: runID,
		Bytes: payloadSize,
	})
	if err != nil {
		return BenchmarkSuiteResult{}, err
	}

	prefillTarget := benchmarkQueuePrefillCount(duration, concurrency)
	var dispatched int64
	var dispatchErrs int64
	prefillStartedAt := time.Now()
	prefillCompletedAt := prefillStartedAt
	pausedBeforePrefill := false
	prefillPauseBlocked := false
	dispatchLatencies := make([]float64, 0, 2048)
	var latMu sync.Mutex

	enqueueWorkers := benchmarkQueueEnqueueWorkers(concurrency)
	runPrefill := func(withPause bool) (bool, bool, error) {
		dispatched = 0
		dispatchErrs = 0
		dispatchLatencies = dispatchLatencies[:0]
		atomic.StoreInt64(&runState.dispatched, 0)
		paused := false
		if withPause {
			if err := queueInstance.Pause(ctx, queueName); err != nil {
				return false, false, fmt.Errorf("pause queue %q before prefill: %w", queueName, err)
			}
			paused = true
		}

		prefillStartedAt = time.Now()
		var dispatchIndex int64
		var pauseBlocked int32
		var wg sync.WaitGroup
		for worker := 0; worker < enqueueWorkers; worker++ {
			wg.Add(1)
			go func() {
				defer wg.Done()
				for {
					idx := atomic.AddInt64(&dispatchIndex, 1)
					if idx > prefillTarget {
						return
					}
					opStarted := time.Now()
					_, err := queueInstance.WithContext(ctx).Dispatch(
						queue.NewJob(lighthouseBenchmarkQueueJobType).
							Payload(payloadBody).
							OnQueue(queueName).
							Timeout(30*time.Second).
							Retry(0),
					)
					if err != nil {
						atomic.AddInt64(&dispatchErrs, 1)
						if withPause && isQueuePausedDispatchErr(err) {
							atomic.StoreInt32(&pauseBlocked, 1)
							return
						}
						continue
					}
					atomic.AddInt64(&dispatched, 1)
					atomic.AddInt64(&runState.dispatched, 1)
					ms := float64(time.Since(opStarted)) / float64(time.Millisecond)
					latMu.Lock()
					dispatchLatencies = append(dispatchLatencies, ms)
					latMu.Unlock()
				}
			}()
		}
		wg.Wait()
		prefillCompletedAt = time.Now()

		blocked := withPause && atomic.LoadInt32(&pauseBlocked) == 1 && dispatched == 0
		if paused {
			if err := queueInstance.Resume(ctx, queueName); err != nil {
				return paused, blocked, fmt.Errorf("resume queue %q after prefill: %w", queueName, err)
			}
			if err := waitForQueuePauseState(ctx, queueInstance, queueName, false, 3*time.Second); err != nil {
				return paused, blocked, err
			}
		}
		return paused, blocked, nil
	}

	var errPrefill error
	pausedBeforePrefill, prefillPauseBlocked, errPrefill = runPrefill(true)
	if errPrefill != nil {
		return BenchmarkSuiteResult{}, errPrefill
	}
	if prefillPauseBlocked {
		pausedBeforePrefill = false
		_, _, errPrefill = runPrefill(false)
		if errPrefill != nil {
			return BenchmarkSuiteResult{}, errPrefill
		}
	}

	measureStart := time.Now()
	if prefillPauseBlocked {
		// For drivers where pause blocks dispatch (e.g. workerpool), prefill runs unpaused
		// and jobs can complete during enqueue. In that case, measure the combined window.
		measureStart = prefillStartedAt
	}
	windowCounts := initWindowCounts(duration)
	var windowMu sync.Mutex

	drainTimeout := benchmarkQueueDrainTimeout(duration)
	waitTimeout := time.NewTimer(drainTimeout)
	defer waitTimeout.Stop()
	pollTicker := time.NewTicker(200 * time.Millisecond)
	defer pollTicker.Stop()

	endCounters := startCounters
	var statsProcessedDelta int64
	var statsFailedDelta int64
	var statsArchivedDelta int64
	timedOut := false
	for {
		stats, statErr := queueInstance.Stats(ctx)
		if statErr == nil {
			counters := stats.ByQueue[queueName]
			endCounters = counters
			statsProcessedDelta = counters.Processed - startCounters.Processed
			if statsProcessedDelta < 0 {
				statsProcessedDelta = 0
			}
			if statsProcessedDelta > dispatched {
				statsProcessedDelta = dispatched
			}
			statsFailedDelta = counters.Failed - startCounters.Failed
			if statsFailedDelta < 0 {
				statsFailedDelta = 0
			}
			if statsFailedDelta > dispatched {
				statsFailedDelta = dispatched
			}
			statsArchivedDelta = counters.Archived - startCounters.Archived
			if statsArchivedDelta < 0 {
				statsArchivedDelta = 0
			}
			if statsArchivedDelta > dispatched {
				statsArchivedDelta = dispatched
			}
			accountedByStats := statsProcessedDelta + statsFailedDelta + statsArchivedDelta
			if accountedByStats > dispatched {
				accountedByStats = dispatched
			}
			remainingByStats := dispatched - accountedByStats
			if remainingByStats < 0 {
				remainingByStats = 0
			}
			// Completion is based on benchmark run accounting, not global queue shape.
			if remainingByStats == 0 {
				break
			}
			recordWindowCount(windowCounts, &windowMu, measureStart, time.Now())
		}
		select {
		case <-waitTimeout.C:
			timedOut = true
			stats, _ := queueInstance.Stats(ctx)
			endCounters = stats.ByQueue[queueName]
			statsProcessedDelta = endCounters.Processed - startCounters.Processed
			if statsProcessedDelta < 0 {
				statsProcessedDelta = 0
			}
			if statsProcessedDelta > dispatched {
				statsProcessedDelta = dispatched
			}
			statsFailedDelta = endCounters.Failed - startCounters.Failed
			if statsFailedDelta < 0 {
				statsFailedDelta = 0
			}
			if statsFailedDelta > dispatched {
				statsFailedDelta = dispatched
			}
			statsArchivedDelta = endCounters.Archived - startCounters.Archived
			if statsArchivedDelta < 0 {
				statsArchivedDelta = 0
			}
			if statsArchivedDelta > dispatched {
				statsArchivedDelta = dispatched
			}
			goto done
		case <-pollTicker.C:
			recordWindowCount(windowCounts, &windowMu, measureStart, time.Now())
		}
	}
	done:
	completed := time.Now()
	elapsed := completed.Sub(measureStart)
	if elapsed <= 0 {
		elapsed = time.Millisecond
	}
	elapsedMS := int64(elapsed / time.Millisecond)
	if elapsedMS < 1 {
		elapsedMS = 1
	}
	prefillElapsed := prefillCompletedAt.Sub(prefillStartedAt)
	if prefillElapsed <= 0 {
		prefillElapsed = time.Millisecond
	}
	drainElapsed := completed.Sub(measureStart)
	if drainElapsed < 0 {
		drainElapsed = 0
	}
	localProcessed := atomic.LoadInt64(&runState.processed)
	localFailed := atomic.LoadInt64(&runState.failed)
	if dispatched > 0 && localProcessed == 0 && timedOut {
		return BenchmarkSuiteResult{}, fmt.Errorf(
			"queue benchmark timed out with no processed jobs (queue=%s, dispatched=%d); ensure workers are running and queue is unpaused",
			queueName,
			dispatched,
		)
	}
	processedDelta := statsProcessedDelta
	if localProcessed > processedDelta {
		processedDelta = localProcessed
	}
	if processedDelta > dispatched {
		processedDelta = dispatched
	}
	failedDelta := statsFailedDelta
	if localFailed > failedDelta {
		failedDelta = localFailed
	}
	if failedDelta > dispatched {
		failedDelta = dispatched
	}
	archivedDelta := statsArchivedDelta
	if archivedDelta < 0 {
		archivedDelta = 0
	}
	if archivedDelta > dispatched {
		archivedDelta = dispatched
	}
	queueFailedDelta := endCounters.Failed - startCounters.Failed
	if queueFailedDelta < 0 {
		queueFailedDelta = 0
	}
	queueArchivedDelta := endCounters.Archived - startCounters.Archived
	if queueArchivedDelta < 0 {
		queueArchivedDelta = 0
	}
	p50, p95, p99 := latencyPercentiles(dispatchLatencies)
	configuredDriver := benchmarkQueueConfiguredDriver(instanceName)
	driver := runtime.NormalizeQueueDriver(string(queueInstance.Driver()))
	if driver == "" {
		driver = configuredDriver
	}

	result := BenchmarkSuiteResult{
		Suite:       "queue",
		Driver:      driver,
		DurationMS:  int64(duration / time.Millisecond),
		Concurrency: concurrency,
		PayloadSize: payloadSize,
		Queue:       queueName,
		StartedAt:   started.UTC().Format(time.RFC3339),
		CompletedAt: completed.UTC().Format(time.RFC3339),
		ElapsedMS:   elapsedMS,
		Ops:         processedDelta,
		OpsPerSec:   float64(processedDelta) / elapsed.Seconds(),
		Errors:      failedDelta + dispatchErrs,
		P50MS:       p50,
		P95MS:       p95,
		P99MS:       p99,
		Extra: map[string]any{
			"instance":           instanceName,
			"run_id":             runID,
			"prefill_target":     prefillTarget,
			"prefill_dispatched": dispatched,
			"dispatched":         dispatched,
			"dispatch_errors":    dispatchErrs,
			"processed_delta":    processedDelta,
			"failed_delta":       failedDelta,
			"archived_delta":     archivedDelta,
			"queue_failed_delta": queueFailedDelta,
			"queue_archived_delta": queueArchivedDelta,
			"processed_from_stats": statsProcessedDelta,
			"processed_from_local": localProcessed,
			"failed_from_stats":  statsFailedDelta,
			"failed_from_local":  localFailed,
			"start_pending":      startCounters.Pending,
			"end_pending":        endCounters.Pending,
			"start_active":       startCounters.Active,
			"end_active":         endCounters.Active,
			"latency_metric":     "enqueue_ms",
			"throughput_metric":  "processed_jobs_per_sec_drain_only",
			"warmup_ms":          int64(warmup / time.Millisecond),
			"window_ms":          1000,
			"window_dispatch":    buildWindowOps(windowCounts),
			"effective_concurrency": enqueueWorkers,
			"prefill_elapsed_ms": int64(prefillElapsed / time.Millisecond),
			"drain_elapsed_ms":   int64(drainElapsed / time.Millisecond),
			"drain_timeout_ms":   int64(drainTimeout / time.Millisecond),
			"timed_out":          timedOut,
			"queue_paused_prefill": pausedBeforePrefill,
			"prefill_pause_blocked": prefillPauseBlocked,
			"configured_queue_workers": env.Get("QUEUE_WORKERS", ""),
			"configured_driver": configuredDriver,
			"resumed_initially_paused": resumedInitiallyPaused,
		},
	}
	enrichBenchmarkResult(&result)
	return result, nil
}

func cleanupQueueBenchmarkRun(ctx context.Context, queueInstance *queue.Queue, queueName, runID string) {
	if queueInstance == nil || strings.TrimSpace(queueName) == "" || strings.TrimSpace(runID) == "" {
		return
	}
	states := []queue.JobState{
		queue.JobStatePending,
		queue.JobStateScheduled,
		queue.JobStateRetry,
		queue.JobStateArchived,
		queue.JobStateCompleted,
	}
	for _, state := range states {
		page := 1
		for {
			list, err := queueInstance.ListJobs(ctx, queue.ListJobsOptions{
				Queue:    queueName,
				State:    state,
				Page:     page,
				PageSize: 200,
			})
			if err != nil {
				return
			}
			if len(list.Jobs) == 0 {
				break
			}
			for _, job := range list.Jobs {
				if job.Type != lighthouseBenchmarkQueueJobType {
					continue
				}
				var payload lighthouseBenchmarkQueuePayload
				if err := json.Unmarshal([]byte(job.Payload), &payload); err != nil {
					continue
				}
				if payload.RunID != runID {
					continue
				}
				_ = queueInstance.DeleteJob(ctx, queueName, job.ID)
			}
			page++
		}
	}
}

func benchmarkQueueConfiguredDriver(name string) string {
	instances := runtime.DiscoverQueueInstances()
	normalizedName := normalizedBenchmarkName(name)
	for _, instance := range instances {
		if normalizedBenchmarkName(instance.Name) != normalizedName {
			continue
		}
		return runtime.NormalizeQueueDriver(instance.Driver)
	}
	return ""
}

func benchmarkQueueDefaultQueue(name string) string {
	return runtime.QueueDefaultQueue(name)
}

func benchmarkQueuePrefillCount(duration time.Duration, concurrency int) int64 {
	_ = duration
	_ = concurrency
	raw := strings.TrimSpace(env.Get("BENCHMARK_QUEUE_PREFILL_COUNT", ""))
	if raw == "" {
		return benchmarkQueuePrefillDefault
	}
	v, err := strconv.ParseInt(raw, 10, 64)
	if err != nil || v <= 0 {
		return benchmarkQueuePrefillDefault
	}
	return v
}

func benchmarkQueueEnqueueWorkers(concurrency int) int {
	workers := concurrency * 4
	if workers < 1 {
		workers = 1
	}
	if workers > 256 {
		workers = 256
	}
	return workers
}

func benchmarkQueueDrainTimeout(duration time.Duration) time.Duration {
	raw := strings.TrimSpace(env.Get("BENCHMARK_QUEUE_DRAIN_TIMEOUT_MS", ""))
	if raw != "" {
		if ms, err := strconv.Atoi(raw); err == nil && ms > 0 {
			return time.Duration(ms) * time.Millisecond
		}
	}
	if duration <= 0 {
		return 90 * time.Second
	}
	timeout := duration * 4
	if timeout < 45*time.Second {
		timeout = 45 * time.Second
	}
	if timeout > benchmarkQueueDrainMax {
		timeout = benchmarkQueueDrainMax
	}
	return timeout
}

