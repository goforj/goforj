func runHTTPBenchmark(ctx context.Context, duration time.Duration, concurrency int, started time.Time) BenchmarkSuiteResult {
	baseURL := strings.TrimSpace(env.Get("BENCHMARK_HTTP_URL", env.Get("APP_URL", "http://localhost:3000")))
	path := strings.TrimSpace(env.Get("BENCHMARK_HTTP_PATH", "/-/health"))
	target := normalizeHTTPBenchmarkURL(baseURL, path)

	warmup := benchmarkWarmup(duration)
	measureStart := started.Add(warmup)
	deadline := measureStart.Add(duration)
	client := benchmarkHTTPClient()
	var ops int64
	var errs int64
	statusCounts := map[string]int64{}
	var statusMu sync.Mutex
	errorCounts := map[string]int64{}
	var errMu sync.Mutex
	latencies := make([]float64, 0, 2048)
	var latMu sync.Mutex
	windowCounts := initWindowCounts(duration)
	var windowMu sync.Mutex
	var wg sync.WaitGroup
	for worker := 0; worker < concurrency; worker++ {
		wg.Add(1)
		go func() {
			defer wg.Done()
			transportErrStreak := 0
			for {
				if ctx.Err() != nil {
					return
				}
				now := time.Now()
				if now.After(deadline) {
					return
				}
				measured := !now.Before(measureStart)
				opStarted := time.Now()
				remaining := time.Until(deadline)
				if remaining <= 50*time.Millisecond {
					return
				}
				requestTimeout := 5 * time.Second
				if remaining > 0 && remaining < requestTimeout {
					requestTimeout = remaining
				}
				reqCtx, reqCancel := context.WithTimeout(context.Background(), requestTimeout)
				req, err := http.NewRequestWithContext(reqCtx, http.MethodGet, target, nil)
				if err != nil {
					reqCancel()
					if measured {
						atomic.AddInt64(&errs, 1)
						errMu.Lock()
						errorCounts["request_build:"+strings.TrimSpace(err.Error())]++
						errMu.Unlock()
					}
					continue
				}
				resp, err := client.Do(req)
				if err != nil {
					reqCancel()
					if measured {
						if time.Now().After(deadline) {
							return
						}
						atomic.AddInt64(&errs, 1)
						errMu.Lock()
						errorCounts["transport:"+classifyHTTPError(err)]++
						errMu.Unlock()
					}
					transportErrStreak++
					backoff := transportErrorBackoff(transportErrStreak)
					if backoff > 0 {
						time.Sleep(backoff)
					}
					continue
				}
				transportErrStreak = 0
				_, _ = io.Copy(io.Discard, io.LimitReader(resp.Body, 1<<20))
				_ = resp.Body.Close()
				reqCancel()
				codeKey := fmt.Sprintf("%d", resp.StatusCode)
				if measured {
					statusMu.Lock()
					statusCounts[codeKey]++
					statusMu.Unlock()
				}
				if resp.StatusCode >= 400 {
					if measured {
						atomic.AddInt64(&errs, 1)
						errMu.Lock()
						errorCounts[fmt.Sprintf("status_%d", resp.StatusCode)]++
						errMu.Unlock()
					}
					continue
				}
				if measured {
					atomic.AddInt64(&ops, 1)
					ms := float64(time.Since(opStarted)) / float64(time.Millisecond)
					latMu.Lock()
					latencies = append(latencies, ms)
					latMu.Unlock()
					recordWindowCount(windowCounts, &windowMu, measureStart, time.Now())
				}
			}
		}()
	}
	wg.Wait()

	topErrors := topErrorCounts(errorCounts, 5)

	completed := time.Now()
	elapsed := completed.Sub(measureStart)
	if elapsed <= 0 {
		elapsed = time.Millisecond
	}
	p50, p95, p99 := latencyPercentiles(latencies)

	result := BenchmarkSuiteResult{
		Suite:       "http",
		Driver:      "http",
		DurationMS:  int64(duration / time.Millisecond),
		Concurrency: concurrency,
		StartedAt:   started.UTC().Format(time.RFC3339),
		CompletedAt: completed.UTC().Format(time.RFC3339),
		ElapsedMS:   int64(elapsed / time.Millisecond),
		Ops:         ops,
		OpsPerSec:   float64(ops) / elapsed.Seconds(),
		Errors:      errs,
		P50MS:       p50,
		P95MS:       p95,
		P99MS:       p99,
		Extra: map[string]any{
			"url":               target,
			"status_counts":     statusCounts,
			"error_counts":      errorCounts,
			"top_errors":        topErrors,
			"throughput_metric": "successful_requests_per_sec",
			"warmup_ms":         int64(warmup / time.Millisecond),
			"window_ms":         1000,
			"window_ops":        buildWindowOps(windowCounts),
		},
	}
	enrichBenchmarkResult(&result)
	return result
}

func benchmarkHTTPClient() *http.Client {
	httpBenchmarkClientOnce.Do(func() {
		transport := &http.Transport{
			Proxy:                 http.ProxyFromEnvironment,
			DialContext:           (&net.Dialer{Timeout: 3 * time.Second, KeepAlive: 30 * time.Second}).DialContext,
			ForceAttemptHTTP2:     true,
			MaxIdleConns:          512,
			MaxIdleConnsPerHost:   256,
			MaxConnsPerHost:       256,
			IdleConnTimeout:       2 * time.Minute,
			TLSHandshakeTimeout:   5 * time.Second,
			ExpectContinueTimeout: time.Second,
		}
		httpBenchmarkClientInst = &http.Client{Transport: transport}
	})
	return httpBenchmarkClientInst
}

func topErrorCounts(counts map[string]int64, max int) []string {
	if len(counts) == 0 || max <= 0 {
		return nil
	}
	type pair struct {
		key   string
		count int64
	}
	items := make([]pair, 0, len(counts))
	for key, count := range counts {
		if count <= 0 {
			continue
		}
		items = append(items, pair{key: key, count: count})
	}
	sort.Slice(items, func(i, j int) bool {
		if items[i].count == items[j].count {
			return items[i].key < items[j].key
		}
		return items[i].count > items[j].count
	})
	if len(items) > max {
		items = items[:max]
	}
	out := make([]string, 0, len(items))
	for _, item := range items {
		out = append(out, fmt.Sprintf("%d× %s", item.count, item.key))
	}
	return out
}

func normalizeHTTPBenchmarkURL(baseURL string, path string) string {
	if baseURL == "" {
		baseURL = "http://localhost:3000"
	}
	parsed, err := url.Parse(baseURL)
	if err != nil || parsed.Scheme == "" || parsed.Host == "" {
		return "http://localhost:3000/health"
	}
	if path == "" {
		path = "/-/health"
	}
	if !strings.HasPrefix(path, "/") {
		path = "/" + path
	}
	parsed.Path = path
	parsed.RawQuery = ""
	parsed.Fragment = ""
	if strings.EqualFold(parsed.Hostname(), "localhost") {
		port := parsed.Port()
		if port != "" {
			parsed.Host = "127.0.0.1:" + port
		} else {
			parsed.Host = "127.0.0.1"
		}
	}
	return parsed.String()
}

func transportErrorBackoff(streak int) time.Duration {
	if streak <= 1 {
		return 0
	}
	if streak > 6 {
		streak = 6
	}
	// 2ms,4ms,8ms,16ms,32ms,64ms
	return time.Duration(1<<streak) * time.Millisecond
}

func benchmarkWarmup(duration time.Duration) time.Duration {
	if duration <= 0 {
		return 0
	}
	w := duration / 5
	if w > time.Second {
		w = time.Second
	}
	if w < 200*time.Millisecond {
		w = 200 * time.Millisecond
	}
	return w
}

func initWindowCounts(duration time.Duration) []int64 {
	if duration <= 0 {
		return []int64{0}
	}
	n := int(duration / time.Second)
	if duration%time.Second != 0 {
		n++
	}
	if n < 1 {
		n = 1
	}
	return make([]int64, n)
}

func recordWindowCount(counts []int64, mu *sync.Mutex, start, at time.Time) {
	if len(counts) == 0 {
		return
	}
	idx := int(at.Sub(start) / time.Second)
	if idx < 0 {
		return
	}
	if idx >= len(counts) {
		idx = len(counts) - 1
	}
	mu.Lock()
	counts[idx]++
	mu.Unlock()
}

func buildWindowOps(counts []int64) []map[string]any {
	out := make([]map[string]any, 0, len(counts))
	for i, c := range counts {
		out = append(out, map[string]any{
			"bucket": i,
			"ops":    c,
		})
	}
	return out
}

func benchmarkErrorRate(report BenchmarkSuiteResult) float64 {
	denom := float64(report.Ops + report.Errors)
	if denom <= 0 {
		return 0
	}
	return float64(report.Errors) / denom
}

func enrichBenchmarkResult(report *BenchmarkSuiteResult) {
	if report == nil {
		return
	}
	if report.Extra == nil {
		report.Extra = map[string]any{}
	}
	errRate := benchmarkErrorRate(*report)
	report.Extra["error_rate"] = errRate
	report.Extra["performance_grade"] = performanceGrade(*report)
	report.Extra["stability_grade"] = stabilityGrade(errRate)
}

// performanceGrade applies suite-specific thresholds so unlike backends receive meaningful grades.
func performanceGrade(report BenchmarkSuiteResult) string {
	opsPerSec := report.OpsPerSec
	p95 := report.P95MS
	aThreshold := 50000.0
	bThreshold := 5000.0
	cThreshold := 500.0

	switch strings.ToLower(strings.TrimSpace(report.Suite)) {
	case "queue":
		driver := strings.ToLower(strings.TrimSpace(report.Driver))
		if driver == "redis" || driver == "asynq" {
			aThreshold = 6000
			bThreshold = 2500
			cThreshold = 500
		} else if driver == "workerpool" {
			aThreshold = 30000
			bThreshold = 10000
			cThreshold = 2000
		}
	case "db":
		aThreshold = 20000
		bThreshold = 8000
		cThreshold = 2000
{{- if .ProjectComponents.Storage }}
	case "storage":
		aThreshold = 3000
		bThreshold = 1200
		cThreshold = 300
{{- end }}
	case "http":
		aThreshold = 20000
		bThreshold = 6000
		cThreshold = 1500
	case "cache":
		driver := strings.ToLower(strings.TrimSpace(report.Driver))
		switch driver {
		case "memory":
			aThreshold = 500000
			bThreshold = 100000
			cThreshold = 30000
		case "redis", "nats", "memcached":
			// Networked caches should not be graded against in-process memory throughput.
			aThreshold = 25000
			bThreshold = 10000
			cThreshold = 3000
		case "file", "sql", "sqlite", "mysql", "postgres", "dynamodb":
			// Persistence-backed caches trade throughput for durability/IO.
			aThreshold = 12000
			bThreshold = 4000
			cThreshold = 1000
		default:
			aThreshold = 25000
			bThreshold = 10000
			cThreshold = 3000
		}
	}

	grade := "D"
	switch {
	case opsPerSec >= aThreshold:
		grade = "A"
	case opsPerSec >= bThreshold:
		grade = "B"
	case opsPerSec >= cThreshold:
		grade = "C"
	default:
		grade = "D"
	}
	if p95 > 250 {
		return degradeGrade(degradeGrade(grade))
	}
	if p95 > 100 {
		return degradeGrade(grade)
	}
	return grade
}

func stabilityGrade(errorRate float64) string {
	switch {
	case errorRate <= 0.001:
		return "A"
	case errorRate <= 0.01:
		return "B"
	case errorRate <= 0.05:
		return "C"
	default:
		return "D"
	}
}

func degradeGrade(in string) string {
	switch in {
	case "A":
		return "B"
	case "B":
		return "C"
	case "C":
		return "D"
	default:
		return "D"
	}
}

func classifyDBError(err error) string {
	if err == nil {
		return "none"
	}
	msg := strings.ToLower(err.Error())
	switch {
	case strings.Contains(msg, "locked"), strings.Contains(msg, "busy"):
		return "lock"
	case strings.Contains(msg, "deadlock"):
		return "deadlock"
	case strings.Contains(msg, "duplicate"), strings.Contains(msg, "unique"):
		return "duplicate"
	case strings.Contains(msg, "timeout"):
		return "timeout"
	default:
		return "other"
	}
}

func classifyHTTPError(err error) string {
	if err == nil {
		return "unknown"
	}
	msg := strings.ToLower(strings.TrimSpace(err.Error()))
	switch {
	case errors.Is(err, context.DeadlineExceeded) || strings.Contains(msg, "deadline exceeded") || strings.Contains(msg, "timeout"):
		return "timeout"
	case errors.Is(err, context.Canceled) || strings.Contains(msg, "context canceled"):
		return "canceled"
	case strings.Contains(msg, "connection refused"):
		return "connection_refused"
	case strings.Contains(msg, "reset by peer"):
		return "connection_reset"
	case strings.Contains(msg, "broken pipe"):
		return "broken_pipe"
	case strings.Contains(msg, "no such host"):
		return "dns"
	default:
		if msg == "" {
			return "unknown"
		}
		return msg
	}
}

func latencyPercentiles(raw []float64) (float64, float64, float64) {
	if len(raw) == 0 {
		return 0, 0, 0
	}
	sorted := append([]float64(nil), raw...)
	sort.Float64s(sorted)
	pick := func(q float64) float64 {
		if q <= 0 {
			return sorted[0]
		}
		if q >= 1 {
			return sorted[len(sorted)-1]
		}
		idx := int(float64(len(sorted)-1) * q)
		if idx < 0 {
			idx = 0
		}
		if idx >= len(sorted) {
			idx = len(sorted) - 1
		}
		return sorted[idx]
	}
	return pick(0.50), pick(0.95), pick(0.99)
}

func runDBOpWithRetry(sqlite bool, fn func() error) error {
	if !sqlite {
		return fn()
	}
	var err error
	backoff := 2 * time.Millisecond
	for attempt := 0; attempt < 4; attempt++ {
		err = fn()
		if err == nil {
			return nil
		}
		msg := strings.ToLower(err.Error())
		if !strings.Contains(msg, "database is locked") &&
			!strings.Contains(msg, "database table is locked") &&
			!strings.Contains(msg, "busy") {
			return err
		}
		time.Sleep(backoff)
		backoff *= 2
	}
	return err
}
