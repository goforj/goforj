// Start boots the dev console agent for the jobs process.
func (c *LighthouseRuntime) Start(ctx context.Context) {
	if !lighthouse.Enabled() {
		return
	}
	c.logger.AddSink(lighthouse.NewLogSink(c.agent))
	publisher := lighthouse.NewInspectPublisher(c.agent{{- if .ProjectComponents.Metrics }}, c.metrics{{- end }})
	c.inspects.SetPublisher(publisher)
	c.inspects.SetPublishOnly(true)
	c.inspects.SetCaptureGate(c.agent.InspectActive)
	go publisher.Start(ctx)
	c.agent.RegisterCapability("inspects")
	c.agent.RegisterCapability("cli")
	c.agent.RegisterCapability("jobs")
	c.agent.RegisterCapability("benchmark")
	queueInstances := lighthouseQueueInstances(c.queues)
	if len(queueInstances) > 0 {
		c.agent.RegisterCapability("queue")
	}
	for _, queueInstance := range queueInstances {
		if queueInstance == nil {
			continue
		}
		queueInstance.Register(lighthouseBenchmarkQueueJobType, handleLighthouseBenchmarkQueueTask)
	}

	c.registerCLICommands(ctx)
	c.registerQueueCommands(ctx)
	c.registerBenchmarkCommands(ctx)

	go func() {
		_ = c.agent.Start(ctx)
	}()
}

func (c *LighthouseRuntime) registerCLICommands(ctx context.Context) {
	c.agent.RegisterCommand("cli:run", func(cmd lighthouse.Command) (any, error) {
		params, err := lighthouse.Decode[struct {
			Args []string `json:"args"`
		}](cmd)
		if err != nil {
			return nil, err
		}
		result, _ := lighthouse.RunCLICommand(ctx, params.Args)
		return map[string]any{"result": result}, nil
	})

	c.agent.RegisterCommand("cli:list", func(cmd lighthouse.Command) (any, error) {
		commands, err := lighthouse.ListCLICommands(ctx)
		if err != nil {
			return nil, err
		}
		return map[string]any{"commands": commands}, nil
	})
}

func (c *LighthouseRuntime) registerBenchmarkCommands(ctx context.Context) {
	c.agent.RegisterCommand("benchmark:catalog", func(_ lighthouse.Command) (any, error) {
		return map[string]any{
			"catalog": c.benchmarks.catalog(),
		}, nil
	})

	c.agent.RegisterCommand("benchmark:run", func(cmd lighthouse.Command) (any, error) {
		params, err := lighthouse.Decode[BenchmarkRunRequest](cmd)
		if err != nil {
			return nil, err
		}
		report, err := c.benchmarks.run(ctx, params)
		if err != nil {
			return nil, err
		}
		report = enforceBenchmarkDriver(report)
		return map[string]any{
			"report": report,
			"system": collectSystemBenchmarkInfo(ctx),
		}, nil
	})

	c.agent.RegisterCommand("benchmark:system", func(_ lighthouse.Command) (any, error) {
		return map[string]any{
			"system": collectSystemBenchmarkInfo(ctx),
		}, nil
	})
}

func normalizedBenchmarkName(name string) string {
	value := strings.ToLower(strings.TrimSpace(name))
	if value == "" {
		return "default"
	}
	return value
}

func optionalBenchmarkName(name string) string {
	value := strings.ToLower(strings.TrimSpace(name))
	if value == "" {
		return ""
	}
	return value
}

{{- if .ProjectComponents.Cache }}
func runCacheBenchmark(ctx context.Context, manager *caches.Manager, duration time.Duration, concurrency, payloadSize int, started time.Time) (BenchmarkSuiteResult, error) {
	if manager == nil {
		return BenchmarkSuiteResult{}, fmt.Errorf("cache benchmark unavailable: cache store is not configured")
	}
	instances := manager.Instances()
	perStore := make([]BenchmarkSuiteResult, 0, len(instances))
	var totalOps int64
	var totalErrors int64
	var totalOpsPerSec float64
	var weightedP50 float64
	var weightedP95 float64
	var weightedP99 float64
	var totalWeight float64
	var maxElapsedMS int64
	driversSeen := map[string]struct{}{}

	for _, instance := range instances {
		cacheInstance := instance.Store
		if cacheInstance == nil {
			continue
		}
		report := runCacheBenchmarkStore(ctx, cacheInstance, normalizedBenchmarkName(instance.Name), duration, concurrency, payloadSize, started)
		perStore = append(perStore, report)
		totalOps += report.Ops
		totalErrors += report.Errors
		totalOpsPerSec += report.OpsPerSec
		if report.ElapsedMS > maxElapsedMS {
			maxElapsedMS = report.ElapsedMS
		}
		weight := float64(report.Ops)
		if weight <= 0 {
			weight = 1
		}
		totalWeight += weight
		weightedP50 += report.P50MS * weight
		weightedP95 += report.P95MS * weight
		weightedP99 += report.P99MS * weight
		if report.Driver != "" && report.Driver != "-" {
			driversSeen[report.Driver] = struct{}{}
		}
	}
	if len(perStore) == 0 {
		return BenchmarkSuiteResult{}, fmt.Errorf("cache benchmark unavailable: cache store is not configured")
	}
	if maxElapsedMS <= 0 {
		maxElapsedMS = int64(duration / time.Millisecond)
		if maxElapsedMS <= 0 {
			maxElapsedMS = 1
		}
	}
	if totalWeight <= 0 {
		totalWeight = 1
	}

	storeRows := make([]map[string]any, 0, len(perStore))
	for _, report := range perStore {
		storeRows = append(storeRows, map[string]any{
			"name":        report.Queue,
			"driver":      report.Driver,
			"ops":         report.Ops,
			"ops_per_sec": report.OpsPerSec,
			"errors":      report.Errors,
			"p95_ms":      report.P95MS,
			"elapsed_ms":  report.ElapsedMS,
		})
	}

	driverLabel := "-"
	if len(driversSeen) > 0 {
		drivers := make([]string, 0, len(driversSeen))
		for driver := range driversSeen {
			drivers = append(drivers, driver)
		}
		sort.Strings(drivers)
		driverLabel = strings.Join(drivers, ",")
	}

	result := BenchmarkSuiteResult{
		Suite:       "cache",
		Driver:      driverLabel,
		DurationMS:  int64(duration / time.Millisecond),
		Concurrency: concurrency,
		PayloadSize: payloadSize,
		StartedAt:   started.UTC().Format(time.RFC3339),
		CompletedAt: time.Now().UTC().Format(time.RFC3339),
		ElapsedMS:   maxElapsedMS,
		Ops:         totalOps,
		OpsPerSec:   totalOpsPerSec,
		Errors:      totalErrors,
		P50MS:       weightedP50 / totalWeight,
		P95MS:       weightedP95 / totalWeight,
		P99MS:       weightedP99 / totalWeight,
		Extra: map[string]any{
			"instance_count":     len(perStore),
			"instances":          storeRows,
			"driver":             driverLabel,
			"configured_driver":  driverLabel,
			"throughput_metric":  "cache_ops_per_sec",
		},
	}
	enrichBenchmarkResult(&result)
	return result, nil
}

func runCacheBenchmarkStore(ctx context.Context, cacheInstance *cache.Cache, cacheName string, duration time.Duration, concurrency, payloadSize int, started time.Time) BenchmarkSuiteResult {
	store := cacheInstance.Store()
	payload := bytes.Repeat([]byte{'a'}, payloadSize)
	var ops int64
	var errs int64
	latencies := make([]float64, 0, 2048)
	var latMu sync.Mutex
	warmup := benchmarkWarmup(duration)
	measureStart := started.Add(warmup)
	deadline := measureStart.Add(duration)
	runPrefix := fmt.Sprintf("lighthouse:bench:%d:%s", started.UnixNano(), cacheName)
	windowCounts := initWindowCounts(duration)
	var windowMu sync.Mutex
	workerSeqs := make([]int, concurrency)
	var wg sync.WaitGroup
	for worker := 0; worker < concurrency; worker++ {
		wg.Add(1)
		go func(workerID int) {
			defer wg.Done()
			seq := 0
			for {
				now := time.Now()
				if now.After(deadline) {
					workerSeqs[workerID] = seq
					return
				}
				measured := !now.Before(measureStart)
				key := fmt.Sprintf("%s:%d:%d", runPrefix, workerID, seq)
				seq++
				opStarted := time.Now()
				if err := store.Set(ctx, key, payload, 2*time.Minute); err != nil {
					if measured {
						atomic.AddInt64(&errs, 1)
					}
					continue
				}
				_, ok, err := store.Get(ctx, key)
				if err != nil || !ok {
					if measured {
						atomic.AddInt64(&errs, 1)
					}
					continue
				}
				if measured {
					atomic.AddInt64(&ops, 1)
					ms := float64(time.Since(opStarted)) / float64(time.Millisecond)
					latMu.Lock()
					latencies = append(latencies, ms)
					latMu.Unlock()
					recordWindowCount(windowCounts, &windowMu, measureStart, time.Now())
				}
			}
		}(worker)
	}
	wg.Wait()

	completed := time.Now()
	elapsed := completed.Sub(measureStart)
	if elapsed <= 0 {
		elapsed = time.Millisecond
	}
	p50, p95, p99 := latencyPercentiles(latencies)
	driver := detectCacheDriver(cacheInstance, cacheName)
	result := BenchmarkSuiteResult{
		Suite:       "cache",
		Driver:      driver,
		DurationMS:  int64(duration / time.Millisecond),
		Concurrency: concurrency,
		PayloadSize: payloadSize,
		Queue:       cacheName,
		StartedAt:   started.UTC().Format(time.RFC3339),
		CompletedAt: completed.UTC().Format(time.RFC3339),
		ElapsedMS:   int64(elapsed / time.Millisecond),
		Ops:         ops,
		OpsPerSec:   float64(ops) / elapsed.Seconds(),
		Errors:      errs,
		P50MS:       p50,
		P95MS:       p95,
		P99MS:       p99,
		Extra: map[string]any{
			"driver":      driver,
			"configured_driver": driver,
			"warmup_ms":   int64(warmup / time.Millisecond),
			"window_ms":   1000,
			"window_ops":  buildWindowOps(windowCounts),
			"window_type": "steady_state",
		},
	}
	enrichBenchmarkResult(&result)
	cleanupCacheBenchmarkRun(ctx, store, runPrefix, workerSeqs)
	return result
}

func cleanupCacheBenchmarkRun(ctx context.Context, store cachecore.Store, runPrefix string, workerSeqs []int) {
	for workerID, seqs := range workerSeqs {
		for seq := 0; seq < seqs; seq++ {
			_ = store.Delete(ctx, fmt.Sprintf("%s:%d:%d", runPrefix, workerID, seq))
		}
	}
}

func detectCacheDriver(cacheInstance *cache.Cache, cacheName string) string {
	allowed := []string{
		string(cachecore.DriverNull),
		string(cachecore.DriverFile),
		string(cachecore.DriverMemory),
		string(cachecore.DriverMemcached),
		string(cachecore.DriverDynamo),
		string(cachecore.DriverSQL),
		string(cachecore.DriverRedis),
		string(cachecore.DriverNATS),
	}
	key := "CACHE_DRIVER"
	if normalizedBenchmarkName(cacheName) != "default" {
		key = "CACHE_" + strings.ToUpper(cacheName) + "_DRIVER"
	}
	configured := strings.ToLower(strings.TrimSpace(env.GetEnum(key, env.Get("CACHE_DRIVER", string(cachecore.DriverMemory)), allowed)))
	candidates := []string{
		string(cacheInstance.Driver()),
		configured,
		strings.ToLower(fmt.Sprintf("%T", cacheInstance.Store())),
	}
	for _, candidate := range candidates {
		if candidate == "" {
			continue
		}
		if normalized := runtime.NormalizeCacheDriver(candidate); normalized != "" {
			return normalized
		}
	}
	if normalized := runtime.NormalizeCacheDriver(configured); normalized != "" {
		return normalized
	}
	return string(cachecore.DriverMemory)
}
