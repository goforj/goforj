func isQueuePausedDispatchErr(err error) bool {
	if err == nil {
		return false
	}
	return strings.Contains(strings.ToLower(err.Error()), "queue is paused")
}

func waitForQueuePauseState(
	ctx context.Context,
	queueInstance *queue.Queue,
	queueName string,
	paused bool,
	timeout time.Duration,
) error {
	deadline := time.Now().Add(timeout)
	for {
		stats, err := queueInstance.Stats(ctx)
		if err == nil {
			counters := stats.ByQueue[queueName]
			isPaused := counters.Paused > 0
			if isPaused == paused {
				return nil
			}
		}
		if time.Now().After(deadline) {
			if paused {
				return fmt.Errorf("queue %q did not enter paused state in time", queueName)
			}
			return fmt.Errorf("queue %q did not resume in time", queueName)
		}
		time.Sleep(100 * time.Millisecond)
	}
}

