	httpBenchmarkClientOnce sync.Once
	httpBenchmarkClientInst *http.Client
)

// NewLighthouseRuntime creates the Lighthouse runtime for the jobs process.
func NewLighthouseRuntime(
	logger *logger.AppLogger,
{{- if .ProjectComponents.Storage }}
	storage *storages.Manager,
{{- end }}
	queues *queues.Manager,
	inspectManager *inspects.Manager,
{{- if .ProjectComponents.Metrics }}
	metricsManager *metrics.Manager,
{{- end }}
{{- if .ProjectComponents.HasDatabase }}
	dbConnections *database.Connections,
{{- end }}
) *LighthouseRuntime {
	componentLogger := logger.WithComponent("Jobs")
	return &LighthouseRuntime{
		agent:        lighthouse.NewAgent(lighthouse.LoadAgentConfig("jobs")),
		logger:       componentLogger,
		queues:       queues,
		defaultQueue: queues.Default(),
		inspects:     inspectManager,
{{- if .ProjectComponents.Metrics }}
		metrics:      metricsManager,
{{- end }}
		benchmarks: newBenchmarkRunner(
			queues,
{{- if .ProjectComponents.Storage }}
			storage,
{{- end }}
{{- if .ProjectComponents.HasDatabase }}
			dbConnections,
{{- else }}
			nil,
{{- end }}
		),
	}
}

