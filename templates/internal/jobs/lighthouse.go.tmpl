// runStorageBenchmark selects the default generated disk before starting a bounded benchmark run.
func runStorageBenchmark(ctx context.Context, manager *storages.Manager, duration time.Duration, concurrency, payloadSize int, started time.Time) (BenchmarkSuiteResult, error) {
	if manager == nil {
		return BenchmarkSuiteResult{}, fmt.Errorf("storage benchmark unavailable: storage is not configured")
	}
	instances := manager.Instances()
	perDisk := make([]BenchmarkSuiteResult, 0, len(instances))
	var totalOps int64
	var totalErrors int64
	var totalOpsPerSec float64
	var totalWriteOps int64
	var totalReadOps int64
	var totalDeleteOps int64
	var weightedP50 float64
	var weightedP95 float64
	var weightedP99 float64
	var totalWeight float64
	var maxElapsedMS int64
	driversSeen := map[string]struct{}{}

	for _, instance := range instances {
		disk := instance.Disk
		if disk == nil {
			continue
		}
		report := runStorageBenchmarkDisk(ctx, disk, normalizedBenchmarkName(instance.Name), duration, concurrency, payloadSize, started)
		perDisk = append(perDisk, report)
		totalOps += report.Ops
		totalErrors += report.Errors
		totalOpsPerSec += report.OpsPerSec
		if report.ElapsedMS > maxElapsedMS {
			maxElapsedMS = report.ElapsedMS
		}
		weight := float64(report.Ops)
		if weight <= 0 {
			weight = 1
		}
		totalWeight += weight
		weightedP50 += report.P50MS * weight
		weightedP95 += report.P95MS * weight
		weightedP99 += report.P99MS * weight
		if report.Extra != nil {
			if v, ok := report.Extra["write_ops"].(int64); ok {
				totalWriteOps += v
			}
			if v, ok := report.Extra["read_ops"].(int64); ok {
				totalReadOps += v
			}
			if v, ok := report.Extra["delete_ops"].(int64); ok {
				totalDeleteOps += v
			}
		}
		if report.Driver != "" && report.Driver != "-" {
			driversSeen[report.Driver] = struct{}{}
		}
	}
	if len(perDisk) == 0 {
		return BenchmarkSuiteResult{}, fmt.Errorf("storage benchmark unavailable: storage is not configured")
	}
	if maxElapsedMS <= 0 {
		maxElapsedMS = int64(duration / time.Millisecond)
		if maxElapsedMS <= 0 {
			maxElapsedMS = 1
		}
	}
	if totalWeight <= 0 {
		totalWeight = 1
	}

	diskRows := make([]map[string]any, 0, len(perDisk))
	for _, report := range perDisk {
		diskRows = append(diskRows, map[string]any{
			"name":        report.Queue,
			"driver":      report.Driver,
			"ops":         report.Ops,
			"ops_per_sec": report.OpsPerSec,
			"errors":      report.Errors,
			"p95_ms":      report.P95MS,
			"elapsed_ms":  report.ElapsedMS,
		})
	}

	driverLabel := "-"
	if len(driversSeen) > 0 {
		drivers := make([]string, 0, len(driversSeen))
		for driver := range driversSeen {
			drivers = append(drivers, driver)
		}
		sort.Strings(drivers)
		driverLabel = strings.Join(drivers, ",")
	}

	result := BenchmarkSuiteResult{
		Suite:       "storage",
		Driver:      driverLabel,
		DurationMS:  int64(duration / time.Millisecond),
		Concurrency: concurrency,
		PayloadSize: payloadSize,
		StartedAt:   started.UTC().Format(time.RFC3339),
		CompletedAt: time.Now().UTC().Format(time.RFC3339),
		ElapsedMS:   maxElapsedMS,
		Ops:         totalOps,
		OpsPerSec:   totalOpsPerSec,
		Errors:      totalErrors,
		P50MS:       weightedP50 / totalWeight,
		P95MS:       weightedP95 / totalWeight,
		P99MS:       weightedP99 / totalWeight,
		Extra: map[string]any{
			"instance_count":    len(perDisk),
			"instances":         diskRows,
			"write_ops":         totalWriteOps,
			"read_ops":          totalReadOps,
			"delete_ops":        totalDeleteOps,
			"driver":            driverLabel,
			"throughput_metric": "storage_ops_per_sec",
		},
	}
	enrichBenchmarkResult(&result)
	return result, nil
}

// runStorageBenchmarkDisk isolates benchmark objects under a run prefix so cleanup never touches App data.
func runStorageBenchmarkDisk(ctx context.Context, disk storage.Storage, diskName string, duration time.Duration, concurrency, payloadSize int, started time.Time) BenchmarkSuiteResult {
	payload := bytes.Repeat([]byte{'s'}, payloadSize)
	var ops int64
	var errs int64
	var writeOps int64
	var readOps int64
	var deleteOps int64
	latencies := make([]float64, 0, 2048)
	var latMu sync.Mutex
	warmup := benchmarkWarmup(duration)
	measureStart := started.Add(warmup)
	deadline := measureStart.Add(duration)
	runPrefix := fmt.Sprintf("lighthouse/bench/%d/%s", started.UnixNano(), diskName)
	windowCounts := initWindowCounts(duration)
	var windowMu sync.Mutex
	var wg sync.WaitGroup
	for worker := 0; worker < concurrency; worker++ {
		wg.Add(1)
		go func(workerID int) {
			defer wg.Done()
			seq := 0
			for {
				now := time.Now()
				if now.After(deadline) {
					return
				}
				measured := !now.Before(measureStart)
				key := fmt.Sprintf("%s/%d/%d.bin", runPrefix, workerID, seq)
				seq++
				opStarted := time.Now()
				if err := disk.WithContext(ctx).Put(key, payload); err != nil {
					if measured {
						atomic.AddInt64(&errs, 1)
					}
					continue
				}
				if measured {
					atomic.AddInt64(&writeOps, 1)
				}
				data, err := disk.WithContext(ctx).Get(key)
				if err != nil || !bytes.Equal(data, payload) {
					if measured {
						atomic.AddInt64(&errs, 1)
					}
					_ = disk.WithContext(ctx).Delete(key)
					continue
				}
				if measured {
					atomic.AddInt64(&readOps, 1)
				}
				if err := disk.WithContext(ctx).Delete(key); err != nil {
					if measured {
						atomic.AddInt64(&errs, 1)
					}
					continue
				}
				if measured {
					atomic.AddInt64(&deleteOps, 1)
					atomic.AddInt64(&ops, 1)
					ms := float64(time.Since(opStarted)) / float64(time.Millisecond)
					latMu.Lock()
					latencies = append(latencies, ms)
					latMu.Unlock()
					recordWindowCount(windowCounts, &windowMu, measureStart, time.Now())
				}
			}
		}(worker)
	}
	wg.Wait()

	completed := time.Now()
	elapsed := completed.Sub(measureStart)
	if elapsed <= 0 {
		elapsed = time.Millisecond
	}
	p50, p95, p99 := latencyPercentiles(latencies)
	driver := "-"
	for _, instance := range runtime.DiscoverStorageInstances() {
		if normalizedBenchmarkName(instance.Name) == normalizedBenchmarkName(diskName) {
			driver = runtime.NormalizeStorageDriver(instance.Driver)
			break
		}
	}
	result := BenchmarkSuiteResult{
		Suite:       "storage",
		Driver:      driver,
		DurationMS:  int64(duration / time.Millisecond),
		Concurrency: concurrency,
		PayloadSize: payloadSize,
		Queue:       diskName,
		StartedAt:   started.UTC().Format(time.RFC3339),
		CompletedAt: completed.UTC().Format(time.RFC3339),
		ElapsedMS:   int64(elapsed / time.Millisecond),
		Ops:         ops,
		OpsPerSec:   float64(ops) / elapsed.Seconds(),
		Errors:      errs,
		P50MS:       p50,
		P95MS:       p95,
		P99MS:       p99,
		Extra: map[string]any{
			"write_ops":         writeOps,
			"read_ops":          readOps,
			"delete_ops":        deleteOps,
			"driver":            driver,
			"warmup_ms":         int64(warmup / time.Millisecond),
			"window_ms":         1000,
			"window_ops":        buildWindowOps(windowCounts),
			"throughput_metric": "storage_ops_per_sec",
		},
	}
	enrichBenchmarkResult(&result)
	cleanupStorageBenchmarkRun(ctx, disk, runPrefix)
	return result
}

// cleanupStorageBenchmarkRun removes only entries created beneath the benchmark run prefix.
func cleanupStorageBenchmarkRun(ctx context.Context, disk storage.Storage, prefix string) {
	disk = disk.WithContext(ctx)
	paths := storageBenchmarkPaths(disk, prefix)
	for _, path := range paths {
		_ = disk.Delete(path)
	}
}

// storageBenchmarkPaths orders run-owned entries deepest first so directory cleanup is safe.
func storageBenchmarkPaths(disk storage.Storage, prefix string) []string {
	if strings.TrimSpace(prefix) == "" {
		return nil
	}
	seen := map[string]struct{}{}
	if err := disk.Walk(prefix, func(entry storage.Entry) error {
		if entry.Path == "" {
			return nil
		}
		seen[entry.Path] = struct{}{}
		return nil
	}); err == nil {
		seen[prefix] = struct{}{}
		paths := make([]string, 0, len(seen))
		for path := range seen {
			paths = append(paths, path)
		}
		sort.Slice(paths, func(i, j int) bool {
			return depth(paths[i]) > depth(paths[j])
		})
		return paths
	}
	paths := storageBenchmarkPathsRecursive(disk, prefix, seen)
	sort.Slice(paths, func(i, j int) bool {
		return depth(paths[i]) > depth(paths[j])
	})
	return paths
}

// storageBenchmarkPathsRecursive bounds traversal to the benchmark prefix while avoiding duplicate backend entries.
func storageBenchmarkPathsRecursive(disk storage.Storage, prefix string, seen map[string]struct{}) []string {
	if prefix == "" {
		return nil
	}
	if _, ok := seen[prefix]; ok {
		return nil
	}
	seen[prefix] = struct{}{}

	entries, err := disk.List(prefix)
	if err != nil {
		return []string{prefix}
	}

	paths := make([]string, 0, len(entries)+1)
	for _, entry := range entries {
		child := entry.Path
		if child == "" {
			continue
		}
		if entry.IsDir {
			paths = append(paths, storageBenchmarkPathsRecursive(disk, child, seen)...)
			continue
		}
		if _, ok := seen[child]; ok {
			continue
		}
		seen[child] = struct{}{}
		paths = append(paths, child)
	}

	return append(paths, prefix)
}

// depth supplies deterministic deepest-first ordering for Storage benchmark cleanup.
func depth(path string) int {
	if path == "" {
		return 0
	}
	return strings.Count(path, "/")
}
