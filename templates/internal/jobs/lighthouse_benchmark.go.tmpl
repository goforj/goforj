type benchmarkQueueRun struct {
	dispatched int64
	processed  int64
	failed     int64
}

type lighthouseBenchmarkQueuePayload struct {
	RunID string `json:"run_id"`
	Bytes int    `json:"bytes"`
}

var (
	benchmarkQueuePrefillDefault = int64(100000)
	benchmarkQueueDrainMax       = 3 * time.Minute
	benchmarkQueueRunSeq         int64
	benchmarkQueueRuns           sync.Map // map[string]*benchmarkQueueRun
)

func newBenchmarkQueueRunID() string {
	seq := atomic.AddInt64(&benchmarkQueueRunSeq, 1)
	return fmt.Sprintf("%d-%d", time.Now().UnixNano(), seq)
}

func handleLighthouseBenchmarkQueueTask(_ context.Context, msg queue.Message) error {
	var payload lighthouseBenchmarkQueuePayload
	if err := msg.Bind(&payload); err != nil {
		if payload.RunID != "" {
			if raw, ok := benchmarkQueueRuns.Load(payload.RunID); ok {
				if run, cast := raw.(*benchmarkQueueRun); cast && run != nil {
					atomic.AddInt64(&run.failed, 1)
				}
			}
		}
		return err
	}
	if payload.Bytes > 0 {
		_ = bytes.Repeat([]byte{'x'}, payload.Bytes)
	}
	if payload.RunID != "" {
		if raw, ok := benchmarkQueueRuns.Load(payload.RunID); ok {
			if run, cast := raw.(*benchmarkQueueRun); cast && run != nil {
				atomic.AddInt64(&run.processed, 1)
			}
		}
	}
	return nil
}

type BenchmarkRunRequest struct {
	Suite       string `json:"suite"`
	Instance    string `json:"instance,omitempty"`
	DurationMS  int64  `json:"duration_ms"`
	Concurrency int    `json:"concurrency"`
	PayloadSize int    `json:"payload_size"`
	Queue       string `json:"queue"`
	Sweep       bool   `json:"sweep"`
	SweepMax    int    `json:"sweep_max"`
}

type BenchmarkSuiteResult struct {
	Suite       string         `json:"suite"`
	Driver      string         `json:"driver"`
	DurationMS  int64          `json:"duration_ms"`
	Concurrency int            `json:"concurrency"`
	PayloadSize int            `json:"payload_size"`
	Queue       string         `json:"queue,omitempty"`
	StartedAt   string         `json:"started_at"`
	CompletedAt string         `json:"completed_at"`
	ElapsedMS   int64          `json:"elapsed_ms"`
	Ops         int64          `json:"ops"`
	OpsPerSec   float64        `json:"ops_per_sec"`
	Errors      int64          `json:"errors"`
	P50MS       float64        `json:"p50_ms"`
	P95MS       float64        `json:"p95_ms"`
	P99MS       float64        `json:"p99_ms"`
	Extra       map[string]any `json:"extra,omitempty"`
}

// catalog advertises only suites whose required managers are available to this App.
func (r *benchmarkRunner) catalog() map[string]any {
	catalog := map[string]any{
		"queue": map[string]any{
			"instances": benchmarkQueueCatalog(r.queues),
		},
	}
{{- if .ProjectComponents.Cache }}
	if r.caches != nil {
		catalog["cache"] = map[string]any{
			"instances": benchmarkCacheCatalog(),
		}
	}
{{- end }}
{{- if .ProjectComponents.HasDatabase }}
	if r.db != nil {
		catalog["db"] = map[string]any{
			"instances": benchmarkDBCatalog(),
		}
	}
{{- end }}
{{- if .ProjectComponents.Storage }}
	if r.storages != nil {
		catalog["storage"] = map[string]any{
			"instances": benchmarkStorageCatalog(),
		}
	}
{{- end }}
	return catalog
}

{{- if .ProjectComponents.Cache }}
// benchmarkCacheCatalog projects generated stores into the bounded Lighthouse benchmark catalog.
func benchmarkCacheCatalog() []benchmarkCatalogItem {
	instances := runtime.DiscoverCacheInstances()
	items := make([]benchmarkCatalogItem, 0, len(instances))
	for _, instance := range instances {
		items = append(items, benchmarkCatalogItem{
			Name:   normalizedBenchmarkName(instance.Name),
			Driver: runtime.NormalizeCacheDriver(instance.Driver),
		})
	}
	return items
}
{{- end }}

func benchmarkQueueCatalog(queues *queues.Manager) []benchmarkCatalogItem {
	instances := runtime.DiscoverQueueInstances()
	items := make([]benchmarkCatalogItem, 0, len(instances))
	runtimeDrivers := map[string]string{}
	if queues != nil {
		for _, instance := range queues.Instances() {
			if instance.Queue == nil {
				continue
			}
			runtimeDrivers[normalizedBenchmarkName(instance.Name)] = runtime.NormalizeQueueDriver(string(instance.Queue.Driver()))
		}
	}
	for _, instance := range instances {
		driver := benchmarkQueueCatalogDriver(runtimeDrivers, instance.Name, instance.Driver)
		items = append(items, benchmarkCatalogItem{
			Name:   normalizedBenchmarkName(instance.Name),
			Driver: driver,
		})
	}
	return items
}

func benchmarkQueueCatalogDriver(runtimeDrivers map[string]string, instanceName, fallback string) string {
	driver := runtimeDrivers[normalizedBenchmarkName(instanceName)]
	if driver != "" {
		return driver
	}
	return runtime.NormalizeQueueDriver(fallback)
}

