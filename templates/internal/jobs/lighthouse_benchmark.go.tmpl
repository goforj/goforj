// run dispatches one normalized benchmark request without widening the App's component surface.
func (r *benchmarkRunner) run(ctx context.Context, req BenchmarkRunRequest) (BenchmarkSuiteResult, error) {
	if req.Sweep {
		return r.runSweep(ctx, req)
	}
	duration := time.Duration(req.DurationMS) * time.Millisecond
	if duration <= 0 {
		duration = 15 * time.Second
	}
	payloadSize := req.PayloadSize
	if payloadSize < 0 {
		payloadSize = 0
	}
	if payloadSize > 256*1024 {
		payloadSize = 256 * 1024
	}
	started := time.Now()
	instanceName := optionalBenchmarkName(req.Instance)
	switch r.suiteName(req.Suite) {
{{- if .ProjectComponents.Cache }}
	case "cache":
		return r.runCache(ctx, instanceName, duration, req.Concurrency, payloadSize, started)
{{- end }}
	case "queue":
		return r.runQueue(ctx, instanceName, duration, req.Concurrency, payloadSize, req.Queue, started)
	case "db":
{{- if .ProjectComponents.HasDatabase }}
		return r.runDB(ctx, instanceName, duration, req.Concurrency, payloadSize, started)
{{- else }}
		return BenchmarkSuiteResult{}, fmt.Errorf("database benchmark unavailable: db connection is not configured")
{{- end }}
{{- if .ProjectComponents.Storage }}
	case "storage":
		return r.runStorage(ctx, instanceName, duration, req.Concurrency, payloadSize, started)
{{- end }}
	case "http":
		return runHTTPBenchmark(ctx, duration, benchmarkConcurrency(req.Concurrency, 8, 512), started), nil
	default:
		return BenchmarkSuiteResult{}, fmt.Errorf("unsupported benchmark suite: %s", r.suiteName(req.Suite))
	}
}

// runBenchmark shares the Lighthouse runner contract with the generated CLI benchmark command.
func runBenchmark(
	ctx context.Context,
{{- if .ProjectComponents.Cache }}
	caches *caches.Manager,
{{- end }}
	queues *queues.Manager,
{{- if .ProjectComponents.Storage }}
	storages *storages.Manager,
{{- end }}
{{- if .ProjectComponents.HasDatabase }}
	dbConnections *database.Connections,
{{- else }}
	_ any,
{{- end }}
	req BenchmarkRunRequest,
) (BenchmarkSuiteResult, error) {
	runner := newBenchmarkRunner(
		queues,
{{- if .ProjectComponents.Storage }}
		storages,
{{- end }}
{{- if .ProjectComponents.HasDatabase }}
		dbConnections,
{{- else }}
		nil,
{{- end }}
	)
{{- if .ProjectComponents.Cache }}
	runner.caches = caches
{{- end }}
	return runner.run(ctx, req)
}

func (r *benchmarkRunner) suiteName(suite string) string {
	value := strings.TrimSpace(strings.ToLower(suite))
	if value == "" {
{{- if .ProjectComponents.Cache }}
		if r.caches != nil {
			return "cache"
		}
{{- end }}
		return "queue"
	}
	return value
}

{{- if .ProjectComponents.Cache }}
func (r *benchmarkRunner) cacheInstances() map[string]*cache.Cache {
	out := map[string]*cache.Cache{}
	if r.caches == nil {
		return out
	}
	for _, instance := range r.caches.Instances() {
		if instance.Store == nil {
			continue
		}
		out[normalizedBenchmarkName(instance.Name)] = instance.Store
	}
	return out
}
{{- end }}

func (r *benchmarkRunner) queueInstances() map[string]*queue.Queue {
	out := map[string]*queue.Queue{}
	if r.queues == nil {
		return out
	}
	for _, instance := range r.queues.Instances() {
		if instance.Queue == nil {
			continue
		}
		out[normalizedBenchmarkName(instance.Name)] = instance.Queue
	}
	return out
}

{{- if .ProjectComponents.Storage }}
