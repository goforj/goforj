{{- if .ProjectComponents.Cache }}
// runCache rejects unavailable App-local Cache support before invoking the shared benchmark implementation.
func (r *benchmarkRunner) runCache(ctx context.Context, instanceName string, duration time.Duration, concurrency, payloadSize int, started time.Time) (BenchmarkSuiteResult, error) {
	concurrency = benchmarkConcurrency(concurrency, 8, 256)
	if r.caches == nil || r.caches.Default() == nil {
		return BenchmarkSuiteResult{}, fmt.Errorf("cache benchmark unavailable: cache store is not configured")
	}
	if instanceName != "" {
		cacheInstance := r.cacheInstances()[instanceName]
		if cacheInstance == nil {
			return BenchmarkSuiteResult{}, fmt.Errorf("cache benchmark unavailable: cache instance %q is not configured", instanceName)
		}
		return runCacheBenchmarkStore(ctx, cacheInstance, instanceName, duration, concurrency, payloadSize, started), nil
	}
	return runCacheBenchmark(ctx, r.caches, duration, concurrency, payloadSize, started)
}
{{- end }}

func (r *benchmarkRunner) runQueue(ctx context.Context, instanceName string, duration time.Duration, concurrency, payloadSize int, queueName string, started time.Time) (BenchmarkSuiteResult, error) {
	concurrency = benchmarkConcurrency(concurrency, 8, 1024)
	if r.queues == nil || r.queues.Default() == nil {
		return BenchmarkSuiteResult{}, fmt.Errorf("queue benchmark unavailable: queue is not configured")
	}
	if instanceName != "" {
		queueInstance := r.queueInstances()[instanceName]
		if queueInstance == nil {
			return BenchmarkSuiteResult{}, fmt.Errorf("queue benchmark unavailable: queue instance %q is not configured", instanceName)
		}
		queueName = strings.TrimSpace(queueName)
		if queueName == "" {
			queueName = benchmarkQueueDefaultQueue(instanceName)
		}
		return runQueueBenchmarkInstance(ctx, queueInstance, duration, concurrency, payloadSize, instanceName, queueName, started)
	}
	return runQueueBenchmark(ctx, r.queues, duration, concurrency, payloadSize, queueName, started)
}

{{- if .ProjectComponents.HasDatabase }}
// runDB rejects unavailable App-local Database support before starting a benchmark.
func (r *benchmarkRunner) runDB(ctx context.Context, instanceName string, duration time.Duration, concurrency, payloadSize int, started time.Time) (BenchmarkSuiteResult, error) {
	concurrency = benchmarkConcurrency(concurrency, 8, 128)
	if r.db == nil {
		return BenchmarkSuiteResult{}, fmt.Errorf("database benchmark unavailable: db connection is not configured")
	}
	if instanceName != "" {
		report, err := runDBBenchmarkConnection(ctx, r.db, instanceName, duration, concurrency, payloadSize, started)
		if err != nil {
			return BenchmarkSuiteResult{}, err
		}
		if report.Extra == nil {
			report.Extra = map[string]any{}
		}
		report.Extra["instance"] = instanceName
		return report, nil
	}
	return runDBBenchmark(ctx, r.db, duration, concurrency, payloadSize, started)
}
{{- end }}

{{- if .ProjectComponents.Storage }}
// runStorage rejects unavailable App-local Storage before invoking the shared benchmark implementation.
func (r *benchmarkRunner) runStorage(ctx context.Context, instanceName string, duration time.Duration, concurrency, payloadSize int, started time.Time) (BenchmarkSuiteResult, error) {
	concurrency = benchmarkConcurrency(concurrency, 8, 128)
	if r.storages == nil || r.storages.Default() == nil {
		return BenchmarkSuiteResult{}, fmt.Errorf("storage benchmark unavailable: storage is not configured")
	}
	if instanceName != "" {
		disk := r.storageInstances()[instanceName]
		if disk == nil {
			return BenchmarkSuiteResult{}, fmt.Errorf("storage benchmark unavailable: storage instance %q is not configured", instanceName)
		}
		return runStorageBenchmarkDisk(ctx, disk, instanceName, duration, concurrency, payloadSize, started), nil
	}
	return runStorageBenchmark(ctx, r.storages, duration, concurrency, payloadSize, started)
}
{{- end }}

func benchmarkConcurrency(value, fallback, max int) int {
	if value <= 0 {
		value = fallback
	}
	if value > max {
		value = max
	}
	return value
}

func (r *benchmarkRunner) runSweep(ctx context.Context, req BenchmarkRunRequest) (BenchmarkSuiteResult, error) {
	baseConcurrency := req.Concurrency
	if baseConcurrency <= 0 {
		baseConcurrency = 8
	}
	maxConcurrency := req.SweepMax
	if maxConcurrency <= 0 {
		maxConcurrency = baseConcurrency
	}
	if maxConcurrency < baseConcurrency {
		maxConcurrency = baseConcurrency
	}
	if maxConcurrency > 128 {
		maxConcurrency = 128
	}

	levels := make([]int, 0, 8)
	level := 1
	for level < baseConcurrency {
		levels = append(levels, level)
		level *= 2
	}
	if len(levels) == 0 || levels[len(levels)-1] != baseConcurrency {
		levels = append(levels, baseConcurrency)
	}
	for level < maxConcurrency {
		level *= 2
		if level > maxConcurrency {
			level = maxConcurrency
		}
		if levels[len(levels)-1] == level {
			break
		}
		levels = append(levels, level)
		if level == maxConcurrency {
			break
		}
	}

	sweepRows := make([]map[string]any, 0, len(levels))
	var final BenchmarkSuiteResult
	var best int = -1
	var bestOps float64
	for idx, c := range levels {
		childReq := req
		childReq.Sweep = false
		childReq.Concurrency = c
		report, err := r.run(ctx, childReq)
		if err != nil {
			return BenchmarkSuiteResult{}, err
		}
		errRate := benchmarkErrorRate(report)
		row := map[string]any{
			"concurrency": c,
			"ops_per_sec": report.OpsPerSec,
			"p95_ms":      report.P95MS,
			"errors":      report.Errors,
			"error_rate":  errRate,
		}
		sweepRows = append(sweepRows, row)
		if errRate <= 0.01 && report.OpsPerSec >= bestOps {
			bestOps = report.OpsPerSec
			best = c
		}
		if idx == len(levels)-1 {
			final = report
		}
	}
	if final.Extra == nil {
		final.Extra = map[string]any{}
	}
	final.Extra["sweep"] = sweepRows
	final.Extra["sweep_levels"] = levels
	if best > 0 {
		final.Extra["recommended_concurrency"] = best
	}
	return final, nil
}
