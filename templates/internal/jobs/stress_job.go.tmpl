package jobs

import (
	"context"
	"encoding/json"
	"fmt"
	"time"

	"{{.GoModuleName}}/internal/queues"
	"github.com/goforj/queue"
)

const StressJobTypeName = "stress:synthetic"

// StressJobPayload controls synthetic workload behavior for queue stress testing.
type StressJobPayload struct {
	Queue   string `json:"queue"`
	SleepMs int    `json:"sleep_ms"`
	Fail    bool   `json:"fail"`
}

// StressJob is a synthetic workload handler used to stress queue drivers.
type StressJob struct {
	queues *queues.Manager
}

func NewStressJob(queues *queues.Manager) *StressJob {
	return &StressJob{queues: queues}
}

func (j *StressJob) Enqueue(ctx context.Context, queueName string, payload StressJobPayload) error {
	body, err := json.Marshal(payload)
	if err != nil {
		return err
	}
	_, err = j.queues.WithContext(ctx).Dispatch(
		queue.NewJob(StressJobTypeName).
			Payload(body).
			OnQueue(queueName).
			Timeout(30*time.Second).
			Retry(1),
	)
	return err
}

func (j *StressJob) HandleTask(_ context.Context, msg queue.Message) error {
	var payload StressJobPayload
	if err := msg.Bind(&payload); err != nil {
		return fmt.Errorf("json.Unmarshal failed: %w", err)
	}
	if payload.SleepMs > 0 {
		time.Sleep(time.Duration(payload.SleepMs) * time.Millisecond)
	}
	if payload.Fail {
		return fmt.Errorf("synthetic failure on queue %s", payload.Queue)
	}
	return nil
}
