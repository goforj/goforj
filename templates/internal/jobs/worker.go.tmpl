package jobs

import (
	"context"
	"errors"
	"fmt"
	"os/signal"
	"sort"
	"strings"
	"sync"
	"syscall"
	"time"
	"{{.GoModuleName}}/internal/runtime"
	"{{.GoModuleName}}/internal/logger"
	"{{.GoModuleName}}/internal/maintenance"
	"{{.GoModuleName}}/internal/queues"
	"github.com/goforj/queue"
	"github.com/goforj/str/v2"
)

// Worker owns the generated Queue instances for one Jobs runtime.
type Worker struct {
	logger      *logger.AppLogger
	lighthouse  *LighthouseRuntime
	appTimeouts *runtime.Timeouts
	queues      *queues.Manager
}

// NewWorker creates a Worker from dependencies that the Jobs wire set guarantees.
func NewWorker(
	logger *logger.AppLogger,
	lighthouse *LighthouseRuntime,
	appTimeouts *runtime.Timeouts,
	queues *queues.Manager,
) *Worker {
	return &Worker{
		logger:      logger.WithComponent("Jobs"),
		lighthouse:  lighthouse,
		appTimeouts: appTimeouts,
		queues: queues,
	}
}

// Start starts the queue worker.
func (s *Worker) Start() error {
	runCtx, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stop()
	return s.StartWithContext(runCtx)
}

// StartWithContext starts the queue worker and blocks until the context is canceled.
func (s *Worker) StartWithContext(runCtx context.Context, queueNames ...string) (runErr error) {
	if runCtx == nil {
		runCtx = context.Background()
	}

	s.lighthouse.Start(runCtx)
	managed, err := selectManagedQueues(s.queues, queueNames...)
	if err != nil {
		return err
	}
	generationOpen := true
	defer func() {
		s.logger.Info().Msg("Shutting down queue worker")
		if generationOpen {
			runErr = errors.Join(runErr, s.shutdownGeneration(managed))
		}
		s.logger.Info().Msg("Queue worker shut down")
	}()
	workersRunning := false
	if !maintenance.Enabled() {
		if err := startManagedQueueWorkers(runCtx, managed); err != nil {
			return err
		}
		workersRunning = true
		s.logWorkerStarted(managed)
	} else {
		s.logger.Info().Msg("Queue worker waiting for maintenance mode to end")
	}

	maintenanceTicker := time.NewTicker(100 * time.Millisecond)
	defer maintenanceTicker.Stop()
	for runCtx.Err() == nil {
		select {
		case <-runCtx.Done():
		case <-maintenanceTicker.C:
			maintenanceEnabled := maintenance.Enabled()
			if maintenanceEnabled && workersRunning {
				s.logger.Info().Msg("Pausing queue worker for maintenance mode")
				if err := s.shutdownGeneration(managed); err != nil {
					return err
				}
				workersRunning = false
				generationOpen = false
				s.logger.Info().Msg("Queue worker paused for maintenance mode")
				continue
			}
			if !maintenanceEnabled && !workersRunning {
				if !generationOpen {
					if err := s.queues.Rebuild(); err != nil {
						return fmt.Errorf("rebuild queues after maintenance: %w", err)
					}
					generationOpen = true
					managed = s.queues.Instances()
					managed, err = selectManagedQueues(s.queues, queueNames...)
					if err != nil {
						return err
					}
				}
				if err := startManagedQueueWorkers(runCtx, managed); err != nil {
					return err
				}
				workersRunning = true
				s.logWorkerStarted(managed)
			}
		}
	}
	return nil
}

// logWorkerStarted reports the active queue allocation whenever a worker generation starts or resumes.
func (s *Worker) logWorkerStarted(managed []queues.Instance) {
	workerCount := managedQueueWorkerCount(managed)
	s.logger.Info().
		CompactValues(strings.Join(managedQueueNames(managed), ", "), fmt.Sprintf("%d %s", workerCount, pluralizeQueueWorkers(workerCount))).
		Str("driver", string(s.queues.Default().Driver())).
		Strs("queues", managedQueueNames(managed)).
		Int("workers", workerCount).
		Strs("queue_workers", managedQueueWorkerAllocations(managed)).
		Msg("Queue worker started")
}

// shutdownGeneration stops intake and gives work already accepted by this worker generation its configured drain window.
func (s *Worker) shutdownGeneration(managed []queues.Instance) error {
	if activeJobs := managedActiveJobs(managed); activeJobs > 0 {
		s.logger.Info().Int64("active_jobs", activeJobs).Msg("Waiting for queue jobs to complete")
	}
	shutdownTimeout := s.appTimeouts.QueueShutdownTimeout()
	shutdownCtx, cancel := context.WithTimeout(context.Background(), shutdownTimeout)
	defer cancel()
	if err := shutdownManagedQueues(shutdownCtx, managed); err != nil {
		if errors.Is(err, context.DeadlineExceeded) {
			return fmt.Errorf("queue shutdown timed out after %s: %w", shutdownTimeout, err)
		}
		return err
	}
	return nil
}

// startManagedQueueWorkers starts every generated Queue because construction already guarantees complete instances.
func startManagedQueueWorkers(ctx context.Context, instances []queues.Instance) error {
	for _, instance := range instances {
		if err := instance.Queue.StartWorkers(ctx); err != nil {
			return err
		}
	}
	return nil
}

// shutdownManagedQueues stops generated Queues concurrently so one slow backend cannot consume every shutdown budget in sequence.
func shutdownManagedQueues(ctx context.Context, instances []queues.Instance) error {
	if len(instances) == 0 {
		return nil
	}
	errs := make(chan error, len(instances))
	var wg sync.WaitGroup
	for _, instance := range instances {
		queueInstance := instance.Queue
		wg.Add(1)
		go func(instance *queue.Queue) {
			defer wg.Done()
			if err := instance.Shutdown(ctx); err != nil {
				errs <- err
			}
		}(queueInstance)
	}
	wg.Wait()
	close(errs)

	var shutdownErr error
	for err := range errs {
		shutdownErr = errors.Join(shutdownErr, err)
	}
	return shutdownErr
}

// managedActiveJobs reports best-effort activity while shutdown is waiting on work already in flight.
func managedActiveJobs(instances []queues.Instance) int64 {
	if len(instances) == 0 {
		return 0
	}

	statsCtx, cancel := context.WithTimeout(context.Background(), time.Second)
	defer cancel()

	var total int64
	for _, instance := range instances {
		snapshot, err := instance.Queue.Stats(statsCtx)
		if err != nil {
			continue
		}
		for _, queueName := range snapshot.Queues() {
			total += snapshot.Active(queueName)
		}
	}
	return total
}

// selectManagedQueues resolves command filters against the manager's generated Queue inventory.
func selectManagedQueues(manager *queues.Manager, queueNames ...string) ([]queues.Instance, error) {
	instances := manager.Instances()
	if len(queueNames) == 0 {
		return instances, nil
	}

	selected := map[string]struct{}{}
	for _, name := range queueNames {
		name = normalizeQueueResourceName(name)
		if name == "" {
			continue
		}
		selected[name] = struct{}{}
	}
	if len(selected) == 0 {
		return instances, nil
	}

	out := make([]queues.Instance, 0, len(selected))
	for _, instance := range instances {
		name := normalizeQueueResourceName(instance.Name)
		if _, ok := selected[name]; !ok {
			continue
		}
		out = append(out, instance)
		delete(selected, name)
	}
	if len(selected) > 0 {
		missing := make([]string, 0, len(selected))
		for name := range selected {
			missing = append(missing, name)
		}
		sort.Strings(missing)
		return nil, fmt.Errorf("unknown queue %q (available: %s)", strings.Join(missing, ","), strings.Join(managedQueueNames(instances), ","))
	}
	return out, nil
}

// managedQueueNames produces stable resource names for logs and unknown-Queue diagnostics.
func managedQueueNames(instances []queues.Instance) []string {
	names := make([]string, 0, len(instances))
	for _, instance := range instances {
		name := normalizeQueueResourceName(instance.Name)
		if name == "" {
			continue
		}
		names = append(names, name)
	}
	sort.Strings(names)
	return names
}

// managedQueueWorkerCount returns the total worker allocation for selected queues.
func managedQueueWorkerCount(instances []queues.Instance) int {
	var total int
	for _, instance := range instances {
		if instance.Workers <= 0 {
			continue
		}
		total += instance.Workers
	}
	return total
}

// managedQueueWorkerAllocations returns stable queue=workers labels for structured logs.
func managedQueueWorkerAllocations(instances []queues.Instance) []string {
	allocations := make([]string, 0, len(instances))
	for _, instance := range instances {
		name := normalizeQueueResourceName(instance.Name)
		if name == "" || instance.Workers <= 0 {
			continue
		}
		allocations = append(allocations, fmt.Sprintf("%s=%d", name, instance.Workers))
	}
	sort.Strings(allocations)
	return allocations
}

// pluralizeQueueWorkers keeps the startup summary grammatical at every worker count.
func pluralizeQueueWorkers(count int) string {
	if count == 1 {
		return "worker"
	}
	return "workers"
}

// normalizeQueueResourceName applies the same case-insensitive lookup convention as generated accessors.
func normalizeQueueResourceName(name string) string {
	return str.Of(name).Trim().ToLower().String()
}
