package jobs

import (
	"context"
	"os/signal"
	"syscall"
	{{- if and .Components.DemoApp .Components.Jobs }}
	"{{.GoModuleName}}/internal/alerts"
	"{{.GoModuleName}}/internal/monitoring"
	{{- end }}
	"{{.GoModuleName}}/internal/app"
	"{{.GoModuleName}}/internal/logger"
	{{- if .Components.Jobs }}
	"{{.GoModuleName}}/internal/queues"
	{{- end }}
	"github.com/goforj/env/v2"
	"github.com/goforj/queue"
)

// Worker is a struct that represents a queue worker.
type Worker struct {
	logger      *logger.AppLogger
	lighthouse  *LighthouseRuntime
	appTimeouts *app.Timeouts
	{{- if .Components.Jobs }}
	queues      *queues.Manager
	{{- end }}
	hello  *ExampleHelloJob
	{{- if and .Components.DemoApp .Components.Jobs }}
	monitorCheck  *monitoring.MonitorCheckJob
	alertDispatch *alerts.DispatchJob
	{{- end }}
}

// NewWorker creates a new Worker with the given logger.
func NewWorker(
	logger *logger.AppLogger,
	lighthouse *LighthouseRuntime,
	appTimeouts *app.Timeouts,
	{{- if .Components.Jobs }}
	queues *queues.Manager,
	{{- end }}
	hello *ExampleHelloJob,
	{{- if and .Components.DemoApp .Components.Jobs }}
	monitorCheck *monitoring.MonitorCheckJob,
	alertDispatch *alerts.DispatchJob,
	{{- end }}
) *Worker {
	return &Worker{
		logger:      logger,
		lighthouse:  lighthouse,
		appTimeouts: appTimeouts,
		{{- if .Components.Jobs }}
		queues: queues,
		{{- end }}
		hello:  hello,
		{{- if and .Components.DemoApp .Components.Jobs }}
		monitorCheck:  monitorCheck,
		alertDispatch: alertDispatch,
		{{- end }}
	}
}

// Start starts the queue worker.
func (s *Worker) Start() error {
	runCtx, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stop()
	return s.StartWithContext(runCtx)
}

// StartWithContext starts the queue worker and blocks until the context is canceled.
func (s *Worker) StartWithContext(runCtx context.Context) error {
	if runCtx == nil {
		runCtx = context.Background()
	}
	s.logger.Info().Msg("Starting queue worker")

	s.lighthouse.Start(runCtx)
	if err := startManagedQueueWorkers(runCtx, s.queues); err != nil {
		return err
	}

	s.logger.Info().
		Str("driver", string(s.queues.Default().Driver())).
		Str("configured_workers", env.Get("QUEUE_WORKERS", "30")).
		Msg("Queue worker started")
	<-runCtx.Done()
	s.logger.Info().Msg("Shutting down queue worker...")
	shutdownCtx, cancel := context.WithTimeout(context.Background(), s.appTimeouts.QueueShutdownTimeout())
	defer cancel()
	if err := shutdownManagedQueues(shutdownCtx, s.queues); err != nil {
		return err
	}
	s.logger.Info().Msg("Queue worker shut down")

	return nil
}

func startManagedQueueWorkers(ctx context.Context, manager *queues.Manager) error {
	instances := managedQueues(manager)
	for _, instance := range instances {
		if err := instance.StartWorkers(ctx); err != nil {
			return err
		}
	}
	return nil
}

func shutdownManagedQueues(ctx context.Context, manager *queues.Manager) error {
	instances := managedQueues(manager)
	for _, instance := range instances {
		if err := instance.Shutdown(ctx); err != nil {
			return err
		}
	}
	return nil
}

func managedQueues(manager *queues.Manager) []*queue.Queue {
	seen := map[*queue.Queue]struct{}{}
	out := make([]*queue.Queue, 0, 4)
	appendQueue := func(instance *queue.Queue) {
		if instance == nil {
			return
		}
		if _, ok := seen[instance]; ok {
			return
		}
		seen[instance] = struct{}{}
		out = append(out, instance)
	}
	if manager != nil {
		for _, instance := range manager.Instances() {
			appendQueue(instance.Queue)
		}
	}
	return out
}
