package jobs

import (
	"context"
	"os/signal"
	"syscall"
	{{- if and .Components.DemoApp .Components.Jobs }}
	"{{.GoModuleName}}/internal/alerts"
	"{{.GoModuleName}}/internal/monitoring"
	{{- end }}
	"{{.GoModuleName}}/internal/logger"
	"github.com/goforj/cache/cachecore"
	"github.com/goforj/queue"
)

// Worker is a struct that represents a queue worker.
type Worker struct {
	logger *logger.AppLogger
	queue  *queue.Queue
	cache  cachecore.Store
	hello  *ExampleHelloJob
	{{- if and .Components.DemoApp .Components.Jobs }}
	monitorCheck  *monitoring.MonitorCheckJob
	alertDispatch *alerts.DispatchJob
	{{- end }}
}

// NewWorker creates a new Worker with the given logger.
func NewWorker(
	logger *logger.AppLogger,
	appQueue *queue.Queue,
	cacheStore cachecore.Store,
	hello *ExampleHelloJob,
	{{- if and .Components.DemoApp .Components.Jobs }}
	monitorCheck *monitoring.MonitorCheckJob,
	alertDispatch *alerts.DispatchJob,
	{{- end }}
) *Worker {
	return &Worker{
		logger: logger,
		queue:  appQueue,
		cache:  cacheStore,
		hello:  hello,
		{{- if and .Components.DemoApp .Components.Jobs }}
		monitorCheck:  monitorCheck,
		alertDispatch: alertDispatch,
		{{- end }}
	}
}

// Start starts the queue worker.
func (s *Worker) Start() error {
	runCtx, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stop()
	return s.StartWithContext(runCtx)
}

// StartWithContext starts the queue worker and blocks until the context is canceled.
func (s *Worker) StartWithContext(runCtx context.Context) error {
	if runCtx == nil {
		runCtx = context.Background()
	}
	s.logger.Info().Msg("Starting queue worker")

	StartDevConsoleAgent(runCtx, s.logger, s.queue, s.cache)
	if s.queue == nil {
		s.logger.Warn().Msg("Queue worker not configured")
		return nil
	}

	if err := s.queue.StartWorkers(runCtx); err != nil {
		return err
	}

	s.logger.Info().Str("driver", string(s.queue.Driver())).Msg("Queue worker started")
	<-runCtx.Done()
	s.logger.Info().Msg("Shutting down queue worker...")
	if err := s.queue.Shutdown(context.Background()); err != nil {
		return err
	}
	s.logger.Info().Msg("Queue worker shut down")

	return nil
}
