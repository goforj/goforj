package jobs

import (
	"context"
	{{- if .Components.DemoApp }}
	"encoding/json"
	{{- end }}
	"fmt"
	"github.com/goforj/env/v2"
	"github.com/hibiken/asynq"
	"{{.GoModuleName}}/internal/logger"
)

// Worker is a struct that represents a queue worker.
type Worker struct {
	logger *logger.AppLogger
	hello  *ExampleHelloJob
	{{- if .Components.DemoApp }}
	monitorCheck *MonitorCheckJob
	{{- end }}
}

// NewWorker creates a new Worker with the given logger.
func NewWorker(
	logger *logger.AppLogger,
	hello *ExampleHelloJob,
	{{- if .Components.DemoApp }}
	monitorCheck *MonitorCheckJob,
	{{- end }}
) *Worker {
	return &Worker{
		logger: logger,
		hello:  hello,
		{{- if .Components.DemoApp }}
		monitorCheck: monitorCheck,
		{{- end }}
	}
}

// Start starts the queue worker.
func (s *Worker) Start() error {
	s.logger.Info().Msg("Starting queue worker")

	StartDevConsoleAgent(context.Background(), s.logger)

	redisAddr := fmt.Sprintf(
		"%s:%s",
		env.Get("REDIS_HOST", "redis"),
		env.Get("REDIS_PORT", "6379"),
	)

	srv := asynq.NewServer(
		asynq.RedisClientOpt{Addr: redisAddr},
		asynq.Config{
			// Specify how many concurrent workers to use
			Concurrency: 30,
			// Optionally specify multiple queues with different priority.
			Queues: map[string]int{
				"critical": 6,
				"default":  3,
				"low":      1,
			},
			ErrorHandler: asynq.ErrorHandlerFunc(s.handleTaskError),
			Logger: AsynqLoggerAdapter{appLogger: s.logger},
		},
	)

	// mux maps a type to a handler
	mux := asynq.NewServeMux()
	mux.HandleFunc(ExampleHelloJobTypeName, s.hello.Handle)
	{{- if .Components.DemoApp }}
	mux.HandleFunc(MonitorCheckJobTypeName, s.monitorCheck.Handle)
	{{- end }}
	// ...register other handlers...

	if err := srv.Run(mux); err != nil {
		return err
	}

	return nil
}

func (s *Worker) handleTaskError(ctx context.Context, task *asynq.Task, err error) {
	retryCount, _ := asynq.GetRetryCount(ctx)
	maxRetry, _ := asynq.GetMaxRetry(ctx)
	queue, _ := asynq.GetQueueName(ctx)

	logEvent := s.logger.Warn().
		Str("task_type", task.Type()).
		Int("retry_count", retryCount).
		Int("max_retry", maxRetry).
		Str("queue", queue).
		Err(err)

	{{- if .Components.DemoApp }}
	if task.Type() == MonitorCheckJobTypeName {
		var payload MonitorCheckPayload
		if unmarshalErr := json.Unmarshal(task.Payload(), &payload); unmarshalErr == nil && payload.MonitorID != "" {
			logEvent = logEvent.Str("monitor_id", payload.MonitorID)
			if s.monitorCheck != nil && s.monitorCheck.monitorRepo != nil {
				if monitor, lookupErr := s.monitorCheck.monitorRepo.ByID(payload.MonitorID); lookupErr == nil && monitor != nil {
					logEvent = logEvent.
						Str("monitor_name", monitor.Name).
						Str("monitor_type", monitor.MonitorType).
						Str("target", monitor.Target)
				}
			}
		}
	}
	{{- end }}

	if retryCount >= maxRetry {
		logEvent.Msg("Retry exhausted with task context")
		return
	}
	logEvent.Msg("Task retry scheduled")
}
