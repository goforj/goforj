package jobs

import (
	"context"
)

// WorkerCmd is a struct that represents a command to start the queue workers.
type WorkerCmd struct {
	runtime *Runtime
{{- if .Components.Metrics }}
	MetricsPort    string `help:"Port for the dedicated jobs metrics endpoint" env:"METRICS_JOBS_PORT" default:"9101" optional:""`
{{- end }}
}

// NewWorkerCmd creates a new WorkerCmd with the given logger and queue worker.
func NewWorkerCmd(
	runtime *Runtime,
) *WorkerCmd {
	return &WorkerCmd{
		runtime: runtime,
	}
}

// Run executes the command to start the queue worker.
func (c *WorkerCmd) Run(ctx context.Context) error {
	return c.runtime.RunWithConfig(ctx, RuntimeConfig{
{{- if .Components.Metrics }}
		MetricsPort: c.MetricsPort,
{{- end }}
	})
}
