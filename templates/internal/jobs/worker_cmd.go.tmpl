package jobs

import (
	"context"
	"os/signal"
	"syscall"

	"{{.GoModuleName}}/internal/logger"
{{- if .Components.Metrics }}
	appmetrics "{{.GoModuleName}}/internal/metrics"
{{- end }}
)

// WorkerCmd is a struct that represents a command to start the queue workers.
type WorkerCmd struct {
	logger *logger.AppLogger
	worker *Worker
{{- if .Components.Metrics }}
	metricsManager *appmetrics.Manager
	MetricsPort    string `help:"Port for the dedicated jobs metrics endpoint" env:"METRICS_JOBS_PORT" default:"9101" optional:""`
{{- end }}
}

// NewWorkerCmd creates a new WorkerCmd with the given logger and queue worker.
func NewWorkerCmd(
	logger *logger.AppLogger,
	worker *Worker,
{{- if .Components.Metrics }}
	metricsManager *appmetrics.Manager,
{{- end }}
) *WorkerCmd {
	return &WorkerCmd{
		logger: logger,
		worker: worker,
{{- if .Components.Metrics }}
		metricsManager: metricsManager,
{{- end }}
	}
}

// Run executes the command to start the queue worker.
func (c *WorkerCmd) Run() error {
	runCtx, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stop()
	return c.RunWithContext(runCtx)
}

// RunWithContext executes the worker command with a caller-provided lifecycle context.
func (c *WorkerCmd) RunWithContext(runCtx context.Context) error {
{{- if .Components.Metrics }}
	if c.metricsManager != nil && c.metricsManager.Registry() != nil {
		if err := appmetrics.StartPrometheusEndpoint(runCtx, c.logger, "jobs", c.MetricsPort, c.metricsManager.Registry()); err != nil {
			return err
		}
	}
{{- end }}
	err := c.worker.StartWithContext(runCtx)
	if err != nil {
		return err
	}

	return nil
}
