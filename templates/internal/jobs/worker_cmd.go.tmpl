package jobs

import (
	"context"
)

// WorkerCmd is a struct that represents a command to start the queue workers.
type WorkerCmd struct {
	runtime *Runtime
	Queues  []string `name:"queue" short:"q" help:"Queue name to work; repeat to work multiple queues" optional:""`
{{- if .Components.Metrics }}
	MetricsPort    string `help:"Port for the dedicated jobs metrics endpoint" optional:""`
{{- end }}
}

// NewWorkerCmd creates a new WorkerCmd with the given logger and queue worker.
func NewWorkerCmd(
	runtime *Runtime,
) *WorkerCmd {
	return &WorkerCmd{
		runtime: runtime,
	}
}

// Signature defines CLI metadata for this command.
func (*WorkerCmd) Signature() string {
	return `name:"queue:work" aliases:"worker" help:"Runs queue workers indefinitely"`
}

// Run executes the command to start the queue worker.
func (c *WorkerCmd) Run(ctx context.Context) error {
	return c.runtime.RunWithConfig(ctx, RuntimeConfig{
		Queues: c.Queues,
{{- if .Components.Metrics }}
		MetricsPort: c.MetricsPort,
{{- end }}
	})
}
