package jobs

import (
	"fmt"
	"{{.GoModuleName}}/internal/logger"
)

// QueueLoggerAdapter adapts queue runtime logs into the app logger.
type QueueLoggerAdapter struct {
	appLogger *logger.AppLogger
}

// NewQueueLoggerAdapter builds a queue logger adapter for the app logger.
func NewQueueLoggerAdapter(appLogger *logger.AppLogger) QueueLoggerAdapter {
	if appLogger != nil {
		appLogger = appLogger.WithComponent("Jobs")
	}
	return QueueLoggerAdapter{appLogger: appLogger}
}

// Debug is a method that logs a debug message.
func (l QueueLoggerAdapter) Debug(args ...interface{}) {
	if ev := l.appLogger.Debug(); ev != nil {
		ev.Msg(fmt.Sprint(args...))
	}
}

// Info is a method that logs an info message.
func (l QueueLoggerAdapter) Info(args ...interface{}) {
	l.appLogger.Info().Msg(fmt.Sprint(args...))
}

// Warn is a method that logs a warning message.
func (l QueueLoggerAdapter) Warn(args ...interface{}) {
	l.appLogger.Warn().Msg(fmt.Sprint(args...))
}

// Error is a method that logs an error message.
func (l QueueLoggerAdapter) Error(args ...interface{}) {
	l.appLogger.Error().Msg(fmt.Sprint(args...))
}

// Fatal is a method that logs an error message.
func (l QueueLoggerAdapter) Fatal(args ...interface{}) {
	l.appLogger.Fatal().Msg(fmt.Sprint(args...))
}
