package lighthouse

import (
	"context"
	"fmt"
	"github.com/google/uuid"
	"github.com/gorilla/websocket"
	"net/http"
	neturl "net/url"
	"os"
	"strings"
	"sync"
	"sync/atomic"
	"time"

	"encoding/json"
	"errors"
)

// CommandHandler handles a control-plane command.
type CommandHandler func(Command) (any, error)

// AgentConfig controls how the agent connects and identifies itself.
type AgentConfig struct {
	URL          string
	Secret       string
	Source       string
	App          string
	AppTarget    string
	Version      string
	Env          string
	Capabilities []string
	InstanceID   string
	InstanceKind string
	Host         string
}

// Agent represents a control-plane client embedded in a binary.
type Agent struct {
	config        AgentConfig
	commands      map[string]CommandHandler
	connMu        sync.RWMutex
	conn          *wsConn
	startedAt     time.Time
	inspectActive atomic.Bool
}

var errAgentNotConnected = errors.New("lighthouse agent not connected")

// NewAgent creates a new agent instance.
func NewAgent(config AgentConfig) *Agent {
	return &Agent{
		config:    config,
		commands:  map[string]CommandHandler{},
		startedAt: time.Now(),
	}
}

// RegisterCommand registers a command handler.
func (a *Agent) RegisterCommand(name string, handler CommandHandler) {
	a.commands[name] = handler
}

// RegisterCapability adds a capability to the agent config.
func (a *Agent) RegisterCapability(name string) {
	a.config.Capabilities = append(a.config.Capabilities, name)
}

// Start connects the agent to the control plane and begins handling messages.
func (a *Agent) Start(ctx context.Context) error {
	if a.config.URL == "" {
		return nil
	}
	if strings.TrimSpace(a.config.Secret) == "" {
		fmt.Printf("lighthouse agent disabled: missing LIGHTHOUSE_SECRET · source=%s\n", a.config.Source)
		return nil
	}
	header := http.Header{}
	if a.config.Secret != "" {
		header.Set("Authorization", "Bearer "+a.config.Secret)
	}
	if source := strings.TrimSpace(a.config.Source); source != "" {
		header.Set("X-Forj-Agent-Source", source)
	}
	if host := strings.TrimSpace(a.config.Host); host != "" {
		header.Set("X-Forj-Agent-Host", host)
	}
	if target := strings.TrimSpace(a.config.AppTarget); target != "" {
		header.Set("X-Forj-App-Target", target)
	}
	header.Set("X-Forj-Agent-Pid", fmt.Sprintf("%d", os.Getpid()))
	authWarned := false
	lastDialWarnAt := time.Time{}
	dialFailureStreak := 0

	for {
		select {
		case <-ctx.Done():
			return nil
		default:
		}

		conn, resp, err := websocket.DefaultDialer.Dial(a.config.URL, header)
		if err != nil {
			dialFailureStreak++
			wait := 2 * time.Second
			if resp != nil && resp.StatusCode == http.StatusUnauthorized {
				wait = 15 * time.Second
				if !authWarned {
					fmt.Printf(
						"lighthouse agent auth rejected (401): source=%s url=%s; verify LIGHTHOUSE_SECRET matches server\n",
						a.config.Source,
						a.config.URL,
					)
					authWarned = true
				}
			}
			status := 0
			if resp != nil {
				status = resp.StatusCode
			}
			if status == 0 && dialFailureStreak == 1 && isBootConnectionRefused(err) {
				select {
				case <-ctx.Done():
					return nil
				case <-time.After(wait):
					continue
				}
			}
			if time.Since(lastDialWarnAt) > 15*time.Second {
				lastDialWarnAt = time.Now()
				switch status {
				case http.StatusOK:
					fmt.Printf(
						"lighthouse agent dial failed: source=%s status=200 url=%s; websocket endpoint likely misconfigured (expected /lighthouse/ws/agent)\n",
						a.config.Source,
						a.config.URL,
					)
				case http.StatusNotFound:
					fmt.Printf(
						"lighthouse agent dial failed: source=%s status=404 url=%s; websocket route not found (check LIGHTHOUSE_URL and LIGHTHOUSE_ENABLED)\n",
						a.config.Source,
						a.config.URL,
					)
				case http.StatusUnauthorized:
					// handled above with dedicated auth guidance
				default:
					if status > 0 {
						fmt.Printf(
							"lighthouse agent dial failed: source=%s status=%d url=%s streak=%d\n",
							a.config.Source,
							status,
							a.config.URL,
							dialFailureStreak,
						)
					} else {
						fmt.Printf(
							"lighthouse agent dial failed: source=%s url=%s error=%v streak=%d\n",
							a.config.Source,
							a.config.URL,
							err,
							dialFailureStreak,
						)
					}
				}
			}
			select {
			case <-ctx.Done():
				return nil
			case <-time.After(wait):
				continue
			}
		}
		authWarned = false
		dialFailureStreak = 0

		if err := a.runSession(ctx, conn); err != nil {
			select {
			case <-ctx.Done():
				return nil
			case <-time.After(2 * time.Second):
				continue
			}
		}
	}
}

// runSession manages a single websocket connection lifecycle.
func (a *Agent) runSession(ctx context.Context, conn *websocket.Conn) error {
	ws := newNativeWSConnWithSecret(conn, a.config.Secret)
	a.setConn(ws)
	defer func() {
		a.clearConn()
		conn.Close()
	}()

	if err := a.register(); err != nil {
		return err
	}

	go a.heartbeat(ctx)

	for {
		select {
		case <-ctx.Done():
			return nil
		default:
		}

		var msg Message
		if err := ws.readJSON(&msg); err != nil {
			return err
		}
		switch msg.Type {
		case "command":
			if err := a.handleCommand(msg); err != nil {
				return err
			}
		case "inspect-control":
			if err := a.handleInspectControl(msg); err != nil {
				return err
			}
		}
	}
}

// register sends the agent metadata to the control plane.
func (a *Agent) register() error {
	info := normalizeAgentInfo(AgentInfo{
		ID:           uuid.NewString(),
		Source:       a.config.Source,
		App:          a.config.App,
		AppTarget:    a.config.AppTarget,
		Version:      a.config.Version,
		Env:          a.config.Env,
		Capabilities: a.config.Capabilities,
		InstanceID:   a.config.InstanceID,
		InstanceKind: a.config.InstanceKind,
		Host:         a.config.Host,
		StartedAt:    a.startedAt,
	})
	payload, err := json.Marshal(info)
	if err != nil {
		return err
	}
	return a.write(Message{
		Type:    "register",
		ID:      uuid.NewString(),
		Source:  a.config.Source,
		Payload: payload,
	})
}

// heartbeat periodically emits heartbeat events while connected.
func (a *Agent) heartbeat(ctx context.Context) {
	ticker := time.NewTicker(5 * time.Second)
	defer ticker.Stop()
	for {
		select {
		case <-ctx.Done():
			return
		case <-ticker.C:
			payload, _ := json.Marshal(map[string]any{
				"uptime":     time.Now().Unix(),
				"started_at": a.startedAt,
			})
			_ = a.write(Message{
				Type:    "heartbeat",
				ID:      uuid.NewString(),
				Source:  a.config.Source,
				Payload: payload,
			})
		}
	}
}

// handleCommand dispatches incoming command messages to registered handlers.
func (a *Agent) handleCommand(msg Message) error {
	var cmd Command
	if err := json.Unmarshal(msg.Payload, &cmd); err != nil {
		return a.writeError(nil, msg, err)
	}
	handler := a.commands[cmd.Name]
	if handler == nil {
		return a.writeError(nil, msg, fmt.Errorf("unknown command: %s", cmd.Name))
	}
	data, err := handler(cmd)
	if err != nil {
		return a.writeError(nil, msg, err)
	}
	return a.writeResponse(nil, msg, data)
}

// writeResponse sends a command response back to the requester.
func (a *Agent) writeResponse(_ *websocket.Conn, msg Message, data any) error {
	raw, err := json.Marshal(data)
	if err != nil {
		return err
	}
	payload, err := json.Marshal(Response{Ok: true, Data: raw})
	if err != nil {
		return err
	}
	return a.write(Message{
		Type:    "response",
		ID:      uuid.NewString(),
		ReplyTo: msg.ID,
		Source:  a.config.Source,
		Payload: payload,
	})
}

// writeError reports a command failure back to the console.
func (a *Agent) writeError(_ *websocket.Conn, msg Message, err error) error {
	payload, marshalErr := json.Marshal(Response{Ok: false, Error: err.Error()})
	if marshalErr != nil {
		return marshalErr
	}
	return a.write(Message{
		Type:    "response",
		ID:      uuid.NewString(),
		ReplyTo: msg.ID,
		Source:  a.config.Source,
		Payload: payload,
	})
}

// setConn stores the active websocket connection.
func (a *Agent) setConn(conn *wsConn) {
	a.connMu.Lock()
	defer a.connMu.Unlock()
	a.conn = conn
}

// clearConn drops the cached websocket connection.
func (a *Agent) clearConn() {
	a.connMu.Lock()
	defer a.connMu.Unlock()
	a.conn = nil
}

// write serializes a Message to the current websocket connection.
func (a *Agent) write(msg Message) error {
	a.connMu.RLock()
	conn := a.conn
	a.connMu.RUnlock()
	if conn == nil {
		return nil
	}
	return conn.writeJSON(msg)
}

func (a *Agent) writeIfConnected(msg Message) error {
	a.connMu.RLock()
	conn := a.conn
	a.connMu.RUnlock()
	if conn == nil {
		return errAgentNotConnected
	}
	return conn.writeJSON(msg)
}

func (a *Agent) handleInspectControl(msg Message) error {
	var control InspectControl
	if err := json.Unmarshal(msg.Payload, &control); err != nil {
		return err
	}
	a.inspectActive.Store(control.Active)
	return nil
}

func (a *Agent) InspectActive() bool {
	return a != nil && a.inspectActive.Load()
}

// EmitLog sends a log entry event to the control plane.
func (a *Agent) EmitLog(entry LogEntry) {
	payload, err := json.Marshal(map[string]any{
		"log": entry,
	})
	if err != nil {
		return
	}
	_ = a.write(Message{
		Type:    "event",
		ID:      uuid.NewString(),
		Source:  a.config.Source,
		Payload: payload,
	})
}

// LoadAgentConfig builds an agent config from environment variables.
func LoadAgentConfig(source string) AgentConfig {
	host, _ := os.Hostname()
	rawURL := strings.TrimSpace(os.Getenv("LIGHTHOUSE_URL"))
	if rawURL == "" {
		rawURL = "ws://localhost:3000/lighthouse/ws/agent"
	}
	url, warnings := normalizeAgentWSURL(rawURL)
	for _, warning := range warnings {
		fmt.Printf("lighthouse agent config warning: %s\n", warning)
	}
	return AgentConfig{
		URL:          url,
		Secret:       SharedSecretFromEnv(),
		Source:       source,
		App:          os.Getenv("APP_NAME"),
		AppTarget:    appTargetFromEnv(),
		Version:      os.Getenv("APP_VERSION"),
		Env:          os.Getenv("APP_ENV"),
		InstanceID:   os.Getenv("APP_INSTANCE_ID"),
		InstanceKind: os.Getenv("APP_INSTANCE_KIND"),
		Host:         host,
	}
}

// appTargetFromEnv identifies the generated app target for Lighthouse agent registration.
func appTargetFromEnv() string {
	if target := strings.TrimSpace(os.Getenv("APP_TARGET")); target != "" {
		return target
	}
	if target := strings.TrimSpace(os.Getenv("FORJ_APP_TARGET")); target != "" {
		return target
	}
	return "app"
}

func SharedSecretFromEnv() string {
	return strings.TrimSpace(os.Getenv("LIGHTHOUSE_SECRET"))
}

func normalizeAgentWSURL(raw string) (string, []string) {
	warnings := []string{}
	parsed, err := neturl.Parse(raw)
	if err != nil {
		return raw, warnings
	}
	switch parsed.Path {
	case "/lighthouse/ws/devwatch":
		warnings = append(warnings,
			"LIGHTHOUSE_URL points to '/ws/devwatch'; agent requires '/ws/agent'. Update LIGHTHOUSE_URL.",
		)
	case "/lighthouse/ws/agent":
		// Correct path.
	default:
		if strings.Contains(parsed.Path, "/ws/") {
			warnings = append(warnings,
				fmt.Sprintf("LIGHTHOUSE_URL has unexpected websocket path '%s'; expected '/lighthouse/ws/agent'.", parsed.Path),
			)
		}
	}
	return raw, warnings
}

func isBootConnectionRefused(err error) bool {
	if err == nil {
		return false
	}
	return strings.Contains(strings.ToLower(err.Error()), "connection refused")
}
