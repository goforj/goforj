package lighthouse

import (
	"context"
	"log"
	"strconv"
	"strings"
	"sync/atomic"
	"time"

	"{{.GoModuleName}}/internal/inspects"
{{- if .ProjectComponents.Metrics }}
	"{{.GoModuleName}}/internal/metrics"
{{- end }}
	"github.com/goforj/env/v2"
	"github.com/google/uuid"
)

const (
	defaultInspectBufferSize     = 4096
	defaultInspectFlushBatchSize = 100
	defaultInspectFlushInterval  = time.Second
)

// InspectPublisher buffers finished inspects and flushes them to Lighthouse in batches.
type InspectPublisher struct {
	agent          *Agent
{{- if .ProjectComponents.Metrics }}
	metrics        *metrics.Manager
{{- end }}
	buffer         chan *inspects.Record
	flushInterval  time.Duration
	flushBatchSize int
	dropped        atomic.Uint64
	lastDropLogAt  atomic.Int64
}

// NewInspectPublisher creates a new Lighthouse inspect publisher.
func NewInspectPublisher(agent *Agent{{- if .ProjectComponents.Metrics }}, metricsManager *metrics.Manager{{- end }}) *InspectPublisher {
	bufferSize := env.GetInt("LIGHTHOUSE_INSPECT_BUFFER_SIZE", strconv.Itoa(defaultInspectBufferSize))
	if bufferSize <= 0 {
		bufferSize = defaultInspectBufferSize
	}
	batchSize := env.GetInt("LIGHTHOUSE_INSPECT_FLUSH_BATCH_SIZE", strconv.Itoa(defaultInspectFlushBatchSize))
	if batchSize <= 0 {
		batchSize = defaultInspectFlushBatchSize
	}
	flushInterval := defaultInspectFlushInterval
	if raw := strings.TrimSpace(env.Get("LIGHTHOUSE_INSPECT_FLUSH_INTERVAL", "")); raw != "" {
		if parsed, err := time.ParseDuration(raw); err == nil && parsed > 0 {
			flushInterval = parsed
		}
	}
	return &InspectPublisher{
		agent:          agent,
{{- if .ProjectComponents.Metrics }}
		metrics:        metricsManager,
{{- end }}
		buffer:         make(chan *inspects.Record, bufferSize),
		flushInterval:  flushInterval,
		flushBatchSize: batchSize,
	}
}

// Publish enqueues a finished inspect for async Lighthouse delivery.
func (p *InspectPublisher) Publish(record inspects.Record) {
	if p == nil || p.agent == nil {
		return
	}
	if !p.agent.InspectActive() {
		return
	}
	copyRecord := inspects.CloneRecord(record)
	select {
	case p.buffer <- &copyRecord:
		p.recordDepth()
	default:
		p.dropped.Add(1)
		p.recordDrop("buffer_full", 1)
		p.logDrop("buffer_full")
	}
}

// Start begins the background flusher.
func (p *InspectPublisher) Start(ctx context.Context) {
	if p == nil || p.agent == nil {
		return
	}
	ticker := time.NewTicker(p.flushInterval)
	defer ticker.Stop()

	batch := make([]*inspects.Record, 0, p.flushBatchSize)
	flush := func() bool {
		if len(batch) == 0 {
			return true
		}
		if !p.flush(batch) {
			return false
		}
		batch = batch[:0]
		return true
	}

	for {
		select {
		case <-ctx.Done():
			_ = flush()
			return
		case record := <-p.buffer:
			if record != nil {
				batch = append(batch, record)
			}
			batch = p.drainBufferedRecords(batch)
			if len(batch) >= p.flushBatchSize && !flush() {
				continue
			}
		case <-ticker.C:
			if !flush() {
				continue
			}
		}
	}
}

// drainBufferedRecords fills the current batch without blocking the publisher loop.
func (p *InspectPublisher) drainBufferedRecords(batch []*inspects.Record) []*inspects.Record {
	for len(batch) < p.flushBatchSize {
		select {
		case record := <-p.buffer:
			if record != nil {
				batch = append(batch, record)
			}
		default:
			return batch
		}
	}
	return batch
}

func (p *InspectPublisher) flush(batch []*inspects.Record) bool {
	if len(batch) == 0 || p.agent == nil {
		return true
	}
	if !p.agent.InspectActive() {
		return true
	}
	startedAt := time.Now()
	records := make([]inspects.Record, 0, len(batch))
	for _, record := range batch {
		if record != nil {
			records = append(records, p.identityRecord(*record))
		}
	}
	if len(records) == 0 {
		return true
	}
	raw, err := encodeInspectBatchPayload(InspectBatchEnvelope{
		Version: inspectBatchEnvelopeVersion,
		Records: records,
	})
	if err != nil {
		p.dropped.Add(uint64(len(records)))
		p.recordDrop("marshal", len(records))
		p.logDrop("marshal")
		p.recordFlush(len(records), time.Since(startedAt), err)
		return true
	}

	if err := p.agent.writeIfConnected(Message{
		Type:    "inspect-batch",
		ID:      uuid.NewString(),
		Source:  p.agent.config.Source,
		Payload: raw,
	}); err != nil {
		p.recordFlush(len(records), time.Since(startedAt), err)
		return false
	}
	p.recordDepth()
	p.recordFlush(len(records), time.Since(startedAt), nil)
	return true
}

func (p *InspectPublisher) identityRecord(record inspects.Record) inspects.Record {
	record = inspects.CloneRecord(record)
	agentInfo := normalizeAgentInfo(AgentInfo{
		Source:     p.agent.config.Source,
		App:        p.agent.config.App,
		InstanceID: p.agent.config.InstanceID,
		Host:       p.agent.config.Host,
	})
	if strings.TrimSpace(record.Summary.App) == "" {
		record.Summary.App = agentInfo.App
	}
	if strings.TrimSpace(record.Summary.AgentKey) == "" {
		record.Summary.AgentKey = agentInfo.Key
	}
	if strings.TrimSpace(record.Summary.GroupKey) == "" {
		record.Summary.GroupKey = agentInfo.GroupKey
	}
	if strings.TrimSpace(record.Summary.InstanceKey) == "" {
		record.Summary.InstanceKey = agentInfo.InstanceKey
	}
	return record
}

func (p *InspectPublisher) logDrop(reason string) {
	now := time.Now().Unix()
	last := p.lastDropLogAt.Load()
	if last != 0 && now-last < 30 {
		return
	}
	if !p.lastDropLogAt.CompareAndSwap(last, now) {
		return
	}
	log.Printf("lighthouse inspect drop; reason=%s dropped_total=%d", reason, p.dropped.Load())
}

// recordDepth reports publisher pressure only when this App participates in project Metrics.
func (p *InspectPublisher) recordDepth() {
{{- if .ProjectComponents.Metrics }}
	if p == nil || p.metrics == nil {
		return
	}
	p.metrics.RecordLighthouseInspectBufferDepth(p.agent.config.Source, len(p.buffer))
{{- end }}
}

// recordDrop reports discarded inspects only when this App participates in project Metrics.
func (p *InspectPublisher) recordDrop(reason string, count int) {
{{- if .ProjectComponents.Metrics }}
	if p == nil || p.metrics == nil {
		return
	}
	p.metrics.RecordLighthouseInspectDropped(p.agent.config.Source, reason, count)
{{- end }}
}

// recordFlush reports Lighthouse delivery outcomes only when this App participates in project Metrics.
func (p *InspectPublisher) recordFlush(batchSize int, duration time.Duration, err error) {
{{- if .ProjectComponents.Metrics }}
	if p == nil || p.metrics == nil {
		return
	}
	p.metrics.RecordLighthouseInspectFlush(p.agent.config.Source, batchSize, duration, err)
{{- end }}
}
