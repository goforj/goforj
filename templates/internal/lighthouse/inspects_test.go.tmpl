type captureWSConnection struct {
	writes []any
}

func (c *captureWSConnection) ReadJSON(target any) error {
	return io.EOF
}

func (c *captureWSConnection) WriteJSON(payload any) error {
	c.writes = append(c.writes, payload)
	return nil
}

func (c *captureWSConnection) Close() error {
	return nil
}

func TestInspectPublisherFlushesBatch(t *testing.T) {
	agent := NewAgent(AgentConfig{Source: "http", Secret: "test-secret"})
	agent.inspectActive.Store(true)
	conn := &captureWSConnection{}
	agent.setConn(&wsConn{conn: conn, secret: agent.config.Secret})

	publisher := NewInspectPublisher(agent{{- if .Components.Metrics }}, nil{{- end }})
	record := inspects.Record{
		Summary: inspects.InspectSummary{
			TraceID:   "inspect-1",
			Source:    "http",
			Name:      "request",
			Status:    "ok",
			StartedAt: time.Now(),
			UpdatedAt: time.Now(),
			EndedAt:   time.Now(),
		},
		Events: []inspects.InspectEvent{
			{Kind: inspects.EventKindLog, Message: "hello"},
		},
	}

	if ok := publisher.flush([]*inspects.Record{&record}); !ok {
		t.Fatal("expected flush to succeed")
	}

	if len(conn.writes) != 1 {
		t.Fatalf("expected 1 websocket write, got %d", len(conn.writes))
	}
	wire, ok := conn.writes[0].(EncryptedMessage)
	if !ok {
		t.Fatalf("expected EncryptedMessage payload, got %T", conn.writes[0])
	}
	decrypted, err := decryptWithSecret(agent.config.Secret, wire.Nonce, wire.Data)
	if err != nil {
		t.Fatalf("decrypt message: %v", err)
	}
	var msg Message
	if err := json.Unmarshal(decrypted, &msg); err != nil {
		t.Fatalf("unmarshal message: %v", err)
	}
	if msg.Type != "inspect-batch" {
		t.Fatalf("expected inspect-batch message, got %q", msg.Type)
	}
	envelope, err := decodeInspectBatchPayload(msg.Payload)
	if err != nil {
		t.Fatalf("decode envelope: %v", err)
	}
	if envelope.Version != inspectBatchEnvelopeVersion {
		t.Fatalf("expected inspect batch version %d, got %d", inspectBatchEnvelopeVersion, envelope.Version)
	}
	if len(envelope.Records) != 1 {
		t.Fatalf("expected 1 record, got %d", len(envelope.Records))
	}
	if envelope.Records[0].Summary.TraceID != record.Summary.TraceID {
		t.Fatalf("expected trace id %q, got %q", record.Summary.TraceID, envelope.Records[0].Summary.TraceID)
	}
}

func TestIngestInspectBatchPersistsRecords(t *testing.T) {
	t.Setenv("LIGHTHOUSE_ENABLED", "true")
	t.Setenv("LIGHTHOUSE_INSPECT_ENABLED", "true")

	store := goforjcache.NewCacheWithTTL(goforjcache.NewMemoryStore(context.Background()), time.Minute)
	manager := inspects.NewManager(store)
	record := inspects.Record{
		Summary: inspects.InspectSummary{
			TraceID:   "inspect-2",
			Source:    "jobs",
			Name:      "job-run",
			Status:    "ok",
			StartedAt: time.Now(),
			UpdatedAt: time.Now(),
			EndedAt:   time.Now(),
		},
		Events: []inspects.InspectEvent{
			{Kind: inspects.EventKindLog, Message: "ingested"},
		},
	}

	if err := ingestInspectBatch(manager, mustJSON(t, InspectBatchEnvelope{
		Version: inspectBatchEnvelopeVersion,
		Records: []inspects.Record{record},
	})); err != nil {
		t.Fatalf("ingest inspect batch: %v", err)
	}

	stored, ok, err := manager.ByID(context.Background(), record.Summary.TraceID)
	if err != nil {
		t.Fatalf("manager.ByID: %v", err)
	}
	if !ok {
		t.Fatal("expected ingested record to be persisted")
	}
	if stored.Summary.TraceID != record.Summary.TraceID {
		t.Fatalf("expected trace id %q, got %q", record.Summary.TraceID, stored.Summary.TraceID)
	}
	if len(stored.Events) != 1 || stored.Events[0].Message != "ingested" {
		t.Fatalf("expected ingested events to persist, got %+v", stored.Events)
	}
}

func TestIngestInspectBatchRejectsUnsupportedVersion(t *testing.T) {
	t.Setenv("LIGHTHOUSE_ENABLED", "true")
	t.Setenv("LIGHTHOUSE_INSPECT_ENABLED", "true")

	store := goforjcache.NewCacheWithTTL(goforjcache.NewMemoryStore(context.Background()), time.Minute)
	manager := inspects.NewManager(store)
	err := ingestInspectBatch(manager, mustJSON(t, InspectBatchEnvelope{
		Version: inspectBatchEnvelopeVersion + 1,
		Records: []inspects.Record{
			{
				Summary: inspects.InspectSummary{
					TraceID:   "inspect-bad-version",
					Source:    "http",
					Name:      "request",
					Status:    "ok",
					StartedAt: time.Now(),
					UpdatedAt: time.Now(),
					EndedAt:   time.Now(),
				},
			},
		},
	}))
	if err == nil {
		t.Fatal("expected unsupported version error")
	}
}

func TestInspectShipIngestAndAPIFlow(t *testing.T) {
	t.Setenv("LIGHTHOUSE_ENABLED", "true")
	t.Setenv("LIGHTHOUSE_INSPECT_ENABLED", "true")

	secret := "test-secret"
	store := goforjcache.NewCacheWithTTL(goforjcache.NewMemoryStore(context.Background()), time.Minute)
	manager := inspects.NewManager(store)
	hub := NewHub()
	server, err := echoweb.NewServer(echoweb.ServerConfig{
		Mounts: []web.RouterMount{
			func(router web.Router) error {
				Attach(router, hub, ServerConfig{
					Secret:   secret,
					Inspects: manager,
				})
				return nil
			},
		},
	})
	if err != nil {
		t.Fatalf("create lighthouse test server: %v", err)
	}

	agent := NewAgent(AgentConfig{Source: "http", Secret: secret})
	agent.inspectActive.Store(true)
	conn := &captureWSConnection{}
	agent.setConn(&wsConn{conn: conn, secret: agent.config.Secret})
	publisher := NewInspectPublisher(agent{{- if .Components.Metrics }}, nil{{- end }})

	record := inspects.Record{
		Summary: inspects.InspectSummary{
			TraceID:    "inspect-e2e",
			Source:     "http",
			Name:       "/api/v1/monitoring/summary",
			Status:     "ok",
			StartedAt:  time.Now().Add(-25 * time.Millisecond),
			UpdatedAt:  time.Now().Add(-5 * time.Millisecond),
			EndedAt:    time.Now(),
			DurationMS: 20,
			EventCount: 2,
			Labels: map[string]string{
				"path":   "/api/v1/monitoring/summary",
				"method": http.MethodGet,
			},
		},
		Events: []inspects.InspectEvent{
			{Kind: inspects.EventKindQuery, Name: "query_summary", At: time.Now().Add(-20 * time.Millisecond), Seq: 1},
			{Kind: inspects.EventKindLog, Message: "HTTP Request", At: time.Now().Add(-5 * time.Millisecond), Seq: 2},
		},
	}

	if ok := publisher.flush([]*inspects.Record{&record}); !ok {
		t.Fatal("expected flush to succeed")
	}
	if len(conn.writes) != 1 {
		t.Fatalf("expected 1 websocket write, got %d", len(conn.writes))
	}
	wire, ok := conn.writes[0].(EncryptedMessage)
	if !ok {
		t.Fatalf("expected EncryptedMessage payload, got %T", conn.writes[0])
	}
	decrypted, err := decryptWithSecret(agent.config.Secret, wire.Nonce, wire.Data)
	if err != nil {
		t.Fatalf("decrypt message: %v", err)
	}
	var msg Message
	if err := json.Unmarshal(decrypted, &msg); err != nil {
		t.Fatalf("unmarshal message: %v", err)
	}
	if err := ingestInspectBatch(manager, msg.Payload); err != nil {
		t.Fatalf("ingest inspect batch: %v", err)
	}

	listReq := httptest.NewRequest(http.MethodGet, "/lighthouse/api/inspect?limit=10", nil)
	listReq.AddCookie(&http.Cookie{Name: lighthouseAuthCookie, Value: secret})
	listRec := httptest.NewRecorder()
	server.ServeHTTP(listRec, listReq)
	if listRec.Code != http.StatusOK {
		t.Fatalf("list status: got %d body=%s", listRec.Code, listRec.Body.String())
	}
	var listPayload struct {
		Inspects []inspects.InspectSummary `json:"inspects"`
	}
	if err := json.Unmarshal(listRec.Body.Bytes(), &listPayload); err != nil {
		t.Fatalf("decode list payload: %v", err)
	}
	if len(listPayload.Inspects) != 1 {
		t.Fatalf("expected 1 inspect in list, got %d", len(listPayload.Inspects))
	}
	if listPayload.Inspects[0].TraceID != record.Summary.TraceID {
		t.Fatalf("expected list trace id %q, got %q", record.Summary.TraceID, listPayload.Inspects[0].TraceID)
	}

	detailReq := httptest.NewRequest(http.MethodGet, "/lighthouse/api/inspect/"+record.Summary.TraceID, nil)
	detailReq.AddCookie(&http.Cookie{Name: lighthouseAuthCookie, Value: secret})
	detailRec := httptest.NewRecorder()
	server.ServeHTTP(detailRec, detailReq)
	if detailRec.Code != http.StatusOK {
		t.Fatalf("detail status: got %d body=%s", detailRec.Code, detailRec.Body.String())
	}
	var detailRecord inspects.Record
	if err := json.Unmarshal(detailRec.Body.Bytes(), &detailRecord); err != nil {
		t.Fatalf("decode detail payload: %v", err)
	}
	if detailRecord.Summary.TraceID != record.Summary.TraceID {
		t.Fatalf("expected detail trace id %q, got %q", record.Summary.TraceID, detailRecord.Summary.TraceID)
	}
	if len(detailRecord.Events) != len(record.Events) {
		t.Fatalf("expected %d detail events, got %d", len(record.Events), len(detailRecord.Events))
	}
}

func TestInspectPublisherRetainsBatchWhenNotConnected(t *testing.T) {
	agent := NewAgent(AgentConfig{Source: "http", Secret: "test-secret"})
	agent.inspectActive.Store(true)
	publisher := NewInspectPublisher(agent{{- if .Components.Metrics }}, nil{{- end }})

	record := inspects.Record{
		Summary: inspects.InspectSummary{
			TraceID:   "inspect-drop",
			Source:    "http",
			Name:      "request",
			Status:    "ok",
			StartedAt: time.Now(),
			UpdatedAt: time.Now(),
			EndedAt:   time.Now(),
		},
	}

	ok := publisher.flush([]*inspects.Record{&record})

	if ok {
		t.Fatal("expected flush to report retryable failure while disconnected")
	}
	if got := publisher.dropped.Load(); got != 0 {
		t.Fatalf("expected dropped count 0, got %d", got)
	}
}

func TestInspectPublisherRetriesBufferedBatchAfterConnect(t *testing.T) {
	agent := NewAgent(AgentConfig{Source: "http", Secret: "test-secret"})
	agent.inspectActive.Store(true)
	publisher := &InspectPublisher{
		agent:          agent,
		buffer:         make(chan *inspects.Record, 4),
		flushInterval:  10 * time.Millisecond,
		flushBatchSize: 100,
	}

	ctx, cancel := context.WithCancel(context.Background())
	defer cancel()
	go publisher.Start(ctx)

	record := inspects.Record{
		Summary: inspects.InspectSummary{
			TraceID:   "inspect-retry",
			Source:    "http",
			Name:      "request",
			Status:    "ok",
			StartedAt: time.Now(),
			UpdatedAt: time.Now(),
			EndedAt:   time.Now(),
		},
	}
	publisher.Publish(record)

	time.Sleep(25 * time.Millisecond)
	if got := publisher.dropped.Load(); got != 0 {
		t.Fatalf("expected dropped count 0 before connect, got %d", got)
	}

	conn := &captureWSConnection{}
	agent.setConn(&wsConn{conn: conn, secret: agent.config.Secret})

	deadline := time.Now().Add(250 * time.Millisecond)
	for len(conn.writes) == 0 && time.Now().Before(deadline) {
		time.Sleep(10 * time.Millisecond)
	}
	if len(conn.writes) != 1 {
		t.Fatalf("expected buffered inspect to flush after connect, got %d writes", len(conn.writes))
	}
}

func TestInspectPublisherDropsWhenBufferFull(t *testing.T) {
	agent := NewAgent(AgentConfig{Source: "http", Secret: "test-secret"})
	agent.inspectActive.Store(true)
	publisher := &InspectPublisher{
		agent:          agent,
		buffer:         make(chan *inspects.Record, 1),
		flushInterval:  time.Second,
		flushBatchSize: 100,
	}

	first := inspects.Record{
		Summary: inspects.InspectSummary{
			TraceID:   "inspect-buffer-1",
			Source:    "http",
			Name:      "request",
			Status:    "ok",
			StartedAt: time.Now(),
			UpdatedAt: time.Now(),
			EndedAt:   time.Now(),
		},
	}
	second := inspects.Record{
		Summary: inspects.InspectSummary{
			TraceID:   "inspect-buffer-2",
			Source:    "http",
			Name:      "request",
			Status:    "ok",
			StartedAt: time.Now(),
			UpdatedAt: time.Now(),
			EndedAt:   time.Now(),
		},
	}

	publisher.Publish(first)
	publisher.Publish(second)

	if len(publisher.buffer) != 1 {
		t.Fatalf("expected buffer depth 1, got %d", len(publisher.buffer))
	}
	if got := publisher.dropped.Load(); got != 1 {
		t.Fatalf("expected dropped count 1, got %d", got)
	}
}

func TestInspectPublisherSkipsWhenInactive(t *testing.T) {
	agent := NewAgent(AgentConfig{Source: "http", Secret: "test-secret"})
	conn := &captureWSConnection{}
	agent.setConn(&wsConn{conn: conn, secret: agent.config.Secret})
	publisher := NewInspectPublisher(agent{{- if .Components.Metrics }}, nil{{- end }})

	record := inspects.Record{
		Summary: inspects.InspectSummary{
			TraceID:   "inspect-inactive",
			Source:    "http",
			Name:      "request",
			Status:    "ok",
			StartedAt: time.Now(),
			UpdatedAt: time.Now(),
			EndedAt:   time.Now(),
		},
	}

	publisher.Publish(record)
	if len(publisher.buffer) != 0 {
		t.Fatalf("expected inactive publisher to skip buffering, got depth %d", len(publisher.buffer))
	}
	if ok := publisher.flush([]*inspects.Record{&record}); !ok {
		t.Fatal("expected inactive flush to short-circuit successfully")
	}
	if len(conn.writes) != 0 {
		t.Fatalf("expected no websocket writes while inactive, got %d", len(conn.writes))
	}
}

func TestHubBroadcastsInspectControl(t *testing.T) {
	secret := "test-secret"
	hub := NewHub()
	agentConn := &captureWSConnection{}
	ws := &wsConn{conn: agentConn, secret: secret}

	hub.RegisterAgent(ws, AgentInfo{Source: "http"})
	if len(agentConn.writes) != 1 {
		t.Fatalf("expected initial inspect-control write, got %d", len(agentConn.writes))
	}
	assertInspectControlMessage(t, secret, agentConn.writes[0], false)

	consoleConn := &captureWSConnection{}
	consoleWS := &wsConn{conn: consoleConn}
	hub.RegisterConsole(consoleWS)
	if len(agentConn.writes) != 2 {
		t.Fatalf("expected active inspect-control write after console register, got %d", len(agentConn.writes))
	}
	assertInspectControlMessage(t, secret, agentConn.writes[1], true)

	hub.UnregisterConsole(consoleWS)
	if len(agentConn.writes) != 3 {
		t.Fatalf("expected inactive inspect-control write after console unregister, got %d", len(agentConn.writes))
	}
	assertInspectControlMessage(t, secret, agentConn.writes[2], false)
}

func mustJSON(t *testing.T, value any) []byte {
	t.Helper()
	raw, err := json.Marshal(value)
	if err != nil {
		t.Fatalf("marshal json: %v", err)
	}
	return raw
}

func assertInspectControlMessage(t *testing.T, secret string, payload any, wantActive bool) {
	t.Helper()
	wire, ok := payload.(EncryptedMessage)
	if !ok {
		t.Fatalf("expected EncryptedMessage payload, got %T", payload)
	}
	decrypted, err := decryptWithSecret(secret, wire.Nonce, wire.Data)
	if err != nil {
		t.Fatalf("decrypt inspect-control message: %v", err)
	}
	var msg Message
	if err := json.Unmarshal(decrypted, &msg); err != nil {
		t.Fatalf("unmarshal inspect-control message: %v", err)
	}
	if msg.Type != "inspect-control" {
		t.Fatalf("expected inspect-control message, got %q", msg.Type)
	}
	var control InspectControl
	if err := json.Unmarshal(msg.Payload, &control); err != nil {
		t.Fatalf("unmarshal inspect control payload: %v", err)
	}
	if control.Active != wantActive {
		t.Fatalf("inspect active = %v, want %v", control.Active, wantActive)
	}
}
