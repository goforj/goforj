package lighthouse

import (
	"encoding/base64"
	"encoding/json"
	"time"

	"{{.GoModuleName}}/internal/inspects"
	"github.com/vmihailenco/msgpack/v5"
)

// Message is the shared envelope for all control-plane traffic.
type Message struct {
	Type        string          `json:"type"`
	ID          string          `json:"id"`
	ReplyTo     string          `json:"reply_to,omitempty"`
	Source      string          `json:"source,omitempty"`
	Destination string          `json:"destination,omitempty"`
	Payload     json.RawMessage `json:"payload"`
}

// EncryptedMessage is the shared encrypted envelope for agent websocket traffic.
type EncryptedMessage struct {
	Nonce string `json:"nonce"`
	Data  string `json:"data"`
}

const inspectBatchEnvelopeVersion = 1

// InspectBatchEnvelope is the versioned finished-inspect payload sent to Lighthouse.
type InspectBatchEnvelope struct {
	Version int               `json:"version"`
	Records []inspects.Record `json:"records"`
}

type InspectControl struct {
	Active bool `json:"active"`
}

type InspectBatchTransport struct {
	Encoding string `json:"encoding"`
	Data     string `json:"data"`
}

// Command represents a typed command request.
type Command struct {
	Name   string          `json:"name"`
	Params json.RawMessage `json:"params"`
}

// Response represents a command response payload.
type Response struct {
	Ok    bool            `json:"ok"`
	Error string          `json:"error,omitempty"`
	Data  json.RawMessage `json:"data,omitempty"`
}

// DevwatchLine represents a single watcher output entry.
type DevwatchLine struct {
	ID        int64     `json:"id"`
	Line      string    `json:"line"`
	Stream    string    `json:"stream"`
	Timestamp time.Time `json:"timestamp"`
	Watcher   string    `json:"watcher,omitempty"`
}

// Decode decodes the command params into a typed struct.
func Decode[T any](cmd Command) (T, error) {
	var value T
	return value, json.Unmarshal(cmd.Params, &value)
}

func encodeInspectBatchPayload(envelope InspectBatchEnvelope) (json.RawMessage, error) {
	raw, err := msgpack.Marshal(envelope)
	if err != nil {
		return nil, err
	}
	return json.Marshal(InspectBatchTransport{
		Encoding: "msgpack",
		Data:     base64.StdEncoding.EncodeToString(raw),
	})
}

func decodeInspectBatchPayload(payload json.RawMessage) (InspectBatchEnvelope, error) {
	var transport InspectBatchTransport
	if err := json.Unmarshal(payload, &transport); err == nil && transport.Encoding != "" {
		switch transport.Encoding {
		case "msgpack":
			raw, decodeErr := base64.StdEncoding.DecodeString(transport.Data)
			if decodeErr != nil {
				return InspectBatchEnvelope{}, decodeErr
			}
			var envelope InspectBatchEnvelope
			if unmarshalErr := msgpack.Unmarshal(raw, &envelope); unmarshalErr != nil {
				return InspectBatchEnvelope{}, unmarshalErr
			}
			return envelope, nil
		default:
			var envelope InspectBatchEnvelope
			err = json.Unmarshal(payload, &envelope)
			return envelope, err
		}
	}

	var envelope InspectBatchEnvelope
	err := json.Unmarshal(payload, &envelope)
	return envelope, err
}
