// ServerConfig configures the dev console server.
type ServerConfig struct {
	Secret string
{{- if .ProjectComponents.Storage }}
	StorageDownload func(r web.Context, disk string, path string) error
{{- end }}
	Inspects *inspects.Manager
}

const lighthouseAuthCookie = "lighthouse_token"
const lighthouseRouteBase = "/lighthouse"

var lighthouseAuthLogMu sync.Mutex
var lighthouseAuthLastLogAt = map[string]time.Time{}
var lighthouseDevSessionMu sync.Mutex
var lighthouseDevSessions = map[string]time.Time{}

// Attach mounts the dev console routes onto the provided web router.
func Attach(router web.Router, hub *Hub, config ServerConfig) {
	if !Enabled() {
		return
	}
	group := router.Group(lighthouseRouteBase)
	baseURL := strings.TrimRight(strings.TrimSpace(os.Getenv("APP_URL")), "/")
	if baseURL == "" {
		baseURL = "http://localhost:3000"
	}

	group.GET("", func(r web.Context) error {
		return serveIndex(r, config)
	})

	group.GET("/assets/*", func(r web.Context) error {
		return serveAssets(r)
	})

	group.POST("/auth", func(r web.Context) error {
		var req struct {
			Username string `json:"username"`
			Password string `json:"password"`
		}
		if err := r.Bind(&req); err != nil {
			return r.NoContent(http.StatusBadRequest)
		}
		if strings.TrimSpace(req.Username) != "admin" {
			return r.NoContent(http.StatusUnauthorized)
		}
		if config.Secret == "" || req.Password != config.Secret {
			return r.NoContent(http.StatusUnauthorized)
		}
		r.SetCookie(&http.Cookie{
			Name:     lighthouseAuthCookie,
			Value:    config.Secret,
			Path:     "/",
			HttpOnly: true,
			SameSite: http.SameSiteLaxMode,
		})
		return r.NoContent(http.StatusNoContent)
	})

	group.POST("/auth/logout", func(r web.Context) error {
		r.SetCookie(&http.Cookie{
			Name:     lighthouseAuthCookie,
			Value:    "",
			Path:     "/",
			MaxAge:   -1,
			HttpOnly: true,
			SameSite: http.SameSiteLaxMode,
		})
		return r.NoContent(http.StatusNoContent)
	})
	if env.IsAppEnvLocal() {
		group.POST("/auth/dev-session", func(r web.Context) error {
			if config.Secret == "" {
				return r.NoContent(http.StatusServiceUnavailable)
			}
			if !authorizeWebBearerToken(r, config.Secret) {
				return r.NoContent(http.StatusUnauthorized)
			}
			code := uuid.NewString()
			storeLighthouseDevSession(code, time.Now().Add(30*time.Second))
			return r.JSON(http.StatusOK, map[string]any{
				"url": fmt.Sprintf("%s/auth/dev/%s", lighthouseRouteBase, code),
			})
		})
		group.GET("/auth/dev/:code", func(r web.Context) error {
			if config.Secret == "" {
				return r.NoContent(http.StatusServiceUnavailable)
			}
			if !consumeLighthouseDevSession(strings.TrimSpace(r.Param("code"))) {
				return r.NoContent(http.StatusUnauthorized)
			}
			r.SetCookie(&http.Cookie{
				Name:     lighthouseAuthCookie,
				Value:    config.Secret,
				Path:     "/",
				HttpOnly: true,
				SameSite: http.SameSiteLaxMode,
			})
			return r.Redirect(http.StatusSeeOther, lighthouseRouteBase)
		})
	}

	authMiddleware := func(next web.Handler) web.Handler {
		return func(r web.Context) error {
			if !authorizeWebRequest(r, config.Secret) {
				logLighthouseWebAuthFailure(r, config.Secret)
				return r.NoContent(http.StatusUnauthorized)
			}
			return next(r)
		}
	}

	apiGroup := group.Group("/api", authMiddleware)
	wsGroup := group.Group("/ws", authMiddleware)

	apiGroup.GET("/agents", func(r web.Context) error {
		agents := hub.Agents()
		hasDev := false
		sources := make([]string, 0, len(agents))
		for _, agent := range agents {
			sources = append(sources, agent.Source)
			if agent.Source == "dev" {
				hasDev = true
			}
		}
		if !hasDev && lighthouseDebugEnabled() {
			log.Printf("lighthouse agents missing dev source; sources=%v pid=%d hub=%p", sources, os.Getpid(), hub)
		}
		return r.JSON(http.StatusOK, agents)
	})

	apiGroup.GET("/local", func(r web.Context) error {
		ip := r.RealIP()
		local := ip == "127.0.0.1" || ip == "::1"
		return r.JSON(http.StatusOK, map[string]any{"local": local})
	})
{{- if .ProjectComponents.Storage }}
	if config.StorageDownload != nil {
		apiGroup.GET("/storage/download", func(r web.Context) error {
			return config.StorageDownload(r, r.Query("disk"), r.Query("path"))
		})
	}
{{- end }}
	apiGroup.GET("/env", func(r web.Context) error {
		name := strings.TrimSpace(r.Query("file"))
		if name == "" {
			return r.JSON(http.StatusOK, map[string]any{
				"files": listEnvFiles(),
			})
		}
		path, ok := resolveEnvFile(name)
		if !ok {
			return r.NoContent(http.StatusNotFound)
		}
		data, err := os.ReadFile(path)
		if err != nil {
			return r.NoContent(http.StatusInternalServerError)
		}
		return r.JSON(http.StatusOK, map[string]any{
			"name":    name,
			"content": string(data),
		})
	})
	apiGroup.POST("/env", func(r web.Context) error {
		name := strings.TrimSpace(r.Query("file"))
		if name == "" {
			return r.NoContent(http.StatusBadRequest)
		}
		path, ok := resolveEnvFile(name)
		if !ok {
			return r.NoContent(http.StatusNotFound)
		}
		var payload struct {
			Content string `json:"content"`
		}
		if err := r.Bind(&payload); err != nil {
			return r.NoContent(http.StatusBadRequest)
		}
		if err := os.WriteFile(path, []byte(payload.Content), 0644); err != nil {
			return r.NoContent(http.StatusInternalServerError)
		}
		return r.NoContent(http.StatusNoContent)
	})

	apiGroup.POST("/editor", func(r web.Context) error {
		var payload editorRequest
		if err := r.Bind(&payload); err != nil {
			return r.NoContent(http.StatusBadRequest)
		}
		payload.Path = strings.TrimSpace(payload.Path)
		payload.Symbol = strings.TrimSpace(payload.Symbol)
		if payload.Path == "" && payload.Symbol == "" {
			return r.NoContent(http.StatusBadRequest)
		}
		if err := defaultEditorService.launch(payload); err != nil {
			log.Printf("failed to open editor: %v", err)
			return r.Text(http.StatusInternalServerError, err.Error())
		}
		return r.NoContent(http.StatusNoContent)
	})
	apiGroup.POST("/editor/symbols", func(r web.Context) error {
		var payload editorSymbolCheckRequest
		if err := r.Bind(&payload); err != nil {
			return r.NoContent(http.StatusBadRequest)
		}
		return r.JSON(http.StatusOK, map[string]any{
			"symbols": defaultEditorService.validateSymbols(payload.Symbols),
		})
	})

	apiGroup.GET("/goforj", func(r web.Context) error {
		project, err := loadProjectConfig()
		if err != nil {
			return r.NoContent(http.StatusInternalServerError)
		}
		return r.JSON(http.StatusOK, project)
	})
	apiGroup.GET("/about", func(r web.Context) error {
		return r.JSON(http.StatusOK, runtime.NewAboutService().Build())
	})
	listInspect := func(r web.Context) error {
		if config.Inspects == nil {
			return r.JSON(http.StatusOK, map[string]any{"inspects": []inspects.InspectSummary{}})
		}
		limit := 50
		if raw := strings.TrimSpace(r.Query("limit")); raw != "" {
			if parsed, err := strconv.Atoi(raw); err == nil && parsed > 0 {
				limit = parsed
			}
		}
		items, err := config.Inspects.Recent(r.Request().Context(), inspects.RecentQuery{
			Source: runtime.NormalizeSource(r.Query("source")),
			Limit:  limit,
		})
		if err != nil {
			return r.NoContent(http.StatusInternalServerError)
		}
		return r.JSON(http.StatusOK, map[string]any{"inspects": items})
	}
	apiGroup.GET("/inspect", listInspect)
	getInspect := func(r web.Context) error {
		if config.Inspects == nil {
			return r.NoContent(http.StatusNotFound)
		}
		record, ok, err := config.Inspects.ByID(r.Request().Context(), r.Param("id"))
		if err != nil {
			return r.NoContent(http.StatusInternalServerError)
		}
		if !ok {
			return r.NoContent(http.StatusNotFound)
		}
		return r.JSON(http.StatusOK, record)
	}
	apiGroup.GET("/inspect/:id", getInspect)
	apiGroup.POST("/goforj", func(r web.Context) error {
		current, err := loadProjectConfig()
		if err != nil {
			return r.NoContent(http.StatusInternalServerError)
		}
		var payload struct {
			ProjectName  *string             `json:"project_name"`
			GoModuleName *string             `json:"module_name"`
			Dev          *devConfigUpdate    `json:"dev"`
			Components   *project.Components `json:"components"`
		}
		if err := r.Bind(&payload); err != nil {
			return r.NoContent(http.StatusBadRequest)
		}
		if payload.ProjectName != nil {
			current.ProjectName = strings.TrimSpace(*payload.ProjectName)
		}
		if payload.GoModuleName != nil && *payload.GoModuleName != "" {
			current.GoModuleName = *payload.GoModuleName
		}
		if payload.Dev != nil {
			applyDevConfigUpdate(&current.Dev, *payload.Dev)
		}
		if payload.Components != nil {
			current.Render.Components = mergeLighthouseComponents(current.Render.Components, *payload.Components)
		}
		if err := saveProjectConfig(current); err != nil {
			return r.NoContent(http.StatusInternalServerError)
		}
		return r.NoContent(http.StatusNoContent)
	})

	wsGroup.GETWS("/agent", func(r web.Context, conn web.WebSocketConn) error {
		return handleAgentWS(r, conn, hub, config.Secret, config.Inspects)
	})

	wsGroup.GETWS("/console", func(r web.Context, conn web.WebSocketConn) error {
		return handleConsoleWS(r, conn, hub)
	})
	wsGroup.GETWS("/devwatch", func(r web.Context, conn web.WebSocketConn) error {
		return handleDevwatchWS(r, conn, hub)
	})

	group.GET("/*", func(r web.Context) error {
		return serveIndex(r, config)
	})
}

func authorizeWebRequest(r web.Context, token string) bool {
	if strings.TrimSpace(token) == "" {
		return false
	}
	if cookie, err := r.Cookie(lighthouseAuthCookie); err == nil && cookie != nil {
		if cookie.Value == token {
			return true
		}
	}
	auth := r.Header("Authorization")
	if strings.HasPrefix(auth, "Bearer ") {
		return strings.TrimSpace(strings.TrimPrefix(auth, "Bearer ")) == token
	}
	return false
}

func authorizeWebBearerToken(r web.Context, token string) bool {
	if strings.TrimSpace(token) == "" {
		return false
	}
	auth := r.Header("Authorization")
	if !strings.HasPrefix(auth, "Bearer ") {
		return false
	}
	return strings.TrimSpace(strings.TrimPrefix(auth, "Bearer ")) == token
}

func storeLighthouseDevSession(code string, expiresAt time.Time) {
	if strings.TrimSpace(code) == "" {
		return
	}
	now := time.Now()
	lighthouseDevSessionMu.Lock()
	defer lighthouseDevSessionMu.Unlock()
	for key, value := range lighthouseDevSessions {
		if !value.After(now) {
			delete(lighthouseDevSessions, key)
		}
	}
	lighthouseDevSessions[code] = expiresAt
}

func consumeLighthouseDevSession(code string) bool {
	if strings.TrimSpace(code) == "" {
		return false
	}
	now := time.Now()
	lighthouseDevSessionMu.Lock()
	defer lighthouseDevSessionMu.Unlock()
	expiresAt, ok := lighthouseDevSessions[code]
	if !ok {
		return false
	}
	delete(lighthouseDevSessions, code)
	return expiresAt.After(now)
}

func logLighthouseWebAuthFailure(r web.Context, expectedToken string) {
	if r == nil || !strings.HasPrefix(r.Path(), lighthouseRouteBase) {
		return
	}
	remote := strings.TrimSpace(r.RealIP())
	bearer := strings.TrimSpace(strings.TrimPrefix(r.Header("Authorization"), "Bearer "))
	hasCookie := false
	if cookie, err := r.Cookie(lighthouseAuthCookie); err == nil && cookie != nil && strings.TrimSpace(cookie.Value) != "" {
		hasCookie = true
	}

	log.Printf(
		"lighthouse http unauthorized path=%s remote=%s has_bearer=%t bearer_fp=%s has_cookie=%t expected_fp=%s",
		r.Path(),
		remote,
		bearer != "",
		tokenFingerprint(bearer),
		hasCookie,
		tokenFingerprint(strings.TrimSpace(expectedToken)),
	)
}

func tokenFingerprint(value string) string {
	trimmed := strings.TrimSpace(value)
	if trimmed == "" {
		return "-"
	}
	sum := fnv.New32a()
	_, _ = sum.Write([]byte(trimmed))
	return fmt.Sprintf("%08x", sum.Sum32())
}

func lighthouseDebugEnabled() bool {
	for _, key := range []string{"LIGHTHOUSE_DEBUG", "FORJ_DEBUG", "APP_DEBUG", "DEBUG"} {
		value := os.Getenv(key)
		if value != "" && value != "0" {
			return true
		}
	}
	return false
}

// listEnvFiles lists available .env and .env.* files in the project root.
func listEnvFiles() []string {
	files := []string{}
	entries, err := os.ReadDir(".")
	if err != nil {
		return files
	}
	for _, entry := range entries {
		if entry.IsDir() {
			continue
		}
		name := entry.Name()
		if name == ".env" || strings.HasPrefix(name, ".env.") {
			files = append(files, name)
		}
	}
	return files
}

// resolveEnvFile validates an env filename and returns its path if it exists.
func resolveEnvFile(name string) (string, bool) {
	if name != ".env" && !strings.HasPrefix(name, ".env.") {
		return "", false
	}
	clean := filepath.Base(name)
	if clean != name {
		return "", false
	}
	path := filepath.Join(".", clean)
	if _, err := os.Stat(path); err != nil {
		return "", false
	}
	return path, true
}

// loadProjectConfig reads .goforj.yml into a project config instance.
func loadProjectConfig() (*project.Config, error) {
	return project.LoadProjectConfig()
}

// saveProjectConfig persists the project config back to .goforj.yml.
func saveProjectConfig(config *project.Config) error {
	config.UpdatedAt = time.Now().Format("2006-01-02 15:04:05 MST")
	config.Render.ComponentContractVersion = project.CurrentComponentContractVersion
	var buf bytes.Buffer
	encoder := yaml.NewEncoder(&buf)
	encoder.SetIndent(2)
	defer encoder.Close()
	if err := encoder.Encode(config); err != nil {
		return err
	}
	return os.WriteFile(".goforj.yml", buf.Bytes(), 0644)
}

// handleAgentWS processes upgraded agent websocket connections.
func handleAgentWS(_ web.Context, conn web.WebSocketConn, hub *Hub, secret string, inspectManager *inspects.Manager) error {
	defer conn.Close()
	ws := newWSConnWithSecret(conn, secret)

	source := ""
	for {
		var msg Message
		if err := ws.readJSON(&msg); err != nil {
			if source != "" {
				hub.RemoveAgent(source)
			}
			return nil
		}
		if source != "" {
			msg.Source = source
		}
		switch msg.Type {
		case "register":
			info, err := parseAgentInfo(msg.Payload)
			if err != nil {
				return err
			}
			source = info.Key
			hub.RegisterAgent(ws, info)
		case "heartbeat":
			var heartbeat struct {
				StartedAt time.Time `json:"started_at"`
			}
			if err := json.Unmarshal(msg.Payload, &heartbeat); err == nil {
				hub.UpdateHeartbeat(msg.Source, heartbeat.StartedAt)
			} else {
				hub.UpdateHeartbeat(msg.Source, time.Time{})
			}
		case "event":
			hub.RecordEvent(msg)
		case "inspect-batch":
			if inspectManager != nil {
				_ = ingestInspectBatch(inspectManager, msg.Payload)
			}
		case "response":
			hub.HandleResponse(msg)
		}
	}
}

func ingestInspectBatch(manager *inspects.Manager, payload json.RawMessage) error {
	if manager == nil || len(payload) == 0 {
		return nil
	}
	envelope, err := decodeInspectBatchPayload(payload)
	if err != nil {
		return err
	}
	if envelope.Version != inspectBatchEnvelopeVersion {
		return fmt.Errorf("unsupported inspect batch version: %d", envelope.Version)
	}
	for _, record := range envelope.Records {
		if err := manager.Ingest(context.Background(), record); err != nil {
			return err
		}
	}
	return nil
}

// handleConsoleWS handles upgraded console websocket connections.
func handleConsoleWS(_ web.Context, conn web.WebSocketConn, hub *Hub) error {
	defer conn.Close()

	ws := newWSConn(conn)
	hub.RegisterConsole(ws)
	defer hub.UnregisterConsole(ws)

	for {
		var msg Message
		if err := conn.ReadJSON(&msg); err != nil {
			return nil
		}
		if msg.Type != "command" {
			continue
		}
		var cmd Command
		if err := json.Unmarshal(msg.Payload, &cmd); err != nil {
			payload, _ := json.Marshal(Response{Ok: false, Error: err.Error()})
			_ = ws.writeJSON(Message{
				Type:    "response",
				ID:      msg.ID,
				ReplyTo: msg.ID,
				Payload: payload,
			})
			continue
		}
		if msg.Destination == "control" && cmd.Name == "logs:history" {
			limit := 5000
			if len(cmd.Params) > 0 {
				var params map[string]any
				if err := json.Unmarshal(cmd.Params, &params); err == nil {
					if raw, ok := params["limit"]; ok {
						if parsed, err := strconv.Atoi(fmt.Sprint(raw)); err == nil {
							limit = parsed
						}
					}
				}
			}
			payload, _ := json.Marshal(map[string]any{
				"logs": hub.LogSnapshot(limit),
			})
			response, _ := json.Marshal(Response{Ok: true, Data: payload})
			_ = ws.writeJSON(Message{
				Type:    "response",
				ID:      uuid.NewString(),
				ReplyTo: msg.ID,
				Source:  "control",
				Payload: response,
			})
			continue
		}
		if err := hub.RouteCommand(ws, msg); err != nil {
			payload, _ := json.Marshal(Response{Ok: false, Error: err.Error()})
			_ = ws.writeJSON(Message{
				Type:    "response",
				ID:      msg.ID,
				ReplyTo: msg.ID,
				Payload: payload,
			})
		}
	}
}

type devwatchControlPayload struct {
	Action string `json:"action"`
}

// handleDevwatchWS handles upgraded devwatch websocket connections for streaming output.
func handleDevwatchWS(r web.Context, conn web.WebSocketConn, hub *Hub) error {
	defer conn.Close()

	ws := newWSConn(conn)
	isSource := r.Query("role") == "source"
	roleLabel := "console"
	if isSource {
		roleLabel = "source"
	}
	remoteAddr := r.RealIP()
	if lighthouseDebugEnabled() {
		log.Printf("lighthouse devwatch ws connected role=%s remote=%s pid=%d hub=%p", roleLabel, remoteAddr, os.Getpid(), hub)
		defer log.Printf("lighthouse devwatch ws disconnected role=%s remote=%s pid=%d hub=%p", roleLabel, remoteAddr, os.Getpid(), hub)
	}
	if !isSource {
		hub.RegisterDevwatch(ws)
		defer hub.UnregisterDevwatch(ws)
	} else {
		hub.RegisterDevwatchSource(ws)
		defer hub.UnregisterDevwatchSource(ws)

		const devwatchAgentSource = "dev"
		appName := os.Getenv("APP_NAME")
		if appName == "" {
			appName = "GoForj Dev Watcher"
		}
		agentInfo := AgentInfo{
			ID:           uuid.NewString(),
			Key:          devwatchAgentSource,
			Source:       devwatchAgentSource,
			Project:      appName,
			App:          "app",
			Version:      os.Getenv("APP_VERSION"),
			Env:          os.Getenv("APP_ENV"),
			Capabilities: []string{"devwatch"},
			InstanceID:   uuid.NewString(),
			InstanceKind: "dev",
			Host:         r.Host(),
			StartedAt:    time.Now(),
		}
		hub.RegisterDevwatchAgent(ws, agentInfo)
		if lighthouseDebugEnabled() {
			log.Printf("lighthouse devwatch agent registered source=%s host=%s pid=%d hub=%p", agentInfo.Source, agentInfo.Host, os.Getpid(), hub)
			defer log.Printf("lighthouse devwatch agent removed source=%s pid=%d hub=%p", devwatchAgentSource, os.Getpid(), hub)
		}
		defer hub.RemoveAgent(devwatchAgentSource)

		done := make(chan struct{})
		defer close(done)
		go func(startedAt time.Time) {
			ticker := time.NewTicker(5 * time.Second)
			defer ticker.Stop()
			for {
				select {
				case <-done:
					return
				case <-ticker.C:
					hub.UpdateHeartbeat(devwatchAgentSource, startedAt)
				}
			}
		}(agentInfo.StartedAt)
	}

	for {
		var msg Message
		if err := conn.ReadJSON(&msg); err != nil {
			return nil
		}
		if msg.Type == "devwatch-control" {
			if !isSource {
				var control devwatchControlPayload
				_ = json.Unmarshal(msg.Payload, &control)
				if control.Action == "restart" {
					hub.ClearDevwatchLog()
				}
				hub.BroadcastDevwatchControl(msg.Payload)
			}
			continue
		}
		if msg.Type != "devwatch" {
			continue
		}
		var payload struct {
			Line DevwatchLine `json:"line"`
		}
		if err := json.Unmarshal(msg.Payload, &payload); err != nil {
			continue
		}
		if payload.Line.Line == "" {
			continue
		}
		if payload.Line.Timestamp.IsZero() {
			payload.Line.Timestamp = time.Now()
		}
		hub.RecordDevwatch(payload.Line)
	}
}

// serveIndex returns the embedded dev console UI.
// serveIndex renders the main dev console SPA.
func serveIndex(r web.Context, config ServerConfig) error {
	data, err := readAsset("index.html")
	if err != nil {
		return err
	}
	return r.Blob(http.StatusOK, "text/html; charset=utf-8", data)
}

// serveAssets serves embedded UI assets.
// serveAssets responds with embedded static assets.
func serveAssets(r web.Context) error {
	path := strings.TrimPrefix(r.Param("*"), "/")
	if path == "" {
		return r.NoContent(http.StatusNotFound)
	}
	data, err := readAsset("assets/" + path)
	if err != nil {
		return r.NoContent(http.StatusNotFound)
	}
	contentType := ""
	if strings.HasSuffix(path, ".css") {
		contentType = "text/css"
	} else if strings.HasSuffix(path, ".js") {
		contentType = "text/javascript"
	}
	return r.Blob(http.StatusOK, contentType, data)
}

// readAsset loads an asset from the embedded filesystem.
func readAsset(name string) ([]byte, error) {
	data, ok := uiAssets[name]
	if !ok {
		return nil, fmt.Errorf("asset not found: %s", name)
	}
	return data, nil
}
