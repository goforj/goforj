package maintenance

import (
	"net"
	"net/http"
	"net/http/httptest"
	"net/url"
	"strings"
	"testing"
)

// TestMaintenanceCommandsUseAuthenticatedControlEndpoint verifies memory transitions reach the running process.
func TestMaintenanceCommandsUseAuthenticatedControlEndpoint(t *testing.T) {
	actions := make(chan string, 2)
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if got := r.Header.Get("Authorization"); got != "Bearer diag-token" {
			t.Errorf("Authorization = %q", got)
		}
		if r.Method != http.MethodPost {
			t.Errorf("method = %q", r.Method)
		}
		actions <- r.URL.Path
		w.WriteHeader(http.StatusNoContent)
	}))
	t.Cleanup(server.Close)
	serverURL, err := url.Parse(server.URL)
	if err != nil {
		t.Fatalf("parse test server URL: %v", err)
	}
	_, port, err := net.SplitHostPort(serverURL.Host)
	if err != nil {
		t.Fatalf("split test server address: %v", err)
	}
	t.Setenv("API_HTTP_PORT", port)
	t.Setenv("APP_DIAG_TOKEN", "diag-token")
	if err := (&EnableCmd{}).Run(); err != nil {
		t.Fatalf("maintenance enable: %v", err)
	}
	if got := <-actions; got != "/-/maintenance/enable" {
		t.Fatalf("enable path = %q", got)
	}
	if err := (&DisableCmd{}).Run(); err != nil {
		t.Fatalf("maintenance disable: %v", err)
	}
	if got := <-actions; got != "/-/maintenance/disable" {
		t.Fatalf("disable path = %q", got)
	}
}

// TestMaintenanceCommandReportsControlFailure keeps remote policy and backend errors visible to operators.
func TestMaintenanceCommandReportsControlFailure(t *testing.T) {
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		http.Error(w, "maintenance remains environment-enforced", http.StatusConflict)
	}))
	t.Cleanup(server.Close)
	serverURL, err := url.Parse(server.URL)
	if err != nil {
		t.Fatalf("parse test server URL: %v", err)
	}
	_, port, err := net.SplitHostPort(serverURL.Host)
	if err != nil {
		t.Fatalf("split test server address: %v", err)
	}
	t.Setenv("API_HTTP_PORT", port)
	t.Setenv("APP_DIAG_TOKEN", "diag-token")
	if err := (&DisableCmd{}).Run(); err == nil {
		t.Fatal("maintenance:disable unexpectedly ignored endpoint failure")
	}
}

// TestControlEndpointAlwaysUsesLoopback prevents public APP_URL configuration from receiving diagnostic credentials.
func TestControlEndpointAlwaysUsesLoopback(t *testing.T) {
	t.Setenv("APP_URL", "https://public.example.test/application")
	t.Setenv("API_HTTP_PORT", "3210")
	endpoint, err := controlEndpoint("enable")
	if err != nil {
		t.Fatalf("controlEndpoint() error = %v", err)
	}
	if endpoint != "http://127.0.0.1:3210/-/maintenance/enable" {
		t.Fatalf("controlEndpoint() = %q", endpoint)
	}
	if strings.Contains(endpoint, "public.example.test") {
		t.Fatal("controlEndpoint used APP_URL")
	}
}

// TestControlEndpointRejectsInvalidPorts keeps configuration failures local and explicit.
func TestControlEndpointRejectsInvalidPorts(t *testing.T) {
	t.Setenv("API_HTTP_PORT", "invalid")
	if _, err := controlEndpoint("enable"); err == nil {
		t.Fatal("controlEndpoint accepted an invalid HTTP port")
	}
}
