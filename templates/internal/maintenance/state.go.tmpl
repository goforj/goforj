package maintenance

import (
	"encoding/json"
	"errors"
	"fmt"
	"os"
	"path/filepath"
	"strings"
	"sync"
	"sync/atomic"
	"time"

	"github.com/goforj/env/v2"
)

const maintenanceRefreshInterval = 100 * time.Millisecond

var maintenanceCache struct {
	mu       sync.Mutex
	snapshot atomic.Pointer[maintenanceSnapshot]
}

type maintenanceSnapshot struct {
	root      string
	app       string
	enabled   bool
	checkedAt time.Time
}

type maintenanceFile struct {
	App       string    `json:"app"`
	EnabledAt time.Time `json:"enabled_at"`
}

// Enabled reports whether the selected App is globally in maintenance mode.
func Enabled() bool {
	if env.GetBool("APP_MAINTENANCE_ENABLED", "false") {
		return true
	}
	root := os.Getenv("APP_RUNTIME_STATE_DIR")
	app := currentAppName()
	now := time.Now()
	if snapshot := maintenanceCache.snapshot.Load(); maintenanceSnapshotFresh(snapshot, root, app, now) {
		return snapshot.enabled
	}
	maintenanceCache.mu.Lock()
	defer maintenanceCache.mu.Unlock()
	if snapshot := maintenanceCache.snapshot.Load(); maintenanceSnapshotFresh(snapshot, root, app, now) {
		return snapshot.enabled
	}
	path := Path()
	_, err := os.Stat(path)
	snapshot := &maintenanceSnapshot{
		root:      root,
		app:       app,
		enabled:   err == nil || !errors.Is(err, os.ErrNotExist),
		checkedAt: now,
	}
	maintenanceCache.snapshot.Store(snapshot)
	return snapshot.enabled
}

// maintenanceSnapshotFresh reports whether the lock-free observation remains valid for the selected App.
func maintenanceSnapshotFresh(snapshot *maintenanceSnapshot, root, app string, now time.Time) bool {
	return snapshot != nil && snapshot.root == root && snapshot.app == app && now.Sub(snapshot.checkedAt) < maintenanceRefreshInterval
}

// Path returns the App-scoped local state file used by maintenance commands.
func Path() string {
	root := strings.TrimSpace(env.Get("APP_RUNTIME_STATE_DIR", ""))
	if root == "" {
		root = filepath.Join("_data", "runtime")
	}
	return filepath.Join(root, currentAppName(), "maintenance.json")
}

// Enable atomically publishes maintenance state for every runtime sharing the App data directory.
func Enable() error {
	path := Path()
	if info, err := os.Lstat(path); err == nil && !info.Mode().IsRegular() {
		return fmt.Errorf("maintenance state path %q is not a regular file", path)
	} else if err != nil && !errors.Is(err, os.ErrNotExist) {
		return err
	}
	stateDir := filepath.Dir(path)
	if err := os.MkdirAll(stateDir, 0o755); err != nil {
		return err
	}
	if info, err := os.Lstat(stateDir); err != nil {
		return err
	} else if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
		return fmt.Errorf("maintenance state directory %q is not a regular directory", stateDir)
	}
	payload, err := json.Marshal(maintenanceFile{App: currentAppName(), EnabledAt: time.Now().UTC()})
	if err != nil {
		return err
	}
	temporary, err := os.CreateTemp(stateDir, ".maintenance-*")
	if err != nil {
		return err
	}
	temporaryPath := temporary.Name()
	defer func() { _ = os.Remove(temporaryPath) }()
	if err := temporary.Chmod(0o644); err != nil {
		_ = temporary.Close()
		return err
	}
	if _, err := temporary.Write(append(payload, '\n')); err != nil {
		_ = temporary.Close()
		return err
	}
	if err := temporary.Sync(); err != nil {
		_ = temporary.Close()
		return err
	}
	if err := temporary.Close(); err != nil {
		return err
	}
	if err := os.Rename(temporaryPath, path); err != nil {
		if _, statErr := os.Stat(path); statErr == nil {
			invalidateMaintenanceCache(true)
			return nil
		}
		return err
	}
	invalidateMaintenanceCache(true)
	return nil
}

// Disable removes command-managed state while preserving an environment-enforced deployment policy.
func Disable() error {
	path := Path()
	err := os.Remove(path)
	if err != nil && !errors.Is(err, os.ErrNotExist) {
		return err
	}
	invalidateMaintenanceCache(false)
	return nil
}

// currentAppName resolves the process identity already selected by the generated launch path.
func currentAppName() string {
	appName := strings.TrimSpace(env.Get("FORJ_APP", "app"))
	if !validAppName(appName) {
		return "app"
	}
	return appName
}

// validAppName accepts generated App slugs while preventing state path traversal from internal callers.
func validAppName(name string) bool {
	if name == "" || name[0] == '-' || name[len(name)-1] == '-' {
		return false
	}
	for _, character := range name {
		if character >= 'a' && character <= 'z' || character >= '0' && character <= '9' || character == '-' {
			continue
		}
		return false
	}
	return true
}

// invalidateMaintenanceCache makes same-process commands and tests observe their writes immediately.
func invalidateMaintenanceCache(enabled bool) {
	maintenanceCache.mu.Lock()
	maintenanceCache.snapshot.Store(&maintenanceSnapshot{
		root:      os.Getenv("APP_RUNTIME_STATE_DIR"),
		app:       currentAppName(),
		enabled:   enabled,
		checkedAt: time.Now(),
	})
	maintenanceCache.mu.Unlock()
}
