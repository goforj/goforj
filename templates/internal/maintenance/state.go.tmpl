package maintenance

import (
	{{- if .ProjectComponents.Cache }}
	"crypto/sha256"
	{{- end }}
	"fmt"
	"strings"
	"sync"
	"sync/atomic"
	"time"

{{- if .ProjectComponents.Cache }}
	"github.com/goforj/cache"
{{- end }}
	"github.com/goforj/env/v2"
{{- if .ProjectComponents.Cache }}
	"{{.GoModuleName}}/internal/caches"
{{- end }}
)

const (
	driverMemory = "memory"
	driverCache  = "cache"

	maintenanceCacheKey = "goforj:maintenance"
	// Cache stores require a TTL, so use a bounded horizon that behaves as persistent operational state in practice.
	maintenanceCacheTTL = 100 * 365 * 24 * time.Hour
	maintenanceRefreshInterval = 100 * time.Millisecond
)

// State owns the maintenance status observed by one HTTP runtime.
type State struct {
	driver string
	memory atomic.Bool
{{- if .ProjectComponents.Cache }}
	store *cache.Cache
	key   string
{{- end }}
	mu sync.Mutex
	snapshot atomic.Pointer[stateSnapshot]
}

// stateSnapshot keeps cache-backed request checks off the network for a short, bounded interval.
type stateSnapshot struct {
	enabled bool
	err error
	checkedAt time.Time
}

// NewState builds the configured maintenance backend.
//
// APP_MAINTENANCE_DRIVER selects the maintenance mechanism. When it is cache,
// APP_MAINTENANCE_STORE selects one of the named stores generated under internal/caches;
// the selected store keeps its own CACHE_* driver and connection configuration.
func NewState() (*State, error) {
	driver := strings.ToLower(strings.TrimSpace(env.Get("APP_MAINTENANCE_DRIVER", driverMemory)))
	if driver == "" {
		driver = driverMemory
	}
	switch driver {
	case driverMemory:
		return &State{driver: driver}, nil
	case driverCache:
		return nil, fmt.Errorf("maintenance: cache driver requires the Cache component")
	default:
		return nil, fmt.Errorf("maintenance: unsupported driver %q; expected memory or cache", driver)
	}
}

{{- if .ProjectComponents.Cache }}
// NewStateWithCacheManager builds maintenance state from the cache manager already owned by the App runtime.
func NewStateWithCacheManager(cacheManager *caches.Manager) (*State, error) {
	driver := strings.ToLower(strings.TrimSpace(env.Get("APP_MAINTENANCE_DRIVER", driverMemory)))
	if driver == "" {
		driver = driverMemory
	}
	switch driver {
	case driverMemory:
		return &State{driver: driver}, nil
	case driverCache:
		storeName := strings.TrimSpace(env.Get("APP_MAINTENANCE_STORE", "default"))
		store := cacheManager.Default()
		if storeName != "default" {
			store = cacheManager.Named(storeName)
		}
		if store == nil {
			return nil, fmt.Errorf("maintenance: cache store %q is not generated", storeName)
		}
		key, err := configuredCacheKey()
		if err != nil {
			return nil, err
		}
		return &State{driver: driver, store: store, key: key}, nil
	default:
		return nil, fmt.Errorf("maintenance: unsupported driver %q; expected memory or cache", driver)
	}
}
{{- end }}

// Driver reports the configured maintenance mechanism.
func (s *State) Driver() string {
	return s.driver
}

// Enabled reports whether HTTP traffic should be gated.
func (s *State) Enabled() (bool, error) {
	if env.GetBool("APP_MAINTENANCE_ENABLED", "false") {
		return true, nil
	}
	if s.driver == driverMemory {
		return s.memory.Load(), nil
	}
	now := time.Now()
	if snapshot := s.snapshot.Load(); snapshot != nil && now.Sub(snapshot.checkedAt) < maintenanceRefreshInterval {
		return snapshot.enabled, snapshot.err
	}
	s.mu.Lock()
	defer s.mu.Unlock()
	if snapshot := s.snapshot.Load(); snapshot != nil && now.Sub(snapshot.checkedAt) < maintenanceRefreshInterval {
		return snapshot.enabled, snapshot.err
	}
{{- if .ProjectComponents.Cache }}
	value, found, err := s.store.GetString(s.cacheKey())
	if err != nil {
		s.snapshot.Store(&stateSnapshot{err: err, checkedAt: time.Now()})
		return false, err
	}
	enabled := found && value == "enabled"
	s.snapshot.Store(&stateSnapshot{enabled: enabled, checkedAt: time.Now()})
	return enabled, nil
{{- else }}
	return false, fmt.Errorf("maintenance: cache driver requires the Cache component")
{{- end }}
}

// Enable gates HTTP traffic through the configured backend.
func (s *State) Enable() error {
	if s.driver == driverMemory {
		s.memory.Store(true)
		return nil
	}
{{- if .ProjectComponents.Cache }}
	if err := s.store.SetString(s.cacheKey(), "enabled", maintenanceCacheTTL); err != nil {
		return err
	}
	s.invalidate(true)
	return nil
{{- else }}
	return fmt.Errorf("maintenance: cache driver requires the Cache component")
{{- end }}
}

// Disable restores HTTP traffic unless the environment override remains active.
func (s *State) Disable() error {
	if s.driver == driverMemory {
		s.memory.Store(false)
		return nil
	}
{{- if .ProjectComponents.Cache }}
	if err := s.store.Delete(s.cacheKey()); err != nil {
		return err
	}
	s.invalidate(false)
	return nil
{{- else }}
	return fmt.Errorf("maintenance: cache driver requires the Cache component")
{{- end }}
}

{{- if .ProjectComponents.Cache }}
// cacheKey returns the deployment-specific key captured when the cache backend is constructed.
func (s *State) cacheKey() string {
	return s.key
}

// configuredCacheKey isolates shared cache infrastructure without exposing APP_KEY in backend metadata.
func configuredCacheKey() (string, error) {
	appKey := strings.TrimSpace(env.Get("APP_KEY", ""))
	if appKey == "" {
		return "", fmt.Errorf("maintenance: APP_KEY is required for cache state isolation")
	}
	environment := strings.TrimSpace(env.Get("APP_ENV", "local"))
	if environment == "" {
		environment = "local"
	}
	digest := sha256.Sum256([]byte(appKey + "\x00" + environment + "\x00" + currentAppName()))
	return fmt.Sprintf("%s:%x", maintenanceCacheKey, digest[:16]), nil
}

// currentAppName resolves the App identity selected by the generated launch path.
func currentAppName() string {
	name := strings.TrimSpace(env.Get("FORJ_APP", "app"))
	if name == "" {
		return "app"
	}
	return name
}
{{- end }}

// invalidate makes a successful control request visible to the current process immediately.
func (s *State) invalidate(enabled bool) {
	s.mu.Lock()
	s.snapshot.Store(&stateSnapshot{enabled: enabled, checkedAt: time.Now()})
	s.mu.Unlock()
}
