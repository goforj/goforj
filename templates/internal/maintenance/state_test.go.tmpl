// BenchmarkEnabledDisabledWarm protects the request-path cost of the default memory backend.
func BenchmarkEnabledDisabledWarm(b *testing.B) {
	b.Setenv("APP_MAINTENANCE_ENABLED", "false")
	b.Setenv("APP_MAINTENANCE_DRIVER", "memory")
	state := newTestState(b)
	b.ReportAllocs()
	b.ResetTimer()
	for range b.N {
		_, _ = state.Enabled()
	}
}

// TestMemoryStateRoundTrip verifies the dependency-free default changes live process state.
func TestMemoryStateRoundTrip(t *testing.T) {
	t.Setenv("APP_MAINTENANCE_ENABLED", "false")
	t.Setenv("APP_MAINTENANCE_DRIVER", "memory")
	state := newTestState(t)
	if enabled, err := state.Enabled(); err != nil || enabled {
		t.Fatalf("initial Enabled() = %v, %v", enabled, err)
	}
	if err := state.Enable(); err != nil {
		t.Fatalf("Enable() error = %v", err)
	}
	if enabled, err := state.Enabled(); err != nil || !enabled {
		t.Fatalf("enabled Enabled() = %v, %v", enabled, err)
	}
	if err := state.Disable(); err != nil {
		t.Fatalf("Disable() error = %v", err)
	}
	if enabled, err := state.Enabled(); err != nil || enabled {
		t.Fatalf("disabled Enabled() = %v, %v", enabled, err)
	}
}

// TestMemoryEnabledDoesNotAllocate protects the disabled request path from hidden per-request work.
func TestMemoryEnabledDoesNotAllocate(t *testing.T) {
	t.Setenv("APP_MAINTENANCE_ENABLED", "false")
	t.Setenv("APP_MAINTENANCE_DRIVER", "memory")
	state := newTestState(t)
	if allocations := testing.AllocsPerRun(1000, func() {
		_, _ = state.Enabled()
	}); allocations != 0 {
		t.Fatalf("Enabled() allocations = %v, want 0", allocations)
	}
}

// TestEnvironmentOverrideRemainsAuthoritative verifies deployment policy cannot be cleared by a control request.
func TestEnvironmentOverrideRemainsAuthoritative(t *testing.T) {
	t.Setenv("APP_MAINTENANCE_DRIVER", "memory")
	t.Setenv("APP_MAINTENANCE_ENABLED", "true")
	state := newTestState(t)
	if err := state.Disable(); err != nil {
		t.Fatalf("Disable() error = %v", err)
	}
	if enabled, err := state.Enabled(); err != nil || !enabled {
		t.Fatalf("Enabled() = %v, %v", enabled, err)
	}
}

// TestMemoryStateSupportsConcurrentHTTPChecks verifies control requests and request checks do not race.
func TestMemoryStateSupportsConcurrentHTTPChecks(t *testing.T) {
	t.Setenv("APP_MAINTENANCE_DRIVER", "memory")
	t.Setenv("APP_MAINTENANCE_ENABLED", "false")
	state := newTestState(t)
	var group sync.WaitGroup
	for range 16 {
		group.Add(1)
		go func() {
			defer group.Done()
			for range 100 {
				_ = state.Enable()
				_, _ = state.Enabled()
				_ = state.Disable()
			}
		}()
	}
	group.Wait()
}

