// resetMaintenanceCacheForTest keeps package-global refresh state from crossing test working directories.
func resetMaintenanceCacheForTest(t *testing.T) {
	t.Helper()
	maintenanceCache.snapshot.Store(nil)
	t.Cleanup(func() { maintenanceCache.snapshot.Store(nil) })
}

// BenchmarkEnabledDisabledWarm tracks the per-request maintenance check when the generated default state is disabled and cached.
func BenchmarkEnabledDisabledWarm(b *testing.B) {
	b.Chdir(b.TempDir())
	b.Setenv("APP_MAINTENANCE_ENABLED", "false")
	b.Setenv("APP_RUNTIME_STATE_DIR", "./_data/runtime")
	b.Setenv("FORJ_APP", "app")
	maintenanceCache.snapshot.Store(nil)
	b.Cleanup(func() { maintenanceCache.snapshot.Store(nil) })
	if Enabled() {
		b.Fatal("maintenance unexpectedly enabled")
	}
	b.ReportAllocs()
	b.ResetTimer()
	for b.Loop() {
		Enabled()
	}
}

// TestMaintenanceStateRoundTrip verifies command-managed state is App-scoped, durable, and immediately observable.
func TestMaintenanceStateRoundTrip(t *testing.T) {
	resetMaintenanceCacheForTest(t)
	t.Chdir(t.TempDir())
	t.Setenv("APP_MAINTENANCE_ENABLED", "false")
	t.Setenv("FORJ_APP", "app")

	if Enabled() {
		t.Fatal("maintenance unexpectedly enabled")
	}
	if err := Enable(); err != nil {
		t.Fatalf("enable maintenance: %v", err)
	}
	if !Enabled() {
		t.Fatal("maintenance state was not observed")
	}
	info, err := os.Stat(filepath.Join("_data", "runtime", "app", "maintenance.json"))
	if err != nil {
		t.Fatalf("stat maintenance state: %v", err)
	}
	if info.Mode().Perm()&0o022 != 0 {
		t.Fatalf("maintenance state permissions = %o, want read-only outside the owner", info.Mode().Perm())
	}
	if err := Disable(); err != nil {
		t.Fatalf("disable maintenance: %v", err)
	}
	if Enabled() {
		t.Fatal("maintenance remained enabled")
	}
}

// TestMaintenanceDisabledWarmPathDoesNotAllocate protects the HTTP admission hot path from path or filesystem work.
func TestMaintenanceDisabledWarmPathDoesNotAllocate(t *testing.T) {
	resetMaintenanceCacheForTest(t)
	t.Setenv("APP_MAINTENANCE_ENABLED", "false")
	t.Setenv("APP_RUNTIME_STATE_DIR", t.TempDir())
	t.Setenv("FORJ_APP", "app")
	invalidateMaintenanceCache(false)
	var enabled bool
	allocations := testing.AllocsPerRun(1000, func() {
		enabled = Enabled()
	})
	if enabled {
		t.Fatal("maintenance unexpectedly enabled")
	}
	if allocations != 0 {
		t.Fatalf("warm disabled maintenance check allocations = %.2f, want 0", allocations)
	}
}

// TestMaintenanceEnablePreservesSharedDirectoryPermissions verifies operator-owned ACL and group modes are not rewritten.
func TestMaintenanceEnablePreservesSharedDirectoryPermissions(t *testing.T) {
	resetMaintenanceCacheForTest(t)
	if runtime.GOOS == "windows" {
		t.Skip("Windows ACLs are not represented by Unix permission bits")
	}
	root := t.TempDir()
	stateDir := filepath.Join(root, "app")
	if err := os.Mkdir(stateDir, 0o770); err != nil {
		t.Fatalf("create shared state directory: %v", err)
	}
	if err := os.Chmod(stateDir, 0o2770); err != nil {
		t.Fatalf("configure shared state directory: %v", err)
	}
	t.Setenv("APP_RUNTIME_STATE_DIR", root)
	t.Setenv("FORJ_APP", "app")
	t.Cleanup(func() { _ = Disable() })
	before, err := os.Stat(stateDir)
	if err != nil {
		t.Fatalf("stat shared state directory before enable: %v", err)
	}
	if err := Enable(); err != nil {
		t.Fatalf("enable maintenance: %v", err)
	}
	after, err := os.Stat(stateDir)
	if err != nil {
		t.Fatalf("stat shared state directory after enable: %v", err)
	}
	if after.Mode().Perm() != before.Mode().Perm() || after.Mode()&os.ModeSetgid != before.Mode()&os.ModeSetgid {
		t.Fatalf("shared state directory mode changed from %v to %v", before.Mode(), after.Mode())
	}
}

// TestMaintenanceEnableRejectsStateSymlinks verifies the marker cannot redirect command writes outside its App directory.
func TestMaintenanceEnableRejectsStateSymlinks(t *testing.T) {
	resetMaintenanceCacheForTest(t)
	if runtime.GOOS == "windows" {
		t.Skip("symlink creation requires environment-specific Windows privileges")
	}
	root := t.TempDir()
	target := t.TempDir()
	if err := os.Symlink(target, filepath.Join(root, "app")); err != nil {
		t.Fatalf("create state directory symlink: %v", err)
	}
	t.Setenv("APP_RUNTIME_STATE_DIR", root)
	t.Setenv("FORJ_APP", "app")
	if err := Enable(); err == nil {
		t.Fatal("enable followed a symlinked App state directory")
	}
}

// TestMaintenanceEnableIsConcurrentAndIdempotent verifies competing command processes converge on one valid marker.
func TestMaintenanceEnableIsConcurrentAndIdempotent(t *testing.T) {
	resetMaintenanceCacheForTest(t)
	t.Chdir(t.TempDir())
	t.Setenv("APP_MAINTENANCE_ENABLED", "false")
	t.Setenv("FORJ_APP", "app")
	t.Cleanup(func() { _ = Disable() })
	const callers = 8
	errors := make(chan error, callers)
	var group sync.WaitGroup
	for range callers {
		group.Add(1)
		go func() {
			defer group.Done()
			errors <- Enable()
		}()
	}
	group.Wait()
	close(errors)
	for err := range errors {
		if err != nil {
			t.Fatalf("concurrent enable: %v", err)
		}
	}
	if !Enabled() {
		t.Fatal("concurrent enable did not publish maintenance state")
	}
}

// TestMaintenanceStateReportsFilesystemFailures verifies commands surface unusable shared state storage.
func TestMaintenanceStateReportsFilesystemFailures(t *testing.T) {
	resetMaintenanceCacheForTest(t)
	root := t.TempDir()
	blockingPath := filepath.Join(root, "not-a-directory")
	if err := os.WriteFile(blockingPath, []byte("blocked"), 0o600); err != nil {
		t.Fatalf("write blocking file: %v", err)
	}
	t.Setenv("APP_RUNTIME_STATE_DIR", blockingPath)
	t.Setenv("FORJ_APP", "app")
	if err := Enable(); err == nil {
		t.Fatal("enable succeeded with an unusable shared state root")
	}

	marker := filepath.Join(root, "runtime", "app", "maintenance.json")
	if err := os.MkdirAll(filepath.Join(marker, "child"), 0o755); err != nil {
		t.Fatalf("create non-removable marker directory: %v", err)
	}
	t.Setenv("APP_RUNTIME_STATE_DIR", filepath.Join(root, "runtime"))
	if err := Disable(); err == nil {
		t.Fatal("disable succeeded with a non-removable marker directory")
	}
}

// TestMaintenancePathUsesConfiguredSharedRoot verifies split runtimes can coordinate from different working directories.
func TestMaintenancePathUsesConfiguredSharedRoot(t *testing.T) {
	resetMaintenanceCacheForTest(t)
	sharedRoot := filepath.Join(t.TempDir(), "runtime-state")
	t.Chdir(t.TempDir())
	t.Setenv("FORJ_APP", "app")
	t.Setenv("APP_RUNTIME_STATE_DIR", sharedRoot)
	if got := Path(); got != filepath.Join(sharedRoot, "app", "maintenance.json") {
		t.Fatalf("configured maintenance path = %q", got)
	}
}

// TestMaintenanceStateObservesExternalProcessWrites verifies split runtimes refresh shared filesystem state without a restart.
func TestMaintenanceStateObservesExternalProcessWrites(t *testing.T) {
	resetMaintenanceCacheForTest(t)
	t.Chdir(t.TempDir())
	t.Setenv("APP_MAINTENANCE_ENABLED", "false")
	t.Setenv("FORJ_APP", "app")
	if Enabled() {
		t.Fatal("maintenance unexpectedly enabled")
	}
	path := Path()
	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
		t.Fatalf("mkdir external state: %v", err)
	}
	if err := os.WriteFile(path, []byte("{}\n"), 0o600); err != nil {
		t.Fatalf("write external state: %v", err)
	}
	time.Sleep(maintenanceRefreshInterval + 10*time.Millisecond)
	if !Enabled() {
		t.Fatal("external maintenance state was not observed")
	}
	if err := os.Remove(path); err != nil {
		t.Fatalf("remove external state: %v", err)
	}
	time.Sleep(maintenanceRefreshInterval + 10*time.Millisecond)
	if Enabled() {
		t.Fatal("external maintenance removal was not observed")
	}
}

// TestMaintenanceEnvironmentForcesState verifies deployment configuration remains authoritative over local commands.
func TestMaintenanceEnvironmentForcesState(t *testing.T) {
	resetMaintenanceCacheForTest(t)
	t.Chdir(t.TempDir())
	t.Setenv("APP_MAINTENANCE_ENABLED", "true")
