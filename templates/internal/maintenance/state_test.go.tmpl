// TestMaintenancePathRejectsUnsafeAppIdentity verifies internal callers cannot turn process identity into a path traversal.
func TestMaintenancePathRejectsUnsafeAppIdentity(t *testing.T) {
	resetMaintenanceCacheForTest(t)
	t.Chdir(t.TempDir())
	for _, appName := range []string{"../outside", `..\\outside`, "/tmp/outside", "UPPER", "leading-", "-trailing"} {
		t.Run(appName, func(t *testing.T) {
			t.Setenv("FORJ_APP", appName)
			if got := Path(); got != filepath.Join("_data", "runtime", "app", "maintenance.json") {
				t.Fatalf("maintenance path for unknown App %q = %q", appName, got)
			}
		})
	}
}
