// TestCacheStateUsesGeneratedNamedStore verifies the maintenance store is selected through the cache manager.
func TestCacheStateUsesGeneratedNamedStore(t *testing.T) {
	t.Setenv("APP_MAINTENANCE_DRIVER", "cache")
	t.Setenv("APP_MAINTENANCE_STORE", "default")
	t.Setenv("CACHE_DRIVER", "memory")
	t.Setenv("APP_MAINTENANCE_ENABLED", "false")
	state := newTestState(t)
	if err := state.Enable(); err != nil {
		t.Fatalf("Enable() error = %v", err)
	}
	if enabled, err := state.Enabled(); err != nil || !enabled {
		t.Fatalf("Enabled() = %v, %v", enabled, err)
	}
	if err := state.Disable(); err != nil {
		t.Fatalf("Disable() error = %v", err)
	}
}

// TestCacheStateRejectsUnknownNamedStore prevents silent fallback to the default cache resource.
func TestCacheStateRejectsUnknownNamedStore(t *testing.T) {
	t.Setenv("APP_MAINTENANCE_DRIVER", "cache")
	t.Setenv("APP_MAINTENANCE_STORE", "missing")
	if _, err := NewState(); err == nil {
		t.Fatal("NewState() accepted unknown named store")
	}
}

// TestCacheStateSharesGeneratedStore verifies separate runtimes observe one configured cache backend.
func TestCacheStateSharesGeneratedStore(t *testing.T) {
	t.Setenv("APP_MAINTENANCE_DRIVER", "cache")
	t.Setenv("APP_MAINTENANCE_STORE", "default")
	t.Setenv("CACHE_DRIVER", "file")
	t.Setenv("CACHE_FILE_DIR", t.TempDir())
	t.Setenv("APP_MAINTENANCE_ENABLED", "false")
	first := newTestState(t)
	second := newTestState(t)
	if err := first.Enable(); err != nil {
		t.Fatalf("Enable() error = %v", err)
	}
	if enabled, err := second.Enabled(); err != nil || !enabled {
		t.Fatalf("second Enabled() = %v, %v", enabled, err)
	}
	if err := second.Disable(); err != nil {
		t.Fatalf("Disable() error = %v", err)
	}
}
