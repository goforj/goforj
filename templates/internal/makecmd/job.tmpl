package {{ .PackageName }}

import (
	"context"
	"encoding/json"
	"fmt"
	"{{.ModulePath}}/internal/queues"
	"github.com/goforj/queue"
)

// {{ .StructName }}TypeName identifies the job during dispatch and handler registration.
const {{ .StructName }}TypeName = "{{ .TaskName }}"

// {{ .StructName }}Payload is the payload for the {{ .StructName }} job.
type {{ .StructName }}Payload struct {
	// add your payload fields here
}

// {{ .StructName }} dispatches and handles its queue workflow.
type {{ .StructName }} struct {
	queues *queues.Manager
}

// New{{ .StructName }} constructs the job with the configured queue manager.
func New{{ .StructName }}(queues *queues.Manager) *{{ .StructName }} {
	return &{{ .StructName }}{queues: queues}
}

// Queue dispatches the typed payload to the selected queue.
func (t *{{ .StructName }}) Queue(ctx context.Context, payload {{ .StructName }}Payload) error {
	data, err := json.Marshal(payload)
	if err != nil {
		return err
	}
	_, err = t.queues.WithContext(ctx).Dispatch(
		queue.NewJob({{ .StructName }}TypeName).Payload(data).OnQueue({{ printf "%q" .QueueName }}),
		// queue.NewJob({{ .StructName }}TypeName).Payload(data).OnQueue({{ printf "%q" .QueueName }}).Timeout(1*time.Minute), // uncomment if you want to set a timeout
	)
	return err
}

// HandleTask processes queue payloads.
func (t *{{ .StructName }}) HandleTask(_ context.Context, msg queue.Message) error {
	var p {{ .StructName }}Payload
	if err := msg.Bind(&p); err != nil {
		return fmt.Errorf("json.Unmarshal failed: %w", err)
	}
	return nil
}
