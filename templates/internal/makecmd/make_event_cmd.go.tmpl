package makecmd

import (
	"bytes"
	_ "embed"
	"fmt"
	"go/format"
	"os"
	"path/filepath"
	"text/template"

	"github.com/goforj/str"

	"{{.GoModuleName}}/internal/console"
)

// EventCmd creates a typed event.
type EventCmd struct {
	Name          string `arg:"" help:"Name of the event (e.g. UserRegistered)"`
	OutputDir     string `short:"d" help:"Directory to write the event file to. Grouped names default to their owning package path." default:"./internal/events"`
	Remove        bool   `help:"Remove the generated event file instead of creating it."`
	DryRun        bool   `name:"dry-run" help:"Preview remove changes without writing files."`
	Open          bool   `short:"o" help:"Open the generated event in your editor."`
	NoOpen        bool   `name:"no-open" help:"Do not open the generated event, even when FORJ_MAKE_OPEN would."`
	MakeOpen      string `name:"make-open" env:"FORJ_MAKE_OPEN" default:"auto" hidden:""`
	EditorCommand string `name:"editor" env:"FORJ_EDITOR" hidden:""`
}

// defaultEventOutputDir is the fallback package for ungrouped events.
const defaultEventOutputDir = "./internal/events"

// NewEventCmd creates a new EventCmd.
func NewEventCmd() *EventCmd {
	return &EventCmd{}
}

// Signature defines CLI metadata for this command.
func (*EventCmd) Signature() string {
	return `name:"make:event" help:"Create a new event" goforj:"preboot"`
}

// Run executes the event generator.
func (c *EventCmd) Run() error {
	target := c.target()
	if c.Remove {
		return removeGeneratedFile(target.outputPath, c.DryRun)
	}
	if err := validateGeneratedFileOpenFlags(c.Open, c.NoOpen); err != nil {
		return err
	}

	if err := os.MkdirAll(filepath.Dir(target.outputPath), os.ModePerm); err != nil {
		return err
	}

	var buf bytes.Buffer
	tmpl := template.Must(template.New("event").Parse(string(eventTmpl)))
	if err := tmpl.Execute(&buf, map[string]string{
		"PackageName": generatedPackageName(c.OutputDir, "events"),
		"StructName":  target.structName,
		"TopicName":   str.Of(target.structName).ChopEnd("Event").ToLower().String(),
	}); err != nil {
		return err
	}

	formatted, err := format.Source(buf.Bytes())
	if err != nil {
		return fmt.Errorf("gofmt error: %w", err)
	}
	if err := os.WriteFile(target.outputPath, formatted, 0644); err != nil {
		return err
	}

	console.Successf("generated event %s", target.outputPath)
	return maybeOpenGeneratedFile(generatedFileOpenOptions{
		Path:          target.outputPath,
		Line:          1,
		Open:          c.Open,
		NoOpen:        c.NoOpen,
		Mode:          c.MakeOpen,
		EditorCommand: c.EditorCommand,
	})
}

type eventTarget struct {
	outputPath string
	structName string
}

func (c *EventCmd) target() eventTarget {
	rawName := str.Of(c.Name).TrimSpace().String()
	structBase := rawName
	parts := str.Of(rawName).Split(":")
	if len(parts) > 1 {
		action := str.Of(parts[len(parts)-1]).TrimSpace().String()
		if action != "" && isDefaultEventOutputDir(c.OutputDir) {
			if packageParts := generatedPackagePathParts(parts[:len(parts)-1]); len(packageParts) > 0 {
				c.OutputDir = filepath.Join(append([]string{".", "internal"}, packageParts...)...)
			}
		}
		structBase = action
	}

	structName := ensureEventSuffix(str.Of(structBase).Pascal().String())
	fileName := str.Of(structName).Snake("_").String() + ".go"
	outputPath := filepath.Join(c.OutputDir, fileName)

	return eventTarget{outputPath: outputPath, structName: structName}
}

// ensureEventSuffix appends Event when name does not already use that suffix.
func ensureEventSuffix(name string) string {
	clean := str.Of(name).TrimSpace()
	if clean.IsBlank() {
		return "ExampleEvent"
	}
	if clean.EndsWith("Event") {
		return clean.String()
	}
	return clean.String() + "Event"
}

// isDefaultEventOutputDir reports whether the user left the event output at its default.
func isDefaultEventOutputDir(outputDir string) bool {
	return filepath.Clean(outputDir) == filepath.Clean(defaultEventOutputDir)
}

// eventTmpl contains the generated event implementation template.
//
//go:embed event.tmpl
var eventTmpl []byte
