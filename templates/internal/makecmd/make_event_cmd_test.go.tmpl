package makecmd

import (
	"path/filepath"
	"testing"

	"github.com/goforj/str/v2"
)

func TestEnsureEventSuffix(t *testing.T) {
	if got := ensureEventSuffix("UserRegistered"); got != "UserRegisteredEvent" {
		t.Fatalf("expected UserRegisteredEvent, got %q", got)
	}
	if got := ensureEventSuffix("UserRegisteredEvent"); got != "UserRegisteredEvent" {
		t.Fatalf("expected suffix to remain unchanged, got %q", got)
	}
	if got := ensureEventSuffix(" "); got != "ExampleEvent" {
		t.Fatalf("expected fallback ExampleEvent, got %q", got)
	}
}

func TestSnakeCase(t *testing.T) {
	if got := str.Of("UserRegisteredEvent").Snake().String(); got != "user_registered_event" {
		t.Fatalf("unexpected snake_case value: %q", got)
	}
}

// TestGeneratedEventTopic verifies grouped names become dotted topics without changing ungrouped compatibility.
func TestGeneratedEventTopic(t *testing.T) {
	tests := []struct {
		name       string
		rawName    string
		structName string
		want       string
	}{
		{name: "ungrouped compatibility", rawName: "UserRegistered", structName: "UserRegisteredEvent", want: "userregistered"},
		{name: "grouped", rawName: "Billing:InvoicePaid", structName: "InvoicePaidEvent", want: "billing.invoice-paid"},
		{name: "nested group", rawName: "Billing:Invoices:PaymentFailed", structName: "PaymentFailedEvent", want: "billing.invoices.payment-failed"},
		{name: "invalid group falls back", rawName: "Billing:", structName: "BillingEvent", want: "billing"},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			if got := generatedEventTopic(tt.rawName, tt.structName); got != tt.want {
				t.Fatalf("generatedEventTopic(%q, %q) = %q, want %q", tt.rawName, tt.structName, got, tt.want)
			}
		})
	}
}

func TestEventCmdRemoveDeletesGeneratedFile(t *testing.T) {
	root := t.TempDir()
	t.Chdir(root)

	create := &EventCmd{Name: "Billing:InvoicePaid", OutputDir: defaultEventOutputDir}
	if err := create.Run(); err != nil {
		t.Fatalf("create event: %v", err)
	}

	outputPath := filepath.Join("internal", "billing", "invoice_paid_event.go")
	assertMakeCmdTestContains(t, outputPath, []string{
		"package billing",
		`const InvoicePaidEventTopic = "billing.invoice-paid"`,
		"type InvoicePaidEvent struct",
	})

	remove := &EventCmd{Name: "Billing:InvoicePaid", OutputDir: defaultEventOutputDir, Remove: true}
	if err := remove.Run(); err != nil {
		t.Fatalf("remove event: %v", err)
	}

	assertMakeCmdTestFileMissing(t, outputPath)
}
