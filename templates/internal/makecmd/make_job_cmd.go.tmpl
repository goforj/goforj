package makecmd

import (
	"bytes"
	_ "embed"
	"fmt"
	"github.com/goforj/str"
	"go/format"
	"os"
	"path/filepath"
	"regexp"
	"strings"
	"text/template"

	"{{.GoModuleName}}/internal/console"
)

// JobCmd generates a job type and wires it into the app.
type JobCmd struct {
	Name      string `arg:"" help:"Name of the job (e.g. ExampleHello)"`
	OutputDir string `short:"d" help:"Directory to write the job file to. Grouped names default to their owning package path." default:"./internal/jobs"`
}

const defaultJobOutputDir = "./internal/jobs"

// NewJobCmd creates the make:job generator command.
func NewJobCmd() *JobCmd {
	return &JobCmd{}
}

// Run generates the job file and updates job wiring.
func (c *JobCmd) Run() error {
	rawName := str.Of(c.Name).TrimSpace().String()
	structBase := rawName
	parts := str.Of(rawName).Split(":")
	if len(parts) > 1 {
		action := str.Of(parts[len(parts)-1]).TrimSpace().String()
		if action != "" && isDefaultJobOutputDir(c.OutputDir) {
			if packageParts := packagePartsFromName(parts[:len(parts)-1]); len(packageParts) > 0 {
				c.OutputDir = filepath.Join(append([]string{".", "internal"}, packageParts...)...)
			}
		}
		structBase = action
	}

	structName := ensureJobSuffix(str.Of(structBase).Pascal().String())
	fileName := str.Of(structName).Snake("_").String() + ".go"
	outputPath := filepath.Join(c.OutputDir, fileName)

	if err := c.writeJobFile(structName, outputPath); err != nil {
		return err
	}

	if err := c.injectIntoWireFile(structName); err != nil {
		return err
	}

	return nil
}

//go:embed job.tmpl
var jobTmpl []byte

// writeJobFile renders the job implementation into the jobs package.
func (c *JobCmd) writeJobFile(structName, outputPath string) error {
	if err := os.MkdirAll(filepath.Dir(outputPath), os.ModePerm); err != nil {
		return err
	}

	moduleName, err := getGoModuleName()
	if err != nil {
		return err
	}

	var buf bytes.Buffer
	tmpl := template.Must(template.New("job").Parse(string(jobTmpl)))
	err = tmpl.Execute(&buf, map[string]string{
		"PackageName": packageName(c.OutputDir),
		"StructName":  structName,
		"TaskName":    strings.ToLower(strings.TrimSuffix(structName, "Job")),
		"ModulePath":  moduleName,
	})
	if err != nil {
		return err
	}

	formatted, err := format.Source(buf.Bytes())
	if err != nil {
		return fmt.Errorf("gofmt error: %w", err)
	}

	if err := os.WriteFile(outputPath, formatted, 0644); err != nil {
		return err
	}

	console.Successf("generated job %s", outputPath)
	return nil
}

// injectIntoWireFile registers the generated job provider with the jobs wire set.
func (c *JobCmd) injectIntoWireFile(structName string) error {
	injectPath := "./wire/inject_jobs_app.go"

	moduleName, err := getGoModuleName()
	if err != nil {
		return err
	}

	pkgName := packageName(c.OutputDir)
	pkgRef := packageRef(c.OutputDir)
	relPath := strings.TrimPrefix(filepath.ToSlash(c.OutputDir), "./")
	importPath := fmt.Sprintf("%s/%s", moduleName, relPath)
	constructor := fmt.Sprintf("%s.New%s", pkgRef, structName)
	constructorLine := fmt.Sprintf("\t%s,", constructor)

	data, err := os.ReadFile(injectPath)
	if err != nil {
		return fmt.Errorf("reading inject_jobs_app.go: %w", err)
	}
	lines := strings.Split(string(data), "\n")

	lines = insertImportIfMissing(lines, importPath, importAliasForPackageRef(pkgName, pkgRef))

	// Inject into jobSet
	for i, line := range lines {
		if strings.HasPrefix(line, "var jobAppSet = wire.NewSet(") {
			closingIndex := -1
			for j := i + 1; j < len(lines); j++ {
				if strings.TrimSpace(lines[j]) == ")" {
					closingIndex = j
					break
				}
			}
			if closingIndex != -1 && !containsLine(lines, constructorLine) {
				lines = append(lines[:closingIndex], append([]string{constructorLine}, lines[closingIndex:]...)...)
			}
			break
		}
	}

	formatted, err := format.Source([]byte(strings.Join(lines, "\n")))
	if err != nil {
		return fmt.Errorf("gofmt error: %w", err)
	}
	if err := os.WriteFile(injectPath, formatted, 0644); err != nil {
		return fmt.Errorf("writing inject_jobs_app.go: %w", err)
	}

	console.Successf("injected into %s: %s", injectPath, constructor)

	return nil
}

// injectIntoWorker registers the generated job with the queue worker.
func (c *JobCmd) injectIntoWorker(structName string) error {
	workerPath := "./internal/jobs/worker.go"
	data, err := os.ReadFile(workerPath)
	if err != nil {
		return fmt.Errorf("reading worker.go: %w", err)
	}

	lines := strings.Split(string(data), "\n")

	baseName := str.Of(strings.TrimSuffix(structName, "Job")).Camel().String() // "some"
	fieldName := baseName                                                      // "some"
	paramName := baseName                                                      // "some"
	typeName := structName                                                     // "SomeJob"
	constName := structName + "TypeName"                                       // "SomeJobTypeName"

	fieldLine := fmt.Sprintf("\t%s *%s", fieldName, typeName)
	paramLine := fmt.Sprintf("\t%s *%s,", paramName, typeName)
	assignLine := fmt.Sprintf("\t\t%s: %s,", fieldName, paramName)
	handlerLine := fmt.Sprintf("\tmux.HandleFunc(%s, s.%s.Handle)", constName, fieldName)

	// Inject field into Worker struct
	if !containsStructField(lines, fieldName, typeName) {
		lines = insertBeforeClosingBrace(lines, "type Worker struct {", fieldLine)
	}

	// Inject param into NewWorker(...)
	if !containsFuncParam(lines, "NewWorker", paramName, typeName) {
		lines = insertIntoFuncParams(lines, "NewWorker", paramLine)
	}

	// Inject assignment into return &Worker{...}
	if !containsAssignment(lines, "return &Worker{", fieldName, paramName) {
		lines = insertBeforeClosingBrace(lines, "return &Worker{", assignLine)
	}

	// Inject mux.HandleFunc(...)
	if !containsHandler(lines, constName, fieldName) {
		lines = insertAfterLastHandleFunc(lines, handlerLine)
	}

	formatted, err := format.Source([]byte(strings.Join(lines, "\n")))
	if err != nil {
		return fmt.Errorf("gofmt error: %w", err)
	}
	if err := os.WriteFile(workerPath, formatted, 0644); err != nil {
		return fmt.Errorf("writing worker.go: %w", err)
	}

	console.Successf("injected into %s: %s", workerPath, structName)

	return nil
}

// ensureJobSuffix appends Job when name does not already use that suffix.
func ensureJobSuffix(name string) string {
	if !strings.HasSuffix(name, "Job") {
		return name + "Job"
	}
	return name
}

// isDefaultJobOutputDir reports whether the user left the job output at its default.
func isDefaultJobOutputDir(outputDir string) bool {
	return filepath.Clean(outputDir) == filepath.Clean(defaultJobOutputDir)
}

// packagePartsFromName converts grouped names into package path segments.
func packagePartsFromName(parts []string) []string {
	packageParts := make([]string, 0, len(parts))
	for _, part := range parts {
		clean := str.Of(part).TrimSpace().Snake("_").String()
		if clean == "" {
			continue
		}
		packageParts = append(packageParts, clean)
	}
	return packageParts
}

// packageName returns the Go package name for an output directory.
func packageName(outputDir string) string {
	name := str.Of(filepath.Base(outputDir)).Snake("_").String()
	if name == "" {
		return "jobs"
	}
	return name
}

// packageRef returns the import reference used for a generated job package.
func packageRef(outputDir string) string {
	rel := strings.TrimPrefix(filepath.ToSlash(filepath.Clean(outputDir)), "./")
	parts := strings.Split(rel, "/")
	if len(parts) > 1 && parts[0] == "internal" {
		parts = parts[1:]
	}
	if len(parts) == 0 {
		return packageName(outputDir)
	}

	var b strings.Builder
	for i, part := range parts {
		clean := str.Of(part).Snake("_").String()
		if clean == "" {
			continue
		}
		if i == 0 {
			b.WriteString(str.Of(clean).Camel().String())
			continue
		}
		b.WriteString(str.Of(clean).Pascal().String())
	}
	if b.Len() == 0 {
		return packageName(outputDir)
	}
	return b.String()
}

// importAliasForPackageRef returns an import alias when the package ref differs from the package name.
func importAliasForPackageRef(packageName, packageRef string) string {
	if packageName == packageRef {
		return ""
	}
	return packageRef
}

// getGoModuleName reads the module path from the current go.mod.
func getGoModuleName() (string, error) {
	data, err := os.ReadFile("go.mod")
	if err != nil {
		return "", err
	}
	for _, line := range strings.Split(string(data), "\n") {
		if strings.HasPrefix(line, "module ") {
			return strings.TrimSpace(strings.TrimPrefix(line, "module ")), nil
		}
	}
	return "", fmt.Errorf("module name not found in go.mod")
}

// insertImportIfMissing adds an import path with an optional alias.
func insertImportIfMissing(lines []string, importPath string, aliases ...string) []string {
	for _, line := range lines {
		if strings.Contains(line, importPath) {
			return lines
		}
	}

	alias := ""
	if len(aliases) > 0 {
		alias = strings.TrimSpace(aliases[0])
	}
	importLine := fmt.Sprintf("\t%q", importPath)
	if alias != "" {
		importLine = fmt.Sprintf("\t%s %q", alias, importPath)
	}
	for i, line := range lines {
		if strings.HasPrefix(strings.TrimSpace(line), "import (") {
			return append(lines[:i+1], append([]string{importLine}, lines[i+1:]...)...)
		}
	}
	return lines
}

// containsLine reports whether lines contain line after trimming whitespace.
func containsLine(lines []string, line string) bool {
	for _, l := range lines {
		if strings.TrimSpace(l) == strings.TrimSpace(line) {
			return true
		}
	}
	return false
}

// insertBeforeClosingBrace inserts a line before the first closing brace after a marker.
func insertBeforeClosingBrace(lines []string, structName string, insert string) []string {
	for i, line := range lines {
		if strings.Contains(line, structName) {
			for j := i + 1; j < len(lines); j++ {
				if strings.TrimSpace(lines[j]) == "}" {
					lines = append(lines[:j], append([]string{insert}, lines[j:]...)...)
					break
				}
			}
			break
		}
	}
	return lines
}

// insertIntoFuncParams inserts a parameter line before a function parameter list closes.
func insertIntoFuncParams(lines []string, funcName string, paramLine string) []string {
	for i, line := range lines {
		if strings.HasPrefix(strings.TrimSpace(line), "func "+funcName) && strings.Contains(line, "(") {
			for j := i; j < len(lines); j++ {
				if strings.Contains(lines[j], ")") {
					lines = append(lines[:j], append([]string{paramLine}, lines[j:]...)...)
					break
				}
			}
			break
		}
	}
	return lines
}

// insertAfterLine inserts a line immediately after the first line containing anchor.
func insertAfterLine(lines []string, anchor string, insert string) []string {
	for i, line := range lines {
		if strings.Contains(line, anchor) {
			lines = append(lines[:i+1], append([]string{insert}, lines[i+1:]...)...)
			break
		}
	}
	return lines
}

// containsField reports whether lines contain a pointer field with the given name and type.
func containsField(lines []string, field, typeName string) bool {
	pattern := fmt.Sprintf(`^\s*%s\s+\*%s\s*$`, regexp.QuoteMeta(field), regexp.QuoteMeta(typeName))
	re := regexp.MustCompile(pattern)

	for _, line := range lines {
		if re.MatchString(line) {
			return true
		}
	}
	return false
}

// containsStructField reports whether lines contain a pointer struct field.
func containsStructField(lines []string, field, typeName string) bool {
	pattern := fmt.Sprintf(`^\s*%s\s+\*%s\s*$`, regexp.QuoteMeta(field), regexp.QuoteMeta(typeName))
	return matchAnyLine(lines, pattern)
}

// containsFuncParam reports whether a function has a matching pointer parameter.
func containsFuncParam(lines []string, funcName, param, typeName string) bool {
	pattern := fmt.Sprintf(`^\s*%s\s+\*%s,?\s*$`, regexp.QuoteMeta(param), regexp.QuoteMeta(typeName))
	inFunc := false
	for _, line := range lines {
		if strings.Contains(line, fmt.Sprintf("func %s(", funcName)) {
			inFunc = true
		}
		if inFunc && strings.Contains(line, ")") {
			break
		}
		if inFunc && regexp.MustCompile(pattern).MatchString(line) {
			return true
		}
	}
	return false
}

// containsAssignment reports whether a struct literal assigns field from param.
func containsAssignment(lines []string, structInit string, field, param string) bool {
	pattern := fmt.Sprintf(`^\s*%s:\s*%s,\s*$`, regexp.QuoteMeta(field), regexp.QuoteMeta(param))
	inBlock := false
	for _, line := range lines {
		if strings.Contains(line, structInit) {
			inBlock = true
		}
		if inBlock && strings.TrimSpace(line) == "}" {
			break
		}
		if inBlock && regexp.MustCompile(pattern).MatchString(line) {
			return true
		}
	}
	return false
}

// containsHandler reports whether the worker already registers the job handler.
func containsHandler(lines []string, constName, field string) bool {
	pattern := fmt.Sprintf(`^\s*mux\.HandleFunc\(%s,\s*s\.%s\.Handle\)\s*$`, regexp.QuoteMeta(constName), regexp.QuoteMeta(field))
	return matchAnyLine(lines, pattern)
}

// matchAnyLine reports whether any line matches pattern.
func matchAnyLine(lines []string, pattern string) bool {
	re := regexp.MustCompile(pattern)
	for _, line := range lines {
		if re.MatchString(line) {
			return true
		}
	}
	return false
}

// insertAfterLastHandleFunc inserts a handler line after the last mux.HandleFunc call.
func insertAfterLastHandleFunc(lines []string, insert string) []string {
	lastIndex := -1
	for i, line := range lines {
		if strings.Contains(line, "mux.HandleFunc(") {
			lastIndex = i
		}
	}
	if lastIndex != -1 {
		lines = append(lines[:lastIndex+1], append([]string{insert}, lines[lastIndex+1:]...)...)
	}
	return lines
}
