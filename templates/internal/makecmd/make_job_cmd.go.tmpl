package makecmd

import (
	"bytes"
	_ "embed"
	"fmt"
	"github.com/goforj/str/v2"
	"go/format"
	"os"
	"path/filepath"
	"strings"
	"text/template"

	"{{.GoModuleName}}/internal/console"
)

// JobCmd generates a job type and wires it into the app.
type JobCmd struct {
	Name          string `arg:"" help:"Name of the job (e.g. ExampleHello)"`
	OutputDir     string `short:"d" help:"Directory to write the job file to. Grouped names default to their owning package path." default:"./internal/jobs"`
	Queue         string `name:"queue" short:"q" help:"Queue name used by the generated dispatch helper" default:"default"`
	Remove        bool   `help:"Remove the generated job file and wiring instead of creating it."`
	DryRun        bool   `name:"dry-run" help:"Preview remove changes without writing files."`
	Open          bool   `short:"o" help:"Open the generated job in your editor."`
	NoOpen        bool   `name:"no-open" help:"Do not open the generated job, even when FORJ_MAKE_OPEN would."`
	MakeOpen      string `name:"make-open" env:"FORJ_MAKE_OPEN" default:"auto" hidden:""`
	EditorCommand string `name:"editor" env:"FORJ_EDITOR" hidden:""`
}

// defaultJobOutputDir is the fallback package for ungrouped jobs.
const defaultJobOutputDir = "./internal/jobs"

// NewJobCmd creates the make:job generator command.
func NewJobCmd() *JobCmd {
	return &JobCmd{}
}

// Signature defines CLI metadata for this command.
func (*JobCmd) Signature() string {
	return `name:"make:job" help:"Create a new job" goforj:"preboot"`
}

// Run generates the job file and updates job wiring.
func (c *JobCmd) Run() error {
	target := c.target()
	if c.Remove {
		return c.remove(target)
	}
	if err := validateGeneratedFileOpenFlags(c.Open, c.NoOpen); err != nil {
		return err
	}

	if err := c.writeJobFile(target.structName, target.taskName, target.outputPath); err != nil {
		return err
	}

	if err := c.injectIntoWireFile(target.structName); err != nil {
		return err
	}

	return maybeOpenGeneratedFile(generatedFileOpenOptions{
		Path:          target.outputPath,
		Line:          1,
		Open:          c.Open,
		NoOpen:        c.NoOpen,
		Mode:          c.MakeOpen,
		EditorCommand: c.EditorCommand,
	})
}

type jobTarget struct {
	outputPath string
	structName string
	taskName   string
}

// target resolves one conventional identity so creation and removal address the same job files.
func (c *JobCmd) target() jobTarget {
	if str.Of(c.OutputDir).Trim().IsBlank() {
		c.OutputDir = defaultJobOutputDir
	}
	rawName := str.Of(c.Name).Trim().String()
	structBase := rawName
	parts := str.Of(rawName).Split(":")
	if len(parts) > 1 {
		action := str.Of(parts[len(parts)-1]).Trim().String()
		if action != "" && isDefaultJobOutputDir(c.OutputDir) {
			if packageParts := generatedPackagePathParts(parts[:len(parts)-1]); len(packageParts) > 0 {
				c.OutputDir = filepath.Join(append([]string{".", "internal"}, packageParts...)...)
			}
		}
		structBase = action
	}

	structName := ensureJobSuffix(str.Of(structBase).Pascal().String())
	fileName := str.Of(structName).Snake().String() + ".go"
	outputPath := filepath.Join(c.OutputDir, fileName)

	return jobTarget{
		outputPath: outputPath,
		structName: structName,
		taskName:   generatedJobTypeName(rawName, structName),
	}
}

// generatedJobTypeName preserves grouped names as stable operator-facing job identities.
func generatedJobTypeName(rawName string, structName string) string {
	parts := str.Of(rawName).Trim().Split(":")
	if len(parts) < 2 {
		return str.Of(structName).TrimSuffix("Job").ToLower().String()
	}

	names := make([]string, 0, len(parts))
	for _, part := range parts {
		name := str.Of(part).Trim().Kebab().ToLower().String()
		if name != "" {
			names = append(names, name)
		}
	}
	if len(names) < 2 {
		return str.Of(structName).TrimSuffix("Job").ToLower().String()
	}
	return strings.Join(names, ":")
}

// remove deletes the job and its App registration together so deleted types cannot remain wired.
func (c *JobCmd) remove(target jobTarget) error {
	if err := removeGeneratedFile(target.outputPath, c.DryRun); err != nil {
		return err
	}
	return c.removeFromWireFile(target.structName)
}

// jobTmpl contains the generated job implementation template.
//
//go:embed job.tmpl
var jobTmpl []byte

// writeJobFile renders the job implementation into the jobs package.
func (c *JobCmd) writeJobFile(structName, taskName, outputPath string) error {
	if err := os.MkdirAll(filepath.Dir(outputPath), os.ModePerm); err != nil {
		return err
	}

	moduleName, err := getGoModuleName()
	if err != nil {
		return err
	}

	var buf bytes.Buffer
	tmpl := template.Must(template.New("job").Parse(string(jobTmpl)))
	err = tmpl.Execute(&buf, map[string]string{
		"PackageName": generatedPackageName(c.OutputDir, "jobs"),
		"StructName":  structName,
		"TaskName":    taskName,
		"ModulePath":  moduleName,
		"QueueName":   c.queueName(),
	})
	if err != nil {
		return err
	}

	formatted, err := format.Source(buf.Bytes())
	if err != nil {
		return fmt.Errorf("gofmt error: %w", err)
	}

	if err := os.WriteFile(outputPath, formatted, 0644); err != nil {
		return err
	}

	console.Successf("generated job %s", outputPath)
	return nil
}

// injectIntoWireFile makes the generated job both constructible and reachable from App assembly.
func (c *JobCmd) injectIntoWireFile(structName string) error {
	injectPath := activeAppWireFile("inject_jobs_app.go", "./wire/inject_jobs_app.go")

	moduleName, err := getGoModuleName()
	if err != nil {
		return err
	}

	pkgName := generatedPackageName(c.OutputDir, "jobs")
	pkgRef := generatedPackageRef(c.OutputDir, "jobs")
	relPath := strings.TrimPrefix(filepath.ToSlash(c.OutputDir), "./")
	importPath := fmt.Sprintf("%s/%s", moduleName, relPath)
	constructor := fmt.Sprintf("%s.New%s", pkgRef, structName)
	constructorLine := fmt.Sprintf("\t%s,", constructor)
	paramName := str.Of(pkgRef).Camel().String() + structName
	typeRef := fmt.Sprintf("%s.%s", pkgRef, structName)
	paramLine := fmt.Sprintf("\t%s *%s,", paramName, typeRef)
	handlerLine := fmt.Sprintf("\tqueueManager.Register(%s.%sTypeName, %s.HandleTask)", pkgRef, structName, paramName)

	data, err := os.ReadFile(injectPath)
	if err != nil {
		return fmt.Errorf("reading inject_jobs_app.go: %w", err)
	}
	lines := strings.Split(string(data), "\n")

	lines = insertImportIfMissing(lines, importPath, importAliasForPackageRef(pkgName, pkgRef))

	lines = insertIntoCallBlock(lines, "var appJobSet = wire.NewSet(", constructorLine)
	if !containsLine(lines, paramLine) {
		lines = insertIntoFuncParams(lines, "registerJobHandlers", paramLine)
		if !containsLine(lines, paramLine) {
			return fmt.Errorf("inject_jobs_app.go has no writable registerJobHandlers parameter boundary")
		}
	}
	if !containsLine(lines, handlerLine) {
		var inserted bool
		lines, inserted = insertJobHandlerRegistration(lines, handlerLine)
		if !inserted {
			return fmt.Errorf("inject_jobs_app.go is missing the registerJobHandlers boundary")
		}
	}

	formatted, err := format.Source([]byte(strings.Join(lines, "\n")))
	if err != nil {
		return fmt.Errorf("gofmt error: %w", err)
	}
	if err := os.WriteFile(injectPath, formatted, 0644); err != nil {
		return fmt.Errorf("writing inject_jobs_app.go: %w", err)
	}

	console.Successf("injected into %s: %s", injectPath, constructor)

	return nil
}

// removeFromWireFile removes constructor and handler registration as one App-owned unit.
func (c *JobCmd) removeFromWireFile(structName string) error {
	injectPath := activeAppWireFile("inject_jobs_app.go", "./wire/inject_jobs_app.go")

	moduleName, err := getGoModuleName()
	if err != nil {
		return err
	}

	pkgRef := generatedPackageRef(c.OutputDir, "jobs")
	relPath := strings.TrimPrefix(filepath.ToSlash(c.OutputDir), "./")
	importPath := fmt.Sprintf("%s/%s", moduleName, relPath)
	constructor := fmt.Sprintf("%s.New%s", pkgRef, structName)
	constructorLine := fmt.Sprintf("\t%s,", constructor)
	paramName := str.Of(pkgRef).Camel().String() + structName
	typeRef := fmt.Sprintf("%s.%s", pkgRef, structName)
	paramLine := fmt.Sprintf("\t%s *%s,", paramName, typeRef)
	handlerLine := fmt.Sprintf("\tqueueManager.Register(%s.%sTypeName, %s.HandleTask)", pkgRef, structName, paramName)

	lines, _, err := readGeneratorGoFile(injectPath)
	if err != nil {
		return fmt.Errorf("reading inject_jobs_app.go: %w", err)
	}
	original := append([]string{}, lines...)
	lines, removedConstructor := removeExactLine(lines, constructorLine)
	lines, removedParam := removeExactLine(lines, paramLine)
	lines, removedHandler := removeExactLine(lines, handlerLine)
	removed := removedConstructor || removedParam || removedHandler
	lines = removeGoImportIfUnused(lines, importPath, pkgRef+".")

	changed, err := writeGeneratorGoLinesIfChanged(injectPath, original, lines, c.DryRun)
	if err != nil {
		return err
	}
	if removed {
		if c.DryRun {
			console.Infof("Would remove %s from %s", strings.TrimSpace(constructorLine), injectPath)
		} else {
			console.Successf("Removed %s from %s", strings.TrimSpace(constructorLine), injectPath)
		}
	} else if !changed {
		console.Infof("No matching job wiring found in %s", injectPath)
	}
	return nil
}

// insertJobHandlerRegistration preserves one stable generator seam without rewriting framework-owned worker code.
func insertJobHandlerRegistration(lines []string, handlerLine string) ([]string, bool) {
	for i, line := range lines {
		if strings.TrimSpace(line) == "return &jobHandlerRegistration{}" {
			return append(lines[:i], append([]string{handlerLine}, lines[i:]...)...), true
		}
	}
	return lines, false
}

// ensureJobSuffix appends Job when name does not already use that suffix.
func ensureJobSuffix(name string) string {
	clean := str.Of(name).Trim()
	if clean.IsBlank() {
		return "ExampleJob"
	}
	if clean.HasSuffix("Job") {
		return clean.String()
	}
	return clean.String() + "Job"
}

// isDefaultJobOutputDir reports whether the user left the job output at its default.
func isDefaultJobOutputDir(outputDir string) bool {
	return filepath.Clean(outputDir) == filepath.Clean(defaultJobOutputDir)
}

// queueName returns the queue name stamped into generated dispatch helpers.
func (c *JobCmd) queueName() string {
	queueName := str.Of(c.Queue).Trim()
	if queueName.IsBlank() {
		return "default"
	}
	return queueName.String()
}
