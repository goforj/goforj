package makecmd

import (
	"os"
	"path/filepath"
	"strings"
	"testing"
)

func TestJobCmdStampsQueueName(t *testing.T) {
	root := t.TempDir()
	t.Chdir(root)

	if err := os.WriteFile("go.mod", []byte("module example.com/testapp\n\ngo 1.24\n"), 0644); err != nil {
		t.Fatalf("write go.mod: %v", err)
	}
	if err := os.MkdirAll("wire", 0755); err != nil {
		t.Fatalf("mkdir wire: %v", err)
	}
	if err := os.WriteFile(filepath.Join("wire", "inject_jobs_app.go"), []byte(`package wire

import "github.com/goforj/wire"

var appJobSet = wire.NewSet(
)
`), 0644); err != nil {
		t.Fatalf("write inject_jobs_app.go: %v", err)
	}

	cmd := &JobCmd{Name: "GenerateReport", Queue: "reports"}
	if err := cmd.Run(); err != nil {
		t.Fatalf("JobCmd.Run returned error: %v", err)
	}

	body, err := os.ReadFile(filepath.Join("internal", "jobs", "generate_report_job.go"))
	if err != nil {
		t.Fatalf("read generated job: %v", err)
	}
	if !strings.Contains(string(body), `.OnQueue("reports")`) {
		t.Fatalf("expected generated job to dispatch on reports queue, got:\n%s", string(body))
	}
}

func TestJobCmdRemoveDeletesFileAndWiring(t *testing.T) {
	root := t.TempDir()
	t.Chdir(root)

	writeMakeCmdTestFile(t, "go.mod", "module example.com/testapp\n\ngo 1.24\n")
	writeMakeCmdTestFile(t, filepath.Join("wire", "inject_jobs_app.go"), `package wire

import "github.com/goforj/wire"

var appJobSet = wire.NewSet(
)
`)

	create := &JobCmd{Name: "Reports:Generate", Queue: "reports"}
	if err := create.Run(); err != nil {
		t.Fatalf("create job: %v", err)
	}

	outputPath := filepath.Join("internal", "reports", "generate_job.go")
	assertMakeCmdTestContains(t, outputPath, []string{
		"package reports",
		"type GenerateJob struct",
		`.OnQueue("reports")`,
	})
	assertMakeCmdTestContains(t, filepath.Join("wire", "inject_jobs_app.go"), []string{
		`"example.com/testapp/internal/reports"`,
		"reports.NewGenerateJob",
	})

	remove := &JobCmd{Name: "Reports:Generate", Remove: true}
	if err := remove.Run(); err != nil {
		t.Fatalf("remove job: %v", err)
	}

	assertMakeCmdTestFileMissing(t, outputPath)
	assertMakeCmdTestNotContains(t, filepath.Join("wire", "inject_jobs_app.go"), []string{
		`"example.com/testapp/internal/reports"`,
		"reports.NewGenerateJob",
	})
}

func TestJobCmdUsesActiveAppTarget(t *testing.T) {
	root := t.TempDir()
	t.Chdir(root)
	t.Setenv("FORJ_APP_TARGET", "reporting")

	writeMakeCmdTestFile(t, "go.mod", "module example.com/testapp\n\ngo 1.24\n")
	writeMakeCmdTestFile(t, filepath.Join("app", "wire", "inject_jobs_app.go"), `package wire

import "github.com/goforj/wire"

var appJobSet = wire.NewSet(
)
`)
	writeMakeCmdTestFile(t, filepath.Join("app", "reporting", "wire", "inject_jobs_app.go"), `package wire

import "github.com/goforj/wire"

var appJobSet = wire.NewSet(
)
`)

	cmd := &JobCmd{Name: "Reports:Generate", Queue: "reports"}
	if err := cmd.Run(); err != nil {
		t.Fatalf("create targeted job: %v", err)
	}

	assertMakeCmdTestContains(t, filepath.Join("app", "reporting", "wire", "inject_jobs_app.go"), []string{
		`"example.com/testapp/internal/reports"`,
		"reports.NewGenerateJob",
	})
	assertMakeCmdTestNotContains(t, filepath.Join("app", "wire", "inject_jobs_app.go"), []string{
		`"example.com/testapp/internal/reports"`,
		"reports.NewGenerateJob",
	})
}
