package makecmd

import (
	"os"
	"path/filepath"
	"testing"
)

// writeTempConfig writes config content and returns the file path.
func writeTempConfig(t *testing.T, content string) string {
	t.Helper()
	dir := t.TempDir()
	path := filepath.Join(dir, ".db-relationships.yaml")
	if err := os.WriteFile(path, []byte(content), 0644); err != nil {
		t.Fatalf("write config: %v", err)
	}
	return path
}

func TestParseRelationshipConfigInvalidArrow(t *testing.T) {
	path := writeTempConfig(t, "posts:\n  - \"1-many id posts:user_id\"\n")
	cmd := &ModelCmd{Config: path}
	if _, err := cmd.parseRelationshipConfig(); err == nil {
		t.Fatalf("expected invalid arrow error")
	}
}

func TestParseRelationshipConfigInvalidPolyKeys(t *testing.T) {
	path := writeTempConfig(t, "posts:\n  - \"poly commentable_id->comments:id as Commentable\"\n")
	cmd := &ModelCmd{Config: path}
	if _, err := cmd.parseRelationshipConfig(); err == nil {
		t.Fatalf("expected invalid polymorphic keys error")
	}
}

func TestParseRelationshipConfigInvalidVia(t *testing.T) {
	path := writeTempConfig(t, "users:\n  - \"many-many id->roles:id via user_roles\"\n")
	cmd := &ModelCmd{Config: path}
	if _, err := cmd.parseRelationshipConfig(); err == nil {
		t.Fatalf("expected invalid join clause error")
	}
}

func TestModelPackageNamesUseCompactLowercaseSegments(t *testing.T) {
	cmd := &ModelCmd{Package: "BillingPortal"}
	if got := cmd.outputDir(); got != filepath.Join("internal", "billingportal") {
		t.Fatalf("model output dir = %q, want internal/billingportal", got)
	}
	if got := cmd.packageName(); got != "billingportal" {
		t.Fatalf("model package name = %q, want billingportal", got)
	}
}

func TestModelCmdRemoveDeletesFileAndRepositoryWiring(t *testing.T) {
	root := t.TempDir()
	t.Chdir(root)

	writeMakeCmdTestFile(t, "go.mod", "module example.com/testapp\n\ngo 1.24\n")
	writeMakeCmdTestFile(t, filepath.Join("internal", "models", "widget.go"), `package models

type Widget struct{}

func NewWidgetRepo() *WidgetRepo {
	return &WidgetRepo{}
}

type WidgetRepo struct{}
`)
	if err := writeRepositorySetFile(filepath.Join("wire", "inject_repositories_app.go"), map[string]string{
		"github.com/goforj/wire":              "",
		"example.com/testapp/internal/models": "",
	}, []string{"models.NewWidgetRepo"}, true); err != nil {
		t.Fatalf("write repository set: %v", err)
	}

	cmd := &ModelCmd{Table: "widgets", Output: "./internal/models", Remove: true}
	if err := cmd.remove(); err != nil {
		t.Fatalf("remove model: %v", err)
	}

	assertMakeCmdTestFileMissing(t, filepath.Join("internal", "models", "widget.go"))
	assertMakeCmdTestNotContains(t, filepath.Join("wire", "inject_repositories_app.go"), []string{
		`"example.com/testapp/internal/models"`,
		"models.NewWidgetRepo",
	})
}
