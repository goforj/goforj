// TestQueueCmdRequiresName verifies non-interactive missing input fails with a clean example.
func TestQueueCmdRequiresName(t *testing.T) {
	err := (&QueueCmd{Workers: 6}).Run()
	if err == nil {
		t.Fatal("expected missing queue name error")
	}
	message := err.Error()
	if !strings.Contains(message, "missing queue name") {
		t.Fatalf("expected missing queue name error, got %q", message)
	}
	if !strings.Contains(message, "example:") || !strings.Contains(message, "make:queue emails --workers 6") {
		t.Fatalf("expected example in missing queue name error, got %q", message)
	}
}

// TestQueueCmdRequiresWorkers verifies direct mode requires an explicit worker allocation.
func TestQueueCmdRequiresWorkers(t *testing.T) {
	err := (&QueueCmd{Name: "emails"}).Run()
	if err == nil {
		t.Fatal("expected missing workers error")
	}
	if !strings.Contains(err.Error(), "missing workers") {
		t.Fatalf("expected missing workers error, got %q", err.Error())
	}
}

// TestQueueResourceWizardRendersPanel verifies resource makers use the compact wizard panel.
func TestQueueResourceWizardRendersPanel(t *testing.T) {
	t.Setenv("NO_COLOR", "1")

	model := newResourceWizardModel(queueResourceMaker(".env"), ResourceInput{})
	view := model.View()
	for _, snippet := range []string{
		"┌ Resource name",
		"App-facing queue identifier",
		"Example: emails.",
		"│ ›",
		"└",
		"›",
		"Enter to continue",
	} {
		if !strings.Contains(view, snippet) {
			t.Fatalf("expected wizard view to contain %q, got:\n%s", snippet, view)
		}
	}
	for _, snippet := range []string{
		"Workers",
		"Backend queue name",
	} {
		if strings.Contains(view, snippet) {
			t.Fatalf("expected initial wizard view not to contain pending field %q, got:\n%s", snippet, view)
		}
	}
	if strings.Contains(view, "Queue resource name:") {
		t.Fatalf("expected boxed wizard instead of raw prompt, got:\n%s", view)
	}
}

// writeQueueEnv writes test env content.
func writeQueueEnv(t *testing.T, path string, content string) {
	t.Helper()
	if err := os.WriteFile(filepath.Clean(path), []byte(content), 0644); err != nil {
		t.Fatalf("write env: %v", err)
	}
}

// readQueueEnv reads test env content.
func readQueueEnv(t *testing.T, path string) string {
	t.Helper()
	data, err := os.ReadFile(filepath.Clean(path))
	if err != nil {
		t.Fatalf("read env: %v", err)
	}
	return string(data)
}

// assertQueueEnvContains verifies env content contains all snippets.
func assertQueueEnvContains(t *testing.T, path string, snippets []string) {
	t.Helper()
	content := readQueueEnv(t, path)
	for _, snippet := range snippets {
		if !strings.Contains(content, snippet) {
			t.Fatalf("expected %s to contain %q, got:\n%s", path, snippet, content)
		}
	}
}

// assertQueueEnvNotContains verifies env content does not contain any snippet.
func assertQueueEnvNotContains(t *testing.T, path string, snippets []string) {
	t.Helper()
	content := readQueueEnv(t, path)
	for _, snippet := range snippets {
		if strings.Contains(content, snippet) {
			t.Fatalf("expected %s not to contain %q, got:\n%s", path, snippet, content)
		}
	}
}
