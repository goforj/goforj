// TestQueueCmdConfiguresNamedQueue verifies direct queue creation updates the queue env section.
func TestQueueCmdConfiguresNamedQueue(t *testing.T) {
	dir := t.TempDir()
	t.Chdir(dir)
	writeQueueEnv(t, `.env`, `APP_NAME=test

# Queue
QUEUE_DRIVER=redis
QUEUE_SUPPORTED_DRIVERS=redis
QUEUE_WORKERS=30
QUEUE_NAME=default
QUEUE_SERVER_LOG_LEVEL=error
QUEUE_SHUTDOWN_TIMEOUT=10s
# Named queues can prioritize work by allocating workers:
# QUEUE_EMAILS_NAME=emails
# QUEUE_EMAILS_WORKERS=6
# QUEUE_REPORTS_NAME=reports
# QUEUE_REPORTS_WORKERS=2
`)

	cmd := &QueueCmd{Name: "emails", Workers: 6}
	if err := cmd.Run(); err != nil {
		t.Fatalf("QueueCmd.Run returned error: %v", err)
	}

	assertQueueEnvContains(t, `.env`, []string{
		"QUEUE_EMAILS_NAME=emails",
		"QUEUE_EMAILS_WORKERS=6",
		"# QUEUE_REPORTS_NAME=reports",
	})
	assertQueueEnvNotContains(t, `.env`, []string{
		"# QUEUE_EMAILS_NAME=emails",
		"# QUEUE_EMAILS_WORKERS=6",
		"QUEUE_QUEUES",
	})
}

// TestQueueCmdConfiguresBackendOverride verifies backend names can differ from resource names.
func TestQueueCmdConfiguresBackendOverride(t *testing.T) {
	dir := t.TempDir()
	t.Chdir(dir)
	writeQueueEnv(t, `.env`, `# Queue
QUEUE_DRIVER=redis
# Named queues can prioritize work by allocating workers:
`)

	cmd := &QueueCmd{Name: "reports", Workers: 2, BackendName: "production-report-jobs"}
	if err := cmd.Run(); err != nil {
		t.Fatalf("QueueCmd.Run returned error: %v", err)
	}

	assertQueueEnvContains(t, `.env`, []string{
		"QUEUE_REPORTS_NAME=production-report-jobs",
		"QUEUE_REPORTS_WORKERS=2",
	})
}

// TestQueueCmdPreservesSectionSpacingWithoutAnchor verifies compact env files keep their next section separated.
func TestQueueCmdPreservesSectionSpacingWithoutAnchor(t *testing.T) {
	dir := t.TempDir()
	t.Chdir(dir)
	writeQueueEnv(t, `.env`, `# Queue
# Available drivers: null,sync,workerpool,redis,nats,sqs,rabbitmq,sqlite,postgres,mysql
QUEUE_DRIVER=workerpool
QUEUE_SUPPORTED_DRIVERS=workerpool,redis
QUEUE_WORKERS=30
QUEUE_SHUTDOWN_TIMEOUT=10s

# Runtime
SCHEDULER_SUBPROCESS_SHUTDOWN_TIMEOUT=
`)

	cmd := &QueueCmd{Name: "reports", Workers: 2}
	if err := cmd.Run(); err != nil {
		t.Fatalf("QueueCmd.Run returned error: %v", err)
	}

	content := readQueueEnv(t, `.env`)
	want := "QUEUE_SHUTDOWN_TIMEOUT=10s\nQUEUE_REPORTS_NAME=reports\nQUEUE_REPORTS_WORKERS=2\n\n# Runtime"
	if !strings.Contains(content, want) {
		t.Fatalf("expected named queue before the section separator:\n%s", content)
	}
}

// TestQueueCmdInsertsAfterNamedQueueExamples verifies new queues do not split the anchor from examples.
func TestQueueCmdInsertsAfterNamedQueueExamples(t *testing.T) {
	dir := t.TempDir()
	t.Chdir(dir)
	writeQueueEnv(t, `.env`, `# Queue
QUEUE_DRIVER=redis
QUEUE_SUPPORTED_DRIVERS=redis
QUEUE_WORKERS=30
QUEUE_NAME=default
QUEUE_SERVER_LOG_LEVEL=error
QUEUE_SHUTDOWN_TIMEOUT=10s
# Named queues can prioritize work by allocating workers:
# QUEUE_EMAILS_NAME=emails
# QUEUE_EMAILS_WORKERS=6
# QUEUE_REPORTS_NAME=reports
# QUEUE_REPORTS_WORKERS=2
METRICS_JOBS_PORT=9101
`)

	cmd := &QueueCmd{Name: "report-processing", Workers: 30}
	if err := cmd.Run(); err != nil {
		t.Fatalf("QueueCmd.Run returned error: %v", err)
	}

	content := readQueueEnv(t, `.env`)
	assertQueueEnvContains(t, `.env`, []string{
		"# QUEUE_REPORTS_WORKERS=2\nQUEUE_REPORT_PROCESSING_NAME=report-processing",
		"QUEUE_REPORT_PROCESSING_WORKERS=30\nMETRICS_JOBS_PORT=9101",
	})
	if strings.Contains(content, "# Named queues can prioritize work by allocating workers:\nQUEUE_REPORT_PROCESSING_NAME") {
		t.Fatalf("expected queue config after examples, got:\n%s", content)
	}
}

// TestQueueCmdUpdatesExistingValues verifies repeated runs update instead of duplicating keys.
func TestQueueCmdUpdatesExistingValues(t *testing.T) {
	dir := t.TempDir()
	t.Chdir(dir)
	writeQueueEnv(t, `.env`, `# Queue
QUEUE_EMAILS_NAME=emails
QUEUE_EMAILS_WORKERS=4
`)

	cmd := &QueueCmd{Name: "emails", Workers: 8}
	if err := cmd.Run(); err != nil {
		t.Fatalf("QueueCmd.Run returned error: %v", err)
	}

	content := readQueueEnv(t, `.env`)
	if strings.Count(content, "QUEUE_EMAILS_WORKERS=") != 1 {
		t.Fatalf("expected one workers key, got:\n%s", content)
	}
	assertQueueEnvContains(t, `.env`, []string{
		"QUEUE_EMAILS_NAME=emails",
		"QUEUE_EMAILS_WORKERS=8",
	})
}

// TestQueueCmdRemoveDeletesQueueEnvKeys verifies removal only deletes generated concrete keys.
func TestQueueCmdRemoveDeletesQueueEnvKeys(t *testing.T) {
	dir := t.TempDir()
	t.Chdir(dir)
	writeQueueEnv(t, `.env`, `# Queue
# Named queues can prioritize work by allocating workers:
# QUEUE_EMAILS_NAME=emails
# QUEUE_EMAILS_WORKERS=6
QUEUE_EMAILS_NAME=emails
QUEUE_EMAILS_WORKERS=8
QUEUE_REPORTS_NAME=reports
QUEUE_REPORTS_WORKERS=2
`)

	cmd := &QueueCmd{Name: "emails", Remove: true}
	if err := cmd.Run(); err != nil {
		t.Fatalf("QueueCmd.Run returned error: %v", err)
	}

	assertQueueEnvContains(t, `.env`, []string{
		"# QUEUE_EMAILS_NAME=emails",
		"# QUEUE_EMAILS_WORKERS=6",
		"QUEUE_REPORTS_NAME=reports",
		"QUEUE_REPORTS_WORKERS=2",
	})
	assertQueueEnvNotContains(t, `.env`, []string{
		"\nQUEUE_EMAILS_NAME=emails",
		"\nQUEUE_EMAILS_WORKERS=8",
	})
}

