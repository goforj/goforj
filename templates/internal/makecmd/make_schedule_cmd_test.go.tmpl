package makecmd

import (
	"os"
	"path/filepath"
	"strings"
	"testing"
)

func TestScheduleCmdGeneratesAndWiresSchedule(t *testing.T) {
	root := t.TempDir()
	t.Chdir(root)

	if err := os.WriteFile("go.mod", []byte("module example.com/testapp\n\ngo 1.24\n"), 0644); err != nil {
		t.Fatalf("write go.mod: %v", err)
	}
	if err := os.MkdirAll("wire", 0755); err != nil {
		t.Fatalf("mkdir wire: %v", err)
	}
	if err := os.WriteFile(filepath.Join("wire", "inject_scheduler_schedules.go"), []byte(`package wire

import (
	"github.com/google/wire"
	"example.com/testapp/internal/schedules"
)

var schedulerScheduleSet = wire.NewSet(
	ProvideAppSchedules,
)

func ProvideAppSchedules() *schedules.AppSchedules {
	return schedules.NewAppSchedules(
	)
}
`), 0644); err != nil {
		t.Fatalf("write inject_scheduler_schedules.go: %v", err)
	}
	cmd := &ScheduleCmd{Name: "Reports:Daily", Every: "24h"}
	if err := cmd.Run(); err != nil {
		t.Fatalf("ScheduleCmd.Run returned error: %v", err)
	}

	body := readScheduleTestFile(t, filepath.Join("internal", "reports", "daily_schedule.go"))
	assertScheduleTestContains(t, body, []string{
		"package reports",
		"// Generated by `forj make:schedule`. Edit this App-owned schedule.",
		`const DailyScheduleName = "reports:daily"`,
		`const DailyScheduleInterval = "24h"`,
		"func (s *DailySchedule) Name() string",
		"func (s *DailySchedule) Interval() (time.Duration, error)",
	})
	if strings.Contains(body, "schedulerx") || strings.Contains(body, "github.com/goforj/scheduler") {
		t.Fatalf("expected generated app schedule not to import scheduler package, got:\n%s", body)
	}

	wireBody := readScheduleTestFile(t, filepath.Join("wire", "inject_scheduler_schedules.go"))
	assertScheduleTestContains(t, wireBody, []string{
		`"example.com/testapp/internal/reports"`,
		"reports.NewDailySchedule",
		"dailySchedule *reports.DailySchedule",
		"return schedules.NewAppSchedules(",
		"dailySchedule,",
	})
}

func TestScheduleCmdRemoveDeletesFileAndWiring(t *testing.T) {
	root := t.TempDir()
	t.Chdir(root)

	writeMakeCmdTestFile(t, "go.mod", "module example.com/testapp\n\ngo 1.24\n")
	writeMakeCmdTestFile(t, filepath.Join("wire", "inject_scheduler_schedules.go"), `package wire

import (
	"github.com/google/wire"
	"example.com/testapp/internal/schedules"
)

var schedulerScheduleSet = wire.NewSet(
	ProvideAppSchedules,
)

func ProvideAppSchedules(
) *schedules.AppSchedules {
	return schedules.NewAppSchedules(
	)
}
`)

	create := &ScheduleCmd{Name: "Reports:Daily", Every: "24h"}
	if err := create.Run(); err != nil {
		t.Fatalf("create schedule: %v", err)
	}

	outputPath := filepath.Join("internal", "reports", "daily_schedule.go")
	assertMakeCmdTestContains(t, outputPath, []string{
		"package reports",
		"type DailySchedule struct",
	})
	assertMakeCmdTestContains(t, filepath.Join("wire", "inject_scheduler_schedules.go"), []string{
		`"example.com/testapp/internal/reports"`,
		"reports.NewDailySchedule",
		"dailySchedule *reports.DailySchedule",
		"dailySchedule,",
	})

	remove := &ScheduleCmd{Name: "Reports:Daily", Every: "24h", Remove: true}
	if err := remove.Run(); err != nil {
		t.Fatalf("remove schedule: %v", err)
	}

	assertMakeCmdTestFileMissing(t, outputPath)
	assertMakeCmdTestNotContains(t, filepath.Join("wire", "inject_scheduler_schedules.go"), []string{
		`"example.com/testapp/internal/reports"`,
		"reports.NewDailySchedule",
		"dailySchedule *reports.DailySchedule",
		"dailySchedule,",
	})
}

// readScheduleTestFile reads a generated schedule test fixture file.
func readScheduleTestFile(t *testing.T, path string) string {
	t.Helper()
	body, err := os.ReadFile(path)
	if err != nil {
		t.Fatalf("read %s: %v", path, err)
	}
	return string(body)
}

// assertScheduleTestContains verifies expected snippets in generated schedule output.
func assertScheduleTestContains(t *testing.T, body string, needles []string) {
	t.Helper()
	for _, needle := range needles {
		if !strings.Contains(body, needle) {
			t.Fatalf("expected generated content to contain %q, got:\n%s", needle, body)
		}
	}
}
