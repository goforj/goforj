// SubscriberCmd generates an event subscriber and wires it into the app event buses.
type SubscriberCmd struct {
	Name          string `arg:"" help:"Name of the subscriber event (e.g. Billing:InvoicePaid)"`
	OutputDir     string `short:"d" help:"Directory to write the subscriber file to. Grouped names default to their owning package path." default:"./internal/events"`
	Bus           string `name:"bus" help:"Event bus to subscribe on. Defaults to the default bus." default:"default"`
	Remove        bool   `help:"Remove the generated subscriber file and wiring instead of creating it."`
	DryRun        bool   `name:"dry-run" help:"Preview remove changes without writing files."`
	Open          bool   `short:"o" help:"Open the generated subscriber in your editor."`
	NoOpen        bool   `name:"no-open" help:"Do not open the generated subscriber, even when FORJ_MAKE_OPEN would."`
	MakeOpen      string `name:"make-open" env:"FORJ_MAKE_OPEN" default:"auto" hidden:""`
	EditorCommand string `name:"editor" env:"FORJ_EDITOR" hidden:""`
}

// defaultSubscriberOutputDir is the fallback package for ungrouped subscribers.
const defaultSubscriberOutputDir = "./internal/events"

// NewSubscriberCmd creates the make:subscriber generator command.
func NewSubscriberCmd() *SubscriberCmd {
	return &SubscriberCmd{}
}

// Signature defines CLI metadata for this command.
func (*SubscriberCmd) Signature() string {
	return `name:"make:subscriber" help:"Create a new event subscriber" goforj:"preboot"`
}

// Help defines extended CLI help for this command.
func (*SubscriberCmd) Help() string {
	return commandExamples(
		commandExample("make:subscriber", "billing:invoice-paid"),
		commandExample("make:subscriber", "billing:invoice-paid", "--bus", "audit"),
	)
}

// Run generates the subscriber file and updates event subscriber wiring.
func (c *SubscriberCmd) Run() error {
	if err := validateGeneratedFileOpenFlags(c.Open, c.NoOpen); err != nil {
		return err
	}

	target := c.target()
	busName := subscriberBusName(c.Bus)
	if c.Remove {
		return c.remove(target, busName)
	}

	if err := c.writeSubscriberFile(target); err != nil {
		return err
	}
	if err := c.injectIntoWireFile(target, busName); err != nil {
		return err
	}

	console.Successf("subscribed %s on %s", target.structName, busName)
	return maybeOpenGeneratedFile(generatedFileOpenOptions{
		Path:          target.outputPath,
		Line:          1,
		Open:          c.Open,
		NoOpen:        c.NoOpen,
		Mode:          c.MakeOpen,
		EditorCommand: c.EditorCommand,
	})
}

func (c *SubscriberCmd) remove(target subscriberTarget, busName string) error {
	if err := removeGeneratedFile(target.outputPath, c.DryRun); err != nil {
		return err
	}
	return c.removeFromWireFile(target, busName)
}

// subscriberTarget is the normalized filesystem and type metadata for a generated subscriber.
type subscriberTarget struct {
	outputDir  string
	outputPath string
	structName string
	eventName  string
}

// target resolves grouped subscriber names into colocated package output.
func (c *SubscriberCmd) target() subscriberTarget {
	if str.Of(c.OutputDir).TrimSpace().IsBlank() {
		c.OutputDir = defaultSubscriberOutputDir
	}

	rawName := str.Of(c.Name).TrimSpace().String()
	structBase := rawName
	parts := str.Of(rawName).Split(":")
	if len(parts) > 1 {
		action := str.Of(parts[len(parts)-1]).TrimSpace().String()
		if action != "" && isDefaultSubscriberOutputDir(c.OutputDir) {
			if packageParts := generatedPackagePathParts(parts[:len(parts)-1]); len(packageParts) > 0 {
				c.OutputDir = filepath.Join(append([]string{".", "internal"}, packageParts...)...)
			}
		}
		structBase = action
	}

	baseName := str.Of(structBase).Pascal().String()
	baseName = str.Of(baseName).ChopEnd("Subscriber").String()
	eventName := ensureEventSuffix(baseName)
	subscriberName := ensureSubscriberSuffix(str.Of(baseName).ChopEnd("Event").String())
	fileName := str.Of(subscriberName).Snake("_").String() + ".go"

	return subscriberTarget{
		outputDir:  c.OutputDir,
		outputPath: filepath.Join(c.OutputDir, fileName),
		structName: subscriberName,
		eventName:  eventName,
	}
}

// writeSubscriberFile renders the subscriber implementation.
func (c *SubscriberCmd) writeSubscriberFile(target subscriberTarget) error {
	if err := os.MkdirAll(filepath.Dir(target.outputPath), os.ModePerm); err != nil {
		return err
	}

	var buf bytes.Buffer
	tmpl := template.Must(template.New("subscriber").Parse(string(subscriberTmpl)))
	if err := tmpl.Execute(&buf, map[string]string{
		"PackageName": generatedPackageName(target.outputDir, "events"),
		"StructName":  target.structName,
		"EventName":   target.eventName,
	}); err != nil {
		return err
	}

	if err := writeGeneratorGoFile(target.outputPath, buf.Bytes()); err != nil {
		return err
	}

	console.Successf("generated subscriber %s", target.outputPath)
	return nil
}

// injectIntoWireFile registers the subscriber constructor and event bus subscription.
func (c *SubscriberCmd) injectIntoWireFile(target subscriberTarget, busName string) error {
	injectPath := targetAppWireFile("inject_subscribers_app.go", "./app/wire/inject_event_subscribers.go", "./wire/inject_subscribers_app.go", "./wire/inject_event_subscribers.go")

	moduleName, err := getGoModuleName()
	if err != nil {
		return err
	}

	packageName := generatedPackageName(target.outputDir, "events")
	packageRef := generatedPackageRef(target.outputDir, "cmd")
	relPath := strings.TrimPrefix(filepath.ToSlash(target.outputDir), "./")
	importPath := fmt.Sprintf("%s/%s", moduleName, relPath)
	constructor := fmt.Sprintf("%s.New%s", packageRef, target.structName)
	constructorLine := fmt.Sprintf("\t%s,", constructor)
	paramName := str.Of(packageRef + target.structName).Camel().String()
	typeRef := fmt.Sprintf("%s.%s", packageRef, target.structName)
	paramLine := fmt.Sprintf("\t%s *%s,", paramName, typeRef)
	busVar := paramName + "Bus"
	handlerLine := fmt.Sprintf("\tif _, err := %s.Subscribe(%s.Handle); err != nil {", busVar, paramName)
	subscriptionLines := []string{
		fmt.Sprintf("\t%s := eventManager.Named(%q)", busVar, busName),
		fmt.Sprintf("\tif %s == nil {", busVar),
		fmt.Sprintf("\t\treturn nil, fmt.Errorf(\"event bus %%q is not configured\", %q)", busName),
		"\t}",
		handlerLine,
		"\t\treturn nil, err",
		"\t}",
	}

	lines, _, err := readGeneratorGoFile(injectPath)
	if err != nil {
		return fmt.Errorf("reading inject_subscribers_app.go: %w", err)
	}
	lines = insertImportIfMissing(lines, importPath, importAliasForPackageRef(packageName, packageRef))
	lines = insertImportIfMissing(lines, "fmt")
	lines = insertIntoCallBlock(lines, "var appSubscriberSet = wire.NewSet(", constructorLine)
	if !containsLine(lines, paramLine) {
		lines = insertIntoFuncParams(lines, "ProvideEventSubscribers", paramLine)
	}
	if !containsLine(lines, handlerLine) {
		lines = subscriberInsertBeforeReturn(lines, subscriptionLines)
	}

	if err := writeGeneratorGoLines(injectPath, lines); err != nil {
		return fmt.Errorf("writing inject_subscribers_app.go: %w", err)
	}

	console.Successf("injected into %s: %s", injectPath, constructor)
	return nil
}

func (c *SubscriberCmd) removeFromWireFile(target subscriberTarget, busName string) error {
	injectPath := targetAppWireFile("inject_subscribers_app.go", "./app/wire/inject_event_subscribers.go", "./wire/inject_subscribers_app.go", "./wire/inject_event_subscribers.go")

	moduleName, err := getGoModuleName()
	if err != nil {
		return err
	}

	packageRef := generatedPackageRef(target.outputDir, "cmd")
	relPath := strings.TrimPrefix(filepath.ToSlash(target.outputDir), "./")
	importPath := fmt.Sprintf("%s/%s", moduleName, relPath)
	constructor := fmt.Sprintf("%s.New%s", packageRef, target.structName)
	constructorLine := fmt.Sprintf("\t%s,", constructor)
	paramName := str.Of(packageRef + target.structName).Camel().String()
	typeRef := fmt.Sprintf("%s.%s", packageRef, target.structName)
	paramLine := fmt.Sprintf("\t%s *%s,", paramName, typeRef)
	busVar := paramName + "Bus"
	handlerLine := fmt.Sprintf("\tif _, err := %s.Subscribe(%s.Handle); err != nil {", busVar, paramName)
	subscriptionLines := []string{
		fmt.Sprintf("\t%s := eventManager.Named(%q)", busVar, busName),
		fmt.Sprintf("\tif %s == nil {", busVar),
		fmt.Sprintf("\t\treturn nil, fmt.Errorf(\"event bus %%q is not configured\", %q)", busName),
		"\t}",
		handlerLine,
		"\t\treturn nil, err",
		"\t}",
	}

	lines, _, err := readGeneratorGoFile(injectPath)
	if err != nil {
		return fmt.Errorf("reading inject_subscribers_app.go: %w", err)
	}
	original := append([]string{}, lines...)
	var removed bool
	lines, removedConstructor := removeExactLine(lines, constructorLine)
	lines, removedParam := removeExactLine(lines, paramLine)
	lines, removedBlock := removeExactBlock(lines, subscriptionLines)
	removed = removedConstructor || removedParam || removedBlock
	lines = removeGoImportIfUnused(lines, importPath, packageRef+".")
	lines = removeGoImportIfUnused(lines, "fmt", "fmt.")

	changed, err := writeGeneratorGoLinesIfChanged(injectPath, original, lines, c.DryRun)
	if err != nil {
		return err
	}
	if removed {
		if c.DryRun {
			console.Infof("Would remove %s subscriber wiring from %s", paramName, injectPath)
		} else {
			console.Successf("Removed %s subscriber wiring from %s", paramName, injectPath)
		}
	} else if !changed {
		console.Infof("No matching subscriber wiring found in %s", injectPath)
	}
	return nil
}

// ensureSubscriberSuffix appends Subscriber when name does not already use that suffix.
func ensureSubscriberSuffix(name string) string {
	clean := str.Of(name).TrimSpace()
	if clean.IsBlank() {
		return "ExampleSubscriber"
	}
	if clean.EndsWith("Subscriber") {
		return clean.String()
	}
	return clean.String() + "Subscriber"
}

// isDefaultSubscriberOutputDir reports whether the user left the subscriber output at its default.
func isDefaultSubscriberOutputDir(outputDir string) bool {
	return filepath.Clean(outputDir) == filepath.Clean(defaultSubscriberOutputDir)
}

// subscriberBusName returns the event bus selected for subscriber registration.
func subscriberBusName(busName string) string {
	if clean := str.Of(busName).TrimSpace().ToLower(); !clean.IsBlank() {
		return clean.String()
	}
	return "default"
}

// subscriberInsertBeforeReturn inserts subscription code before the ready marker return.
func subscriberInsertBeforeReturn(lines []string, insert []string) []string {
	for i, line := range lines {
		if strings.TrimSpace(line) == "return &EventSubscribersReady{}, nil" {
			return append(lines[:i], append(insert, lines[i:]...)...)
		}
	}
	return lines
}

// subscriberTmpl contains the generated subscriber implementation template.
//
//go:embed subscriber.tmpl
var subscriberTmpl []byte
