package makecmd

import (
	"path/filepath"
	"testing"
)

func TestSubscriberCmdRemoveDeletesFileAndWiring(t *testing.T) {
	root := t.TempDir()
	t.Chdir(root)

	writeMakeCmdTestFile(t, "go.mod", "module example.com/testapp\n\ngo 1.24\n")
	writeMakeCmdTestFile(t, filepath.Join("wire", "inject_event_subscribers.go"), `package wire

import (
	"example.com/testapp/internal/events"
	"github.com/google/wire"
)

var eventSubscriberSet = wire.NewSet(
	ProvideEventSubscribers,
)

type EventSubscribersReady struct{}

func ProvideEventSubscribers(
	eventManager *events.Manager,
) (*EventSubscribersReady, error) {
	return &EventSubscribersReady{}, nil
}
`)

	create := &SubscriberCmd{Name: "Billing:InvoicePaid", OutputDir: defaultSubscriberOutputDir}
	if err := create.Run(); err != nil {
		t.Fatalf("create subscriber: %v", err)
	}

	outputPath := filepath.Join("internal", "billing", "invoice_paid_subscriber.go")
	assertMakeCmdTestContains(t, outputPath, []string{
		"package billing",
		"type InvoicePaidSubscriber struct",
	})
	assertMakeCmdTestContains(t, filepath.Join("wire", "inject_event_subscribers.go"), []string{
		`"example.com/testapp/internal/billing"`,
		"billing.NewInvoicePaidSubscriber",
		"billingInvoicePaidSubscriber *billing.InvoicePaidSubscriber",
		`billingInvoicePaidSubscriberBus := eventManager.Named("default")`,
		"billingInvoicePaidSubscriber.Handle",
	})

	remove := &SubscriberCmd{Name: "Billing:InvoicePaid", OutputDir: defaultSubscriberOutputDir, Remove: true}
	if err := remove.Run(); err != nil {
		t.Fatalf("remove subscriber: %v", err)
	}

	assertMakeCmdTestFileMissing(t, outputPath)
	assertMakeCmdTestNotContains(t, filepath.Join("wire", "inject_event_subscribers.go"), []string{
		`"example.com/testapp/internal/billing"`,
		"billing.NewInvoicePaidSubscriber",
		"billingInvoicePaidSubscriber *billing.InvoicePaidSubscriber",
		`billingInvoicePaidSubscriberBus := eventManager.Named("default")`,
		"billingInvoicePaidSubscriber.Handle",
	})
}
