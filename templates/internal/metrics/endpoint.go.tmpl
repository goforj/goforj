package metrics

import (
	"context"
	"errors"
	"net"
	"net/http"
	"strings"
	"time"

	gmetrics "github.com/goforj/metrics"
	"{{.GoModuleName}}/internal/logger"
)

// StartPrometheusEndpoint starts a lightweight per-process Prometheus scrape endpoint.
func StartPrometheusEndpoint(ctx context.Context, appLogger *logger.AppLogger, role string, port string, registry *gmetrics.Registry) error {
	if ctx == nil || registry == nil {
		return nil
	}
	port = strings.TrimSpace(port)
	if port == "" {
		return nil
	}

	ln, err := net.Listen("tcp", ":"+port)
	if err != nil {
		return err
	}

	srv := &http.Server{
		Handler:           gmetrics.Handler(registry),
		ReadHeaderTimeout: 5 * time.Second,
	}

	if appLogger != nil {
		appLogger.Info().
			Str("role", strings.TrimSpace(role)).
			Str("port", port).
			Msg("Starting metrics endpoint")
	}

	go func() {
		<-ctx.Done()
		shutdownCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		_ = srv.Shutdown(shutdownCtx)
	}()

	go func() {
		if err := srv.Serve(ln); err != nil && !errors.Is(err, http.ErrServerClosed) && appLogger != nil {
			appLogger.Error().
				Err(err).
				Str("role", strings.TrimSpace(role)).
				Str("port", port).
				Msg("Metrics endpoint stopped unexpectedly")
		}
	}()

	return nil
}
