func metricSourceContextLabel(ctx context.Context, fallback string) string {
	source := runtime.SourceFromContext(ctx)
	if strings.TrimSpace(string(source)) == "" {
		return metricSourceLabel(fallback)
	}
	return metricSourceLabel(string(source))
}

func shouldTrackHTTPRequest(r web.Context) bool {
	if r == nil {
		return false
	}
	uri := r.Path()
	if uri == "" {
		uri = r.URI()
	}
	uri = strings.TrimSpace(uri)
	switch {
	case uri == "/metrics":
		return false
	case strings.HasPrefix(uri, "/lighthouse/"):
		return false
	}
	upgrade := strings.TrimSpace(r.Header("Upgrade"))
	if upgrade == "" {
		return true
	}
	if strings.EqualFold(upgrade, "websocket") {
		return false
	}
	connection := strings.TrimSpace(r.Header("Connection"))
	if connection == "" {
		return true
	}
	if strings.Contains(strings.ToLower(connection), "upgrade") &&
		strings.EqualFold(upgrade, "websocket") {
		return false
	}
	return true
}

func metricSourceLabel(source string) string {
	source = strings.TrimSpace(strings.ToLower(source))
	switch source {
	case "http", "scheduler", "jobs", "cli", "lighthouse", "startup", "app":
