{{- if .Components.Mail }}
func mailerNameLabel(name string) string {
	name = strings.TrimSpace(strings.ToLower(name))
	if name == "" {
		return "default"
	}
	return name
}

func mailDriverLabel(driver string) string {
	driver = strings.TrimSpace(strings.ToLower(driver))
	if driver == "" {
		return "unknown"
	}
	return driver
}

func mailStatusLabel(err error) string {
	switch {
	case err == nil:
		return "ok"
	case errors.Is(err, context.Canceled):
		return "canceled"
	case errors.Is(err, context.DeadlineExceeded):
		return "timeout"
	case strings.Contains(strings.ToLower(err.Error()), "timeout"):
		return "timeout"
	case errors.Is(err, goforjmail.ErrMissingMailer),
		errors.Is(err, goforjmail.ErrMissingRecipient),
		errors.Is(err, goforjmail.ErrMissingSubject),
		errors.Is(err, goforjmail.ErrMissingBody),
		errors.Is(err, goforjmail.ErrInvalidRecipient),
		errors.Is(err, goforjmail.ErrInvalidFrom),
		errors.Is(err, goforjmail.ErrInvalidReplyTo),
		errors.Is(err, goforjmail.ErrInvalidHeaderName),
		errors.Is(err, goforjmail.ErrInvalidAttachment):
		return "invalid"
	default:
		return "error"
	}
}

func mailReasonLabel(err error) string {
	switch {
	case err == nil:
		return "ok"
	case errors.Is(err, context.Canceled):
		return "canceled"
	case errors.Is(err, context.DeadlineExceeded):
		return "deadline_exceeded"
	case strings.Contains(strings.ToLower(err.Error()), "timeout"):
		return "timeout"
	case errors.Is(err, goforjmail.ErrMissingMailer):
		return "missing_mailer"
	case errors.Is(err, goforjmail.ErrMissingRecipient):
		return "missing_recipient"
	case errors.Is(err, goforjmail.ErrMissingSubject):
		return "missing_subject"
	case errors.Is(err, goforjmail.ErrMissingBody):
		return "missing_body"
	case errors.Is(err, goforjmail.ErrInvalidRecipient):
		return "invalid_recipient"
	case errors.Is(err, goforjmail.ErrInvalidFrom):
		return "invalid_from"
	case errors.Is(err, goforjmail.ErrInvalidReplyTo):
		return "invalid_reply_to"
	case errors.Is(err, goforjmail.ErrInvalidHeaderName):
		return "invalid_header_name"
	case errors.Is(err, goforjmail.ErrInvalidAttachment):
		return "invalid_attachment"
	default:
		return "provider_error"
	}
}
