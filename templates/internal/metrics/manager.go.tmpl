			Kind: gmetrics.KindGauge,
		}, []string{"connection", "driver"}),
		databasePoolIdle: registry.MustGaugeVec(gmetrics.Descriptor{
			Name: "database.pool.idle",
			Help: "Current number of idle database connections by connection and driver.",
			Kind: gmetrics.KindGauge,
		}, []string{"connection", "driver"}),
		databasePoolWaitCount: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "database.pool.wait_count",
			Help: "Total waits for a free database connection by connection and driver.",
			Kind: gmetrics.KindCounter,
		}, []string{"connection", "driver"}),
		databasePoolWaitDuration: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "database.pool.wait_duration",
			Help: "Total wait time for a free database connection by connection and driver.",
			Kind: gmetrics.KindCounter,
		}, []string{"connection", "driver"}),
		databasePoolMaxIdleClosed: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "database.pool.closed.max_idle",
			Help: "Total database connections closed due to max idle by connection and driver.",
			Kind: gmetrics.KindCounter,
		}, []string{"connection", "driver"}),
		databasePoolMaxIdleTimeClosed: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "database.pool.closed.max_idle_time",
			Help: "Total database connections closed due to max idle time by connection and driver.",
			Kind: gmetrics.KindCounter,
		}, []string{"connection", "driver"}),
		databasePoolMaxLifetimeClosed: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "database.pool.closed.max_lifetime",
			Help: "Total database connections closed due to max lifetime by connection and driver.",
			Kind: gmetrics.KindCounter,
		}, []string{"connection", "driver"}),
		databasePoolSnapshots: make(map[string]databasePoolSnapshot),
{{- end }}
		cacheOperations: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "cache.operations",
			Help: "Total cache operations by source, cache, driver, operation, category, status, and hit result.",
			Kind: gmetrics.KindCounter,
		}, []string{"source", "cache", "driver", "operation", "category", "status", "hit"}),
		cacheOperationLatency: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "cache.operation.duration",
			Help: "Cache operation latency by source, cache, driver, operation, and category.",
			Kind: gmetrics.KindHistogram,
