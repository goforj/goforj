	reason := eventDeliveryReasonLabel(event.Err)
	m.eventDeliveriesInflight.WithLabelValues(labels.Source, labels.Bus, labels.Driver, labels.Topic, labels.Handler).Add(-1)
	m.eventDeliveries.WithLabelValues(labels.Source, labels.Bus, labels.Driver, labels.Topic, labels.Handler, status, reason).Inc()
	m.observeDuration(m.eventDeliveryLatency, event.Duration, labels.Source, labels.Bus, labels.Driver, labels.Topic, labels.Handler)
}
