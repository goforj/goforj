		}, []string{"source", "cache", "driver", "operation", "category"}, gmetrics.DurationBounds(cacheDurationBounds())),
		storageOperations: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "storage.operations",
			Help: "Total storage operations by source, disk, driver, operation, category, and status.",
			Kind: gmetrics.KindCounter,
		}, []string{"source", "disk", "driver", "operation", "category", "status"}),
		storageOperationLatency: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "storage.operation.duration",
			Help: "Storage operation latency by source, disk, driver, operation, and category.",
			Kind: gmetrics.KindHistogram,
			Unit: gmetrics.UnitSeconds,
		}, []string{"source", "disk", "driver", "operation", "category"}, gmetrics.DurationBounds(storageDurationBounds())),
		eventPublishes: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "events.publishes",
			Help: "Total published events by source, bus, driver, topic, status, and reason.",
