{{- end }}

	httpRequests        *gmetrics.Counter
	httpInflight        *gmetrics.Gauge
	httpClientErrors    *gmetrics.Counter
	httpServerErrors    *gmetrics.Counter
	httpDuration        *gmetrics.Histogram
	httpRequestsByRoute *gmetrics.CounterVec
	httpDurationByRoute *gmetrics.HistogramVec
{{- if .Components.Auth }}
	authFlows           *gmetrics.CounterVec
	authFlowLatency     *gmetrics.HistogramVec
{{- end }}
{{- if .Components.Jobs }}
	queueJobsEnqueued    *gmetrics.Counter
	queueJobsScheduled   *gmetrics.Counter
	queueJobsProcessed   *gmetrics.Counter
	queueJobsFailed      *gmetrics.Counter
	queueJobsRetried     *gmetrics.Counter
	queueJobsArchived    *gmetrics.Counter
	queueJobsInflight    *gmetrics.GaugeVec
	queueJobsByJob       *gmetrics.CounterVec
	queueJobsInflightByJob *gmetrics.GaugeVec
	queueEventsByQueue   *gmetrics.CounterVec
	queueDurationByQueue *gmetrics.HistogramVec
	queueDurationByJob   *gmetrics.HistogramVec
{{- end }}
{{- if .Components.Scheduler }}
	schedulerStarted       *gmetrics.Counter
	schedulerRuns          *gmetrics.Counter
	schedulerFailures      *gmetrics.Counter
	schedulerSkips         *gmetrics.Counter
	schedulerInflight      *gmetrics.GaugeVec
	schedulerRunsByJob     *gmetrics.CounterVec
	schedulerEventsByJob   *gmetrics.CounterVec
	schedulerDurationByJob *gmetrics.HistogramVec
{{- end }}
{{- if .Components.HasDatabase }}
	databaseOperations       *gmetrics.CounterVec
	databaseOperationLatency *gmetrics.HistogramVec
	databasePoolOpen         *gmetrics.GaugeVec
	databasePoolInUse        *gmetrics.GaugeVec
	databasePoolIdle         *gmetrics.GaugeVec
	databasePoolWaitCount    *gmetrics.CounterVec
	databasePoolWaitDuration *gmetrics.CounterVec
	databasePoolMaxIdleClosed     *gmetrics.CounterVec
	databasePoolMaxIdleTimeClosed *gmetrics.CounterVec
	databasePoolMaxLifetimeClosed *gmetrics.CounterVec
	databasePoolSnapshots    map[string]databasePoolSnapshot
{{- end }}
	cacheOperations         *gmetrics.CounterVec
	cacheOperationLatency   *gmetrics.HistogramVec
	storageOperations       *gmetrics.CounterVec
	storageOperationLatency *gmetrics.HistogramVec
	eventPublishes          *gmetrics.CounterVec
	eventPublishLatency     *gmetrics.HistogramVec
	eventSubscriptions      *gmetrics.CounterVec
	eventSubscribersActive  *gmetrics.GaugeVec
	eventDeliveries         *gmetrics.CounterVec
	eventDeliveriesInflight *gmetrics.GaugeVec
	eventDeliveryLatency    *gmetrics.HistogramVec
{{- if .Components.Mail }}
	mailSends        *gmetrics.CounterVec
	mailSendLatency  *gmetrics.HistogramVec
{{- end }}
}

// Config controls which framework metrics surfaces are active.
type Config struct {
	HTTP      bool
	Cache     bool
	Storage   bool
	Events    bool
{{- if .Components.Mail }}
	Mail      bool
{{- end }}
{{- if .Components.Jobs }}
	Queue     bool
{{- end }}
{{- if .Components.HasDatabase }}
	Database  bool
{{- end }}
{{- if .Components.Auth }}
	Auth      bool
{{- end }}
{{- if .Components.Scheduler }}
	Scheduler bool
{{- end }}
}

// NewConfig resolves framework metrics config from environment.
func NewConfig() Config {
	return Config{
		HTTP:      env.GetBool("METRICS_HTTP_ENABLED", "true"),
		Cache:     env.GetBool("METRICS_CACHE_ENABLED", "true"),
		Storage:   env.GetBool("METRICS_STORAGE_ENABLED", "true"),
		Events:    env.GetBool("METRICS_EVENTS_ENABLED", "true"),
{{- if .Components.Mail }}
		Mail:      env.GetBool("METRICS_MAIL_ENABLED", "true"),
{{- end }}
{{- if .Components.Jobs }}
		Queue:     env.GetBool("METRICS_QUEUE_ENABLED", "true"),
{{- end }}
{{- if .Components.HasDatabase }}
		Database:  env.GetBool("METRICS_DATABASE_ENABLED", "true"),
{{- end }}
{{- if .Components.Auth }}
		Auth:      env.GetBool("METRICS_AUTH_ENABLED", "true"),
{{- end }}
{{- if .Components.Scheduler }}
		Scheduler: env.GetBool("METRICS_SCHEDULER_ENABLED", "true"),
{{- end }}
	}
}

// NewManager creates the default app metrics manager.
func NewManager() *Manager {
	return NewManagerWithConfig(NewConfig())
}

