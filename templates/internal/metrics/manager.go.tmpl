		return "unsupported"
	case errors.Is(err, goforjcache.ErrEncryptionKey),
		errors.Is(err, goforjcache.ErrValueTooLarge),
		errors.Is(err, goforjcache.ErrEncryptValueTooBig),
		errors.Is(err, goforjcache.ErrCorruptCompression),
		errors.Is(err, goforjcache.ErrDecryptFailed):
		return "invalid"
