			Name: "scheduler.failures",
			Help: "Total scheduler jobs that failed.",
			Kind: gmetrics.KindCounter,
		}),
		schedulerSkips: registry.MustCounter(gmetrics.Descriptor{
			Name: "scheduler.skips",
			Help: "Total scheduler jobs that were skipped.",
			Kind: gmetrics.KindCounter,
		}),
		schedulerRunsByJob: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "scheduler.runs.by_job",
			Help: "Total scheduler job outcomes by job name and status.",
			Kind: gmetrics.KindCounter,
		}, []string{"job_name", "status"}),
		schedulerDurationByJob: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "scheduler.job.duration.by_job",
			Help: "Scheduler job duration by job name.",
			Kind: gmetrics.KindHistogram,
			Unit: gmetrics.UnitSeconds,
		}, []string{"job_name"}, gmetrics.DurationBounds(gmetrics.DefaultDurationBounds())),
{{- end }}
{{- if .Components.HasDatabase }}
		databaseOperations: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "database.operations",
			Help: "Total database statements by connection, driver, operation, and status.",
			Kind: gmetrics.KindCounter,
		}, []string{"connection", "driver", "operation", "status"}),
		databaseOperationLatency: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "database.operation.duration",
			Help: "Database statement latency by connection, driver, and operation.",
			Kind: gmetrics.KindHistogram,
			Unit: gmetrics.UnitSeconds,
		}, []string{"connection", "driver", "operation"}, gmetrics.DurationBounds(databaseDurationBounds())),
{{- end }}
		cacheOperations: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "cache.operations",
			Help: "Total cache operations by cache, driver, operation, category, status, and hit result.",
			Kind: gmetrics.KindCounter,
		}, []string{"cache", "driver", "operation", "category", "status", "hit"}),
		cacheOperationLatency: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "cache.operation.duration",
			Help: "Cache operation latency by cache, driver, operation, and category.",
			Kind: gmetrics.KindHistogram,
			Unit: gmetrics.UnitSeconds,
		}, []string{"cache", "driver", "operation", "category"}, gmetrics.DurationBounds(cacheDurationBounds())),
		storageOperations: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "storage.operations",
			Help: "Total storage operations by disk, driver, operation, category, and status.",
			Kind: gmetrics.KindCounter,
		}, []string{"disk", "driver", "operation", "category", "status"}),
		storageOperationLatency: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "storage.operation.duration",
			Help: "Storage operation latency by disk, driver, operation, and category.",
			Kind: gmetrics.KindHistogram,
			Unit: gmetrics.UnitSeconds,
		}, []string{"disk", "driver", "operation", "category"}, gmetrics.DurationBounds(storageDurationBounds())),
		eventPublishes: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "events.publishes",
			Help: "Total published events by bus, driver, topic, and status.",
			Kind: gmetrics.KindCounter,
		}, []string{"bus", "driver", "topic", "status"}),
		eventPublishLatency: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "events.publish.duration",
			Help: "Event publish latency by bus, driver, and topic.",
			Kind: gmetrics.KindHistogram,
			Unit: gmetrics.UnitSeconds,
		}, []string{"bus", "driver", "topic"}, gmetrics.DurationBounds(eventDurationBounds())),
{{- if .Components.Mail }}
		mailSends: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "mail.sends",
			Help: "Total mail send attempts by mailer, driver, and status.",
			Kind: gmetrics.KindCounter,
		}, []string{"mailer", "driver", "status"}),
		mailSendLatency: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "mail.send.duration",
			Help: "Mail send latency by mailer and driver.",
			Kind: gmetrics.KindHistogram,
			Unit: gmetrics.UnitSeconds,
		}, []string{"mailer", "driver"}, gmetrics.DurationBounds(gmetrics.DefaultDurationBounds())),
{{- end }}
	}
}

// Registry returns the underlying metrics registry.
func (m *Manager) Registry() *gmetrics.Registry {
	if m == nil {
		return nil
	}
	return m.registry
}

// HTTPMiddleware tracks in-flight HTTP requests.
func (m *Manager) HTTPMiddleware() web.Middleware {
	return func(next web.Handler) web.Handler {
		return func(r web.Context) error {
			if m != nil && m.httpInflight != nil && shouldTrackHTTPRequest(r) {
				m.httpInflight.Add(1)
				defer m.httpInflight.Sub(1)
			}
			return next(r)
		}
	}
}

// RecordHTTPRequest updates framework-owned aggregate HTTP metrics.
func (m *Manager) RecordHTTPRequest(r web.Context, status int, latency time.Duration) {
	if m == nil || !shouldTrackHTTPRequest(r) {
		return
	}
	m.httpRequests.Inc()
	m.httpDuration.ObserveDuration(latency)
	method := httpMethodLabel(r)
	route := httpRouteLabel(r)
	statusLabel := strconv.Itoa(status)
	m.httpRequestsByRoute.WithLabelValues(method, route, statusLabel).Inc()
	m.httpDurationByRoute.WithLabelValues(method, route).ObserveDuration(latency)
	switch {
	case status >= 500:
		m.httpServerErrors.Inc()
	case status >= 400:
		m.httpClientErrors.Inc()
	}
}

{{- if .Components.Jobs }}
// RecordQueueEvent updates framework-owned queue metrics from queue runtime observer events.
func (m *Manager) RecordQueueEvent(event queue.Event) {
	if m == nil {
		return
	}
	queueName := queueLabel(event.Queue)
	jobName := queueJobLabel(event.JobType)
	driver := queueDriverLabel(string(event.Driver))
	if m.queueEventsByQueue != nil {
		m.queueEventsByQueue.WithLabelValues(queueName, string(event.Kind)).Inc()
	}

	switch event.Kind {
	case queue.EventEnqueueAccepted:
		m.queueJobsEnqueued.Inc()
		m.queueJobsByJob.WithLabelValues(queueName, jobName, driver, "enqueued").Inc()
		if event.Scheduled {
			m.queueJobsScheduled.Inc()
			m.queueJobsByJob.WithLabelValues(queueName, jobName, driver, "scheduled").Inc()
		}
	case queue.EventProcessStarted:
		m.queueJobsInflight.WithLabelValues(queueName).Add(1)
		m.queueJobsInflightByJob.WithLabelValues(queueName, jobName, driver).Add(1)
	case queue.EventProcessSucceeded:
		m.queueJobsInflight.WithLabelValues(queueName).Add(-1)
		m.queueJobsInflightByJob.WithLabelValues(queueName, jobName, driver).Add(-1)
		m.queueJobsProcessed.Inc()
		m.queueJobsByJob.WithLabelValues(queueName, jobName, driver, "succeeded").Inc()
		if event.Duration > 0 {
			m.queueDurationByQueue.WithLabelValues(queueName).ObserveDuration(event.Duration)
			m.queueDurationByJob.WithLabelValues(queueName, jobName, driver).ObserveDuration(event.Duration)
		}
	case queue.EventProcessFailed:
		m.queueJobsInflight.WithLabelValues(queueName).Add(-1)
		m.queueJobsInflightByJob.WithLabelValues(queueName, jobName, driver).Add(-1)
		m.queueJobsFailed.Inc()
		m.queueJobsByJob.WithLabelValues(queueName, jobName, driver, "failed").Inc()
		if event.Duration > 0 {
			m.queueDurationByQueue.WithLabelValues(queueName).ObserveDuration(event.Duration)
			m.queueDurationByJob.WithLabelValues(queueName, jobName, driver).ObserveDuration(event.Duration)
		}
	case queue.EventProcessRetried:
		m.queueJobsRetried.Inc()
		m.queueJobsByJob.WithLabelValues(queueName, jobName, driver, "retried").Inc()
	case queue.EventProcessArchived:
		m.queueJobsArchived.Inc()
		m.queueJobsByJob.WithLabelValues(queueName, jobName, driver, "archived").Inc()
	}
}
{{- end }}

{{- if .Components.Scheduler }}
// RecordSchedulerJob updates framework-owned scheduler metrics from scheduler job observer events.
func (m *Manager) RecordSchedulerJob(event schedulerx.JobEvent) {
	if m == nil {
		return
	}
	jobName := schedulerJobLabel(event.Name)
	switch event.Type {
	case schedulerx.JobSucceeded:
		m.schedulerRuns.Inc()
		m.schedulerRunsByJob.WithLabelValues(jobName, "succeeded").Inc()
		if event.Duration > 0 {
			m.schedulerDurationByJob.WithLabelValues(jobName).ObserveDuration(event.Duration)
		}
	case schedulerx.JobFailed:
		m.schedulerFailures.Inc()
		m.schedulerRunsByJob.WithLabelValues(jobName, "failed").Inc()
		if event.Duration > 0 {
			m.schedulerDurationByJob.WithLabelValues(jobName).ObserveDuration(event.Duration)
		}
	case schedulerx.JobSkipped:
		m.schedulerSkips.Inc()
		m.schedulerRunsByJob.WithLabelValues(jobName, "skipped").Inc()
	}
}
{{- end }}

