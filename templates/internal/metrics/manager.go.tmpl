// Registry returns the underlying metrics registry.
func (m *Manager) Registry() *gmetrics.Registry {
	if m == nil {
		return nil
	}
	return m.registry
}

// Config returns the resolved metrics config.
func (m *Manager) Config() Config {
	if m == nil {
		return Config{}
	}
	return m.config
}

func (m *Manager) HTTPEnabled() bool {
	return m.config.HTTP
}

func (m *Manager) CacheEnabled() bool {
	return m.config.Cache
}

