// RecordDatabasePoolStats updates framework-owned database pool metrics from sql.DB stats snapshots.
func (m *Manager) RecordDatabasePoolStats(connection, driver string, stats sql.DBStats) {
	if !m.DatabaseEnabled() {
		return
	}
	connection = databaseConnectionLabel(connection)
	driver = databaseDriverLabel(driver)

	m.databasePoolOpen.WithLabelValues(connection, driver).Set(int64(stats.OpenConnections))
	m.databasePoolInUse.WithLabelValues(connection, driver).Set(int64(stats.InUse))
	m.databasePoolIdle.WithLabelValues(connection, driver).Set(int64(stats.Idle))

	key := connection + "|" + driver

	m.mu.Lock()
	prev := m.databasePoolSnapshots[key]
	m.databasePoolSnapshots[key] = databasePoolSnapshot{
		waitCount:         stats.WaitCount,
		waitDuration:      stats.WaitDuration,
		maxIdleClosed:     stats.MaxIdleClosed,
		maxIdleTimeClosed: stats.MaxIdleTimeClosed,
		maxLifetimeClosed: stats.MaxLifetimeClosed,
	}
	m.mu.Unlock()

	if stats.WaitCount > prev.waitCount {
		delta := uint64(stats.WaitCount - prev.waitCount)
		m.databasePoolWaitCount.WithLabelValues(connection, driver).Add(delta)
	}
	if stats.WaitDuration > prev.waitDuration {
		delta := stats.WaitDuration - prev.waitDuration
		m.databasePoolWaitDuration.WithLabelValues(connection, driver).Add(uint64(delta))
	}
	if stats.MaxIdleClosed > prev.maxIdleClosed {
		delta := uint64(stats.MaxIdleClosed - prev.maxIdleClosed)
		m.databasePoolMaxIdleClosed.WithLabelValues(connection, driver).Add(delta)
	}
	if stats.MaxIdleTimeClosed > prev.maxIdleTimeClosed {
		delta := uint64(stats.MaxIdleTimeClosed - prev.maxIdleTimeClosed)
		m.databasePoolMaxIdleTimeClosed.WithLabelValues(connection, driver).Add(delta)
	}
	if stats.MaxLifetimeClosed > prev.maxLifetimeClosed {
		delta := uint64(stats.MaxLifetimeClosed - prev.maxLifetimeClosed)
		m.databasePoolMaxLifetimeClosed.WithLabelValues(connection, driver).Add(delta)
	}
}
