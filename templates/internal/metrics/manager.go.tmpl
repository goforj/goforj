			Kind: gmetrics.KindHistogram,
			Unit: gmetrics.UnitSeconds,
		}, metricLabelKeys("source", "queue", "job_name", "driver"), gmetrics.DurationBounds(queueDurationBounds())),
{{- end }}
{{- if .ProjectComponents.Scheduler }}
		schedulerStarted: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "scheduler.started",
			Help: "Total scheduler job attempts that started execution.",
			Kind: gmetrics.KindCounter,
		}, metricLabelKeys("source")),
