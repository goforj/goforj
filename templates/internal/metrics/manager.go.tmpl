// HTTPMiddleware tracks in-flight HTTP requests.
func (m *Manager) HTTPMiddleware() web.Middleware {
	return func(next web.Handler) web.Handler {
		return func(r web.Context) error {
			source := m.metricSource(requestContext(r))
			if m != nil && m.HTTPEnabled() && m.httpInflight != nil && shouldTrackHTTPRequest(r) {
				m.httpInflight.WithLabelValues(source).Add(1)
				defer m.httpInflight.WithLabelValues(source).Sub(1)
			}
			return next(r)
		}
	}
}

// RecordHTTPRequest updates framework-owned aggregate HTTP metrics.
func (m *Manager) RecordHTTPRequest(r web.Context, status int, latency time.Duration) {
	if !m.HTTPEnabled() || !shouldTrackHTTPRequest(r) {
		return
	}
	source := m.metricSource(requestContext(r))
	m.httpRequests.WithLabelValues(source).Inc()
	m.httpDuration.WithLabelValues(source).ObserveDuration(latency)
	method := httpMethodLabel(r)
	route := httpRouteLabel(r)
	statusLabel := strconv.Itoa(status)
	m.httpRequestsByRoute.WithLabelValues(source, method, route, statusLabel).Inc()
	m.httpDurationByRoute.WithLabelValues(source, method, route).ObserveDuration(latency)
	switch {
	case status >= 500:
		m.httpServerErrors.WithLabelValues(source).Inc()
	case status >= 400:
		m.httpClientErrors.WithLabelValues(source).Inc()
	}
}

