// HTTPMiddleware tracks in-flight HTTP requests.
func (m *Manager) HTTPMiddleware() web.Middleware {
	return func(next web.Handler) web.Handler {
		return func(r web.Context) error {
			if m != nil && m.HTTPEnabled() && m.httpInflight != nil && shouldTrackHTTPRequest(r) {
				source := requestMetricSource(r)
				inflight := m.httpSourceMetrics(source).inflight
				inflight.Add(1)
				defer inflight.Sub(1)
			}
			return next(r)
		}
	}
}

// RecordHTTPRequest updates framework-owned aggregate HTTP metrics.
func (m *Manager) RecordHTTPRequest(r web.Context, status int, latency time.Duration) {
	if !m.HTTPEnabled() || !shouldTrackHTTPRequest(r) {
		return
	}
	source := requestMetricSource(r)
	sourceMetrics := m.httpSourceMetrics(source)
	sourceMetrics.requests.Inc()
	sourceMetrics.duration.ObserveDuration(latency)
	method := httpMethodLabel(r)
	route := httpRouteLabel(r)
	statusLabel := strconv.Itoa(status)
	routeMetrics := m.httpRouteMetrics(source, method, route)
	routeMetrics.duration.ObserveDuration(latency)
	m.httpRouteStatusCounter(source, method, route, statusLabel).Inc()
	switch {
	case status >= 500:
		sourceMetrics.serverErrors.Inc()
	case status >= 400:
		sourceMetrics.clientErrors.Inc()
	}
}

