// RecordQueueEvent updates framework-owned queue metrics from queue observer events.
func (m *Manager) RecordQueueEvent(ctx context.Context, event queue.Event) {
	if !m.QueueEnabled() {
		return
	}
	source := m.metricSource(ctx)
	queueName := queueLabel(event.Queue)
	jobName := queueJobLabel(event.JobType)
	driver := queueDriverLabel(string(event.Driver))
	if m.queueEventsByQueue != nil {
		m.queueEventsByQueue.WithLabelValues(source, queueName, string(event.Kind)).Inc()
	}

	switch event.Kind {
	case queue.EventEnqueueAccepted:
		m.queueJobsEnqueued.WithLabelValues(source).Inc()
		m.queueJobsByJob.WithLabelValues(source, queueName, jobName, driver, "enqueued").Inc()
		if event.Scheduled {
			m.queueJobsScheduled.WithLabelValues(source).Inc()
			m.queueJobsByJob.WithLabelValues(source, queueName, jobName, driver, "scheduled").Inc()
		}
	case queue.EventProcessStarted:
		m.queueJobsInflight.WithLabelValues(source, queueName).Add(1)
		m.queueJobsInflightByJob.WithLabelValues(source, queueName, jobName, driver).Add(1)
	case queue.EventProcessSucceeded:
		m.queueJobsInflight.WithLabelValues(source, queueName).Add(-1)
		m.queueJobsInflightByJob.WithLabelValues(source, queueName, jobName, driver).Add(-1)
		m.queueJobsProcessed.WithLabelValues(source).Inc()
		m.queueJobsByJob.WithLabelValues(source, queueName, jobName, driver, "succeeded").Inc()
		if event.Duration > 0 {
			m.queueDurationByQueue.WithLabelValues(source, queueName).ObserveDuration(event.Duration)
			m.queueDurationByJob.WithLabelValues(source, queueName, jobName, driver).ObserveDuration(event.Duration)
		}
	case queue.EventProcessFailed:
		m.queueJobsInflight.WithLabelValues(source, queueName).Add(-1)
		m.queueJobsInflightByJob.WithLabelValues(source, queueName, jobName, driver).Add(-1)
		m.queueJobsFailed.WithLabelValues(source).Inc()
		m.queueJobsByJob.WithLabelValues(source, queueName, jobName, driver, "failed").Inc()
		if event.Duration > 0 {
			m.queueDurationByQueue.WithLabelValues(source, queueName).ObserveDuration(event.Duration)
			m.queueDurationByJob.WithLabelValues(source, queueName, jobName, driver).ObserveDuration(event.Duration)
		}
	case queue.EventProcessRetried:
		m.queueJobsRetried.WithLabelValues(source).Inc()
		m.queueJobsByJob.WithLabelValues(source, queueName, jobName, driver, "retried").Inc()
	case queue.EventProcessArchived:
		m.queueJobsArchived.WithLabelValues(source).Inc()
		m.queueJobsByJob.WithLabelValues(source, queueName, jobName, driver, "archived").Inc()
	}
}
{{- end }}

