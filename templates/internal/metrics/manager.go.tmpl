// RecordSchedulerJob updates framework-owned scheduler metrics from scheduler job observer events.
func (m *Manager) RecordSchedulerJob(event schedulerx.JobEvent) {
	if m == nil || !m.SchedulerEnabled() {
		return
	}
	jobName := schedulerJobLabel(event.Name)
	targetKind := schedulerTargetKindLabel(event.TargetKind)
	reason := schedulerReasonLabel(event.Reason)
	switch event.Type {
	case schedulerx.JobStarted:
		m.schedulerStarted.Inc()
		m.schedulerInflight.WithLabelValues(jobName, targetKind).Add(1)
		m.schedulerEventsByJob.WithLabelValues(jobName, targetKind, "started", reason).Inc()
	case schedulerx.JobSucceeded:
		m.schedulerInflight.WithLabelValues(jobName, targetKind).Add(-1)
		m.schedulerRuns.Inc()
		m.schedulerRunsByJob.WithLabelValues(jobName, "succeeded").Inc()
		m.schedulerEventsByJob.WithLabelValues(jobName, targetKind, "succeeded", reason).Inc()
		if event.Duration > 0 {
			m.schedulerDurationByJob.WithLabelValues(jobName, targetKind, "succeeded").ObserveDuration(event.Duration)
		}
	case schedulerx.JobFailed:
		m.schedulerInflight.WithLabelValues(jobName, targetKind).Add(-1)
		m.schedulerFailures.Inc()
		m.schedulerRunsByJob.WithLabelValues(jobName, "failed").Inc()
		m.schedulerEventsByJob.WithLabelValues(jobName, targetKind, "failed", reason).Inc()
		if event.Duration > 0 {
			m.schedulerDurationByJob.WithLabelValues(jobName, targetKind, "failed").ObserveDuration(event.Duration)
		}
	case schedulerx.JobSkipped:
		m.schedulerSkips.Inc()
		m.schedulerRunsByJob.WithLabelValues(jobName, "skipped").Inc()
		m.schedulerEventsByJob.WithLabelValues(jobName, targetKind, "skipped", reason).Inc()
	}
}
