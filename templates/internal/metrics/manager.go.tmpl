// RecordLighthouseInspectBufferDepth updates the current outbound inspect buffer depth by source.
func (m *Manager) RecordLighthouseInspectBufferDepth(source string, depth int) {
	if m == nil || m.lighthouseInspectBufferDepth == nil {
		return
	}
	m.lighthouseInspectBufferDepth.WithLabelValues(metricSourceLabel(source)).Set(int64(depth))
}

// RecordLighthouseInspectDropped increments dropped finished inspect counts by source and reason.
func (m *Manager) RecordLighthouseInspectDropped(source, reason string, count int) {
	if m == nil || m.lighthouseInspectDropped == nil || count <= 0 {
		return
	}
	m.lighthouseInspectDropped.WithLabelValues(metricSourceLabel(source), lighthouseInspectReasonLabel(reason)).Add(uint64(count))
}

// RecordLighthouseInspectFlush updates outbound inspect batch metrics.
func (m *Manager) RecordLighthouseInspectFlush(source string, batchSize int, duration time.Duration, err error) {
	if m == nil {
		return
	}
	normalizedSource := metricSourceLabel(source)
	status := "ok"
	if err != nil {
		status = "error"
	}
	if m.lighthouseInspectFlushes != nil {
		m.lighthouseInspectFlushes.WithLabelValues(normalizedSource, status).Inc()
	}
	if batchSize > 0 && m.lighthouseInspectFlushSize != nil {
		m.lighthouseInspectFlushSize.WithLabelValues(normalizedSource).Observe(int64(batchSize))
	}
	if duration > 0 && m.lighthouseInspectFlushLatency != nil {
		m.lighthouseInspectFlushLatency.WithLabelValues(normalizedSource).ObserveDuration(duration)
	}
	if err != nil && m.lighthouseInspectFlushErrors != nil {
		m.lighthouseInspectFlushErrors.WithLabelValues(normalizedSource, lighthouseInspectReasonLabel(err.Error())).Inc()
	}
}

