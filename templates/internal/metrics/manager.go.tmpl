// Manager owns the app metrics registry and framework-owned metric handles.
type Manager struct {
	registry *gmetrics.Registry

	httpRequests        *gmetrics.Counter
	httpInflight        *gmetrics.Gauge
	httpClientErrors    *gmetrics.Counter
	httpServerErrors    *gmetrics.Counter
	httpDuration        *gmetrics.Histogram
	httpRequestsByRoute *gmetrics.CounterVec
	httpDurationByRoute *gmetrics.HistogramVec
{{- if .Components.Jobs }}
	queueJobsEnqueued    *gmetrics.Counter
	queueJobsScheduled   *gmetrics.Counter
	queueJobsProcessed   *gmetrics.Counter
	queueJobsFailed      *gmetrics.Counter
	queueJobsRetried     *gmetrics.Counter
	queueJobsArchived    *gmetrics.Counter
	queueJobsInflight    *gmetrics.GaugeVec
	queueJobsByJob       *gmetrics.CounterVec
	queueJobsInflightByJob *gmetrics.GaugeVec
	queueEventsByQueue   *gmetrics.CounterVec
	queueDurationByQueue *gmetrics.HistogramVec
	queueDurationByJob   *gmetrics.HistogramVec
{{- end }}
{{- if .Components.Scheduler }}
	schedulerRuns          *gmetrics.Counter
	schedulerFailures      *gmetrics.Counter
	schedulerSkips         *gmetrics.Counter
	schedulerRunsByJob     *gmetrics.CounterVec
	schedulerDurationByJob *gmetrics.HistogramVec
{{- end }}
{{- if .Components.HasDatabase }}
	databaseOperations       *gmetrics.CounterVec
	databaseOperationLatency *gmetrics.HistogramVec
{{- end }}
	cacheOperations         *gmetrics.CounterVec
	cacheOperationLatency   *gmetrics.HistogramVec
	storageOperations       *gmetrics.CounterVec
	storageOperationLatency *gmetrics.HistogramVec
	eventPublishes          *gmetrics.CounterVec
	eventPublishLatency     *gmetrics.HistogramVec
{{- if .Components.Mail }}
	mailSends        *gmetrics.CounterVec
	mailSendLatency  *gmetrics.HistogramVec
{{- end }}
}

// NewManager creates the default app metrics manager.
func NewManager() *Manager {
	registry := gmetrics.NewRegistry()

	return &Manager{
		registry: registry,
		httpRequests: registry.MustCounter(gmetrics.Descriptor{
			Name: "http.requests",
			Help: "Total HTTP requests served by the application.",
			Kind: gmetrics.KindCounter,
		}),
		httpInflight: registry.MustGauge(gmetrics.Descriptor{
			Name: "http.requests.inflight",
			Help: "Current in-flight HTTP requests.",
			Kind: gmetrics.KindGauge,
		}),
		httpClientErrors: registry.MustCounter(gmetrics.Descriptor{
			Name: "http.responses.client_errors",
			Help: "Total HTTP 4xx responses served by the application.",
			Kind: gmetrics.KindCounter,
		}),
		httpServerErrors: registry.MustCounter(gmetrics.Descriptor{
			Name: "http.responses.server_errors",
			Help: "Total HTTP 5xx responses served by the application.",
			Kind: gmetrics.KindCounter,
		}),
		httpDuration: registry.MustHistogram(gmetrics.Descriptor{
			Name: "http.request.duration",
			Help: "HTTP request latency.",
			Kind: gmetrics.KindHistogram,
			Unit: gmetrics.UnitSeconds,
		}, gmetrics.DurationBounds(gmetrics.DefaultDurationBounds())),
		httpRequestsByRoute: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "http.requests.by_route",
			Help: "Total HTTP requests served by the application by method, route, and status.",
			Kind: gmetrics.KindCounter,
		}, []string{"method", "route", "status"}),
		httpDurationByRoute: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "http.request.duration.by_route",
			Help: "HTTP request latency by method and route.",
			Kind: gmetrics.KindHistogram,
			Unit: gmetrics.UnitSeconds,
		}, []string{"method", "route"}, gmetrics.DurationBounds(gmetrics.DefaultDurationBounds())),
{{- if .Components.Jobs }}
		queueJobsEnqueued: registry.MustCounter(gmetrics.Descriptor{
			Name: "queue.jobs.enqueued",
			Help: "Total queue jobs accepted for enqueue.",
			Kind: gmetrics.KindCounter,
		}),
		queueJobsScheduled: registry.MustCounter(gmetrics.Descriptor{
			Name: "queue.jobs.scheduled",
			Help: "Total queue jobs accepted for delayed or scheduled execution.",
			Kind: gmetrics.KindCounter,
		}),
		queueJobsProcessed: registry.MustCounter(gmetrics.Descriptor{
			Name: "queue.jobs.processed",
			Help: "Total queue job handler attempts that completed successfully.",
			Kind: gmetrics.KindCounter,
		}),
		queueJobsFailed: registry.MustCounter(gmetrics.Descriptor{
			Name: "queue.jobs.failed",
			Help: "Total queue job handler attempts that returned an error.",
			Kind: gmetrics.KindCounter,
		}),
		queueJobsRetried: registry.MustCounter(gmetrics.Descriptor{
			Name: "queue.jobs.retried",
			Help: "Total queue job handler attempts that were scheduled for retry.",
			Kind: gmetrics.KindCounter,
		}),
		queueJobsArchived: registry.MustCounter(gmetrics.Descriptor{
			Name: "queue.jobs.archived",
			Help: "Total queue jobs that reached terminal archived failure state.",
			Kind: gmetrics.KindCounter,
		}),
		queueJobsInflight: registry.MustGaugeVec(gmetrics.Descriptor{
			Name: "queue.jobs.inflight",
			Help: "Current in-flight queue job attempts by queue.",
			Kind: gmetrics.KindGauge,
		}, []string{"queue"}),
		queueJobsByJob: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "queue.jobs.by_job",
			Help: "Total queue job events by queue, job, driver, and status.",
			Kind: gmetrics.KindCounter,
		}, []string{"queue", "job_name", "driver", "status"}),
		queueJobsInflightByJob: registry.MustGaugeVec(gmetrics.Descriptor{
			Name: "queue.jobs.inflight.by_job",
			Help: "Current in-flight queue job attempts by queue, job, and driver.",
			Kind: gmetrics.KindGauge,
		}, []string{"queue", "job_name", "driver"}),
		queueEventsByQueue: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "queue.events.by_queue",
			Help: "Total queue runtime events by queue and event kind.",
			Kind: gmetrics.KindCounter,
		}, []string{"queue", "kind"}),
		queueDurationByQueue: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "queue.job.duration.by_queue",
			Help: "Queue job processing duration by queue.",
			Kind: gmetrics.KindHistogram,
			Unit: gmetrics.UnitSeconds,
		}, []string{"queue"}, gmetrics.DurationBounds(queueDurationBounds())),
		queueDurationByJob: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "queue.job.duration.by_job",
			Help: "Queue job processing duration by queue, job, and driver.",
			Kind: gmetrics.KindHistogram,
			Unit: gmetrics.UnitSeconds,
		}, []string{"queue", "job_name", "driver"}, gmetrics.DurationBounds(queueDurationBounds())),
{{- end }}
{{- if .Components.Scheduler }}
		schedulerRuns: registry.MustCounter(gmetrics.Descriptor{
			Name: "scheduler.runs",
