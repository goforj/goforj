func requestContext(r web.Context) context.Context {
	if r == nil || r.Request() == nil {
		return context.Background()
	}
	return r.Request().Context()
}

func (m *Manager) metricSource(ctx context.Context) string {
	return metricSourceContextLabel(ctx)
}

func (m *Manager) observeDuration(histogram *gmetrics.HistogramVec, duration time.Duration, labels ...string) {
	if histogram == nil || duration <= 0 {
		return
	}
	histogram.WithLabelValues(labels...).ObserveDuration(duration)
}

func (m *Manager) cacheMetricLabels(ctx context.Context, event caches.CacheOpEvent) cacheMetricLabelSet {
	labels := cacheMetricLabelSet{
		Source:    m.metricSource(ctx),
		Name:      cacheNameLabel(event.Name),
		Driver:    cacheDriverLabel(string(event.Driver)),
		Operation: cacheOperationLabel(event.Operation),
		Status:    cacheStatusLabel(event.Err),
	}
	labels.Category = cacheCategoryLabel(labels.Operation)
	labels.HitLabel = cacheHitLabel(labels.Operation, event.Hit, event.Err)
	return labels
}

