// Manager owns the app metrics registry and framework-owned metric handles.
type Manager struct {
	registry *gmetrics.Registry
	config   Config
	mu       sync.Mutex
	httpMu   sync.RWMutex

	httpRequests        *metricCounterVec
	httpInflight        *metricGaugeVec
	httpClientErrors    *metricCounterVec
	httpServerErrors    *metricCounterVec
	httpDuration        *metricHistogramVec
	httpRequestsByRoute *metricCounterVec
	httpDurationByRoute *metricHistogramVec
	httpSourceSeries    map[string]httpSourceMetrics
	httpRouteSeries     map[httpRouteMetricKey]httpRouteMetrics
	httpRouteStatusSeries map[httpRouteStatusMetricKey]*gmetrics.Counter
{{- if and .Components.DemoApp .Components.HasDatabase }}
	monitoringSidebarRequests           *metricCounterVec
	monitoringSidebarReturned           *metricHistogramVec
	monitoringSidebarNextOffset         *metricHistogramVec
	monitoringHeartbeatRequests         *metricCounterVec
	monitoringHeartbeatRequestedIDs     *metricHistogramVec
	monitoringHeartbeatReturnedRows     *metricHistogramVec
	monitoringHeartbeatReturnedPointSets *metricHistogramVec
{{- end }}
{{- if .ProjectComponents.Auth }}
	authFlows           *metricCounterVec
	authFlowLatency     *metricHistogramVec
{{- end }}
{{- if .ProjectComponents.Jobs }}
	queueJobsEnqueued    *metricCounterVec
	queueJobsScheduled   *metricCounterVec
	queueJobsProcessed   *metricCounterVec
	queueJobsFailed      *metricCounterVec
	queueJobsRetried     *metricCounterVec
	queueJobsArchived    *metricCounterVec
	queueJobsInflight    *metricGaugeVec
	queueJobsByJob       *metricCounterVec
	queueJobsInflightByJob *metricGaugeVec
	queueEventsByQueue   *metricCounterVec
	queueDurationByQueue *metricHistogramVec
	queueDurationByJob   *metricHistogramVec
{{- end }}
{{- if .ProjectComponents.Scheduler }}
	schedulerStarted       *metricCounterVec
	schedulerRuns          *metricCounterVec
	schedulerFailures      *metricCounterVec
	schedulerSkips         *metricCounterVec
	schedulerInflight      *metricGaugeVec
	schedulerRunsByJob     *metricCounterVec
	schedulerEventsByJob   *metricCounterVec
	schedulerDurationByJob *metricHistogramVec
{{- end }}
{{- if .ProjectComponents.HasDatabase }}
	databaseOperations            *metricCounterVec
	databaseOperationLatency      *metricHistogramVec
	databaseQueriesByFingerprint *metricCounterVec
	databaseQueryFingerprintInfo *metricGaugeVec
	databaseSlowQueries           *metricCounterVec
	databaseSlowQueryLatency      *metricHistogramVec
	databasePoolOpen              *metricGaugeVec
	databasePoolInUse             *metricGaugeVec
	databasePoolIdle              *metricGaugeVec
	databasePoolWaitCount         *metricCounterVec
	databasePoolWaitDuration      *metricCounterVec
	databasePoolMaxIdleClosed     *metricCounterVec
	databasePoolMaxIdleTimeClosed *metricCounterVec
	databasePoolMaxLifetimeClosed *metricCounterVec
	databasePoolSnapshots         map[string]databasePoolSnapshot
{{- end }}
	{{- if .ProjectComponents.Cache }}
	cacheOperations       *metricCounterVec
	cacheOperationLatency *metricHistogramVec
	{{- end }}
{{- if .ProjectComponents.Storage }}
	storageOperations       *metricCounterVec
	storageOperationLatency *metricHistogramVec
{{- end }}
{{- if .ProjectComponents.Events }}
	eventPublishes          *metricCounterVec
	eventPublishLatency     *metricHistogramVec
	eventSubscriptions      *metricCounterVec
	eventSubscribersActive  *metricGaugeVec
	eventDeliveries         *metricCounterVec
	eventDeliveriesInflight *metricGaugeVec
	eventDeliveryLatency    *metricHistogramVec
{{- end }}
	lighthouseInspectBufferDepth  *metricGaugeVec
	lighthouseInspectDropped      *metricCounterVec
	lighthouseInspectFlushes      *metricCounterVec
	lighthouseInspectFlushErrors  *metricCounterVec
	lighthouseInspectFlushSize    *metricHistogramVec
	lighthouseInspectFlushLatency *metricHistogramVec
{{- if .ProjectComponents.Mail }}
	mailSends        *metricCounterVec
	mailSendLatency  *metricHistogramVec
{{- end }}
}

// Config controls which framework metrics surfaces are active.
type Config struct {
	HTTP      bool
{{- if and .Components.DemoApp .Components.HasDatabase }}
	Monitoring bool
{{- end }}
	{{- if .ProjectComponents.Cache }}
	Cache bool
	{{- end }}
{{- if .ProjectComponents.Storage }}
	Storage   bool
{{- end }}
{{- if .ProjectComponents.Events }}
	Events    bool
{{- end }}
{{- if .ProjectComponents.Mail }}
	Mail      bool
{{- end }}
{{- if .ProjectComponents.Jobs }}
	Queue     bool
{{- end }}
{{- if .ProjectComponents.HasDatabase }}
	Database  bool
{{- end }}
{{- if .ProjectComponents.Auth }}
	Auth      bool
{{- end }}
{{- if .ProjectComponents.Scheduler }}
	Scheduler bool
{{- end }}
}

type httpSourceMetrics struct {
	inflight     *gmetrics.Gauge
	requests     *gmetrics.Counter
	duration     *gmetrics.Histogram
	clientErrors *gmetrics.Counter
	serverErrors *gmetrics.Counter
}

type httpRouteMetrics struct {
	duration *gmetrics.Histogram
}

type httpRouteMetricKey struct {
	source string
	method string
	route  string
}

type httpRouteStatusMetricKey struct {
	source string
	method string
	route  string
	status string
}

type sourceNameRequestContext interface {
	AppSourceName() string
}

type metricRegistry struct {
	appName string
	registry  *gmetrics.Registry
}

type metricCounterVec struct {
	appName string
	vec       *gmetrics.CounterVec
}

type metricGaugeVec struct {
	appName string
	vec       *gmetrics.GaugeVec
}

type metricHistogramVec struct {
	appName string
	vec       *gmetrics.HistogramVec
}

func (r metricRegistry) MustCounterVec(desc gmetrics.Descriptor, labelKeys []string) *metricCounterVec {
	return &metricCounterVec{
		appName: r.appName,
		vec:       r.registry.MustCounterVec(desc, labelKeys),
	}
}

func (r metricRegistry) MustGaugeVec(desc gmetrics.Descriptor, labelKeys []string) *metricGaugeVec {
	return &metricGaugeVec{
		appName: r.appName,
		vec:       r.registry.MustGaugeVec(desc, labelKeys),
	}
}

func (r metricRegistry) MustHistogramVec(desc gmetrics.Descriptor, labelKeys []string, bounds []int64) *metricHistogramVec {
	return &metricHistogramVec{
		appName: r.appName,
		vec:       r.registry.MustHistogramVec(desc, labelKeys, bounds),
	}
}

func (v *metricCounterVec) WithLabelValues(values ...string) *gmetrics.Counter {
	return v.vec.WithLabelValues(metricLabelValues(v.appName, values...)...)
}

func (v *metricGaugeVec) WithLabelValues(values ...string) *gmetrics.Gauge {
	return v.vec.WithLabelValues(metricLabelValues(v.appName, values...)...)
}

func (v *metricHistogramVec) WithLabelValues(values ...string) *gmetrics.Histogram {
	return v.vec.WithLabelValues(metricLabelValues(v.appName, values...)...)
}

// NewConfig resolves framework metrics config from environment.
func NewConfig() Config {
	return Config{
		HTTP:      env.GetBool("METRICS_HTTP_ENABLED", "true"),
{{- if and .Components.DemoApp .Components.HasDatabase }}
		Monitoring: runtime.CurrentApp().Components.DemoApp && runtime.CurrentApp().Components.HasDatabase() && env.GetBool("METRICS_MONITORING_ENABLED", "true"),
{{- end }}
	{{- if .ProjectComponents.Cache }}
		Cache: runtime.CurrentApp().Components.Cache && env.GetBool("METRICS_CACHE_ENABLED", "true"),
	{{- end }}
{{- if .ProjectComponents.Storage }}
		Storage:   runtime.CurrentApp().Components.Storage && env.GetBool("METRICS_STORAGE_ENABLED", "true"),
{{- end }}
{{- if .ProjectComponents.Events }}
		Events:    runtime.CurrentApp().Components.Events && env.GetBool("METRICS_EVENTS_ENABLED", "true"),
{{- end }}
{{- if .ProjectComponents.Mail }}
		Mail:      runtime.CurrentApp().Components.Mail && env.GetBool("METRICS_MAIL_ENABLED", "true"),
{{- end }}
{{- if .ProjectComponents.Jobs }}
		Queue:     runtime.CurrentApp().Components.Jobs && env.GetBool("METRICS_QUEUE_ENABLED", "true"),
{{- end }}
{{- if .ProjectComponents.HasDatabase }}
		Database:  runtime.CurrentApp().Components.HasDatabase() && env.GetBool("METRICS_DATABASE_ENABLED", "true"),
{{- end }}
{{- if .ProjectComponents.Auth }}
		Auth:      runtime.CurrentApp().Components.Auth && env.GetBool("METRICS_AUTH_ENABLED", "true"),
{{- end }}
{{- if .ProjectComponents.Scheduler }}
		Scheduler: runtime.CurrentApp().Components.Scheduler && env.GetBool("METRICS_SCHEDULER_ENABLED", "true"),
{{- end }}
	}
}

// NewManager creates the default app metrics manager.
func NewManager() *Manager {
	return NewManagerWithConfig(NewConfig())
}

// NewManagerWithConfig creates a metrics manager with the provided config.
func NewManagerWithConfig(config Config) *Manager {
	baseRegistry := gmetrics.NewRegistry()
	appName := metricAppLabel(runtime.CurrentApp().Name)
	registry := metricRegistry{appName: appName, registry: baseRegistry}

	return &Manager{
		registry: baseRegistry,
		config:   config,
		httpRequests: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "http.requests",
			Help: "Total HTTP requests served by the application.",
			Kind: gmetrics.KindCounter,
		}, metricLabelKeys("source")),
		httpInflight: registry.MustGaugeVec(gmetrics.Descriptor{
			Name: "http.requests.inflight",
			Help: "Current in-flight HTTP requests.",
			Kind: gmetrics.KindGauge,
		}, metricLabelKeys("source")),
		httpClientErrors: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "http.responses.client_errors",
			Help: "Total HTTP 4xx responses served by the application.",
			Kind: gmetrics.KindCounter,
		}, metricLabelKeys("source")),
		httpServerErrors: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "http.responses.server_errors",
			Help: "Total HTTP 5xx responses served by the application.",
			Kind: gmetrics.KindCounter,
		}, metricLabelKeys("source")),
		httpDuration: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "http.request.duration",
			Help: "HTTP request latency.",
			Kind: gmetrics.KindHistogram,
			Unit: gmetrics.UnitSeconds,
		}, metricLabelKeys("source"), gmetrics.DurationBounds(gmetrics.DefaultDurationBounds())),
		httpRequestsByRoute: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "http.requests.by_route",
			Help: "Total HTTP requests served by the application by source, method, route, and status.",
			Kind: gmetrics.KindCounter,
		}, metricLabelKeys("source", "method", "route", "status")),
		httpDurationByRoute: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "http.request.duration.by_route",
			Help: "HTTP request latency by source, method, and route.",
			Kind: gmetrics.KindHistogram,
			Unit: gmetrics.UnitSeconds,
		}, metricLabelKeys("source", "method", "route"), gmetrics.DurationBounds(gmetrics.DefaultDurationBounds())),
		httpSourceSeries:      make(map[string]httpSourceMetrics),
		httpRouteSeries:       make(map[httpRouteMetricKey]httpRouteMetrics),
		httpRouteStatusSeries: make(map[httpRouteStatusMetricKey]*gmetrics.Counter),
{{- if and .Components.DemoApp .Components.HasDatabase }}
		monitoringSidebarRequests: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "monitoring.sidebar.requests",
			Help: "Total sidebar page requests by source, filtered state, and pagination state.",
			Kind: gmetrics.KindCounter,
		}, metricLabelKeys("source", "filtered", "has_more")),
		monitoringSidebarReturned: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "monitoring.sidebar.rows_returned",
			Help: "Sidebar page row counts by source and filtered state.",
			Kind: gmetrics.KindHistogram,
		}, metricLabelKeys("source", "filtered"), []int64{1, 10, 25, 50, 100, 150, 200, 250}),
		monitoringSidebarNextOffset: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "monitoring.sidebar.next_offset",
			Help: "Sidebar pagination next-offset values by source and filtered state.",
			Kind: gmetrics.KindHistogram,
		}, metricLabelKeys("source", "filtered"), []int64{0, 50, 100, 200, 400, 800, 1200, 2000}),
		monitoringHeartbeatRequests: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "monitoring.heartbeats.requests",
			Help: "Total heartbeat payload requests by source and scope.",
			Kind: gmetrics.KindCounter,
		}, metricLabelKeys("source", "scope")),
		monitoringHeartbeatRequestedIDs: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "monitoring.heartbeats.requested_ids",
			Help: "Requested monitor-id counts per heartbeat payload by source and scope.",
			Kind: gmetrics.KindHistogram,
		}, metricLabelKeys("source", "scope"), []int64{0, 1, 5, 10, 20, 40, 60, 100, 200}),
		monitoringHeartbeatReturnedRows: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "monitoring.heartbeats.rows_returned",
			Help: "Returned heartbeat row counts by source and scope.",
			Kind: gmetrics.KindHistogram,
		}, metricLabelKeys("source", "scope"), []int64{0, 1, 5, 10, 20, 40, 60, 100, 200}),
		monitoringHeartbeatReturnedPointSets: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "monitoring.heartbeats.point_sets_returned",
			Help: "Returned heartbeat point-set counts by source and scope.",
			Kind: gmetrics.KindHistogram,
		}, metricLabelKeys("source", "scope"), []int64{0, 1, 5, 10, 20, 40, 60, 100, 200}),
{{- end }}
{{- if .ProjectComponents.Auth }}
		authFlows: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "auth.flows",
			Help: "Total auth lifecycle flow outcomes by flow, status, reason, and provider.",
			Kind: gmetrics.KindCounter,
		}, metricLabelKeys("flow", "status", "reason", "provider")),
		authFlowLatency: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "auth.flow.duration",
			Help: "Auth lifecycle flow latency by flow, status, and provider.",
			Kind: gmetrics.KindHistogram,
			Unit: gmetrics.UnitSeconds,
		}, metricLabelKeys("flow", "status", "provider"), gmetrics.DurationBounds(authDurationBounds())),
{{- end }}
{{- if .ProjectComponents.Jobs }}
