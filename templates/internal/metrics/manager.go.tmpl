			Name: "queue.jobs.scheduled",
			Help: "Total queue jobs accepted for delayed or scheduled execution by source.",
			Kind: gmetrics.KindCounter,
		}, metricLabelKeys("source")),
		queueJobsProcessed: registry.MustCounterVec(gmetrics.Descriptor{
