func metricSourceContextLabel(ctx context.Context) string {
	source := app.SourceFromContext(ctx)
	if strings.TrimSpace(string(source)) == "" {
		return "app"
	}
	return metricSourceLabel(string(source))
}

func shouldTrackHTTPRequest(r web.Context) bool {
	if r == nil {
		return false
	}
	uri := strings.TrimSpace(r.URI())
	switch {
	case uri == "/metrics":
		return false
	case strings.HasPrefix(uri, "/lighthouse/"):
		return false
	}
	if strings.EqualFold(strings.TrimSpace(r.Header("Upgrade")), "websocket") {
		return false
	}
	if strings.Contains(strings.ToLower(strings.TrimSpace(r.Header("Connection"))), "upgrade") &&
		strings.EqualFold(strings.TrimSpace(r.Header("Upgrade")), "websocket") {
		return false
	}
	return true
}

func metricSourceLabel(source string) string {
	source = strings.TrimSpace(strings.ToLower(source))
	switch source {
	case "http", "scheduler", "jobs", "cli", "startup", "app":
		return source
	default:
		return "app"
	}
}

func httpMethodLabel(r web.Context) string {
	if r == nil {
		return "UNKNOWN"
	}
	method := strings.ToUpper(strings.TrimSpace(r.Method()))
	if method == "" {
		return "UNKNOWN"
	}
	return method
}

func httpRouteLabel(r web.Context) string {
	if r == nil {
		return "unknown"
	}
	route := strings.TrimSpace(r.Path())
	if route != "" {
		return route
	}
	if req := r.Request(); req != nil && req.URL != nil {
		if path := strings.TrimSpace(req.URL.Path); path != "" {
			return path
		}
	}
	return "unknown"
}

