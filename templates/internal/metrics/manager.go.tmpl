	}
	return method
}

func httpRouteLabel(r web.Context) string {
	if r == nil {
		return "unknown"
	}
	route := strings.TrimSpace(r.Path())
	if route != "" {
		return route
	}
	uri := strings.TrimSpace(r.URI())
	if uri == "" {
		return "unknown"
	}
	if path, _, _ := strings.Cut(uri, "?"); strings.TrimSpace(path) != "" {
		return strings.TrimSpace(path)
	}
	return "unknown"
}

