package metrics

import (
	"context"
	"{{.GoModuleName}}/internal/app"
	"{{.GoModuleName}}/internal/caches"
	"{{.GoModuleName}}/internal/storages"
{{- if .Components.HasDatabase }}
	"database/sql"
{{- end }}
	"errors"
	"strconv"
	"strings"
{{- if .Components.HasDatabase }}
	"sync"
{{- end }}
	"time"

	"github.com/goforj/env/v2"
	goforjcache "github.com/goforj/cache"
	gmetrics "github.com/goforj/metrics"
{{- if .Components.Jobs }}
	"github.com/goforj/queue"
{{- end }}
{{- if .Components.Scheduler }}
	schedulerx "github.com/goforj/scheduler/v2"
{{- end }}
	goforjevents "github.com/goforj/events"
{{- if .Components.Mail }}
	goforjmail "github.com/goforj/mail"
{{- end }}
	"github.com/goforj/storage"
	"github.com/goforj/web"
)

// Manager owns the app metrics registry and framework-owned metric handles.
type Manager struct {
	registry *gmetrics.Registry
	config   Config
{{- if .Components.HasDatabase }}
	mu       sync.Mutex
{{- end }}

	httpRequests        *gmetrics.CounterVec
	httpInflight        *gmetrics.GaugeVec
	httpClientErrors    *gmetrics.CounterVec
	httpServerErrors    *gmetrics.CounterVec
	httpDuration        *gmetrics.HistogramVec
	httpRequestsByRoute *gmetrics.CounterVec
	httpDurationByRoute *gmetrics.HistogramVec
{{- if and .Components.DemoApp .Components.HasDatabase }}
	monitoringSidebarRequests           *gmetrics.CounterVec
	monitoringSidebarReturned           *gmetrics.HistogramVec
	monitoringSidebarNextOffset         *gmetrics.HistogramVec
	monitoringHeartbeatRequests         *gmetrics.CounterVec
	monitoringHeartbeatRequestedIDs     *gmetrics.HistogramVec
	monitoringHeartbeatReturnedRows     *gmetrics.HistogramVec
	monitoringHeartbeatReturnedPointSets *gmetrics.HistogramVec
{{- end }}
{{- if .Components.Auth }}
	authFlows           *gmetrics.CounterVec
	authFlowLatency     *gmetrics.HistogramVec
{{- end }}
{{- if .Components.Jobs }}
	queueJobsEnqueued    *gmetrics.CounterVec
	queueJobsScheduled   *gmetrics.CounterVec
	queueJobsProcessed   *gmetrics.CounterVec
	queueJobsFailed      *gmetrics.CounterVec
	queueJobsRetried     *gmetrics.CounterVec
	queueJobsArchived    *gmetrics.CounterVec
	queueJobsInflight    *gmetrics.GaugeVec
	queueJobsByJob       *gmetrics.CounterVec
	queueJobsInflightByJob *gmetrics.GaugeVec
	queueEventsByQueue   *gmetrics.CounterVec
	queueDurationByQueue *gmetrics.HistogramVec
	queueDurationByJob   *gmetrics.HistogramVec
{{- end }}
{{- if .Components.Scheduler }}
	schedulerStarted       *gmetrics.CounterVec
	schedulerRuns          *gmetrics.CounterVec
	schedulerFailures      *gmetrics.CounterVec
	schedulerSkips         *gmetrics.CounterVec
	schedulerInflight      *gmetrics.GaugeVec
	schedulerRunsByJob     *gmetrics.CounterVec
	schedulerEventsByJob   *gmetrics.CounterVec
	schedulerDurationByJob *gmetrics.HistogramVec
{{- end }}
{{- if .Components.HasDatabase }}
	databaseOperations            *gmetrics.CounterVec
	databaseOperationLatency      *gmetrics.HistogramVec
	databaseQueriesByFingerprint *gmetrics.CounterVec
	databaseQueryFingerprintInfo *gmetrics.GaugeVec
	databaseSlowQueries           *gmetrics.CounterVec
	databaseSlowQueryLatency      *gmetrics.HistogramVec
	databasePoolOpen              *gmetrics.GaugeVec
	databasePoolInUse             *gmetrics.GaugeVec
	databasePoolIdle              *gmetrics.GaugeVec
	databasePoolWaitCount         *gmetrics.CounterVec
	databasePoolWaitDuration      *gmetrics.CounterVec
	databasePoolMaxIdleClosed     *gmetrics.CounterVec
	databasePoolMaxIdleTimeClosed *gmetrics.CounterVec
	databasePoolMaxLifetimeClosed *gmetrics.CounterVec
	databasePoolSnapshots         map[string]databasePoolSnapshot
{{- end }}
	cacheOperations         *gmetrics.CounterVec
	cacheOperationLatency   *gmetrics.HistogramVec
	storageOperations       *gmetrics.CounterVec
	storageOperationLatency *gmetrics.HistogramVec
	eventPublishes          *gmetrics.CounterVec
	eventPublishLatency     *gmetrics.HistogramVec
	eventSubscriptions      *gmetrics.CounterVec
	eventSubscribersActive  *gmetrics.GaugeVec
	eventDeliveries         *gmetrics.CounterVec
	eventDeliveriesInflight *gmetrics.GaugeVec
	eventDeliveryLatency    *gmetrics.HistogramVec
	lighthouseInspectBufferDepth  *gmetrics.GaugeVec
	lighthouseInspectDropped      *gmetrics.CounterVec
	lighthouseInspectFlushes      *gmetrics.CounterVec
	lighthouseInspectFlushErrors  *gmetrics.CounterVec
	lighthouseInspectFlushSize    *gmetrics.HistogramVec
	lighthouseInspectFlushLatency *gmetrics.HistogramVec
{{- if .Components.Mail }}
	mailSends        *gmetrics.CounterVec
	mailSendLatency  *gmetrics.HistogramVec
{{- end }}
}

// Config controls which framework metrics surfaces are active.
type Config struct {
	HTTP      bool
{{- if and .Components.DemoApp .Components.HasDatabase }}
	Monitoring bool
{{- end }}
	Cache     bool
	Storage   bool
	Events    bool
{{- if .Components.Mail }}
	Mail      bool
{{- end }}
{{- if .Components.Jobs }}
	Queue     bool
{{- end }}
{{- if .Components.HasDatabase }}
	Database  bool
{{- end }}
{{- if .Components.Auth }}
	Auth      bool
{{- end }}
{{- if .Components.Scheduler }}
	Scheduler bool
{{- end }}
}

// NewConfig resolves framework metrics config from environment.
func NewConfig() Config {
	return Config{
		HTTP:      env.GetBool("METRICS_HTTP_ENABLED", "true"),
{{- if and .Components.DemoApp .Components.HasDatabase }}
		Monitoring: env.GetBool("METRICS_MONITORING_ENABLED", "true"),
{{- end }}
		Cache:     env.GetBool("METRICS_CACHE_ENABLED", "true"),
		Storage:   env.GetBool("METRICS_STORAGE_ENABLED", "true"),
		Events:    env.GetBool("METRICS_EVENTS_ENABLED", "true"),
{{- if .Components.Mail }}
		Mail:      env.GetBool("METRICS_MAIL_ENABLED", "true"),
{{- end }}
{{- if .Components.Jobs }}
		Queue:     env.GetBool("METRICS_QUEUE_ENABLED", "true"),
{{- end }}
{{- if .Components.HasDatabase }}
		Database:  env.GetBool("METRICS_DATABASE_ENABLED", "true"),
{{- end }}
{{- if .Components.Auth }}
		Auth:      env.GetBool("METRICS_AUTH_ENABLED", "true"),
{{- end }}
{{- if .Components.Scheduler }}
		Scheduler: env.GetBool("METRICS_SCHEDULER_ENABLED", "true"),
{{- end }}
	}
}

// NewManager creates the default app metrics manager.
func NewManager() *Manager {
	return NewManagerWithConfig(NewConfig())
}

// NewManagerWithConfig creates a metrics manager with the provided config.
func NewManagerWithConfig(config Config) *Manager {
	registry := gmetrics.NewRegistry()

	return &Manager{
		registry: registry,
		config:   config,
		httpRequests: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "http.requests",
			Help: "Total HTTP requests served by the application.",
			Kind: gmetrics.KindCounter,
		}, []string{"source"}),
		httpInflight: registry.MustGaugeVec(gmetrics.Descriptor{
			Name: "http.requests.inflight",
			Help: "Current in-flight HTTP requests.",
			Kind: gmetrics.KindGauge,
		}, []string{"source"}),
		httpClientErrors: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "http.responses.client_errors",
			Help: "Total HTTP 4xx responses served by the application.",
			Kind: gmetrics.KindCounter,
		}, []string{"source"}),
		httpServerErrors: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "http.responses.server_errors",
			Help: "Total HTTP 5xx responses served by the application.",
			Kind: gmetrics.KindCounter,
		}, []string{"source"}),
		httpDuration: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "http.request.duration",
			Help: "HTTP request latency.",
			Kind: gmetrics.KindHistogram,
			Unit: gmetrics.UnitSeconds,
		}, []string{"source"}, gmetrics.DurationBounds(gmetrics.DefaultDurationBounds())),
		httpRequestsByRoute: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "http.requests.by_route",
			Help: "Total HTTP requests served by the application by source, method, route, and status.",
			Kind: gmetrics.KindCounter,
		}, []string{"source", "method", "route", "status"}),
		httpDurationByRoute: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "http.request.duration.by_route",
			Help: "HTTP request latency by source, method, and route.",
			Kind: gmetrics.KindHistogram,
			Unit: gmetrics.UnitSeconds,
		}, []string{"source", "method", "route"}, gmetrics.DurationBounds(gmetrics.DefaultDurationBounds())),
{{- if and .Components.DemoApp .Components.HasDatabase }}
		monitoringSidebarRequests: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "monitoring.sidebar.requests",
			Help: "Total sidebar page requests by source, filtered state, and pagination state.",
			Kind: gmetrics.KindCounter,
		}, []string{"source", "filtered", "has_more"}),
		monitoringSidebarReturned: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "monitoring.sidebar.rows_returned",
			Help: "Sidebar page row counts by source and filtered state.",
			Kind: gmetrics.KindHistogram,
		}, []string{"source", "filtered"}, []int64{1, 10, 25, 50, 100, 150, 200, 250}),
		monitoringSidebarNextOffset: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "monitoring.sidebar.next_offset",
			Help: "Sidebar pagination next-offset values by source and filtered state.",
			Kind: gmetrics.KindHistogram,
		}, []string{"source", "filtered"}, []int64{0, 50, 100, 200, 400, 800, 1200, 2000}),
		monitoringHeartbeatRequests: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "monitoring.heartbeats.requests",
			Help: "Total heartbeat payload requests by source and scope.",
			Kind: gmetrics.KindCounter,
		}, []string{"source", "scope"}),
		monitoringHeartbeatRequestedIDs: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "monitoring.heartbeats.requested_ids",
			Help: "Requested monitor-id counts per heartbeat payload by source and scope.",
			Kind: gmetrics.KindHistogram,
		}, []string{"source", "scope"}, []int64{0, 1, 5, 10, 20, 40, 60, 100, 200}),
		monitoringHeartbeatReturnedRows: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "monitoring.heartbeats.rows_returned",
			Help: "Returned heartbeat row counts by source and scope.",
			Kind: gmetrics.KindHistogram,
		}, []string{"source", "scope"}, []int64{0, 1, 5, 10, 20, 40, 60, 100, 200}),
		monitoringHeartbeatReturnedPointSets: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "monitoring.heartbeats.point_sets_returned",
			Help: "Returned heartbeat point-set counts by source and scope.",
			Kind: gmetrics.KindHistogram,
		}, []string{"source", "scope"}, []int64{0, 1, 5, 10, 20, 40, 60, 100, 200}),
{{- end }}
{{- if .Components.Auth }}
		authFlows: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "auth.flows",
			Help: "Total auth lifecycle flow outcomes by flow, status, reason, and provider.",
			Kind: gmetrics.KindCounter,
		}, []string{"flow", "status", "reason", "provider"}),
		authFlowLatency: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "auth.flow.duration",
			Help: "Auth lifecycle flow latency by flow, status, and provider.",
			Kind: gmetrics.KindHistogram,
			Unit: gmetrics.UnitSeconds,
		}, []string{"flow", "status", "provider"}, gmetrics.DurationBounds(authDurationBounds())),
{{- end }}
{{- if .Components.Jobs }}
		queueJobsEnqueued: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "queue.jobs.enqueued",
			Help: "Total queue jobs accepted for enqueue by source.",
			Kind: gmetrics.KindCounter,
		}, []string{"source"}),
		queueJobsScheduled: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "queue.jobs.scheduled",
			Help: "Total queue jobs accepted for delayed or scheduled execution by source.",
			Kind: gmetrics.KindCounter,
		}, []string{"source"}),
		queueJobsProcessed: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "queue.jobs.processed",
			Help: "Total queue job handler attempts that completed successfully by source.",
			Kind: gmetrics.KindCounter,
		}, []string{"source"}),
		queueJobsFailed: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "queue.jobs.failed",
			Help: "Total queue job handler attempts that returned an error by source.",
			Kind: gmetrics.KindCounter,
		}, []string{"source"}),
		queueJobsRetried: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "queue.jobs.retried",
			Help: "Total queue job handler attempts that were scheduled for retry by source.",
			Kind: gmetrics.KindCounter,
		}, []string{"source"}),
		queueJobsArchived: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "queue.jobs.archived",
			Help: "Total queue jobs that reached terminal archived failure state by source.",
			Kind: gmetrics.KindCounter,
		}, []string{"source"}),
		queueJobsInflight: registry.MustGaugeVec(gmetrics.Descriptor{
			Name: "queue.jobs.inflight",
			Help: "Current in-flight queue job attempts by source and queue.",
			Kind: gmetrics.KindGauge,
		}, []string{"source", "queue"}),
		queueJobsByJob: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "queue.jobs.by_job",
			Help: "Total queue job events by source, queue, job, driver, and status.",
			Kind: gmetrics.KindCounter,
		}, []string{"source", "queue", "job_name", "driver", "status"}),
		queueJobsInflightByJob: registry.MustGaugeVec(gmetrics.Descriptor{
			Name: "queue.jobs.inflight.by_job",
			Help: "Current in-flight queue job attempts by source, queue, job, and driver.",
			Kind: gmetrics.KindGauge,
		}, []string{"source", "queue", "job_name", "driver"}),
		queueEventsByQueue: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "queue.events.by_queue",
			Help: "Total queue events by source, queue, and event kind.",
			Kind: gmetrics.KindCounter,
		}, []string{"source", "queue", "kind"}),
		queueDurationByQueue: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "queue.job.duration.by_queue",
			Help: "Queue job processing duration by source and queue.",
			Kind: gmetrics.KindHistogram,
			Unit: gmetrics.UnitSeconds,
		}, []string{"source", "queue"}, gmetrics.DurationBounds(queueDurationBounds())),
		queueDurationByJob: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "queue.job.duration.by_job",
			Help: "Queue job processing duration by source, queue, job, and driver.",
			Kind: gmetrics.KindHistogram,
			Unit: gmetrics.UnitSeconds,
		}, []string{"source", "queue", "job_name", "driver"}, gmetrics.DurationBounds(queueDurationBounds())),
{{- end }}
{{- if .Components.Scheduler }}
		schedulerStarted: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "scheduler.started",
			Help: "Total scheduler job attempts that started execution.",
			Kind: gmetrics.KindCounter,
		}, []string{"source"}),
		schedulerRuns: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "scheduler.runs",
			Help: "Total scheduler jobs that completed successfully.",
			Kind: gmetrics.KindCounter,
		}, []string{"source"}),
		schedulerFailures: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "scheduler.failures",
			Help: "Total scheduler jobs that failed.",
			Kind: gmetrics.KindCounter,
		}, []string{"source"}),
		schedulerSkips: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "scheduler.skips",
			Help: "Total scheduler jobs that were skipped.",
			Kind: gmetrics.KindCounter,
		}, []string{"source"}),
		schedulerInflight: registry.MustGaugeVec(gmetrics.Descriptor{
			Name: "scheduler.jobs.inflight",
			Help: "Current in-flight scheduler job attempts by source, job name, and target kind.",
			Kind: gmetrics.KindGauge,
		}, []string{"source", "job_name", "target_kind"}),
		schedulerRunsByJob: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "scheduler.runs.by_job",
			Help: "Total scheduler job outcomes by source, job name, and status.",
			Kind: gmetrics.KindCounter,
		}, []string{"source", "job_name", "status"}),
		schedulerEventsByJob: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "scheduler.events.by_job",
			Help: "Total scheduler job lifecycle events by source, job name, target kind, status, and reason.",
			Kind: gmetrics.KindCounter,
		}, []string{"source", "job_name", "target_kind", "status", "reason"}),
		schedulerDurationByJob: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "scheduler.job.duration.by_job",
			Help: "Scheduler job duration by source, job name, target kind, and outcome status.",
			Kind: gmetrics.KindHistogram,
			Unit: gmetrics.UnitSeconds,
		}, []string{"source", "job_name", "target_kind", "status"}, gmetrics.DurationBounds(schedulerDurationBounds())),
{{- end }}
{{- if .Components.HasDatabase }}
		databaseOperations: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "database.operations",
			Help: "Total database statements by connection, driver, operation, target, and status.",
			Kind: gmetrics.KindCounter,
		}, []string{"connection", "driver", "operation", "target", "status"}),
		databaseOperationLatency: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "database.operation.duration",
			Help: "Database statement latency by connection, driver, operation, and target.",
			Kind: gmetrics.KindHistogram,
			Unit: gmetrics.UnitSeconds,
		}, []string{"connection", "driver", "operation", "target"}, gmetrics.DurationBounds(databaseDurationBounds())),
		databaseQueriesByFingerprint: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "database.queries.by_fingerprint",
			Help: "Total database query statements by connection, driver, target, and fingerprint.",
			Kind: gmetrics.KindCounter,
		}, []string{"connection", "driver", "target", "fingerprint"}),
		databaseQueryFingerprintInfo: registry.MustGaugeVec(gmetrics.Descriptor{
			Name: "database.query_fingerprint.info",
			Help: "Lookup metadata for database query fingerprints by connection, driver, target, fingerprint, and query shape.",
			Kind: gmetrics.KindGauge,
		}, []string{"connection", "driver", "target", "fingerprint", "query_shape"}),
		databaseSlowQueries: registry.MustCounterVec(gmetrics.Descriptor{
			Name: "database.slow_queries",
			Help: "Total slow database statements by connection, driver, operation, target, status, and fingerprint.",
			Kind: gmetrics.KindCounter,
		}, []string{"connection", "driver", "operation", "target", "status", "fingerprint"}),
		databaseSlowQueryLatency: registry.MustHistogramVec(gmetrics.Descriptor{
			Name: "database.slow_query.duration",
			Help: "Slow database statement latency by connection, driver, operation, target, status, and fingerprint.",
			Kind: gmetrics.KindHistogram,
			Unit: gmetrics.UnitSeconds,
		}, []string{"connection", "driver", "operation", "target", "status", "fingerprint"}, gmetrics.DurationBounds(databaseDurationBounds())),
		databasePoolOpen: registry.MustGaugeVec(gmetrics.Descriptor{
			Name: "database.pool.open",
			Help: "Current number of open database connections by connection and driver.",
			Kind: gmetrics.KindGauge,
