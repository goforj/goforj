// RecordSchedulerJob updates framework-owned scheduler metrics from scheduler job observer events.
func (m *Manager) RecordSchedulerJob(ctx context.Context, event scheduler.JobEvent) {
	if !m.SchedulerEnabled() {
		return
	}
	source := m.metricSource(ctx)
	jobName := schedulerJobLabel(event.Name)
	targetKind := schedulerTargetKindLabel(event.TargetKind)
	reason := schedulerReasonLabel(event.Reason)
	switch event.Type {
	case scheduler.JobStarted:
		m.schedulerStarted.WithLabelValues(source).Inc()
		m.schedulerInflight.WithLabelValues(source, jobName, targetKind).Add(1)
		m.schedulerEventsByJob.WithLabelValues(source, jobName, targetKind, "started", reason).Inc()
	case scheduler.JobSucceeded:
		m.schedulerInflight.WithLabelValues(source, jobName, targetKind).Add(-1)
		m.schedulerRuns.WithLabelValues(source).Inc()
		m.schedulerRunsByJob.WithLabelValues(source, jobName, "succeeded").Inc()
		m.schedulerEventsByJob.WithLabelValues(source, jobName, targetKind, "succeeded", reason).Inc()
		if event.Duration > 0 {
			m.schedulerDurationByJob.WithLabelValues(source, jobName, targetKind, "succeeded").ObserveDuration(event.Duration)
		}
	case scheduler.JobFailed:
		m.schedulerInflight.WithLabelValues(source, jobName, targetKind).Add(-1)
		m.schedulerFailures.WithLabelValues(source).Inc()
		m.schedulerRunsByJob.WithLabelValues(source, jobName, "failed").Inc()
		m.schedulerEventsByJob.WithLabelValues(source, jobName, targetKind, "failed", reason).Inc()
		if event.Duration > 0 {
			m.schedulerDurationByJob.WithLabelValues(source, jobName, targetKind, "failed").ObserveDuration(event.Duration)
		}
	case scheduler.JobSkipped:
		m.schedulerSkips.WithLabelValues(source).Inc()
		m.schedulerRunsByJob.WithLabelValues(source, jobName, "skipped").Inc()
		m.schedulerEventsByJob.WithLabelValues(source, jobName, targetKind, "skipped", reason).Inc()
	}
}
{{- end }}

