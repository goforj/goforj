func cacheDriverLabel(driver string) string {
	driver = strings.TrimSpace(strings.ToLower(driver))
	if driver == "" {
		return "unknown"
	}
	return driver
}

func cacheOperationLabel(operation string) string {
	operation = strings.TrimSpace(strings.ToLower(operation))
	if operation == "" {
		return "other"
	}
	return operation
}

func cacheCategoryLabel(operation string) string {
	switch operation {
	case "get", "get_bytes", "get_string", "get_json", "pull", "remember", "remember_json", "remember_stale":
		return "read"
	case "set", "set_string", "set_json", "add":
		return "write"
	case "delete", "delete_many", "flush":
		return "delete"
	case "increment", "decrement":
		return "counter"
	case "try_lock", "lock", "unlock":
		return "lock"
	case "refresh_ahead":
		return "refresh"
	default:
		return "other"
	}
}

func cacheStatusLabel(err error) string {
	switch {
	case err == nil:
		return "ok"
	case errors.Is(err, goforjcache.ErrInspectorUnsupported),
		errors.Is(err, goforjcache.ErrUnsupportedCodec):
		return "unsupported"
	case errors.Is(err, goforjcache.ErrEncryptionKey),
		errors.Is(err, goforjcache.ErrValueTooLarge),
		errors.Is(err, goforjcache.ErrEncryptValueTooBig),
		errors.Is(err, goforjcache.ErrCorruptCompression),
		errors.Is(err, goforjcache.ErrDecryptFailed):
		return "invalid"
	case errors.Is(err, context.DeadlineExceeded):
		return "timeout"
	}
	if strings.Contains(strings.ToLower(err.Error()), "timeout") {
		return "timeout"
	}
	return "error"
}

