func cacheHitLabel(operation string, hit bool, err error) string {
	if err != nil {
		return "na"
	}
	switch operation {
	case "get", "get_bytes", "get_string", "get_json", "pull", "remember", "remember_json":
		if hit {
			return "hit"
		}
		return "miss"
	default:
		return "na"
	}
}

