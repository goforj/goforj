func requestContext(r web.Context) context.Context {
	if r == nil || r.Context() == nil {
		return context.Background()
	}
	return r.Context()
}

func requestMetricSource(r web.Context) string {
	if r == nil {
		return "http"
	}
	if carrier, ok := r.(sourceNameRequestContext); ok {
		if source := metricSourceLabel(carrier.AppSourceName()); source != "app" || strings.TrimSpace(carrier.AppSourceName()) != "" {
			return source
		}
	}
	return metricSourceContextLabel(requestContext(r), "http")
}

func (m *Manager) httpSourceMetrics(source string) httpSourceMetrics {
	m.httpMu.RLock()
	metrics, ok := m.httpSourceSeries[source]
	m.httpMu.RUnlock()
	if ok {
		return metrics
	}

	m.httpMu.Lock()
	defer m.httpMu.Unlock()
	if metrics, ok = m.httpSourceSeries[source]; ok {
		return metrics
	}
	metrics = httpSourceMetrics{
		inflight:     m.httpInflight.WithLabelValues(source),
		requests:     m.httpRequests.WithLabelValues(source),
		duration:     m.httpDuration.WithLabelValues(source),
		clientErrors: m.httpClientErrors.WithLabelValues(source),
		serverErrors: m.httpServerErrors.WithLabelValues(source),
	}
	m.httpSourceSeries[source] = metrics
	return metrics
}

func (m *Manager) httpRouteMetrics(source string, method string, route string) httpRouteMetrics {
	key := httpRouteMetricKey{
		source: source,
		method: method,
		route:  route,
	}

	m.httpMu.RLock()
	metrics, ok := m.httpRouteSeries[key]
	m.httpMu.RUnlock()
	if ok {
		return metrics
	}

	m.httpMu.Lock()
	defer m.httpMu.Unlock()
	if metrics, ok = m.httpRouteSeries[key]; ok {
		return metrics
	}
	metrics = httpRouteMetrics{
		duration: m.httpDurationByRoute.WithLabelValues(source, method, route),
	}
	m.httpRouteSeries[key] = metrics
	return metrics
}

func (m *Manager) httpRouteStatusCounter(source string, method string, route string, status string) *gmetrics.Counter {
	key := httpRouteStatusMetricKey{
		source: source,
		method: method,
		route:  route,
		status: status,
	}

	m.httpMu.RLock()
	counter, ok := m.httpRouteStatusSeries[key]
	m.httpMu.RUnlock()
	if ok {
		return counter
	}

	m.httpMu.Lock()
	defer m.httpMu.Unlock()
	if counter, ok = m.httpRouteStatusSeries[key]; ok {
		return counter
	}
	counter = m.httpRequestsByRoute.WithLabelValues(source, method, route, status)
	m.httpRouteStatusSeries[key] = counter
	return counter
}

func (m *Manager) metricSource(ctx context.Context) string {
	return metricSourceContextLabel(ctx, "app")
}

func (m *Manager) observeDuration(histogram *metricHistogramVec, duration time.Duration, labels ...string) {
	if histogram == nil || duration <= 0 {
		return
	}
	histogram.WithLabelValues(labels...).ObserveDuration(duration)
}


