{{- if .Components.Scheduler }}
func TestRecordSchedulerJobTracksOutcomesAndDuration(t *testing.T) {
	manager := NewManager()

	manager.RecordSchedulerJob(schedulerx.JobEvent{
		Type:       schedulerx.JobStarted,
		Name:       "monitor:poll",
		TargetKind: "handler",
	})
	manager.RecordSchedulerJob(schedulerx.JobEvent{
		Type:       schedulerx.JobSucceeded,
		Name:       "monitor:poll",
		TargetKind: "handler",
		Duration:   2 * 1e9,
	})
	manager.RecordSchedulerJob(schedulerx.JobEvent{
		Type:       schedulerx.JobStarted,
		Name:       "monitor:poll",
		TargetKind: "handler",
	})
	manager.RecordSchedulerJob(schedulerx.JobEvent{
		Type:       schedulerx.JobFailed,
		Name:       "monitor:poll",
		TargetKind: "handler",
	})
	manager.RecordSchedulerJob(schedulerx.JobEvent{
		Type:       schedulerx.JobSkipped,
		Name:       "monitor:retention",
		TargetKind: "command",
		Reason:     string(schedulerx.JobSkipPaused),
	})

	if got := counterValueByName(t, manager, "scheduler.started"); got != 2 {
		t.Fatalf("scheduler started total: got %d want 2", got)
	}
	if got := counterValueByName(t, manager, "scheduler.runs"); got != 1 {
		t.Fatalf("scheduler runs total: got %d want 1", got)
	}
	if got := counterValueByName(t, manager, "scheduler.failures"); got != 1 {
		t.Fatalf("scheduler failures total: got %d want 1", got)
	}
	if got := counterValueByName(t, manager, "scheduler.skips"); got != 1 {
		t.Fatalf("scheduler skips total: got %d want 1", got)
	}
	if got := counterValueByLabels(t, manager, "scheduler.runs.by_job", []gmetrics.Label{
		{Key: "job_name", Value: "monitor:poll"},
		{Key: "status", Value: "succeeded"},
	}); got != 1 {
		t.Fatalf("scheduler job succeeded count: got %d want 1", got)
	}
	if got := counterValueByLabels(t, manager, "scheduler.runs.by_job", []gmetrics.Label{
		{Key: "job_name", Value: "monitor:poll"},
		{Key: "status", Value: "failed"},
	}); got != 1 {
		t.Fatalf("scheduler job failed count: got %d want 1", got)
	}
	if got := counterValueByLabels(t, manager, "scheduler.runs.by_job", []gmetrics.Label{
		{Key: "job_name", Value: "monitor:retention"},
		{Key: "status", Value: "skipped"},
	}); got != 1 {
		t.Fatalf("scheduler job skipped count: got %d want 1", got)
	}
	if got := gaugeValueByLabels(t, manager, "scheduler.jobs.inflight", []gmetrics.Label{
		{Key: "job_name", Value: "monitor:poll"},
		{Key: "target_kind", Value: "handler"},
	}); got != 0 {
		t.Fatalf("scheduler inflight after terminal outcomes: got %d want 0", got)
	}
	if got := counterValueByLabels(t, manager, "scheduler.events.by_job", []gmetrics.Label{
		{Key: "job_name", Value: "monitor:poll"},
		{Key: "target_kind", Value: "handler"},
		{Key: "status", Value: "started"},
		{Key: "reason", Value: "na"},
	}); got != 2 {
		t.Fatalf("scheduler started event count: got %d want 2", got)
	}
	if got := counterValueByLabels(t, manager, "scheduler.events.by_job", []gmetrics.Label{
		{Key: "job_name", Value: "monitor:retention"},
		{Key: "target_kind", Value: "command"},
