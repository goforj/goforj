func TestRecordHTTPRequestEmitsLabeledSeries(t *testing.T) {
	manager := NewManager()
	req := httptestNewRequest(http.MethodGet, "/users/42")
	ctx := webtest.NewContext(req, nil, "/users/:id", webtest.PathParams{"id": "42"})

	manager.RecordHTTPRequest(ctx, http.StatusOK, 2)

	if got := counterValueByName(t, manager, "http.requests"); got != 1 {
		t.Fatalf("requests total: got %d want 1", got)
	}
	if got := counterValueByLabels(t, manager, "http.requests.by_route", []gmetrics.Label{
		{Key: "method", Value: "GET"},
		{Key: "route", Value: "/users/:id"},
		{Key: "status", Value: "200"},
	}); got != 1 {
		t.Fatalf("labeled request total: got %d want 1", got)
	}
	if got := histogramCountByLabels(t, manager, "http.request.duration.by_route", []gmetrics.Label{
		{Key: "method", Value: "GET"},
		{Key: "route", Value: "/users/:id"},
	}); got != 1 {
		t.Fatalf("labeled duration count: got %d want 1", got)
	}
}

