func TestHTTPMiddlewareTracksNormalRequests(t *testing.T) {
	manager := NewManager()
	req := httptestNewRequest(http.MethodGet, "/hello")
	ctx := webtest.NewContext(req, nil, "/hello", nil)

	handler := manager.HTTPMiddleware()(func(c web.Context) error {
		if got := gaugeValueByName(t, manager, "http.requests.inflight"); got != 1 {
			t.Fatalf("inflight during request: got %d want 1", got)
		}
		return c.NoContent(http.StatusOK)
	})

	assert.NoError(t, handler(ctx))
	if got := gaugeValueByName(t, manager, "http.requests.inflight"); got != 0 {
		t.Fatalf("inflight after request: got %d want 0", got)
	}
}

