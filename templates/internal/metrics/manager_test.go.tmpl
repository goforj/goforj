func TestRecordQueueEventTracksLifecycleAndDuration(t *testing.T) {
	manager := NewManager()

	manager.RecordQueueEvent(queue.Event{Kind: queue.EventEnqueueAccepted, Queue: "critical", JobType: "emails:send", Driver: queue.DriverRedis, Scheduled: true})
	manager.RecordQueueEvent(queue.Event{Kind: queue.EventProcessStarted, Queue: "critical", JobType: "emails:send", Driver: queue.DriverRedis})
	if got := gaugeValueByLabels(t, manager, "queue.jobs.inflight", []gmetrics.Label{
		{Key: "queue", Value: "critical"},
	}); got != 1 {
		t.Fatalf("queue inflight during processing: got %d want 1", got)
	}
	if got := gaugeValueByLabels(t, manager, "queue.jobs.inflight.by_job", []gmetrics.Label{
		{Key: "queue", Value: "critical"},
		{Key: "job_name", Value: "emails:send"},
		{Key: "driver", Value: "redis"},
	}); got != 1 {
		t.Fatalf("queue inflight by job during processing: got %d want 1", got)
	}
	manager.RecordQueueEvent(queue.Event{Kind: queue.EventProcessSucceeded, Queue: "critical", JobType: "emails:send", Driver: queue.DriverRedis, Duration: 2 * 1e9})

	if got := counterValueByName(t, manager, "queue.jobs.enqueued"); got != 1 {
		t.Fatalf("queue enqueued total: got %d want 1", got)
	}
	if got := counterValueByName(t, manager, "queue.jobs.scheduled"); got != 1 {
		t.Fatalf("queue scheduled total: got %d want 1", got)
	}
	if got := counterValueByName(t, manager, "queue.jobs.processed"); got != 1 {
		t.Fatalf("queue processed total: got %d want 1", got)
	}
	if got := gaugeValueByLabels(t, manager, "queue.jobs.inflight", []gmetrics.Label{
		{Key: "queue", Value: "critical"},
	}); got != 0 {
		t.Fatalf("queue inflight after success: got %d want 0", got)
	}
	if got := gaugeValueByLabels(t, manager, "queue.jobs.inflight.by_job", []gmetrics.Label{
		{Key: "queue", Value: "critical"},
		{Key: "job_name", Value: "emails:send"},
		{Key: "driver", Value: "redis"},
	}); got != 0 {
		t.Fatalf("queue inflight by job after success: got %d want 0", got)
	}
	if got := counterValueByLabels(t, manager, "queue.events.by_queue", []gmetrics.Label{
		{Key: "queue", Value: "critical"},
		{Key: "kind", Value: string(queue.EventProcessSucceeded)},
	}); got != 1 {
		t.Fatalf("queue event count: got %d want 1", got)
	}
	if got := counterValueByLabels(t, manager, "queue.jobs.by_job", []gmetrics.Label{
		{Key: "queue", Value: "critical"},
		{Key: "job_name", Value: "emails:send"},
		{Key: "driver", Value: "redis"},
		{Key: "status", Value: "enqueued"},
	}); got != 1 {
		t.Fatalf("queue by job enqueued count: got %d want 1", got)
	}
	if got := counterValueByLabels(t, manager, "queue.jobs.by_job", []gmetrics.Label{
		{Key: "queue", Value: "critical"},
		{Key: "job_name", Value: "emails:send"},
		{Key: "driver", Value: "redis"},
		{Key: "status", Value: "scheduled"},
	}); got != 1 {
		t.Fatalf("queue by job scheduled count: got %d want 1", got)
	}
	if got := counterValueByLabels(t, manager, "queue.jobs.by_job", []gmetrics.Label{
		{Key: "queue", Value: "critical"},
		{Key: "job_name", Value: "emails:send"},
		{Key: "driver", Value: "redis"},
		{Key: "status", Value: "succeeded"},
	}); got != 1 {
		t.Fatalf("queue by job succeeded count: got %d want 1", got)
	}
	if got := histogramCountByLabels(t, manager, "queue.job.duration.by_queue", []gmetrics.Label{
		{Key: "queue", Value: "critical"},
	}); got != 1 {
		t.Fatalf("queue duration count: got %d want 1", got)
	}
	if got := histogramCountByLabels(t, manager, "queue.job.duration.by_job", []gmetrics.Label{
		{Key: "queue", Value: "critical"},
		{Key: "job_name", Value: "emails:send"},
		{Key: "driver", Value: "redis"},
	}); got != 1 {
		t.Fatalf("queue duration by job count: got %d want 1", got)
	}
}

