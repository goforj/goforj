	ctx := webtest.NewContext(req, nil, "/lighthouse/ws/agent", nil)

	handler := manager.HTTPMiddleware()(func(c web.Context) error {
		if got := gaugeValueByName(t, manager, "http.requests.inflight"); got != 0 {
			t.Fatalf("inflight during websocket upgrade: got %d want 0", got)
		}
		return c.NoContent(http.StatusSwitchingProtocols)
	})

	assert.NoError(t, handler(ctx))
	if got := gaugeValueByName(t, manager, "http.requests.inflight"); got != 0 {
		t.Fatalf("inflight after websocket upgrade: got %d want 0", got)
	}
}

