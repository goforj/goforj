		{Key: "kind", Value: string(queue.EventProcessSucceeded)},
	}); got != 1 {
		t.Fatalf("queue event count: got %d want 1", got)
	}
	if got := counterValueByLabels(t, manager, "queue.jobs.by_job", []gmetrics.Label{
		{Key: "source", Value: "app"},
		{Key: "queue", Value: "critical"},
		{Key: "job_name", Value: "emails:send"},
		{Key: "driver", Value: "redis"},
		{Key: "status", Value: "enqueued"},
	}); got != 1 {
		t.Fatalf("queue by job enqueued count: got %d want 1", got)
	}
	if got := counterValueByLabels(t, manager, "queue.jobs.by_job", []gmetrics.Label{
