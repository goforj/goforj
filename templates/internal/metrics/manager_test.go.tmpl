func httptestNewRequest(method, target string) *http.Request {
	req, err := http.NewRequest(method, target, nil)
	if err != nil {
		panic(err)
	}
	return req
}

func gaugeValueByName(t *testing.T, manager *Manager, name string) int64 {
	t.Helper()
	for _, gauge := range manager.Registry().Snapshot().Gauges {
		if gauge.Descriptor.Name == name {
			return gauge.Value
		}
	}
	t.Fatalf("missing gauge %q", name)
	return 0
}

func gaugeValueByLabels(t *testing.T, manager *Manager, name string, labels []gmetrics.Label) int64 {
	t.Helper()
	for _, gauge := range manager.Registry().Snapshot().Gauges {
		if gauge.Descriptor.Name == name && sameMetricsLabels(gauge.Labels, labels) {
			return gauge.Value
		}
	}
	t.Fatalf("missing labeled gauge %q", name)
	return 0
}

func counterValueByName(t *testing.T, manager *Manager, name string) uint64 {
	t.Helper()
	for _, counter := range manager.Registry().Snapshot().Counters {
		if counter.Descriptor.Name == name {
			return counter.Value
		}
	}
	t.Fatalf("missing counter %q", name)
	return 0
}

func counterValueByLabels(t *testing.T, manager *Manager, name string, labels []gmetrics.Label) uint64 {
	t.Helper()
	for _, counter := range manager.Registry().Snapshot().Counters {
		if counter.Descriptor.Name == name && sameMetricsLabels(counter.Labels, labels) {
			return counter.Value
		}
	}
	t.Fatalf("missing labeled counter %q", name)
	return 0
}

func histogramCountByLabels(t *testing.T, manager *Manager, name string, labels []gmetrics.Label) uint64 {
	t.Helper()
	for _, histogram := range manager.Registry().Snapshot().Histograms {
		if histogram.Descriptor.Name == name && sameMetricsLabels(histogram.Labels, labels) {
			return histogram.Count
		}
	}
	t.Fatalf("missing labeled histogram %q", name)
	return 0
}

func sameMetricsLabels(a, b []gmetrics.Label) bool {
	if len(a) != len(b) {
		return false
	}
	for i := range a {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}
