func TestRecordQueueEventTracksLifecycleAndDuration(t *testing.T) {
	manager := NewManager()

	manager.RecordQueueEvent(queue.Event{Kind: queue.EventEnqueueAccepted, Queue: "critical", JobType: "emails:send", Driver: queue.DriverRedis, Scheduled: true})
	manager.RecordQueueEvent(queue.Event{Kind: queue.EventProcessStarted, Queue: "critical", JobType: "emails:send", Driver: queue.DriverRedis})
	if got := gaugeValueByLabels(t, manager, "queue.jobs.inflight", []gmetrics.Label{
		{Key: "source", Value: "app"},
		{Key: "queue", Value: "critical"},
	}); got != 1 {
		t.Fatalf("queue inflight during processing: got %d want 1", got)
	}
	if got := gaugeValueByLabels(t, manager, "queue.jobs.inflight.by_job", []gmetrics.Label{
		{Key: "source", Value: "app"},
		{Key: "queue", Value: "critical"},
		{Key: "job_name", Value: "emails:send"},
		{Key: "driver", Value: "redis"},
	}); got != 1 {
		t.Fatalf("queue inflight by job during processing: got %d want 1", got)
	}
	manager.RecordQueueEvent(queue.Event{Kind: queue.EventProcessSucceeded, Queue: "critical", JobType: "emails:send", Driver: queue.DriverRedis, Duration: 2 * 1e9})

	if got := counterValueByLabels(t, manager, "queue.jobs.enqueued", []gmetrics.Label{
		{Key: "source", Value: "app"},
	}); got != 1 {
		t.Fatalf("queue enqueued total: got %d want 1", got)
	}
	if got := counterValueByLabels(t, manager, "queue.jobs.scheduled", []gmetrics.Label{
		{Key: "source", Value: "app"},
	}); got != 1 {
		t.Fatalf("queue scheduled total: got %d want 1", got)
	}
	if got := counterValueByLabels(t, manager, "queue.jobs.processed", []gmetrics.Label{
		{Key: "source", Value: "app"},
	}); got != 1 {
		t.Fatalf("queue processed total: got %d want 1", got)
