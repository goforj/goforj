package migrations

import (
	"embed"
	"fmt"
	"io/fs"
	"path/filepath"
	"strings"

	"github.com/goforj/str"
	"gorm.io/gorm"
)

// registry holds all registered migrations
var registry []Migration

// Migration interface defines the methods that a migration must implement
type Migration interface {
	Name() string
	Connection() string
	Up(dbConn *gorm.DB) error
	Down(dbConn *gorm.DB) error
}

// RegisterMigration registers a new migration
func RegisterMigration(m Migration) {
	registry = append(registry, m)
}

// GetMigrations returns all registered migrations
func GetMigrations() []Migration {
	return registry
}

//go:embed * */*
var files embed.FS

// migrationFS is the filesystem used for migration SQL lookup.
var migrationFS fs.FS = files

// init function is called when the package is imported
func init() {
	// Register all SQL migrations found in the embedded file system
	if err := AutoRegisterMigrations(); err != nil {
		panic(err)
	}
}

// AutoRegisterMigrations automatically registers all SQL migrations
func AutoRegisterMigrations() error {
	migrationPaths := make(map[string]struct{})
	if err := fs.WalkDir(migrationFS, ".", func(path string, d fs.DirEntry, err error) error {
		if err != nil {
			return err
		}
		if d.IsDir() {
			return nil
		}
		if strings.HasSuffix(path, ".go") {
			return nil
		}
		if strings.HasSuffix(path, ".up.sql") {
			basePath := strings.TrimSuffix(path, ".up.sql")
			migrationPaths[basePath] = struct{}{}
		}
		return nil
	}); err != nil {
		return err
	}

	for basePath := range migrationPaths {
		downFilename := basePath + ".down.sql"
		if _, err := migrationFS.Open(downFilename); err != nil {
			fmt.Printf("⚠️  Warning: migration %s is missing Down file (%s)\n", basePath, downFilename)
		}

		connName, baseName := parseMigrationPath(basePath)
		registerSQLMigration(connName, baseName, basePath)
	}

	return nil
}

// GetMigrationSQL reads the SQL file from the embedded file system
func GetMigrationSQL(filename string) (string, error) {
	data, err := fs.ReadFile(migrationFS, filename)
	if err != nil {
		return "", err
	}
	return string(data), nil
}

// registerSQLMigration registers a SQL migration with the given base name
func registerSQLMigration(connection, name, pathBase string) {
	RegisterMigration(&migration{name: name, connection: connection, pathBase: pathBase})
}

// migration represents a SQL migration
type migration struct {
	name      string
	connection string
	pathBase  string
}

// Name returns the name of the migration
func (m *migration) Name() string {
	return m.name
}

// Connection returns the connection name for this migration.
func (m *migration) Connection() string {
	return m.connection
}

// Up executes the Up migration SQL
func (m *migration) Up(dbConn *gorm.DB) error {
	sql, err := GetMigrationSQL(m.pathBase + ".up.sql")
	if err != nil {
		return err
	}
	return dbConn.Exec(sql).Error
}

// Down executes the Down migration SQL
func (m *migration) Down(dbConn *gorm.DB) error {
	sql, err := GetMigrationSQL(m.pathBase + ".down.sql")
	if err != nil {
		return err
	}
	return dbConn.Exec(sql).Error
}

// parseMigrationPath returns the connection name and base filename.
func parseMigrationPath(path string) (string, string) {
	safe := str.Of(filepath.ToSlash(path)).ChopStart("./").String()
	parts := str.Of(safe).Split("/")
	if len(parts) < 2 {
		return "default", safe
	}
	return normalizeConnectionName(parts[0]), parts[len(parts)-1]
}

// normalizeConnectionName returns a trimmed, lowercase connection name.
func normalizeConnectionName(value string) string {
	name := str.Of(value).TrimSpace().ToLower()
	if name.IsEmpty() {
		return "default"
	}
	return name.String()
}
