// SeedCmd seeds monitoring targets for load testing.
type SeedCmd struct {
{{- if and .Components.DemoApp .Components.HasDatabase }}
	monitorRepo *models.MonitorRepo
{{- end }}

	Source            string `help:"Seed source (tranco, popular, file path, CSV URL, or comma-separated domains)" default:"tranco"`
	Profile           string `help:"Seed profile. Overrides source/count defaults when set." enum:"popular,top-1k,1k,top1k,top-10k,10k,top10k" default:"popular"`
	Count             int    `help:"Number of monitors to seed" default:"10000"`
	HostLimit         int    `help:"Maximum candidate hosts to resolve and validate before filtering. Defaults to 3x count when unset." default:"0"`
	Interval          int    `help:"Monitor interval in seconds" default:"60"`
	Timeout           int    `help:"Monitor timeout in milliseconds" default:"5000"`
	Tag               string `help:"Optional tag label for seeded monitors" default:"loadtest"`
	Replace           bool   `help:"Replace existing HTTP monitors that match the resolved seed targets"`
	CleanupBlocked    bool   `help:"Delete existing blocked adult/gambling HTTP monitors before seeding"`
	CleanupOnly       bool   `help:"Delete existing blocked adult/gambling HTTP monitors and exit"`
	Validate          bool   `help:"Validate targets are reachable before insert" default:"true"`
	ValidateTimeoutMS int `help:"Validation timeout in milliseconds" default:"500"`
	ValidateWorkers   int    `help:"Concurrent workers for target validation" default:"100"`
	DryRun            bool   `help:"Preview monitors without writing to the database"`
}

const monitorSeedDefaultCount = 10000

// Signature defines CLI metadata for this command.
func (*SeedCmd) Signature() string {
	return `name:"monitor:seed" help:"Seed monitoring targets for load testing"`
}

// NewSeedCmd creates a new SeedCmd.
func NewSeedCmd(
{{- if and .Components.DemoApp .Components.HasDatabase }}
	monitorRepo *models.MonitorRepo,
{{- end }}
) *SeedCmd {
	return &SeedCmd{
{{- if and .Components.DemoApp .Components.HasDatabase }}
		monitorRepo: monitorRepo,
{{- end }}
	}
}

// Run executes the command.
func (c *SeedCmd) Run(ctx context.Context) error {
	{{- if not (and .Components.DemoApp .Components.HasDatabase) }}
	console.Warnf("monitor:seed is available only when Demo App and Database components are enabled")
	return nil
	{{- end }}
	{{- if and .Components.DemoApp .Components.HasDatabase }}
	if c.CleanupOnly {
		c.CleanupBlocked = true
	}
	if c.CleanupBlocked {
		if _, _, err := c.cleanupBlockedMonitors(ctx); err != nil {
			return err
		}
		if c.CleanupOnly {
			return nil
		}
	}
	if c.Count <= 0 {
		return fmt.Errorf("count must be greater than zero")
	}
	if c.Interval <= 0 {
		c.Interval = 60
	}
	if c.Timeout <= 0 {
		c.Timeout = 5000
	}
	if c.ValidateTimeoutMS <= 0 {
		c.ValidateTimeoutMS = 500
	}
	if c.ValidateWorkers <= 0 {
		c.ValidateWorkers = 100
	}

	sourceToUse := str.Of(c.Source).TrimSpace().String()
	countToUse := c.Count
	hostLimitToUse := c.resolveHostLimit(countToUse)
	profileApplied := str.Of(c.Profile).TrimSpace().String()
	if profileApplied != "" {
		nextSource, nextCount, err := resolveSeedProfile(profileApplied, c.Count)
		if err != nil {
			return err
		}
		sourceToUse = nextSource
		countToUse = nextCount
		hostLimitToUse = c.resolveHostLimit(countToUse)
		console.Infof("seed profile applied: %s · source %s · count %d", str.Of(profileApplied).ToLower().String(), sourceToUse, countToUse)
	}

	console.Infof("resolving monitor seed source: %s", sourceToUse)
	domains, sourceLabel, err := c.resolveDomains(ctx, sourceToUse, hostLimitToUse)
	if err != nil {
		return err
	}
	if len(domains) == 0 {
		return fmt.Errorf("no seed domains found from source %q", sourceLabel)
	}
	console.Infof("seed source ready: %s · candidates %d · host limit %d", sourceLabel, len(domains), hostLimitToUse)

	existing, err := c.monitorRepo.TargetSetByType("http")
	if err != nil {
		return err
	}

	candidateTargets := make([]string, 0, countToUse*2)
	candidateSeen := make(map[string]struct{}, countToUse*2)
	skippedBlocked := 0
	skippedExisting := 0
	for _, domain := range domains {
		target := normalizeTarget(domain)
		if target == "" {
			continue
		}
		if blocked, _ := blockedSeedTarget(target); blocked {
			skippedBlocked++
			continue
		}
		if _, seen := candidateSeen[target]; seen {
			continue
		}
		candidateSeen[target] = struct{}{}
		if !c.Replace {
			if _, ok := existing[target]; ok {
				skippedExisting++
				continue
			}
		}
		if _, seen := existing[target]; seen && !c.Replace {
			skippedExisting++
			continue
		}
		candidateTargets = append(candidateTargets, target)
		if !c.Replace {
			existing[target] = struct{}{}
		}
	}

	validTargets := make([]string, 0, c.Count)
	skippedUnreachable := 0
	if c.Validate {
		total := len(candidateTargets)
		workers := seedValidationWorkerCount(c.ValidateWorkers, total)
		console.Infof("validating reachable targets · total %d · timeout %dms · workers %d", total, c.ValidateTimeoutMS, workers)
		progressStep := seedValidationProgressStep(total)
		acceptedByIndex, totalAccepted, skipped := validateTargetsConcurrently(
			candidateTargets,
			time.Duration(c.ValidateTimeoutMS)*time.Millisecond,
			workers,
			func(processed, accepted, skippedUnreachable int) {
				if processed%progressStep == 0 || processed == total {
					console.Infof(
						"validation progress · processed %d/%d · accepted %d · skipped_unreachable %d",
						processed,
						total,
						accepted,
						skippedUnreachable,
					)
				}
			},
		)
		skippedUnreachable = skipped
		for idx, target := range candidateTargets {
			if len(validTargets) >= countToUse {
				break
			}
			if !acceptedByIndex[idx] {
				continue
			}
			validTargets = append(validTargets, target)
		}
		console.Infof("validation complete · accepted %d · skipped_unreachable %d", totalAccepted, skippedUnreachable)
	} else {
		console.Infof("target validation disabled · selecting up to %d targets", countToUse)
		for _, target := range candidateTargets {
			if len(validTargets) >= countToUse {
				break
			}
			validTargets = append(validTargets, target)
		}
	}

	now := time.Now().UTC()
	seedRows := make([]models.Monitor, 0, countToUse)
		for _, target := range validTargets {
			if len(seedRows) >= countToUse {
				break
			}
			name := buildMonitorName(target, len(seedRows)+1)
			seedRows = append(seedRows, models.Monitor{
				Name:            name,
				MonitorType:     "http",
				Target:          target,
				TargetURL:       null.StringFrom(target),
			IntervalSeconds: c.Interval,
			TimeoutMs:       c.Timeout,
			RetryAttempts:   2,
			RetryBackoffMs:  250,
			ScheduleJitterMs: 150,
			Enabled:         true,
			CreatedAt:       now,
			UpdatedAt:       now,
		})
	}

	if len(seedRows) == 0 {
		console.Infof(
			"no new monitors to seed · requested %d · skipped_blocked %d · skipped_existing %d · skipped_unreachable %d · source %s",
			countToUse,
			skippedBlocked,
			skippedExisting,
			skippedUnreachable,
			sourceLabel,
		)
		return nil
	}

	if c.DryRun {
		preview := make([]string, 0, 5)
		for i := 0; i < len(seedRows) && i < 5; i++ {
			preview = append(preview, seedRows[i].Target)
		}
		console.Infof(
			"monitor seed dry-run complete · requested %d · prepared %d · skipped_blocked %d · skipped_existing %d · skipped_unreachable %d · source %s · preview %s",
			countToUse,
			len(seedRows),
			skippedBlocked,
			skippedExisting,
			skippedUnreachable,
			sourceLabel,
			strings.Join(preview, ", "),
		)
		return nil
	}

	if c.Replace {
		if err := c.monitorRepo.DeleteByTypeAndTargets("http", validTargets); err != nil {
			return err
		}
	}

	if err := c.monitorRepo.CreateBatch(seedRows); err != nil {
		return err
	}

	console.Successf(
		"monitor seed complete · requested %d · seeded %d · skipped_blocked %d · skipped_existing %d · skipped_unreachable %d · source %s · replace %t",
		countToUse,
		len(seedRows),
		skippedBlocked,
		skippedExisting,
		skippedUnreachable,
		sourceLabel,
		c.Replace,
	)
	return nil
	{{- end }}
}

func seedValidationWorkerCount(requested int, total int) int {
	if requested <= 0 {
		requested = 1
	}
	if total <= 0 {
		return 1
	}
	if requested > total {
		return total
	}
	return requested
}

type blockedSeedMonitor struct {
	ID     int64
	Name   string
	Target string
	Reason string
}

{{- if and .Components.DemoApp .Components.HasDatabase }}
func (c *SeedCmd) cleanupBlockedMonitors(ctx context.Context) (int, int, error) {
	rows, err := c.monitorRepo.WithContext(ctx).AllOrderedByName()
	if err != nil {
		return 0, 0, err
	}
	blocked := blockedSeedMonitors(rows)
	if len(blocked) == 0 {
		console.Infof("monitor seed cleanup complete · blocked 0")
		return 0, 0, nil
	}

	preview := blockedSeedMonitorPreview(blocked, 5)
	if c.DryRun {
		console.Infof("monitor seed cleanup dry-run · blocked %d · preview %s", len(blocked), preview)
		return len(blocked), 0, nil
	}

	ids := make([]int64, 0, len(blocked))
	for _, row := range blocked {
		ids = append(ids, row.ID)
	}
	if err := c.monitorRepo.DeleteByIDs(ids); err != nil {
		return len(blocked), 0, err
	}
	console.Successf("monitor seed cleanup complete · blocked %d · deleted %d · preview %s", len(blocked), len(ids), preview)
	return len(blocked), len(ids), nil
}

func blockedSeedMonitors(rows []models.Monitor) []blockedSeedMonitor {
	blocked := make([]blockedSeedMonitor, 0)
	for i := range rows {
		row := rows[i]
		if str.Of(row.MonitorType).TrimSpace().ToLower().String() != "http" {
			continue
		}
		if row.Id == 0 {
			continue
		}
		if blockedTarget, reason := blockedSeedTarget(row.Target); blockedTarget {
			blocked = append(blocked, blockedSeedMonitor{
				ID:     row.Id,
				Name:   str.Of(row.Name).TrimSpace().String(),
				Target: str.Of(row.Target).TrimSpace().String(),
				Reason: reason,
			})
		}
	}
	return blocked
}
{{- end }}

func blockedSeedMonitorPreview(rows []blockedSeedMonitor, limit int) string {
	if len(rows) == 0 {
		return "none"
	}
	if limit <= 0 {
		limit = len(rows)
	}
	if limit > len(rows) {
		limit = len(rows)
	}
	out := make([]string, 0, limit)
	for i := 0; i < limit; i++ {
		label := rows[i].Target
		if rows[i].Name != "" {
			label = rows[i].Name + " (" + rows[i].Target + ")"
		}
		if rows[i].Reason != "" {
			label += " [" + rows[i].Reason + "]"
		}
		out = append(out, label)
	}
	if len(rows) > limit {
		out = append(out, fmt.Sprintf("+%d more", len(rows)-limit))
	}
	return strings.Join(out, ", ")
}

func (c *SeedCmd) resolveHostLimit(count int) int {
	if c.HostLimit > 0 {
		return c.HostLimit
	}
	return count * 3
}

func validateTargetsConcurrently(
	targets []string,
	timeout time.Duration,
	workers int,
	onProgress func(processed, accepted, skippedUnreachable int),
) ([]bool, int, int) {
	total := len(targets)
	if total == 0 {
		return nil, 0, 0
	}
	workers = seedValidationWorkerCount(workers, total)

	type result struct {
		index int
		ok    bool
	}

	jobs := make(chan int, workers)
	results := make(chan result, workers)
	var workerWG sync.WaitGroup

	for i := 0; i < workers; i++ {
		workerWG.Add(1)
		go func() {
			defer workerWG.Done()
			for idx := range jobs {
				ok := checkTargetReachable(targets[idx], timeout)
				results <- result{index: idx, ok: ok}
			}
		}()
	}
	go func() {
		for idx := range targets {
			jobs <- idx
		}
		close(jobs)
		workerWG.Wait()
		close(results)
	}()

	acceptedByIndex := make([]bool, total)
	processed := 0
	accepted := 0
	skipped := 0
	for item := range results {
		processed++
		if item.ok {
			acceptedByIndex[item.index] = true
			accepted++
		} else {
			skipped++
		}
		if onProgress != nil {
			onProgress(processed, accepted, skipped)
		}
	}
	return acceptedByIndex, accepted, skipped
}

func checkTargetReachable(target string, timeout time.Duration) bool {
	transport := &http.Transport{
		Proxy:             http.ProxyFromEnvironment,
		DisableKeepAlives: true,
		ForceAttemptHTTP2: false,
	}
	client := &http.Client{
		Timeout:   timeout,
		Transport: transport,
	}
	getReq, err := http.NewRequest(http.MethodGet, target, nil)
	if err != nil {
		return false
	}
	getReq.Header.Set("User-Agent", "goforj-monitor-seed/1.0")
	getReq.Header.Set("Range", "bytes=0-0")
	getRes, getErr := client.Do(getReq)
	if getErr != nil {
		return false
	}
	_, _ = io.CopyN(io.Discard, getRes.Body, 1024)
	_ = getRes.Body.Close()
	return getRes.StatusCode > 0 && getRes.StatusCode < 500
}

func resolveSeedProfile(profile string, requestedCount int) (string, int, error) {
	p := str.Of(profile).TrimSpace().ToLower().String()
	switch p {
	case "popular", "brands":
		// Popular profile is a curated fixed-size set by default.
		if requestedCount == monitorSeedDefaultCount {
			return "popular", len(monitorSeedPopularDomains), nil
		}
		return "popular", requestedCount, nil
	case "top-1k", "top1k", "1k":
		if requestedCount == monitorSeedDefaultCount {
			return "tranco", 1000, nil
		}
		return "tranco", requestedCount, nil
	case "top-10k", "top10k", "10k":
		if requestedCount == monitorSeedDefaultCount {
			return "tranco", 10000, nil
		}
		return "tranco", requestedCount, nil
	default:
		return "", 0, fmt.Errorf("unsupported profile %q (use popular, top-1k, or top-10k)", profile)
	}
}

