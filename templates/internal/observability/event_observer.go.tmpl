// BeginEvent scopes producer and consumer tracing without coupling the event bus to a tracing SDK.
func (o eventObserver) BeginEvent(ctx context.Context, operation string, event events.EventDeliveryEvent) (context.Context, func(error)) {
	if operation != "send" {
		ctx = runtime.WithSource(ctx, runtime.SourceEvents)
	}
	if !o.inspects.TracingEnabled() {
		return ctx, nil
	}
	attributes := []attribute.KeyValue{attribute.String("messaging.system", string(event.Driver)), attribute.String("messaging.destination.name", event.Topic), attribute.String("messaging.operation.name", operation), attribute.String("messaging.operation.type", operation)}
	if operation == "send" {
		ctx, span := o.inspects.TracerProvider().Tracer("goforj/events").Start(ctx, "send "+event.Topic, trace.WithSpanKind(trace.SpanKindProducer), trace.WithAttributes(attributes...))
		return ctx, func(err error) {
			if err != nil {
				span.SetStatus(codes.Error, "event publication failed")
			}
			span.End()
		}
	}
	ctx = o.inspects.Begin(ctx, runtime.SourceEvents, "process "+event.Topic, map[string]string{"bus": event.Bus, "topic": event.Topic, "handler": event.Handler})
	trace.SpanFromContext(ctx).SetAttributes(attributes...)
	return ctx, func(err error) {
		status := ""
		if err != nil {
			status = "error"
		}
		o.inspects.Finish(ctx, status, err)
	}
}
