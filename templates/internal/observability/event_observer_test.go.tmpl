// TestQueueObserverJobPanicMarksExecutionError preserves the panic while closing consumer and producer scopes as failures.
func TestQueueObserverJobPanicMarksExecutionError(t *testing.T) {
	t.Setenv("LIGHTHOUSE_ENABLED", "true")
	t.Setenv("LIGHTHOUSE_INSPECT_ENABLED", "true")
	t.Setenv("QUEUE_DRIVER", "sync")
	manager := inspects.NewManager()
	defer manager.TracerProvider().Shutdown(context.Background())
	exporter := tracetest.NewInMemoryExporter()
	manager.TracerProvider().RegisterSpanProcessor(trace.NewSimpleSpanProcessor(exporter))
	jobs, err := queues.NewManagerWithObserver(nil, nil, manager)
	if err != nil {
		t.Fatal(err)
	}
	for _, instance := range jobs.Instances() {
		if err := instance.Queue.StartWorkers(context.Background()); err != nil {
			t.Fatal(err)
		}
		defer instance.Queue.Shutdown(context.Background())
	}
	jobs.Register("orders.panic", func(context.Context, queue.Message) error { panic("original job panic") })
	func() {
		defer func() {
			if value := recover(); value != "original job panic" {
				t.Errorf("panic=%v want original job panic", value)
			}
		}()
		_, _ = jobs.Dispatch(queue.NewJob("orders.panic"))
	}()
	spans := exporter.GetSpans()
	if len(spans) != 2 {
		t.Fatalf("spans=%v want producer and consumer", spans)
	}
	for _, span := range spans {
		if span.Status.Code != codes.Error {
			t.Errorf("span %s status=%v want error", span.Name, span.Status)
		}
	}
}

// TestQueueObserverFailedDispatchMarksProducerError covers enqueue failure before any consumer execution starts.
func TestQueueObserverFailedDispatchMarksProducerError(t *testing.T) {
	t.Setenv("LIGHTHOUSE_ENABLED", "true")
	t.Setenv("LIGHTHOUSE_INSPECT_ENABLED", "true")
	t.Setenv("QUEUE_DRIVER", "sync")
	manager := inspects.NewManager()
	defer manager.TracerProvider().Shutdown(context.Background())
	exporter := tracetest.NewInMemoryExporter()
	manager.TracerProvider().RegisterSpanProcessor(trace.NewSimpleSpanProcessor(exporter))
	jobs, err := queues.NewManagerWithObserver(nil, nil, manager)
	if err != nil {
		t.Fatal(err)
	}
	for _, instance := range jobs.Instances() {
		defer instance.Queue.Shutdown(context.Background())
	}
	if _, err := jobs.Dispatch(queue.NewJob("")); err == nil {
		t.Fatal("invalid job dispatched")
	}
	spans := exporter.GetSpans()
	if len(spans) != 1 || spans[0].Name != "send default" || spans[0].Status.Code != codes.Error {
		t.Fatalf("failed producer spans=%v", spans)
	}
}
