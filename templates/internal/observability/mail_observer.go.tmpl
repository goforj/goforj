package observability

{{- if .ProjectComponents.Mail }}
import (
	"context"

	"{{.GoModuleName}}/internal/inspects"
	"{{.GoModuleName}}/internal/mail"
{{- if .ProjectComponents.Metrics }}
	"{{.GoModuleName}}/internal/metrics"
{{- end }}
)

// MailObserver records mail sends through the configured observability sinks.
func MailObserver(
	inspectManager *inspects.Manager,
{{- if .ProjectComponents.Metrics }}
	metricsManager *metrics.Manager,
{{- end }}
) mail.Observer {
	return mail.ObserverFunc(func(ctx context.Context, event mail.MailSendEvent) {
		inspectManager.RecordMailEvent(ctx, inspects.MailSendInspectEvent{
			Name:     event.Name,
			Driver:   event.Driver,
			Err:      event.Err,
			Duration: event.Duration,
		})
{{- if .ProjectComponents.Metrics }}
		if metricsManager != nil {
			metricsManager.RecordMailSend(ctx, metrics.MailSendMetricEvent{
				Name:     event.Name,
				Driver:   event.Driver,
				Err:      event.Err,
				Duration: event.Duration,
			})
		}
{{- end }}
	})
}
{{- end }}
