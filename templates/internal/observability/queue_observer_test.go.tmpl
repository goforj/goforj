// TestQueueInspectEventPreservesObservedOperation verifies the observer adapter does not lose queue event fields.
func TestQueueInspectEventPreservesObservedOperation(t *testing.T) {
	expectedErr := errors.New("queue unavailable")
	expectedDuration := 31 * time.Millisecond

	event := queueInspectEvent(queue.Event{
		Kind:      queue.EventProcessRetried,
		Driver:    queue.DriverRedis,
		Queue:     "critical",
		JobType:   "emails:send",
		JobKey:    "email-42",
		Attempt:   3,
		Scheduled: true,
		Duration:  expectedDuration,
		Err:       expectedErr,
	})

	if event.Kind != string(queue.EventProcessRetried) || event.Driver != string(queue.DriverRedis) {
		t.Fatalf("queue inspect kind/driver = %#v", event)
	}
	if event.Queue != "critical" || event.JobName != "emails:send" || event.JobKey != "email-42" {
		t.Fatalf("queue inspect identity = %#v", event)
	}
	if event.Attempt != 3 || !event.Scheduled {
		t.Fatalf("queue inspect attempt/scheduled = %#v", event)
	}
	if !errors.Is(event.Err, expectedErr) || event.Duration != expectedDuration {
		t.Fatalf("queue inspect error/duration = %#v", event)
	}
}

func TestQueueWorkflowLogIncludesQueueName(t *testing.T) {
	t.Setenv("APP_LOG_FORMAT", "json")
	t.Setenv("APP_LOG_PREFIX", "Test › Jobs")
	t.Setenv("APP_LOG_TIME", "")
	t.Setenv("APP_LOG_CALLER", "")

	appLogger := logger.NewAppLogger()
	entries := make([]logger.LogEntry, 0, 1)
	appLogger.AddSink(func(entry logger.LogEntry) {
		entries = append(entries, entry)
	})
	inspectManager := inspects.NewManager()

	logQueueWorkflowEvent(appLogger, inspectManager, runtime.WithSource(context.Background(), runtime.SourceJobs), queue.Event{
		Kind:    queue.EventProcessSucceeded,
		Queue:   "reports",
		JobType: "reports:generate",
		Driver:  queue.DriverWorkerpool,
	})

	if len(entries) != 1 {
		t.Fatalf("expected 1 job log entry, got %d", len(entries))
	}
	if entries[0].Message != "Job processed" {
		t.Fatalf("expected Job processed message, got %q", entries[0].Message)
	}
	if got := entries[0].Fields["queue"]; got != "reports" {
		t.Fatalf("expected queue field %q, got %#v", "reports", got)
	}
	if got := entries[0].Fields["name"]; got != "reports:generate" {
		t.Fatalf("expected job name field %q, got %#v", "reports:generate", got)
	}
}
