package queue

import (
	"context"
	"fmt"
	"github.com/goforj/env/v2"
	"sync"
	"time"
)

type localDispatcher struct {
	driver   Driver
	mu       sync.RWMutex
	handlers map[string]Handler
	unique   map[string]time.Time
	workQueue chan queuedTask
}

type queuedTask struct {
	ctx  context.Context
	task Task
}

func newLocalDispatcher(driver Driver) Dispatcher {
	dispatcher := &localDispatcher{
		driver:   driver,
		handlers: make(map[string]Handler),
		unique:   make(map[string]time.Time),
	}
	if driver == DriverWorkerpool {
		dispatcher.startMemoryWorkers()
	}
	return dispatcher
}

func (d *localDispatcher) Driver() Driver {
	return d.driver
}

func (d *localDispatcher) Register(taskType string, handler Handler) {
	if taskType == "" || handler == nil {
		return
	}
	d.mu.Lock()
	d.handlers[taskType] = handler
	d.mu.Unlock()
}

func (d *localDispatcher) Enqueue(ctx context.Context, task Task, opts ...Option) error {
	parsed := resolveOptions(opts...)
	if task.Type == "" {
		return fmt.Errorf("task type is required")
	}
	if parsed.uniqueTTL > 0 {
		if !d.claimUnique(task, parsed.uniqueTTL) {
			return ErrDuplicate
		}
	}
	if parsed.delay <= 0 {
		return d.enqueueNow(ctx, task)
	}
	go func() {
		timer := time.NewTimer(parsed.delay)
		defer timer.Stop()
		<-timer.C
		_ = d.enqueueNow(context.Background(), task)
	}()
	return nil
}

func (d *localDispatcher) enqueueNow(ctx context.Context, task Task) error {
	if _, ok := d.lookup(task.Type); !ok {
		return fmt.Errorf("no handler registered for task type %q", task.Type)
	}
	if d.driver == DriverWorkerpool {
		return d.enqueueAsync(ctx, task)
	}
	return d.run(ctx, task)
}

func (d *localDispatcher) enqueueAsync(ctx context.Context, task Task) error {
	if d.workQueue == nil {
		return fmt.Errorf("workerpool queue not initialized")
	}
	if ctx == nil {
		ctx = context.Background()
	}
	select {
	case d.workQueue <- queuedTask{ctx: ctx, task: task}:
		return nil
	case <-ctx.Done():
		return ctx.Err()
	}
}

func (d *localDispatcher) startMemoryWorkers() {
	workers := env.GetInt("QUEUE_WORKERPOOL_WORKERS", "4")
	if workers <= 0 {
		workers = 1
	}
	bufferSize := env.GetInt("QUEUE_WORKERPOOL_BUFFER", "1024")
	if bufferSize <= 0 {
		bufferSize = workers
	}
	d.workQueue = make(chan queuedTask, bufferSize)
	for i := 0; i < workers; i++ {
		go d.worker()
	}
}

func (d *localDispatcher) worker() {
	for job := range d.workQueue {
		_ = d.run(job.ctx, job.task)
	}
}

func (d *localDispatcher) run(ctx context.Context, task Task) error {
	handler, ok := d.lookup(task.Type)
	if !ok {
		return fmt.Errorf("no handler registered for task type %q", task.Type)
	}
	return handler(ctx, task)
}

func (d *localDispatcher) lookup(taskType string) (Handler, bool) {
	d.mu.RLock()
	handler, ok := d.handlers[taskType]
	d.mu.RUnlock()
	return handler, ok
}

func (d *localDispatcher) claimUnique(task Task, ttl time.Duration) bool {
	now := time.Now()
	key := task.Type + ":" + string(task.Payload)

	d.mu.Lock()
	defer d.mu.Unlock()

	for candidate, expiresAt := range d.unique {
		if expiresAt.Before(now) {
			delete(d.unique, candidate)
		}
	}
	if expiresAt, ok := d.unique[key]; ok && expiresAt.After(now) {
		return false
	}
	d.unique[key] = now.Add(ttl)
	return true
}
