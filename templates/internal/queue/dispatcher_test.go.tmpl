package queue

import (
	"context"
	"strings"
	"testing"
)

func TestNewDispatcher_SelectsLocalForSync(t *testing.T) {
	t.Setenv("QUEUE_DRIVER", "sync")
	dispatcher := NewDispatcher(nil)

	if dispatcher.Driver() != DriverSync {
		t.Fatalf("expected sync driver, got %q", dispatcher.Driver())
	}
}

