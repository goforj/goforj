package queue

import (
	"github.com/goforj/env/v2"
	"github.com/goforj/str"
)

// Driver identifies the queue backend.
type Driver string

const (
	DriverRedis  Driver = "redis"
	DriverSync   Driver = "sync"
	DriverWorkerpool Driver = "workerpool"
)

// ActiveDriver resolves the queue driver from environment.
func ActiveDriver() Driver {
	value := str.Of(env.Get("QUEUE_DRIVER", string(DriverRedis))).
		TrimSpace().
		ToLower().
		String()

	switch Driver(value) {
	case DriverSync:
		return DriverSync
	case DriverWorkerpool:
		return DriverWorkerpool
	default:
		return DriverRedis
	}
}

// UsesRedis reports whether Redis-backed queueing is active.
func UsesRedis() bool {
	return ActiveDriver() == DriverRedis
}
