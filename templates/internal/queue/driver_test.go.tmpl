package queue

import (
	"testing"
)

func TestActiveDriver_DefaultsToRedis(t *testing.T) {
	t.Setenv("QUEUE_DRIVER", "")

	if got := ActiveDriver(); got != DriverRedis {
		t.Fatalf("expected redis driver, got %q", got)
	}
}

func TestActiveDriver_NormalizesValues(t *testing.T) {
	t.Setenv("QUEUE_DRIVER", "  SyNc ")
	if got := ActiveDriver(); got != DriverSync {
		t.Fatalf("expected sync driver, got %q", got)
	}

	t.Setenv("QUEUE_DRIVER", "workerpool")
	if got := ActiveDriver(); got != DriverWorkerpool {
		t.Fatalf("expected workerpool driver, got %q", got)
	}
}

func TestActiveDriver_InvalidFallsBackToRedis(t *testing.T) {
	t.Setenv("QUEUE_DRIVER", "unknown")
	if got := ActiveDriver(); got != DriverRedis {
		t.Fatalf("expected redis fallback, got %q", got)
	}
}

func TestUsesRedis(t *testing.T) {
	t.Setenv("QUEUE_DRIVER", "redis")
	if !UsesRedis() {
		t.Fatal("expected UsesRedis to be true")
	}

	t.Setenv("QUEUE_DRIVER", "sync")
	if UsesRedis() {
		t.Fatal("expected UsesRedis to be false")
	}
}
