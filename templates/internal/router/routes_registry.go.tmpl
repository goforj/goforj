package router

import (
	"github.com/goforj/web"
	{{if and .Components.Auth .Components.HasDatabase}}"{{.GoModuleName}}/internal/auth"{{end}}
	{{if and .Components.DemoApp .Components.HasDatabase}}"{{.GoModuleName}}/internal/appsettings"{{end}}
	"{{.GoModuleName}}/internal/hello"
	{{if and .Components.DemoApp .Components.HasDatabase}}"{{.GoModuleName}}/internal/monitoring"{{end}}
)

// Package router provides the application routes for the HTTP server.
// It defines the routes for the application and groups them into
// different categories such as app routes and authenticated routes.
// It uses the wire dependency injection framework to provide the routes
// and their controllers.

// AppRoutes is a struct that holds the routes for the application.
// can hold different groups of routes like app, admin, etc.
type AppRoutes struct {
	public    []web.Route
	protected []web.Route
}

{{if and .Components.DemoApp .Components.HasDatabase}}
func splitMonitoringRoutes(routes []web.Route) (publicRoutes []web.Route, protectedRoutes []web.Route) {
	for _, route := range routes {
		switch route.Path() {
		case "/monitoring/status-page", "/monitoring/monitors/:id/favicon", "/monitoring/monitors/:id/push":
			publicRoutes = append(publicRoutes, route)
		default:
			protectedRoutes = append(protectedRoutes, route)
		}
	}
	return publicRoutes, protectedRoutes
}
{{end}}

// ProvideAppRoutes is a function that returns a slice of routes.
func ProvideAppRoutes(
	{{if and .Components.Auth .Components.HasDatabase}}authController *auth.Controller,{{end}}
	helloController *hello.Controller,
	{{if and .Components.DemoApp .Components.HasDatabase}}appsettingsController *appsettings.Controller,{{end}}
	{{if and .Components.DemoApp .Components.HasDatabase}}monitoringController *monitoring.Controller,{{end}}
) *AppRoutes {
	var publicRoutes []web.Route
	var protectedRoutes []web.Route
	{{if and .Components.Auth .Components.HasDatabase}}
	publicRoutes = append(publicRoutes, authController.Routes()...)
	protectedRoutes = append(protectedRoutes, helloController.Routes()...)
	{{else}}
	publicRoutes = append(publicRoutes, helloController.Routes()...)
	{{end}}
	{{if and .Components.DemoApp .Components.HasDatabase}}
		{{if and .Components.Auth .Components.HasDatabase}}
	protectedRoutes = append(protectedRoutes, appsettingsController.Routes()...)
	monitoringPublicRoutes, monitoringProtectedRoutes := splitMonitoringRoutes(monitoringController.Routes())
	publicRoutes = append(publicRoutes, monitoringPublicRoutes...)
	protectedRoutes = append(protectedRoutes, monitoringProtectedRoutes...)
		{{else}}
	publicRoutes = append(publicRoutes, appsettingsController.Routes()...)
	publicRoutes = append(publicRoutes, monitoringController.Routes()...)
		{{end}}
	{{end}}
	return &AppRoutes{
		public:    publicRoutes,
		protected: protectedRoutes,
	}
}

// ProvideRoutes is a function that provides the routes for the HTTP server.
func ProvideRoutes(r *AppRoutes{{if and .Components.Auth .Components.HasDatabase}}, authService *auth.Service{{end}}) []web.RouteGroup {
	var groups []web.RouteGroup

	if len(r.public) > 0 {
		groups = append(groups, web.NewRouteGroup("/api/v1", r.public))
	}
	if len(r.protected) > 0 {
		{{if and .Components.Auth .Components.HasDatabase}}
		groups = append(groups, web.NewRouteGroup("/api/v1", r.protected, authService.RequireAuth()).WithMiddlewareNames("auth.RequireAuth"))
		{{else}}
		groups = append(groups, web.NewRouteGroup("/api/v1", r.protected))
		{{end}}
	}

	return groups
}
