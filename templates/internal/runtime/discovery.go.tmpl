// PrimitiveInstance describes a configured primitive instance for app metadata and tooling.
type PrimitiveInstance struct {
	Name      string `json:"name"`
	Driver    string `json:"driver"`
	IsDefault bool   `json:"is_default"`
}

{{ if .ProjectComponents.Cache }}
// DiscoverCacheInstances returns configured cache instances with normalized driver names.
func DiscoverCacheInstances() []PrimitiveInstance {
	if !CurrentApp().Components.Cache {
		return nil
	}
	names := aboutScopedNames("CACHE", aboutCacheRootKeys)
	out := make([]PrimitiveInstance, 0, len(names))
	for _, name := range names {
		scope := aboutPrimitiveScope("CACHE", name)
		driver := NormalizeCacheDriver(scope.Get("DRIVER", "memory"))
		if driver == "" {
			driver = "memory"
		}
		out = append(out, PrimitiveInstance{
			Name:      name,
			Driver:    driver,
			IsDefault: name == "default",
		})
	}
	return out
}
{{- end }}

