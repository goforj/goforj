// DiscoverDatabaseInstances returns configured database connections with normalized driver names.
func DiscoverDatabaseInstances() []PrimitiveInstance {
	names := aboutDatabaseNames()
	defaultName := aboutDatabaseDefaultName()
	out := make([]PrimitiveInstance, 0, len(names))
	for _, name := range names {
		out = append(out, PrimitiveInstance{
			Name:      name,
			Driver:    NormalizeDBDriver(aboutDatabaseEnv(name, "DRIVER")),
			IsDefault: name == defaultName,
		})
	}
	return out
}

// QueueDefaultQueue returns the backend queue name for the named queue instance.
func QueueDefaultQueue(name string) string {
	name = normalizedAppInstanceName(name)
	scope := aboutPrimitiveScope("QUEUE", name)
	value := strings.TrimSpace(scope.Get("NAME", ""))
	if value == "" {
		value = strings.TrimSpace(scope.Get("DEFAULT_QUEUE", ""))
	}
	if value == "" && name != "" && name != "default" {
		value = name
	}
	if value == "" {
		value = "default"
	}
	return QueuePhysicalName(value)
}

// QueuePhysicalName returns the physical backend queue name for the current app.
func QueuePhysicalName(name string) string {
	name = strings.TrimSpace(name)
	if name == "" {
		name = "default"
	}
	target := strings.TrimSpace(CurrentApp().Name)
	if target == "" || target == defaultAppName {
		return name
	}
	prefix := target + "_"
	if strings.HasPrefix(name, prefix) {
		return name
	}
	return prefix + name
}

func normalizedAppInstanceName(name string) string {
	value := strings.ToLower(strings.TrimSpace(name))
	if value == "" {
		return "default"
	}
	return value
}

{{ if .ProjectComponents.Cache }}
// NormalizeCacheDriver reduces Cache driver aliases to their generated canonical names.
func NormalizeCacheDriver(v string) string {
	driver := strings.TrimSpace(strings.ToLower(v))
	switch {
	case driver == "", driver == "-", driver == "nil", driver == "<nil>":
		return ""
	case driver == "dynamodb" || strings.Contains(driver, "dynamo"):
		return "dynamodb"
	case strings.Contains(driver, "postgres"):
		return "postgres"
	case strings.Contains(driver, "sqlite"):
		return "sqlite"
	case strings.Contains(driver, "mysql"):
		return "mysql"
	case strings.Contains(driver, "memcached"):
		return "memcached"
	case strings.Contains(driver, "redis"):
		return "redis"
	case strings.Contains(driver, "file"):
		return "file"
	case strings.Contains(driver, "null"):
		return "null"
	case strings.Contains(driver, "nats"):
		return "nats"
	case strings.Contains(driver, "sql"):
		return "sql"
	case strings.Contains(driver, "memory"), strings.Contains(driver, "inmem"), strings.Contains(driver, "in_memory"):
		return "memory"
	default:
		return driver
	}
}
{{- end }}

