package scheduler

import (
	"context"
	"os/signal"
	"syscall"
)

// Cmd is a struct that represents a command to start the scheduler.
type Cmd struct {
	scheduler  *Scheduler
	lighthouse *LighthouseRuntime
}

// NewCmd creates a new Cmd with the given logger and scheduler.
func NewCmd(scheduler *Scheduler, lighthouse *LighthouseRuntime) *Cmd {
	return &Cmd{
		scheduler:  scheduler,
		lighthouse: lighthouse,
	}
}

// Run executes the command to start the scheduler.
func (c *Cmd) Run() error {
	runCtx, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stop()
	return c.RunWithContext(runCtx)
}

// RunWithContext executes the scheduler command with a caller-provided lifecycle context.
func (c *Cmd) RunWithContext(runCtx context.Context) error {
	c.lighthouse.Start(runCtx)
	err := c.scheduler.StartWithContext(runCtx)
	if err != nil {
		return err
	}

	return nil
}
