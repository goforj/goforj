package scheduler

import (
	"context"
)

// Cmd is a struct that represents a command to start the scheduler.
type Cmd struct {
	runtime *Runtime
{{- if .Components.Metrics }}
	MetricsPort    string `help:"Port for the dedicated scheduler metrics endpoint" env:"METRICS_SCHEDULER_PORT" default:"9102" optional:""`
{{- end }}
}

// NewCmd creates a new Cmd with the given logger and scheduler.
func NewCmd(
	runtime *Runtime,
) *Cmd {
	return &Cmd{
		runtime: runtime,
	}
}

// Run executes the command to start the scheduler.
func (c *Cmd) Run(ctx context.Context) error {
	return c.runtime.RunWithConfig(ctx, RuntimeConfig{
{{- if .Components.Metrics }}
		MetricsPort: c.MetricsPort,
{{- end }}
	})
}
