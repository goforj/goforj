// ScheduleInfo describes a scheduled job for the dev console.
type ScheduleInfo struct {
	ID       string   `json:"id"`
	Name     string   `json:"name"`
	Type     string   `json:"type"`
	Schedule string   `json:"schedule"`
	Handler  string   `json:"handler"`
	HandlerRaw string `json:"handler_raw"`
	Next     string   `json:"next"`
	NextRun  string   `json:"next_run"`
	Tags     []string `json:"tags"`
	Paused   bool     `json:"paused"`
}

// StartDevConsoleAgent boots the dev console agent for the scheduler process.
func StartDevConsoleAgent(ctx context.Context, scheduler *Scheduler, logger *logger.AppLogger) {
	if !devconsole.Enabled() {
		return
	}
	agent := devconsole.NewAgent(devconsole.LoadAgentConfig("scheduler"))
	logger.AddSink(devconsole.NewLogSink(agent))
	agent.RegisterCapability("cli")
	agent.RegisterCapability("schedule")
	agent.RegisterCommand("schedule:list", func(cmd devconsole.Command) (any, error) {
		return map[string]any{
			"schedules": scheduler.ListSchedules(),
			"paused_all": scheduler.IsAllPaused(),
		}, nil
	})
	agent.RegisterCommand("schedule:pause", func(cmd devconsole.Command) (any, error) {
		params, err := devconsole.Decode[struct {
			ID string `json:"id"`
		}](cmd)
		if err != nil {
			return nil, err
		}
		if err := scheduler.PauseSchedule(params.ID); err != nil {
			return nil, err
		}
		return map[string]any{
			"schedules": scheduler.ListSchedules(),
			"paused_all": scheduler.IsAllPaused(),
		}, nil
	})
	agent.RegisterCommand("schedule:resume", func(cmd devconsole.Command) (any, error) {
		params, err := devconsole.Decode[struct {
			ID string `json:"id"`
		}](cmd)
		if err != nil {
			return nil, err
		}
		if _, err := scheduler.ResumeSchedule(params.ID); err != nil {
			return nil, err
		}
		return map[string]any{
			"schedules": scheduler.ListSchedules(),
			"paused_all": scheduler.IsAllPaused(),
		}, nil
	})
	agent.RegisterCommand("schedule:restart", func(cmd devconsole.Command) (any, error) {
		params, err := devconsole.Decode[struct {
			ID string `json:"id"`
		}](cmd)
		if err != nil {
			return nil, err
		}
		if _, err := scheduler.RestartSchedule(params.ID); err != nil {
			return nil, err
		}
		return map[string]any{
			"schedules": scheduler.ListSchedules(),
			"paused_all": scheduler.IsAllPaused(),
		}, nil
	})
	agent.RegisterCommand("schedule:pause-all", func(cmd devconsole.Command) (any, error) {
		if err := scheduler.PauseAll(); err != nil {
			return nil, err
		}
		return map[string]any{
			"schedules": scheduler.ListSchedules(),
			"paused_all": scheduler.IsAllPaused(),
		}, nil
	})
	agent.RegisterCommand("schedule:resume-all", func(cmd devconsole.Command) (any, error) {
		scheduler.ResumeAll()
		return map[string]any{
			"schedules": scheduler.ListSchedules(),
			"paused_all": scheduler.IsAllPaused(),
		}, nil
	})
	agent.RegisterCommand("cli:run", func(cmd devconsole.Command) (any, error) {
		params, err := devconsole.Decode[struct {
			Args []string `json:"args"`
		}](cmd)
		if err != nil {
			return nil, err
		}
		result, _ := devconsole.RunCLICommand(ctx, params.Args)
		return map[string]any{
			"result": result,
		}, nil
	})
	agent.RegisterCommand("cli:list", func(cmd devconsole.Command) (any, error) {
		commands, err := devconsole.ListCLICommands(ctx)
		if err != nil {
			return nil, err
		}
		return map[string]any{
			"commands": commands,
		}, nil
	})
{{- if .Components.Jobs }}
	startQueueMetricsSnapshotter(ctx, logger)
{{- end }}
	go func() {
		_ = agent.Start(ctx)
	}()
}

