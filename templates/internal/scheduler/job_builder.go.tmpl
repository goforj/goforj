package scheduler

import (
	"context"
	"os"
	"os/exec"
	"strconv"
	"strings"
	"time"
	"github.com/go-co-op/gocron/v2"
	schedulerx "github.com/goforj/scheduler"
)

// trackingScheduler wraps gocron to capture schedule specs for pause/resume.
type trackingScheduler struct {
	gocron.Scheduler
	onJob func(job gocron.Job, def gocron.JobDefinition, task gocron.Task, opts []gocron.JobOption)
}

func (t *trackingScheduler) NewJob(
	definition gocron.JobDefinition,
	task gocron.Task,
	options ...gocron.JobOption,
) (gocron.Job, error) {
	job, err := t.Scheduler.NewJob(definition, task, options...)
	if err == nil && job != nil && t.onJob != nil {
		t.onJob(job, definition, task, options)
	}
	return job, err
}

// NewJobBuilder creates the fluent scheduler using the shared goforj/scheduler module.
func NewJobBuilder(s gocron.Scheduler) *schedulerx.JobBuilder {
	tracker := &trackingScheduler{
		Scheduler: s,
		onJob: func(job gocron.Job, def gocron.JobDefinition, task gocron.Task, opts []gocron.JobOption) {
			recordScheduleSpec(job.ID().String(), scheduleSpec{
				Definition: def,
				Task:       task,
				Options:    opts,
				Name:       job.Name(),
				Tags:       job.Tags(),
			})
		},
	}
	builder := schedulerx.NewJobBuilder(tracker)
	builder.WithCommandRunner(schedulerx.CommandRunnerFunc(func(ctx context.Context, exe string, args []string) error {
		if timeout := schedulerCommandTimeout(); timeout > 0 {
			var cancel context.CancelFunc
			ctx, cancel = context.WithTimeout(ctx, timeout)
			defer cancel()
		}
		cmd := exec.CommandContext(ctx, exe, args...)
		cmd.Stdout = os.Stdout
		cmd.Stderr = os.Stderr
		cmd.Env = append(os.Environ(),
			"FORJ_COMMAND_ORIGIN=scheduler_command",
			"FORJ_SUBPROCESS=1",
		)
		return cmd.Run()
	}))
	return builder
}

func schedulerCommandTimeout() time.Duration {
	const defaultSeconds = 600
	raw := strings.TrimSpace(os.Getenv("SCHEDULER_COMMAND_TIMEOUT_SECONDS"))
	if raw == "" {
		return time.Duration(defaultSeconds) * time.Second
	}
	seconds, err := strconv.Atoi(raw)
	if err != nil || seconds <= 0 {
		return time.Duration(defaultSeconds) * time.Second
	}
	return time.Duration(seconds) * time.Second
}
