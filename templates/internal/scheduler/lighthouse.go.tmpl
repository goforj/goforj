package scheduler

import (
	"context"
	"{{.GoModuleName}}/internal/lighthouse"
	"{{.GoModuleName}}/internal/logger"
)

// ScheduleInfo describes a scheduled job for the dev console.
type ScheduleInfo struct {
	ID         string   `json:"id"`
	Name       string   `json:"name"`
	Type       string   `json:"type"`
	Schedule   string   `json:"schedule"`
	Handler    string   `json:"handler"`
	HandlerRaw string   `json:"handler_raw"`
	Next       string   `json:"next"`
	NextRun    string   `json:"next_run"`
	Tags       []string `json:"tags"`
	Paused     bool     `json:"paused"`
}

// StartLighthouseAgent boots the dev console agent for the scheduler process.
func StartLighthouseAgent(ctx context.Context, scheduler *Scheduler, logger *logger.AppLogger) {
	if !lighthouse.Enabled() {
		return
	}
	agent := lighthouse.NewAgent(lighthouse.LoadAgentConfig("scheduler"))
	logger.AddSink(lighthouse.NewLogSink(agent))
	agent.RegisterCapability("cli")
	agent.RegisterCapability("schedule")
	agent.RegisterCommand("schedule:list", func(cmd lighthouse.Command) (any, error) {
		return map[string]any{
			"schedules":  scheduler.ListSchedules(),
			"paused_all": scheduler.IsAllPaused(),
		}, nil
	})
	agent.RegisterCommand("schedule:pause", func(cmd lighthouse.Command) (any, error) {
		params, err := lighthouse.Decode[struct {
			ID string `json:"id"`
		}](cmd)
		if err != nil {
			return nil, err
		}
		if err := scheduler.PauseSchedule(params.ID); err != nil {
			return nil, err
		}
		return map[string]any{
			"schedules":  scheduler.ListSchedules(),
			"paused_all": scheduler.IsAllPaused(),
		}, nil
	})
	agent.RegisterCommand("schedule:resume", func(cmd lighthouse.Command) (any, error) {
		params, err := lighthouse.Decode[struct {
			ID string `json:"id"`
		}](cmd)
		if err != nil {
			return nil, err
		}
		if _, err := scheduler.ResumeSchedule(params.ID); err != nil {
			return nil, err
		}
		return map[string]any{
			"schedules":  scheduler.ListSchedules(),
			"paused_all": scheduler.IsAllPaused(),
		}, nil
	})
	agent.RegisterCommand("schedule:restart", func(cmd lighthouse.Command) (any, error) {
		params, err := lighthouse.Decode[struct {
			ID string `json:"id"`
		}](cmd)
		if err != nil {
			return nil, err
		}
		if _, err := scheduler.RestartSchedule(params.ID); err != nil {
			return nil, err
		}
		return map[string]any{
			"schedules":  scheduler.ListSchedules(),
			"paused_all": scheduler.IsAllPaused(),
		}, nil
	})
	agent.RegisterCommand("schedule:pause-all", func(cmd lighthouse.Command) (any, error) {
		if err := scheduler.PauseAll(); err != nil {
			return nil, err
		}
		return map[string]any{
			"schedules":  scheduler.ListSchedules(),
			"paused_all": scheduler.IsAllPaused(),
		}, nil
	})
	agent.RegisterCommand("schedule:resume-all", func(cmd lighthouse.Command) (any, error) {
		if err := scheduler.ResumeAll(); err != nil {
			return nil, err
		}
		return map[string]any{
			"schedules":  scheduler.ListSchedules(),
			"paused_all": scheduler.IsAllPaused(),
		}, nil
	})
	agent.RegisterCommand("cli:run", func(cmd lighthouse.Command) (any, error) {
		params, err := lighthouse.Decode[struct {
			Args []string `json:"args"`
		}](cmd)
		if err != nil {
			return nil, err
		}
		result, _ := lighthouse.RunCLICommand(ctx, params.Args)
		return map[string]any{"result": result}, nil
	})
	agent.RegisterCommand("cli:list", func(cmd lighthouse.Command) (any, error) {
		commands, err := lighthouse.ListCLICommands(ctx)
		if err != nil {
			return nil, err
		}
		return map[string]any{"commands": commands}, nil
	})
	go func() {
		_ = agent.Start(ctx)
	}()
}
