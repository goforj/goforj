package scheduler

import (
	"context"
	"errors"
	"os"
	"os/exec"
	"os/signal"
	"strings"
	"syscall"
	"time"

	"github.com/goforj/env/v2"
	schedulerx "github.com/goforj/scheduler/v2"
	"{{.GoModuleName}}/internal/app"
{{- if .Components.Metrics }}
	"{{.GoModuleName}}/internal/metrics"
{{- end }}
	{{- if and .Components.Auth .Components.HasDatabase }}
	"{{.GoModuleName}}/internal/auth"
	{{- end }}
	{{- if or (and .Components.DemoApp .Components.HasDatabase) (and .Components.DemoApp .Components.Jobs) }}
	"{{.GoModuleName}}/internal/monitoring"
	{{- end }}
	"{{.GoModuleName}}/internal/logger"
)

// Scheduler is a struct that represents a scheduler.
type Scheduler struct {
	logger    *logger.AppLogger
	*schedulerx.Scheduler
	appTimeouts *app.Timeouts
{{- if .Components.Metrics }}
	metrics *metrics.Manager
{{- end }}
	{{- if and .Components.Auth .Components.HasDatabase }}
	authService *auth.Service
	{{- end }}
	{{- if and .Components.DemoApp .Components.HasDatabase }}
	retentionService *monitoring.RetentionService
	{{- end }}
	{{- if and .Components.DemoApp .Components.Jobs }}
	monitorCheckJob *monitoring.MonitorCheckJob
	{{- end }}
}

// NewScheduler creates a new Scheduler.
func NewScheduler(
	logger *logger.AppLogger,
	appTimeouts *app.Timeouts,
	scheduler *schedulerx.Scheduler,
{{- if .Components.Metrics }}
	metricsManager *metrics.Manager,
{{- end }}
	{{- if and .Components.Auth .Components.HasDatabase }}
	authService *auth.Service,
	{{- end }}
	{{- if and .Components.DemoApp .Components.HasDatabase }}
	retentionService *monitoring.RetentionService,
	{{- end }}
	{{- if and .Components.DemoApp .Components.Jobs }}
	monitorCheckJob *monitoring.MonitorCheckJob,
	{{- end }}
) *Scheduler {
	componentLogger := logger
	if componentLogger != nil {
		componentLogger = componentLogger.WithComponent("Scheduler")
	}
	return &Scheduler{
		logger:    componentLogger,
		Scheduler: scheduler,
		appTimeouts: appTimeouts,
		{{- if .Components.Metrics }}
		metrics: metricsManager,
		{{- end }}
		{{- if and .Components.Auth .Components.HasDatabase }}
		authService: authService,
		{{- end }}
		{{- if and .Components.DemoApp .Components.HasDatabase }}
		retentionService: retentionService,
		{{- end }}
		{{- if and .Components.DemoApp .Components.Jobs }}
		monitorCheckJob: monitorCheckJob,
		{{- end }}
	}
}

// Start starts the scheduler.
func (s *Scheduler) Start() error {
	runCtx, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stop()
	return s.StartWithContext(runCtx)
}

// StartWithContext starts the scheduler and blocks until the context is canceled.
func (s *Scheduler) StartWithContext(runCtx context.Context) error {
	if runCtx == nil {
		runCtx = context.Background()
	}
	s.Scheduler.WithTaskContextDecorator(func(ctx context.Context) context.Context {
		return app.WithSource(ctx, app.SourceScheduler)
	})
	err := s.Register()
	if err != nil {
		return err
	}

	// start the scheduler
	s.Scheduler.Start()
	s.logger.Info().Msg("Scheduler started")

	<-runCtx.Done()
	s.logger.Info().Msg("Shutting down scheduler")

	shutdownErr := make(chan error, 1)
	go func() {
		shutdownErr <- s.Scheduler.Shutdown()
	}()
	select {
	case err = <-shutdownErr:
	case <-time.After(s.appTimeouts.ShutdownTimeout()):
		err = errors.New("scheduler shutdown timed out")
	}
	if err != nil {
		return err
	}

	s.logger.Info().Msg("Scheduler shut down")

	return nil
}

// ConfigureScheduler applies app-level scheduler command execution settings.
func ConfigureScheduler(s *schedulerx.Scheduler) *schedulerx.Scheduler {
	s.WithCommandRunner(schedulerx.CommandRunnerFunc(func(ctx context.Context, exe string, args []string) error {
		if timeout := schedulerCommandTimeout(); timeout > 0 {
			var cancel context.CancelFunc
			ctx, cancel = context.WithTimeout(ctx, timeout)
			defer cancel()
		}
		cmd := exec.CommandContext(ctx, exe, args...)
		cmd.Stdout = os.Stdout
		cmd.Stderr = os.Stderr
		cmd.Env = schedulerCommandEnv(os.Environ())
		return cmd.Run()
	}))
	return s
}

func schedulerCommandEnv(base []string) []string {
	out := make([]string, 0, len(base)+3)
	logPrefix := ""
	for _, entry := range base {
		switch {
		case strings.HasPrefix(entry, "APP_LOG_PREFIX="):
			logPrefix = strings.TrimSpace(strings.TrimPrefix(entry, "APP_LOG_PREFIX="))
		case strings.HasPrefix(entry, "FORJ_SUBPROCESS="):
		case strings.HasPrefix(entry, "FORJ_COMMAND_ORIGIN="):
		default:
			out = append(out, entry)
		}
	}
	parts := strings.SplitN(strings.TrimSpace(logPrefix), "›", 2)
	app := strings.TrimSpace(parts[0])
	if app == "" {
		app = "App"
	}
	out = append(out, "FORJ_COMMAND_ORIGIN=scheduler_command")
	out = append(out, "FORJ_SUBPROCESS=1")
	out = append(out, "APP_LOG_PREFIX="+app+" › Command")
	return out
}

func schedulerCommandTimeout() time.Duration {
	return env.GetDuration("SCHEDULER_COMMAND_TIMEOUT", "10m")
}
