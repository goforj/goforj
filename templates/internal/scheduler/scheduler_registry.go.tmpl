package scheduler

{{ $hasDemoRetention := and .Components.DemoApp .Components.HasDatabase -}}
{{ $hasDemoJobs := and .Components.DemoApp .Components.Jobs -}}
{{ $hasStressTick := and .Components.Jobs .Components.StressTest -}}
import (
	"context"

	"github.com/goforj/scheduler/v2"
{{- if $hasStressTick }}
	"github.com/goforj/env/v2"
{{- end }}
)

// Register sets up recurring scheduled handlers using the GoForj scheduler module.
// This provides a fluent API for defining tasks concisely.
// @docs https://github.com/goforj/scheduler
func (s *Scheduler) Register() error {
	s.registerJobObservers()

	// s.Every(1).Seconds().Do(func(context.Context) error {
	// 	s.logger.Info().Msg("Hello world!")
	// 	return nil
	// })

	{{- if and .Components.Auth .Components.HasDatabase }}
	s.DailyAt("04:11").Name("auth:sessions:cleanup").Do(s.inspectTask("auth:sessions:cleanup", s.authService.Cleanup))
	{{- end }}
	{{- if $hasDemoRetention }}
	s.Cron("17 3 * * *").Name("monitor:retention").Do(s.inspectTask("monitor:retention", s.retentionService.RunScheduled))
	{{- end }}
	{{- if $hasDemoJobs }}
	s.Every(30).Seconds().Name("monitor:poll").Do(s.inspectTask("monitor:poll", s.monitorCheckJob.RunScheduledPoll))
	// this pings the synthetic push monitor trigger, useful for validating push checks
	s.Every(60).Seconds().Name("monitor:push-test-trigger").Do(s.inspectTask("monitor:push-test-trigger", s.monitorCheckJob.RunScheduledPushTrigger))
	{{- end }}
	{{- if $hasStressTick }}
	if env.GetBool("STRESS_ENABLED", "false") {
		interval := env.GetInt("STRESS_INTERVAL_SECONDS", "2")
		if interval <= 0 {
			interval = 2
		}
		s.Every(interval).Seconds().Name("queue:stress:tick").Command("queue:stress:tick")
	}
	{{- end }}

	return nil
}

// registerJobObservers installs app-level defaults for scheduler job outcomes.
// App owners can expand this hook point to publish events, record metrics, or
// forward failures to notification tooling without touching each individual schedule.
func (s *Scheduler) registerJobObservers() {
	s.Observe(scheduler.JobObserverFunc(func(ctx context.Context, event scheduler.JobEvent) {
		{{- if .Components.Metrics }}
		if s.metrics != nil && s.metrics.SchedulerEnabled() {
			s.metrics.RecordSchedulerJob(ctx, event)
		}
		{{- end }}
		switch event.Type {
		case scheduler.JobSucceeded:
			if s.inspectManager != nil {
				s.inspectManager.RecordLog(ctx, "info", "scheduler job succeeded", map[string]any{
					"job_id":      event.JobID.String(),
					"name":        event.Name,
					"target_kind": event.TargetKind,
					"attempt":     event.Attempt,
					"duration_ms": event.Duration.Milliseconds(),
				})
			}
			s.logger.Debug().
				Str("job_id", event.JobID.String()).
				Str("name", event.Name).
				Str("target_kind", event.TargetKind).
				Int("attempt", event.Attempt).
				Dur("duration", event.Duration).
				Msg("scheduler job succeeded")
		case scheduler.JobFailed:
			if s.inspectManager != nil {
				s.inspectManager.RecordLog(ctx, "error", "scheduler job failed", map[string]any{
					"job_id":      event.JobID.String(),
					"name":        event.Name,
					"target_kind": event.TargetKind,
					"attempt":     event.Attempt,
					"duration_ms": event.Duration.Milliseconds(),
					"error":       errorString(event.Error),
				})
			}
			s.logger.Error().
				Err(event.Error).
				Str("job_id", event.JobID.String()).
				Str("name", event.Name).
				Str("target_kind", event.TargetKind).
				Int("attempt", event.Attempt).
				Dur("duration", event.Duration).
				Msg("scheduler job failed")
		}
	}))
}

func errorString(err error) string {
	if err == nil {
		return ""
	}
	return err.Error()
}
