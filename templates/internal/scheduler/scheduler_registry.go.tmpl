package scheduler

{{ $hasDemoRetention := and .Components.DemoApp .Components.HasDatabase -}}
{{ $hasDemoJobs := and .Components.DemoApp .Components.Jobs -}}
{{ $hasStressTick := and .Components.Jobs .Components.StressTest -}}
import (
	"github.com/goforj/scheduler/v2"
{{- if $hasStressTick }}
	"github.com/goforj/env/v2"
{{- end }}
)

// Register sets up recurring scheduled handlers using the GoForj scheduler module.
// This provides a fluent API for defining tasks concisely.
// @docs https://github.com/goforj/scheduler
func (s *Scheduler) Register() error {
	s.registerJobObservers()

	// s.Every(1).Seconds().Do(func(context.Context) error {
	// 	s.logger.Info().Msg("Hello world!")
	// 	return nil
	// })

	{{- if $hasDemoRetention }}
	s.Cron("17 3 * * *").Name("monitor:retention").Do(s.retentionService.RunScheduled)
	{{- end }}
	{{- if $hasDemoJobs }}
	s.Every(30).Seconds().Name("monitor:poll").Do(s.monitorCheckJob.RunScheduledPoll)
	// this pings the synthetic push monitor trigger, useful for validating push checks
	s.Every(60).Seconds().Name("monitor:push-test-trigger").Do(s.monitorCheckJob.RunScheduledPushTrigger)
	{{- end }}
	{{- if $hasStressTick }}
	if env.GetBool("STRESS_ENABLED", "false") {
		interval := env.GetInt("STRESS_INTERVAL_SECONDS", "2")
		if interval <= 0 {
			interval = 2
		}
		s.Every(interval).Seconds().Name("queue:stress:tick").Command("queue:stress:tick")
	}
	{{- end }}

	return nil
}

// registerJobObservers installs app-level defaults for scheduler job outcomes.
// App owners can expand this hook point to publish events, record metrics, or
// forward failures to notification tooling without touching each individual schedule.
func (s *Scheduler) registerJobObservers() {
	s.Observe(scheduler.JobObserverFunc(func(event scheduler.JobEvent) {
		switch event.Type {
		case scheduler.JobSucceeded:
			s.logger.Debug().
				Str("job_id", event.JobID.String()).
				Str("name", event.Name).
				Str("target_kind", event.TargetKind).
				Int("attempt", event.Attempt).
				Dur("duration", event.Duration).
				Msg("scheduler job succeeded")
		case scheduler.JobFailed:
			s.logger.Error().
				Err(event.Error).
				Str("job_id", event.JobID.String()).
				Str("name", event.Name).
				Str("target_kind", event.TargetKind).
				Int("attempt", event.Attempt).
				Dur("duration", event.Duration).
				Msg("scheduler job failed")
		}
	}))
}
