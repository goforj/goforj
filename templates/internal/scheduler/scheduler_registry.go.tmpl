package scheduler

{{- if and .Components.Jobs .Components.StressTest }}
import "github.com/goforj/env/v2"
{{- end }}

// Register sets up recurring scheduled commands using the GoForj scheduler module.
// This provides a fluent API for defining tasks concisely.
// @docs https://github.com/goforj/scheduler
func (s *Scheduler) Register() error {
	// s.Every(1).Seconds().Do(func() { s.logger.Info().Msg("Hello world!") })
	{{- if and .Components.DemoApp .Components.HasDatabase }}
	s.Cron("17 3 * * *").WithoutOverlapping().Command("monitor:retention")
	{{- end }}
	{{- if and .Components.DemoApp .Components.Jobs }}
	s.Every(30).Seconds().WithoutOverlapping().Command("monitor:poll")
	// this pings the synthetic push monitor trigger, useful for validating push checks
	s.Every(60).Seconds().WithoutOverlapping().Command("monitor:push-test-trigger")
	{{- end }}
	{{- if and .Components.Jobs .Components.StressTest }}
	if env.GetBool("QUEUE_STRESS_ENABLED", "false") {
		interval := env.GetInt("QUEUE_STRESS_INTERVAL_SECONDS", "2")
		if interval <= 0 {
			interval = 2
		}
		s.Every(interval).Seconds().WithoutOverlapping().Command("queue:stress:tick")
	}
	{{- end }}

	return nil
}
