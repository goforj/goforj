package schedules

import (
	"context"
	"strings"

{{- if .Components.Metrics }}
	"github.com/goforj/env/v2"
{{- end }}
	"{{.GoModuleName}}/internal/app"
	"{{.GoModuleName}}/internal/logger"
{{- if .Components.Metrics }}
	"{{.GoModuleName}}/internal/metrics"
{{- end }}
)

// RuntimeConfig describes scheduler runtime execution settings.
type RuntimeConfig struct {
	DisableMetricsEndpoint bool
{{- if .Components.Metrics }}
	MetricsPort string
{{- end }}
}

// Runtime executes the scheduler runtime with standalone-host compatible behavior.
type Runtime struct {
	logger     *logger.AppLogger
	scheduler  *Scheduler
	lighthouse *LighthouseRuntime
{{- if .Components.Metrics }}
	metricsManager *metrics.Manager
{{- end }}
	config RuntimeConfig
}

// NewRuntime creates a hostable scheduler runtime.
func NewRuntime(
	logger *logger.AppLogger,
	scheduler *Scheduler,
	lighthouse *LighthouseRuntime,
{{- if .Components.Metrics }}
	metricsManager *metrics.Manager,
{{- end }}
) *Runtime {
	return &Runtime{
		logger:     logger,
		scheduler:  scheduler,
		lighthouse: lighthouse,
{{- if .Components.Metrics }}
		metricsManager: metricsManager,
{{- end }}
		config: defaultRuntimeConfig(),
	}
}

// Identity returns the logical runtime identity for the scheduler runtime.
func (*Runtime) Identity() app.RuntimeIdentity {
	return app.RuntimeIdentity{Name: "scheduler", Label: "scheduler"}
}

// Run executes the scheduler runtime with its default config.
func (r *Runtime) Run(ctx context.Context) error {
	return r.RunWithConfig(ctx, r.config)
}

// RunWithConfig executes the scheduler runtime with explicit config.
func (r *Runtime) RunWithConfig(ctx context.Context, cfg RuntimeConfig) error {
	if ctx == nil {
		ctx = context.Background()
	}
	ctx = app.WithSource(ctx, app.SourceScheduler)
	cfg = normalizeRuntimeConfig(cfg)

{{- if .Components.Metrics }}
	if !cfg.DisableMetricsEndpoint && r.metricsManager != nil && r.metricsManager.SchedulerEnabled() && r.metricsManager.Registry() != nil {
		if err := metrics.StartPrometheusEndpoint(ctx, r.logger, "scheduler", cfg.MetricsPort, r.metricsManager.Registry()); err != nil {
			return err
		}
	}
{{- end }}
	r.lighthouse.Start(ctx)
	return r.scheduler.StartWithContext(ctx)
}

// defaultRuntimeConfig reads scheduler runtime defaults from environment.
func defaultRuntimeConfig() RuntimeConfig {
	return normalizeRuntimeConfig(RuntimeConfig{
{{- if .Components.Metrics }}
		MetricsPort: env.Get("METRICS_SCHEDULER_PORT", "9102"),
{{- end }}
	})
}

// normalizeRuntimeConfig fills empty scheduler runtime settings with defaults.
func normalizeRuntimeConfig(cfg RuntimeConfig) RuntimeConfig {
{{- if .Components.Metrics }}
	cfg.MetricsPort = strings.TrimSpace(cfg.MetricsPort)
	if cfg.MetricsPort == "" {
		cfg.MetricsPort = "9102"
	}
{{- else }}
	_ = strings.TrimSpace("")
{{- end }}
	return cfg
}
