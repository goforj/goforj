// syncMaintenancePause overlays maintenance state without clearing an independently paused scheduler.
func syncMaintenancePause(engine *scheduler.Scheduler, owned bool) (bool, error) {
	if maintenance.Enabled() {
		if engine.IsPausedAll() {
			return owned, nil
		}
		if err := engine.PauseAll(); err != nil {
			return false, err
		}
		return true, nil
	}
	if !owned {
		return false, nil
	}
	if err := engine.ResumeAll(); err != nil {
		return true, err
	}
	return false, nil
}

