package main

import (
	{{if .Components.WebUI}}"embed"{{end}}
	"fmt"
	"github.com/goforj/env/v2"
	"{{.GoModuleName}}/internal/cmd"
	{{if .Components.WebUI}}"{{.GoModuleName}}/internal/http"{{end}}
	"{{.GoModuleName}}/wire"
	"os"
)
{{if .Components.WebUI}}
//go:embed all:frontend/dist/*
var spa embed.FS
{{end}}
func main() {
	args := cmd.EffectiveLaunchArgs(os.Args[1:])

	if err := cmd.ApplyCompiledEnvOverrides(); err != nil {
		fmt.Println("Error applying compiled env overrides:", err)
		os.Exit(1)
	}
	if err := cmd.ApplyCompiledEnvDefaults(); err != nil {
		fmt.Println("Error applying compiled env defaults:", err)
		os.Exit(1)
	}

	// load env
	if err := env.Load(); err != nil {
		fmt.Println("Error loading env file:", err)
		os.Exit(1)
	}
	if err := cmd.ApplyCompiledEnvOverrides(); err != nil {
		fmt.Println("Error re-applying compiled env overrides:", err)
		os.Exit(1)
	}
	if handled, err := cmd.MaybeRunSkipBootCommand(args); handled {
		if err != nil {
			fmt.Println("Error executing command:", err)
			os.Exit(1)
		}
		return
	}
{{if .Components.WebUI}}
	// initialize embedded spa's
	http.RegisterSpa("/*", "frontend/dist", &spa)
{{end}}
	// initialize application
	app, err := wire.InitializeApplication()
	if err != nil {
		fmt.Println("Error initializing application:", err)
		os.Exit(1)
	}
	if err := app.Run(nil, args); err != nil {
		app.Logger().Error().Err(err).Msg("Error executing command")
		os.Exit(1)
	}
}
