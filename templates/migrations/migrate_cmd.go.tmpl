package migrations

import (
	"fmt"

	"{{.GoModuleName}}/internal/console"
	"{{.GoModuleName}}/internal/database"
	"{{.GoModuleName}}/internal/logger"
)

// MigrateCmd is a CLI command
type MigrateCmd struct {
	Step       int    `help:"Number of migrations to apply" default:"0"` // 0 = all
	DryRun     bool   `help:"Show what would run without applying"`
	Connection string `help:"Database connection name" default:"default"`

	logger *logger.AppLogger
	db     *database.Connections
}

// NewMigrateCmd creates a new MigrateCmd
func NewMigrateCmd(
	logger *logger.AppLogger,
	db *database.Connections,
) *MigrateCmd {
	return &MigrateCmd{
		Connection: "default",
		logger:     logger,
		db:         db,
	}
}

// Run executes the command.
func (c *MigrateCmd) Run() error {
	if err := c.ensureMigrationsTable(); err != nil {
		console.Fatalf("%v", err)
		return nil
	}

	connName := normalizeConnectionName(c.Connection)
	dbConn, err := c.db.Connection(connName)
	if err != nil {
		console.Fatalf("%v", err)
		return nil
	}

	var existing []string
	dbConn.Raw("SELECT name FROM migrations").Scan(&existing)
	existingMap := map[string]bool{}
	for _, name := range existing {
		existingMap[name] = true
	}

	activeDriver := normalizeDriverName(dbConn.Dialector.Name())
	candidates := selectMigrations(connName, activeDriver)
	var pending []Migration
	for _, m := range candidates {
		if !existingMap[m.Name()] {
			pending = append(pending, m)
		}
	}

	if len(pending) == 0 {
		console.Successf("migrations complete (0)")
		return nil
	}

	applied := 0
	for _, m := range pending {
		if c.Step > 0 && applied >= c.Step {
			break
		}

		if c.DryRun {
			console.Infof("would apply %s", m.Name())
			applied++
			continue
		}

		if err := m.Up(dbConn); err != nil {
			console.Fatalf("migration %s failed: %v", m.Name(), err)
			return nil
		}

		console.Successf("applied %s", m.Name())
		dbConn.Exec("INSERT INTO migrations (name) VALUES (?)", m.Name())
		applied++
	}

	if c.DryRun {
		console.Successf("dry-run complete (%d)", applied)
		return nil
	}

	console.Successf("migrations complete (%d)", applied)
	return nil
}

func (c *MigrateCmd) ensureMigrationsTable() error {
	connName := normalizeConnectionName(c.Connection)
	dbConn, err := c.db.Connection(connName)
	if err != nil {
		return err
	}
	driver := dbConn.Dialector.Name()
	ddl := ""
	switch driver {
	case "postgres":
		ddl = `
CREATE TABLE IF NOT EXISTS migrations (
	id BIGSERIAL PRIMARY KEY,
	name VARCHAR(255) NOT NULL UNIQUE,
	applied_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);`
	case "sqlite":
		ddl = `
CREATE TABLE IF NOT EXISTS migrations (
	id INTEGER PRIMARY KEY AUTOINCREMENT,
	name TEXT NOT NULL UNIQUE,
	applied_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
);`
	default:
		ddl = `
CREATE TABLE IF NOT EXISTS migrations (
	id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
	name VARCHAR(255) NOT NULL UNIQUE,
	applied_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
);`
	}
	if err := dbConn.Exec(ddl).Error; err != nil {
		return fmt.Errorf("failed to create migrations table: %w", err)
	}

	return nil
}
