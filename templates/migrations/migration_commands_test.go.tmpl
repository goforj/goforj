func assertMigrationCount(t *testing.T, conns *database.Connections, connection string, want int) {
	t.Helper()

	dbConn, err := conns.Connection(connection)
	if err != nil {
		t.Fatalf("%s connection failed: %v", connection, err)
	}
	var count int
	if err := dbConn.Raw("SELECT COUNT(*) FROM migrations").Scan(&count).Error; err != nil {
		t.Fatalf("%s count failed: %v", connection, err)
	}
	if count != want {
		t.Fatalf("expected %d migrations for %s, got %d", want, connection, count)
	}
}

func setMigrationFS(t *testing.T, dir string) {
	t.Helper()

	originalFS := migrationFS
	t.Cleanup(func() {
		migrationFS = originalFS
		resetRegistry()
	})
	migrationFS = os.DirFS(dir)
	resetRegistry()

	if err := AutoRegisterMigrations(); err != nil {
		t.Fatalf("AutoRegisterMigrations failed: %v", err)
	}
}
