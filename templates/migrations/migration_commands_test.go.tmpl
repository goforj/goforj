func TestMigrateRunsAllTargetStreamsWhenUnqualified(t *testing.T) {
	dir := t.TempDir()
	writeSQL(t, filepath.Join(dir, "app", "default"), "2026_01_30_app", "CREATE TABLE app_rows (id INTEGER);", "DROP TABLE app_rows;")
	writeSQL(t, filepath.Join(dir, "billing", "default"), "2026_01_31_billing", "CREATE TABLE billing_rows (id INTEGER);", "DROP TABLE billing_rows;")
	writeSQL(t, filepath.Join(dir, "billing", "ledger"), "2026_02_01_ledger", "CREATE TABLE ledger_rows (id INTEGER);", "DROP TABLE ledger_rows;")

	setMigrationFS(t, dir)

	t.Setenv("FORJ_APP_TARGET", "app")
	t.Setenv("FORJ_COMMAND_PREFIX", "forj")
	t.Setenv("DB_DRIVER", "sqlite")
	t.Setenv("DB_DATABASE", ":memory:")
	t.Setenv("DB_BILLING_DRIVER", "sqlite")
	t.Setenv("DB_BILLING_DATABASE", ":memory:")
	t.Setenv("DB_BILLING_LEDGER_DRIVER", "sqlite")
	t.Setenv("DB_BILLING_LEDGER_DATABASE", ":memory:")

	conns := database.NewConnections({{- if .Components.Metrics }}metrics.NewManager(), {{- end }}(*inspects.Manager)(nil))
	log := logger.NewSilentLogger()

	cmd := NewMigrateCmd(log, conns)
	if err := cmd.Run(); err != nil {
		t.Fatalf("migrate all targets failed: %v", err)
	}

	assertMigrationCount(t, conns, "default", 1)
	assertMigrationCount(t, conns, "billing", 1)
	assertMigrationCount(t, conns, "billing_ledger", 1)
}

