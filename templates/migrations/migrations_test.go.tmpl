{{- if .Components.DatabaseSQLite }}
//go:build !integration

package migrations

import (
	"io/fs"
	"os"
	"path/filepath"
	"strings"
	"testing"

	"github.com/glebarez/sqlite"
	"gorm.io/gorm"
)

func writeTestSQLFiles(t *testing.T, dir string) {
	up := `CREATE TABLE test_table (id INTEGER PRIMARY KEY);`
	down := `DROP TABLE test_table;`

	err := os.WriteFile(filepath.Join(dir, "test.up.sql"), []byte(up), 0644)
	if err != nil {
		t.Fatalf("Failed to write test.up.sql: %v", err)
	}

	err = os.WriteFile(filepath.Join(dir, "test.down.sql"), []byte(down), 0644)
	if err != nil {
		t.Fatalf("Failed to write test.down.sql: %v", err)
	}
}

func loadTestMigrations(t *testing.T, f fs.FS) []Migration {
	entries, err := fs.ReadDir(f, ".")
	if err != nil {
		t.Fatalf("ReadDir failed: %v", err)
	}

	var migrations []Migration
	for _, entry := range entries {
		name := entry.Name()
		if strings.HasSuffix(name, ".up.sql") {
			base := strings.TrimSuffix(name, ".up.sql")
			m := &migration{name: base}
			migrations = append(migrations, m)
		}
	}
	return migrations
}

func TestMigrationEndToEnd(t *testing.T) {
	tempDir := t.TempDir()
	writeTestSQLFiles(t, tempDir)

	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{})
	if err != nil {
		t.Fatalf("Failed to open SQLite DB: %v", err)
	}

	migrations := loadTestMigrations(t, os.DirFS(tempDir))
	if len(migrations) == 0 {
		t.Fatal("Expected at least one migration")
	}

	for _, m := range migrations {
		t.Run(m.Name()+"_Up", func(t *testing.T) {
			sql, err := os.ReadFile(filepath.Join(tempDir, m.Name()+".up.sql"))
			if err != nil {
				t.Fatalf("Failed to read up.sql: %v", err)
			}
			if err := db.Exec(string(sql)).Error; err != nil {
				t.Errorf("Up failed: %v", err)
			}
		})
		t.Run(m.Name()+"_Down", func(t *testing.T) {
			sql, err := os.ReadFile(filepath.Join(tempDir, m.Name()+".down.sql"))
			if err != nil {
				t.Fatalf("Failed to read down.sql: %v", err)
			}
			if err := db.Exec(string(sql)).Error; err != nil {
				t.Errorf("Down failed: %v", err)
			}
		})
	}
}
{{- else }}
package migrations
