{{- if and .Components.Auth .Components.HasDatabase }}
// Login authenticates the submitted form and redirects to the dashboard.
func (c *Controller) Login(r web.Context) error {
	if err := r.Request().ParseForm(); err != nil {
		return render(r, LoginPage(LoginPageData{Error: "Invalid form submission"}))
	}
	login := strings.TrimSpace(r.Request().FormValue("login"))
	password := r.Request().FormValue("password")
	remember := r.Request().FormValue("remember") != ""
	if login == "" || password == "" {
		return render(r, LoginPage(LoginPageData{
			Login: login,
			Error: "Username and password are required",
		}))
	}
	_, tokens, err := c.auth.Authenticate(r.Context(), auth.AuthenticateInput{
		Login:     login,
		Password:  password,
		Remember:  remember,
		UserAgent: r.Request().UserAgent(),
		IPAddress: r.RealIP(),
	})
	if err != nil {
		message := "Unable to sign in"
		if errors.Is(err, auth.ErrInvalidCredentials) {
			message = "Invalid credentials"
		}
		return render(r, LoginPage(LoginPageData{
			Login: login,
			Error: message,
		}))
	}
	c.auth.SetSessionCookies(r, tokens)
	if isHTMX(r) {
		r.SetHeader("HX-Redirect", "/")
		return r.NoContent(http.StatusNoContent)
	}
	return r.Redirect(http.StatusSeeOther, "/")
}

// Logout revokes the current session and returns to the login page.
func (c *Controller) Logout(r web.Context) error {
	if err := c.auth.Logout(r); err != nil && !errors.Is(err, auth.ErrUnauthorized) {
		return err
	}
	if isHTMX(r) {
		r.SetHeader("HX-Redirect", "/login")
		return r.NoContent(http.StatusNoContent)
	}
	return r.Redirect(http.StatusSeeOther, "/login")
}
{{- end }}

func render(r web.Context, component templ.Component) error {
	var body bytes.Buffer
	if err := component.Render(r.Context(), &body); err != nil {
		return err
	}
	return r.HTML(http.StatusOK, body.String())
}

func isHTMX(r web.Context) bool {
	return strings.EqualFold(r.Header("HX-Request"), "true")
}
