package starterui

import (
	"bytes"
{{- if and .Components.Auth .Components.HasDatabase }}
	"errors"
{{- end }}
	"net/http"
	"strings"

	"github.com/a-h/templ"
	"github.com/goforj/web"
{{- if and .Components.Auth .Components.HasDatabase }}
	"{{.GoModuleName}}/internal/auth"
{{- end }}
)

// Controller serves the templ + htmx starter pages.
type Controller struct {
{{- if and .Components.Auth .Components.HasDatabase }}
	auth *auth.Service
{{- end }}
}

// NewController creates the starter UI controller.
func NewController(
{{- if and .Components.Auth .Components.HasDatabase }}
	authService *auth.Service,
{{- end }}
) *Controller {
	return &Controller{
{{- if and .Components.Auth .Components.HasDatabase }}
		auth: authService,
{{- end }}
	}
}

// Routes returns the starter UI routes.
func (c *Controller) Routes() []web.Route {
	return []web.Route{
		web.NewRoute(http.MethodGet, "/", c.Dashboard),
{{- if .ComponentLibrary }}
		web.NewRoute(http.MethodGet, "/components", c.Components),
		web.NewRoute(http.MethodGet, "/components/overview", c.ComponentsOverview),
		web.NewRoute(http.MethodGet, "/components/forms", c.Forms),
		web.NewRoute(http.MethodGet, "/components/navigation", c.Navigation),
		web.NewRoute(http.MethodGet, "/components/overlays", c.Overlays),
		web.NewRoute(http.MethodGet, "/components/data", c.Data),
{{- end }}
		web.NewRoute(http.MethodGet, "/settings", c.Settings),
		web.NewRoute(http.MethodGet, "/settings/profile", c.SettingsProfile),
		web.NewRoute(http.MethodGet, "/settings/password", c.SettingsPassword),
		web.NewRoute(http.MethodGet, "/settings/appearance", c.SettingsAppearance),
{{- if and .Components.Auth .Components.HasDatabase }}
		web.NewRoute(http.MethodGet, "/login", c.LoginPage),
		web.NewRoute(http.MethodGet, "/register", c.RegisterPage),
		web.NewRoute(http.MethodGet, "/forgot-password", c.ForgotPasswordPage),
		web.NewRoute(http.MethodGet, "/reset-password", c.ResetPasswordPage),
		web.NewRoute(http.MethodGet, "/verify-email", c.VerifyEmailPage),
		web.NewRoute(http.MethodPost, "/login", c.Login),
		web.NewRoute(http.MethodPost, "/logout", c.Logout),
{{- end }}
	}
}

// Dashboard renders the starter dashboard.
func (c *Controller) Dashboard(r web.Context) error {
	return c.renderAppPage(r, "Dashboard", DashboardPage)
}

{{- if .ComponentLibrary }}
// Components redirects to the component overview.
func (c *Controller) Components(r web.Context) error {
	return r.Redirect(http.StatusSeeOther, "/components/overview")
}

// ComponentsOverview renders the component overview.
func (c *Controller) ComponentsOverview(r web.Context) error {
	return c.renderAppPage(r, "Components Overview", ComponentsOverviewPage)
