func (c *Controller) renderAppPage(r web.Context, title string, page func(PageData) templ.Component) error {
{{- if and .Components.Auth .Components.HasDatabase }}
	return c.requirePageAuth(r, func(_ web.Context, user *auth.User) error {
		return render(r, page(PageData{
			Title: title,
			User:  UserFromAuth(user),
		}))
	})
{{- else }}
	return render(r, page(PageData{Title: title, User: fallbackUserData()}))
{{- end }}
}

{{- if and .Components.Auth .Components.HasDatabase }}
func (c *Controller) requirePageAuth(r web.Context, next func(web.Context, *auth.User) error) error {
	user, err := c.auth.AuthenticateRequest(r)
	if err != nil {
		if errors.Is(err, auth.ErrUnauthorized) {
			if isHTMX(r) {
				r.SetHeader("HX-Redirect", "/login")
				return r.NoContent(http.StatusNoContent)
			}
			return r.Redirect(http.StatusSeeOther, "/login")
		}
		return err
	}
	return next(r, user)
}
{{- end }}

// LoginPage renders the sign-in page.
func (c *Controller) LoginPage(r web.Context) error {
	return render(r, LoginPage(LoginPageData{}))
}

// RegisterPage renders the registration page.
