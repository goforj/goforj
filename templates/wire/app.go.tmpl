// Startup initializes background app resources.
func (a *App) Startup(ctx context.Context) error {
	if ctx == nil {
		ctx = context.Background()
	}
	if app.SourceFromContext(ctx) == "" {
		ctx = app.WithSource(ctx, app.SourceStartup)
	}
	startedInspect := false
	if a.inspects != nil && inspects.RecorderFromContext(ctx) == nil {
		ctx = a.inspects.Begin(ctx, app.SourceStartup, "startup", map[string]string{
			"phase": "startup",
		})
		startedInspect = true
	}
	if err := a.lifecycle.Start(ctx); err != nil {
		if startedInspect {
			a.inspects.Finish(ctx, "error", err)
		}
		return err
	}
	if startedInspect {
		a.inspects.Finish(ctx, "ok", nil)
	}
	return nil
}

// Shutdown gracefully releases background app resources.
func (a *App) Shutdown(ctx context.Context) error {
	return a.lifecycle.Stop(ctx)
}

// Run starts app lifecycle, executes CLI args, and performs graceful shutdown.
func (a *App) Run(ctx context.Context, args []string) error {
	if ctx == nil {
		ctx = context.Background()
	}
	command := ""
	if len(args) > 0 {
		command = args[0]
	}
	origin := strings.TrimSpace(os.Getenv("FORJ_COMMAND_ORIGIN"))
	parser, err := kong.New(
		a.RootCmd(),
		kong.Name(strings.ToLower(os.Getenv("APP_NAME"))),
		kong.Help(cmd.KongHelpFormatter),
	)
	if err != nil {
		return err
	}

	if len(args) == 0 {
		parseCtx, _ := parser.Parse([]string{"--help"})
		parseCtx.PrintUsage(false)
		return nil
	}

	parseCtx, err := parser.Parse(args)
	if err != nil {
		return err
	}
	ctx, stop := app.CLINotifyContext(ctx, syscall.SIGINT, syscall.SIGTERM)
	defer stop()
	ctx = a.inspects.Begin(ctx, app.SourceCLI, command, map[string]string{
		"command": command,
	})
	parseCtx.BindTo(ctx, (*context.Context)(nil))
	shutdownTimeout := a.shutdownTimeoutForOrigin(origin)
	if err := a.Startup(ctx); err != nil {
		a.inspects.Finish(ctx, "error", err)
		return err
	}
	defer func() {
		shutdownCtx, cancel := context.WithTimeout(context.Background(), shutdownTimeout)
		defer cancel()
		if shutdownErr := a.Shutdown(shutdownCtx); shutdownErr != nil {
			if origin == "" {
				origin = "cli"
			}
			subprocess := strings.TrimSpace(os.Getenv("FORJ_SUBPROCESS")) == "1"
			msg := "Application shutdown failed"
			if subprocess {
				msg = "Application subprocess shutdown failed"
			}
			a.logger.Error().
				Err(shutdownErr).
				Str("command", command).
				Strs("args", args).
				Str("origin", origin).
				Bool("subprocess", subprocess).
				Int("pid", os.Getpid()).
				Dur("shutdown_timeout", shutdownTimeout).
				Msg(msg)
		}
		a.inspects.Finish(ctx, "", nil)
	}()
	if err := parseCtx.Run(); err != nil {
		a.inspects.Finish(ctx, "error", err)
		return err
	}
	a.inspects.Finish(ctx, "ok", nil)
	return nil
}

