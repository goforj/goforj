// NewApplication creates a new App instance
func NewApplication(
	{{- if .Components.HasDatabase }}
	db *database.Connections,
	{{- end }}
	{{- if and .Components.Auth .Components.HasDatabase }}
	_ *authPreseedReady,
	{{- end }}
	{{- if and .Components.DemoApp .Components.HasDatabase }}
	_ *demoPreseedReady,
	{{- end }}
	appLogger *logger.AppLogger,
	rootCmd *cmd.RootCmd,
	appTimeouts *app.Timeouts,
	lifecycleRegistry *app.LifecycleRegistry,
	cacheManager *caches.Manager,
	storage *storages.Manager,
	events *eventcore.Manager,
	inspectManager *inspects.Manager,
	{{- if .Components.Metrics }}
	metricsManager *metrics.Manager,
	{{- end }}
	{{- if .Components.Mail }}
	mailManager *appmail.Manager,
	{{- end }}
	{{- if .Components.Jobs }}
	queues *queues.Manager,
	exampleHelloJob *jobs.ExampleHelloJob,
	{{- if and .Components.DemoApp .Components.Jobs }}
	dispatchJob *alerts.DispatchJob,
	monitorCheckJob *monitoring.MonitorCheckJob,
	{{- end }}
	{{- if and .Components.Jobs .Components.StressTest }}
	stressJob *jobs.StressJob,
	{{- end }}
	{{- end }}
) App {
	lifecycleManager := app.NewLifecycle(appTimeouts)
	runtimeTopology := app.RuntimeTopology{
		Mode: app.NormalizeRuntimeMode(os.Getenv("RUNTIME_MODE")),
	}.Normalized()
	if appLogger != nil && inspectManager != nil {
		appLogger.AddSink(func(entry logger.LogEntry) {
			inspectID := strings.TrimSpace(fmt.Sprintf("%v", entry.Fields["inspect_id"]))
			if inspectID == "" {
				return
			}
			fields := make(map[string]any, len(entry.Fields))
			for key, value := range entry.Fields {
				if key == "inspect_id" {
					continue
				}
				fields[key] = value
			}
			inspectManager.RecordLog(inspects.WithInspectID(context.Background(), inspectID), entry.Level, entry.Message, fields)
		})
	}
	if storage != nil && strings.TrimSpace(os.Getenv("FORJ_SUBPROCESS")) != "1" {
		for _, warning := range storage.Warnings() {
			appLogger.Warn().
				Str("disk", warning.Name).
				Str("driver", warning.Driver).
				Str("details", warning.Error).
				Msg("Optional storage disk unavailable; skipping")
		}
	}
	if cacheManager != nil && inspectManager != nil {
		cacheManager = cacheManager.WithObserver(caches.ObserverFunc(func(ctx context.Context, name string, op string, _ string, hit bool, err error, dur time.Duration, driver cachecore.Driver) {
			if inspects.IsInternalContext(ctx) {
				return
			}
			inspectManager.RecordCacheEvent(ctx, name, op, string(driver), hit, err, dur)
		}))
	}
	{{- if .Components.HasDatabase }}
	if db != nil {
		lifecycleManager.On(app.Shutdown, func(ctx context.Context) error {
			appLogger.Debug().Msg("Shutting down database connections...")
			if err := db.Close(ctx); err != nil {
				return err
			}
			appLogger.Debug().Msg("Database connections shut down")
			return nil
		})
	}
	{{- end }}
	{{- if .Components.Jobs }}
	queues.Register(jobs.ExampleHelloJobTypeName, exampleHelloJob.HandleTask)
	{{- if and .Components.DemoApp .Components.Jobs }}
	queues.Register(alerts.DispatchJobTypeName, dispatchJob.HandleTask)
	queues.Register(monitoring.MonitorCheckJobTypeName, monitorCheckJob.HandleTask)
	{{- end }}
	{{- if and .Components.Jobs .Components.StressTest }}
	queues.Register(jobs.StressJobTypeName, stressJob.HandleTask)
	{{- end }}
	{{- end }}
	if events != nil {
		seenEventBuses := map[eventcore.Bus]struct{}{}
		for _, instance := range events.Instances() {
			bus := instance.Bus
			if bus == nil {
				continue
			}
			if _, ok := seenEventBuses[bus]; ok {
				continue
			}
			seenEventBuses[bus] = struct{}{}
			currentBus := bus
			busName := instance.Name
			lifecycleManager.On(app.Startup, func(ctx context.Context) error {
				appLogger.Debug().Str("bus", busName).Msg("Starting event bus")
				if err := currentBus.Start(ctx); err != nil {
					return err
				}
				appLogger.Debug().Str("bus", busName).Msg("Event bus started")
				return nil
			})
			lifecycleManager.On(app.Shutdown, func(ctx context.Context) error {
				appLogger.Debug().Str("bus", busName).Msg("Shutting down event bus...")
				if err := currentBus.Close(ctx); err != nil {
					return err
				}
				appLogger.Debug().Str("bus", busName).Msg("Event bus shut down")
				return nil
			})
		}
	}
	if lifecycleRegistry != nil {
		lifecycleRegistry.Register(lifecycleManager)
	}

	return App{
		context: context.Background(),
		rootCmd: rootCmd,
		logger:  appLogger,
		topology: runtimeTopology,
		{{- if .Components.HasDatabase }}
		db: db,
		{{- end }}
		cache: cacheManager,
		storage: storage,
		events: events,
		inspects: inspectManager,
		{{- if .Components.Metrics }}
		metrics: metricsManager,
		{{- end }}
		{{- if .Components.Mail }}
		mail: mailManager,
		{{- end }}
		lifecycle: lifecycleManager,
		appTimeouts: appTimeouts,
		{{- if .Components.Jobs }}
		queues: queues,
		{{- end }}
	}
}

func (a *App) shutdownTimeoutForOrigin(origin string) time.Duration {
	if strings.EqualFold(origin, "scheduler_command") {
		return a.appTimeouts.SchedulerSubprocessShutdownTimeout()
	}
	return a.appShutdownTimeout()
}

func (a *App) appShutdownTimeout() time.Duration {
	return a.appTimeouts.ShutdownTimeout()
}
