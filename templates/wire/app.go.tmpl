package wire

import (
	"context"
	"{{.GoModuleName}}/internal/cmd"
	"{{.GoModuleName}}/internal/cache"
	"{{.GoModuleName}}/internal/events"
	"{{.GoModuleName}}/internal/logger"
{{- if .Components.Jobs }}
	"{{.GoModuleName}}/internal/queue"
{{- end }}
{{- if .Components.HasDatabase }}
	"{{.GoModuleName}}/internal/dbconns"
{{- end }}
)

// App is the root App resource
type App struct {
	context context.Context
	rootCmd *cmd.RootCmd
	logger  *logger.AppLogger
	cache   cache.Store
	eventBus events.Bus
	{{- if .Components.Jobs }}
	dispatcher queue.Dispatcher
	{{- end }}
	{{- if .Components.HasDatabase }}
	db      *dbconns.Connections
	{{- end }}
}

// RootCmd returns the root command of the application
func (a *App) RootCmd() *cmd.RootCmd {
	return a.rootCmd
}

// Logger returns the logger of the application
func (a *App) Logger() *logger.AppLogger {
	return a.logger
}

// Startup initializes background app resources.
func (a *App) Startup(ctx context.Context) error {
	var startupErr error
	{{- if .Components.Jobs }}
	if a.dispatcher != nil {
		if err := a.dispatcher.Start(ctx); err != nil && startupErr == nil {
			startupErr = err
		}
	}
	{{- end }}
	if a.eventBus != nil {
		if err := a.eventBus.Start(ctx); err != nil && startupErr == nil {
			startupErr = err
		}
	}
	return startupErr
}

// Shutdown gracefully releases background app resources.
func (a *App) Shutdown(ctx context.Context) error {
	var shutdownErr error
	{{- if .Components.Jobs }}
	if a.dispatcher != nil {
		if a.dispatcher.Driver() == queue.DriverWorkerpool {
			a.logger.Info().Msg("Waiting for workerpool jobs to finish")
		}
		if err := a.dispatcher.Shutdown(ctx); err != nil && shutdownErr == nil {
			shutdownErr = err
		}
	}
	{{- end }}
	if a.eventBus != nil {
		if err := a.eventBus.Close(ctx); err != nil && shutdownErr == nil {
			shutdownErr = err
		}
	}
	return shutdownErr
}

{{- if .Components.HasDatabase }}
// DB returns the database connection registry.
func (a *App) DB() *dbconns.Connections {
	return a.db
}
{{- end }}

// NewApplication creates a new App instance
func NewApplication(
	{{- if .Components.HasDatabase }}
	db *dbconns.Connections,
	{{- end }}
	{{- if and .Components.DemoApp .Components.HasDatabase }}
	_ *demoPreseedReady,
	{{- end }}
	logger *logger.AppLogger,
	rootCmd *cmd.RootCmd,
	cacheStore cache.Store,
	eventBus events.Bus,
	{{- if .Components.Jobs }}
	dispatcher queue.Dispatcher,
	{{- end }}
) App {
	return App{
		context: context.Background(),
		rootCmd: rootCmd,
		logger:  logger,
		{{- if .Components.HasDatabase }}
		db: db,
		{{- end }}
		cache: cacheStore,
		eventBus: eventBus,
		{{- if .Components.Jobs }}
		dispatcher: dispatcher,
		{{- end }}
	}
}
