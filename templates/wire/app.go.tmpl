// App is the root App resource
type App struct {
	context context.Context
	rootCmd *cmd.RootCmd
	logger  *logger.AppLogger
	topology app.RuntimeTopology
	cache   *caches.Manager
	storage *storages.Manager
	events *eventcore.Manager
	inspects *inspects.Manager
	{{- if .Components.Metrics }}
	metrics *metrics.Manager
	{{- end }}
	{{- if .Components.Mail }}
	mail *appmail.Manager
	{{- end }}
	lifecycle *app.Lifecycle
	appTimeouts *app.Timeouts
	{{- if .Components.Jobs }}
	queues *queues.Manager
	{{- end }}
	{{- if .Components.HasDatabase }}
	db      *database.Connections
	{{- end }}
}

