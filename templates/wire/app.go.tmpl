// DB returns the database connection registry.
func (a *App) DB() *database.Connections {
	return a.db
}
{{- end }}

// NewApplication creates a new App instance
func NewApplication(
	{{- if .Components.HasDatabase }}
	db *database.Connections,
	{{- end }}
	{{- if and .Components.DemoApp .Components.HasDatabase }}
	_ *demoPreseedReady,
	{{- end }}
	logger *logger.AppLogger,
	rootCmd *cmd.RootCmd,
	appTimeouts *app.Timeouts,
	lifecycleRegistry *app.LifecycleRegistry,
	caches *caches.Manager,
	storage *storages.Manager,
	events *eventcore.Manager,
	{{- if .Components.Jobs }}
	queues *queues.Manager,
	exampleHelloJob *jobs.ExampleHelloJob,
	{{- if and .Components.DemoApp .Components.Jobs }}
	dispatchJob *alerts.DispatchJob,
	monitorCheckJob *monitoring.MonitorCheckJob,
	{{- end }}
	{{- if and .Components.Jobs .Components.StressTest }}
	stressJob *jobs.StressJob,
	{{- end }}
	{{- end }}
) App {
	lifecycleManager := app.NewLifecycle(appTimeouts)
	{{- if .Components.HasDatabase }}
	if db != nil {
		lifecycleManager.On(app.Shutdown, func(ctx context.Context) error {
			logger.Info().Msg("Shutting down database connections...")
			if err := db.Close(ctx); err != nil {
				return err
			}
			logger.Info().Msg("Database connections shut down")
			return nil
		})
	}
	{{- end }}
	{{- if .Components.Jobs }}
	queues.Default().Register(jobs.ExampleHelloJobTypeName, exampleHelloJob.HandleTask)
	{{- if and .Components.DemoApp .Components.Jobs }}
	queues.Default().Register(alerts.DispatchJobTypeName, dispatchJob.HandleTask)
	queues.Default().Register(monitoring.MonitorCheckJobTypeName, monitorCheckJob.HandleTask)
	{{- end }}
	{{- if and .Components.Jobs .Components.StressTest }}
	queues.Default().Register(jobs.StressJobTypeName, stressJob.HandleTask)
	{{- end }}
	defaultQueue := queues.Default()
	if defaultQueue != nil {
		// Workerpool executes jobs on an in-process pool, so any command that boots
		// the shared app graph may legitimately own worker startup/shutdown. Sync
		// executes inline and distributed drivers are handled by queue:work instead.
		switch defaultQueue.Driver() {
		case queue.DriverWorkerpool:
			lifecycleManager.On(app.Startup, defaultQueue.StartWorkers)
			lifecycleManager.On(app.Shutdown, func(ctx context.Context) error {
				logger.Info().Msg("Waiting for queue workers to finish")
				shutdownCtx := ctx
				if timeout := appTimeouts.QueueShutdownTimeout(); timeout > 0 {
					var cancel context.CancelFunc
					shutdownCtx, cancel = context.WithTimeout(ctx, timeout)
					defer cancel()
				}
				return defaultQueue.Shutdown(shutdownCtx)
			})
		}
	}
	{{- end }}
	if events != nil {
		seenEventBuses := map[eventcore.Bus]struct{}{}
		for _, instance := range events.Instances() {
			bus := instance.Bus
			if bus == nil {
				continue
			}
			if _, ok := seenEventBuses[bus]; ok {
				continue
			}
			seenEventBuses[bus] = struct{}{}
			currentBus := bus
			busName := instance.Name
			lifecycleManager.On(app.Startup, func(ctx context.Context) error {
				logger.Info().Str("bus", busName).Msg("Starting event bus")
				if err := currentBus.Start(ctx); err != nil {
					return err
				}
				logger.Info().Str("bus", busName).Msg("Event bus started")
				return nil
			})
			lifecycleManager.On(app.Shutdown, func(ctx context.Context) error {
				logger.Info().Str("bus", busName).Msg("Shutting down event bus...")
				if err := currentBus.Close(ctx); err != nil {
					return err
				}
				logger.Info().Str("bus", busName).Msg("Event bus shut down")
				return nil
			})
		}
	}
	if lifecycleRegistry != nil {
		lifecycleRegistry.Register(lifecycleManager)
	}

	return App{
		context: context.Background(),
		rootCmd: rootCmd,
		logger:  logger,
		{{- if .Components.HasDatabase }}
		db: db,
		{{- end }}
		cache: caches,
		storage: storage,
		events: events,
		lifecycle: lifecycleManager,
		appTimeouts: appTimeouts,
		{{- if .Components.Jobs }}
		queues: queues,
		{{- end }}
	}
}

func (a *App) shutdownTimeoutForOrigin(origin string) time.Duration {
	if strings.EqualFold(origin, "scheduler_command") {
		return a.appTimeouts.SchedulerSubprocessShutdownTimeout()
	}
	return a.appShutdownTimeout()
}

func (a *App) appShutdownTimeout() time.Duration {
	return a.appTimeouts.ShutdownTimeout()
}

func shouldSkipAppLifecycle(command, origin string) bool {
	return strings.EqualFold(command, "run") && !strings.EqualFold(origin, "scheduler_command")
}
