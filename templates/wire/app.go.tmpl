// App is the root App resource
type App struct {
	context context.Context
	rootCmd *cmd.RootCmd
	logger  *logger.AppLogger
	cache   cache.Store
	eventBus events.Bus
	lifecycle *lifecycle.Manager
	{{- if .Components.Jobs }}
	dispatcher queue.Dispatcher
	{{- end }}
	{{- if .Components.HasDatabase }}
	db      *dbconns.Connections
	{{- end }}
}

// RootCmd returns the root command of the application
func (a *App) RootCmd() *cmd.RootCmd {
	return a.rootCmd
}

// Logger returns the logger of the application
func (a *App) Logger() *logger.AppLogger {
	return a.logger
}

// Lifecycle returns the app lifecycle manager so callers can register custom hooks.
func (a *App) Lifecycle() *lifecycle.Manager {
	return a.lifecycle
}

// Startup initializes background app resources.
func (a *App) Startup(ctx context.Context) error {
	if a.lifecycle == nil {
		return nil
	}
	return a.lifecycle.Start(ctx)
}

// Shutdown gracefully releases background app resources.
func (a *App) Shutdown(ctx context.Context) error {
	if a.lifecycle == nil {
		return nil
	}
	return a.lifecycle.Stop(ctx)
}

// Run starts app lifecycle, executes CLI args, and performs graceful shutdown.
func (a *App) Run(ctx context.Context, args []string) error {
	if ctx == nil {
		ctx = context.Background()
	}
	command := ""
	if len(args) > 0 {
		command = args[0]
	}
	origin := strings.TrimSpace(os.Getenv("FORJ_COMMAND_ORIGIN"))
	shutdownTimeout := resolveShutdownTimeout(command, origin)
	if err := a.Startup(ctx); err != nil {
		return err
	}
	defer func() {
		shutdownCtx, cancel := context.WithTimeout(context.Background(), shutdownTimeout)
		defer cancel()
		if shutdownErr := a.Shutdown(shutdownCtx); shutdownErr != nil {
			if origin == "" {
				origin = "cli"
			}
			subprocess := strings.TrimSpace(os.Getenv("FORJ_SUBPROCESS")) == "1"
			msg := "Application shutdown failed"
			if subprocess {
				msg = "Application subprocess shutdown failed"
			}
			a.logger.Error().
				Err(shutdownErr).
				Str("command", command).
				Strs("args", args).
				Str("origin", origin).
				Bool("subprocess", subprocess).
				Int("pid", os.Getpid()).
				Dur("shutdown_timeout", shutdownTimeout).
				Msg(msg)
		}
	}()

	parser, err := kong.New(
		a.RootCmd(),
		kong.Name(strings.ToLower(os.Getenv("APP_NAME"))),
		kong.Help(cmd.KongHelpFormatter),
	)
	if err != nil {
		return err
	}

	if len(args) == 0 {
		parseCtx, _ := parser.Parse([]string{"--help"})
		parseCtx.PrintUsage(false)
		return nil
	}

	parseCtx, err := parser.Parse(args)
	if err != nil {
		return err
	}
	if err := parseCtx.Run(); err != nil {
		return err
	}
	return nil
}

{{- if .Components.HasDatabase }}
// DB returns the database connection registry.
func (a *App) DB() *dbconns.Connections {
	return a.db
}
{{- end }}

// NewApplication creates a new App instance
func NewApplication(
	{{- if .Components.HasDatabase }}
	db *dbconns.Connections,
	{{- end }}
	{{- if and .Components.DemoApp .Components.HasDatabase }}
	_ *demoPreseedReady,
	{{- end }}
	logger *logger.AppLogger,
	rootCmd *cmd.RootCmd,
	lifecycleRegistry *lifecycle.Registry,
	cacheStore cache.Store,
	eventBus events.Bus,
	{{- if .Components.Jobs }}
	dispatcher queue.Dispatcher,
	{{- end }}
) App {
	lifecycleManager := lifecycle.NewManager()
	{{- if .Components.Jobs }}
	if dispatcher != nil {
		lifecycleManager.On(lifecycle.Startup, dispatcher.Start)
		lifecycleManager.On(lifecycle.Shutdown, func(ctx context.Context) error {
			if dispatcher.Driver() == queue.DriverWorkerpool && logger != nil {
				logger.Info().Msg("Waiting for workerpool jobs to finish")
			}
			shutdownCtx := ctx
			if dispatcher.Driver() == queue.DriverWorkerpool {
				if timeout := durationFromEnvSeconds("QUEUE_WORKERPOOL_SHUTDOWN_TIMEOUT_SECONDS", 0); timeout > 0 {
					var cancel context.CancelFunc
					shutdownCtx, cancel = context.WithTimeout(ctx, timeout)
					defer cancel()
				}
			}
			return dispatcher.Shutdown(shutdownCtx)
		})
	}
	{{- end }}
	if eventBus != nil {
		lifecycleManager.On(lifecycle.Startup, eventBus.Start)
		lifecycleManager.On(lifecycle.Shutdown, eventBus.Close)
	}
	if lifecycleRegistry != nil {
		lifecycleRegistry.Register(lifecycleManager)
	}

	return App{
		context: context.Background(),
		rootCmd: rootCmd,
		logger:  logger,
		{{- if .Components.HasDatabase }}
		db: db,
		{{- end }}
		cache: cacheStore,
		eventBus: eventBus,
		lifecycle: lifecycleManager,
		{{- if .Components.Jobs }}
		dispatcher: dispatcher,
		{{- end }}
	}
}

func resolveShutdownTimeout(command, origin string) time.Duration {
	timeout := durationFromEnvSeconds("APP_SHUTDOWN_TIMEOUT_SECONDS", 30)
	if strings.EqualFold(origin, "scheduler_command") || command == "monitor:poll" || command == "push-monitor-trigger" {
		timeout = durationFromEnvSeconds("SCHEDULER_SUBPROCESS_SHUTDOWN_TIMEOUT_SECONDS", int(timeout/time.Second))
	}
	return timeout
}

func durationFromEnvSeconds(key string, defaultSeconds int) time.Duration {
	if defaultSeconds < 0 {
		defaultSeconds = 0
	}
	raw := strings.TrimSpace(os.Getenv(key))
	if raw == "" {
		return time.Duration(defaultSeconds) * time.Second
	}
	seconds, err := strconv.Atoi(raw)
	if err != nil || seconds < 0 {
		return time.Duration(defaultSeconds) * time.Second
	}
	return time.Duration(seconds) * time.Second
}
