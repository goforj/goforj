// TestNotificationAccessorUsesConfiguredManager verifies App access and Wire provider cleanup without a real delivery.
func TestNotificationAccessorUsesConfiguredManager(t *testing.T) {
    t.Setenv("NOTIFICATION_DRIVER", "log")
    manager, cleanup, err := provideNotificationManager()
    if err != nil { t.Fatal(err) }
    defer cleanup()
    application := App{notifications: manager}
    if application.Notifications() != manager { t.Fatal("App lost notification manager") }
    if err := application.Notifications().Default().Send(context.Background(), notification.Message{Title: "Incident test", Body: "local capture"}); err != nil { t.Fatal(err) }
    cleanup()
    if err := manager.Close(); err != nil { t.Fatal(err) }
}
