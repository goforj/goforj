// TestLogTimeoutWarningsReportsEachCappedSetting verifies startup logs retain both configured and effective values.
func TestLogTimeoutWarningsReportsEachCappedSetting(t *testing.T) {
	t.Setenv("APP_SHUTDOWN_TIMEOUT", "30s")
{{- if .ProjectComponents.Jobs }}
	t.Setenv("QUEUE_SHUTDOWN_TIMEOUT", "90s")
{{- end }}
	t.Setenv("SCHEDULER_SUBPROCESS_SHUTDOWN_TIMEOUT", "90s")

	appLogger := logger.NewAppLogger()
	entries := make([]logger.LogEntry, 0, 2)
	appLogger.AddSink(func(entry logger.LogEntry) {
		entries = append(entries, entry)
	})
	logTimeoutWarnings(appLogger, runtime.NewTimeouts())

	want := map[string]bool{"SCHEDULER_SUBPROCESS_SHUTDOWN_TIMEOUT": true}
{{- if .ProjectComponents.Jobs }}
	want["QUEUE_SHUTDOWN_TIMEOUT"] = true
{{- end }}
	if len(entries) != len(want) {
		t.Fatalf("timeout warning entries = %#v, want %d", entries, len(want))
	}
	for _, entry := range entries {
		setting, ok := entry.Fields["timeout_setting"].(string)
		if !ok || !want[setting] {
			t.Fatalf("timeout warning setting = %#v, want one of %#v", entry.Fields["timeout_setting"], want)
		}
		if entry.Message != "Shutdown timeout capped by app shutdown budget" || entry.Fields["configured_timeout"] != "1m30s" || entry.Fields["effective_timeout"] != "30s" || entry.Fields["parent_timeout"] != "30s" {
			t.Fatalf("timeout warning = %#v", entry)
		}
	}
}

// TestTimeoutWithinParentPreservesAnEarlierDeadline verifies cleanup cannot extend its command's deadline.
func TestTimeoutWithinParentPreservesAnEarlierDeadline(t *testing.T) {
	ctx, cancel := context.WithTimeout(context.Background(), 40*time.Millisecond)
	defer cancel()
	got := timeoutWithinParent(ctx, 30*time.Second)
	if got <= 0 || got > 40*time.Millisecond || got < 20*time.Millisecond {
		t.Fatalf("bounded timeout = %s, want remaining parent deadline", got)
	}

	if got, want := timeoutWithinParent(context.Background(), 30*time.Second), 30*time.Second; got != want {
		t.Fatalf("deadline-free timeout = %s, want %s", got, want)
	}
	if got := timeoutWithinParent(nil, 30*time.Second); got != 30*time.Second {
		t.Fatalf("nil parent timeout = %s, want 30s", got)
	}

	expired, stop := context.WithCancel(context.Background())
	stop()
	if got, want := timeoutWithinParent(expired, 30*time.Second), 30*time.Second; got != want {
		t.Fatalf("deadline-free canceled timeout = %s, want %s", got, want)
	}
}

func TestAppStartupIsIdempotent(t *testing.T) {
	var calls atomic.Int64
	manager := runtime.NewLifecycle(runtime.NewTimeouts())
	manager.On(runtime.Startup, func(context.Context) error {
		calls.Add(1)
		return nil
	})

	app := App{inspects: inspects.NewManager(), logger: logger.NewSilentLogger(), lifecycle: manager}
	if err := app.Startup(context.Background()); err != nil {
		t.Fatalf("first startup failed: %v", err)
	}
	if err := app.Startup(context.Background()); err != nil {
		t.Fatalf("second startup failed: %v", err)
	}
	if got := calls.Load(); got != 1 {
		t.Fatalf("expected startup hook to run once, got %d", got)
	}
}

