// TestAppShutdownSharesWireCleanupAcrossCopies protects once-only provider cleanup after value copies of App.
func TestAppShutdownSharesWireCleanupAcrossCopies(t *testing.T) {
 t.Setenv("LIGHTHOUSE_INSPECT_ENABLED", "true")
 inspectManager := inspects.NewManager()
 t.Cleanup(func() { _ = inspectManager.Shutdown(context.Background()) })
 lifecycle := runtime.NewLifecycle(runtime.NewTimeouts())
 var cleanupCalls atomic.Int64
 lifecycle.On(runtime.Shutdown, func(context.Context) error {
  if got := cleanupCalls.Load(); got != 0 {
   t.Errorf("Wire cleanup ran before lifecycle shutdown: %d", got)
  }
  return nil
 })
 if err := lifecycle.Start(context.Background()); err != nil {
  t.Fatal(err)
 }
 application := App{
  logger: logger.NewSilentLogger(),
  inspects: inspectManager,
  lifecycle: lifecycle,
  cleanup: onceCleanup(func() {
   cleanupCalls.Add(1)
   _, span := inspectManager.TracerProvider().Tracer("test/shutdown").Start(context.Background(), "after-sdk-shutdown")
   if span.IsRecording() {
    t.Error("Wire cleanup ran before SDK shutdown")
   }
   span.End()
  }),
 }
 copied := application
 if copied != application || !map[App]bool{application: true}[copied] {
  t.Fatal("App value comparisons or map-key identity changed")
 }
 if err := application.Shutdown(nil); err != nil {
  t.Fatal(err)
 }
 if err := copied.Shutdown(context.Background()); err != nil {
  t.Fatal(err)
 }
 if got := cleanupCalls.Load(); got != 1 {
  t.Fatalf("Wire cleanup calls across App copies = %d, want 1", got)
 }
}

