// TestAppCleanupRunsAfterExecutionDeadline verifies expired commands still release lifecycle resources with a bounded cleanup context.
func TestAppCleanupRunsAfterExecutionDeadline(t *testing.T) {
	manager := runtime.NewLifecycle(runtime.NewTimeouts())
	called := false
	manager.On(runtime.Shutdown, func(ctx context.Context) error {
		called = true
		if err := ctx.Err(); err != nil {
			t.Errorf("cleanup context already expired: %v", err)
		}
		deadline, ok := ctx.Deadline()
		if !ok || time.Until(deadline) > time.Second {
			t.Error("cleanup context must have a bounded grace period")
		}
		return nil
	})
	app := App{inspects: inspects.NewManager(), logger: logger.NewAppLogger(), lifecycle: manager}
	if err := app.Startup(context.Background()); err != nil {
