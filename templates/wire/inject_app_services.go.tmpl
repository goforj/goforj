func (o eventObserver) OnEventDeliveryFinish(ctx context.Context, event events.EventDeliveryEvent) {
	o.inspects.RecordEventDeliveryFinish(ctx, inspects.EventDeliveryInspectEvent{
		Bus:      event.Bus,
		Driver:   string(event.Driver),
		Topic:    event.Topic,
		Handler:  event.Handler,
