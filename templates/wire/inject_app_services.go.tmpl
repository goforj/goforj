package wire

import (
	"context"
	"{{.GoModuleName}}/internal/app"
	"{{.GoModuleName}}/internal/events"
{{- if .Components.Metrics }}
	"{{.GoModuleName}}/internal/metrics"
{{- end }}
	"{{.GoModuleName}}/internal/inspects"
	"github.com/google/wire"
{{- if and .Components.DemoApp .Components.HasDatabase }}
	"{{.GoModuleName}}/internal/logger"
{{- end }}
{{- if and .Components.DemoApp .Components.HasDatabase }}
	"{{.GoModuleName}}/internal/appsettings"
	"{{.GoModuleName}}/internal/notification"
{{- end }}
	"{{.GoModuleName}}/internal/caches"
)

// appSet is a wire set that provides any application-level services and dependencies.
// for more specific sets, you can create your own
var appSet = wire.NewSet(
	provideCacheManager,
	provideLighthouseCacheStore,
	provideStorageManager,
	provideEventManager,
	provideInspectManager,
{{- if .Components.Metrics }}
	metrics.NewManager,
{{- end }}
	app.NewTimeouts,
	app.NewLifecycleRegistry,
	events.NewMakeEventCmd,
{{- if and .Components.DemoApp .Components.HasDatabase }}
	preseedDemoDefaults,
{{- end }}
)

func provideInspectManager(caches *caches.Manager) *inspects.Manager {
	return inspects.NewManager(caches.Inspects())
}

type eventObserver struct {
	inspects *inspects.Manager
{{- if .Components.Metrics }}
	metrics *metrics.Manager
{{- end }}
}

func (o eventObserver) OnEventPublish(ctx context.Context, event events.EventPublishEvent) {
	o.inspects.RecordEventPublish(ctx, inspects.EventPublishInspectEvent{
		Bus:      event.Bus,
		Driver:   string(event.Driver),
		Topic:    event.Topic,
		Err:      event.Err,
		Duration: event.Duration,
	})
{{- if .Components.Metrics }}
	if o.metrics != nil {
		o.metrics.RecordEventPublish(ctx, metrics.EventPublishMetricEvent{
			Bus:      event.Bus,
			Driver:   string(event.Driver),
			Topic:    event.Topic,
			Err:      event.Err,
			Duration: event.Duration,
		})
	}
{{- end }}
}

func (o eventObserver) OnEventSubscribe(ctx context.Context, event events.EventSubscriptionEvent) {
	o.inspects.RecordEventSubscribe(ctx, inspects.EventSubscriptionInspectEvent{
		Bus:     event.Bus,
		Driver:  string(event.Driver),
		Topic:   event.Topic,
		Handler: event.Handler,
		Err:     event.Err,
	})
{{- if .Components.Metrics }}
	if o.metrics != nil {
		o.metrics.RecordEventSubscribe(ctx, metrics.EventSubscriptionMetricEvent{
			Bus:     event.Bus,
			Driver:  string(event.Driver),
			Topic:   event.Topic,
			Handler: event.Handler,
			Err:     event.Err,
		})
	}
{{- end }}
}

func (o eventObserver) OnEventUnsubscribe(ctx context.Context, event events.EventSubscriptionEvent) {
	o.inspects.RecordEventUnsubscribe(ctx, inspects.EventSubscriptionInspectEvent{
		Bus:     event.Bus,
		Driver:  string(event.Driver),
		Topic:   event.Topic,
		Handler: event.Handler,
	})
{{- if .Components.Metrics }}
	if o.metrics != nil {
		o.metrics.RecordEventUnsubscribe(ctx, metrics.EventSubscriptionMetricEvent{
			Bus:     event.Bus,
			Driver:  string(event.Driver),
			Topic:   event.Topic,
			Handler: event.Handler,
		})
	}
{{- end }}
}

