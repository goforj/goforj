package wire

import (
	"context"
	"time"
	"{{.GoModuleName}}/internal/app"
	"{{.GoModuleName}}/internal/events"
{{- if .Components.Metrics }}
	"{{.GoModuleName}}/internal/metrics"
{{- end }}
	"{{.GoModuleName}}/internal/inspects"
	"github.com/google/wire"
{{- if and .Components.DemoApp .Components.HasDatabase }}
	"{{.GoModuleName}}/internal/logger"
{{- end }}
{{- if and .Components.DemoApp .Components.HasDatabase }}
	"{{.GoModuleName}}/internal/appsettings"
	"{{.GoModuleName}}/internal/notification"
{{- end }}
	"{{.GoModuleName}}/internal/caches"
)

// appSet is a wire set that provides any application-level services and dependencies.
// for more specific sets, you can create your own
var appSet = wire.NewSet(
	provideCacheManager,
	provideLighthouseCacheStore,
	provideStorageManager,
	provideEventManager,
	provideInspectManager,
{{- if .Components.Metrics }}
	metrics.NewManager,
{{- end }}
	app.NewTimeouts,
	app.NewLifecycleRegistry,
	events.NewMakeEventCmd,
{{- if and .Components.DemoApp .Components.HasDatabase }}
	preseedDemoDefaults,
{{- end }}
)

func provideInspectManager(caches *caches.Manager) *inspects.Manager {
	if caches == nil {
		return inspects.NewManager(nil)
	}
	return inspects.NewManager(caches.Inspects())
}

type eventObserver struct {
	inspects *inspects.Manager
{{- if .Components.Metrics }}
	metrics *metrics.Manager
{{- end }}
}

func (o eventObserver) OnEventPublish(ctx context.Context, name string, topic string, err error, dur time.Duration, driver events.Driver) {
	if o.inspects != nil {
		o.inspects.RecordEventBusEvent(ctx, name, string(driver), "publish", topic, "", err, dur)
	}
{{- if .Components.Metrics }}
	if o.metrics != nil {
		o.metrics.RecordEventPublish(ctx, name, string(driver), topic, err, dur)
	}
{{- end }}
}

func (o eventObserver) OnEventSubscribe(ctx context.Context, name string, topic string, handler string, err error, driver events.Driver) {
	if o.inspects != nil {
		o.inspects.RecordEventBusEvent(ctx, name, string(driver), "subscribe", topic, handler, err, 0)
	}
{{- if .Components.Metrics }}
	if o.metrics != nil {
		o.metrics.RecordEventSubscribe(ctx, name, string(driver), topic, handler, err)
	}
{{- end }}
}

func (o eventObserver) OnEventUnsubscribe(ctx context.Context, name string, topic string, handler string, driver events.Driver) {
	if o.inspects != nil {
		o.inspects.RecordEventBusEvent(ctx, name, string(driver), "unsubscribe", topic, handler, nil, 0)
	}
{{- if .Components.Metrics }}
	if o.metrics != nil {
		o.metrics.RecordEventUnsubscribe(ctx, name, string(driver), topic, handler)
	}
{{- end }}
}

func (o eventObserver) OnEventDeliveryStart(ctx context.Context, name string, topic string, handler string, driver events.Driver) {
	if o.inspects != nil {
		o.inspects.RecordEventBusEvent(ctx, name, string(driver), "delivery_start", topic, handler, nil, 0)
	}
{{- if .Components.Metrics }}
	if o.metrics != nil {
		o.metrics.RecordEventDeliveryStart(ctx, name, string(driver), topic, handler)
	}
{{- end }}
}

func (o eventObserver) OnEventDeliveryFinish(ctx context.Context, name string, topic string, handler string, err error, dur time.Duration, driver events.Driver) {
	if o.inspects != nil {
		o.inspects.RecordEventBusEvent(ctx, name, string(driver), "delivery_finish", topic, handler, err, dur)
	}
{{- if .Components.Metrics }}
	if o.metrics != nil {
		o.metrics.RecordEventDeliveryFinish(ctx, name, string(driver), topic, handler, err, dur)
	}
{{- end }}
}

func provideEventManager(
	inspectManager *inspects.Manager,
{{- if .Components.Metrics }}
	metricsManager *metrics.Manager,
{{- end }}
) (*events.Manager, error) {
	manager, err := events.NewManager()
	if err != nil {
		return nil, err
	}
{{- if .Components.Metrics }}
	if inspectManager != nil || (metricsManager != nil && metricsManager.EventsEnabled()) {
		manager = manager.WithObserver(eventObserver{inspects: inspectManager, metrics: metricsManager})
	}
{{- else }}
	if inspectManager != nil {
		manager = manager.WithObserver(eventObserver{inspects: inspectManager})
	}
{{- end }}
	return manager, nil
}

{{- if and .Components.DemoApp .Components.HasDatabase }}
type demoPreseedReady struct{}

func preseedDemoDefaults(
	logger *logger.AppLogger,
	settingRepo *appsettings.AppSettingRepo,
	channelRepo *notification.ChannelRepo,
) (*demoPreseedReady, error) {
	setupCtx := app.BackgroundSourceContext(app.SourceStartup)
	if inserted, err := settingRepo.PreseedDefaults(setupCtx); err != nil {
		return nil, err
	} else if inserted > 0 {
		logger.Info().Int("inserted", inserted).Msg("app settings preseeded")
	}
	if inserted, err := channelRepo.PreseedDefaults(setupCtx); err != nil {
		return nil, err
	} else if inserted > 0 {
		logger.Info().Int("inserted", inserted).Msg("notification channels preseeded")
	}
	return &demoPreseedReady{}, nil
}
{{- end }}
