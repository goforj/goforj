package wire

import (
	"{{.GoModuleName}}/internal/app"
{{- if and .Components.Auth .Components.HasDatabase }}
	"{{.GoModuleName}}/internal/auth"
{{- end }}
	"{{.GoModuleName}}/internal/events"
	"github.com/google/wire"
{{- if or (and .Components.Auth .Components.HasDatabase) (and .Components.DemoApp .Components.HasDatabase) }}
	"{{.GoModuleName}}/internal/logger"
{{- end }}
{{- if and .Components.DemoApp .Components.HasDatabase }}
	"{{.GoModuleName}}/internal/appsettings"
	"{{.GoModuleName}}/internal/notification"
{{- end }}
)

// appSet is a wire set that provides any application-level services and dependencies.
// for more specific sets, you can create your own
var appSet = wire.NewSet(
	provideCacheManager,
	provideCacheStore,
	provideStorageManager,
	provideEventManager,
	app.NewTimeouts,
	app.NewLifecycleRegistry,
	events.NewMakeEventCmd,
{{- if and .Components.Auth .Components.HasDatabase }}
	auth.NewService,
	preseedAuthDefaults,
{{- end }}
{{- if and .Components.DemoApp .Components.HasDatabase }}
	preseedDemoDefaults,
{{- end }}
)

func provideEventManager() (*events.Manager, error) {
	return events.NewManager()
}

{{- if and .Components.Auth .Components.HasDatabase }}
type authPreseedReady struct{}

func preseedAuthDefaults(
	logger *logger.AppLogger,
	authService *auth.Service,
) (*authPreseedReady, error) {
	seeded, err := authService.EnsureBootstrapUserFromEnv()
	if err != nil {
		return nil, err
	}
	if seeded {
		logger.Info().Msg("auth bootstrap user ensured")
	}
	return &authPreseedReady{}, nil
}
{{- end }}

{{- if and .Components.DemoApp .Components.HasDatabase }}
type demoPreseedReady struct{}

func preseedDemoDefaults(
	logger *logger.AppLogger,
	settingRepo *appsettings.AppSettingRepo,
	channelRepo *notification.ChannelRepo,
) (*demoPreseedReady, error) {
	if inserted, err := settingRepo.PreseedDefaults(); err != nil {
		return nil, err
	} else if inserted > 0 {
		logger.Info().Int("inserted", inserted).Msg("app settings preseeded")
	}
	if inserted, err := channelRepo.PreseedDefaults(); err != nil {
		return nil, err
	} else if inserted > 0 {
		logger.Info().Int("inserted", inserted).Msg("notification channels preseeded")
	}
	return &demoPreseedReady{}, nil
}
{{- end }}
