package wire

import (
{{- if .Components.Metrics }}
	"context"
	"time"

	"{{.GoModuleName}}/internal/metrics"
{{- end }}
	"{{.GoModuleName}}/internal/caches"
	"github.com/goforj/cache/cachecore"
)

func provideCacheManager(
{{- if .Components.Metrics }}
	metricsManager *metrics.Manager,
{{- end }}
) (*caches.Manager, error) {
	manager, err := caches.NewManager()
	if err != nil {
		return nil, err
	}
{{- if .Components.Metrics }}
	if metricsManager != nil && metricsManager.CacheEnabled() {
		manager = manager.WithObserver(caches.ObserverFunc(func(ctx context.Context, name string, op string, _ string, hit bool, err error, dur time.Duration, driver cachecore.Driver) {
			metricsManager.RecordCacheOperation(ctx, name, string(driver), op, hit, err, dur)
		}))
	}
{{- end }}
	return manager, nil
}

func provideCacheStore(caches *caches.Manager) cachecore.Store {
	if caches == nil {
		return nil
	}
	return caches.Default().Store()
}
