package wire

import (
	"{{.GoModuleName}}/internal/cache"
	"github.com/goforj/cache/cachecore"
)

func provideCacheManager() (*cache.Manager, error) {
	return cache.NewManager()
}

func provideCacheStore(cacheManager *cache.Manager) cachecore.Store {
	if cacheManager == nil {
		return nil
	}
	return cacheManager.Default().Store()
}
