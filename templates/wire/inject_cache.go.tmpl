package wire

import (
{{- if .Components.Metrics }}
	"context"

	"{{.GoModuleName}}/internal/metrics"
{{- end }}
	"{{.GoModuleName}}/internal/caches"
)

func provideCacheManager(
{{- if .Components.Metrics }}
	metricsManager *metrics.Manager,
{{- end }}
) (*caches.Manager, error) {
	manager, err := caches.NewManager()
	if err != nil {
		return nil, err
	}
{{- if .Components.Metrics }}
	if metricsManager != nil && metricsManager.CacheEnabled() {
		manager = manager.WithObserver(caches.ObserverFunc(func(ctx context.Context, event caches.CacheOpEvent) {
			metricsManager.RecordCacheOperation(ctx, event)
		}))
	}
{{- end }}
	return manager, nil
}
