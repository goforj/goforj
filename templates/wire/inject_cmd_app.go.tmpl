// App-owned Wire injector. EDIT THIS FILE.
// Add application command providers here, or use `forj make:command`.

package wire

import (
	"github.com/goforj/wire"
	"{{.GoModuleName}}/internal/backup"
	"{{.GoModuleName}}/internal/cmd"
{{- if and .Components.DemoApp .Components.HasDatabase }}
	"{{.GoModuleName}}/internal/monitoring"
{{- end }}
)

// appCommandSet is a wire set that provides app-owned command providers.
var appCommandSet = wire.NewSet(
	backup.NewPlanCmd,
	backup.NewCreateCmd,
	backup.NewListCmd,
	backup.NewVerifyCmd,
	backup.NewRestoreCmd,
	backup.NewPruneCmd,
	backup.NewStatusCmd,
	cmd.NewHelloWorldCmd,
	cmd.NewTestEventPipelineCmd,
	{{- if and .Components.DemoApp .Components.HasDatabase .Components.Jobs }}
	monitoring.NewPollCmd,
	monitoring.NewPushTriggerCmd,
	{{- end }}
	{{- if and .Components.DemoApp .Components.HasDatabase }}
	monitoring.NewResetCmd,
	monitoring.NewRetentionCmd,
	monitoring.NewSeedCmd,
	{{- if .Components.Jobs }}
	monitoring.NewTestPollLoopCmd,
	{{- end }}
	{{- end }}
)
