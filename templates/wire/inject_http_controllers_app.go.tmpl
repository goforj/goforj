// App-owned Wire injector. EDIT THIS FILE.
// Add HTTP controller providers here, or use `forj make:controller`.

package wire

import (
	"github.com/goforj/wire"
{{- if and .Components.DemoApp .Components.HasDatabase }}
	"{{.GoModuleName}}/internal/appsettings"
{{- end }}
{{- if and .Components.Auth .Components.HasDatabase (ne .StarterKit "templ_htmx") }}
	"{{.GoModuleName}}/internal/auth"
{{- end }}
	"{{.GoModuleName}}/internal/hello"
{{- if and .Components.DemoApp .Components.HasDatabase }}
	"{{.GoModuleName}}/internal/monitoring"
{{- end }}
{{- if eq .StarterKit "templ_htmx" }}
	"{{.GoModuleName}}/internal/starterui"
{{- end }}
)

// appHttpControllerSet provides all HTTP route controllers.
var appHttpControllerSet = wire.NewSet(
{{- if and .Components.DemoApp .Components.HasDatabase }}
	appsettings.NewController,
{{- end }}
{{- if and .Components.Auth .Components.HasDatabase (ne .StarterKit "templ_htmx") }}
	auth.NewController,
{{- end }}
	hello.NewController,
{{- if and .Components.DemoApp .Components.HasDatabase }}
	monitoring.NewController,
{{- end }}
{{- if eq .StarterKit "templ_htmx" }}
	starterui.NewController,
{{- end }}
)
