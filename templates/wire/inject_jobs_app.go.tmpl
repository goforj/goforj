// App-owned Wire injector. EDIT THIS FILE.
// Add application job providers here, or use `forj make:job`.

package wire

import (
	"github.com/goforj/wire"
	"{{.GoModuleName}}/internal/jobs"
{{- if and .Components.DemoApp .Components.Jobs }}
	"{{.GoModuleName}}/internal/alerts"
	"{{.GoModuleName}}/internal/monitoring"
{{- end }}
)

// appJobSet is a wire set that contains application-level jobs.
var appJobSet = wire.NewSet(
	{{- if and .Components.DemoApp .Components.Jobs }}
	alerts.NewDispatchJob,
	{{- end }}
	jobs.NewExampleHelloJob,
	jobs.NewExampleHelloJobCmd,
	{{- if and .Components.Jobs .Components.StressTest }}
	jobs.NewStressJob,
	{{- end }}
	{{- if and .Components.DemoApp .Components.Jobs }}
	monitoring.NewCheckService,
	monitoring.NewMonitorCheckJob,
	{{- end }}
)
