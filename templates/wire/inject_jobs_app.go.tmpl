// App-owned Wire injector. EDIT THIS FILE.
// Add application job providers here, or use `forj make:job`.

package wire

import (
	"github.com/goforj/wire"
	"{{.GoModuleName}}/internal/queues"
	"{{.GoModuleName}}/internal/jobs"
{{- if .Components.DemoApp }}
	"{{.GoModuleName}}/internal/alerts"
	"{{.GoModuleName}}/internal/monitoring"
{{- end }}
)

// appJobSet is a wire set that contains application-level jobs.
var appJobSet = wire.NewSet(
	registerJobHandlers,
	{{- if .Components.DemoApp }}
	alerts.NewDispatchJob,
	{{- end }}
	jobs.NewExampleHelloJob,
	jobs.NewExampleHelloJobCmd,
	{{- if .Components.DemoApp }}
	monitoring.NewCheckService,
	monitoring.NewMonitorCheckJob,
	{{- end }}
)

// jobHandlerRegistration makes handler registration a prerequisite of App construction.
type jobHandlerRegistration struct{}

// registerJobHandlers binds every application job to each configured queue runtime.
func registerJobHandlers(
	queueManager *queues.Manager,
	exampleHelloJob *jobs.ExampleHelloJob,
	{{- if .Components.DemoApp }}
	dispatchJob *alerts.DispatchJob,
	monitorCheckJob *monitoring.MonitorCheckJob,
	{{- end }}
) *jobHandlerRegistration {
	queueManager.Register(jobs.ExampleHelloJobTypeName, exampleHelloJob.HandleTask)
	{{- if .Components.DemoApp }}
	queueManager.Register(alerts.DispatchJobTypeName, dispatchJob.HandleTask)
	queueManager.Register(monitoring.MonitorCheckJobTypeName, monitorCheckJob.HandleTask)
	{{- end }}
	return &jobHandlerRegistration{}
}
