package wire

import (
	"context"
	"github.com/google/wire"
	"{{.GoModuleName}}/internal/mail"
	"{{.GoModuleName}}/internal/inspects"
{{- if .Components.Metrics }}
	"{{.GoModuleName}}/internal/metrics"
{{- end }}
)

var mailSet = wire.NewSet(
	provideMailManager,
)

func provideMailManager(
	inspectManager *inspects.Manager,
{{- if .Components.Metrics }}
	metricsManager *metrics.Manager,
{{- end }}
) (*mail.Manager, error) {
{{- if .Components.Metrics }}
	if metricsManager != nil && metricsManager.MailEnabled() {
		return mail.NewManagerWithObserver(mail.ObserverFunc(func(ctx context.Context, event mail.MailSendEvent) {
			inspectManager.RecordMailEvent(ctx, inspects.MailSendInspectEvent{
				Name:     event.Name,
				Driver:   event.Driver,
				Err:      event.Err,
				Duration: event.Duration,
			})
			metricsManager.RecordMailSend(ctx, metrics.MailSendMetricEvent{
				Name:     event.Name,
				Driver:   event.Driver,
				Err:      event.Err,
				Duration: event.Duration,
			})
		}))
	}
{{- end }}
	return mail.NewManagerWithObserver(mail.ObserverFunc(func(ctx context.Context, event mail.MailSendEvent) {
		inspectManager.RecordMailEvent(ctx, inspects.MailSendInspectEvent{
			Name:     event.Name,
			Driver:   event.Driver,
			Err:      event.Err,
			Duration: event.Duration,
		})
	}))
}
