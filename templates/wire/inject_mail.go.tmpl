package wire

import (
	"context"
	"time"
	"github.com/google/wire"
	"{{.GoModuleName}}/internal/mail"
	"{{.GoModuleName}}/internal/inspects"
{{- if .Components.Metrics }}
	"{{.GoModuleName}}/internal/metrics"
{{- end }}
)

var mailSet = wire.NewSet(
	provideMailManager,
)

func provideMailManager(
	inspectManager *inspects.Manager,
{{- if .Components.Metrics }}
	metricsManager *metrics.Manager,
{{- end }}
) (*mail.Manager, error) {
{{- if .Components.Metrics }}
	if inspectManager != nil || (metricsManager != nil && metricsManager.MailEnabled()) {
		return mail.NewManagerWithObserver(mail.ObserverFunc(func(ctx context.Context, name string, driver string, err error, dur time.Duration) {
			if inspectManager != nil {
				inspectManager.RecordMailEvent(ctx, name, driver, err, dur)
			}
			if metricsManager != nil && metricsManager.MailEnabled() {
				metricsManager.RecordMailSend(ctx, name, driver, err, dur)
			}
		}))
	}
{{- else }}
	if inspectManager != nil {
		return mail.NewManagerWithObserver(mail.ObserverFunc(func(ctx context.Context, name string, driver string, err error, dur time.Duration) {
			inspectManager.RecordMailEvent(ctx, name, driver, err, dur)
		}))
	}
{{- end }}
	return mail.NewManager()
}
