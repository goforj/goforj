package wire

import (
	"time"

	"github.com/goforj/queue"
	"{{.GoModuleName}}/internal/queues"
	"{{.GoModuleName}}/internal/jobs"
	"{{.GoModuleName}}/internal/logger"
)

func provideQueueManager(appLogger *logger.AppLogger) (*queues.Manager, error) {
	var observer queue.Observer
	var queueLogger queue.Logger = queue.NoopLogger{}
	if appLogger != nil {
		observer = queue.ObserverFunc(func(event queue.Event) {
			logQueueWorkflowEvent(appLogger, event)
		})
		queueLogger = jobs.NewQueueLoggerAdapter(appLogger)
	}
	return queues.NewManagerWithObserver(observer, queueLogger)
}

func provideQueue(queueManager *queues.Manager) *queue.Queue {
	if queueManager == nil {
		return nil
	}
	return queueManager.Default()
}

func logQueueWorkflowEvent(appLogger *logger.AppLogger, event queue.Event) {
	if appLogger == nil {
		return
	}
	kind := string(event.Kind)
	if kind != "job_succeeded" && kind != "job_failed" && kind != "dispatch_failed" {
		return
	}
	log := appLogger.Info()
	if event.Err != nil {
		log = appLogger.Warn()
	}
	retried := event.Attempt > 0
	log.
		Str("queue_event", kind).
		Str("job_name", event.JobType).
		Str("queue", event.Queue).
		Int("attempt", event.Attempt).
		Bool("retried", retried).
		Str("duration", humanDuration(event.Duration)).
		Err(event.Err).
		Msg("Job processed")
}

func humanDuration(d time.Duration) string {
	if d <= 0 {
		return "0s"
	}
	if d < time.Millisecond {
		return d.Round(time.Microsecond).String()
	}
	if d < time.Second {
		return d.Round(time.Millisecond).String()
	}
	return d.Round(10 * time.Millisecond).String()
}
