package wire

import (
	"context"
	"time"

	"github.com/goforj/queue"
	"{{.GoModuleName}}/internal/app"
	"{{.GoModuleName}}/internal/queues"
	"{{.GoModuleName}}/internal/jobs"
	"{{.GoModuleName}}/internal/logger"
{{- if .Components.Metrics }}
	"{{.GoModuleName}}/internal/metrics"
{{- end }}
)

func provideQueueManager(
	appLogger *logger.AppLogger,
{{- if .Components.Metrics }}
	metricsManager *metrics.Manager,
{{- end }}
) (*queues.Manager, error) {
	var observer queue.Observer
	var queueLogger queue.Logger = queue.NoopLogger{}
{{- if .Components.Metrics }}
	if appLogger != nil || (metricsManager != nil && metricsManager.QueueEnabled()) {
		observer = queue.ObserverFunc(func(ctx context.Context, event queue.Event) {
			if metricsManager != nil && metricsManager.QueueEnabled() {
				metricsManager.RecordQueueEvent(ctx, event)
			}
			logQueueWorkflowEvent(appLogger, ctx, event)
		})
	}
{{- else }}
	if appLogger != nil {
		observer = queue.ObserverFunc(func(ctx context.Context, event queue.Event) {
			logQueueWorkflowEvent(appLogger, ctx, event)
		})
	}
{{- end }}
	if appLogger != nil {
		queueLogger = jobs.NewQueueLoggerAdapter(appLogger)
	}
	return queues.NewManagerWithObserver(observer, queueLogger)
}

func logQueueWorkflowEvent(appLogger *logger.AppLogger, ctx context.Context, event queue.Event) {
	if appLogger == nil {
		return
	}
	switch event.Kind {
	case queue.EventProcessSucceeded, queue.EventProcessFailed, queue.EventDispatchFailed:
	default:
		return
	}
	log := appLogger.Info()
	if event.Err != nil {
		log = appLogger.Warn()
	}
	source := app.SourceFromContext(ctx)
	if source == "" {
		source = app.SourceApp
	}
	retried := event.Attempt > 0
	log.
		Str("source", source.String()).
		Str("queue_event", string(event.Kind)).
		Str("job_name", event.JobType).
		Str("queue", event.Queue).
		Int("attempt", event.Attempt).
		Bool("retried", retried).
		Str("duration", humanDuration(event.Duration)).
		Err(event.Err).
		Msg("Job processed")
}

func humanDuration(d time.Duration) string {
	if d <= 0 {
		return "0s"
	}
	if d < time.Millisecond {
		return d.Round(time.Microsecond).String()
	}
	if d < time.Second {
		return d.Round(time.Millisecond).String()
	}
	return d.Round(10 * time.Millisecond).String()
}
