// App-owned Wire injector. EDIT THIS FILE.
// Add repository providers here, or use `forj make:model`.

package wire

import (
	"github.com/goforj/wire"
{{- if and .Components.DemoApp .Components.HasDatabase }}
	"{{.GoModuleName}}/internal/appsettings"
	"{{.GoModuleName}}/internal/models"
	"{{.GoModuleName}}/internal/notification"
{{- end }}
)

// repositorySet is a wire set for generated repositories.
var repositorySet = wire.NewSet(
{{- if and .Components.DemoApp .Components.HasDatabase }}
	appsettings.NewAppSettingRepo,
	models.NewAlertDispatchEventRepo,
	models.NewIncidentRepo,
	models.NewMonitorCheckRepo,
	models.NewMonitorCheckRollupRepo,
	models.NewMonitorRepo,
	notification.NewChannelRepo,
{{- else }}
	wire.Value(repositorySetPlaceholder{}),
{{- end }}
)

// repositorySetPlaceholder keeps repositorySet non-empty until repos are generated.
type repositorySetPlaceholder struct{}
