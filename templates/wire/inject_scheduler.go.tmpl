package wire

import (
	schedulerx "github.com/goforj/scheduler"
	"github.com/google/wire"
	"{{.GoModuleName}}/internal/scheduler"
)

var schedulerSet = wire.NewSet(
	scheduler.NewScheduler,
	scheduler.NewCmd,
	ProvideScheduler,
)

// ProvideScheduler provides the scheduler and its command.
func ProvideScheduler() (*schedulerx.Scheduler, error) {
	s, err := schedulerx.NewWithError()
	if err != nil {
		return nil, err
	}
	return scheduler.ConfigureScheduler(s), nil
}
