//go:build wireinject
// +build wireinject

// GoForj Wire harness. Edit this file when customizing root assembly.
// Re-rendering can overwrite this file; review local changes before rendering over them.

package wire

import (
	"github.com/goforj/wire"
	"{{.GoModuleName}}/internal/logger"
)

// initializeApplication builds the graph and releases constructed resources if a later provider fails.
func initializeApplication() (App, func(), error) {
	wire.Build(
		appSet,
{{ if and .Components.Auth .Components.HasDatabase -}}
		authSet,
{{ end -}}
		cmdSet,
{{ if .Components.HasDatabase -}}
		databaseSet,
{{ end -}}
{{ if .Components.Events -}}
		appSubscriberSet,
{{ end -}}
{{ if or .Components.WebAPI .Components.WebUI -}}
		appHttpControllerSet,
{{ end -}}
{{ if or .Components.WebAPI .Components.WebUI -}}
		httpServerSet,
{{ end -}}
{{ if .Components.Jobs -}}
		appJobSet,
{{ end -}}
{{ if .Components.Jobs -}}
		jobSet,
{{ end -}}
		logger.ProvideAppLogger,
		managerSet,
{{ if .Components.Scheduler -}}
		schedulerSet,
{{ end -}}
		NewApplication,
	)

	return App{}, nil, nil
}
